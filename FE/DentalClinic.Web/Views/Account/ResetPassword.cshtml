@model ResetPasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Reset Password";
}

<div class="auth-card-header">
    <div class="empty-state-icon-box mb-3" style="width: 50px; height: 50px;">
        <i class="bi bi-shield-lock text-primary fs-4"></i>
    </div>
    <h2 class="auth-card-title">Set New Password</h2>
    <p class="auth-card-subtitle">Choose a new secure password for <strong>@Model.Email</strong></p>
</div>

<form asp-controller="Account" asp-action="ResetPassword" method="post" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Email" />
    <input type="hidden" asp-for="Token" />

    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

    <div class="mb-3">
        <label asp-for="NewPassword" class="form-label">New Password</label>
        <div class="input-password-wrapper">
            <input asp-for="NewPassword" type="password" id="resetPasswordInput" class="form-control pe-5" placeholder="Minimum 8 characters" autofocus />
            <button type="button" class="password-toggle-btn" data-target="resetPasswordInput" title="Toggle password visibility">
                <i class="bi bi-eye"></i>
            </button>
        </div>
        <span asp-validation-for="NewPassword" class="text-danger small"></span>
    </div>

    <div class="mb-4">
        <label asp-for="ConfirmPassword" class="form-label">Confirm New Password</label>
        <div class="input-password-wrapper">
            <input asp-for="ConfirmPassword" type="password" id="resetConfirmPasswordInput" class="form-control pe-5" placeholder="Re-enter new password" />
            <button type="button" class="password-toggle-btn" data-target="resetConfirmPasswordInput" title="Toggle password visibility">
                <i class="bi bi-eye"></i>
            </button>
        </div>
        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
    </div>

    <button type="submit" class="btn btn-dc-primary w-100 py-2 fs-6 mb-3">
        <i class="bi bi-check-circle me-1"></i> Save New Password
    </button>

    <div class="text-center small">
        <a asp-controller="Account" asp-action="Login" class="text-decoration-none text-muted">
            Cancel and return to Sign In
        </a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
