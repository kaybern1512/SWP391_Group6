@model ResetPasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Đặt Lại Mật Khẩu";
}

<div class="auth-card-header text-center">
    <div class="empty-state-icon-box mx-auto mb-3" style="width: 54px; height: 54px;">
        <i class="bi bi-shield-lock text-primary fs-3"></i>
    </div>
    <h2 class="auth-card-title">Đặt Lại Mật Khẩu</h2>
    <p class="auth-card-subtitle">
        Nhập mã xác thực OTP 6 chữ số được gửi đến email: <br />
        <strong class="text-dark">@Model.Email</strong>
    </p>
</div>

<div class="alert alert-info py-2 small mb-3 text-start">
    <i class="bi bi-info-circle me-1"></i>
    <strong>Lưu ý kiểm thử (Development):</strong> Mã xác thực OTP gồm 6 chữ số được in trực tiếp trong cửa sổ Terminal của <code>Backend API</code> (dòng <code>[DEV OTP NOTIFICATION]</code>).
</div>

<form asp-controller="Account" asp-action="ResetPassword" method="post" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Email" />

    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

    <div class="mb-3">
        <label asp-for="Token" class="form-label">Mã OTP Xác Thực</label>
        <div class="input-group">
            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-key"></i></span>
            <input asp-for="Token" class="form-control border-start-0" placeholder="Nhập mã OTP 6 chữ số" maxlength="10" autocomplete="off" autofocus />
        </div>
        <span asp-validation-for="Token" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="NewPassword" class="form-label">Mật Khẩu Mới</label>
        <div class="input-password-wrapper">
            <input asp-for="NewPassword" type="password" id="resetPasswordInput" class="form-control pe-5" placeholder="Tối thiểu 8 ký tự (chữ hoa, thường, số, ký tự đặc biệt)" />
            <button type="button" class="password-toggle-btn" data-target="resetPasswordInput" title="Hiển thị/Ẩn mật khẩu">
                <i class="bi bi-eye"></i>
            </button>
        </div>
        <span asp-validation-for="NewPassword" class="text-danger small"></span>
    </div>

    <div class="mb-4">
        <label asp-for="ConfirmPassword" class="form-label">Xác Nhận Mật Khẩu Mới</label>
        <div class="input-password-wrapper">
            <input asp-for="ConfirmPassword" type="password" id="resetConfirmPasswordInput" class="form-control pe-5" placeholder="Nhập lại mật khẩu mới" />
            <button type="button" class="password-toggle-btn" data-target="resetConfirmPasswordInput" title="Hiển thị/Ẩn mật khẩu">
                <i class="bi bi-eye"></i>
            </button>
        </div>
        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
    </div>

    <button type="submit" class="btn btn-dc-primary w-100 py-2 fs-6 mb-3">
        <i class="bi bi-check-circle me-1"></i> Lưu Mật Khẩu Mới
    </button>

    <div class="d-flex justify-content-between align-items-center border-top pt-3 mt-4 small">
        <a asp-controller="Account" asp-action="ForgotPassword" class="text-decoration-none text-primary">
            <i class="bi bi-arrow-repeat me-1"></i> Yêu cầu gửi lại OTP
        </a>
        <a asp-controller="Account" asp-action="Login" class="text-decoration-none text-muted">
            Quay lại Đăng nhập
        </a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
