@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi Mật Khẩu";
}

<div class="container-fluid p-0" style="max-width: 680px;">
    <!-- Breadcrumb -->
    <ul class="breadcrumb-dc mb-3">
        <li><a asp-controller="Profile" asp-action="Index">Hồ sơ cá nhân</a></li>
        <li class="separator">/</li>
        <li class="active">Đổi mật khẩu</li>
    </ul>

    <div class="card-dc">
        <div class="card-dc-header">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-shield-lock text-primary fs-5"></i>
                <span class="fs-6 fw-bold">Cập Nhật Mật Khẩu Tài Khoản</span>
            </div>
        </div>
        <div class="card-dc-body p-4">
            <p class="text-muted small mb-4">
                Để bảo vệ an toàn cho hồ sơ bệnh án và tài khoản chuyên môn của bạn, hãy chọn mật khẩu phức tạp và không sử dụng trùng mật khẩu giữa các nền tảng khác.
            </p>

            <form asp-controller="Account" asp-action="ChangePassword" method="post" novalidate>
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="CurrentPassword" class="form-label">Mật Khẩu Hiện Tại <span class="text-danger">*</span></label>
                    <div class="input-password-wrapper">
                        <input asp-for="CurrentPassword" type="password" id="currentPasswordInput" class="form-control pe-5" placeholder="Nhập mật khẩu hiện tại" autofocus />
                        <button type="button" class="password-toggle-btn" data-target="currentPasswordInput" title="Hiển thị/Ẩn mật khẩu">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label">Mật Khẩu Mới <span class="text-danger">*</span></label>
                    <div class="input-password-wrapper">
                        <input asp-for="NewPassword" type="password" id="newPasswordInput" class="form-control pe-5" placeholder="Tối thiểu 8 ký tự (chữ hoa, chữ thường, số, ký tự đặc biệt)" />
                        <button type="button" class="password-toggle-btn" data-target="newPasswordInput" title="Hiển thị/Ẩn mật khẩu">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label">Xác Nhận Mật Khẩu Mới <span class="text-danger">*</span></label>
                    <div class="input-password-wrapper">
                        <input asp-for="ConfirmPassword" type="password" id="confirmPasswordInput" class="form-control pe-5" placeholder="Nhập lại mật khẩu mới" />
                        <button type="button" class="password-toggle-btn" data-target="confirmPasswordInput" title="Hiển thị/Ẩn mật khẩu">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a asp-controller="Profile" asp-action="Index" class="btn btn-dc-outline">Hủy Bỏ</a>
                    <button type="submit" class="btn btn-dc-primary">
                        <i class="bi bi-check-lg me-1"></i> Cập Nhật Mật Khẩu
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
