@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
}

<div class="container-fluid p-0" style="max-width: 680px;">
    <!-- Breadcrumb -->
    <ul class="breadcrumb-dc mb-3">
        <li><a asp-controller="Profile" asp-action="Index">Profile</a></li>
        <li class="separator">/</li>
        <li class="active">Change Password</li>
    </ul>

    <div class="card-dc">
        <div class="card-dc-header">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-shield-lock text-primary fs-5"></i>
                <span class="fs-6 fw-bold">Update Account Password</span>
            </div>
        </div>
        <div class="card-dc-body p-4">
            <p class="text-muted small mb-4">
                To keep your medical records and clinical credentials secure, choose a complex password and avoid reusing passwords across accounts.
            </p>

            <form asp-controller="Account" asp-action="ChangePassword" method="post" novalidate>
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="CurrentPassword" class="form-label">Current Password</label>
                    <div class="input-password-wrapper">
                        <input asp-for="CurrentPassword" type="password" id="currentPasswordInput" class="form-control pe-5" placeholder="Enter current password" autofocus />
                        <button type="button" class="password-toggle-btn" data-target="currentPasswordInput" title="Toggle password visibility">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label">New Password</label>
                    <div class="input-password-wrapper">
                        <input asp-for="NewPassword" type="password" id="newPasswordInput" class="form-control pe-5" placeholder="Minimum 8 characters (mixed case, number, symbol)" />
                        <button type="button" class="password-toggle-btn" data-target="newPasswordInput" title="Toggle password visibility">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label">Confirm New Password</label>
                    <div class="input-password-wrapper">
                        <input asp-for="ConfirmPassword" type="password" id="confirmPasswordInput" class="form-control pe-5" placeholder="Re-enter new password" />
                        <button type="button" class="password-toggle-btn" data-target="confirmPasswordInput" title="Toggle password visibility">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a asp-controller="Profile" asp-action="Index" class="btn btn-dc-outline">Cancel</a>
                    <button type="submit" class="btn btn-dc-primary">
                        <i class="bi bi-check-lg me-1"></i> Update Password
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
