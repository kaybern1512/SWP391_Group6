@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5 text-center">
    <div class="card-dc p-5 mx-auto" style="max-width: 520px;">
        <div class="empty-state-icon-box mx-auto mb-3" style="width: 64px; height: 64px; background-color: var(--dc-danger-bg); color: var(--dc-danger);">
            <i class="bi bi-shield-slash fs-2"></i>
        </div>
        <h3 class="fw-bold text-dark mb-2">Access Denied (403)</h3>
        <p class="text-muted mb-4">
            Your current account role does not have authorization to view this clinical or administrative workspace. Please sign in with appropriate credentials or contact the system administrator.
        </p>
        <div class="d-flex justify-content-center gap-2">
            <a asp-controller="Home" asp-action="Index" class="btn btn-dc-primary">
                <i class="bi bi-house me-1"></i> Home
            </a>
            <a asp-controller="Account" asp-action="Login" class="btn btn-dc-outline">
                <i class="bi bi-person-circle me-1"></i> Switch Account
            </a>
        </div>
    </div>
</div>
