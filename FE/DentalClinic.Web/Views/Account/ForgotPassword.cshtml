@model ForgotPasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Forgot Password";
    var isSubmitted = ViewBag.Submitted as bool? ?? false;
    var submittedEmail = ViewBag.SubmittedEmail as string;
}

<div class="auth-card-header">
    <div class="empty-state-icon-box mb-3" style="width: 50px; height: 50px;">
        <i class="bi bi-key text-primary fs-4"></i>
    </div>
    <h2 class="auth-card-title">Password Recovery</h2>
    <p class="auth-card-subtitle">Enter your registered email address to receive a secure password reset link</p>
</div>

@if (isSubmitted)
{
    <div class="alert alert-info py-3 mb-4">
        <div class="d-flex align-items-start gap-2">
            <i class="bi bi-info-circle-fill fs-5 text-info mt-1"></i>
            <div>
                <strong>Request Dispatched:</strong>
                <p class="mb-0 mt-1 small">
                    If an account exists for <strong class="text-dark">@submittedEmail</strong>, a message containing reset instructions has been sent. Please check your inbox and spam folder.
                </p>
            </div>
        </div>
    </div>
    <a asp-controller="Account" asp-action="Login" class="btn btn-dc-outline w-100 py-2">
        <i class="bi bi-arrow-left me-1"></i> Return to Sign In
    </a>
}
else
{
    <form asp-controller="Account" asp-action="ForgotPassword" method="post" novalidate>
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

        <div class="mb-4">
            <label asp-for="Email" class="form-label">Email Address</label>
            <div class="input-group">
                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
                <input asp-for="Email" type="email" class="form-control border-start-0" placeholder="name@domain.com" autofocus />
            </div>
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>

        <button type="submit" class="btn btn-dc-primary w-100 py-2 fs-6 mb-3">
            <i class="bi bi-send me-1"></i> Send Recovery Link
        </button>

        <div class="text-center small text-muted">
            <a asp-controller="Account" asp-action="Login" class="text-decoration-none text-primary">
                <i class="bi bi-arrow-left me-1"></i> Remember password? Sign In
            </a>
        </div>
    </form>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
