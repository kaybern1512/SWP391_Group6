@model LoginViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Đăng Nhập";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<div class="auth-card-header">
    <h2 class="auth-card-title">Chào Mừng Trở Lại</h2>
    <p class="auth-card-subtitle">Đăng nhập để truy cập cổng khám chữa bệnh và quản trị DentalCare</p>
</div>

<!-- Social Google Sign-In -->
<form asp-controller="Account" asp-action="ExternalLogin" asp-route-returnUrl="@returnUrl" method="post" class="mb-3">
    @Html.AntiForgeryToken()
    <input type="hidden" name="provider" value="Google" />
    <button type="submit" class="btn-google">
        <svg width="18" height="18" viewBox="0 0 48 48">
            <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
            <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
            <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
            <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
        </svg>
        <span>Tiếp tục với Google</span>
    </button>
</form>

<div class="auth-divider">
    <span>hoặc đăng nhập bằng email</span>
</div>

<form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl" method="post" novalidate>
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label">Địa Chỉ Email</label>
        <div class="input-group">
            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
            <input asp-for="Email" type="email" class="form-control border-start-0" placeholder="ten@domain.com" autofocus />
        </div>
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <div class="d-flex justify-content-between align-items-center mb-1">
            <label asp-for="Password" class="form-label mb-0">Mật Khẩu</label>
            <a asp-controller="Account" asp-action="ForgotPassword" class="small text-primary text-decoration-none">
                Quên mật khẩu?
            </a>
        </div>
        <div class="input-password-wrapper">
            <input asp-for="Password" type="password" id="loginPasswordInput" class="form-control pe-5" placeholder="Nhập mật khẩu của bạn" />
            <button type="button" class="password-toggle-btn" data-target="loginPasswordInput" title="Hiển thị/Ẩn mật khẩu">
                <i class="bi bi-eye"></i>
            </button>
        </div>
        <span asp-validation-for="Password" class="text-danger small"></span>
    </div>

    <div class="form-check mb-4">
        <input asp-for="RememberMe" class="form-check-input" id="rememberMeCheck" />
        <label asp-for="RememberMe" class="form-check-label small text-muted" for="rememberMeCheck">
            Ghi nhớ đăng nhập trên trình duyệt này
        </label>
    </div>

    <button type="submit" class="btn btn-dc-primary w-100 py-2 fs-6">
        <i class="bi bi-box-arrow-in-right me-1"></i> Đăng Nhập
    </button>

    <div class="text-center mt-4 small text-muted">
        Chưa có tài khoản?
        <a asp-controller="Account" asp-action="Register" class="text-primary fw-semibold text-decoration-none">Đăng ký hồ sơ bệnh nhân mới</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
