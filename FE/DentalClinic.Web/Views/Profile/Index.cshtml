@model ProfileViewModel
@{
    ViewData["Title"] = "My Profile";
    var avatarUrl = Model.AvatarUrl;
    if (string.IsNullOrEmpty(avatarUrl) || avatarUrl == "/images/default-avatar.png")
    {
        avatarUrl = "/images/default-avatar.svg";
    }
    var roleBadgeClass = Model.Role.ToLowerInvariant() switch
    {
        "patient" => "badge-role-patient",
        "dentist" => "badge-role-dentist",
        "receptionist" => "badge-role-receptionist",
        "departmentmanager" => "badge-role-departmentmanager",
        "systemadministrator" => "badge-role-systemadministrator",
        _ => "badge-role-patient"
    };
}

<div class="container-fluid p-0" style="max-width: 1080px;">
    <!-- Breadcrumb -->
    <ul class="breadcrumb-dc mb-3">
        <li><a asp-controller="Home" asp-action="Index">Home</a></li>
        <li class="separator">/</li>
        <li class="active">My Profile</li>
    </ul>

    @if (ViewBag.ApiNotice != null)
    {
        <div class="alert alert-secondary d-flex align-items-center gap-2 mb-3 py-2 small">
            <i class="bi bi-info-circle text-primary"></i>
            <div>@ViewBag.ApiNotice</div>
        </div>
    }

    <!-- Profile Header Card -->
    <div class="card-dc mb-4 overflow-hidden">
        <div class="profile-cover"></div>
        <div class="profile-avatar-wrapper">
            <img src="@avatarUrl" alt="Avatar" class="profile-avatar-img" id="currentAvatarImg" onerror="this.src='/images/default-avatar.svg'" />
            <button type="button" class="avatar-edit-overlay" data-bs-toggle="modal" data-bs-target="#uploadAvatarModal" title="Upload new photo">
                <i class="bi bi-camera-fill"></i>
            </button>
        </div>

        <div class="profile-info-header">
            <div>
                <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                    <h2 class="profile-name mb-0">@Model.FullName</h2>
                    <span class="badge-dc @roleBadgeClass">@Model.Role</span>
                    @if (Model.IsEmailVerified)
                    {
                        <span class="badge-dc badge-status-confirmed">
                            <i class="bi bi-check2-circle"></i> Verified Email
                        </span>
                    }
                    else
                    {
                        <span class="badge-dc badge-status-pending">
                            <i class="bi bi-exclamation-circle"></i> Unverified Email
                        </span>
                    }
                </div>
                <div class="text-muted small d-flex align-items-center gap-3 flex-wrap">
                    <span><i class="bi bi-envelope me-1"></i> @Model.Email</span>
                    @if (!string.IsNullOrEmpty(Model.Code))
                    {
                        <span><i class="bi bi-upc-scan me-1"></i> Code: <strong>@Model.Code</strong></span>
                    }
                    @if (!string.IsNullOrEmpty(Model.PhoneNumber))
                    {
                        <span><i class="bi bi-telephone me-1"></i> @Model.PhoneNumber</span>
                    }
                </div>
            </div>

            <div class="d-flex gap-2 mt-2 mt-sm-0">
                <a asp-controller="Profile" asp-action="Edit" class="btn btn-dc-primary btn-sm">
                    <i class="bi bi-pencil-square me-1"></i> Edit Profile
                </a>
                <a asp-controller="Account" asp-action="ChangePassword" class="btn btn-dc-outline btn-sm">
                    <i class="bi bi-key me-1"></i> Change Password
                </a>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Main Information Column -->
        <div class="col-lg-8">
            <div class="card-dc mb-4">
                <div class="card-dc-header">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-person-lines-fill text-primary"></i>
                        <span>Personal Demographics & Contact</span>
                    </div>
                </div>
                <div class="card-dc-body p-4">
                    <dl class="row profile-details-list mb-0">
                        <dt class="col-sm-4">Full Legal Name</dt>
                        <dd class="col-sm-8">@Model.FullName</dd>

                        <dt class="col-sm-4">Email Address</dt>
                        <dd class="col-sm-8">
                            @Model.Email
                            <span class="text-muted ms-1 small">(Primary Login ID)</span>
                        </dd>

                        <dt class="col-sm-4">Contact Phone</dt>
                        <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.PhoneNumber) ? "Not provided" : Model.PhoneNumber)</dd>

                        <dt class="col-sm-4">Date of Birth</dt>
                        <dd class="col-sm-8">@(Model.DateOfBirth.HasValue ? Model.DateOfBirth.Value.ToString("yyyy-MM-dd") : "Not provided")</dd>

                        <dt class="col-sm-4">Gender</dt>
                        <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Gender) ? "Not specified" : Model.Gender)</dd>

                        <dt class="col-sm-4">Residential Address</dt>
                        <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Address) ? "Not provided" : Model.Address)</dd>

                        <dt class="col-sm-4">National ID (CCCD)</dt>
                        <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.NationalId) ? "Not provided" : Model.NationalId)</dd>

                        <dt class="col-sm-4">Health Insurance (BHYT)</dt>
                        <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.HealthInsuranceNumber) ? "No insurance on file" : Model.HealthInsuranceNumber)</dd>

                        <dt class="col-sm-4">Emergency Contact</dt>
                        <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.EmergencyContact) ? "Not provided" : Model.EmergencyContact)</dd>
                    </dl>
                </div>
            </div>

            @if (Model.Role == "Dentist")
            {
                <div class="card-dc mb-4">
                    <div class="card-dc-header">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-award text-teal"></i>
                            <span>Clinical Practice Credentials</span>
                        </div>
                    </div>
                    <div class="card-dc-body p-4">
                        <dl class="row profile-details-list mb-0">
                            <dt class="col-sm-4">Practicing License #</dt>
                            <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.LicenseNumber) ? "Pending verification" : Model.LicenseNumber)</dd>

                            <dt class="col-sm-4">Qualification Degree</dt>
                            <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Qualification) ? "Doctor of Dental Surgery (DDS)" : Model.Qualification)</dd>

                            <dt class="col-sm-4">Clinical Experience</dt>
                            <dd class="col-sm-8">@(Model.YearsOfExperience.HasValue ? $"{Model.YearsOfExperience.Value} years" : "Not specified")</dd>

                            <dt class="col-sm-4">Assigned Department</dt>
                            <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.DepartmentName) ? "General Dentistry" : Model.DepartmentName)</dd>

                            <dt class="col-sm-4">Professional Bio</dt>
                            <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Biography) ? "No professional summary provided." : Model.Biography)</dd>
                        </dl>
                    </div>
                </div>
            }
        </div>

        <!-- Side Card: Account Summary -->
        <div class="col-lg-4">
            <div class="card-dc mb-4">
                <div class="card-dc-header">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-shield-check text-primary"></i>
                        <span>Account Parameters</span>
                    </div>
                </div>
                <div class="card-dc-body p-4">
                    <ul class="list-unstyled mb-0 small">
                        <li class="d-flex justify-content-between py-2 border-bottom">
                            <span class="text-muted">Account Status:</span>
                            <span class="fw-semibold text-success"><i class="bi bi-dot fs-5"></i> Active</span>
                        </li>
                        <li class="d-flex justify-content-between py-2 border-bottom">
                            <span class="text-muted">Assigned Role:</span>
                            <span class="fw-semibold text-dark">@Model.Role</span>
                        </li>
                        <li class="d-flex justify-content-between py-2 border-bottom">
                            <span class="text-muted">Identifier Code:</span>
                            <span class="fw-bold text-primary">@(string.IsNullOrEmpty(Model.Code) ? $"UID-{Model.UserId}" : Model.Code)</span>
                        </li>
                        <li class="d-flex justify-content-between py-2 border-bottom">
                            <span class="text-muted">Registration Date:</span>
                            <span class="fw-semibold text-dark">@(Model.CreatedAt != default ? Model.CreatedAt.ToString("yyyy-MM-dd") : "Today")</span>
                        </li>
                        <li class="d-flex justify-content-between py-2">
                            <span class="text-muted">Two-Factor Auth:</span>
                            <span class="fw-semibold text-muted">Disabled</span>
                        </li>
                    </ul>
                </div>
            </div>

            <div class="card-dc bg-light border">
                <div class="card-dc-body p-4 text-center">
                    <i class="bi bi-hospital fs-1 text-primary mb-2 d-inline-block"></i>
                    <h6 class="fw-bold mb-1">Clinic Support</h6>
                    <p class="text-muted small mb-3">
                        Need assistance updating clinical insurance records or identity verification? Contact the front desk.
                    </p>
                    <a href="tel:19001234" class="btn btn-dc-outline btn-sm rounded-pill px-3">
                        <i class="bi bi-telephone me-1"></i> Front Desk Assistance
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Upload Avatar -->
<div class="modal fade" id="uploadAvatarModal" tabindex="-1" aria-labelledby="uploadAvatarModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fs-6 fw-bold" id="uploadAvatarModalLabel">Update Profile Photo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Profile" asp-action="UploadAvatar" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-body text-center p-4">
                    <div class="mb-3">
                        <img src="@avatarUrl" id="avatarPreviewImg" class="rounded-circle border" style="width: 110px; height: 110px; object-fit: cover;" onerror="this.src='/images/default-avatar.svg'" />
                    </div>
                    <div class="mb-3 text-start">
                        <label class="form-label" for="avatarFileInput">Choose image file (JPG, PNG, WEBP, max 5 MB):</label>
                        <input type="file" name="avatarFile" id="avatarFileInput" class="form-control" accept=".jpg,.jpeg,.png,.webp" required />
                    </div>
                    <p class="text-muted small mb-0">
                        The uploaded photo is securely stored and synchronized with your clinical profile.
                    </p>
                </div>
                <div class="modal-footer border-top">
                    <button type="button" class="btn btn-dc-outline btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-dc-primary btn-sm">
                        <i class="bi bi-cloud-arrow-up me-1"></i> Upload & Save
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
