@model EditProfileViewModel
@{
    ViewData["Title"] = "Chỉnh Sửa Hồ Sơ";
}

<div class="container-fluid p-0" style="max-width: 860px;">
    <!-- Breadcrumb -->
    <ul class="breadcrumb-dc mb-3">
        <li><a asp-controller="Profile" asp-action="Index">Hồ sơ</a></li>
        <li class="separator">/</li>
        <li class="active">Chỉnh Sửa Hồ Sơ</li>
    </ul>

    <div class="card-dc">
        <div class="card-dc-header">
            <div>
                <div class="fs-6 fw-bold text-dark">Chỉnh Sửa Hồ Sơ</div>
                <div class="text-muted small">Cập nhật thông tin cá nhân và dữ liệu liên hệ của bạn</div>
            </div>
            @if (!string.IsNullOrEmpty(Model.Code))
            {
                <span class="badge bg-light text-primary border">Mã: @Model.Code</span>
            }
        </div>

        <div class="card-dc-body p-4">
            <form asp-controller="Profile" asp-action="Edit" method="post" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Role" />
                <input type="hidden" asp-for="Code" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-4"></div>

                <!-- Readonly Login Identity -->
                <div class="mb-4 pb-3 border-bottom">
                    <label asp-for="Email" class="form-label">Địa Chỉ Email</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
                        <input asp-for="Email" class="form-control bg-light text-muted border-start-0" readonly />
                        <span class="input-group-text bg-light small text-muted">Tài khoản cố định</span>
                    </div>
                    <small class="text-muted d-block mt-1">Địa chỉ email đăng ký là định danh bảo mật chính của bạn và không thể sửa trực tiếp.</small>
                </div>

                <!-- Section 1: Personal Information -->
                <div class="form-section-title">
                    <i class="bi bi-person text-primary"></i> Thông Tin Cá Nhân
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="FullName" class="form-label">Họ và Tên</label>
                        <input asp-for="FullName" class="form-control" placeholder="Ví dụ: Nguyễn Văn A" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="DateOfBirth" class="form-label">Ngày Sinh</label>
                        <input asp-for="DateOfBirth" type="date" class="form-control" />
                        <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PhoneNumber" class="form-label">Số Điện Thoại</label>
                        <input asp-for="PhoneNumber" class="form-control" placeholder="0912345678" />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Gender" class="form-label">Giới Tính</label>
                        <select asp-for="Gender" class="form-select">
                            <option value="">-- Chọn Giới Tính --</option>
                            <option value="Male">Nam</option>
                            <option value="Female">Nữ</option>
                            <option value="Other">Khác</option>
                        </select>
                        <span asp-validation-for="Gender" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Section 2: Contact Information -->
                <div class="form-section-title">
                    <i class="bi bi-geo-alt text-teal"></i> Thông Tin Liên Hệ
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-12">
                        <label asp-for="Address" class="form-label">Địa Chỉ Thường Trú</label>
                        <input asp-for="Address" class="form-control" placeholder="Số nhà, tên đường, phường/xã, quận/huyện, tỉnh/thành phố" />
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="EmergencyContact" class="form-label">Người Liên Hệ Khẩn Cấp</label>
                        <input asp-for="EmergencyContact" class="form-control" placeholder="Ví dụ: Người thân - 0987654321" />
                        <span asp-validation-for="EmergencyContact" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Section 3: Insurance & Identification -->
                <div class="form-section-title">
                    <i class="bi bi-shield-check text-info"></i> Giấy Tờ & Bảo Hiểm Y Tế
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="NationalId" class="form-label">Số CCCD / CMND (12 số)</label>
                        <input asp-for="NationalId" class="form-control" placeholder="12 số căn cước công dân" />
                        <span asp-validation-for="NationalId" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="HealthInsuranceNumber" class="form-label">Mã Thẻ BHYT</label>
                        <input asp-for="HealthInsuranceNumber" class="form-control" placeholder="Ví dụ: DN4012345678901" />
                        <span asp-validation-for="HealthInsuranceNumber" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a asp-controller="Profile" asp-action="Index" class="btn btn-dc-outline">Hủy Bỏ</a>
                    <button type="submit" class="btn btn-dc-primary">
                        <i class="bi bi-check-lg me-1"></i> Lưu Thay Đổi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
