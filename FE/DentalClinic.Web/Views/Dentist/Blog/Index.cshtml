@model DentalClinic.Web.ViewModels.Blog.DentistBlogIndexViewModel
@{
    ViewData["Title"] = "Bài Viết Của Tôi - Bác Sĩ Nha Khoa";
    var items = Model.PagedResult.Items;
    var totalPages = Model.PagedResult.TotalPages;
    var currentPage = Model.CurrentPage;
}

<div class="container-fluid py-3">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1">
                <i class="bi bi-journal-richtext text-primary me-2"></i>Bài Viết Của Tôi
            </h3>
            <p class="text-muted small mb-0">Soạn thảo, quản lý bản nháp và gửi duyệt bài viết kiến thức nha khoa.</p>
        </div>
        <div>
            <a asp-controller="DentistBlog" asp-action="Create" class="btn btn-primary d-inline-flex align-items-center gap-2 rounded-pill px-4 py-2 shadow-sm">
                <i class="bi bi-plus-circle"></i>
                <span class="fw-semibold">Viết Bài Mới</span>
            </a>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="card border-0 shadow-sm rounded-4 p-3 mb-4">
        <form method="get" asp-controller="DentistBlog" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light border-end-0">
                        <i class="bi bi-search text-muted"></i>
                    </span>
                    <input type="text"
                           name="keyword"
                           value="@Model.CurrentKeyword"
                           class="form-control bg-light border-start-0"
                           placeholder="Tìm theo tiêu đề bài viết..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select form-select-sm bg-light">
                    <option value="">-- Tất cả trạng thái --</option>
                    <option value="Draft" selected="@(Model.CurrentStatus == "Draft")">Bản nháp (Draft)</option>
                    <option value="PendingReview" selected="@(Model.CurrentStatus == "PendingReview")">Chờ duyệt (PendingReview)</option>
                    <option value="Published" selected="@(Model.CurrentStatus == "Published")">Đã xuất bản (Published)</option>
                    <option value="Archived" selected="@(Model.CurrentStatus == "Archived")">Đã lưu trữ (Archived)</option>
                </select>
            </div>
            <div class="col-md-auto d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary rounded-pill px-3">
                    <i class="bi bi-funnel me-1"></i> Lọc
                </button>
                <a asp-controller="DentistBlog" asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>

    <!-- Post List Table -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        @if (items != null && items.Count > 0)
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted small text-uppercase" style="letter-spacing: 0.05em;">
                        <tr>
                            <th style="width: 80px;" class="text-center">Ảnh</th>
                            <th>Bài Viết</th>
                            <th>Chuyên Mục</th>
                            <th class="text-center">Trạng Thái</th>
                            <th class="text-center">Lượt Xem</th>
                            <th>Ngày Tạo / Đăng</th>
                            <th class="text-end" style="width: 140px;">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var post in items)
                        {
                            <tr>
                                <td class="text-center">
                                    <img src="@(!string.IsNullOrWhiteSpace(post.ThumbnailUrl) ? post.ThumbnailUrl : "https://images.unsplash.com/photo-1588776814546-1ffcf47267a5?auto=format&fit=crop&w=120&q=80")"
                                         alt="@post.Title"
                                         class="rounded-3 border"
                                         style="width: 60px; height: 42px; object-fit: cover;" />
                                </td>
                                <td>
                                    <div class="fw-bold text-dark mb-1">
                                        @post.Title
                                    </div>
                                    <div class="text-muted small text-truncate" style="max-width: 380px;">
                                        @post.Summary
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        @post.CategoryName
                                    </span>
                                </td>
                                <td class="text-center">
                                    @switch (post.Status)
                                    {
                                        case "Draft":
                                            <span class="badge badge-status-draft px-2 py-1 rounded-pill">Lưu Nháp</span>
                                            break;
                                        case "PendingReview":
                                            <span class="badge badge-status-pendingreview px-2 py-1 rounded-pill">Chờ Duyệt</span>
                                            break;
                                        case "Published":
                                            <span class="badge badge-status-published px-2 py-1 rounded-pill">Đã Xuất Bản</span>
                                            break;
                                        case "Archived":
                                            <span class="badge badge-status-archived px-2 py-1 rounded-pill">Lưu Trữ</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary px-2 py-1 rounded-pill">@post.Status</span>
                                            break;
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-light text-muted">
                                        <i class="bi bi-eye me-1"></i>@post.ViewCount
                                    </span>
                                </td>
                                <td class="small text-muted">
                                    <div>Tạo: @post.CreatedAt.ToString("dd/MM/yyyy")</div>
                                    @if (post.PublishedAt.HasValue)
                                    {
                                        <div class="text-success small">Đăng: @post.PublishedAt.Value.ToString("dd/MM/yyyy")</div>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        @if (post.Status == "Published")
                                        {
                                            <a asp-controller="Blog" asp-action="Detail" asp-route-slug="@post.Slug" target="_blank" class="btn btn-outline-info" title="Xem công khai">
                                                <i class="bi bi-box-arrow-up-right"></i>
                                            </a>
                                        }
                                        <a asp-controller="DentistBlog" asp-action="Edit" asp-route-id="@post.BlogPostId" class="btn btn-outline-primary" title="Chỉnh sửa bài viết">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button type="button" class="btn btn-outline-danger" title="Xóa bài viết"
                                                data-bs-toggle="modal" data-bs-target="#deletePostModal-@post.BlogPostId">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>

                                    <!-- Delete Confirm Modal -->
                                    <div class="modal fade" id="deletePostModal-@post.BlogPostId" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered text-start">
                                            <div class="modal-content border-0 shadow">
                                                <div class="modal-header">
                                                    <h5 class="modal-title text-danger">
                                                        <i class="bi bi-exclamation-triangle-fill me-1"></i> Xác nhận xóa bài viết
                                                    </h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body">
                                                    Bạn có chắc chắn muốn xóa bài viết <strong>"@post.Title"</strong>? Hành động này không thể hoàn tác.
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-sm btn-light" data-bs-dismiss="modal">Hủy</button>
                                                    <form method="post" asp-controller="DentistBlog" asp-action="Delete" asp-route-id="@post.BlogPostId">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-sm btn-danger">Xác Nhận Xóa</button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            @if (totalPages > 1)
            {
                <div class="p-3 border-top d-flex justify-content-between align-items-center">
                    <span class="small text-muted">
                        Trang <strong>@currentPage</strong> / <strong>@totalPages</strong> (Tổng @Model.PagedResult.TotalCount bài)
                    </span>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                            <a class="page-link" asp-controller="DentistBlog" asp-action="Index"
                               asp-route-status="@Model.CurrentStatus"
                               asp-route-keyword="@Model.CurrentKeyword"
                               asp-route-page="@(currentPage - 1)">Trước</a>
                        </li>
                        @for (int p = 1; p <= totalPages; p++)
                        {
                            <li class="page-item @(p == currentPage ? "active" : "")">
                                <a class="page-link" asp-controller="DentistBlog" asp-action="Index"
                                   asp-route-status="@Model.CurrentStatus"
                                   asp-route-keyword="@Model.CurrentKeyword"
                                   asp-route-page="@p">@p</a>
                            </li>
                        }
                        <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                            <a class="page-link" asp-controller="DentistBlog" asp-action="Index"
                               asp-route-status="@Model.CurrentStatus"
                               asp-route-keyword="@Model.CurrentKeyword"
                               asp-route-page="@(currentPage + 1)">Sau</a>
                        </li>
                    </ul>
                </div>
            }
        }
        else
        {
            <div class="p-5 text-center">
                <i class="bi bi-journal-plus display-4 text-muted mb-3 d-block"></i>
                <h5 class="fw-bold text-dark mb-2">Bạn chưa có bài viết nào</h5>
                <p class="text-muted small mb-4" style="max-width: 420px; margin: 0 auto;">
                    Hãy chia sẻ kiến thức nha khoa hữu ích đến với bệnh nhân và cộng đồng ngay hôm nay.
                </p>
                <a asp-controller="DentistBlog" asp-action="Create" class="btn btn-primary rounded-pill px-4">
                    <i class="bi bi-plus-circle me-1"></i> Soạn Bài Viết Đầu Tiên
                </a>
            </div>
        }
    </div>
</div>
