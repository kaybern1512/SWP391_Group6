@model DentalClinic.Web.ViewModels.Appointments.DentistTodayAppointmentsViewModel
@{
    var today = DateOnly.FromDateTime(DateTime.Today);
    var tomorrow = today.AddDays(1);
    var yesterday = today.AddDays(-1);
    var isToday = Model.SelectedDate == today;
    var isTomorrow = Model.SelectedDate == tomorrow;
    var displayTitle = isToday ? "Lịch Thăm Khám Hôm Nay" : (isTomorrow ? "Lịch Thăm Khám Ngày Mai" : $"Lịch Thăm Khám Ngày {Model.SelectedDate:dd/MM/yyyy}");
    ViewData["Title"] = displayTitle;
}

<div class="container-fluid px-0">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-calendar2-week text-primary me-2"></i>@displayTitle
            </h1>
            <p class="text-muted mb-0">
                Ngày khám: <strong class="text-primary">@Model.SelectedDate.ToString("dd/MM/yyyy")</strong>
                @(isToday ? " (Hôm nay)" : (isTomorrow ? " (Ngày mai)" : ""))
                &bull; Bác sĩ chuyên khoa phụ trách điều trị
            </p>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <div class="btn-group shadow-sm">
                <a asp-action="Today" asp-route-date="@today.ToString("yyyy-MM-dd")" class="btn btn-sm @(isToday ? "btn-primary fw-semibold" : "btn-outline-primary")">
                    Hôm Nay
                </a>
                <a asp-action="Today" asp-route-date="@tomorrow.ToString("yyyy-MM-dd")" class="btn btn-sm @(isTomorrow ? "btn-primary fw-semibold" : "btn-outline-primary")">
                    Ngày Mai
                </a>
            </div>

            <form method="get" asp-action="Today" class="d-flex align-items-center gap-1">
                <input type="date" name="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" onchange="this.form.submit()" class="form-control form-control-sm shadow-sm" style="width: 150px;" title="Chọn ngày xem lịch khám" />
            </form>

            <a asp-controller="DentistSchedule" asp-action="Schedule" class="btn btn-sm btn-outline-secondary shadow-sm" title="Mở lịch làm việc tháng">
                <i class="bi bi-calendar-month me-1"></i>Xem Lịch Tháng
            </a>

            <span class="badge bg-primary fs-6 px-3 py-2 ms-2">
                @Model.Appointments.Count ca khám
            </span>
        </div>
    </div>

    @if (Model.Appointments.Count == 0)
    {
        <div class="card border-0 shadow-sm text-center py-5">
            <div class="card-body">
                <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px;">
                    <i class="bi bi-calendar-event fs-2 text-muted"></i>
                </div>
                <h5 class="fw-bold text-dark">Không có ca khám nào vào ngày @Model.SelectedDate.ToString("dd/MM/yyyy")</h5>
                <p class="text-muted mb-3">Bạn hiện không có lịch hẹn khám nào được phân bổ trong ngày này.</p>
                <div class="d-flex justify-content-center gap-2">
                    @if (!isToday)
                    {
                        <a asp-action="Today" asp-route-date="@today.ToString("yyyy-MM-dd")" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-calendar-check me-1"></i>Xem Lịch Hôm Nay
                        </a>
                    }
                    <a asp-controller="DentistSchedule" asp-action="Schedule" class="btn btn-primary btn-sm">
                        <i class="bi bi-calendar-month me-1"></i>Xem Lịch Làm Việc Cả Tháng
                    </a>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0 fw-bold text-dark">
                    <i class="bi bi-person-workspace me-2 text-primary"></i>Danh sách bệnh nhân tiếp nhận hôm nay
                </h5>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3 text-center" style="width: 90px;">STT</th>
                            <th>Mã Hẹn</th>
                            <th>Bệnh Nhân</th>
                            <th>Dịch Vụ Khám</th>
                            <th>Khung Giờ</th>
                            <th>Vị Trí Ghế</th>
                            <th>Lý Do Khám</th>
                            <th>Trạng Thái</th>
                            <th class="text-end pe-3">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var appt in Model.Appointments)
                        {
                            <tr>
                                <td class="ps-3 text-center">
                                    @if (!string.IsNullOrEmpty(appt.QueueNumber))
                                    {
                                        <div class="badge bg-primary fs-5 px-3 py-2 font-monospace shadow-sm">
                                            @appt.QueueNumber
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">--</span>
                                    }
                                </td>
                                <td>
                                    <span class="fw-bold font-monospace text-dark">@appt.AppointmentCode</span>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@appt.PatientName</div>
                                    <div class="text-muted small">Mã: @appt.PatientCode &bull; SĐT: @(appt.PatientPhone ?? "N/A")</div>
                                </td>
                                <td>
                                    <div class="fw-semibold text-primary">@appt.ServiceName</div>
                                    <div class="text-muted small">@appt.DepartmentName</div>
                                </td>
                                <td>
                                    <div class="fw-bold text-success fs-6">
                                        @(appt.ScheduledStart?.ToString("HH:mm") ?? "--") - @(appt.ScheduledEnd?.ToString("HH:mm") ?? "--")
                                    </div>
                                    <div class="text-muted small">Thời lượng: @(appt.DurationMinutes ?? 30) phút</div>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark"><i class="bi bi-geo-alt me-1 text-danger"></i>@(appt.RoomName ?? "--")</div>
                                    @if (appt.DentalChairId.HasValue && !string.IsNullOrWhiteSpace(appt.DentalChairName))
                                    {
                                        <div class="text-success small fw-semibold d-flex align-items-center gap-1 mt-1">
                                            <i class="bi bi-check-circle"></i> Ghế: @appt.DentalChairName
                                            <button type="button" class="btn btn-link p-0 text-muted ms-1" style="font-size: 0.75rem;" title="Đổi ghế khác" onclick="openPickChairModal(@appt.AppointmentId, '@appt.PatientName', '@(appt.RoomName ?? "")', @appt.DentalChairId.Value)">
                                                <i class="bi bi-arrow-repeat"></i>
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="mt-1">
                                            <button type="button" class="btn btn-sm btn-outline-warning text-dark py-0 px-2 d-inline-flex align-items-center gap-1 shadow-sm" style="font-size: 0.78rem;" onclick="openPickChairModal(@appt.AppointmentId, '@appt.PatientName', '@(appt.RoomName ?? "")', 0)">
                                                <i class="bi bi-pin-map text-warning"></i> <strong>Pick Ghế</strong>
                                            </button>
                                        </div>
                                    }
                                </td>
                                <td style="max-width: 220px;">
                                    <div class="small text-truncate" title="@appt.ReasonForVisit">
                                        @appt.ReasonForVisit
                                    </div>
                                </td>
                                <td>
                                    @switch (appt.Status)
                                    {
                                        case "CheckedIn":
                                            <span class="badge bg-success px-3 py-2">
                                                <i class="bi bi-person-check me-1"></i>Đã Check-in
                                            </span>
                                            break;
                                        case "Confirmed":
                                            <span class="badge bg-info text-dark px-3 py-2">
                                                <i class="bi bi-clock me-1"></i>Chờ đến phòng khám
                                            </span>
                                            break;
                                        case "InService":
                                            <span class="badge bg-primary px-3 py-2">
                                                <i class="bi bi-activity me-1"></i>Đang điều trị
                                            </span>
                                            break;
                                        case "Completed":
                                            <span class="badge bg-secondary px-3 py-2">
                                                <i class="bi bi-check-all me-1"></i>Đã xong
                                            </span>
                                            break;
                                        case "Cancelled":
                                        case "Rejected":
                                            <span class="badge bg-danger px-3 py-2">
                                                <i class="bi bi-x-circle me-1"></i>@(appt.Status == "Rejected" ? "Từ chối" : "Đã hủy")
                                            </span>
                                            break;
                                        case "PendingReceptionReview":
                                        case "PendingDepartmentReview":
                                            <span class="badge bg-warning text-dark px-3 py-2">
                                                <i class="bi bi-hourglass-split me-1"></i>Chờ duyệt
                                            </span>
                                            break;
                                        default:
                                            <span class="badge bg-light text-dark border px-3 py-2">@appt.Status</span>
                                            break;
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <div class="d-flex align-items-center justify-content-end gap-1">
                                        @if (appt.Status == "CheckedIn" || appt.Status == "Confirmed")
                                        {
                                            <form asp-controller="DentistAppointment" asp-action="Start" asp-route-id="@appt.AppointmentId" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                                                <button type="submit" class="btn btn-sm btn-success fw-semibold shadow-sm" title="Tiếp nhận bệnh nhân vào ghế điều trị">
                                                    <i class="bi bi-play-circle me-1"></i>Vào Khám
                                                </button>
                                            </form>
                                        }
                                        else if (appt.Status == "InService")
                                        {
                                            <form asp-controller="DentistAppointment" asp-action="Complete" asp-route-id="@appt.AppointmentId" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                                                <button type="submit" class="btn btn-sm btn-primary fw-semibold shadow-sm" title="Hoàn tất buổi khám và điều trị">
                                                    <i class="bi bi-check-circle me-1"></i>Hoàn Thành
                                                </button>
                                            </form>
                                        }

                                        <a asp-controller="DentistMedicalRecord" asp-action="Index" asp-route-patientId="@appt.PatientUserId" asp-route-appointmentId="@appt.AppointmentId" class="btn btn-sm btn-outline-primary" title="Mở hồ sơ bệnh án & Sơ đồ răng">
                                            <i class="bi bi-journal-medical me-1"></i> Bệnh Án
                                        </a>
                                        <a asp-controller="DentistTreatmentPlan" asp-action="Create" asp-route-patientId="@appt.PatientUserId" class="btn btn-sm btn-outline-info" title="Lập phác đồ & kế hoạch điều trị cho bệnh nhân">
                                            <i class="bi bi-diagram-3 me-1"></i>Phác Đồ
                                        </a>
                                        @if (appt.Status == "InService" || appt.Status == "Completed")
                                        {
                                            <a asp-controller="DentistPrescription" asp-action="Index" asp-route-search="@appt.PatientCode" class="btn btn-sm btn-outline-success" title="Kê đơn hoặc xem đơn thuốc">
                                                <i class="bi bi-capsule me-1"></i>Đơn Thuốc
                                            </a>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-secondary opacity-50" disabled title="Bác sĩ cần vào khám và chẩn đoán trước khi kê đơn thuốc">
                                                <i class="bi bi-capsule me-1"></i>Đơn Thuốc
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<!-- Modal Chọn Ghế Điều Trị Cho Bác Sĩ -->
<div class="modal fade" id="pickChairModal" tabindex="-1" aria-labelledby="pickChairModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold" id="pickChairModalLabel">
                    <i class="bi bi-pin-map me-2"></i>Chọn Ghế Nha Khoa Điều Trị
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="pickChairForm" method="post" action="">
                @Html.AntiForgeryToken()
                <input type="hidden" name="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                <div class="modal-body p-4">
                    <div class="alert alert-light border mb-3">
                        <div class="small text-muted">Bệnh nhân: <strong id="modalPatientName" class="text-dark">--</strong></div>
                        <div class="small text-muted">Phòng điều trị: <strong id="modalRoomName" class="text-primary">--</strong></div>
                    </div>

                    <label class="form-label fw-bold mb-2">Danh sách ghế trong phòng:</label>
                    <div id="chairsLoading" class="text-center py-3">
                        <div class="spinner-border text-primary spinner-border-sm me-2" role="status"></div>
                        <span class="text-muted small">Đang tải danh sách ghế...</span>
                    </div>

                    <div id="chairsContainer" class="d-flex flex-column gap-2" style="display: none;">
                        <!-- Ghế render động -->
                    </div>

                    <div id="chairsEmpty" class="text-center py-3 text-muted small" style="display: none;">
                        <i class="bi bi-info-circle me-1"></i>Không tìm thấy ghế nào đang hoạt động trong phòng khám này.
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" id="btnSubmitPickChair" class="btn btn-primary fw-semibold" disabled>
                        <i class="bi bi-check2-circle me-1"></i>Xác Nhận Ghế
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openPickChairModal(apptId, patientName, roomName, currentChairId) {
            document.getElementById('modalPatientName').innerText = patientName;
            document.getElementById('modalRoomName').innerText = roomName || 'Phòng khám chuyên khoa';
            const form = document.getElementById('pickChairForm');
            form.action = `/Dentist/Appointments/${apptId}/AssignChair`;

            const loading = document.getElementById('chairsLoading');
            const container = document.getElementById('chairsContainer');
            const empty = document.getElementById('chairsEmpty');
            const submitBtn = document.getElementById('btnSubmitPickChair');

            loading.style.display = 'block';
            container.style.display = 'none';
            empty.style.display = 'none';
            submitBtn.disabled = true;
            container.innerHTML = '';

            fetch(`/Dentist/Appointments/${apptId}/RoomChairs`)
                .then(res => res.json())
                .then(result => {
                    loading.style.display = 'none';
                    if (result.success && result.data && result.data.length > 0) {
                        container.style.display = 'flex';
                        result.data.forEach(chair => {
                            const isSelected = currentChairId && currentChairId === chair.dentalChairId;
                            const isOccupied = chair.isOccupied;
                            const div = document.createElement('div');
                            div.className = `p-3 rounded border d-flex justify-content-between align-items-center ${isOccupied ? 'bg-light border-danger text-muted' : (isSelected ? 'bg-primary-subtle border-primary' : 'bg-white')}`;
                            div.style.cursor = isOccupied ? 'not-allowed' : 'pointer';

                            div.innerHTML = `
                                <div class="d-flex align-items-center gap-2">
                                    <input class="form-check-input mt-0" type="radio" name="dentalChairId" id="chairRadio_${chair.dentalChairId}" value="${chair.dentalChairId}" ${isSelected ? 'checked' : ''} ${isOccupied ? 'disabled' : ''}>
                                    <label class="form-check-label fw-semibold cursor-pointer mb-0" for="chairRadio_${chair.dentalChairId}">
                                        <i class="bi bi-badge-hd me-1"></i> Ghế ${chair.chairCode}
                                    </label>
                                </div>
                                <div>
                                    ${isOccupied 
                                        ? '<span class="badge bg-danger-subtle text-danger border border-danger small"><i class="bi bi-person-fill-exclamation me-1"></i>Đang bận</span>' 
                                        : '<span class="badge bg-success-subtle text-success border border-success small"><i class="bi bi-check-circle me-1"></i>Sẵn sàng</span>'}
                                </div>
                            `;

                            if (!isOccupied) {
                                div.addEventListener('click', () => {
                                    const radio = div.querySelector('input[type="radio"]');
                                    radio.checked = true;
                                    submitBtn.disabled = false;
                                    container.querySelectorAll('.p-3').forEach(el => el.classList.remove('bg-primary-subtle', 'border-primary'));
                                    div.classList.add('bg-primary-subtle', 'border-primary');
                                });
                            }

                            container.appendChild(div);
                        });

                        if (currentChairId) {
                            submitBtn.disabled = false;
                        }
                    } else {
                        empty.style.display = 'block';
                    }
                })
                .catch(err => {
                    loading.style.display = 'none';
                    empty.style.display = 'block';
                    empty.innerText = 'Không thể tải danh sách ghế từ máy chủ.';
                });

            const modal = new bootstrap.Modal(document.getElementById('pickChairModal'));
            modal.show();
        }
    </script>
}
