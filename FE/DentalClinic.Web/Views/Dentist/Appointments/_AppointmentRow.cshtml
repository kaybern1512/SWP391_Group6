@model DentalClinic.Web.Models.ApiDtos.AppointmentDto
@{
    var currentDate = ViewData["CurrentDate"] as string ?? (Model.ScheduledStart?.ToString("yyyy-MM-dd") ?? DateTime.Today.ToString("yyyy-MM-dd"));
    var returnUrl = ViewData["ReturnUrl"] as string ?? "";
    var isExamining = Model.Status == "InService" || Model.Status == "InProgress";
}

<tr>
    <td class="ps-3 text-center">
        @if (!string.IsNullOrEmpty(Model.QueueNumber))
        {
            <div class="badge bg-primary fs-5 px-3 py-2 font-monospace shadow-sm">
                @Model.QueueNumber
            </div>
        }
        else
        {
            <span class="text-muted font-monospace">--</span>
        }
    </td>
    <td>
        <span class="fw-bold font-monospace text-dark">@Model.AppointmentCode</span>
        @if (Model.ScheduledStart.HasValue)
        {
            <div class="text-muted small">@Model.ScheduledStart.Value.ToString("dd/MM/yyyy")</div>
        }
    </td>
    <td>
        <div class="fw-bold text-dark">@Model.PatientName</div>
        <div class="text-muted small">Mã: @Model.PatientCode &bull; SĐT: @(Model.PatientPhone ?? "N/A")</div>
    </td>
    <td>
        <div class="fw-semibold text-primary">@Model.ServiceName</div>
        <div class="text-muted small">@Model.DepartmentName</div>
        @if (Model.Services != null && Model.Services.Count > 1)
        {
            <div class="mt-1">
                <span class="badge bg-light text-dark border small" title="@string.Join(", ", Model.Services.Select(s => s.ServiceName))">
                    <i class="bi bi-collection me-1"></i>@(Model.Services.Count) dịch vụ liên khoa
                </span>
            </div>
        }
    </td>
    <td>
        <div class="fw-bold text-success fs-6">
            @(Model.ScheduledStart?.ToString("HH:mm") ?? "--") - @(Model.ScheduledEnd?.ToString("HH:mm") ?? "--")
        </div>
        <div class="text-muted small">Thời lượng: @(Model.DurationMinutes ?? 30) phút</div>
    </td>
    <td>
        <div class="fw-semibold text-dark"><i class="bi bi-geo-alt me-1 text-danger"></i>@(Model.RoomName ?? "--")</div>
        @if (Model.DentalChairId.HasValue && !string.IsNullOrWhiteSpace(Model.DentalChairName))
        {
            <div class="text-success small fw-semibold d-flex align-items-center gap-1 mt-1">
                <i class="bi bi-check-circle"></i> Ghế: @Model.DentalChairName
                @if (Model.Status != "Completed" && Model.Status != "Cancelled")
                {
                    <button type="button" class="btn btn-link p-0 text-muted ms-1" style="font-size: 0.75rem;" title="Đổi ghế khác" onclick="openPickChairModal(@Model.AppointmentId, '@Model.PatientName', '@(Model.RoomName ?? "")', @Model.DentalChairId.Value)">
                        <i class="bi bi-arrow-repeat"></i>
                    </button>
                }
                else
                {
                    <span class="text-muted ms-1 small" title="Ca khám đã hoàn tất, vị trí ghế đã được khóa"><i class="bi bi-lock-fill"></i></span>
                }
            </div>
        }
        else
        {
            @if (Model.Status != "Completed" && Model.Status != "Cancelled")
            {
                <div class="mt-1">
                    <button type="button" class="btn btn-sm btn-outline-warning text-dark py-0 px-2 d-inline-flex align-items-center gap-1 shadow-sm" style="font-size: 0.78rem;" onclick="openPickChairModal(@Model.AppointmentId, '@Model.PatientName', '@(Model.RoomName ?? "")', 0)">
                        <i class="bi bi-pin-map text-warning"></i> <strong>Pick Ghế</strong>
                    </button>
                </div>
            }
            else
            {
                <div class="text-muted small mt-1"><em>(Chưa gán ghế)</em></div>
            }
        }
    </td>
    <td style="max-width: 200px;">
        <div class="small text-truncate" title="@Model.ReasonForVisit">
            @(string.IsNullOrWhiteSpace(Model.ReasonForVisit) ? "--" : Model.ReasonForVisit)
        </div>
    </td>
    <td>
        @switch (Model.Status)
        {
            case "CheckedIn":
                <span class="badge bg-success px-3 py-2">
                    <i class="bi bi-person-check me-1"></i>Đã Check-in
                </span>
                break;
            case "Confirmed":
                <span class="badge bg-info text-dark px-3 py-2">
                    <i class="bi bi-clock me-1"></i>Chờ đến phòng khám
                </span>
                break;
            case "InProgress":
            case "InService":
                <span class="badge bg-primary px-3 py-2">
                    <i class="bi bi-heart-pulse-fill me-1"></i>Đang điều trị
                </span>
                break;
            case "Completed":
                <span class="badge bg-secondary px-3 py-2">
                    <i class="bi bi-check-all me-1"></i>Đã xong
                </span>
                break;
            case "Cancelled":
            case "Rejected":
                <span class="badge bg-danger px-3 py-2">
                    <i class="bi bi-x-circle me-1"></i>@(Model.Status == "Rejected" ? "Từ chối" : "Đã hủy")
                </span>
                break;
            case "PendingReceptionReview":
            case "PendingDepartmentReview":
                <span class="badge bg-warning text-dark px-3 py-2">
                    <i class="bi bi-hourglass-split me-1"></i>Chờ duyệt
                </span>
                break;
            default:
                <span class="badge bg-light text-dark border px-3 py-2">@Model.Status</span>
                break;
        }
    </td>
    <td class="text-end pe-3">
        <div class="d-flex align-items-center justify-content-end gap-1 flex-wrap">
            @if (Model.Status == "CheckedIn" || Model.Status == "Waiting")
            {
                @if (Model.DentalChairId.HasValue && Model.DentalChairId.Value > 0)
                {
                    <form asp-controller="DentistAppointment" asp-action="Start" asp-route-id="@Model.AppointmentId" method="post" class="d-inline start-exam-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="date" value="@currentDate" />
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <button type="submit" class="btn btn-sm btn-primary fw-semibold shadow-sm text-nowrap btn-start-exam" title="Tiếp nhận bệnh nhân vào ghế và bắt đầu khám bệnh">
                            <i class="bi bi-box-arrow-in-right me-1"></i>Vào Khám
                        </button>
                    </form>
                }
                else
                {
                    <button type="button" class="btn btn-sm btn-warning text-dark fw-semibold shadow-sm text-nowrap" onclick="openPickChairModal(@Model.AppointmentId, '@Model.PatientName', '@(Model.RoomName ?? "")', 0)" title="Vui lòng chọn ghế nha khoa trước khi vào khám">
                        <i class="bi bi-pin-map-fill me-1"></i>Chọn Ghế Để Khám
                    </button>
                }
            }
            else if (Model.Status == "Confirmed")
            {
                <span class="badge bg-secondary-subtle text-secondary border px-2 py-1 small" title="Chờ bệnh nhân làm thủ tục check-in tại quầy tiếp đón">
                    <i class="bi bi-hourglass me-1"></i>Chờ Check-in
                </span>
            }
            else if (Model.Status == "InService" || Model.Status == "InProgress")
            {
                <a asp-controller="DentistMedicalRecord" asp-action="Index" 
                   asp-route-patientId="@Model.PatientUserId" 
                   asp-route-appointmentId="@Model.AppointmentId" 
                   asp-route-isExamining="true" 
                   class="btn btn-sm btn-success fw-semibold shadow-sm text-nowrap pulse-btn" 
                   title="Mở hồ sơ bệnh án và tiếp tục buổi khám & điều trị">
                    <i class="bi bi-heart-pulse-fill me-1"></i>Tiếp Tục Khám
                </a>
            }

            <a asp-controller="DentistMedicalRecord" asp-action="Index" asp-route-patientId="@Model.PatientUserId" asp-route-appointmentId="@Model.AppointmentId" class="btn btn-sm btn-outline-primary" title="Xem trước hồ sơ bệnh án & Sơ đồ răng">
                <i class="bi bi-journal-medical me-1"></i> Bệnh Án
            </a>
            <a asp-controller="DentistTreatmentPlan" asp-action="Create" asp-route-patientId="@Model.PatientUserId" class="btn btn-sm btn-outline-info" title="Lập phác đồ & kế hoạch điều trị cho bệnh nhân">
                <i class="bi bi-diagram-3 me-1"></i>Phác Đồ
            </a>
            @if (Model.Status == "InService" || Model.Status == "InProgress")
            {
                <button type="button" class="btn btn-sm btn-outline-warning text-dark fw-semibold shadow-sm text-nowrap btn-order-xray" 
                        data-bs-toggle="modal" data-bs-target="#orderXrayModal-@Model.AppointmentId" 
                        title="Chỉ định chụp X-quang cho bệnh nhân">
                    <i class="bi bi-camera-fill text-warning me-1"></i>Chỉ Định X-Quang
                </button>

                <div class="dropdown d-inline">
                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle fw-semibold text-nowrap" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Điều phối ca điều trị khi sắp hết ca trực">
                        <i class="bi bi-hourglass-split me-1"></i>Hết Ca Trực
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow">
                        <li>
                            <button class="dropdown-item py-2" type="button" data-bs-toggle="modal" data-bs-target="#continueAfternoonModal-@Model.AppointmentId">
                                <i class="bi bi-sun text-warning me-2"></i><strong>Tiếp Tục Ca Chiều (Nghỉ trưa)</strong>
                            </button>
                        </li>
                        <li>
                            <button class="dropdown-item py-2" type="button" data-bs-toggle="modal" data-bs-target="#recommendAnotherDayModal-@Model.AppointmentId">
                                <i class="bi bi-calendar-event text-primary me-2"></i><strong>Hẹn Điều Trị Ngày Khác</strong>
                            </button>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <button class="dropdown-item py-2 text-danger" type="button" data-bs-toggle="modal" data-bs-target="#flagDelayModal-@Model.AppointmentId">
                                <i class="bi bi-exclamation-triangle-fill text-danger me-2"></i><strong>Báo Trễ Ca (Ưu tiên cao)</strong>
                            </button>
                        </li>
                    </ul>
                </div>
            }

            @if (Model.Status == "InService" || Model.Status == "InProgress" || Model.Status == "Completed")
            {
                <a asp-controller="DentistPrescription" 
                   asp-action="Index" 
                   asp-route-appointmentId="@Model.AppointmentId" 
                   asp-route-search="@Model.PatientCode" 
                   asp-route-autoOpen="true" 
                   asp-route-returnUrl="@returnUrl" 
                   class="btn btn-sm btn-outline-success fw-medium" 
                   title="Kê đơn thuốc trực tiếp cho ca khám này">
                    <i class="bi bi-capsule me-1"></i>Đơn Thuốc
                </a>
            }
            else
            {
                <button type="button" class="btn btn-sm btn-outline-secondary opacity-50" disabled title="Bác sĩ cần vào khám và chẩn đoán trước khi kê đơn thuốc">
                    <i class="bi bi-capsule me-1"></i>Đơn Thuốc
                </button>
            }
        </div>

        @if (Model.Status == "InService" || Model.Status == "InProgress")
        {
            <!-- Modal Chỉ Định X-Quang -->
            <div class="modal fade text-start" id="orderXrayModal-@Model.AppointmentId" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <form asp-controller="DentistAppointment" asp-action="OrderXray" asp-route-id="@Model.AppointmentId" method="post" id="orderXrayForm-@Model.AppointmentId">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                            <div class="modal-header bg-light">
                                <h5 class="modal-title fw-bold">
                                    <i class="bi bi-camera-fill text-warning me-2"></i>Chỉ Định Chụp X-Quang
                                </h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <div class="alert alert-info py-2 px-3 small mb-3">
                                    <strong>Bệnh nhân:</strong> @Model.PatientName (@Model.PatientCode) &bull; <strong>Ca khám:</strong> #@Model.AppointmentId
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Loại Phim Chụp X-Quang <span class="text-danger">*</span></label>
                                    <select name="diagnosticType" id="selectDiagType-@Model.AppointmentId" class="form-select" required>
                                        <option value="Panorama" selected>Panorama (Toàn cảnh hàm răng)</option>
                                        <option value="Intraoral">Intraoral (Cận chóp răng)</option>
                                        <option value="Cephalometric">Cephalometric (Sọ nghiêng)</option>
                                        <option value="CBCT" disabled>CBCT (Cone Beam CT 3D) - Chưa hỗ trợ</option>
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Chỉ Định Lâm Sàng / Lý Do Chụp <span class="text-danger">*</span></label>
                                    <textarea name="clinicalIndication" id="textareaIndication-@Model.AppointmentId" class="form-control" rows="3" required placeholder="Nhập yêu cầu lâm sàng...">Chụp Panorama kiểm tra tình trạng răng và cấu trúc xương hàm</textarea>
                                </div>
                            </div>
                            <div class="modal-footer bg-light">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                                <button type="submit" class="btn btn-primary fw-semibold" id="btnSubmitOrderXray-@Model.AppointmentId">
                                    <i class="bi bi-send-check me-1"></i>Xác Nhận Chỉ Định
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Modal Tiếp Tục Ca Chiều -->
            <div class="modal fade text-start" id="continueAfternoonModal-@Model.AppointmentId" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <form asp-controller="DentistAppointment" asp-action="ContinueAfternoon" asp-route-id="@Model.AppointmentId" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                            <div class="modal-header bg-warning text-dark">
                                <h5 class="modal-title fw-bold">
                                    <i class="bi bi-sun text-dark me-2"></i>Tiếp Tục Ca Khám Buổi Chiều (Option A)
                                </h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <div class="alert alert-info py-2 px-3 small mb-3">
                                    <strong>Bệnh nhân:</strong> @Model.PatientName (@Model.PatientCode) &bull; <strong>Dịch vụ:</strong> @Model.ServiceName
                                </div>
                                <div class="alert alert-success small mb-3">
                                    <i class="bi bi-shield-check me-1"></i>
                                    Hệ thống tạm dừng phiên sáng an toàn, giải phóng ghế điều trị trong giờ nghỉ trưa (12:00–13:00) và tạo phiên tiếp nối buổi chiều với <strong>Đơn giá 0 đ</strong> (không tính tiền hai lần, không trừ kép kho thuốc).
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Thời gian bắt đầu ca chiều <span class="text-danger">*</span></label>
                                    <input type="datetime-local" name="continuationStart" class="form-control" value="@(DateTime.Today.AddHours(13).AddMinutes(30).ToString("yyyy-MM-ddTHH:mm"))" required />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Thời lượng dự kiến (phút) <span class="text-danger">*</span></label>
                                    <input type="number" name="durationMinutes" class="form-control" value="45" min="15" max="240" step="15" required />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Ghi chú lâm sàng / Lý do tiếp tục</label>
                                    <textarea name="notes" class="form-control" rows="2" placeholder="Tạm dừng ca sáng do hết giờ ca trực, giải phóng ghế và tiếp tục lúc 13:30..."></textarea>
                                </div>
                            </div>
                            <div class="modal-footer bg-light">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                                <button type="submit" class="btn btn-warning fw-bold text-dark">
                                    <i class="bi bi-pause-circle me-1"></i>Tạm Dừng &amp; Chuyển Ca Chiều
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Modal Hẹn Điều Trị Ngày Khác -->
            <div class="modal fade text-start" id="recommendAnotherDayModal-@Model.AppointmentId" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <form asp-controller="DentistAppointment" asp-action="RecommendAnotherDay" asp-route-id="@Model.AppointmentId" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                            <div class="modal-header bg-primary text-white">
                                <h5 class="modal-title fw-bold">
                                    <i class="bi bi-calendar-event me-2"></i>Hẹn Điều Trị Ngày Khác (Option B)
                                </h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <div class="alert alert-info py-2 px-3 small mb-3">
                                    <strong>Bệnh nhân:</strong> @Model.PatientName (@Model.PatientCode) &bull; <strong>Dịch vụ:</strong> @Model.ServiceName
                                </div>
                                <div class="alert alert-warning small mb-3">
                                    <i class="bi bi-info-circle me-1"></i>
                                    Hệ thống ghi nhận khối lượng công việc đã hoàn thành và còn lại, tạo lịch tái khám đề xuất (Proposed) và giữ nguyên phác đồ điều trị đang thực hiện.
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Ngày hẹn điều trị tiếp theo <span class="text-danger">*</span></label>
                                    <input type="date" name="recommendedDate" class="form-control" value="@(DateTime.Today.AddDays(7).ToString("yyyy-MM-dd"))" min="@(DateTime.Today.AddDays(1).ToString("yyyy-MM-dd"))" required />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Lý do chuyên môn <span class="text-danger">*</span></label>
                                    <input type="text" name="clinicalReason" class="form-control" value="Hết thời lượng ca trực, hẹn tiếp tục giai đoạn tiếp theo" required />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Nội dung công việc đã hoàn tất</label>
                                    <textarea name="completedNotes" class="form-control" rows="2" placeholder="Ví dụ: Đã mở tủy, làm sạch ống tủy số 1..."></textarea>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Nội dung điều trị còn lại</label>
                                    <textarea name="remainingNotes" class="form-control" rows="2" placeholder="Ví dụ: Trám bít ống tủy vĩnh viễn và hàn thẩm mỹ răng..."></textarea>
                                </div>
                            </div>
                            <div class="modal-footer bg-light">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                                <button type="submit" class="btn btn-primary fw-bold">
                                    <i class="bi bi-calendar-check me-1"></i>Xác Nhận Hẹn Ngày Khác
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Modal Báo Trễ Ca -->
            <div class="modal fade text-start" id="flagDelayModal-@Model.AppointmentId" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <form asp-controller="DentistAppointment" asp-action="FlagDelay" asp-route-id="@Model.AppointmentId" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                            <div class="modal-header bg-danger text-white">
                                <h5 class="modal-title fw-bold">
                                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Báo Trễ Ca Lâm Sàng (Option C)
                                </h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <div class="alert alert-danger py-2 px-3 small mb-3">
                                    <strong>Cảnh báo khẩn:</strong> Ca khám đang diễn ra phức tạp, chưa thể tạm dừng an toàn và cần thêm thời gian can thiệp lâm sàng.
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Lý do chuyên môn chưa thể dừng ca <span class="text-danger">*</span></label>
                                    <textarea name="notes" class="form-control" rows="3" required placeholder="Ví dụ: Ống tủy vôi hóa phức tạp đang cầm máu, không thể tạm dừng an toàn trước 12:00..."></textarea>
                                </div>
                                <p class="text-muted small mb-0">Hệ thống sẽ gửi thông báo ưu tiên cao đến Quầy Lễ Tân để điều phối các bệnh nhân kế tiếp.</p>
                            </div>
                            <div class="modal-footer bg-light">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                                <button type="submit" class="btn btn-danger fw-bold">
                                    <i class="bi bi-broadcast me-1"></i>Phát Tín Hiệu Cảnh Báo
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    </td>
</tr>
