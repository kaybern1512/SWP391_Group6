    <!-- Modal Xác Nhận Xóa Phim Chụp -->
    <div class="modal fade" id="modalConfirmDeleteImaging" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>Xác Nhận Xóa Phim Chụp
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form asp-action="DeleteImagingRecord" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="deleteImagingRecordId" name="imagingRecordId" value="0" />
                    <input type="hidden" name="patientUserId" value="@(record.PatientUserId)" />
                    <div class="modal-body p-4 text-center">
                        <i class="bi bi-trash text-danger" style="font-size: 3rem;"></i>
                        <h5 class="mt-3 text-slate-800">Bạn có chắc chắn muốn xóa phim chụp này?</h5>
                        <p class="text-muted small mb-0">Hành động này sẽ xóa dữ liệu trên máy chủ Cloudinary và gỡ bỏ hình ảnh khỏi hồ sơ bệnh án.</p>
                        <div class="alert alert-light border mt-3 text-start small">
                            <div><strong>Loại phim:</strong> <span id="deleteImagingTypePreview"></span></div>
                            <div><strong>Kết luận:</strong> <span id="deleteImagingResultPreview"></span></div>
                        </div>
                    </div>
                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
                        <button type="submit" class="btn btn-danger px-4 fw-medium">
                            <i class="bi bi-trash-fill me-1"></i> Xác Nhận Xóa
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        function openAddImagingModal(entryId, diagnosis) {
            document.getElementById('addImagingClinicalEntryId').value = entryId;
            document.getElementById('addImagingDiagnosisPreview').textContent = diagnosis || ('Đợt khám #' + entryId);
            // Reset form
            const fileInput = document.getElementById('imagingFileInput');
            if (fileInput) fileInput.value = '';
            const previewContainer = document.getElementById('imagePreviewContainer');
            if (previewContainer) previewContainer.classList.add('d-none');
            new bootstrap.Modal(document.getElementById('modalAddImaging')).show();
        }

        // Xem trước ảnh khi chọn từ máy tính
        function previewSelectedImage(input) {
            const previewContainer = document.getElementById('imagePreviewContainer');
            const previewImg = document.getElementById('imagePreview');
            const dicomNotice = document.getElementById('dicomPreviewNotice');

            if (!input.files || input.files.length === 0) {
                previewContainer.classList.add('d-none');
                return;
            }

            const file = input.files[0];
            const fileName = file.name.toLowerCase();

            // Kiểm tra dung lượng 15MB
            if (file.size > 15 * 1024 * 1024) {
                alert('Tập tin vượt quá kích thước cho phép 15 MB. Vui lòng chọn tập tin khác.');
                input.value = '';
                previewContainer.classList.add('d-none');
                return;
            }

            previewContainer.classList.remove('d-none');

            if (fileName.endsWith('.dcm')) {
                previewImg.classList.add('d-none');
                dicomNotice.classList.remove('d-none');
            } else {
                dicomNotice.classList.add('d-none');
                previewImg.classList.remove('d-none');

                const reader = new FileReader();
                reader.onload = function(e) {
                    previewImg.src = e.target.result;
                };
                reader.readAsDataURL(file);
            }
        }

        // Bật spinner khi submit upload
        document.addEventListener('DOMContentLoaded', function() {
            const formAdd = document.getElementById('formAddImaging');
            if (formAdd) {
                formAdd.addEventListener('submit', function() {
                    const btn = document.getElementById('btnSubmitImaging');
                    const text = document.getElementById('btnSubmitText');
                    const spinner = document.getElementById('btnSubmitSpinner');
                    if (btn && spinner && text) {
                        btn.disabled = true;
                        text.classList.add('d-none');
                        spinner.classList.remove('d-none');
                    }
                });
            }
        });

        // Xóa ảnh xác nhận
        function confirmDeleteImaging(id, type, summary) {
            document.getElementById('deleteImagingRecordId').value = id;
            document.getElementById('deleteImagingTypePreview').textContent = type || 'Phim X-quang';
            document.getElementById('deleteImagingResultPreview').textContent = summary || 'Không có ghi chú';
            new bootstrap.Modal(document.getElementById('modalConfirmDeleteImaging')).show();
        }

        // ==========================================
        // LIGHTBOX CONTROLS (Zoom, Rotate, Pan)
        // ==========================================
        let currentZoom = 1;
        let currentRotation = 0;
        let isDragging = false;
        let startX, startY, translateX = 0, translateY = 0;

        function openImagingLightbox(url, type, date, summary, isDicom, downloadUrl) {
            currentZoom = 1;
            currentRotation = 0;
            translateX = 0;
            translateY = 0;

            const dlUrl = downloadUrl || url;
            document.getElementById('lightboxImagingType').textContent = type || 'Phim X-Quang';
            document.getElementById('lightboxImagingDate').textContent = date ? ('Chụp ngày: ' + date) : '';
            document.getElementById('lightboxResultSummary').textContent = summary || 'Không có mô tả bổ sung.';
            document.getElementById('lightboxDownloadBtn').href = dlUrl;

            const imgEl = document.getElementById('lightboxImg');
            const wrapper = document.getElementById('lightboxImageWrapper');
            const dicomPlaceholder = document.getElementById('lightboxDicomPlaceholder');
            const dicomDownloadBtn = document.getElementById('lightboxDicomDownloadBtn');

            if (isDicom) {
                wrapper.classList.add('d-none');
                dicomPlaceholder.classList.remove('d-none');
                dicomDownloadBtn.href = dlUrl;
            } else {
                dicomPlaceholder.classList.add('d-none');
                wrapper.classList.remove('d-none');
                imgEl.src = url;
                updateLightboxTransform();
            }

            new bootstrap.Modal(document.getElementById('modalImagingLightbox')).show();
        }

        function updateLightboxTransform() {
            const wrapper = document.getElementById('lightboxImageWrapper');
            if (wrapper) {
                wrapper.style.transform = `translate(${translateX}px, ${translateY}px) scale(${currentZoom}) rotate(${currentRotation}deg)`;
            }
        }

        function lightboxZoomIn() {
            if (currentZoom < 5) {
                currentZoom += 0.25;
                updateLightboxTransform();
            }
        }

        function lightboxZoomOut() {
            if (currentZoom > 0.5) {
                currentZoom -= 0.25;
                updateLightboxTransform();
            }
        }

        function lightboxRotate() {
            currentRotation = (currentRotation + 90) % 360;
            updateLightboxTransform();
        }

        function lightboxReset() {
            currentZoom = 1;
            currentRotation = 0;
            translateX = 0;
            translateY = 0;
            updateLightboxTransform();
        }

        function handleLightboxWheel(e) {
            e.preventDefault();
            if (e.deltaY < 0) {
                lightboxZoomIn();
            } else {
                lightboxZoomOut();
            }
        }

        // Kéo rê ảnh (Pan) khi đã zoom
        document.addEventListener('DOMContentLoaded', function() {
            const wrapper = document.getElementById('lightboxImageWrapper');
            if (wrapper) {
                wrapper.addEventListener('mousedown', function(e) {
                    isDragging = true;
                    startX = e.clientX - translateX;
                    startY = e.clientY - translateY;
                    wrapper.style.cursor = 'grabbing';
                });

                window.addEventListener('mousemove', function(e) {
                    if (!isDragging) return;
                    translateX = e.clientX - startX;
                    translateY = e.clientY - startY;
                    updateLightboxTransform();
                });

                window.addEventListener('mouseup', function() {
                    isDragging = false;
                    if (wrapper) wrapper.style.cursor = 'grab';
                });
            }
        });

        // ==========================================
        // ODONTOGRAM ROW LOGIC (GIỮ NGUYÊN)
        // ==========================================
        function addToothRow() {
            const container = document.getElementById("toothRowsContainer");
            if (!container) return;
            const rowId = "tooth-row-" + Date.now();
            const rowHtml = `
                <div class="row g-2 align-items-center tooth-input-row" id="${rowId}">
                    <div class="col-md-3">
                        <select class="form-select form-select-sm tooth-number-select">
                            <option value="">-- Chọn Răng --</option>
                            @for (int i = 18; i >= 11; i--) { <option value="@i">Răng @i</option> }
                            @for (int i = 21; i <= 28; i++) { <option value="@i">Răng @i</option> }
                            @for (int i = 48; i >= 41; i--) { <option value="@i">Răng @i</option> }
                            @for (int i = 31; i <= 38; i++) { <option value="@i">Răng @i</option> }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <select class="form-select form-select-sm tooth-condition-select">
                            <option value="Caries">Sâu răng (Caries)</option>
                            <option value="Filled">Đã trám (Filled)</option>
                            <option value="Pulpitis">Viêm tủy (Pulpitis)</option>
                            <option value="Crown">Bọc sứ (Crown)</option>
                            <option value="Missing">Mất răng (Missing)</option>
                            <option value="ExtractionNeeded">Cần nhổ (Extraction)</option>
                            <option value="Healthy">Khỏe mạnh (Healthy)</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <input type="text" class="form-control form-control-sm tooth-note-input" placeholder="Ghi chú (mặt răng O, M, D...)" />
                    </div>
                    <div class="col-md-1 text-end">
                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="document.getElementById('${rowId}').remove()"><i class="bi bi-trash"></i></button>
                    </div>
                </div>`;
            container.insertAdjacentHTML('beforeend', rowHtml);
        }

        function prepareToothConditionsJson() {
            const rows = document.querySelectorAll(".tooth-input-row");
            const list = [];
            rows.forEach(r => {
                const toothNum = r.querySelector(".tooth-number-select").value;
                const cond = r.querySelector(".tooth-condition-select").value;
                const note = r.querySelector(".tooth-note-input").value;
                if (toothNum) {
                    list.push({
                        toothNumber: toothNum,
                        condition: cond,
                        surface: "All",
                        note: note
                    });
                }
            });
            document.getElementById("toothConditionsJsonInput").value = JSON.stringify(list);
        }

        document.addEventListener("DOMContentLoaded", function() {
            if (document.getElementById("toothRowsContainer")) {
                addToothRow();
            }
        });
    </script>
}
