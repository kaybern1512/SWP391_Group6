@using DentalClinic.Web.Models.ApiDtos
@model DentalClinic.Web.ViewModels.MedicalRecord.DentistMedicalRecordIndexViewModel
@{
    ViewData["Title"] = "Hồ Sơ Bệnh Án & Sơ Đồ Răng (EMR)";
    var record = Model.SelectedRecord;
}

@section Styles {
    <link rel="stylesheet" href="~/css/medical-imaging-viewer.css" asp-append-version="true" />
}

<style>
    /* Odontogram Styles */
    .odontogram-wrapper {
        background: #f8fafc;
        border-radius: 12px;
        padding: 20px;
        border: 1px solid #e2e8f0;
    }
    .arch-container {
        display: flex;
        justify-content: center;
        gap: 6px;
        flex-wrap: wrap;
        margin-bottom: 12px;
    }
    .quadrant-group {
        display: flex;
        gap: 5px;
    }
    .quadrant-divider {
        width: 2px;
        background: #cbd5e1;
        margin: 0 8px;
    }
    .tooth-card {
        width: 46px;
        min-height: 74px;
        height: auto;
        background: #ffffff;
        border: 2px solid #cbd5e1;
        border-radius: 8px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: space-between;
        padding: 4px 2px 3px 2px;
        cursor: pointer;
        transition: all 0.2s ease;
        position: relative;
        gap: 2px;
        box-sizing: border-box;
    }
    .tooth-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        border-color: #0284c7;
    }
    .tooth-number {
        font-size: 0.75rem;
        font-weight: 700;
        color: #1e293b;
        line-height: 1.1;
    }
    .tooth-icon {
        font-size: 1.1rem;
        line-height: 1;
        margin: 1px 0;
    }
    .tooth-status-tag {
        font-size: 0.52rem;
        font-weight: 700;
        line-height: 1.15;
        padding: 2px 1px;
        border-radius: 3px;
        text-transform: uppercase;
        width: 100%;
        text-align: center;
        word-break: break-word;
        overflow-wrap: break-word;
        white-space: normal;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 14px;
        box-sizing: border-box;
    }

    /* Tooth Condition Colors */
    .tooth-healthy { border-color: #94a3b8; }
    .tooth-healthy .tooth-icon { color: #64748b; }
    .tooth-healthy .tooth-status-tag { background: #f1f5f9; color: #475569; }

    .tooth-caries { border-color: #ef4444; background: #fff1f2; }
    .tooth-caries .tooth-icon { color: #dc2626; }
    .tooth-caries .tooth-status-tag { background: #fee2e2; color: #b91c1c; }

    .tooth-filled { border-color: #0284c7; background: #f0f9ff; }
    .tooth-filled .tooth-icon { color: #0284c7; }
    .tooth-filled .tooth-status-tag { background: #e0f2fe; color: #0369a1; }

    .tooth-missing { border-color: #64748b; background: #e2e8f0; opacity: 0.6; }
    .tooth-missing .tooth-icon { color: #475569; }
    .tooth-missing .tooth-status-tag { background: #cbd5e1; color: #334155; }

    .tooth-crown { border-color: #eab308; background: #fefce8; }
    .tooth-crown .tooth-icon { color: #ca8a04; }
    .tooth-crown .tooth-status-tag { background: #fef9c3; color: #a16207; }

    .tooth-pulpitis { border-color: #a855f7; background: #faf5ff; }
    .tooth-pulpitis .tooth-icon { color: #9333ea; }
    .tooth-pulpitis .tooth-status-tag { background: #f3e8ff; color: #7e22ce; }

    .tooth-extractionneeded { border-color: #f97316; background: #fff7ed; }
    .tooth-extractionneeded .tooth-icon { color: #ea580c; }
    .tooth-extractionneeded .tooth-status-tag { background: #ffedd5; color: #c2410c; }

    /* Imaging Gallery & Lightbox Styles */
    .img-thumbnail-fit {
        object-fit: cover;
        object-position: center;
        transition: transform 0.25s ease;
    }
    .imaging-preview-container:hover .img-thumbnail-fit {
        transform: scale(1.05);
    }
    .imaging-zoom-overlay {
        transition: opacity 0.2s ease;
        pointer-events: none;
    }
    .imaging-preview-container:hover .imaging-zoom-overlay {
        opacity: 1 !important;
    }
    .fs-11 { font-size: 0.72rem; }
    .text-truncate-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .btn-xs {
        padding: 0.15rem 0.5rem;
        font-size: 0.75rem;
        border-radius: 4px;
    }
    .bg-purple-subtle { background-color: #f3e8ff; color: #7e22ce; }
    .border-purple-subtle { border-color: #d8b4fe !important; }
</style>

<div class="container-fluid px-4 py-4">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary-subtle text-primary fw-medium px-2 py-1 fs-12">
                    <i class="bi bi-journal-medical me-1"></i> Bác sĩ nha khoa
                </span>
                <span class="badge bg-light text-muted fw-normal px-2 py-1 fs-12">Clinical EMR & Odontogram</span>
            </div>
            <h1 class="h3 fw-bold text-slate-800 mb-0">Hồ Sơ Bệnh Án & Sơ Đồ Răng Điện Tử</h1>
            <p class="text-muted small mb-0 mt-1">Tra cứu bệnh án, theo dõi tình trạng răng miệng 32 răng và ghi nhận chẩn đoán điều trị</p>
        </div>
        @if (record != null)
        {
            <button type="button" class="btn btn-primary d-flex align-items-center gap-2 shadow-sm" data-bs-toggle="modal" data-bs-target="#modalCreateClinicalEntry">
                <i class="bi bi-clipboard2-plus-fill"></i>
                <span>Ghi Nhận Chẩn Đoán Mới</span>
            </button>
        }
    </div>


    <div class="row g-4">
        <!-- Left: Patient Search & List -->
        <div class="col-lg-4 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white border-0 py-3">
                    <h6 class="fw-bold text-slate-800 mb-2">Tra Cứu Bệnh Nhân</h6>
                    <form method="get" class="input-group input-group-sm">
                        <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Tên, Mã BN, SĐT...">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i></button>
                        @if (!string.IsNullOrEmpty(Model.Search))
                        {
                            <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i></a>
                        }
                    </form>
                </div>
                <div class="list-group list-group-flush overflow-auto" style="max-height: 650px;">
                    @if (Model.Patients.Any())
                    {
                        foreach (var p in Model.Patients)
                        {
                            var isActive = p.PatientUserId == Model.SelectedPatientUserId;
                            <a asp-action="Index" asp-route-patientId="@p.PatientUserId" asp-route-search="@Model.Search" 
                               class="list-group-item list-group-item-action p-3 @(isActive ? "active text-white bg-primary border-primary" : "")">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div class="fw-bold @(isActive ? "text-white" : "text-dark")">@p.FullName</div>
                                    <span class="badge @(isActive ? "bg-white text-primary" : "bg-light text-muted border") fs-11">@p.PatientCode</span>
                                </div>
                                <div class="small @(isActive ? "text-white-50" : "text-muted") mt-1">
                                    <i class="bi bi-telephone me-1"></i>@(p.PhoneNumber ?? "Chưa có SĐT")
                                </div>
                                <div class="small @(isActive ? "text-white-50" : "text-muted")">
                                    <i class="bi bi-gender-ambiguous me-1"></i>@(p.Gender ?? "—") • @(p.DateOfBirth?.ToString("dd/MM/yyyy") ?? "—")
                                </div>
                            </a>
                        }
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted small">
                            <i class="bi bi-person-x fs-3 d-block mb-1"></i>
                            Không tìm thấy bệnh nhân nào.
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Right: Medical Record Detail & Odontogram -->
        <div class="col-lg-8 col-xl-9">
            @if (record != null)
            {
                <!-- Patient Banner -->
                <div class="card border-0 shadow-sm rounded-3 mb-4 bg-white p-3">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="bg-primary-subtle text-primary p-3 rounded-circle fs-3 fw-bold">
                                <i class="bi bi-person"></i>
                            </div>
                            <div>
                                <div class="d-flex align-items-center gap-2">
                                    <h4 class="fw-bold text-slate-800 mb-0">@record.PatientName</h4>
                                    <span class="badge bg-secondary-subtle text-secondary border">@record.PatientCode</span>
                                </div>
                                <div class="text-muted small mt-1 d-flex flex-wrap gap-3">
                                    <span><i class="bi bi-telephone me-1"></i>@(record.PatientPhone ?? "—")</span>
                                    <span><i class="bi bi-gender-ambiguous me-1"></i>@(record.Gender ?? "—")</span>
                                    <span><i class="bi bi-calendar3 me-1"></i>@(record.DateOfBirth?.ToString("dd/MM/yyyy") ?? "—") (@(record.Age.HasValue ? $"{record.Age} tuổi" : "—"))</span>
                                    <span><i class="bi bi-geo-alt me-1"></i>@(record.Address ?? "—")</span>
                                </div>
                            </div>
                        </div>
                        <div class="text-end">
                            <div class="text-muted small">Ngày mở hồ sơ:</div>
                            <div class="fw-bold text-dark">@record.CreatedAt.ToString("dd/MM/yyyy")</div>
                        </div>
                    </div>
                </div>

                <!-- Odontogram (32 FDI Teeth Chart) -->
                <div class="card border-0 shadow-sm rounded-3 mb-4">
                    <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                        <h5 class="card-title fw-bold text-slate-800 mb-0 d-flex align-items-center gap-2">
                            <i class="bi bi-grid-3x3-gap-fill text-primary"></i>
                            <span>Sơ Đồ Răng Khám Bệnh (Odontogram - Hệ FDI)</span>
                        </h5>
                        <span class="badge bg-light text-muted border">32 Răng người lớn</span>
                    </div>
                    <div class="card-body p-4">
                        <div class="odontogram-wrapper">
                            <!-- Upper Arch (Hàm Trên) -->
                            <div class="text-center small fw-bold text-muted mb-2 text-uppercase letter-spacing-1">
                                <i class="bi bi-arrow-up-circle me-1"></i> Hàm Trên (Maxillary)
                            </div>
                            <div class="arch-container">
                                <!-- Q1: 18 -> 11 -->
                                <div class="quadrant-group">
                                    @for (int i = 18; i >= 11; i--)
                                    {
                                        var tStr = i.ToString();
                                        var tooth = record.CurrentOdontogram.FirstOrDefault(x => x.ToothNumber == tStr) ?? new OdontogramEntryDto { ToothNumber = tStr, Condition = "Healthy" };
                                        var condClass = $"tooth-{tooth.Condition.ToLower()}";
                                        <div class="tooth-card @condClass" title="Răng @tStr: @tooth.Condition @(string.IsNullOrEmpty(tooth.Note) ? "" : $"({tooth.Note})")">
                                            <span class="tooth-number">@tStr</span>
                                            <i class="bi bi-shield-fill tooth-icon"></i>
                                            <span class="tooth-status-tag">@tooth.Condition</span>
                                        </div>
                                    }
                                </div>
                                <div class="quadrant-divider"></div>
                                <!-- Q2: 21 -> 28 -->
                                <div class="quadrant-group">
                                    @for (int i = 21; i <= 28; i++)
                                    {
                                        var tStr = i.ToString();
                                        var tooth = record.CurrentOdontogram.FirstOrDefault(x => x.ToothNumber == tStr) ?? new OdontogramEntryDto { ToothNumber = tStr, Condition = "Healthy" };
                                        var condClass = $"tooth-{tooth.Condition.ToLower()}";
                                        <div class="tooth-card @condClass" title="Răng @tStr: @tooth.Condition @(string.IsNullOrEmpty(tooth.Note) ? "" : $"({tooth.Note})")">
                                            <span class="tooth-number">@tStr</span>
                                            <i class="bi bi-shield-fill tooth-icon"></i>
                                            <span class="tooth-status-tag">@tooth.Condition</span>
                                        </div>
                                    }
                                </div>
                            </div>

                            <hr class="my-3 text-slate-300" />

                            <!-- Lower Arch (Hàm Dưới) -->
                            <div class="arch-container">
                                <!-- Q4: 48 -> 41 -->
                                <div class="quadrant-group">
                                    @for (int i = 48; i >= 41; i--)
                                    {
                                        var tStr = i.ToString();
                                        var tooth = record.CurrentOdontogram.FirstOrDefault(x => x.ToothNumber == tStr) ?? new OdontogramEntryDto { ToothNumber = tStr, Condition = "Healthy" };
                                        var condClass = $"tooth-{tooth.Condition.ToLower()}";
                                        <div class="tooth-card @condClass" title="Răng @tStr: @tooth.Condition @(string.IsNullOrEmpty(tooth.Note) ? "" : $"({tooth.Note})")">
                                            <span class="tooth-number">@tStr</span>
                                            <i class="bi bi-shield-fill tooth-icon"></i>
                                            <span class="tooth-status-tag">@tooth.Condition</span>
                                        </div>
                                    }
                                </div>
                                <div class="quadrant-divider"></div>
                                <!-- Q3: 31 -> 38 -->
                                <div class="quadrant-group">
                                    @for (int i = 31; i <= 38; i++)
                                    {
                                        var tStr = i.ToString();
                                        var tooth = record.CurrentOdontogram.FirstOrDefault(x => x.ToothNumber == tStr) ?? new OdontogramEntryDto { ToothNumber = tStr, Condition = "Healthy" };
                                        var condClass = $"tooth-{tooth.Condition.ToLower()}";
                                        <div class="tooth-card @condClass" title="Răng @tStr: @tooth.Condition @(string.IsNullOrEmpty(tooth.Note) ? "" : $"({tooth.Note})")">
                                            <span class="tooth-number">@tStr</span>
                                            <i class="bi bi-shield-fill tooth-icon"></i>
                                            <span class="tooth-status-tag">@tooth.Condition</span>
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="text-center small fw-bold text-muted mt-2 text-uppercase letter-spacing-1">
                                <i class="bi bi-arrow-down-circle me-1"></i> Hàm Dưới (Mandibular)
                            </div>
                        </div>

                        <!-- Odontogram Color Legend -->
                        <div class="d-flex flex-wrap align-items-center justify-content-center gap-3 mt-3 pt-2 text-muted fs-12">
                            <span class="d-flex align-items-center gap-1"><span class="badge bg-secondary p-1 rounded-circle"></span> Khỏe mạnh</span>
                            <span class="d-flex align-items-center gap-1"><span class="badge bg-danger p-1 rounded-circle"></span> Sâu răng (Caries)</span>
                            <span class="d-flex align-items-center gap-1"><span class="badge bg-primary p-1 rounded-circle"></span> Đã trám (Filled)</span>
                            <span class="d-flex align-items-center gap-1"><span class="badge bg-dark p-1 rounded-circle"></span> Mất răng (Missing)</span>
                            <span class="d-flex align-items-center gap-1"><span class="badge bg-warning p-1 rounded-circle"></span> Bọc sứ (Crown)</span>
                            <span class="d-flex align-items-center gap-1"><span class="badge bg-info p-1 rounded-circle"></span> Viêm tủy (Pulpitis)</span>
                            <span class="d-flex align-items-center gap-1"><span class="badge bg-danger-subtle border border-danger p-1 rounded-circle"></span> Cần nhổ</span>
                        </div>
                    </div>
                </div>

                <!-- Clinical Entries History Timeline -->
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-header bg-white border-0 py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <h5 class="card-title fw-bold text-slate-800 mb-0 d-flex align-items-center gap-2">
                            <i class="bi bi-clock-history text-primary"></i>
                            <span>Lịch Sử Khám & Chẩn Đoán Lâm Sàng</span>
                            <span class="badge bg-secondary-subtle text-secondary rounded-pill fs-12 ms-1">@record.ClinicalEntries.Count đợt khám</span>
                        </h5>
                        <div class="d-flex align-items-center gap-2">
                            <button type="button" id="btnOpenComparison" class="btn btn-sm btn-outline-primary fw-semibold d-inline-flex align-items-center gap-1 shadow-sm" onclick="openComparisonModal()" title="So sánh 2 ảnh X-quang Trước / Sau của bệnh nhân">
                                <i class="bi bi-layout-split"></i>
                                <span>So Sánh Phim (Before / After)</span>
                            </button>
                        </div>
                    </div>
                    <div class="card-body p-4 pt-2">
                        @if (record.ClinicalEntries.Any())
                        {
                            <div class="timeline-container">
                                @foreach (var entry in record.ClinicalEntries)
                                {
                                    <div class="card border rounded-3 p-3 mb-3 bg-light-subtle">
                                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2 pb-2 border-bottom">
                                            <div>
                                                <span class="fw-bold text-dark fs-15">
                                                    <i class="bi bi-calendar-event me-1 text-primary"></i>Ngày khám: @entry.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                                </span>
                                                <span class="text-muted small ms-2">Bác sĩ: <strong>@entry.DentistName</strong></span>
                                            </div>
                                            @if (!string.IsNullOrEmpty(entry.AppointmentCode))
                                            {
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                                    <i class="bi bi-ticket-perforated me-1"></i>@entry.AppointmentCode
                                                </span>
                                            }
                                        </div>

                                        <div class="row g-3 fs-14">
                                            @if (!string.IsNullOrEmpty(entry.Symptoms))
                                            {
                                                <div class="col-md-6">
                                                    <div class="text-muted small fw-semibold">Triệu chứng đến khám:</div>
                                                    <div class="text-slate-800">@entry.Symptoms</div>
                                                </div>
                                            }
                                            @if (!string.IsNullOrEmpty(entry.ClinicalFindings))
                                            {
                                                <div class="col-md-6">
                                                    <div class="text-muted small fw-semibold">Tiền sử & Dấu hiệu lâm sàng:</div>
                                                    <div class="text-slate-800">@entry.ClinicalFindings</div>
                                                </div>
                                            }
                                            <div class="col-12">
                                                <div class="text-muted small fw-semibold">Chẩn đoán chính:</div>
                                                <div class="fw-bold text-primary fs-15">@entry.Diagnosis</div>
                                            </div>
                                            @if (!string.IsNullOrEmpty(entry.ClinicalNotes))
                                            {
                                                <div class="col-12">
                                                    <div class="text-muted small fw-semibold">Kế hoạch điều trị & Lời dặn:</div>
                                                    <div class="text-muted fst-italic">@entry.ClinicalNotes</div>
                                                </div>
                                            }
                                            @if (entry.OdontogramEntries.Any())
                                            {
                                                <div class="col-12">
                                                    <div class="text-muted small fw-semibold mb-1">Răng tổn thương & can thiệp trong đợt này:</div>
                                                    <div class="d-flex flex-wrap gap-2">
                                                        @foreach (var tooth in entry.OdontogramEntries)
                                                        {
                                                            <span class="badge bg-light text-dark border px-2 py-1 fs-12">
                                                                Răng <strong>@tooth.ToothNumber</strong>: @tooth.Condition @(string.IsNullOrEmpty(tooth.Note) ? "" : $"({tooth.Note})")
                                                            </span>
                                                        }
                                                    </div>
                                                </div>
                                            }

                                            <!-- Dental Imaging Thumbnail Gallery -->
                                            <div class="col-12 mt-3 pt-3 border-top">
                                                <div class="d-flex justify-content-between align-items-center mb-2">
                                                    <span class="text-muted small fw-bold text-uppercase d-flex align-items-center gap-1">
                                                        <i class="bi bi-images text-primary"></i>
                                                        <span>Thư Viện Phim X-quang & Cận Lâm Sàng</span>
                                                        <span class="badge bg-primary-subtle text-primary ms-1">@entry.ImagingRecords.Count</span>
                                                    </span>
                                                </div>

                                                @if (entry.ImagingRecords.Any())
                                                {
                                                    <div class="row g-3">
                                                        @foreach (var img in entry.ImagingRecords)
                                                        {
                                                            var isDicom = (!string.IsNullOrEmpty(img.FileUrl) && (img.FileUrl.EndsWith(".dcm", StringComparison.OrdinalIgnoreCase) || img.FileUrl.EndsWith(".dicom", StringComparison.OrdinalIgnoreCase))) ||
                                                                          img.ImagingType.Equals("DICOM", StringComparison.OrdinalIgnoreCase);
                                                            var safeUrl = Url.Action("ImagingContent", "DentistMedicalRecord", new { imagingRecordId = img.ImagingRecordId });
                                                            var badgeColor = img.ImagingType switch
                                                            {
                                                                "Panorama" => "bg-primary-subtle text-primary border-primary-subtle",
                                                                "Periapical" => "bg-info-subtle text-info border-info-subtle",
                                                                "Cephalometric" => "bg-purple-subtle text-purple border-purple-subtle",
                                                                "Intraoral" => "bg-success-subtle text-success border-success-subtle",
                                                                _ => "bg-secondary-subtle text-secondary border-secondary-subtle"
                                                            };

                                                            <div class="col-6 col-md-4 col-lg-3">
                                                                <div class="card h-100 border rounded-3 shadow-none overflow-hidden imaging-thumbnail-card bg-white">
                                                                    <div class="d-flex align-items-center justify-content-between px-2 pt-2 pb-1 border-bottom bg-light-subtle">
                                                                        <span class="badge @badgeColor small text-truncate fw-semibold">
                                                                            <i class="bi bi-film me-1"></i>@img.ImagingType
                                                                        </span>
                                                                        <span class="text-muted fs-11" title="@img.CreatedAt.ToString("dd/MM/yyyy HH:mm")">
                                                                            @img.CreatedAt.ToString("dd/MM/yyyy")
                                                                        </span>
                                                                    </div>

                                                                    @if (isDicom)
                                                                    {
                                                                        <div class="p-3 text-center bg-light d-flex flex-column align-items-center justify-content-center" style="min-height: 140px;">
                                                                            <i class="bi bi-file-earmark-medical-fill text-primary" style="font-size: 2.2rem;"></i>
                                                                            <span class="badge bg-primary-subtle text-primary border mt-2 small">DICOM PS 3.10</span>
                                                                            <span class="text-muted small mt-1" style="font-size: 0.75rem;">Định dạng y tế chuyên dụng</span>
                                                                            <a href="@safeUrl" class="btn btn-xs btn-outline-primary mt-2" download>
                                                                                <i class="bi bi-download me-1"></i> Tải file .dcm
                                                                            </a>
                                                                        </div>
                                                                    }
                                                                    else
                                                                    {
                                                                        <div class="imaging-preview-container position-relative bg-dark text-center" style="height: 140px; cursor: pointer;"
                                                                             onclick="openImagingLightbox('@safeUrl', '@img.ImagingType', '@(img.ResultSummary?.Replace("'", "\\'") ?? "")', '@img.CreatedAt.ToString("dd/MM/yyyy HH:mm")', false)"
                                                                             title="Nhấn để phóng to xem chi tiết">
                                                                            <img src="@safeUrl"
                                                                                 class="w-100 h-100 img-thumbnail-fit"
                                                                                 alt="@img.ImagingType"
                                                                                 loading="lazy"
                                                                                 onerror="this.onerror=null; this.parentElement.innerHTML='<div class=\'p-3 text-center text-muted small h-100 d-flex flex-column align-items-center justify-content-center\'><i class=\'bi bi-image-fill fs-2 text-secondary mb-1\'></i> Không thể tải ảnh an toàn</div>';" />
                                                                            <div class="imaging-zoom-overlay position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center text-white bg-dark bg-opacity-25 opacity-0">
                                                                                <i class="bi bi-zoom-in fs-4"></i>
                                                                            </div>
                                                                        </div>
                                                                    }

                                                                    <div class="p-2 border-top bg-white flex-grow-1 d-flex flex-column justify-content-between">
                                                                        <div class="small text-slate-700 text-truncate-2" title="@img.ResultSummary">
                                                                            <i class="bi bi-chat-left-text me-1 text-muted"></i>
                                                                            @if (!string.IsNullOrWhiteSpace(img.ResultSummary))
                                                                            {
                                                                                <span>@img.ResultSummary</span>
                                                                            }
                                                                            else
                                                                            {
                                                                                <span class="text-muted fst-italic">Chưa có kết luận</span>
                                                                            }
                                                                        </div>
                                                                        @if (User.IsInRole("Dentist"))
                                                                        {
                                                                            <div class="d-flex justify-content-end align-items-center gap-1 mt-2 pt-1 border-top border-light">
                                                                                @if (!isDicom)
                                                                                {
                                                                                    <button type="button" class="btn btn-xs btn-outline-primary"
                                                                                            onclick="openComparisonWithImage(@img.ImagingRecordId)"
                                                                                            title="Mở so sánh với ảnh này">
                                                                                        <i class="bi bi-layout-split me-1"></i> So sánh
                                                                                    </button>
                                                                                }
                                                                                <button type="button" class="btn btn-xs btn-outline-danger"
                                                                                        onclick="openDeleteImagingModal(@img.ImagingRecordId, '@(img.ImagingType)', '@(img.CreatedAt.ToString("dd/MM/yyyy HH:mm"))', @(record.PatientUserId))"
                                                                                        title="Xóa phim X-quang">
                                                                                    <i class="bi bi-trash3-fill me-1"></i> Xóa
                                                                                </button>
                                                                            </div>
                                                                        }
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="text-center py-3 px-2 bg-light-subtle rounded-3 border border-dashed text-muted small my-2">
                                                        <i class="bi bi-film fs-4 d-block mb-1 text-secondary opacity-50"></i>
                                                        <span>Chưa có phim X-quang hoặc ảnh răng nào cho ca khám này.</span>
                                                    </div>
                                                }
                                            </div>

                                            @if (User.IsInRole("Dentist"))
                                            {
                                                <div class="col-12 text-end mt-2">
                                                    <button type="button" class="btn btn-sm btn-outline-primary fw-medium" onclick="openUploadImagingModal(@entry.ClinicalEntryId, '@(entry.Diagnosis?.Replace("'", "\\'") ?? "")')">
                                                        <i class="bi bi-cloud-arrow-up-fill me-1"></i> Upload Phim X-quang / Ảnh Răng
                                                    </button>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5 text-muted">
                                <i class="bi bi-journal-x fs-1 d-block mb-2 text-secondary"></i>
                                Bệnh nhân chưa có lượt ghi nhận chẩn đoán lâm sàng nào.
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="card border-0 shadow-sm rounded-3 p-5 text-center text-muted">
                    <i class="bi bi-person-lines-fill fs-1 d-block mb-2 text-secondary"></i>
                    <h5>Vui lòng chọn một bệnh nhân từ danh sách bên trái để xem hồ sơ bệnh án điện tử và sơ đồ răng.</h5>
                </div>
            }
        </div>
    </div>
</div>

<!-- ==================================================== -->
<!-- MODAL: GHI NHẬN CHẨN ĐOÁN LÂM SÀNG & CẬP NHẬT RĂNG -->
<!-- ==================================================== -->
@if (record != null)
{
    <div class="modal fade" id="modalCreateClinicalEntry" tabindex="-1" aria-labelledby="modalCreateClinicalEntryLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold" id="modalCreateClinicalEntryLabel">
                        <i class="bi bi-clipboard2-plus-fill me-2"></i>Ghi Nhận Chẩn Đoán Bệnh Án Cho @record.PatientName
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-action="CreateEntry" method="post" enctype="multipart/form-data" id="formCreateClinicalEntry">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="PatientUserId" value="@record.PatientUserId" />
                    <input type="hidden" name="AppointmentId" value="@(Model.NewEntryForm?.AppointmentId)" />
                    <input type="hidden" id="toothConditionsJsonInput" name="ToothConditionsJson" value="[]" />

                    <div class="modal-body p-4">
                        @if (Model.NewEntryForm?.AppointmentId.HasValue == true)
                        {
                            <div class="alert alert-info py-2 px-3 mb-3 small d-flex align-items-center gap-2">
                                <i class="bi bi-calendar2-check-fill text-primary"></i>
                                <span>Đang ghi nhận chẩn đoán liên kết ca khám bệnh ID: <strong>#@Model.NewEntryForm.AppointmentId</strong>.</span>
                            </div>
                        }
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-slate-700" for="newEntryDiagnosis">Chẩn đoán chính của bác sĩ <span class="text-danger">*</span></label>
                            <input type="text" id="newEntryDiagnosis" name="Diagnosis" class="form-control" placeholder="Ví dụ: Sâu răng mặt nhai R16, Viêm nướu quanh răng R46..." required />
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-slate-700" for="newEntrySymptoms">Triệu chứng đến khám</label>
                                <textarea id="newEntrySymptoms" name="Symptoms" class="form-control" rows="2" placeholder="Ví dụ: Ê buốt khi ăn đồ lạnh, đau nhức về đêm..."></textarea>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-slate-700" for="newEntryClinicalFindings">Tiền sử bệnh & Dấu hiệu lâm sàng</label>
                                <textarea id="newEntryClinicalFindings" name="ClinicalFindings" class="form-control" rows="2" placeholder="Ví dụ: Dị ứng Penicillin, huyết áp ổn định..."></textarea>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-slate-700" for="newEntryClinicalNotes">Kế hoạch điều trị & Lời dặn</label>
                            <textarea id="newEntryClinicalNotes" name="ClinicalNotes" class="form-control" rows="2" placeholder="Ví dụ: Trám composite R16, hẹn tái khám sau 1 tuần..."></textarea>
                        </div>

                        <!-- Chỉ Định Chụp X-Quang / Cận Lâm Sàng -->
                        <div class="border rounded-3 p-3 bg-light mb-3">
                            <label class="form-label fw-bold text-slate-800 d-flex justify-content-between align-items-center mb-2">
                                <span><i class="bi bi-camera-fill me-1 text-info"></i> Chỉ Định Chụp Phim X-Quang / Cận Lâm Sàng:</span>
                            </label>
                            <div class="row g-2">
                                <div class="col-md-5">
                                    <select name="ImagingType" id="createEntryImagingType" class="form-select form-select-sm">
                                        <option value="">-- Không yêu cầu chụp phim --</option>
                                        <option value="Panorama">Toàn cảnh Panorama (OPG)</option>
                                        <option value="Periapical">Cận chóp / Quanh chóp (Periapical)</option>
                                        <option value="Cephalometric">Phim sọ nghiêng Cephalometric</option>
                                        <option value="Intraoral">Ảnh chụp trong miệng (Intraoral)</option>
                                    </select>
                                </div>
                                <div class="col-md-7">
                                    <input type="text" name="ImagingResultSummary" id="createEntryImagingResultSummary" class="form-control form-control-sm" placeholder="Vị trí/mục đích chụp (VD: Khảo sát răng ngầm R48, cuống răng R16...)" />
                                </div>

                                <!-- File Upload & Preview Section -->
                                <div class="col-12 mt-2">
                                    <div class="card border rounded-3 p-2 bg-white">
                                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                                            <div class="d-flex align-items-center gap-2">
                                                <input type="file"
                                                       id="createEntryImagingFileInput"
                                                       name="ImagingFile"
                                                       class="d-none"
                                                       accept=".jpg,.jpeg,.png,.dcm,.dicom" />
                                                <button type="button"
                                                        id="btnSelectImagingFile"
                                                        class="btn btn-sm btn-outline-primary fw-medium"
                                                        onclick="document.getElementById('createEntryImagingFileInput').click()">
                                                    <i class="bi bi-cloud-arrow-up-fill me-1"></i> Chọn ảnh X-quang
                                                </button>
                                                <span class="text-muted small" id="createEntryFileHint">
                                                    <i class="bi bi-info-circle me-1"></i>(Tùy chọn nếu đã chụp) Hỗ trợ JPG, JPEG, PNG, DICOM (.dcm, .dicom) — Tối đa 15 MB.
                                                </span>
                                            </div>
                                            <button type="button"
                                                    id="btnRemoveImagingFile"
                                                    class="btn btn-sm btn-link text-danger text-decoration-none p-0 d-none"
                                                    onclick="clearCreateEntryImagingFile()">
                                                <i class="bi bi-x-circle me-1"></i>Hủy chọn ảnh
                                            </button>
                                        </div>

                                        <!-- Validation Error Alert -->
                                        <div id="createEntryFileError" class="text-danger small mt-2 d-none">
                                            <i class="bi bi-exclamation-triangle-fill me-1"></i><span id="createEntryFileErrorText"></span>
                                        </div>

                                        <!-- Preview Box -->
                                        <div id="createEntryFilePreviewContainer" class="mt-2 pt-2 border-top d-none">
                                            <!-- Image Preview (JPG / PNG) -->
                                            <div id="createEntryImagePreviewCard" class="d-none d-flex align-items-center gap-3 p-2 rounded bg-light border">
                                                <div class="position-relative" style="width: 72px; height: 72px; flex-shrink: 0;">
                                                    <img id="createEntryImagePreviewThumb"
                                                         src=""
                                                         alt="Xem trước ảnh X-quang"
                                                         class="w-100 h-100 rounded object-fit-cover border" />
                                                </div>
                                                <div class="flex-grow-1 overflow-hidden">
                                                    <div class="d-flex align-items-center gap-2 mb-1">
                                                        <span class="badge bg-success-subtle text-success border border-success-subtle small fw-semibold">
                                                            <i class="bi bi-image me-1"></i>Hình ảnh hợp lệ
                                                        </span>
                                                        <span class="text-muted small" id="createEntryImageFileSize"></span>
                                                    </div>
                                                    <div class="fw-semibold text-slate-800 small text-truncate" id="createEntryImageFileName"></div>
                                                    <div class="text-muted small" style="font-size: 0.75rem;">Sẽ tự động đính kèm và lưu ảnh X-quang khi bấm "Lưu Bệnh Án".</div>
                                                </div>
                                            </div>

                                            <!-- DICOM Card (No simulated image preview) -->
                                            <div id="createEntryDicomPreviewCard" class="d-none d-flex align-items-center gap-3 p-2 rounded bg-light border">
                                                <div class="d-flex align-items-center justify-content-center bg-primary-subtle text-primary rounded border border-primary-subtle" style="width: 72px; height: 72px; flex-shrink: 0;">
                                                    <i class="bi bi-file-earmark-medical-fill fs-2"></i>
                                                </div>
                                                <div class="flex-grow-1 overflow-hidden">
                                                    <div class="d-flex align-items-center gap-2 mb-1">
                                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle small fw-semibold">
                                                            <i class="bi bi-hospital me-1"></i>DICOM PS 3.10
                                                        </span>
                                                        <span class="text-muted small" id="createEntryDicomFileSize"></span>
                                                    </div>
                                                    <div class="fw-semibold text-slate-800 small text-truncate" id="createEntryDicomFileName"></div>
                                                    <div class="text-muted small" style="font-size: 0.75rem;">Tập tin y tế chuyên dụng (không hiển thị preview ảnh phẳng). Sẽ được đính kèm và lưu trữ an toàn cùng bệnh án.</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Interactive Tooth Condition Picker for this Entry -->
                        <div class="border rounded-3 p-3 bg-light mb-3">
                            <label class="form-label fw-bold text-slate-800 d-flex justify-content-between align-items-center mb-2">
                                <span><i class="bi bi-tools me-1 text-primary"></i> Ghi Nhận Răng Có Tổn Thương / Thủ Thuật:</span>
                                <button type="button" class="btn btn-sm btn-outline-primary" onclick="addToothRow()">
                                    <i class="bi bi-plus-lg me-1"></i> Thêm Răng
                                </button>
                            </label>
                            <div id="toothRowsContainer" class="d-flex flex-column gap-2">
                                <!-- Dynamic rows added by JS -->
                            </div>
                        </div>

                        @if (Model.NewEntryForm?.AppointmentId.HasValue == true)
                        {
                            <div class="form-check form-switch p-2 bg-light rounded border">
                                <input class="form-check-input ms-0 me-2" type="checkbox" role="switch" id="completeAppointmentSwitch" name="CompleteAppointment" value="true">
                                <label class="form-check-label fw-semibold text-slate-800" for="completeAppointmentSwitch">
                                    Đánh dấu hoàn thành toàn bộ ca khám này
                                </label>
                                <div class="text-muted small ms-4">
                                    (Để trống nếu bác sĩ vẫn đang tư vấn dịch vụ, chỉ định chụp X-quang hoặc chuẩn bị đưa bệnh nhân vào ghế điều trị)
                                </div>
                            </div>
                        }
                    </div>
                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy Bỏ</button>
                        <button type="submit" class="btn btn-primary px-4 fw-medium" onclick="prepareToothConditionsJson()">
                            <i class="bi bi-save me-1"></i> Lưu Bệnh Án & Sơ Đồ Răng
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal Upload Phim X-Quang / Ảnh Răng -->
    <div class="modal fade" id="modalUploadImaging" tabindex="-1" aria-labelledby="modalUploadImagingLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold" id="modalUploadImagingLabel">
                        <i class="bi bi-cloud-arrow-up-fill me-2"></i>Upload Phim X-Quang / Ảnh Răng
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="formUploadImaging" asp-action="UploadImaging" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="uploadImagingClinicalEntryId" name="ClinicalEntryId" value="0" />
                    <input type="hidden" name="PatientUserId" value="@(record.PatientUserId)" />
                    <div class="modal-body p-4">
                        <div class="mb-3 p-2 bg-light rounded border">
                            <label class="form-label fw-semibold text-slate-700 mb-0 small">Đợt khám liên kết:</label>
                            <div id="uploadImagingDiagnosisPreview" class="fw-bold text-primary small"></div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-slate-700">Tệp phim X-quang / ảnh răng <span class="text-danger">*</span></label>
                            <input type="file" id="uploadImagingFileInput" name="File" class="form-control" accept=".jpg,.jpeg,.png,.dcm,.dicom" required />
                            <div class="form-text small text-muted">
                                <i class="bi bi-info-circle me-1"></i>Hỗ trợ JPG, PNG, DICOM (.dcm, .dicom) — Tối đa 15 MB.
                            </div>
                            <div id="fileValidationFeedback" class="text-danger small mt-1 d-none"></div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-slate-700">Loại phim X-quang <span class="text-danger">*</span></label>
                            <select id="uploadImagingTypeSelect" name="ImagingType" class="form-select" required>
                                <option value="">-- Chọn loại phim --</option>
                                <option value="Panorama">Panorama (Toàn cảnh OPG)</option>
                                <option value="Periapical">Periapical (Cận chóp / Quanh chóp)</option>
                                <option value="Cephalometric">Cephalometric (Sọ nghiêng Ceph)</option>
                                <option value="Intraoral">Intraoral (Ảnh chụp trong miệng)</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-slate-700">Kết luận đọc phim / Mô tả tổn thương</label>
                            <textarea id="uploadImagingResultSummary" name="ResultSummary" class="form-control" rows="3" placeholder="Ghi nhận cấu trúc xương ổ, cuống răng, nang quanh cuống hoặc hướng mọc của răng..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" id="btnSubmitUploadImaging" class="btn btn-primary px-4 fw-medium">
                            <span id="uploadSpinner" class="spinner-border spinner-border-sm me-1 d-none" role="status" aria-hidden="true"></span>
                            <i class="bi bi-cloud-arrow-up-fill me-1" id="uploadIcon"></i>
                            <span id="uploadBtnText">Upload Phim</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal Phóng To Ảnh X-Quang (Lightbox - Commit 16 & Day 01: Zoom In / Zoom Out) -->
    <div class="modal fade" id="imagingLightboxModal" tabindex="-1" aria-labelledby="imagingLightboxModalLabel" aria-hidden="true" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-xl">
            <div class="modal-content bg-dark text-white border-0 shadow-lg">
                <div class="modal-header border-secondary border-opacity-50 py-2 px-3 bg-dark d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-aspect-ratio text-info fs-5"></i>
                        <span class="badge bg-primary text-white px-2 py-1" id="lightboxTypeBadge">X-Quang</span>
                        <span class="text-white-50 small ms-2" id="lightboxDate"></span>
                        <span class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-50 small d-none d-xl-inline-flex align-items-center gap-1" id="annotationNoticeBadge" title="Chú thích tạm thời">
                            <i class="bi bi-info-circle-fill"></i>Chú thích tạm thời — không được lưu vào hồ sơ bệnh án.
                        </span>
                    </div>

                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <!-- Medical Imaging Zoom & Rotate Toolbar (Day 01, 02, 03, 04) -->
                        <div class="imaging-zoom-toolbar btn-toolbar d-flex align-items-center gap-1 px-2 py-1" role="toolbar" aria-label="Thanh công cụ thu phóng và xoay X-quang">
                            <button type="button" id="btnZoomOut" class="btn btn-sm btn-outline-light border-0 px-2 py-1" title="Thu nhỏ (-)" aria-label="Thu nhỏ">
                                <i class="bi bi-dash-lg"></i>
                            </button>
                            <span id="zoomPercentageBadge" class="badge font-monospace px-2 py-1" title="Tỷ lệ thu phóng hiện tại" aria-live="polite">
                                100%
                            </span>
                            <button type="button" id="btnZoomIn" class="btn btn-sm btn-outline-light border-0 px-2 py-1" title="Phóng to (+)" aria-label="Phóng to">
                                <i class="bi bi-plus-lg"></i>
                            </button>

                            <div class="vr bg-secondary opacity-50 mx-1 my-1"></div>

                            <button type="button" id="btnRotateLeft" class="btn btn-sm btn-outline-light border-0 px-2 py-1" title="Xoay trái 90° (Phím [)" aria-label="Xoay trái 90 độ">
                                <i class="bi bi-arrow-counterclockwise"></i>
                            </button>
                            <button type="button" id="btnRotateRight" class="btn btn-sm btn-outline-light border-0 px-2 py-1" title="Xoay phải 90° (Phím ])" aria-label="Xoay phải 90 độ">
                                <i class="bi bi-arrow-clockwise"></i>
                            </button>
                            <button type="button" id="btnResetRotation" class="btn btn-sm btn-outline-light border-0 px-2 py-1 d-flex align-items-center gap-1" title="Đặt lại góc xoay về 0°" aria-label="Đặt lại góc xoay">
                                <span id="rotationBadge" class="badge font-monospace px-1">0°</span>
                            </button>

                            <div class="vr bg-secondary opacity-50 mx-1 my-1"></div>

                            <!-- Day 04: Brightness & Contrast Controls -->
                            <div class="dropdown d-inline-block">
                                <button type="button" id="btnFilterDropdown" class="btn btn-sm btn-outline-light border-0 px-2 py-1 d-flex align-items-center gap-1 dropdown-toggle" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" title="Điều chỉnh Độ sáng & Độ tương phản (Brightness & Contrast)">
                                    <i class="bi bi-sliders"></i>
                                    <span class="d-none d-sm-inline small">Bộ lọc</span>
                                </button>
                                <div class="dropdown-menu dropdown-menu-dark imaging-filter-menu p-3 shadow-lg" style="min-width: 280px;" aria-labelledby="btnFilterDropdown">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <label for="brightnessSlider" class="form-label small text-info fw-semibold mb-0">
                                            <i class="bi bi-brightness-high me-1"></i>Độ sáng
