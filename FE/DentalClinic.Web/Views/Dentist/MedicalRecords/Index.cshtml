@using DentalClinic.Web.Models.ApiDtos
@model DentalClinic.Web.ViewModels.MedicalRecord.DentistMedicalRecordIndexViewModel
@{
    ViewData["Title"] = "Hồ Sơ Bệnh Án & Sơ Đồ Răng (EMR)";
    var record = Model.SelectedRecord;
    var activeAppt = Model.ActiveAppointment;
    var isExamining = Model.IsExamining;
}

<style>
    /* Odontogram Styles */
    .odontogram-wrapper {
        background: #f8fafc;
        border-radius: 12px;
        padding: 18px 12px;
        border: 1px solid #e2e8f0;
        overflow-x: auto;
    }
    .arch-container {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 3px;
        flex-wrap: nowrap !important;
        min-width: 720px;
        margin: 0 auto 6px auto;
        padding: 2px 0;
    }
    .quadrant-group {
        display: flex;
        gap: 3px;
        flex-shrink: 0;
    }
    .quadrant-divider {
        width: 3px;
        height: 64px;
        background: #94a3b8;
        border-radius: 2px;
        margin: 0 6px;
        flex-shrink: 0;
    }
    .tooth-card {
        width: 44px;
        min-height: 70px;
        background: #ffffff;
        border: 2px solid #cbd5e1;
        border-radius: 8px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: space-between;
        padding: 4px 2px 3px 2px;
        cursor: pointer;
        transition: all 0.2s ease;
        position: relative;
        user-select: none;
        flex-shrink: 0;
    }
    .tooth-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 10px rgba(0,0,0,0.12);
        border-color: #0284c7;
    }
    .tooth-number {
        font-size: 0.78rem;
        font-weight: 700;
        color: #1e293b;
        line-height: 1;
    }
    .tooth-icon {
        font-size: 1.15rem;
        line-height: 1;
        margin: 2px 0;
    }
    .tooth-status-tag {
        font-size: 0.58rem;
        font-weight: 700;
        padding: 1px 2px;
        border-radius: 4px;
        width: 100%;
        max-width: 100%;
        text-align: center;
        line-height: 1.15;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        box-sizing: border-box;
    }

    /* Distinct Tooth Condition Colors */
    .tooth-healthy { border-color: #86efac; background: #f0fdf4; }
    .tooth-healthy .tooth-icon { color: #16a34a; }
    .tooth-healthy .tooth-status-tag { background: #dcfce7; color: #15803d; }

    .tooth-caries { border-color: #f87171; background: #fef2f2; box-shadow: 0 0 6px rgba(220, 38, 38, 0.2); }
    .tooth-caries .tooth-icon { color: #dc2626; }
    .tooth-caries .tooth-status-tag { background: #fee2e2; color: #b91c1c; }

    .tooth-filled { border-color: #60a5fa; background: #eff6ff; }
    .tooth-filled .tooth-icon { color: #2563eb; }
    .tooth-filled .tooth-status-tag { background: #dbeafe; color: #1d4ed8; }

    .tooth-missing { border-color: #94a3b8; background: #f1f5f9; opacity: 0.75; }
    .tooth-missing .tooth-icon { color: #475569; }
    .tooth-missing .tooth-status-tag { background: #e2e8f0; color: #334155; }

    .tooth-crown { border-color: #fcd34d; background: #fffbeb; }
    .tooth-crown .tooth-icon { color: #d97706; }
    .tooth-crown .tooth-status-tag { background: #fef3c7; color: #b45309; }

    .tooth-pulpitis { border-color: #d8b4fe; background: #faf5ff; }
    .tooth-pulpitis .tooth-icon { color: #9333ea; }
    .tooth-pulpitis .tooth-status-tag { background: #f3e8ff; color: #7e22ce; }

    .tooth-extractionneeded { border-color: #fdba74; background: #fff7ed; }
    .tooth-extractionneeded .tooth-icon { color: #ea580c; }
    .tooth-extractionneeded .tooth-status-tag { background: #ffedd5; color: #c2410c; }

    .tooth-highlighted {
        transform: scale(1.08) !important;
        box-shadow: 0 0 12px rgba(2, 132, 199, 0.6) !important;
        border-width: 3px !important;
        z-index: 10;
    }

    /* Interactive Color Legend */
    .legend-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 10px;
        border-radius: 6px;
        font-size: 0.78rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
        border: 1px solid transparent;
        user-select: none;
    }
    .legend-badge:hover {
        transform: translateY(-1px);
        box-shadow: 0 2px 6px rgba(0,0,0,0.08);
    }
    .legend-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        display: inline-block;
    }

    .badge-healthy { background: #dcfce7; color: #15803d; border-color: #86efac; }
    .badge-healthy .legend-dot { background: #16a34a; }

    .badge-caries { background: #fee2e2; color: #b91c1c; border-color: #f87171; }
    .badge-caries .legend-dot { background: #dc2626; }

    .badge-filled { background: #dbeafe; color: #1d4ed8; border-color: #60a5fa; }
    .badge-filled .legend-dot { background: #2563eb; }

    .badge-missing { background: #e2e8f0; color: #334155; border-color: #94a3b8; }
    .badge-missing .legend-dot { background: #475569; }

    .badge-crown { background: #fef3c7; color: #b45309; border-color: #fcd34d; }
    .badge-crown .legend-dot { background: #d97706; }

    .badge-pulpitis { background: #f3e8ff; color: #7e22ce; border-color: #d8b4fe; }
    .badge-pulpitis .legend-dot { background: #9333ea; }

    .badge-extractionneeded { background: #ffedd5; color: #c2410c; border-color: #fdba74; }
    .badge-extractionneeded .legend-dot { background: #ea580c; }

    /* Past visit card in sidebar */
    .visit-card-active {
        border-left: 4px solid #0284c7 !important;
        background-color: #f0f9ff !important;
    }

    @@keyframes pulse-ring {
        0% { box-shadow: 0 0 0 0 rgba(22, 163, 74, 0.5); }
        70% { box-shadow: 0 0 0 8px rgba(22, 163, 74, 0); }
        100% { box-shadow: 0 0 0 0 rgba(22, 163, 74, 0); }
    }
    .animate-pulse {
        animation: pulse-ring 2s infinite;
    }

    /* Imaging preview */
    .img-thumbnail-fit {
        object-fit: cover;
        object-position: center;
        transition: transform 0.25s ease;
    }
    .imaging-preview-container:hover .img-thumbnail-fit {
        transform: scale(1.05);
    }
    .fs-11 { font-size: 0.72rem; }
    .fs-12 { font-size: 0.78rem; }
    .fs-13 { font-size: 0.84rem; }
    .fs-14 { font-size: 0.88rem; }
    .fs-15 { font-size: 0.95rem; }
</style>

<div class="container-fluid px-4 py-4">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary-subtle text-primary fw-medium px-2 py-1 fs-12">
                    <i class="bi bi-journal-medical me-1"></i> Bác sĩ nha khoa
                </span>
                <span class="badge bg-light text-muted fw-normal px-2 py-1 fs-12">Clinical EMR & Odontogram</span>
                @if (isExamining)
                {
                    <span class="badge bg-success text-white px-2 py-1 fs-12 animate-pulse">
                        <i class="bi bi-heart-pulse-fill me-1"></i> Đang trong ca khám trực tiếp
                    </span>
                }
            </div>
            <h1 class="h3 fw-bold text-slate-800 mb-0">Hồ Sơ Bệnh Án & Sơ Đồ Răng Điện Tử</h1>
            <p class="text-muted small mb-0 mt-1">Theo dõi tiền sử lâm sàng, sơ đồ răng theo từng đợt khám và điều trị dịch vụ tại ghế</p>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <a asp-controller="DentistAppointment" asp-action="Today" class="btn btn-outline-secondary btn-sm shadow-sm">
                <i class="bi bi-arrow-left me-1"></i> Về Ca Khám Hôm Nay
            </a>
            @if (record != null)
            {
                <button type="button" class="btn btn-outline-primary btn-sm shadow-sm" data-bs-toggle="modal" data-bs-target="#modalSwitchPatient">
                    <i class="bi bi-people me-1"></i> Đổi Bệnh Nhân
                </button>
                <button type="button" class="btn btn-success btn-sm d-flex align-items-center gap-2 shadow-sm" data-bs-toggle="modal" data-bs-target="#modalCreateFollowUpAppointment"><i class="bi bi-calendar-plus-fill"></i><span>Đặt Lịch Tái Khám</span></button>
                <button type="button" class="btn btn-primary btn-sm d-flex align-items-center gap-2 shadow-sm" data-bs-toggle="modal" data-bs-target="#modalCreateClinicalEntry">
                    <i class="bi bi-clipboard2-plus-fill"></i>
                    <span>Ghi Nhận Chẩn Đoán Mới</span>
                </button>
            }
        </div>
    </div>

    @if (record != null)
    {
        <!-- Patient Banner -->
        <div class="card border-0 shadow-sm rounded-3 mb-3 bg-white p-3">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-primary-subtle text-primary p-3 rounded-circle fs-3 fw-bold">
                        <i class="bi bi-person"></i>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2">
                            <h4 class="fw-bold text-slate-800 mb-0">@record.PatientName</h4>
                            <span class="badge bg-secondary-subtle text-secondary border">@record.PatientCode</span>
                        </div>
                        <div class="text-muted small mt-1 d-flex flex-wrap gap-3">
                            <span><i class="bi bi-telephone me-1"></i>@(record.PatientPhone ?? "—")</span>
                            <span><i class="bi bi-gender-ambiguous me-1"></i>@(record.Gender ?? "—")</span>
                            <span><i class="bi bi-calendar3 me-1"></i>@(record.DateOfBirth?.ToString("dd/MM/yyyy") ?? "—") (@(record.Age.HasValue ? $"{record.Age} tuổi" : "—"))</span>
                            <span><i class="bi bi-geo-alt me-1"></i>@(record.Address ?? "—")</span>
                        </div>
                    </div>
                </div>
                <div class="text-end">
                    <div class="text-muted small">Ngày mở hồ sơ:</div>
                    <div class="fw-bold text-dark">@record.CreatedAt.ToString("dd/MM/yyyy")</div>
                </div>
            </div>
        </div>

        <!-- Live Examination Active Console (when doctor is in active appointment) -->
        @if (activeAppt != null)
        {
            var isApptCompleted = activeAppt.Status == "Completed";
            var isApptCancelled = activeAppt.Status == "Cancelled";
            var isApptActive = !isApptCompleted && !isApptCancelled;

            <div class="card @(isApptCompleted ? "border-success-subtle bg-light" : isApptCancelled ? "border-secondary bg-light" : "border-primary border-2 bg-primary-subtle") shadow-sm rounded-3 mb-4 p-3">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div>
                        <div class="d-flex align-items-center gap-2">
                            @if (isApptCompleted)
                            {
                                <span class="badge bg-secondary px-3 py-2 fs-13">
                                    <i class="bi bi-check-circle-fill me-1"></i> CA KHÁM ĐÃ HOÀN THÀNH
                                </span>
                            }
                            else if (isApptCancelled)
                            {
                                <span class="badge bg-danger px-3 py-2 fs-13">
                                    <i class="bi bi-x-circle-fill me-1"></i> CA KHÁM ĐÃ HỦY
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success px-3 py-2 fs-13 animate-pulse">
                                    <i class="bi bi-heart-pulse-fill me-1"></i> ĐANG TRONG CA KHÁM
                                </span>
                            }
                            <span class="fw-bold font-monospace text-dark fs-15">@activeAppt.AppointmentCode</span>
                            <span class="badge bg-primary text-white">@activeAppt.ServiceName</span>
                        </div>
                        <div class="text-dark small mt-2 d-flex align-items-center gap-2 flex-wrap">
                            <span><i class="bi bi-door-closed me-1 text-primary"></i> Phòng: <strong>@(activeAppt.RoomName ?? "Phòng khám chung")</strong></span>
                            &bull;
                            <span>
                                <i class="bi bi-badge-hd me-1 text-danger"></i> Ghế: 
                                <strong>@(activeAppt.DentalChairName ?? "Chưa gán ghế")</strong>
                            </span>
                            @if (isApptActive)
                            {
                                <button type="button" class="btn btn-xs btn-outline-primary py-0 px-2 fw-semibold" onclick="openPickChairModal(@activeAppt.AppointmentId, '@(activeAppt.PatientName?.Replace("'", "\\'") ?? "")', '@(activeAppt.RoomName ?? "")', @(activeAppt.DentalChairId ?? 0))">
                                    <i class="bi bi-pin-map me-1"></i>Chọn/Đổi Ghế
                                </button>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary border py-1 px-2 small ms-1" title="Ca khám đã hoàn tất, vị trí ghế điều trị đã được khóa">
                                    <i class="bi bi-lock-fill me-1"></i>Đã Khóa Ghế
                                </span>
                            }
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        @if (isApptActive)
                        {
                            <button type="button" class="btn btn-primary btn-sm fw-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#modalCreateClinicalEntry">
                                <i class="bi bi-pencil-square me-1"></i> Ghi Nhận Khám & Răng
                            </button>
                            <button type="button" class="btn btn-warning text-dark btn-sm fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#modalAddAdditionalService">
                                <i class="bi bi-plus-circle-fill me-1"></i> Ghi Nhận Dịch Vụ Đã Làm
                            </button>
                            @if (Model.ActivePrescription == null)
                            {
                                <button type="button" class="btn btn-outline-success btn-sm bg-white shadow-sm fw-semibold" data-bs-toggle="modal" data-bs-target="#modalQuickPrescription">
                                    <i class="bi bi-capsule me-1"></i> Kê Đơn Thuốc Tại Ghế
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-success btn-sm text-white shadow-sm fw-semibold" data-bs-toggle="modal" data-bs-target="#modalDirectDispense">
                                    <i class="bi bi-box-seam me-1"></i> Cấp Thuốc Trực Tiếp
                                </button>
                            }
                            <button type="button" class="btn btn-danger btn-sm fw-bold shadow-sm" onclick="openCompleteExamModal(@activeAppt.AppointmentId, '@(record.PatientName?.Replace("'", "\\'") ?? "")', '@activeAppt.AppointmentCode')">
                                <i class="bi bi-check-circle-fill me-1"></i> Hoàn Thành Ca Khám
                            </button>
                        }
                        else
                        {
                            <span class="badge bg-success text-white px-3 py-2 fw-semibold fs-13 shadow-sm d-inline-flex align-items-center">
                                <i class="bi bi-check-all fs-6 me-1"></i> Ca khám đã hoàn tất
                            </span>
                            @if (Model.ActivePrescription != null)
                            {
                                <button type="button" class="btn btn-outline-success btn-sm bg-white shadow-sm" data-bs-toggle="modal" data-bs-target="#modalDirectDispense">
                                    <i class="bi bi-box-seam me-1"></i> Xem Cấp Thuốc
                                </button>
                            }
                        }
                    </div>
                </div>
            </div>

            <!-- UNIFIED WORKSPACE SECTIONS FOR ACTIVE APPOINTMENT -->
            <div class="card border-0 shadow-sm rounded-3 mb-4 bg-white overflow-hidden">
                <div class="card-header bg-white border-bottom py-3">
                    <ul class="nav nav-pills card-header-pills" id="examWorkspaceTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active fw-semibold" id="tab-services-btn" data-bs-toggle="tab" data-bs-target="#tab-services" type="button" role="tab">
                                <i class="bi bi-tools me-1 text-warning"></i> Dịch Vụ Thực Hiện Tại Ghế
                                <span class="badge bg-primary text-white ms-1">@Model.PerformedServices.Count</span>
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link fw-semibold" id="tab-prescription-btn" data-bs-toggle="tab" data-bs-target="#tab-prescription" type="button" role="tab">
                                <i class="bi bi-capsule me-1 text-success"></i> Đơn Thuốc & Cấp Phát Tại Ghế
                                @if (Model.ActivePrescription != null)
                                {
                                    <span class="badge bg-success text-white ms-1">Đã kê</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary ms-1">Chưa kê</span>
                                }
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link fw-semibold" id="tab-plans-btn" data-bs-toggle="tab" data-bs-target="#tab-plans" type="button" role="tab">
                                <i class="bi bi-diagram-3 me-1 text-info"></i> Phác Đồ Điều Trị
                                <span class="badge bg-info-subtle text-info ms-1">@Model.PatientTreatmentPlans.Count</span>
                            </button>
                        </li>
                    </ul>
                </div>
                <div class="card-body p-3">
                    <div class="tab-content" id="examWorkspaceContent">
                        <!-- TAB 1: PERFORMED SERVICES (Section 6) -->
                        <div class="tab-pane fade show active" id="tab-services" role="tabpanel">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div>
                                    <h6 class="fw-bold text-slate-800 mb-0">Danh Sách Dịch Vụ & Thủ Thuật Thực Tế Đã Làm</h6>
                                    <small class="text-muted">Căn cứ duy nhất để Lễ tân tính viện phí. Dịch vụ đặt trước (@activeAppt.ServiceName) chỉ là lý do đăng ký ban đầu.</small>
                                </div>
                                @if (isApptActive)
                                {
                                    <button type="button" class="btn btn-warning text-dark btn-sm fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#modalAddAdditionalService">
                                        <i class="bi bi-plus-circle-fill me-1"></i> Thêm Dịch Vụ Thực Hiện
                                    </button>
                                }
                            </div>

                            @if (Model.PerformedServices.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead class="table-light small text-muted">
                                            <tr>
                                                <th>#</th>
                                                <th>Tên Dịch Vụ / Thủ Thuật</th>
                                                <th class="text-center">Số Lượng</th>
                                                <th class="text-end">Đơn Giá</th>
                                                <th class="text-end">Thành Tiền</th>
                                                <th class="text-center">Thao Tác</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @for (int i = 0; i < Model.PerformedServices.Count; i++)
                                            {
                                                var ps = Model.PerformedServices[i];
                                                <tr>
                                                    <td>@(i + 1)</td>
                                                    <td class="fw-semibold text-dark">
                                                        <i class="bi bi-check2-circle text-success me-1"></i>
                                                        @ps.ServiceName
                                                    </td>
                                                    <td class="text-center">@ps.Quantity</td>
                                                    <td class="text-end">@ps.UnitPrice.ToString("N0") đ</td>
                                                    <td class="text-end fw-bold text-primary">@ps.Amount.ToString("N0") đ</td>
                                                    <td class="text-center">
                                                        @if (isApptActive)
                                                        {
                                                            <form asp-action="DeletePerformedService" method="post" class="d-inline" onsubmit="return confirm('Xác nhận xóa dịch vụ này khỏi ca khám?');">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="performedServiceId" value="@ps.PerformedServiceId" />
                                                                <input type="hidden" name="appointmentId" value="@activeAppt.AppointmentId" />
                                                                <input type="hidden" name="patientUserId" value="@record.PatientUserId" />
                                                                <button type="submit" class="btn btn-xs btn-outline-danger" title="Xóa dịch vụ">
                                                                    <i class="bi bi-trash"></i>
                                                                </button>
                                                            </form>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-secondary-subtle text-secondary small">Đã khóa</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                        <tfoot class="table-light">
                                            <tr>
                                                <td colspan="4" class="text-end fw-bold">Tổng chi phí thủ thuật thực hiện:</td>
                                                <td class="text-end fw-bold text-danger fs-6">
                                                    @Model.PerformedServices.Sum(ps => ps.Amount).ToString("N0") đ
                                                </td>
                                                <td></td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-4 text-muted bg-light rounded-3">
                                    <i class="bi bi-clipboard2-x fs-3 d-block text-secondary mb-2"></i>
                                    <span>Chưa có dịch vụ thực tế nào được ghi nhận cho ca khám này.</span>
                                    @if (isApptActive)
                                    {
                                        <div class="mt-2">
                                            <button type="button" class="btn btn-warning text-dark btn-sm fw-semibold" data-bs-toggle="modal" data-bs-target="#modalAddAdditionalService">
                                                <i class="bi bi-plus-circle-fill me-1"></i> Ghi nhận ngay tại ghế
                                            </button>
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        <!-- TAB 2: PRESCRIPTION & CHAIRSIDE DISPENSING (Section 9 & 10) -->
                        <div class="tab-pane fade" id="tab-prescription" role="tabpanel">
                            <div class="alert alert-info py-2 px-3 small border-0 bg-info-subtle text-dark mb-3 d-flex align-items-center gap-2">
                                <i class="bi bi-info-circle-fill text-info fs-5"></i>
                                <div>
                                    <strong>Quy trình cấp thuốc trực tiếp tại ghế:</strong> DentalCare không có Dược sĩ. Bác sĩ tự kê đơn, chọn lô thuốc còn hạn trong kho nội bộ, nhập số lượng thực tế cấp cho bệnh nhân và xác nhận bàn giao tại ghế.
                                </div>
                            </div>

                            @if (Model.ActivePrescription != null)
                            {
                                <div class="row g-3">
                                    <div class="col-lg-6">
                                        <div class="card border rounded-3 p-3 h-100 bg-white">
                                            <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                                                <h6 class="fw-bold text-slate-800 mb-0">
                                                    <i class="bi bi-file-earmark-medical text-primary me-1"></i> Đơn Thuốc Đã Kê (#@Model.ActivePrescription.PrescriptionId)
                                                </h6>
                                                <span class="text-muted small">@Model.ActivePrescription.IssuedAt.ToString("dd/MM/yyyy HH:mm")</span>
                                            </div>

                                            @if (!string.IsNullOrEmpty(Model.ActivePrescription.GeneralInstructions))
                                            {
                                                <div class="small text-muted mb-2 fst-italic">
                                                    <strong>Lời dặn:</strong> @Model.ActivePrescription.GeneralInstructions
                                                </div>
                                            }

                                            <div class="table-responsive">
                                                <table class="table table-sm table-hover align-middle mb-0">
                                                    <thead class="table-light small">
                                                        <tr>
                                                            <th>Tên thuốc</th>
                                                            <th class="text-center">Số lượng</th>
                                                            <th>Cách dùng</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var item in Model.ActivePrescription.Items)
                                                        {
                                                            <tr>
                                                                <td class="fw-semibold">
                                                                    @item.MedicationName
                                                                    @if (!string.IsNullOrEmpty(item.Dosage))
                                                                    {
                                                                        <span class="text-muted small">(@item.Dosage)</span>
                                                                    }
                                                                </td>
                                                                <td class="text-center">@(item.Frequency ?? "Theo chỉ định") @(item.Duration ?? "")</td>
                                                                <td class="small text-muted">@(item.Instructions ?? "—")</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>

                                            @if (isApptActive)
                                            {
                                                <div class="mt-3 text-end">
                                                    <button type="button" class="btn btn-success btn-sm fw-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#modalDirectDispense">
                                                        <i class="bi bi-box-seam me-1"></i> Cấp Thuốc Trực Tiếp Tại Ghế
                                                    </button>
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <div class="col-lg-6">
                                        <div class="card border rounded-3 p-3 h-100 bg-white">
                                            <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                                                <h6 class="fw-bold text-slate-800 mb-0">
                                                    <i class="bi bi-clock-history text-success me-1"></i> Lịch Sử Thuốc Đã Thực Cấp Tại Ghế
                                                </h6>
                                                <span class="badge bg-success text-white">@Model.Dispensations.Count đợt cấp</span>
                                            </div>

                                            @if (Model.Dispensations.Any())
                                            {
                                                <div class="d-flex flex-column gap-2 overflow-auto" style="max-height: 280px;">
                                                    @foreach (var disp in Model.Dispensations)
                                                    {
                                                        <div class="p-2 bg-light rounded border">
                                                            <div class="d-flex justify-content-between small text-muted mb-1">
                                                                <span>Phiếu #@disp.DispensationId &bull; @disp.DispensedAt.ToString("dd/MM/yyyy HH:mm")</span>
                                                                <span class="badge bg-success-subtle text-success border">Đã trừ tồn</span>
                                                            </div>
                                                            <div class="d-flex flex-column gap-1">
                                                                @foreach (var dItem in disp.Items)
                                                                {
                                                                    <div class="d-flex justify-content-between align-items-center small">
                                                                        <span class="fw-semibold text-dark">
                                                                            <i class="bi bi-capsule me-1 text-primary"></i>@dItem.MedicineName
                                                                            <span class="text-muted">(Lô: @dItem.BatchNumber)</span>
                                                                        </span>
                                                                        <span class="badge bg-primary text-white">
                                                                            @dItem.QuantityDispensed @dItem.Unit
                                                                        </span>
                                                                    </div>
                                                                }
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="text-center py-4 text-muted small bg-light rounded">
                                                    <i class="bi bi-box2 fs-3 d-block text-secondary mb-1"></i>
                                                    Chưa có đợt cấp thuốc thực tế nào cho đơn thuốc này.
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-4 text-muted bg-light rounded-3">
                                    <i class="bi bi-capsule fs-3 d-block text-secondary mb-2"></i>
                                    <span>Chưa có đơn thuốc nào cho ca khám này.</span>
                                    @if (isApptActive)
                                    {
                                        <div class="mt-2">
                                            <button type="button" class="btn btn-outline-success btn-sm fw-semibold" data-bs-toggle="modal" data-bs-target="#modalQuickPrescription">
                                                <i class="bi bi-plus-circle me-1"></i> Kê đơn thuốc tại ghế ngay
                                            </button>
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        <!-- TAB 3: TREATMENT PLANS (Section 7) -->
                        <div class="tab-pane fade" id="tab-plans" role="tabpanel">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div>
                                    <h6 class="fw-bold text-slate-800 mb-0">Phác Đồ & Liệu Trình Điều Trị Nhiều Buổi</h6>
                                    <small class="text-muted">Áp dụng cho điều trị tủy nhiều lần, chỉnh nha, implant, phục hình.</small>
                                </div>
                                <a asp-controller="DentistTreatmentPlan" asp-action="Index" class="btn btn-outline-primary btn-sm fw-semibold">
                                    <i class="bi bi-box-arrow-up-right me-1"></i> Quản lý toàn bộ phác đồ
                                </a>
                            </div>

                            @if (Model.PatientTreatmentPlans.Any())
                            {
                                <div class="d-flex flex-column gap-3">
                                    @foreach (var plan in Model.PatientTreatmentPlans)
                                    {
                                        <div class="card border rounded-3 p-3 bg-white">
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <div class="d-flex align-items-center gap-2">
                                                    <span class="fw-bold text-dark fs-6">Phác Đồ #@plan.TreatmentPlanId</span>
                                                    <span class="badge @(plan.Status == "Completed" ? "bg-success" : "bg-primary")">@plan.Status</span>
                                                    <span class="badge bg-secondary-subtle text-secondary border">@plan.DepartmentName</span>
                                                </div>
                                                <div class="small text-muted">
                                                    Tiến độ: <strong>@plan.CompletedItemsCount / @plan.TotalItemsCount giai đoạn</strong> (@plan.ProgressPercentage%)
                                                </div>
                                            </div>
                                            <div class="progress mb-2" style="height: 6px;">
                                                <div class="progress-bar bg-success" role="progressbar" style="width: @plan.ProgressPercentage%"></div>
                                            </div>
                                            <div class="table-responsive">
                                                <table class="table table-sm table-hover align-middle mb-0 small">
                                                    <thead class="table-light text-muted">
                                                        <tr>
                                                            <th>Giai đoạn</th>
                                                            <th>Dịch vụ</th>
                                                            <th>Răng</th>
                                                            <th>Bác sĩ</th>
                                                            <th>Trạng thái</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var item in plan.Items)
                                                        {
                                                            <tr>
                                                                <td>GĐ @item.SequenceNo</td>
                                                                <td class="fw-semibold">@item.ServiceName</td>
                                                                <td>@(string.IsNullOrEmpty(item.ToothNumber) ? "—" : $"R{item.ToothNumber}")</td>
                                                                <td>@(item.AssignedDentistName ?? "Chưa phân công")</td>
                                                                <td>
                                                                    <span class="badge @(item.Status == "Completed" ? "bg-success" : item.Status == "InProgress" ? "bg-warning text-dark" : "bg-light text-muted border")">
                                                                        @item.Status
                                                                    </span>
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-4 text-muted bg-light rounded-3">
                                    <i class="bi bi-diagram-3 fs-3 d-block text-secondary mb-2"></i>
                                    <span>Bệnh nhân chưa có phác đồ điều trị dài hạn nào.</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="row g-4">
            <!-- Left Column: Patient's Past Clinical Visits History (Hồ sơ các lần khám trước) -->
            <div class="col-lg-4 col-xl-3">
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="fw-bold text-slate-800 mb-0">
                                <i class="bi bi-clock-history text-primary me-1"></i> Các Lần Khám Trước
                            </h6>
                            <small class="text-muted">@record.ClinicalEntries.Count đợt khám của bệnh nhân</small>
                        </div>
                        <button type="button" class="btn btn-xs btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#modalSwitchPatient" title="Tra cứu bệnh nhân khác">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>

                    <div class="list-group list-group-flush overflow-auto p-2" style="max-height: 650px;">
                        <!-- Button to show Cumulative Odontogram -->
                        <button type="button" id="btnSideAll" class="list-group-item list-group-item-action p-3 rounded-3 mb-2 border visit-card-active text-start" onclick="switchOdontogramVisit('all')">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="fw-bold text-primary small">
                                    <i class="bi bi-diagram-3-fill me-1"></i> Hiện Trạng Tổng Thể
                                </span>
                                <span class="badge bg-primary text-white fs-11">32 răng</span>
                            </div>
                            <div class="small text-muted mt-1">
                                Tổng hợp tình trạng răng mới nhất qua mọi đợt điều trị.
                            </div>
                        </button>

                        @if (record.ClinicalEntries.Any())
                        {
                            @for (int idx = 0; idx < record.ClinicalEntries.Count; idx++)
                            {
                                var entry = record.ClinicalEntries[idx];
                                var isLatest = idx == 0;
                                <button type="button" id="btnSide_@entry.ClinicalEntryId" class="list-group-item list-group-item-action p-3 rounded-3 mb-2 border text-start bg-white" onclick="switchOdontogramVisit('@entry.ClinicalEntryId')">
                                    <div class="d-flex justify-content-between align-items-start mb-1">
                                        <div class="fw-bold text-dark fs-13">
                                            <i class="bi bi-calendar2-check text-primary me-1"></i>
                                            @entry.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                        </div>
                                        @if (isLatest)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle fs-11">Gần nhất</span>
                                        }
                                    </div>
                                    @if (!string.IsNullOrEmpty(entry.AppointmentCode))
                                    {
                                        <div class="font-monospace small text-primary mb-1">
                                            <i class="bi bi-ticket-perforated me-1"></i>@entry.AppointmentCode
                                        </div>
                                    }
                                    <div class="small text-muted">
                                        BS: <strong>@entry.DentistName</strong>
                                    </div>
                                    <div class="small fw-semibold text-dark mt-1 text-truncate" title="@entry.Diagnosis">
                                        Chẩn đoán: @entry.Diagnosis
                                    </div>

                                    @if (entry.OdontogramEntries.Any())
                                    {
                                        <div class="d-flex flex-wrap gap-1 mt-2">
                                            @foreach (var t in entry.OdontogramEntries)
                                            {
                                                var condBadge = t.Condition.ToLower() switch
                                                {
                                                    "caries" => "badge-caries",
                                                    "filled" => "badge-filled",
                                                    "missing" => "badge-missing",
                                                    "crown" => "badge-crown",
                                                    "pulpitis" => "badge-pulpitis",
                                                    "extractionneeded" => "badge-extractionneeded",
                                                    _ => "badge-healthy"
                                                };
                                                <span class="legend-badge @condBadge py-0 px-2 fs-11">
                                                    R@(t.ToothNumber): @t.Condition
                                                </span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-muted small fst-italic mt-1" style="font-size: 0.72rem;">
                                            Khám tổng quát, không ghi nhận can thiệp răng.
                                        </div>
                                    }
                                </button>
                            }
                        }
                        else
                        {
                            <div class="text-center py-4 text-muted small">
                                <i class="bi bi-journal-x fs-3 d-block mb-1 text-secondary"></i>
                                Bệnh nhân chưa có lịch sử đợt khám nào trước đây.
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Right Column: Odontogram (Hệ FDI) & Detailed Visits Timeline -->
            <div class="col-lg-8 col-xl-9">
                <!-- Odontogram (32 FDI Teeth Chart) with Interactive Visit Switcher -->
                <div class="card border-0 shadow-sm rounded-3 mb-4">
                    <div class="card-header bg-white border-0 py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <div>
                            <h5 class="card-title fw-bold text-slate-800 mb-0 d-flex align-items-center gap-2">
                                <i class="bi bi-grid-3x3-gap-fill text-primary"></i>
                                <span>Sơ Đồ Răng Khám Bệnh (Odontogram - Hệ FDI)</span>
                            </h5>
                            <small class="text-muted">Theo dõi và phân tích tình trạng răng theo từng lần khám riêng biệt</small>
                        </div>
                        <span class="badge bg-light text-muted border px-3 py-2">32 Răng người lớn</span>
                    </div>

                    <div class="card-body p-4 pt-2">
                        <!-- Visit Selection Tabs for Odontogram -->
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3 pb-2 border-bottom">
                            <div class="btn-group btn-group-sm flex-wrap shadow-sm" role="group" id="visitButtonsGroup">
                                <button type="button" class="btn btn-primary active" id="btnTop_all" onclick="switchOdontogramVisit('all')">
                                    <i class="bi bi-diagram-3-fill me-1"></i> Hiện Trạng Tổng Thể
                                </button>
                                @foreach (var entry in record.ClinicalEntries)
                                {
                                    <button type="button" class="btn btn-outline-primary" id="btnTop_@entry.ClinicalEntryId" onclick="switchOdontogramVisit('@entry.ClinicalEntryId')">
                                        <i class="bi bi-calendar-event me-1"></i> Đợt @entry.CreatedAt.ToString("dd/MM/yyyy")
                                    </button>
                                }
                            </div>
                            <span id="odontogramStatusBanner" class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 fw-semibold">
                                Đang hiển thị: Hiện trạng răng tổng thể
                            </span>
                        </div>

                        <!-- 32 Teeth Layout Wrapper (Mỗi hàm trên 1 hàng ngang duy nhất) -->
                        <div class="odontogram-wrapper">
                            <!-- Upper Arch (Hàm Trên: 16 răng trên 1 hàng ngang) -->
                            <div class="d-flex align-items-center justify-content-between mb-2 px-2">
                                <span class="small fw-bold text-muted text-uppercase letter-spacing-1">
                                    <i class="bi bi-arrow-up-circle me-1 text-primary"></i> Hàm Trên (Maxillary)
                                </span>
                                <span class="small text-muted fs-11">Phải (Q1: 18 &rarr; 11) &bull; Trái (Q2: 21 &rarr; 28)</span>
                            </div>
                            <div class="arch-container">
                                <!-- Q1: 18 -> 11 -->
                                <div class="quadrant-group">
                                    @for (int i = 18; i >= 11; i--)
                                    {
                                        var tStr = i.ToString();
                                        <div class="tooth-card tooth-healthy" id="toothCard_@tStr" data-tooth="@tStr" title="Răng @tStr: Khỏe mạnh">
                                            <span class="tooth-number">@tStr</span>
                                            <i class="bi bi-shield-check tooth-icon" id="toothIcon_@tStr"></i>
                                            <span class="tooth-status-tag" id="toothTag_@tStr">Khỏe</span>
                                        </div>
                                    }
                                </div>
                                <div class="quadrant-divider" title="Đường chính giữa cung hàm (Midline)"></div>
                                <!-- Q2: 21 -> 28 -->
                                <div class="quadrant-group">
                                    @for (int i = 21; i <= 28; i++)
                                    {
                                        var tStr = i.ToString();
                                        <div class="tooth-card tooth-healthy" id="toothCard_@tStr" data-tooth="@tStr" title="Răng @tStr: Khỏe mạnh">
                                            <span class="tooth-number">@tStr</span>
                                            <i class="bi bi-shield-check tooth-icon" id="toothIcon_@tStr"></i>
                                            <span class="tooth-status-tag" id="toothTag_@tStr">Khỏe</span>
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="my-3 border-top border-secondary-subtle opacity-50 position-relative">
                                <span class="position-absolute top-50 start-50 translate-middle bg-slate-100 px-3 py-0 fs-11 text-muted fw-semibold rounded-pill border">
                                    Mặt Nhai / Khớp Cắn
                                </span>
                            </div>

                            <!-- Lower Arch (Hàm Dưới: 16 răng trên 1 hàng ngang) -->
                            <div class="arch-container">
                                <!-- Q4: 48 -> 41 -->
                                <div class="quadrant-group">
                                    @for (int i = 48; i >= 41; i--)
                                    {
                                        var tStr = i.ToString();
                                        <div class="tooth-card tooth-healthy" id="toothCard_@tStr" data-tooth="@tStr" title="Răng @tStr: Khỏe mạnh">
                                            <span class="tooth-number">@tStr</span>
                                            <i class="bi bi-shield-check tooth-icon" id="toothIcon_@tStr"></i>
                                            <span class="tooth-status-tag" id="toothTag_@tStr">Khỏe</span>
                                        </div>
                                    }
                                </div>
                                <div class="quadrant-divider" title="Đường chính giữa cung hàm (Midline)"></div>
                                <!-- Q3: 31 -> 38 -->
                                <div class="quadrant-group">
                                    @for (int i = 31; i <= 38; i++)
                                    {
                                        var tStr = i.ToString();
                                        <div class="tooth-card tooth-healthy" id="toothCard_@tStr" data-tooth="@tStr" title="Răng @tStr: Khỏe mạnh">
                                            <span class="tooth-number">@tStr</span>
                                            <i class="bi bi-shield-check tooth-icon" id="toothIcon_@tStr"></i>
                                            <span class="tooth-status-tag" id="toothTag_@tStr">Khỏe</span>
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="d-flex align-items-center justify-content-between mt-2 px-2">
                                <span class="small fw-bold text-muted text-uppercase letter-spacing-1">
                                    <i class="bi bi-arrow-down-circle me-1 text-primary"></i> Hàm Dưới (Mandibular)
                                </span>
                                <span class="small text-muted fs-11">Phải (Q4: 48 &rarr; 41) &bull; Trái (Q3: 31 &rarr; 38)</span>
                            </div>
                        </div>

                        <!-- Odontogram Color Legend & Counter -->
                        <div class="p-3 bg-white border rounded-3 mt-3 shadow-sm">
                            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
                                <span class="fw-bold text-dark small">
                                    <i class="bi bi-palette2 me-1 text-primary"></i> Bảng Màu Phân Biệt Tình Trạng Răng (Hệ FDI):
                                </span>
                                <span class="text-muted small fs-11">Nhấn vào màu để lọc làm nổi bật các răng tương ứng</span>
                            </div>
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                <span class="legend-badge badge-healthy" onclick="highlightTeethByCondition('healthy')">
                                    <span class="legend-dot"></span> Khỏe mạnh (<span id="count-healthy">32</span>)
                                </span>
                                <span class="legend-badge badge-caries" onclick="highlightTeethByCondition('caries')">
                                    <span class="legend-dot"></span> Sâu răng (Caries) (<span id="count-caries">0</span>)
                                </span>
                                <span class="legend-badge badge-filled" onclick="highlightTeethByCondition('filled')">
                                    <span class="legend-dot"></span> Đã trám (Filled) (<span id="count-filled">0</span>)
                                </span>
                                <span class="legend-badge badge-missing" onclick="highlightTeethByCondition('missing')">
                                    <span class="legend-dot"></span> Mất răng (Missing) (<span id="count-missing">0</span>)
                                </span>
                                <span class="legend-badge badge-crown" onclick="highlightTeethByCondition('crown')">
                                    <span class="legend-dot"></span> Bọc sứ (Crown) (<span id="count-crown">0</span>)
                                </span>
                                <span class="legend-badge badge-pulpitis" onclick="highlightTeethByCondition('pulpitis')">
                                    <span class="legend-dot"></span> Viêm tủy (Pulpitis) (<span id="count-pulpitis">0</span>)
                                </span>
                                <span class="legend-badge badge-extractionneeded" onclick="highlightTeethByCondition('extractionneeded')">
                                    <span class="legend-dot"></span> Cần nhổ (<span id="count-extractionneeded">0</span>)
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Detailed Clinical Entries History Timeline -->
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                        <h5 class="card-title fw-bold text-slate-800 mb-0 d-flex align-items-center gap-2">
                            <i class="bi bi-journal-text text-primary"></i>
                            <span>Chi Tiết Lịch Sử Khám & Chẩn Đoán Lâm Sàng</span>
                            <span class="badge bg-secondary-subtle text-secondary rounded-pill fs-12 ms-1">@record.ClinicalEntries.Count đợt</span>
                        </h5>
                    </div>
                    <div class="card-body p-4 pt-2">
                        @if (record.ClinicalEntries.Any())
                        {
                            <div class="timeline-container">
                                @foreach (var entry in record.ClinicalEntries)
                                {
                                    <div class="card border rounded-3 p-3 mb-3 bg-light-subtle shadow-none" id="entryCard_@entry.ClinicalEntryId">
                                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2 pb-2 border-bottom">
                                            <div>
                                                <span class="fw-bold text-dark fs-15">
                                                    <i class="bi bi-calendar-event me-1 text-primary"></i>Ngày khám: @entry.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                                </span>
                                                <span class="text-muted small ms-2">Bác sĩ: <strong>@entry.DentistName</strong></span>
                                            </div>
                                            <div class="d-flex align-items-center gap-2">
                                                @if (!string.IsNullOrEmpty(entry.AppointmentCode))
                                                {
                                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                                        <i class="bi bi-ticket-perforated me-1"></i>@entry.AppointmentCode
                                                    </span>
                                                }
                                                <button type="button" class="btn btn-xs btn-outline-primary" onclick="switchOdontogramVisit('@entry.ClinicalEntryId')">
                                                    <i class="bi bi-diagram-3 me-1"></i> Xem Sơ Đồ Răng Đợt Này
                                                </button>
                                            </div>
                                        </div>

                                        <div class="row g-3 fs-14">
                                            @if (!string.IsNullOrEmpty(entry.Symptoms))
                                            {
                                                <div class="col-md-6">
                                                    <div class="text-muted small fw-semibold">Triệu chứng đến khám:</div>
                                                    <div class="text-slate-800">@entry.Symptoms</div>
                                                </div>
                                            }
                                            @if (!string.IsNullOrEmpty(entry.ClinicalFindings))
                                            {
                                                <div class="col-md-6">
                                                    <div class="text-muted small fw-semibold">Tiền sử & Dấu hiệu lâm sàng:</div>
                                                    <div class="text-slate-800">@entry.ClinicalFindings</div>
                                                </div>
                                            }
                                            <div class="col-12">
                                                <div class="text-muted small fw-semibold">Chẩn đoán chính:</div>
                                                <div class="fw-bold text-primary fs-15">@entry.Diagnosis</div>
                                            </div>
                                            @if (!string.IsNullOrEmpty(entry.ClinicalNotes))
                                            {
                                                <div class="col-12">
                                                    <div class="text-muted small fw-semibold">Kế hoạch điều trị & Lời dặn:</div>
                                                    <div class="text-muted fst-italic">@entry.ClinicalNotes</div>
                                                </div>
                                            }
                                            @if (entry.OdontogramEntries.Any())
                                            {
                                                <div class="col-12">
                                                    <div class="text-muted small fw-semibold mb-1">Răng tổn thương & can thiệp trong đợt này:</div>
                                                    <div class="d-flex flex-wrap gap-2">
                                                        @foreach (var tooth in entry.OdontogramEntries)
                                                        {
                                                            <span class="badge bg-light text-dark border px-2 py-1 fs-12">
                                                                Răng <strong>@tooth.ToothNumber</strong>: @tooth.Condition @(string.IsNullOrEmpty(tooth.Note) ? "" : $"({tooth.Note})")
                                                            </span>
                                                        }
                                                    </div>
                                                </div>
                                            }

                                            <!-- Dental Imaging Thumbnail Gallery -->
                                            <div class="col-12 mt-3 pt-3 border-top">
                                                <div class="d-flex justify-content-between align-items-center mb-2">
                                                    <span class="text-muted small fw-bold text-uppercase d-flex align-items-center gap-1">
                                                        <i class="bi bi-images text-primary"></i>
                                                        <span>Thư Viện Phim X-quang & Cận Lâm Sàng</span>
                                                        <span class="badge bg-primary-subtle text-primary ms-1">@entry.ImagingRecords.Count</span>
                                                    </span>
                                                </div>

                                                @if (entry.ImagingRecords.Any())
                                                {
                                                    <div class="row g-3">
                                                        @foreach (var img in entry.ImagingRecords)
                                                        {
                                                            var isDicom = (!string.IsNullOrEmpty(img.FileUrl) && (img.FileUrl.EndsWith(".dcm", StringComparison.OrdinalIgnoreCase) || img.FileUrl.EndsWith(".dicom", StringComparison.OrdinalIgnoreCase))) ||
                                                                          img.ImagingType.Equals("DICOM", StringComparison.OrdinalIgnoreCase);
                                                            var safeUrl = Url.Action("ImagingContent", "DentistMedicalRecord", new { imagingRecordId = img.ImagingRecordId });

                                                            <div class="col-6 col-md-4 col-lg-3">
                                                                <div class="card h-100 border rounded-3 shadow-none overflow-hidden bg-white">
                                                                    <div class="d-flex align-items-center justify-content-between px-2 pt-2 pb-1 border-bottom bg-light-subtle">
                                                                        <span class="badge bg-primary-subtle text-primary small text-truncate fw-semibold">
                                                                            <i class="bi bi-film me-1"></i>@img.ImagingType
                                                                        </span>
                                                                        <span class="text-muted fs-11">
                                                                            @img.CreatedAt.ToString("dd/MM/yyyy")
                                                                        </span>
                                                                    </div>

                                                                    @if (isDicom)
                                                                    {
                                                                        <div class="p-3 text-center bg-light d-flex flex-column align-items-center justify-content-center" style="min-height: 120px;">
                                                                            <i class="bi bi-file-earmark-medical-fill text-primary" style="font-size: 2rem;"></i>
                                                                            <span class="badge bg-primary-subtle text-primary border mt-2 small">DICOM</span>
                                                                            <a href="@safeUrl" class="btn btn-xs btn-outline-primary mt-2" download>Tải file</a>
                                                                        </div>
                                                                    }
                                                                    else
                                                                    {
                                                                        <div class="imaging-preview-container position-relative cursor-pointer" style="height: 130px; overflow: hidden;" onclick="openLightbox('@safeUrl', '@img.ImagingType', '@(img.ResultSummary?.Replace("'", "\\'") ?? "")')">
                                                                            <img src="@safeUrl" alt="@img.ImagingType" class="w-100 h-100 img-thumbnail-fit" />
                                                                        </div>
                                                                    }
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="text-center py-2 px-2 bg-light rounded-3 text-muted small my-1">
                                                        <span>Chưa có phim X-quang hoặc ảnh răng nào cho ca khám này.</span>
                                                    </div>
                                                }
                                            </div>

                                            <div class="col-12 text-end mt-2">
                                                <button type="button" class="btn btn-sm btn-outline-primary fw-medium" onclick="openUploadImagingModal(@entry.ClinicalEntryId, '@(entry.Diagnosis?.Replace("'", "\\'") ?? "")')">
                                                    <i class="bi bi-cloud-arrow-up-fill me-1"></i> Upload Phim X-quang / Ảnh Răng
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5 text-muted">
                                <i class="bi bi-journal-x fs-1 d-block mb-2 text-secondary"></i>
                                Bệnh nhân chưa có lượt ghi nhận chẩn đoán lâm sàng nào.
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-3 p-5 text-center text-muted">
            <i class="bi bi-person-lines-fill fs-1 d-block mb-2 text-secondary"></i>
            <h5>Vui lòng chọn một bệnh nhân để xem hồ sơ bệnh án điện tử và sơ đồ răng.</h5>
            <div class="mt-3">
                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalSwitchPatient">
                    <i class="bi bi-search me-1"></i> Tra Cứu Danh Sách Bệnh Nhân
                </button>
            </div>
        </div>
    }
</div>

<!-- ==================================================== -->
<!-- MODAL: ĐỔI / TRA CỨU BỆNH NHÂN KHÁC                  -->
<!-- ==================================================== -->
<div class="modal fade" id="modalSwitchPatient" tabindex="-1" aria-labelledby="modalSwitchPatientLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-white border-bottom">
                <h5 class="modal-title fw-bold text-dark" id="modalSwitchPatientLabel">
                    <i class="bi bi-people text-primary me-2"></i>Chọn Bệnh Nhân Khác
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-3">
                <form method="get" class="input-group input-group-sm mb-3">
                    <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Tìm theo tên, Mã BN, SĐT...">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i></button>
                </form>

                <div class="list-group overflow-auto" style="max-height: 400px;">
                    @if (Model.Patients.Any())
                    {
                        foreach (var p in Model.Patients)
                        {
                            var isActive = p.PatientUserId == Model.SelectedPatientUserId;
                            <a asp-action="Index" asp-route-patientId="@p.PatientUserId" 
                               class="list-group-item list-group-item-action p-2 @(isActive ? "active text-white bg-primary" : "")">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="fw-bold">@p.FullName</div>
                                    <span class="badge @(isActive ? "bg-white text-primary" : "bg-light text-muted border") fs-11">@p.PatientCode</span>
                                </div>
                                <div class="small @(isActive ? "text-white-50" : "text-muted")">
                                    SĐT: @(p.PhoneNumber ?? "N/A") &bull; @(p.Gender ?? "—")
                                </div>
                            </a>
                        }
                    }
                    else
                    {
                        <div class="text-center py-3 text-muted small">
                            Không tìm thấy bệnh nhân nào.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ==================================================== -->
<!-- MODAL: GHI NHẬN CHẨN ĐOÁN LÂM SÀNG & CẬP NHẬT RĂNG -->
<!-- ==================================================== -->
@if (record != null)
{
    <div class="modal fade" id="modalCreateClinicalEntry" tabindex="-1" aria-labelledby="modalCreateClinicalEntryLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold" id="modalCreateClinicalEntryLabel">
                        <i class="bi bi-clipboard2-plus-fill me-2"></i>Ghi Nhận Chẩn Đoán Bệnh Án Cho @record.PatientName
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-action="CreateEntry" method="post" enctype="multipart/form-data" id="formCreateClinicalEntry">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="PatientUserId" value="@record.PatientUserId" />
                    <input type="hidden" name="AppointmentId" value="@(Model.ActiveAppointmentId ?? Model.NewEntryForm?.AppointmentId)" />
                    <input type="hidden" id="toothConditionsJsonInput" name="ToothConditionsJson" value="[]" />

                    <div class="modal-body p-4">
                        @if (Model.ActiveAppointmentId.HasValue)
                        {
                            <div class="alert alert-info py-2 px-3 mb-3 small d-flex align-items-center gap-2">
                                <i class="bi bi-calendar2-check-fill text-primary"></i>
                                <span>Đang ghi nhận chẩn đoán cho ca khám: <strong>@(activeAppt?.AppointmentCode ?? $"#{Model.ActiveAppointmentId}")</strong>.</span>
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-slate-700" for="newEntryDiagnosis">Chẩn đoán chính của bác sĩ <span class="text-danger">*</span></label>
                            <input type="text" id="newEntryDiagnosis" name="Diagnosis" class="form-control" placeholder="Ví dụ: Sâu răng mặt nhai R16, Viêm nướu quanh răng R46..." required />
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-slate-700" for="newEntrySymptoms">Triệu chứng đến khám</label>
                                <textarea id="newEntrySymptoms" name="Symptoms" class="form-control" rows="2" placeholder="Ví dụ: Ê buốt khi ăn đồ lạnh, đau nhức về đêm..."></textarea>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-slate-700" for="newEntryClinicalFindings">Tiền sử bệnh & Dấu hiệu lâm sàng</label>
                                <textarea id="newEntryClinicalFindings" name="ClinicalFindings" class="form-control" rows="2" placeholder="Ví dụ: Dị ứng Penicillin, huyết áp ổn định..."></textarea>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-slate-700" for="newEntryClinicalNotes">Kế hoạch điều trị & Lời dặn</label>
                            <textarea id="newEntryClinicalNotes" name="ClinicalNotes" class="form-control" rows="2" placeholder="Ví dụ: Trám composite R16, hẹn tái khám sau 1 tuần..."></textarea>
                        </div>

                        <!-- Chỉ Định Chụp X-Quang / Cận Lâm Sàng -->
                        <div class="border rounded-3 p-3 bg-light mb-3">
                            <label class="form-label fw-bold text-slate-800 d-flex justify-content-between align-items-center mb-2">
                                <span><i class="bi bi-camera-fill me-1 text-info"></i> Chỉ Định Chụp Phim X-Quang / Cận Lâm Sàng:</span>
                            </label>
                            <div class="row g-2">
                                <div class="col-md-5">
                                    <select name="ImagingType" id="createEntryImagingType" class="form-select form-select-sm">
                                        <option value="">-- Không yêu cầu chụp phim --</option>
                                        <option value="Panorama">Toàn cảnh Panorama (OPG)</option>
                                        <option value="Periapical">Cận chóp / Quanh chóp (Periapical)</option>
                                        <option value="Cephalometric">Phim sọ nghiêng Cephalometric</option>
                                        <option value="Intraoral">Ảnh chụp trong miệng (Intraoral)</option>
                                    </select>
                                </div>
                                <div class="col-md-7">
                                    <input type="text" name="ImagingResultSummary" id="createEntryImagingResultSummary" class="form-control form-control-sm" placeholder="Vị trí/mục đích chụp (VD: Khảo sát răng ngầm R48, cuống răng R16...)" />
                                </div>

                                <!-- File Upload & Preview Section -->
                                <div class="col-12 mt-2">
                                    <div class="card border rounded-3 p-2 bg-white">
                                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                                            <div class="d-flex align-items-center gap-2">
                                                <input type="file"
                                                       id="createEntryImagingFileInput"
                                                       name="ImagingFile"
                                                       class="d-none"
                                                       accept=".jpg,.jpeg,.png,.dcm,.dicom" />
                                                <button type="button"
                                                        id="btnSelectImagingFile"
                                                        class="btn btn-sm btn-outline-primary fw-medium"
                                                        onclick="document.getElementById('createEntryImagingFileInput').click()">
                                                    <i class="bi bi-cloud-arrow-up-fill me-1"></i> Chọn ảnh X-quang
                                                </button>
                                                <span class="text-muted small" id="createEntryFileHint">
                                                    <i class="bi bi-info-circle me-1"></i>(Tùy chọn nếu đã chụp) Hỗ trợ JPG, JPEG, PNG, DICOM (.dcm, .dicom) — Tối đa 15 MB.
                                                </span>
                                            </div>
                                            <button type="button"
                                                    id="btnRemoveImagingFile"
                                                    class="btn btn-sm btn-link text-danger text-decoration-none p-0 d-none"
                                                    onclick="clearCreateEntryImagingFile()">
                                                <i class="bi bi-x-circle me-1"></i>Hủy chọn ảnh
                                            </button>
                                        </div>

                                        <!-- Validation Error Alert -->
                                        <div id="createEntryFileError" class="text-danger small mt-2 d-none">
                                            <i class="bi bi-exclamation-triangle-fill me-1"></i><span id="createEntryFileErrorText"></span>
                                        </div>

                                        <!-- Preview Box -->
                                        <div id="createEntryFilePreviewContainer" class="mt-2 pt-2 border-top d-none">
                                            <!-- Image Preview (JPG / PNG) -->
                                            <div id="createEntryImagePreviewCard" class="d-none d-flex align-items-center gap-3 p-2 rounded bg-light border">
                                                <div class="position-relative" style="width: 72px; height: 72px; flex-shrink: 0;">
                                                    <img id="createEntryImagePreviewThumb"
                                                         src=""
                                                         alt="Xem trước ảnh X-quang"
                                                         class="w-100 h-100 rounded object-fit-cover border" />
                                                </div>
                                                <div class="flex-grow-1 overflow-hidden">
                                                    <div class="d-flex align-items-center gap-2 mb-1">
                                                        <span class="badge bg-success-subtle text-success border border-success-subtle small fw-semibold">
                                                            <i class="bi bi-image me-1"></i>Hình ảnh hợp lệ
                                                        </span>
                                                        <span class="text-muted small" id="createEntryImageFileSize"></span>
                                                    </div>
                                                    <div class="fw-semibold text-slate-800 small text-truncate" id="createEntryImageFileName"></div>
                                                    <div class="text-muted small" style="font-size: 0.75rem;">Sẽ tự động đính kèm và lưu ảnh X-quang khi bấm "Lưu Bệnh Án".</div>
                                                </div>
                                            </div>

                                            <!-- DICOM Card (No simulated image preview) -->
                                            <div id="createEntryDicomPreviewCard" class="d-none d-flex align-items-center gap-3 p-2 rounded bg-light border">
                                                <div class="d-flex align-items-center justify-content-center bg-primary-subtle text-primary rounded border border-primary-subtle" style="width: 72px; height: 72px; flex-shrink: 0;">
                                                    <i class="bi bi-file-earmark-medical-fill fs-2"></i>
                                                </div>
                                                <div class="flex-grow-1 overflow-hidden">
                                                    <div class="d-flex align-items-center gap-2 mb-1">
                                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle small fw-semibold">
                                                            <i class="bi bi-hospital me-1"></i>DICOM PS 3.10
                                                        </span>
                                                        <span class="text-muted small" id="createEntryDicomFileSize"></span>
                                                    </div>
                                                    <div class="fw-semibold text-slate-800 small text-truncate" id="createEntryDicomFileName"></div>
                                                    <div class="text-muted small" style="font-size: 0.75rem;">Tập tin y tế chuyên dụng (không hiển thị preview ảnh phẳng). Sẽ được đính kèm và lưu trữ an toàn cùng bệnh án.</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Ghi Nhận Răng Có Can Thiệp / Tổn Thương -->
                        <div class="border rounded-3 p-3 bg-light mb-3">
                            <label class="form-label fw-bold text-slate-800 d-flex justify-content-between align-items-center mb-2">
                                <span><i class="bi bi-tools me-1 text-primary"></i> Ghi Nhận Răng Có Tổn Thương / Thủ Thuật:</span>
                                <button type="button" class="btn btn-sm btn-outline-primary" onclick="addToothRow()">
                                    <i class="bi bi-plus-lg me-1"></i> Thêm Răng
                                </button>
                            </label>
                            <div id="toothRowsContainer" class="d-flex flex-column gap-2">
                                <!-- Dynamic rows added by JS -->
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy Bỏ</button>
                        <button type="submit" class="btn btn-primary px-4 fw-medium" onclick="prepareToothConditionsJson()">
                            <i class="bi bi-save me-1"></i> Lưu Bệnh Án & Sơ Đồ Răng
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- ==================================================== -->
    <!-- MODAL: THÊM DỊCH VỤ / GHẾ LÀM TIẾP (SERVICE TRANSITION) -->
    <!-- ==================================================== -->
    <div class="modal fade" id="modalAddAdditionalService" tabindex="-1" aria-labelledby="modalAddAdditionalServiceLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-warning text-dark">
                    <h5 class="modal-title fw-bold" id="modalAddAdditionalServiceLabel">
                        <i class="bi bi-plus-circle-fill me-2"></i>Chuyển Tiếp Dịch Vụ / Ghế Làm Tiếp
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-action="AddAdditionalService" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="AppointmentId" value="@(Model.ActiveAppointmentId ?? 0)" />
                    <input type="hidden" name="PatientUserId" value="@record.PatientUserId" />

                    <div class="modal-body p-4">
                        <div class="alert alert-light border mb-3 small">
                            Bệnh nhân: <strong>@record.PatientName</strong> &bull; Ca khám hiện tại: <strong>@(activeAppt?.AppointmentCode ?? "--")</strong>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Chọn Dịch Vụ Cần Làm Thêm / Chuyển Tiếp <span class="text-danger">*</span></label>
                            <select name="serviceId" class="form-select" required>
                                <option value="">-- Chọn dịch vụ nha khoa --</option>
                                @foreach (var s in Model.DepartmentServices)
                                {
                                    <option value="@s.DepartmentServiceId">@s.ServiceName - @(s.Price.HasValue ? $"{s.Price:N0} đ" : "Theo chẩn đoán") (@(s.DurationMinutes ?? 30) phút)</option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Hình Thức Tiếp Nhận & Phục Vụ <span class="text-danger">*</span></label>
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="radio" name="executionMode" id="execSelf" value="self" checked onchange="toggleExecMode()">
                                <label class="form-check-label fw-bold text-dark" for="execSelf">
                                    <i class="bi bi-person-check text-success me-1"></i> Bác sĩ tự thực hiện ngay cho bệnh nhân tại ghế
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="executionMode" id="execDelegate" value="delegate" onchange="toggleExecMode()">
                                <label class="form-check-label fw-bold text-dark" for="execDelegate">
                                    <i class="bi bi-arrow-left-right text-primary me-1"></i> Chuyển giao cho bác sĩ khác trong chuyên khoa đang rảnh
                                </label>
                            </div>
                        </div>

                        <!-- Panel: Chọn ghế nếu bác sĩ tự làm -->
                        <div id="panelChairSelection" class="p-3 bg-light rounded border mb-3">
                            <label class="form-label fw-semibold small text-muted mb-1">Ghế nha khoa điều trị:</label>
                            <select name="dentalChairId" class="form-select form-select-sm">
                                @if (Model.AvailableChairs.Any())
                                {
                                    foreach (var c in Model.AvailableChairs)
                                    {
                                        var isSelected = activeAppt?.DentalChairId == c.DentalChairId;
                                        <option value="@c.DentalChairId" selected="@isSelected">Ghế @c.ChairCode @(isSelected ? "(Ghế hiện tại)" : "")</option>
                                    }
                                }
                                else
                                {
                                    <option value="0">Ghế hiện tại của ca khám</option>
                                }
                            </select>
                        </div>

                        <!-- Panel: Chọn bác sĩ nếu chuyển giao -->
                        <div id="panelDentistSelection" class="p-3 bg-light rounded border mb-3" style="display: none;">
                            <label class="form-label fw-semibold small text-muted mb-1">Bác sĩ tiếp nhận chuyển giao:</label>
                            <select name="targetDentistUserId" class="form-select form-select-sm">
                                <option value="">-- Chọn bác sĩ cùng chuyên khoa --</option>
                                @foreach (var d in Model.DepartmentDentists)
                                {
                                    <option value="@d.UserId">@d.FullName - @d.Qualification</option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Số lượng thực hiện:</label>
                            <input type="number" name="quantity" class="form-control" value="1" min="1" max="32" />
                        </div>

                        <div class="mb-2">
                            <label class="form-label fw-semibold">Ghi chú & Chỉ định bổ sung:</label>
                            <textarea name="notes" class="form-control" rows="2" placeholder="Ví dụ: Bệnh nhân muốn cạo vôi răng và đánh bóng sau khi khám..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-warning fw-semibold px-4">
                            <i class="bi bi-check2-circle me-1"></i> Xác Nhận Ghi Nhận Dịch Vụ
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- ==================================================== -->
    <!-- MODAL: KÊ ĐƠN THUỐC NHANH TẠI GHẾ (PRESCRIPTION)     -->
    <!-- ==================================================== -->
    <div class="modal fade" id="modalQuickPrescription" tabindex="-1" aria-labelledby="modalQuickPrescriptionLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title fw-bold" id="modalQuickPrescriptionLabel">
                        <i class="bi bi-capsule me-2"></i>Kê Đơn Thuốc Điện Tử Tại Ghế
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-action="CreatePrescriptionQuick" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="appointmentId" value="@(Model.ActiveAppointmentId ?? 0)" />
                    <input type="hidden" name="patientUserId" value="@record.PatientUserId" />

                    <div class="modal-body p-4">
                        <div class="alert alert-light border mb-3 small d-flex justify-content-between align-items-center">
                            <div>Bệnh nhân: <strong>@record.PatientName</strong> &bull; Ca khám: <strong>@(activeAppt?.AppointmentCode ?? "--")</strong></div>
                            <span class="badge bg-success-subtle text-success border">Kê đơn trực tiếp</span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Lời dặn chung / Hướng dẫn uống thuốc:</label>
                            <input type="text" name="generalInstructions" class="form-control" placeholder="Ví dụ: Uống sau ăn no, kiêng rượu bia, uống nhiều nước..." />
                        </div>

                        <div class="card border rounded-3 p-3 bg-light mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label class="fw-bold text-dark mb-0"><i class="bi bi-capsule-pill text-success me-1"></i>Danh Mục Thuốc Kê Đơn:</label>
                                <button type="button" class="btn btn-sm btn-outline-success" onclick="addMedicationRow()">
                                    <i class="bi bi-plus-lg me-1"></i>Thêm Thuốc
                                </button>
                            </div>

                            <div id="medicationRowsContainer" class="d-flex flex-column gap-2">
                                <!-- Initial Medication Row -->
                                <div class="row g-2 align-items-center bg-white p-2 rounded border med-row">
                                    <div class="col-md-4">
                                        <label class="small text-muted mb-1">Thuốc trong kho:</label>
                                        <select class="form-select form-select-sm med-select" onchange="onMedSelectChange(this)">
                                            <option value="">-- Chọn thuốc có sẵn --</option>
                                            @foreach (var med in Model.AvailableMedicines)
                                            {
                                                <option value="@med.MedicineName" data-dosage="@(med.Concentration ?? "")" data-unit="@med.Unit">
                                                    @med.MedicineName (@(med.Concentration ?? "")) - Tồn: @med.TotalAvailableStock @med.Unit
                                                </option>
                                            }
                                        </select>
                                        <input type="text" name="medicationNames[]" class="form-control form-control-sm mt-1 med-name-input" placeholder="Tên thuốc..." required />
                                    </div>
                                    <div class="col-md-2">
                                        <label class="small text-muted mb-1">Hàm lượng:</label>
                                        <input type="text" name="dosages[]" class="form-control form-control-sm med-dosage-input" placeholder="500mg..." />
                                    </div>
                                    <div class="col-md-2">
                                        <label class="small text-muted mb-1">Tần suất:</label>
                                        <input type="text" name="frequencies[]" class="form-control form-control-sm" value="2 lần/ngày (sau ăn)" required />
                                    </div>
                                    <div class="col-md-2">
                                        <label class="small text-muted mb-1">Thời gian:</label>
                                        <input type="text" name="durations[]" class="form-control form-control-sm" value="5 ngày" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="small text-muted mb-1">Cách dùng:</label>
                                        <div class="input-group input-group-sm">
                                            <input type="text" name="instructions[]" class="form-control" placeholder="Uống với nhiều nước..." />
                                            <button type="button" class="btn btn-outline-danger" onclick="removeMedRow(this)" title="Xóa dòng">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-success px-4 fw-semibold">
                            <i class="bi bi-save me-1"></i> Lưu Đơn Thuốc Điện Tử
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- ==================================================== -->
    <!-- MODAL: CẤP THUỐC TRỰC TIẾP TẠI GHẾ (DISPENSING)      -->
    <!-- ==================================================== -->
    <div class="modal fade" id="modalDirectDispense" tabindex="-1" aria-labelledby="modalDirectDispenseLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title fw-bold" id="modalDirectDispenseLabel">
                        <i class="bi bi-box-seam me-2"></i>Cấp Thuốc Trực Tiếp Tại Ghế
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-action="DispenseMedicineQuick" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="appointmentId" value="@(Model.ActiveAppointmentId ?? 0)" />
                    <input type="hidden" name="patientUserId" value="@record.PatientUserId" />
                    <input type="hidden" name="prescriptionId" value="@(Model.ActivePrescription?.PrescriptionId ?? 0)" />
                    <input type="hidden" id="dispenseMedicineIdHidden" name="medicineId" value="0" />

                    <div class="modal-body p-4">
                        <div class="alert alert-warning py-2 px-3 small border-0 bg-warning-subtle text-dark mb-3">
                            <i class="bi bi-exclamation-triangle-fill text-warning me-1"></i>
                            DentalCare không có Dược sĩ. Bác sĩ tự chọn lô thuốc còn hạn và cấp phát cho bệnh nhân. Hệ thống tự động trừ tồn kho (FEFO) và chống xuất âm.
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">1. Chọn thuốc cần cấp phát: <span class="text-danger">*</span></label>
                            <select id="dispenseMedicineSelect" class="form-select" onchange="loadBatchesForSelectedMed(this)" required>
                                <option value="">-- Chọn thuốc trong danh mục kho --</option>
                                @foreach (var med in Model.AvailableMedicines)
                                {
                                    <option value="@med.MedicineId" data-stock="@med.TotalAvailableStock" data-unit="@med.Unit">
                                        @med.MedicineName (@(med.Concentration ?? "")) - Khả dụng: @med.TotalAvailableStock @med.Unit
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">2. Chọn Lô thuốc còn hạn (FEFO): <span class="text-danger">*</span></label>
                            <select id="dispenseBatchSelect" name="batchId" class="form-select" required onchange="onBatchSelected(this)">
                                <option value="">-- Vui lòng chọn thuốc trước --</option>
                            </select>
                            <div class="form-text small text-muted" id="batchStockInfo"></div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">3. Số lượng thực tế bàn giao cho bệnh nhân: <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input type="number" id="dispenseQuantityInput" name="quantity" class="form-control" value="6" min="1" max="100" required />
                                <span class="input-group-text" id="dispenseUnitText">Viên</span>
                            </div>
                            <div class="form-text small text-muted">Nếu kê 10 viên và cấp 6 viên, hệ thống chỉ trừ đúng 6 viên trong kho.</div>
                        </div>

                        <div class="mb-2">
                            <label class="form-label fw-semibold">Ghi chú cấp phát (tùy chọn):</label>
                            <input type="text" name="notes" class="form-control" placeholder="Ghi chú bàn giao tại ghế..." />
                        </div>
                    </div>
                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-success px-4 fw-semibold">
                            <i class="bi bi-box-seam me-1"></i> Xác Nhận Cấp & Trừ Kho
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal Phóng To Ảnh X-Quang (Lightbox - Commit 16) -->
    <div class="modal fade" id="imagingLightboxModal" tabindex="-1" aria-labelledby="imagingLightboxModalLabel" aria-hidden="true" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-xl modal-dialog-centered" style="max-width: min(92vw, 1300px); width: 92vw;">
            <div class="modal-content bg-dark text-white border-0 shadow-lg overflow-hidden w-100">
                <div class="modal-header border-secondary border-opacity-50 py-2 px-3 bg-dark">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-aspect-ratio text-info fs-5"></i>
                        <span class="badge bg-primary text-white px-2 py-1" id="lightboxTypeBadge">X-Quang</span>
                        <span class="text-white-50 small ms-2" id="lightboxDate"></span>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng (Esc)"></button>
                </div>
                <div class="modal-body p-0 position-relative d-flex justify-content-center align-items-center bg-black basic-imaging-viewport" style="min-height: 380px; height: 72vh; max-height: calc(100vh - 200px); width: 100%; overflow: hidden;">
                    <!-- Loading State -->
                    <div id="lightboxLoadingSpinner" class="position-absolute d-flex flex-column align-items-center justify-content-center text-white">
                        <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                            <span class="visually-hidden">Đang tải phim X-quang...</span>
                        </div>
                        <span class="small text-white-50 mt-2">Đang tải ảnh chuẩn nét...</span>
                    </div>

                    <!-- Error State -->
                    <div id="lightboxErrorAlert" class="p-4 text-center text-warning d-none">
                        <i class="bi bi-exclamation-triangle-fill fs-1 text-warning mb-2 d-block"></i>
                        <h6 class="text-white">Không thể hiển thị ảnh phóng to</h6>
                        <p class="small text-white-50 mb-0">Tệp ảnh có thể đã bị xóa hoặc phiên truy cập đã hết hạn. Vui lòng thử tải lại trang.</p>
                    </div>

                    <!-- Large Image (Aspect Ratio Preserved & Fit to Screen) -->
                    <img id="lightboxImage"
                         src=""
                         class="d-none"
                         style="width: 100%; height: 100%; max-width: 100%; max-height: 100%; object-fit: contain;"
                         alt="Phóng to phim X-quang nha khoa" />
                </div>
                <div class="modal-footer border-secondary border-opacity-50 py-2 px-3 justify-content-between bg-dark">
                    <div class="text-start flex-grow-1 me-3">
                        <div class="small fw-semibold text-info mb-0"><i class="bi bi-journal-text me-1"></i>Kết luận đọc phim:</div>
                        <div id="lightboxResultSummary" class="text-white-50 small text-wrap"></div>
                    </div>
                    <div class="d-flex gap-2 align-items-center">
                        <a id="lightboxDownloadBtn" href="#" download class="btn btn-sm btn-outline-light">
                            <i class="bi bi-download me-1"></i> Tải ảnh
                        </a>
                        <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">
                            <i class="bi bi-x-lg me-1"></i> Đóng (Esc)
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ==================================================== -->
    <!-- MODAL: HOÀN THÀNH CA KHÁM VÀ ĐIỀU TRỊ                -->
    <!-- ==================================================== -->
    <div class="modal fade" id="modalCompleteExam" tabindex="-1" aria-labelledby="modalCompleteExamLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title fw-bold" id="modalCompleteExamLabel">
                        <i class="bi bi-check-circle-fill me-2"></i>Xác Nhận Hoàn Thành Ca Khám
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-action="CompleteExam" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="completeAppointmentId" name="appointmentId" value="@(Model.ActiveAppointmentId ?? 0)" />
                    <input type="hidden" name="patientUserId" value="@record.PatientUserId" />

                    <div class="modal-body p-4">
                        <div class="alert alert-light border mb-3">
                            <div class="small text-muted">Mã lịch hẹn: <strong id="completeApptCode" class="font-monospace text-primary">@(activeAppt?.AppointmentCode ?? "--")</strong></div>
                            <div class="small text-muted">Bệnh nhân: <strong class="text-dark">@record.PatientName</strong></div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Lời dặn dò bệnh nhân & Kết luận buổi điều trị:</label>
                            <textarea name="notes" class="form-control" rows="3" placeholder="Nhập lời dặn sau khi điều trị (kiêng ăn uống, vệ sinh răng miệng, chỉ định phục hồi...)..."></textarea>
                        </div>

                        <!-- Khối Kế Hoạch Tái Khám / Theo Dõi Lâm Sàng (Guard 5) -->
                        <div class="card border rounded-3 p-3 mb-3 bg-light-subtle">
                            <h6 class="fw-bold text-dark mb-2">
                                <i class="bi bi-calendar-plus text-primary me-1"></i> Kế Hoạch Tái Khám & Theo Dõi (Nếu Có)
                            </h6>
                            <div class="row g-2">
                                <div class="col-md-6">
                                    <label class="form-label small text-muted">Ngày khuyến nghị tái khám:</label>
                                    <input type="date" name="recommendedFollowUpDate" class="form-control form-control-sm" value="@(DateTime.UtcNow.AddDays(7).ToString("yyyy-MM-dd"))" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small text-muted">Mục đích theo dõi:</label>
                                    <select name="followUpReasonCategory" class="form-select form-select-sm">
                                        <option value="Chưa chốt ngày" selected>Chưa chốt ngày (Bệnh nhân cân nhắc)</option>
                                        <option value="Theo dõi lành thương">Theo dõi lành thương sau phẫu thuật</option>
                                        <option value="Định kỳ thay thun / khí cụ">Định kỳ thay thun / siết khí cụ</option>
                                        <option value="Theo dõi tủy răng">Theo dõi tủy / lành thương quanh chóp</option>
                                        <option value="Tái khám định kỳ">Tái khám chăm sóc định kỳ</option>
                                    </select>
                                </div>
                                <div class="col-12 mt-2">
                                    <label class="form-label small text-muted">Lý do / Hướng dẫn tái khám:</label>
                                    <input type="text" name="followUpReason" class="form-control form-control-sm" placeholder="VD: Tái khám kiểm tra vết thương và cắt chỉ sau 7 ngày..." />
                                </div>
                            </div>
                        </div>

                        <div class="alert alert-warning py-2 small mb-0">
                            <i class="bi bi-info-circle me-1"></i> Ca khám sẽ được chuyển sang trạng thái <strong>Hoàn thành (Completed)</strong>, giải phóng ghế nha khoa và đồng bộ dữ liệu sang quầy thu ngân.
                        </div>
                    </div>
                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Quay Lại</button>
                        <button type="submit" class="btn btn-danger fw-bold px-4">
                            <i class="bi bi-check-circle-fill me-1"></i> Hoàn Thành Ca Khám
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal Upload Phim X-Quang -->
    <div class="modal fade" id="modalUploadImaging" tabindex="-1" aria-labelledby="modalUploadImagingLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold" id="modalUploadImagingLabel">
                        <i class="bi bi-cloud-arrow-up-fill me-2"></i>Upload Phim X-quang / Ảnh Răng
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-action="UploadImaging" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="uploadClinicalEntryId" name="ClinicalEntryId" value="0" />
                    <input type="hidden" name="PatientUserId" value="@record.PatientUserId" />

                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Chọn tập tin ảnh / DICOM <span class="text-danger">*</span></label>
                            <input type="file" name="File" class="form-control" accept=".jpg,.jpeg,.png,.dcm,.dicom" required />
                            <div class="form-text small">Hỗ trợ JPG, PNG hoặc file y tế DICOM (tối đa 15MB).</div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Loại phim chụp <span class="text-danger">*</span></label>
                            <select name="ImagingType" class="form-select" required>
                                <option value="Panorama">Toàn cảnh Panorama</option>
                                <option value="Periapical">Cận chóp răng (Periapical)</option>
                                <option value="Cephalometric">Sọ nghiêng Cephalometric</option>
                                <option value="Bitewing">Cánh cắn (Bitewing)</option>
                                <option value="Intraoral">Ảnh chụp trong miệng (Intraoral)</option>
                                <option value="DICOM">File y tế DICOM chuyên dụng</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Kết luận đọc phim / Mô tả tổn thương</label>
                            <textarea name="ResultSummary" class="form-control" rows="2" placeholder="Ví dụ: Răng 16 sâu mặt nhai, tiêu xương nhẹ..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                        <button type="submit" class="btn btn-primary fw-medium px-4">
                            <i class="bi bi-upload me-1"></i> Tải Lên Phim
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal Đặt Lịch Tái Khám (Day 03) -->
    <div class="modal fade" id="modalCreateFollowUpAppointment" tabindex="-1" aria-labelledby="modalCreateFollowUpAppointmentLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-success text-white py-3">
                    <h5 class="modal-title fw-bold" id="modalCreateFollowUpAppointmentLabel">
                        <i class="bi bi-calendar-heart-fill me-2"></i>Đặt Lịch Hẹn Tái Khám Cho Bệnh Nhân
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="formDoctorBookFollowUp" asp-action="BookFollowUp" method="post" onsubmit="return handleFollowUpSubmit(event);">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="PatientUserId" value="@(record.PatientUserId)" />
                    <input type="hidden" id="selectedFollowUpStart" name="ScheduledStart" value="" />
                    <input type="hidden" id="selectedFollowUpEnd" name="ScheduledEnd" value="" />

                    <div class="modal-body p-4">
                        <!-- Patient & Doctor Info Summary -->
                        <div class="row g-3 p-3 bg-light rounded-3 mb-4 border">
                            <div class="col-md-6">
                                <label class="small text-muted mb-1 d-block"><i class="bi bi-person-fill text-primary me-1"></i>Bệnh nhân:</label>
                                <div class="fw-bold text-dark fs-6">@record.PatientName</div>
                                <div class="small text-muted">Mã BN: <span class="badge bg-secondary-subtle text-secondary">@record.PatientCode</span></div>
                            </div>
                            <div class="col-md-6">
                                <label class="small text-muted mb-1 d-block"><i class="bi bi-person-badge-fill text-success me-1"></i>Bác sĩ phụ trách tái khám:</label>
                                <div class="fw-bold text-dark fs-6">@(User.Identity?.Name ?? "Bác sĩ điều trị")</div>
                                <div class="small text-muted"><i class="bi bi-hospital me-1"></i>Phòng khám Nha Khoa DentalCare</div>
                            </div>
                        </div>

                        <!-- Date & Slot Picker -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-slate-700">
                                    <i class="bi bi-calendar-event me-1 text-primary"></i>Chọn ngày tái khám: <span class="text-danger">*</span>
                                </label>
                                <input type="date" id="followUpDateInput" class="form-control" 
                                       value="@(DateTime.Today.AddDays(7).ToString("yyyy-MM-dd"))" 
                                       min="@(DateTime.Today.ToString("yyyy-MM-dd"))"
                                       onchange="loadDoctorFollowUpSlots();" required />
                                <div class="form-text small text-muted">Gợi ý: Mặc định tái khám sau 7 ngày điều trị.</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-slate-700">
                                    <i class="bi bi-hourglass-split me-1 text-primary"></i>Thời lượng hẹn:
                                </label>
                                <select id="followUpDurationSelect" class="form-select" onchange="loadDoctorFollowUpSlots();">
                                    <option value="30" selected>30 phút (Tái khám tiêu chuẩn / Cắt chỉ)</option>
                                    <option value="45">45 phút (Kiểm tra khớp cắn / Chỉnh nha)</option>
                                    <option value="60">60 phút (Điều trị tủy bước tiếp / Thử mão)</option>
                                </select>
                            </div>
                        </div>

                        <!-- Available Slots Area -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold text-slate-700 d-flex justify-content-between align-items-center">
                                <span><i class="bi bi-clock-history me-1 text-primary"></i>Khung giờ trống khả dụng: <span class="text-danger">*</span></span>
                                <span id="slotStatusBadge" class="badge bg-light text-muted fw-normal">Đang cập nhật...</span>
                            </label>

                            <!-- Loading Spinner -->
                            <div id="followUpSlotsSpinner" class="text-center py-4 bg-light rounded-3 d-none">
                                <div class="spinner-border spinner-border-sm text-success me-2" role="status"></div>
                                <span class="small text-muted">Đang kiểm tra lịch làm việc & tìm giờ trống...</span>
                            </div>

                            <!-- Slots Grid -->
                            <div id="followUpSlotsGrid" class="d-flex flex-wrap gap-2 p-3 bg-light rounded-3 border" style="min-height: 80px; max-height: 180px; overflow-y: auto;">
                                <!-- Dynamic buttons generated via JS -->
                            </div>

                            <!-- Empty alert -->
                            <div id="followUpSlotsEmptyAlert" class="alert alert-warning py-2 px-3 small border-0 bg-warning-subtle text-dark d-none mt-2">
                                <i class="bi bi-exclamation-triangle-fill text-warning me-1"></i>
                                <span>Bác sĩ không có khung giờ trống nào vào ngày đã chọn. Vui lòng chọn một ngày khác hoặc đổi thời lượng.</span>
                            </div>
                        </div>

                        <!-- Reason -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-slate-700">
                                <i class="bi bi-clipboard-pulse me-1 text-primary"></i>Nội dung / Lý do tái khám: <span class="text-danger">*</span>
                            </label>
                            <select id="followUpPresetReason" class="form-select mb-2" onchange="applyPresetReason();">
                                <option value="">-- Chọn nội dung chỉ định tái khám mẫu --</option>
                                <option value="Cắt chỉ sau phẫu thuật / nhổ răng">Cắt chỉ sau phẫu thuật / nhổ răng</option>
                                <option value="Kiểm tra và điều trị tủy giai đoạn tiếp theo">Kiểm tra và điều trị tủy giai đoạn tiếp theo</option>
                                <option value="Thử sườn / gắn mão sứ phục hình">Thử sườn / gắn mão sứ phục hình</option>
                                <option value="Tái khám siết cung chỉnh nha">Tái khám siết cung chỉnh nha</option>
                                <option value="Kiểm tra khớp cắn và theo dõi lành thương">Kiểm tra khớp cắn và theo dõi lành thương</option>
                                <option value="Tái khám định kỳ sau điều trị nha chu">Tái khám định kỳ sau điều trị nha chu</option>
                                <option value="other">Lý do khác (tự nhập bên dưới)</option>
                            </select>
                            <input type="text" id="followUpReasonInput" name="Reason" class="form-control" placeholder="Nhập lý do hoặc chỉ định cụ thể cho buổi tái khám..." required maxlength="250" />
                        </div>

                        <!-- Notes for Patient -->
                        <div class="mb-2">
                            <label class="form-label fw-semibold text-slate-700">
                                <i class="bi bi-chat-left-dots me-1 text-primary"></i>Lời dặn thêm cho bệnh nhân (tùy chọn):
                            </label>
                            <textarea name="Notes" class="form-control" rows="2" placeholder="Ví dụ: Kiêng nhai đồ cứng, uống thuốc đúng giờ, chườm lạnh nếu còn ê buốt..."></textarea>
                        </div>
                    </div>

                    <div class="modal-footer bg-light py-2 px-3">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                        <button type="submit" id="btnSubmitFollowUp" class="btn btn-success px-4 fw-semibold" disabled>
                            <span id="followUpSubmitSpinner" class="spinner-border spinner-border-sm me-1 d-none" role="status" aria-hidden="true"></span>
                            <i class="bi bi-calendar-check-fill me-1" id="followUpSubmitIcon"></i>
                            <span id="followUpSubmitText">Xác Nhận Đặt Lịch Tái Khám</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<!-- Modal Pick Chair (if needed from medical record screen) -->
<div class="modal fade" id="pickChairModal" tabindex="-1" aria-labelledby="pickChairModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold" id="pickChairModalLabel">
                    <i class="bi bi-pin-map me-2"></i>Chọn Ghế Nha Khoa Điều Trị
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="pickChairForm" method="post" action="">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                <div class="modal-body p-4">
                    <div class="alert alert-light border mb-3 small">
                        Bệnh nhân: <strong id="modalPatientName">--</strong> &bull; Phòng: <strong id="modalRoomName">--</strong>
                    </div>

                    <div id="chairsLoading" class="text-center py-3">
                        <div class="spinner-border text-primary spinner-border-sm me-2" role="status"></div>
                        <span class="text-muted small">Đang tải danh sách ghế...</span>
                    </div>

                    <div id="chairsContainer" class="d-flex flex-column gap-2" style="display: none;"></div>
                    <div id="chairsEmpty" class="text-center py-3 text-muted small" style="display: none;">
                        Không có ghế khả dụng trong phòng này.
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" id="btnSubmitPickChair" class="btn btn-primary fw-semibold" disabled>
