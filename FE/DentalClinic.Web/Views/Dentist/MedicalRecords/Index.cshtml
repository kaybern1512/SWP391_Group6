                    <h5 class="modal-title fw-bold" id="modalCreateClinicalEntryLabel">
                        <i class="bi bi-clipboard2-plus-fill me-2"></i>Ghi Nhận Chẩn Đoán Bệnh Án Cho @record.PatientName
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
