                                    </div>

                                    <div class="compare-stage">
                                        <img id="compareImageBefore" src="" class="compare-img d-none" alt="Phim X-quang Trước điều trị (Before)" draggable="false" />
                                    </div>
                                </div>

                                <!-- Metadata BEFORE -->
                                <div id="compareMetaBefore" class="compare-meta-card p-2 text-white-50 mt-2">
                                    <span class="text-white-50 small fst-italic">Chưa chọn ảnh</span>
                                </div>
                            </div>
                        </div>

                        <!-- AFTER PANEL (Right) -->
                        <div class="col-12 col-lg-6 d-flex flex-column">
                            <div class="card bg-black border border-secondary border-opacity-50 rounded-3 p-2 h-100 d-flex flex-column">
                                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2 pb-2 border-bottom border-secondary border-opacity-50">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge bg-success text-white px-2 py-1 fw-bold">
                                            <i class="bi bi-check-circle me-1"></i>AFTER — Sau điều trị
                                        </span>
                                    </div>
                                    <div class="d-flex align-items-center gap-2 flex-grow-1 justify-content-end">
                                        <label for="selectCompareAfter" class="visually-hidden">Chọn ảnh Sau</label>
                                        <select id="selectCompareAfter" class="form-select form-select-sm bg-dark text-white border-secondary small text-truncate" style="max-width: 240px;" title="Chọn phim X-quang Sau điều trị">
                                        </select>
                                    </div>
                                </div>

                                <!-- Toolbar AFTER -->
                                <div class="d-flex align-items-center justify-content-between gap-1 mb-2 px-2 py-1 compare-toolbar">
                                    <div class="d-flex align-items-center gap-1">
                                        <button type="button" id="btnZoomInAfter" class="btn btn-sm btn-outline-light border-0 px-2 py-1" title="Phóng to ảnh After (+)" aria-label="Phóng to After">
                                            <i class="bi bi-zoom-in"></i>
                                        </button>
                                        <button type="button" id="btnZoomOutAfter" class="btn btn-sm btn-outline-light border-0 px-2 py-1" title="Thu nhỏ ảnh After (-)" aria-label="Thu nhỏ After">
                                            <i class="bi bi-zoom-out"></i>
                                        </button>
                                        <span id="zoomBadgeAfter" class="badge bg-dark text-info border border-info border-opacity-50 px-2 py-1 compare-zoom-badge" title="Tỷ lệ thu phóng After">100%</span>
                                        <button type="button" id="btnFitAfter" class="btn btn-sm btn-outline-light border-0 px-2 py-1" title="Khớp khung nhìn After" aria-label="Khớp khung nhìn After">
                                            <i class="bi bi-arrows-angle-contract"></i>
                                        </button>
                                    </div>
                                    <div>
                                        <button type="button" id="btnResetAfter" class="btn btn-sm btn-outline-light border-0 px-2 py-1 text-warning" title="Reset ảnh After về ban đầu" aria-label="Reset After">
                                            <i class="bi bi-arrow-counterclockwise me-1"></i>Reset
                                        </button>
                                    </div>
                                </div>

                                <!-- Viewport AFTER -->
                                <div id="compareViewportAfter" class="compare-viewport flex-grow-1 d-flex justify-content-center align-items-center position-relative">
                                    <div id="spinnerAfter" class="position-absolute d-flex flex-column align-items-center justify-content-center text-white d-none" style="z-index: 10;">
                                        <div class="spinner-border text-primary spinner-border-sm" role="status">
                                            <span class="visually-hidden">Đang tải ảnh After...</span>
                                        </div>
                                        <span class="small text-white-50 mt-1" style="font-size: 0.75rem;">Đang tải...</span>
                                    </div>

                                    <div id="errorAfter" class="p-3 text-center text-warning position-absolute d-none" style="z-index: 10;">
                                        <i class="bi bi-exclamation-triangle-fill text-warning fs-3 mb-1 d-block"></i>
                                        <div class="small text-white fw-semibold">Không thể tải ảnh Sau điều trị</div>
                                        <div class="text-white-50" style="font-size: 0.7rem;">Ảnh có thể đã bị xóa hoặc phiên hết hạn.</div>
                                    </div>

                                    <div class="compare-stage">
                                        <img id="compareImageAfter" src="" class="compare-img d-none" alt="Phim X-quang Sau điều trị (After)" draggable="false" />
                                    </div>
                                </div>

                                <!-- Metadata AFTER -->
                                <div id="compareMetaAfter" class="compare-meta-card p-2 text-white-50 mt-2">
                                    <span class="text-white-50 small fst-italic">Chưa chọn ảnh</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer border-secondary border-opacity-50 py-2 px-3 justify-content-between bg-dark">
                    <div class="text-white-50 small d-none d-md-block">
                        <i class="bi bi-info-circle me-1 text-info"></i>Cuộn chuột để thu phóng, kéo chuột để di chuyển từng khung ảnh độc lập. Nhấn "Đảo vị trí" để đổi hai ảnh Trước/Sau.
                    </div>
                    <div class="d-flex gap-2 align-items-center ms-auto">
                        <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">
                            <i class="bi bi-x-lg me-1"></i> Đóng (Esc)
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Xác Nhận Xóa Phim X-Quang (Commit 22) -->
    <div class="modal fade" id="modalDeleteImagingConfirm" tabindex="-1" aria-labelledby="modalDeleteImagingConfirmLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title fw-bold" id="modalDeleteImagingConfirmLabel">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>Xác Nhận Xóa Phim X-Quang
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="formDeleteImaging" asp-action="DeleteImaging" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="deleteImagingRecordId" name="imagingRecordId" value="0" />
                    <input type="hidden" id="deleteImagingPatientUserId" name="patientUserId" value="@(record.PatientUserId)" />
                    <div class="modal-body p-4">
                        <p class="text-slate-800 mb-3">
                            Bạn có chắc chắn muốn xóa phim X-quang này khỏi hồ sơ bệnh án không? Thao tác này sẽ gỡ bỏ bản ghi chẩn đoán hình ảnh và tệp liên quan.
                        </p>
                        <div class="alert alert-warning py-2 px-3 small border-0 bg-warning-subtle text-dark">
                            <div><i class="bi bi-info-circle-fill text-warning me-1"></i><strong>Loại phim:</strong> <span id="deleteImagingTypeLabel" class="fw-bold"></span></div>
                            <div><i class="bi bi-calendar-event me-1"></i><strong>Ngày tạo:</strong> <span id="deleteImagingDateLabel"></span></div>
                            <div><i class="bi bi-hash me-1"></i><strong>Mã bản ghi:</strong> #<span id="deleteImagingIdLabel"></span></div>
                        </div>
                        <div class="text-muted small fst-italic">
                            Lưu ý: Chỉ bác sĩ được phân công phụ trách ca khám mới có quyền xóa phim X-quang này.
                        </div>
                    </div>
                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" id="btnConfirmDeleteImaging" class="btn btn-danger px-4 fw-medium">
                            <span id="deleteSpinner" class="spinner-border spinner-border-sm me-1 d-none" role="status" aria-hidden="true"></span>
                            <i class="bi bi-trash3-fill me-1" id="deleteIcon"></i>
                            <span id="deleteBtnText">Xác nhận xóa</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/medical-imaging-viewer.js" asp-append-version="true"></script>
    <script>
        let lightboxModalInstance = null;
        let comparisonModalInstance = null;

        @if (record != null)
        {
            var comparisonImagesList = record.ClinicalEntries
                .SelectMany(e => e.ImagingRecords.Where(img => {
                    var isDcm = (!string.IsNullOrEmpty(img.FileUrl) && (img.FileUrl.EndsWith(".dcm", StringComparison.OrdinalIgnoreCase) || img.FileUrl.EndsWith(".dicom", StringComparison.OrdinalIgnoreCase))) ||
                                img.ImagingType.Equals("DICOM", StringComparison.OrdinalIgnoreCase);
                    return !isDcm;
                }).Select(img => new {
                    id = img.ImagingRecordId,
                    patientUserId = record.PatientUserId,
                    clinicalEntryId = e.ClinicalEntryId,
                    type = img.ImagingType ?? "X-Quang",
                    summary = img.ResultSummary ?? "",
                    savedAt = img.CreatedAt.ToString("dd/MM/yyyy HH:mm"),
                    entryDate = e.CreatedAt.ToString("dd/MM/yyyy"),
                    diagnosis = e.Diagnosis ?? "",
                    dentistName = e.DentistName ?? "",
                    url = Url.Action("ImagingContent", "DentistMedicalRecord", new { imagingRecordId = img.ImagingRecordId })
                }))
                .ToList();
            <text>
            const patientAvailableImages = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(comparisonImagesList));
            </text>
        }
        else
        {
            <text>
            const patientAvailableImages = [];
            </text>
        }

        function openComparisonModal() {
            if (window.MedicalImagingComparisonViewer) {
                window.MedicalImagingComparisonViewer.openComparison(patientAvailableImages);
            }
        }

        function openComparisonWithImage(selectedImageId) {
            if (window.MedicalImagingComparisonViewer) {
                window.MedicalImagingComparisonViewer.openComparison(patientAvailableImages, selectedImageId);
            }
        }

        function openImagingLightbox(imageUrl, imagingType, resultSummary, createdAt, isDicom) {
            if (isDicom) {
                return;
            }

            const modalEl = document.getElementById('imagingLightboxModal');
            if (!modalEl) return;

            const imgEl = document.getElementById('lightboxImage');
            const spinner = document.getElementById('lightboxLoadingSpinner');
            const errorAlert = document.getElementById('lightboxErrorAlert');
            const typeBadge = document.getElementById('lightboxTypeBadge');
            const dateEl = document.getElementById('lightboxDate');
            const summaryEl = document.getElementById('lightboxResultSummary');
            const downloadBtn = document.getElementById('lightboxDownloadBtn');

            // Reset UI states
            if (imgEl) {
                imgEl.classList.add('d-none');
                imgEl.src = '';
            }
            if (spinner) spinner.classList.remove('d-none');
            if (errorAlert) errorAlert.classList.add('d-none');

            if (typeBadge) typeBadge.textContent = imagingType || 'X-Quang';
            if (dateEl) dateEl.textContent = createdAt ? ('Ngày chụp: ' + createdAt) : '';
            if (summaryEl) summaryEl.textContent = resultSummary && resultSummary.trim().length > 0 ? resultSummary : 'Chưa có ghi nhận kết luận đọc phim.';
            if (downloadBtn) {
                downloadBtn.href = imageUrl;
            }

            // Bind image load events
            if (imgEl) {
                imgEl.onload = function () {
                    if (spinner) spinner.classList.add('d-none');
                    imgEl.classList.remove('d-none');
                    if (window.MedicalImagingViewer) {
                        window.MedicalImagingViewer.fitToScreen();
                    }
                };
                imgEl.onerror = function () {
                    if (spinner) spinner.classList.add('d-none');
                    if (errorAlert) errorAlert.classList.remove('d-none');
                };
                imgEl.src = imageUrl;
            }

            if (!lightboxModalInstance) {
                lightboxModalInstance = new bootstrap.Modal(modalEl, {
                    keyboard: true,
                    backdrop: true
                });
            }
            if (window.MedicalImagingViewer) {
                if (window.MedicalImagingViewer.clearTemporaryAnnotations) {
                    window.MedicalImagingViewer.clearTemporaryAnnotations();
                }
                window.MedicalImagingViewer.init();
            }
            lightboxModalInstance.show();
        }

        function openUploadImagingModal(entryId, diagnosis) {
            document.getElementById('uploadImagingClinicalEntryId').value = entryId;
            document.getElementById('uploadImagingDiagnosisPreview').textContent = diagnosis || ('Đợt khám #' + entryId);
            const fileInput = document.getElementById('uploadImagingFileInput');
            if (fileInput) fileInput.value = '';
            const typeSelect = document.getElementById('uploadImagingTypeSelect');
            if (typeSelect) typeSelect.selectedIndex = 0;
            const summaryInput = document.getElementById('uploadImagingResultSummary');
            if (summaryInput) summaryInput.value = '';
            const feedback = document.getElementById('fileValidationFeedback');
            if (feedback) { feedback.textContent = ''; feedback.classList.add('d-none'); }
            const submitBtn = document.getElementById('btnSubmitUploadImaging');
            if (submitBtn) { submitBtn.disabled = false; }
            const spinner = document.getElementById('uploadSpinner');
            if (spinner) spinner.classList.add('d-none');
            const icon = document.getElementById('uploadIcon');
            if (icon) icon.classList.remove('d-none');
            const btnText = document.getElementById('uploadBtnText');
            if (btnText) btnText.textContent = 'Upload Phim';

            new bootstrap.Modal(document.getElementById('modalUploadImaging')).show();
        }

        function openDeleteImagingModal(imagingRecordId, imagingType, createdAt, patientUserId) {
            document.getElementById('deleteImagingRecordId').value = imagingRecordId;
            document.getElementById('deleteImagingPatientUserId').value = patientUserId;
            document.getElementById('deleteImagingTypeLabel').textContent = imagingType || 'X-Quang';
            document.getElementById('deleteImagingDateLabel').textContent = createdAt || '—';
            document.getElementById('deleteImagingIdLabel').textContent = imagingRecordId;

            const submitBtn = document.getElementById('btnConfirmDeleteImaging');
            if (submitBtn) submitBtn.disabled = false;
            const spinner = document.getElementById('deleteSpinner');
            if (spinner) spinner.classList.add('d-none');
            const icon = document.getElementById('deleteIcon');
            if (icon) icon.classList.remove('d-none');
            const btnText = document.getElementById('deleteBtnText');
            if (btnText) btnText.textContent = 'Xác nhận xóa';

            new bootstrap.Modal(document.getElementById('modalDeleteImagingConfirm')).show();
        }

        // Backward compatibility
        function openAddImagingModal(entryId, diagnosis) {
            openUploadImagingModal(entryId, diagnosis);
        }

        function addToothRow() {
            const container = document.getElementById("toothRowsContainer");
            const rowId = "tooth-row-" + Date.now();
            const rowHtml = `
                <div class="row g-2 align-items-center tooth-input-row" id="${rowId}">
                    <div class="col-md-3">
                        <select class="form-select form-select-sm tooth-number-select">
                            <option value="">-- Chọn Răng --</option>
                            @for (int i = 18; i >= 11; i--) { <option value="@i">Răng @i</option> }
                            @for (int i = 21; i <= 28; i++) { <option value="@i">Răng @i</option> }
                            @for (int i = 48; i >= 41; i--) { <option value="@i">Răng @i</option> }
                            @for (int i = 31; i <= 38; i++) { <option value="@i">Răng @i</option> }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <select class="form-select form-select-sm tooth-condition-select">
                            <option value="Caries">Sâu răng (Caries)</option>
                            <option value="Filled">Đã trám (Filled)</option>
                            <option value="Pulpitis">Viêm tủy (Pulpitis)</option>
                            <option value="Crown">Bọc sứ (Crown)</option>
                            <option value="Missing">Mất răng (Missing)</option>
                            <option value="ExtractionNeeded">Cần nhổ (Extraction)</option>
                            <option value="Healthy">Khỏe mạnh (Healthy)</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <input type="text" class="form-control form-control-sm tooth-note-input" placeholder="Ghi chú (mặt răng O, M, D...)" />
                    </div>
                    <div class="col-md-1 text-end">
                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="document.getElementById('${rowId}').remove()"><i class="bi bi-trash"></i></button>
                    </div>
                </div>`;
            container.insertAdjacentHTML('beforeend', rowHtml);
        }

        function prepareToothConditionsJson() {
            const rows = document.querySelectorAll(".tooth-input-row");
            const list = [];
            rows.forEach(r => {
                const toothNum = r.querySelector(".tooth-number-select").value;
                const cond = r.querySelector(".tooth-condition-select").value;
                const note = r.querySelector(".tooth-note-input").value;
                if (toothNum) {
                    list.push({
                        toothNumber: toothNum,
                        condition: cond,
                        surface: "All",
                        note: note
                    });
                }
            });
            document.getElementById("toothConditionsJsonInput").value = JSON.stringify(list);
        }

        function clearCreateEntryImagingFile() {
            const fileInput = document.getElementById('createEntryImagingFileInput');
            if (fileInput) fileInput.value = '';

            const previewContainer = document.getElementById('createEntryFilePreviewContainer');
            if (previewContainer) previewContainer.classList.add('d-none');

            const imgCard = document.getElementById('createEntryImagePreviewCard');
            if (imgCard) imgCard.classList.add('d-none');

            const dicomCard = document.getElementById('createEntryDicomPreviewCard');
            if (dicomCard) dicomCard.classList.add('d-none');

            const thumb = document.getElementById('createEntryImagePreviewThumb');
            if (thumb) {
                if (thumb.src && thumb.src.startsWith('blob:')) {
                    URL.revokeObjectURL(thumb.src);
                }
                thumb.src = '';
            }

            const removeBtn = document.getElementById('btnRemoveImagingFile');
            if (removeBtn) removeBtn.classList.add('d-none');

            const errorAlert = document.getElementById('createEntryFileError');
            if (errorAlert) errorAlert.classList.add('d-none');

            const hint = document.getElementById('createEntryFileHint');
            if (hint) hint.classList.remove('d-none');
        }

        // Client-side file validation & double submit prevention
        document.addEventListener("DOMContentLoaded", function() {
            if (document.getElementById("toothRowsContainer")) {
                addToothRow();
            }

            // --- Interactive X-Ray File Selection & Preview in New Clinical Entry Modal ---
            const createEntryFileInput = document.getElementById('createEntryImagingFileInput');
            const maxImageSizeBytes = 15 * 1024 * 1024;
            const allowedImageExts = ['.jpg', '.jpeg', '.png', '.dcm', '.dicom'];

            if (createEntryFileInput) {
                createEntryFileInput.addEventListener('change', function () {
                    const errorAlert = document.getElementById('createEntryFileError');
                    const errorText = document.getElementById('createEntryFileErrorText');
                    const previewContainer = document.getElementById('createEntryFilePreviewContainer');
                    const imgCard = document.getElementById('createEntryImagePreviewCard');
                    const dicomCard = document.getElementById('createEntryDicomPreviewCard');
                    const removeBtn = document.getElementById('btnRemoveImagingFile');

                    if (!this.files || this.files.length === 0) {
                        clearCreateEntryImagingFile();
                        return;
                    }

                    const file = this.files[0];
                    const fileName = file.name;
                    const ext = '.' + fileName.split('.').pop().toLowerCase();

                    if (!allowedImageExts.includes(ext)) {
                        if (errorText) errorText.textContent = `Định dạng tệp "${ext}" không được hỗ trợ. Chỉ chấp nhận JPG, JPEG, PNG hoặc DICOM (.dcm, .dicom).`;
                        if (errorAlert) errorAlert.classList.remove('d-none');
                        clearCreateEntryImagingFile();
                        return;
                    }

                    if (file.size > maxImageSizeBytes) {
                        const sizeMb = (file.size / (1024 * 1024)).toFixed(2);
                        if (errorText) errorText.textContent = `Dung lượng tệp (${sizeMb} MB) vượt quá giới hạn tối đa 15 MB.`;
                        if (errorAlert) errorAlert.classList.remove('d-none');
                        clearCreateEntryImagingFile();
                        return;
                    }

                    if (errorAlert) errorAlert.classList.add('d-none');
                    if (removeBtn) removeBtn.classList.remove('d-none');
                    if (previewContainer) previewContainer.classList.remove('d-none');

                    const formattedSize = file.size < 1024 * 1024
                        ? `${(file.size / 1024).toFixed(1)} KB`
                        : `${(file.size / (1024 * 1024)).toFixed(2)} MB`;

                    // DICOM: only display file name and metadata, no fake image preview
                    if (ext === '.dcm' || ext === '.dicom') {
                        if (imgCard) imgCard.classList.add('d-none');
                        if (dicomCard) dicomCard.classList.remove('d-none');
                        const nameEl = document.getElementById('createEntryDicomFileName');
                        if (nameEl) nameEl.textContent = fileName;
                        const sizeEl = document.getElementById('createEntryDicomFileSize');
                        if (sizeEl) sizeEl.textContent = formattedSize;
                    } else {
                        // JPEG / PNG: display image preview thumbnail
                        if (dicomCard) dicomCard.classList.add('d-none');
                        if (imgCard) imgCard.classList.remove('d-none');
                        const nameEl = document.getElementById('createEntryImageFileName');
                        if (nameEl) nameEl.textContent = fileName;
                        const sizeEl = document.getElementById('createEntryImageFileSize');
                        if (sizeEl) sizeEl.textContent = formattedSize;
                        const thumb = document.getElementById('createEntryImagePreviewThumb');
                        if (thumb) {
                            if (thumb.src && thumb.src.startsWith('blob:')) {
                                URL.revokeObjectURL(thumb.src);
                            }
                            thumb.src = URL.createObjectURL(file);
                        }
                    }

                    // Auto-focus selecting ImagingType if not chosen yet
                    const typeSelect = document.getElementById('createEntryImagingType');
                    if (typeSelect && !typeSelect.value) {
                        typeSelect.focus();
                    }
                });
            }

            const createEntryForm = document.getElementById('formCreateClinicalEntry');
            if (createEntryForm) {
                createEntryForm.addEventListener('submit', function (e) {
                    const fileInput = document.getElementById('createEntryImagingFileInput');
                    const typeSelect = document.getElementById('createEntryImagingType');
                    const errorAlert = document.getElementById('createEntryFileError');
                    const errorText = document.getElementById('createEntryFileErrorText');

                    if (fileInput && fileInput.files && fileInput.files.length > 0) {
                        if (typeSelect && !typeSelect.value) {
                            e.preventDefault();
                            if (errorText) errorText.textContent = 'Bác sĩ vui lòng chọn phân loại phim X-quang tương ứng với tệp ảnh đính kèm.';
                            if (errorAlert) errorAlert.classList.remove('d-none');
                            typeSelect.focus();
                            return false;
                        }
                    }
                });
            }

            const createEntryModalEl = document.getElementById('modalCreateClinicalEntry');
            if (createEntryModalEl) {
                createEntryModalEl.addEventListener('hidden.bs.modal', function () {
                    clearCreateEntryImagingFile();
                });
            }

            const fileInput = document.getElementById('uploadImagingFileInput');
            const uploadForm = document.getElementById('formUploadImaging');
            const feedback = document.getElementById('fileValidationFeedback');
            const maxSizeBytes = 15 * 1024 * 1024;
            const allowedExts = ['.jpg', '.jpeg', '.png', '.dcm', '.dicom'];

            if (fileInput) {
                fileInput.addEventListener('change', function () {
                    if (!this.files || this.files.length === 0) return;
                    const file = this.files[0];
                    const name = file.name.toLowerCase();
                    const hasValidExt = allowedExts.some(ext => name.endsWith(ext));

                    if (!hasValidExt) {
                        feedback.textContent = 'Định dạng tệp không hợp lệ! Vui lòng chỉ chọn .jpg, .jpeg, .png hoặc .dcm/.dicom';
                        feedback.classList.remove('d-none');
                        this.value = '';
                        return;
                    }

                    if (file.size > maxSizeBytes) {
                        feedback.textContent = `Dung lượng tệp (${(file.size / (1024 * 1024)).toFixed(2)} MB) vượt quá giới hạn 15 MB!`;
                        feedback.classList.remove('d-none');
                        this.value = '';
                        return;
                    }

                    feedback.textContent = '';
                    feedback.classList.add('d-none');
                });
            }

            if (uploadForm) {
                uploadForm.addEventListener('submit', function (e) {
                    const submitBtn = document.getElementById('btnSubmitUploadImaging');
                    const spinner = document.getElementById('uploadSpinner');
                    const icon = document.getElementById('uploadIcon');
                    const btnText = document.getElementById('uploadBtnText');

                    if (submitBtn.disabled) {
                        e.preventDefault();
                        return;
                    }

                    submitBtn.disabled = true;
                    if (spinner) spinner.classList.remove('d-none');
                    if (icon) icon.classList.add('d-none');
                    if (btnText) btnText.textContent = 'Đang tải lên...';
                });
            }

            const deleteForm = document.getElementById('formDeleteImaging');
            if (deleteForm) {
                deleteForm.addEventListener('submit', function (e) {
                    const submitBtn = document.getElementById('btnConfirmDeleteImaging');
                    const spinner = document.getElementById('deleteSpinner');
                    const icon = document.getElementById('deleteIcon');
                    const btnText = document.getElementById('deleteBtnText');

                    if (submitBtn.disabled) {
                        e.preventDefault();
                        return;
                    }

                    submitBtn.disabled = true;
                    if (spinner) spinner.classList.remove('d-none');
                    if (icon) icon.classList.add('d-none');
                    if (btnText) btnText.textContent = 'Đang xóa...';
                });
            }

            const lightboxModalEl = document.getElementById('imagingLightboxModal');
            if (lightboxModalEl) {
                lightboxModalEl.addEventListener('hidden.bs.modal', function () {
                    const imgEl = document.getElementById('lightboxImage');
                    if (imgEl) {
                        imgEl.onload = null;
                        imgEl.onerror = null;
                        imgEl.src = '';
                        imgEl.classList.add('d-none');
                    }
                    if (window.MedicalImagingViewer && window.MedicalImagingViewer.clearTemporaryAnnotations) {
                        window.MedicalImagingViewer.clearTemporaryAnnotations();
                    }
                });
            }

            const comparisonModalEl = document.getElementById('imagingComparisonModal');
            if (comparisonModalEl) {
                comparisonModalEl.addEventListener('hidden.bs.modal', function () {
                    if (window.MedicalImagingComparisonViewer) {
                        window.MedicalImagingComparisonViewer.closeComparison();
                    }
                });
            }
        });
    </script>
}
