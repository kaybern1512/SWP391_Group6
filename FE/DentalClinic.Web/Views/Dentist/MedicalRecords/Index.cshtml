@section Scripts {
    <script>
        // Data model embedded for odontogram per visit
        const odontogramData = {
            all: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(record?.CurrentOdontogram ?? new())),
            visits: {
                @if (record != null)
                {
                    foreach (var entry in record.ClinicalEntries)
                    {
                        <text>
                        '@entry.ClinicalEntryId': {
                            date: '@entry.CreatedAt.ToString("dd/MM/yyyy HH:mm")',
                            code: '@(entry.AppointmentCode ?? $"#{entry.ClinicalEntryId}")',
                            dentist: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(entry.DentistName ?? "")),
                            diagnosis: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(entry.Diagnosis ?? "")),
                            teeth: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(entry.OdontogramEntries))
                        },
                        </text>
                    }
                }
            }
        };

        const conditionMap = {
            'healthy': { label: 'Khỏe', class: 'tooth-healthy', icon: 'bi-shield-check' },
            'caries': { label: 'Sâu răng', class: 'tooth-caries', icon: 'bi-exclamation-triangle-fill' },
            'filled': { label: 'Đã trám', class: 'tooth-filled', icon: 'bi-tools' },
            'missing': { label: 'Mất răng', class: 'tooth-missing', icon: 'bi-x-octagon-fill' },
            'crown': { label: 'Bọc sứ', class: 'tooth-crown', icon: 'bi-gem' },
            'pulpitis': { label: 'Viêm tủy', class: 'tooth-pulpitis', icon: 'bi-fire' },
            'extractionneeded': { label: 'Cần nhổ', class: 'tooth-extractionneeded', icon: 'bi-slash-circle-fill' }
        };

        // All 32 FDI teeth numbers
        const allTeethNumbers = [
            '18','17','16','15','14','13','12','11',
            '21','22','23','24','25','26','27','28',
            '48','47','46','45','44','43','42','41',
            '31','32','33','34','35','36','37','38'
        ];

        function switchOdontogramVisit(visitKey) {
            // Update buttons active states
            document.querySelectorAll('#visitButtonsGroup button').forEach(b => {
                b.classList.remove('btn-primary', 'active');
                b.classList.add('btn-outline-primary');
            });

            const topBtn = document.getElementById('btnTop_' + visitKey);
            if (topBtn) {
                topBtn.classList.remove('btn-outline-primary');
                topBtn.classList.add('btn-primary', 'active');
            }

            // Update sidebar buttons active states
            document.querySelectorAll('[id^="btnSide"]').forEach(b => b.classList.remove('visit-card-active'));
            const sideBtn = document.getElementById('btnSide_' + visitKey) || document.getElementById('btnSideAll');
            if (sideBtn && visitKey !== 'all') {
                sideBtn.classList.add('visit-card-active');
            } else if (visitKey === 'all' && document.getElementById('btnSideAll')) {
                document.getElementById('btnSideAll').classList.add('visit-card-active');
            }

            // Highlight corresponding clinical entry in history
            document.querySelectorAll('[id^="entryCard_"]').forEach(c => c.classList.remove('border-primary', 'bg-white'));
            const targetEntryCard = document.getElementById('entryCard_' + visitKey);
            if (targetEntryCard) {
                targetEntryCard.classList.add('border-primary', 'bg-white');
                targetEntryCard.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }

            const banner = document.getElementById('odontogramStatusBanner');
            const counts = {
                healthy: 0,
                caries: 0,
                filled: 0,
                missing: 0,
                crown: 0,
                pulpitis: 0,
                extractionneeded: 0
            };

            if (visitKey === 'all') {
                if (banner) banner.innerHTML = '<i class="bi bi-diagram-3-fill me-1"></i> Đang hiển thị: <strong>Hiện trạng răng tổng thể</strong> (Tất cả đợt khám)';

                // Render cumulative state
                const toothMap = {};
                if (odontogramData.all) {
                    odontogramData.all.forEach(t => {
                        toothMap[t.ToothNumber] = t;
                    });
                }

                allTeethNumbers.forEach(num => {
                    const t = toothMap[num];
                    const cond = (t && t.Condition ? t.Condition.toLowerCase() : 'healthy');
                    applyToothState(num, cond, t ? t.Note : null);
                    if (counts[cond] !== undefined) counts[cond]++;
                    else counts.healthy++;
                });
            } else {
                const visit = odontogramData.visits[visitKey];
                if (visit && banner) {
                    banner.innerHTML = `<i class="bi bi-calendar2-check-fill me-1"></i> Đang hiển thị: <strong>Sơ đồ đợt khám ngày ${visit.date}</strong> (Mã: <code>${visit.code}</code> - BS: <strong>${visit.dentist}</strong>)`;
                }

                const visitToothMap = {};
                if (visit && visit.teeth) {
                    visit.teeth.forEach(t => {
                        visitToothMap[t.ToothNumber] = t;
                    });
                }

                allTeethNumbers.forEach(num => {
                    if (visitToothMap[num]) {
                        const t = visitToothMap[num];
                        const cond = t.Condition ? t.Condition.toLowerCase() : 'healthy';
                        applyToothState(num, cond, t.Note);
                        if (counts[cond] !== undefined) counts[cond]++;
                    } else {
                        // In this visit, tooth was not modified / had no interventions
                        applyToothState(num, 'healthy', 'Không can thiệp trong đợt này');
                        counts.healthy++;
                    }
                });
            }

            // Update counter badges in legend
            Object.keys(counts).forEach(k => {
                const counterEl = document.getElementById('count-' + k);
                if (counterEl) counterEl.innerText = counts[k];
            });
        }

        function applyToothState(toothNum, conditionKey, note) {
            const card = document.getElementById('toothCard_' + toothNum);
            const icon = document.getElementById('toothIcon_' + toothNum);
            const tag = document.getElementById('toothTag_' + toothNum);

            if (!card || !icon || !tag) return;

            // Remove existing condition classes
            card.className = 'tooth-card';
            icon.className = 'tooth-icon bi';

            const meta = conditionMap[conditionKey] || conditionMap['healthy'];
            card.classList.add(meta.class);
            icon.classList.add(meta.icon);
            tag.innerText = meta.label;

            const noteText = note ? ` (${note})` : '';
            card.title = `Răng ${toothNum}: ${meta.label}${noteText}`;
        }

        function highlightTeethByCondition(cond) {
            allTeethNumbers.forEach(num => {
                const card = document.getElementById('toothCard_' + num);
                if (!card) return;
                const match = card.classList.contains('tooth-' + cond);
                if (match) {
                    card.classList.add('tooth-highlighted');
                    setTimeout(() => card.classList.remove('tooth-highlighted'), 2200);
                }
            });
        }

        function toggleExecMode() {
            const isDelegate = document.getElementById('execDelegate').checked;
            document.getElementById('panelChairSelection').style.display = isDelegate ? 'none' : 'block';
            document.getElementById('panelDentistSelection').style.display = isDelegate ? 'block' : 'none';
        }

        function openCompleteExamModal(apptId, patientName, apptCode) {
            document.getElementById('completeAppointmentId').value = apptId;
            document.getElementById('completeApptCode').innerText = apptCode;
            const modal = new bootstrap.Modal(document.getElementById('modalCompleteExam'));
            modal.show();
        }

        function openUploadImagingModal(entryId, diagnosis) {
            document.getElementById('uploadClinicalEntryId').value = entryId;
            const modal = new bootstrap.Modal(document.getElementById('modalUploadImaging'));
            modal.show();
        }

        function openLightbox(url, title, desc) {
            document.getElementById('lightboxImg').src = url;
            document.getElementById('lightboxTitle').innerText = title || 'Phim X-Quang';
            document.getElementById('lightboxDesc').innerText = desc || '';
            const modal = new bootstrap.Modal(document.getElementById('imageLightboxModal'));
            modal.show();
        }

        function openPickChairModal(apptId, patientName, roomName, currentChairId) {
            document.getElementById('modalPatientName').innerText = patientName;
            document.getElementById('modalRoomName').innerText = roomName || 'Phòng khám chuyên khoa';
            const form = document.getElementById('pickChairForm');
            form.action = `/Dentist/Appointments/${apptId}/AssignChair`;

            const loading = document.getElementById('chairsLoading');
            const container = document.getElementById('chairsContainer');
            const empty = document.getElementById('chairsEmpty');
            const submitBtn = document.getElementById('btnSubmitPickChair');

            loading.style.display = 'block';
            container.style.display = 'none';
            empty.style.display = 'none';
            submitBtn.disabled = true;
            container.innerHTML = '';

            fetch(`/Dentist/Appointments/${apptId}/RoomChairs`)
                .then(res => res.json())
                .then(result => {
                    loading.style.display = 'none';
                    if (result.success && result.data && result.data.length > 0) {
                        container.style.display = 'flex';
                        result.data.forEach(chair => {
                            const isSelected = currentChairId && currentChairId === chair.dentalChairId;
                            const isOccupied = chair.isOccupied;
                            const div = document.createElement('div');
                            div.className = `p-3 rounded border d-flex justify-content-between align-items-center ${isOccupied ? 'bg-light border-danger text-muted' : (isSelected ? 'bg-primary-subtle border-primary' : 'bg-white')}`;
                            div.style.cursor = isOccupied ? 'not-allowed' : 'pointer';

                            div.innerHTML = `
                                <div class="d-flex align-items-center gap-2">
                                    <input class="form-check-input mt-0" type="radio" name="dentalChairId" id="chairRadio_${chair.dentalChairId}" value="${chair.dentalChairId}" ${isSelected ? 'checked' : ''} ${isOccupied ? 'disabled' : ''}>
                                    <label class="form-check-label fw-semibold cursor-pointer mb-0" for="chairRadio_${chair.dentalChairId}">
                                        <i class="bi bi-badge-hd me-1"></i> Ghế ${chair.chairCode}
                                    </label>
                                </div>
                                <div>
                                    ${isOccupied 
                                        ? '<span class="badge bg-danger-subtle text-danger border border-danger small"><i class="bi bi-person-fill-exclamation me-1"></i>Đang bận</span>' 
                                        : '<span class="badge bg-success-subtle text-success border border-success small"><i class="bi bi-check-circle me-1"></i>Sẵn sàng</span>'}
                                </div>
                            `;

                            if (!isOccupied) {
                                div.addEventListener('click', () => {
                                    const radio = div.querySelector('input[type="radio"]');
                                    radio.checked = true;
                                    submitBtn.disabled = false;
                                    container.querySelectorAll('.p-3').forEach(el => el.classList.remove('bg-primary-subtle', 'border-primary'));
                                    div.classList.add('bg-primary-subtle', 'border-primary');
                                });
                            }

                            container.appendChild(div);
                        });

                        if (currentChairId) {
                            submitBtn.disabled = false;
                        }
                    } else {
                        empty.style.display = 'block';
                    }
                })
                .catch(err => {
                    loading.style.display = 'none';
                    empty.style.display = 'block';
                    empty.innerText = 'Không thể tải danh sách ghế từ máy chủ.';
                });

            const modal = new bootstrap.Modal(document.getElementById('pickChairModal'));
            modal.show();
        }

        // Dynamic rows for Tooth Condition in Create Entry Modal
        let toothRowCount = 0;
        function addToothRow() {
            toothRowCount++;
            const container = document.getElementById('toothRowsContainer');
            const row = document.createElement('div');
            row.className = 'row g-2 align-items-center bg-white p-2 rounded border';
            row.id = 'toothRow_' + toothRowCount;

            row.innerHTML = `
                <div class="col-md-3">
                    <select class="form-select form-select-sm tooth-number-select" required>
                        <option value="">-- Số Răng (FDI) --</option>
                        ${allTeethNumbers.map(n => `<option value="${n}">Răng ${n}</option>`).join('')}
                    </select>
                </div>
                <div class="col-md-4">
                    <select class="form-select form-select-sm tooth-condition-select">
                        <option value="Caries">Sâu răng (Caries)</option>
                        <option value="Pulpitis">Viêm tủy (Pulpitis)</option>
                        <option value="Filled">Đã trám (Filled)</option>
                        <option value="Crown">Bọc sứ (Crown)</option>
                        <option value="Missing">Mất răng (Missing)</option>
                        <option value="ExtractionNeeded">Cần nhổ răng</option>
                        <option value="Healthy">Khỏe mạnh</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <input type="text" class="form-control form-control-sm tooth-note-input" placeholder="Mặt răng / Ghi chú (VD: Mặt nhai, ê buốt...)" />
                </div>
                <div class="col-md-1 text-end">
                    <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2" onclick="removeToothRow(${toothRowCount})">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
            `;

            container.appendChild(row);
        }

        function removeToothRow(id) {
            const row = document.getElementById('toothRow_' + id);
            if (row) row.remove();
        }

        function prepareToothConditionsJson() {
            const rows = document.querySelectorAll('#toothRowsContainer .row');
            const items = [];
            rows.forEach(r => {
                const toothSelect = r.querySelector('.tooth-number-select');
                const condSelect = r.querySelector('.tooth-condition-select');
                const noteInput = r.querySelector('.tooth-note-input');

                if (toothSelect && toothSelect.value) {
                    items.push({
                        ToothNumber: toothSelect.value,
                        Condition: condSelect ? condSelect.value : 'Healthy',
                        Surface: 'All',
                        Note: noteInput ? noteInput.value : ''
                    });
                }
            });

            document.getElementById('toothConditionsJsonInput').value = JSON.stringify(items);
        }

        function clearCreateEntryImagingFile() {
            const fileInput = document.getElementById('createEntryImagingFileInput');
            if (fileInput) fileInput.value = '';

            const previewContainer = document.getElementById('createEntryFilePreviewContainer');
            if (previewContainer) previewContainer.classList.add('d-none');

            const imgCard = document.getElementById('createEntryImagePreviewCard');
            if (imgCard) imgCard.classList.add('d-none');

            const dicomCard = document.getElementById('createEntryDicomPreviewCard');
            if (dicomCard) dicomCard.classList.add('d-none');

            const thumb = document.getElementById('createEntryImagePreviewThumb');
            if (thumb) {
                if (thumb.src && thumb.src.startsWith('blob:')) {
                    URL.revokeObjectURL(thumb.src);
                }
                thumb.src = '';
            }

            const removeBtn = document.getElementById('btnRemoveImagingFile');
            if (removeBtn) removeBtn.classList.add('d-none');

            const errorAlert = document.getElementById('createEntryFileError');
            if (errorAlert) errorAlert.classList.add('d-none');

            const hint = document.getElementById('createEntryFileHint');
            if (hint) hint.classList.remove('d-none');
        }

        // Client-side file validation & double submit prevention
        document.addEventListener("DOMContentLoaded", function() {
            if (document.getElementById("toothRowsContainer")) {
                addToothRow();
            }

            // --- Interactive X-Ray File Selection & Preview in New Clinical Entry Modal ---
            const createEntryFileInput = document.getElementById('createEntryImagingFileInput');
            const maxImageSizeBytes = 15 * 1024 * 1024;
            const allowedImageExts = ['.jpg', '.jpeg', '.png', '.dcm', '.dicom'];

            if (createEntryFileInput) {
                createEntryFileInput.addEventListener('change', function () {
                    const errorAlert = document.getElementById('createEntryFileError');
                    const errorText = document.getElementById('createEntryFileErrorText');
                    const previewContainer = document.getElementById('createEntryFilePreviewContainer');
                    const imgCard = document.getElementById('createEntryImagePreviewCard');
                    const dicomCard = document.getElementById('createEntryDicomPreviewCard');
                    const removeBtn = document.getElementById('btnRemoveImagingFile');

                    if (!this.files || this.files.length === 0) {
                        clearCreateEntryImagingFile();
                        return;
                    }

                    const file = this.files[0];
                    const fileName = file.name;
                    const ext = '.' + fileName.split('.').pop().toLowerCase();

                    if (!allowedImageExts.includes(ext)) {
                        if (errorText) errorText.textContent = `Định dạng tệp "${ext}" không được hỗ trợ. Chỉ chấp nhận JPG, JPEG, PNG hoặc DICOM (.dcm, .dicom).`;
                        if (errorAlert) errorAlert.classList.remove('d-none');
                        clearCreateEntryImagingFile();
                        return;
                    }

                    if (file.size > maxImageSizeBytes) {
                        const sizeMb = (file.size / (1024 * 1024)).toFixed(2);
                        if (errorText) errorText.textContent = `Dung lượng tệp (${sizeMb} MB) vượt quá giới hạn tối đa 15 MB.`;
                        if (errorAlert) errorAlert.classList.remove('d-none');
                        clearCreateEntryImagingFile();
                        return;
                    }

                    if (errorAlert) errorAlert.classList.add('d-none');
                    if (removeBtn) removeBtn.classList.remove('d-none');
                    if (previewContainer) previewContainer.classList.remove('d-none');

                    const formattedSize = file.size < 1024 * 1024
                        ? `${(file.size / 1024).toFixed(1)} KB`
                        : `${(file.size / (1024 * 1024)).toFixed(2)} MB`;

                    // DICOM: only display file name and metadata, no fake image preview
                    if (ext === '.dcm' || ext === '.dicom') {
                        if (imgCard) imgCard.classList.add('d-none');
                        if (dicomCard) dicomCard.classList.remove('d-none');
                        const nameEl = document.getElementById('createEntryDicomFileName');
                        if (nameEl) nameEl.textContent = fileName;
                        const sizeEl = document.getElementById('createEntryDicomFileSize');
                        if (sizeEl) sizeEl.textContent = formattedSize;
                    } else {
                        // JPEG / PNG: display image preview thumbnail
                        if (dicomCard) dicomCard.classList.add('d-none');
                        if (imgCard) imgCard.classList.remove('d-none');
                        const nameEl = document.getElementById('createEntryImageFileName');
                        if (nameEl) nameEl.textContent = fileName;
                        const sizeEl = document.getElementById('createEntryImageFileSize');
                        if (sizeEl) sizeEl.textContent = formattedSize;
                        const thumb = document.getElementById('createEntryImagePreviewThumb');
                        if (thumb) {
                            if (thumb.src && thumb.src.startsWith('blob:')) {
                                URL.revokeObjectURL(thumb.src);
                            }
                            thumb.src = URL.createObjectURL(file);
                        }
                    }

                    // Auto-focus selecting ImagingType if not chosen yet
                    const typeSelect = document.getElementById('createEntryImagingType');
                    if (typeSelect && !typeSelect.value) {
                        typeSelect.focus();
                    }
                });
            }

            const createEntryForm = document.getElementById('formCreateClinicalEntry');
            if (createEntryForm) {
                createEntryForm.addEventListener('submit', function (e) {
                    const fileInput = document.getElementById('createEntryImagingFileInput');
                    const typeSelect = document.getElementById('createEntryImagingType');
                    const errorAlert = document.getElementById('createEntryFileError');
                    const errorText = document.getElementById('createEntryFileErrorText');

                    if (fileInput && fileInput.files && fileInput.files.length > 0) {
                        if (typeSelect && !typeSelect.value) {
                            e.preventDefault();
                            if (errorText) errorText.textContent = 'Bác sĩ vui lòng chọn phân loại phim X-quang tương ứng với tệp ảnh đính kèm.';
                            if (errorAlert) errorAlert.classList.remove('d-none');
                            typeSelect.focus();
                            return false;
                        }
                    }
                });
            }

            const createEntryModalEl = document.getElementById('modalCreateClinicalEntry');
            if (createEntryModalEl) {
                createEntryModalEl.addEventListener('hidden.bs.modal', function () {
                    clearCreateEntryImagingFile();
                });
            }

            const fileInput = document.getElementById('uploadImagingFileInput');
            const uploadForm = document.getElementById('formUploadImaging');
            const feedback = document.getElementById('fileValidationFeedback');
            const maxSizeBytes = 15 * 1024 * 1024;
            const allowedExts = ['.jpg', '.jpeg', '.png', '.dcm', '.dicom'];

            if (fileInput) {
                fileInput.addEventListener('change', function () {
                    if (!this.files || this.files.length === 0) return;
                    const file = this.files[0];
                    const name = file.name.toLowerCase();
                    const hasValidExt = allowedExts.some(ext => name.endsWith(ext));

                    if (!hasValidExt) {
                        feedback.textContent = 'Định dạng tệp không hợp lệ! Vui lòng chỉ chọn .jpg, .jpeg, .png hoặc .dcm/.dicom';
                        feedback.classList.remove('d-none');
                        this.value = '';
                        return;
                    }

                    if (file.size > maxSizeBytes) {
                        feedback.textContent = `Dung lượng tệp (${(file.size / (1024 * 1024)).toFixed(2)} MB) vượt quá giới hạn 15 MB!`;
                        feedback.classList.remove('d-none');
                        this.value = '';
                        return;
                    }

                    feedback.textContent = '';
                    feedback.classList.add('d-none');
                });
            }

            if (uploadForm) {
                uploadForm.addEventListener('submit', function (e) {
                    const submitBtn = document.getElementById('btnSubmitUploadImaging');
                    const spinner = document.getElementById('uploadSpinner');
                    const icon = document.getElementById('uploadIcon');
                    const btnText = document.getElementById('uploadBtnText');

                    if (submitBtn.disabled) {
                        e.preventDefault();
                        return;
                    }

                    submitBtn.disabled = true;
                    if (spinner) spinner.classList.remove('d-none');
                    if (icon) icon.classList.add('d-none');
                    if (btnText) btnText.textContent = 'Đang tải lên...';
                });
            }

            const deleteForm = document.getElementById('formDeleteImaging');
            if (deleteForm) {
                deleteForm.addEventListener('submit', function (e) {
                    const submitBtn = document.getElementById('btnConfirmDeleteImaging');
                    const spinner = document.getElementById('deleteSpinner');
                    const icon = document.getElementById('deleteIcon');
                    const btnText = document.getElementById('deleteBtnText');

                    if (submitBtn.disabled) {
                        e.preventDefault();
                        return;
                    }

                    submitBtn.disabled = true;
                    if (spinner) spinner.classList.remove('d-none');
                    if (icon) icon.classList.add('d-none');
                    if (btnText) btnText.textContent = 'Đang xóa...';
                });
            }

            const followUpModalEl = document.getElementById('modalCreateFollowUpAppointment');
            if (followUpModalEl) {
                followUpModalEl.addEventListener('shown.bs.modal', function () {
                    loadDoctorFollowUpSlots();
                });
            }

            const lightboxModalEl = document.getElementById('imagingLightboxModal');
            if (lightboxModalEl) {
                lightboxModalEl.addEventListener('hidden.bs.modal', function () {
                    const imgEl = document.getElementById('lightboxImage');
                    if (imgEl) {
                        imgEl.onload = null;
                        imgEl.onerror = null;
                        imgEl.src = '';
                        imgEl.classList.add('d-none');
                    }
                });
            }

            // Initialize Odontogram view on page load
            switchOdontogramVisit('all');
        });

        function applyPresetReason() {
            const select = document.getElementById('followUpPresetReason');
            const input = document.getElementById('followUpReasonInput');
            if (!select || !input) return;
            if (select.value === 'other') {
                input.value = '';
                input.focus();
            } else if (select.value) {
                input.value = select.value;
            }
        }

        async function loadDoctorFollowUpSlots() {
            const dateInput = document.getElementById('followUpDateInput');
            const durationSelect = document.getElementById('followUpDurationSelect');
            const grid = document.getElementById('followUpSlotsGrid');
            const spinner = document.getElementById('followUpSlotsSpinner');
            const emptyAlert = document.getElementById('followUpSlotsEmptyAlert');
            const badge = document.getElementById('slotStatusBadge');
            const submitBtn = document.getElementById('btnSubmitFollowUp');
            const startInput = document.getElementById('selectedFollowUpStart');
            const endInput = document.getElementById('selectedFollowUpEnd');

            if (!dateInput || !grid) return;

            const dateVal = dateInput.value;
            const durationVal = durationSelect ? durationSelect.value : 30;

            if (!dateVal) return;

            // Reset selection
            if (startInput) startInput.value = '';
            if (endInput) endInput.value = '';
            if (submitBtn) submitBtn.disabled = true;
            grid.innerHTML = '';
            if (emptyAlert) emptyAlert.classList.add('d-none');
            if (spinner) spinner.classList.remove('d-none');
            if (badge) {
                badge.className = 'badge bg-warning-subtle text-warning';
                badge.textContent = 'Đang tải...';
            }

            try {
                const res = await fetch(`/Dentist/MedicalRecords/AvailableSlots?date=${encodeURIComponent(dateVal)}&durationMinutes=${encodeURIComponent(durationVal)}`);
                const json = await res.json();
                if (spinner) spinner.classList.add('d-none');

                if (json.success && Array.isArray(json.data) && json.data.length > 0) {
                    if (badge) {
                        badge.className = 'badge bg-success-subtle text-success';
                        badge.textContent = `${json.data.length} khung giờ trống`;
                    }
                    json.data.forEach(slot => {
                        const start = new Date(slot.startTime);
                        const end = new Date(slot.endTime);
                        const formatTime = (d) => ('0' + d.getHours()).slice(-2) + ':' + ('0' + d.getMinutes()).slice(-2);
                        const label = `${formatTime(start)} - ${formatTime(end)}`;

                        const btn = document.createElement('button');
                        btn.type = 'button';
                        btn.className = 'btn btn-outline-success btn-sm px-3 py-2 fw-semibold slot-pill-btn';
                        btn.innerHTML = `<i class="bi bi-clock me-1"></i>${label}`;
                        btn.onclick = () => selectFollowUpSlot(slot.startTime, slot.endTime, btn);
                        grid.appendChild(btn);
                    });
                } else {
                    if (emptyAlert) emptyAlert.classList.remove('d-none');
                    if (badge) {
                        badge.className = 'badge bg-secondary-subtle text-secondary';
                        badge.textContent = 'Không có giờ trống';
                    }
                }
            } catch (err) {
                if (spinner) spinner.classList.add('d-none');
                if (emptyAlert) {
                    emptyAlert.classList.remove('d-none');
                    emptyAlert.querySelector('span').textContent = 'Không thể kết nối đến máy chủ lấy khung giờ trống. Vui lòng thử lại.';
                }
            }
        }

        function selectFollowUpSlot(startIso, endIso, btnElement) {
            document.querySelectorAll('.slot-pill-btn').forEach(b => {
                b.classList.remove('btn-success', 'text-white');
                b.classList.add('btn-outline-success');
            });

            btnElement.classList.remove('btn-outline-success');
            btnElement.classList.add('btn-success', 'text-white');

            const startInput = document.getElementById('selectedFollowUpStart');
            const endInput = document.getElementById('selectedFollowUpEnd');
            const submitBtn = document.getElementById('btnSubmitFollowUp');

            if (startInput) startInput.value = startIso;
            if (endInput) endInput.value = endIso;
            if (submitBtn) submitBtn.disabled = false;
        }

        function handleFollowUpSubmit(e) {
            const startInput = document.getElementById('selectedFollowUpStart');
            const reasonInput = document.getElementById('followUpReasonInput');
            const submitBtn = document.getElementById('btnSubmitFollowUp');
            const spinner = document.getElementById('followUpSubmitSpinner');
            const icon = document.getElementById('followUpSubmitIcon');
            const btnText = document.getElementById('followUpSubmitText');

            if (!startInput || !startInput.value) {
                alert('Vui lòng chọn một khung giờ tái khám trống.');
                return false;
            }

            if (!reasonInput || !reasonInput.value.trim()) {
                alert('Vui lòng nhập lý do hoặc nội dung chỉ định tái khám.');
                if (reasonInput) reasonInput.focus();
                return false;
            }

            if (submitBtn) {
                submitBtn.disabled = true;
                if (spinner) spinner.classList.remove('d-none');
                if (icon) icon.classList.add('d-none');
                if (btnText) btnText.textContent = 'Đang đặt lịch...';
            }

            return true;
        }
    </script>
}
