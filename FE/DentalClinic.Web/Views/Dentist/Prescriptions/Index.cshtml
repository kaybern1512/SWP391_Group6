@using DentalClinic.Web.Models.ApiDtos
@model DentalClinic.Web.ViewModels.Prescription.DentistPrescriptionIndexViewModel
@{
    ViewData["Title"] = "Kê Đơn Thuốc Điện Tử";
}

<div class="container-fluid px-4 py-4">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary-subtle text-primary fw-medium px-2 py-1 fs-12">
                    <i class="bi bi-capsule me-1"></i> Bác sĩ nha khoa
                </span>
                <span class="badge bg-light text-muted fw-normal px-2 py-1 fs-12">Clinical Prescriptions</span>
            </div>
            <h1 class="h3 fw-bold text-slate-800 mb-0">Quản Lý & Kê Đơn Thuốc Điện Tử</h1>
            <p class="text-muted small mb-0 mt-1">Lập đơn thuốc gắn liền với ca khám điều trị và in đơn thuốc chuẩn y tế cho bệnh nhân</p>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-primary d-flex align-items-center gap-2 shadow-sm" data-bs-toggle="modal" data-bs-target="#modalCreatePrescription">
                <i class="bi bi-plus-circle-fill"></i>
                <span>+ Kê Đơn Thuốc Mới</span>
            </button>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
            <i class="bi bi-check-circle-fill fs-5"></i>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
            <div>@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Search Toolbar -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-md-9 col-lg-10">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" name="search" value="@Model.Search" class="form-control bg-light border-start-0" 
                               placeholder="Tìm kiếm theo Tên bệnh nhân, Mã BN, Mã ca khám hoặc Tên thuốc...">
                    </div>
                </div>
                <div class="col-md-3 col-lg-2 d-flex gap-2">
                    <button type="submit" class="btn btn-dark w-100 d-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-funnel"></i>
                        <span>Tìm Kiếm</span>
                    </button>
                    @if (!string.IsNullOrEmpty(Model.Search))
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary" title="Xóa bộ lọc">
                            <i class="bi bi-x-lg"></i>
                        </a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Prescriptions Table -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
            <h5 class="card-title fw-bold text-slate-800 mb-0 d-flex align-items-center gap-2">
                <i class="bi bi-journal-medical text-primary"></i>
                <span>Danh Sách Đơn Thuốc Đã Kê</span>
                <span class="badge bg-secondary-subtle text-secondary rounded-pill fs-12 ms-1">@Model.Prescriptions.Count đơn</span>
            </h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-muted fs-13 text-uppercase">
                    <tr>
                        <th class="ps-4">Mã Đơn / Ca Khám</th>
                        <th>Bệnh Nhân</th>
                        <th>Ngày Kê Đơn</th>
                        <th>Các Thuốc Trong Đơn</th>
                        <th>Lời Dặn Của Bác Sĩ</th>
                        <th class="text-end pe-4">Thao Tác</th>
                    </tr>
                </thead>
                <tbody class="fs-14">
                    @if (Model.Prescriptions.Any())
                    {
                        foreach (var p in Model.Prescriptions)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold text-primary">#RX-@p.PrescriptionId</div>
                                    <div class="badge bg-light text-dark border small">Ca: @p.AppointmentCode</div>
                                </td>
                                <td>
                                    <div class="fw-bold text-slate-800">@p.PatientName</div>
                                    <div class="text-muted small">@p.PatientCode • @(p.PatientPhone ?? "—")</div>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@p.IssuedAt.ToString("dd/MM/yyyy")</div>
                                    <div class="text-muted small">@p.IssuedAt.ToString("HH:mm")</div>
                                </td>
                                <td>
                                    <div class="d-flex flex-column gap-1">
                                        @foreach (var item in p.Items)
                                        {
                                            <div class="small">
                                                <strong>• @item.MedicationName</strong>
                                                <span class="text-muted">(@(item.Dosage ?? "—") - @(item.Frequency ?? "Theo chỉ định"))</span>
                                            </div>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <span class="text-muted small fst-italic">@(string.IsNullOrEmpty(p.GeneralInstructions) ? "Không có" : p.GeneralInstructions)</span>
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="Print" asp-route-id="@p.PrescriptionId" class="btn btn-sm btn-outline-primary" target="_blank" title="In đơn thuốc chuẩn y tế">
                                        <i class="bi bi-printer me-1"></i> In Đơn
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-capsule fs-1 d-block mb-2 text-secondary"></i>
                                Bạn chưa kê đơn thuốc nào. Hãy bấm <strong>"+ Kê Đơn Thuốc Mới"</strong> để bắt đầu.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ============================================== -->
<!-- MODAL: KÊ ĐƠN THUỐC MỚI                       -->
<!-- ============================================== -->
<div class="modal fade" id="modalCreatePrescription" tabindex="-1" aria-labelledby="modalCreatePrescriptionLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold" id="modalCreatePrescriptionLabel">
                    <i class="bi bi-capsule me-2"></i>Kê Đơn Thuốc Cho Bệnh Nhân
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="prescriptionItemsJsonInput" name="ItemsJson" value="[]" />

                <div class="modal-body p-4">
                    <!-- Chọn ca khám -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-slate-700">Chọn ca khám của bệnh nhân <span class="text-danger">*</span></label>
                        @if (Model.EligibleAppointments.Any())
                        {
                            <select name="AppointmentId" class="form-select" required>
                                <option value="">-- Chọn ca khám điều trị --</option>
                                @foreach (var appt in Model.EligibleAppointments)
                                {
                                    <option value="@appt.AppointmentId">
                                        @appt.AppointmentCode - @appt.PatientName (@appt.PatientCode) - @appt.ServiceName (@(appt.ScheduledStart.HasValue ? appt.ScheduledStart.Value.ToString("dd/MM/yyyy HH:mm") : ""))
                                    </option>
                                }
                            </select>
                        }
                        else
                        {
                            <div class="alert alert-warning py-2 px-3 small">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i> Hiện tại bạn không có ca khám nào được phân bổ để kê đơn.
                            </div>
                        }
                    </div>

                    <!-- Danh sách thuốc -->
                    <div class="border rounded-3 p-3 bg-light mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label class="form-label fw-bold text-slate-800 mb-0">
                                <i class="bi bi-prescription2 me-1 text-primary"></i> Danh Mục Thuốc Trong Đơn:
                            </label>
                            <button type="button" class="btn btn-sm btn-primary" onclick="addMedicationRow()">
                                <i class="bi bi-plus-lg me-1"></i> Thêm Thuốc
                            </button>
                        </div>
                        <div id="medicationRowsContainer" class="d-flex flex-column gap-2">
                            <!-- Rows added dynamically via JS -->
                        </div>
                    </div>

                    <!-- Lời dặn chung -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-slate-700">Lời dặn chung của bác sĩ</label>
                        <textarea name="GeneralInstructions" class="form-control" rows="2" 
                                  placeholder="Ví dụ: Uống thuốc sau khi ăn no. Kiêng đồ ăn quá cay nóng, nước ngọt có ga. Tái khám sau 7 ngày hoặc khi có dấu hiệu bất thường."></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy Bỏ</button>
                    <button type="submit" class="btn btn-primary px-4 fw-medium" onclick="preparePrescriptionJson()">
                        <i class="bi bi-check-circle me-1"></i> Hoàn Tất & Lưu Đơn Thuốc
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    const sampleMedications = [
        { name: "Amoxicillin 500mg", dosage: "14 viên", freq: "Uống 2 lần/ngày, sáng 1v - tối 1v", dur: "7 ngày", inst: "Uống sau ăn no" },
        { name: "Paracetamol 500mg", dosage: "10 viên", freq: "Khi đau nhức, cách nhau 4-6 tiếng", dur: "3-5 ngày", inst: "Không uống quá 4 viên/ngày" },
        { name: "Alphachymotrypsin 4.2mg", dosage: "20 viên", freq: "Uống 2 lần/ngày, sáng 2v - tối 2v", dur: "5 ngày", inst: "Uống nhiều nước" },
        { name: "Ibuprofen 400mg", dosage: "10 viên", freq: "Uống 2 lần/ngày sau bữa ăn", dur: "5 ngày", inst: "Chống viêm giảm đau" },
        { name: "Nước súc miệng Chlorhexidine 0.12%", dosage: "1 chai 250ml", freq: "Súc miệng 2-3 lần/ngày", dur: "7 ngày", inst: "Ngậm và súc miệng trong 30 giây" }
    ];

    function addMedicationRow(defaultMed = null) {
        const container = document.getElementById("medicationRowsContainer");
        const rowId = "med-row-" + Date.now() + Math.floor(Math.random() * 100);

        const name = defaultMed ? defaultMed.name : "";
        const dosage = defaultMed ? defaultMed.dosage : "";
        const freq = defaultMed ? defaultMed.freq : "";
        const inst = defaultMed ? defaultMed.inst : "";

        const html = `
            <div class="card border p-2 bg-white med-input-row" id="${rowId}">
                <div class="row g-2 align-items-center">
                    <div class="col-md-5">
                        <label class="small text-muted mb-0">Tên thuốc & hàm lượng <span class="text-danger">*</span></label>
                        <input type="text" class="form-control form-control-sm med-name-input" list="medListOptions" placeholder="Ví dụ: Amoxicillin 500mg" value="${name}" required />
                    </div>
                    <div class="col-md-3">
                        <label class="small text-muted mb-0">Số lượng & Đơn vị</label>
                        <input type="text" class="form-control form-control-sm med-dosage-input" placeholder="Ví dụ: 14 viên / 1 chai" value="${dosage}" />
                    </div>
                    <div class="col-md-3">
                        <label class="small text-muted mb-0">Cách dùng / Tần suất</label>
                        <input type="text" class="form-control form-control-sm med-freq-input" placeholder="Ví dụ: Sáng 1v, tối 1v" value="${freq}" />
                    </div>
                    <div class="col-md-1 text-end pt-3">
                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="document.getElementById('${rowId}').remove()"><i class="bi bi-trash"></i></button>
                    </div>
                </div>
            </div>`;
        container.insertAdjacentHTML('beforeend', html);
    }

    function preparePrescriptionJson() {
        const rows = document.querySelectorAll(".med-input-row");
        const list = [];
        rows.forEach(r => {
            const name = r.querySelector(".med-name-input").value.trim();
            const dosage = r.querySelector(".med-dosage-input").value.trim();
            const freq = r.querySelector(".med-freq-input").value.trim();
            if (name) {
                list.push({
                    medicationName: name,
                    dosage: dosage,
                    frequency: freq,
                    duration: "Theo chỉ định",
                    instructions: freq
                });
            }
        });
        document.getElementById("prescriptionItemsJsonInput").value = JSON.stringify(list);
    }

    document.addEventListener("DOMContentLoaded", function () {
        if (document.getElementById("medicationRowsContainer")) {
            // Add default rows from sample medications
            addMedicationRow(sampleMedications[0]);
            addMedicationRow(sampleMedications[1]);
        }
    });
</script>

<datalist id="medListOptions">
    <option value="Amoxicillin 500mg"></option>
    <option value="Augmentin 625mg"></option>
    <option value="Paracetamol 500mg"></option>
    <option value="Ibuprofen 400mg"></option>
    <option value="Alphachymotrypsin 4.2mg"></option>
    <option value="Rodogyl (Spiramycin + Metronidazol)"></option>
    <option value="Nước súc miệng Chlorhexidine 0.12%"></option>
    <option value="Vitamin C 500mg"></option>
</datalist>
