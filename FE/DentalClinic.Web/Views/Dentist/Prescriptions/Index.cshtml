@using DentalClinic.Web.Models.ApiDtos
@model DentalClinic.Web.ViewModels.Prescription.DentistPrescriptionIndexViewModel
@{
    ViewData["Title"] = "Kê Đơn Thuốc Điện Tử";
}

<div class="container-fluid px-4 py-4">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary-subtle text-primary fw-medium px-2 py-1 fs-12">
                    <i class="bi bi-capsule me-1"></i> Bác sĩ nha khoa
                </span>
                <span class="badge bg-light text-muted fw-normal px-2 py-1 fs-12">Đơn thuốc lâm sàng</span>
            </div>
            <h1 class="h3 fw-bold text-slate-800 mb-0">Quản Lý & Kê Đơn Thuốc Điện Tử</h1>
            <p class="text-muted small mb-0 mt-1">Lập đơn thuốc gắn liền với ca khám điều trị và in đơn thuốc chuẩn y tế cho bệnh nhân</p>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-primary d-flex align-items-center gap-2 shadow-sm" data-bs-toggle="modal" data-bs-target="#modalCreatePrescription">
                <i class="bi bi-plus-circle-fill"></i>
                <span>+ Kê Đơn Thuốc Mới</span>
            </button>
        </div>
    </div>


    <!-- Search Toolbar -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-md-9 col-lg-10">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" name="search" value="@Model.Search" class="form-control bg-light border-start-0" 
                               placeholder="Tìm kiếm theo Tên bệnh nhân, Mã BN, Mã ca khám hoặc Tên thuốc...">
                    </div>
                </div>
                <div class="col-md-3 col-lg-2 d-flex gap-2">
                    <button type="submit" class="btn btn-dark w-100 d-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-funnel"></i>
                        <span>Tìm Kiếm</span>
                    </button>
                    @if (!string.IsNullOrEmpty(Model.Search))
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary" title="Xóa bộ lọc">
                            <i class="bi bi-x-lg"></i>
                        </a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Prescriptions Table -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
            <h5 class="card-title fw-bold text-slate-800 mb-0 d-flex align-items-center gap-2">
                <i class="bi bi-journal-medical text-primary"></i>
                <span>Danh Sách Đơn Thuốc Đã Kê</span>
                <span class="badge bg-secondary-subtle text-secondary rounded-pill fs-12 ms-1">@Model.Prescriptions.Count đơn</span>
            </h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-muted fs-13 text-uppercase">
                    <tr>
                        <th class="ps-4">Mã Đơn / Ca Khám</th>
                        <th>Bệnh Nhân</th>
                        <th>Ngày Kê Đơn</th>
                        <th>Các Thuốc Trong Đơn</th>
                        <th>Lời Dặn Của Bác Sĩ</th>
                        <th class="text-end pe-4">Thao Tác</th>
                    </tr>
                </thead>
                <tbody class="fs-14">
                    @if (Model.Prescriptions.Any())
                    {
                        foreach (var p in Model.Prescriptions)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold text-primary">#RX-@p.PrescriptionId</div>
                                    <div class="badge bg-light text-dark border small">Ca: @p.AppointmentCode</div>
                                    @if (Model.DispensationStatusMap.TryGetValue(p.PrescriptionId, out var dispStatus) && dispStatus.HasDispensation)
                                    {
                                        <div class="badge bg-success-subtle text-success small mt-1 d-block text-start">
                                            <i class="bi bi-box-check-fill me-1"></i>Đã cấp (@dispStatus.TotalUnitsDispensed viên/đv)
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="badge bg-secondary-subtle text-secondary small mt-1 d-block text-start">
                                            <i class="bi bi-hourglass me-1"></i>Chưa cấp kho
                                        </div>
                                    }
                                </td>
                                <td>
                                    <div class="fw-bold text-slate-800">@p.PatientName</div>
                                    <div class="text-muted small">@p.PatientCode • @(p.PatientPhone ?? "—")</div>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@p.IssuedAt.ToString("dd/MM/yyyy")</div>
                                    <div class="text-muted small">@p.IssuedAt.ToString("HH:mm")</div>
                                </td>
                                <td>
                                    <div class="d-flex flex-column gap-1">
                                        @foreach (var item in p.Items)
                                        {
                                            <div class="small">
                                                <strong>• @item.MedicationName</strong>
                                                <span class="text-muted">(@(item.Dosage ?? "—") - @(item.Frequency ?? "Theo chỉ định"))</span>
                                            </div>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <span class="text-muted small fst-italic">@(string.IsNullOrEmpty(p.GeneralInstructions) ? "Không có" : p.GeneralInstructions)</span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-inline-flex gap-1">
                                        <button type="button" class="btn btn-sm btn-outline-success btn-open-dispense"
                                                data-bs-toggle="modal" data-bs-target="#modalDispensePrescription"
                                                data-prescription-id="@p.PrescriptionId"
                                                data-patient-name="@p.PatientName"
                                                data-appt-code="@p.AppointmentCode"
                                                title="Cấp phát thuốc trực tiếp từ kho phòng khám (WF-16)">
                                            <i class="bi bi-box-arrow-right me-1"></i> Cấp Thuốc
                                        </button>
                                        <a asp-action="Print" asp-route-id="@p.PrescriptionId" class="btn btn-sm btn-outline-primary" target="_blank" title="In đơn thuốc chuẩn y tế">
                                            <i class="bi bi-printer me-1"></i> In Đơn
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-capsule fs-1 d-block mb-2 text-secondary"></i>
                                Bạn chưa kê đơn thuốc nào. Hãy bấm <strong>"+ Kê Đơn Thuốc Mới"</strong> để bắt đầu.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ============================================== -->
<!-- MODAL: KÊ ĐƠN THUỐC MỚI                       -->
<!-- ============================================== -->
<div class="modal fade" id="modalCreatePrescription" tabindex="-1" aria-labelledby="modalCreatePrescriptionLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold" id="modalCreatePrescriptionLabel">
                    <i class="bi bi-capsule me-2"></i>Kê Đơn Thuốc Cho Bệnh Nhân
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Create" method="post" onsubmit="return preparePrescriptionJson()">
                @Html.AntiForgeryToken()
                <input type="hidden" id="prescriptionItemsJsonInput" name="ItemsJson" value="[]" />

                <div class="modal-body p-4">
                    <!-- Chọn ca khám -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-slate-700">Chọn ca khám của bệnh nhân <span class="text-danger">*</span></label>
                        @if (Model.EligibleAppointments.Any())
                        {
                            <select name="AppointmentId" class="form-select" required>
                                <option value="">-- Chọn ca khám điều trị --</option>
                                @foreach (var appt in Model.EligibleAppointments)
                                {
                                    <option value="@appt.AppointmentId">
                                        @appt.AppointmentCode - @appt.PatientName (@appt.PatientCode) - @appt.ServiceName (@(appt.ScheduledStart.HasValue ? appt.ScheduledStart.Value.ToString("dd/MM/yyyy HH:mm") : ""))
                                    </option>
                                }
                            </select>
                        }
                        else
                        {
                            <div class="alert alert-warning py-2 px-3 small">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i> Hiện tại bạn không có ca khám nào được phân bổ để kê đơn.
                            </div>
                        }
                    </div>

                    <!-- Danh sách thuốc -->
                    <div class="border rounded-3 p-3 bg-light mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label class="form-label fw-bold text-slate-800 mb-0">
                                <i class="bi bi-prescription2 me-1 text-primary"></i> Danh Mục Thuốc Trong Đơn:
                            </label>
                            <button type="button" class="btn btn-sm btn-primary" onclick="addMedicationRow()">
                                <i class="bi bi-plus-lg me-1"></i> Thêm Thuốc
                            </button>
                        </div>
                        <div id="medicationRowsContainer" class="d-flex flex-column gap-2">
                            <!-- Rows added dynamically via JS -->
                        </div>
                    </div>

                    <!-- Lời dặn chung -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-slate-700">Lời dặn chung của bác sĩ</label>
                        <textarea name="GeneralInstructions" class="form-control" rows="2" 
                                  placeholder="Ví dụ: Uống thuốc sau khi ăn no. Kiêng đồ ăn quá cay nóng, nước ngọt có ga. Tái khám sau 7 ngày hoặc khi có dấu hiệu bất thường."></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy Bỏ</button>
                    <button type="submit" class="btn btn-primary px-4 fw-medium">
                        <i class="bi bi-check-circle me-1"></i> Hoàn Tất & Lưu Đơn Thuốc
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>


<!-- ============================================== -->
<!-- MODAL: CẤP THUỐC TỪ KHO CHO ĐƠN (WF-16)        -->
<!-- ============================================== -->
<div class="modal fade" id="modalDispensePrescription" tabindex="-1" aria-labelledby="modalDispensePrescriptionLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title fw-bold" id="modalDispensePrescriptionLabel">
                    <i class="bi bi-box-arrow-right me-2"></i>Cấp Phát Thuốc Trực Tiếp Từ Kho (WF-16)
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Dispense" method="post" onsubmit="return prepareDispenseJson()">
                @Html.AntiForgeryToken()
                <input type="hidden" id="dispensePrescriptionIdInput" name="PrescriptionId" />
                <input type="hidden" id="dispenseItemsJsonInput" name="ItemsJson" value="[]" />

                <div class="modal-body p-4">
                    <div class="alert alert-info py-2 small mb-3">
                        <i class="bi bi-info-circle me-1"></i>
                        Đơn thuốc: <strong id="dispensePrescriptionNumDisplay">#RX-...</strong> &bull;
                        Bệnh nhân: <strong id="dispensePatientNameDisplay">...</strong> &bull;
                        Mã ca: <strong id="dispenseApptCodeDisplay">...</strong>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="fw-semibold text-slate-800">Danh Mục Thuốc Xuất Kho Theo Lô (FEFO)</span>
                        <button type="button" class="btn btn-sm btn-outline-success" onclick="addDispenseRow()">
                            <i class="bi bi-plus-lg me-1"></i>Thêm Dòng Thuốc
                        </button>
                    </div>

                    <div id="dispenseRowsContainer" class="d-flex flex-column gap-2 mb-3">
                        <!-- Dynamic Dispense Rows -->
                    </div>

                    <div class="mb-2">
                        <label class="form-label fw-semibold text-slate-700">Ghi chú lâm sàng / Hướng dẫn dặn dò khi giao thuốc</label>
                        <input type="text" name="Notes" class="form-control" placeholder="VD: Bác sĩ đã kiểm tra tem nhãn, bàn giao trực tiếp 6 viên Amoxicillin..." />
                    </div>
                </div>

                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-success fw-semibold">
                        <i class="bi bi-check2-circle me-1"></i> Xác Nhận Bàn Giao & Giảm Tồn Kho
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const sampleMedications = [
        { name: "Amoxicillin 500mg", dosage: "14 viên", freq: "Uống 2 lần/ngày, sáng 1v - tối 1v", dur: "7 ngày", inst: "Uống sau ăn no" },
        { name: "Paracetamol 500mg", dosage: "10 viên", freq: "Khi đau nhức, cách nhau 4-6 tiếng", dur: "3-5 ngày", inst: "Không uống quá 4 viên/ngày" },
        { name: "Alphachymotrypsin 4.2mg", dosage: "20 viên", freq: "Uống 2 lần/ngày, sáng 2v - tối 2v", dur: "5 ngày", inst: "Uống nhiều nước" },
        { name: "Ibuprofen 400mg", dosage: "10 viên", freq: "Uống 2 lần/ngày sau bữa ăn", dur: "5 ngày", inst: "Chống viêm giảm đau" },
        { name: "Nước súc miệng Chlorhexidine 0.12%", dosage: "1 chai 250ml", freq: "Súc miệng 2-3 lần/ngày", dur: "7 ngày", inst: "Ngậm và súc miệng trong 30 giây" }
    ];

    function addMedicationRow(defaultMed = null) {
        const container = document.getElementById("medicationRowsContainer");
        const rowId = "med-row-" + Date.now() + Math.floor(Math.random() * 100);

        const name = defaultMed ? defaultMed.name : "";
        const dosage = defaultMed ? defaultMed.dosage : "";
        const freq = defaultMed ? defaultMed.freq : "";
        const inst = defaultMed ? defaultMed.inst : "";

        const html = `
            <div class="card border p-2 bg-white med-input-row" id="${rowId}">
                <div class="row g-2 align-items-center">
                    <div class="col-md-5">
                        <label class="small text-muted mb-0">Tên thuốc & hàm lượng <span class="text-danger">*</span></label>
                        <input type="text" class="form-control form-control-sm med-name-input" list="medListOptions" placeholder="Ví dụ: Amoxicillin 500mg" value="${name}" required />
                    </div>
                    <div class="col-md-3">
                        <label class="small text-muted mb-0">Số lượng & Đơn vị</label>
                        <input type="text" class="form-control form-control-sm med-dosage-input" placeholder="Ví dụ: 14 viên / 1 chai" value="${dosage}" />
                    </div>
                    <div class="col-md-3">
                        <label class="small text-muted mb-0">Cách dùng / Tần suất</label>
                        <input type="text" class="form-control form-control-sm med-freq-input" placeholder="Ví dụ: Sáng 1v, tối 1v" value="${freq}" />
                    </div>
                    <div class="col-md-1 text-end pt-3">
                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="document.getElementById('${rowId}').remove()"><i class="bi bi-trash"></i></button>
                    </div>
                </div>
            </div>`;
        container.insertAdjacentHTML('beforeend', html);
    }

    function preparePrescriptionJson() {
        const rows = document.querySelectorAll(".med-input-row");
        const list = [];
        rows.forEach(r => {
            const name = r.querySelector(".med-name-input").value.trim();
            const dosage = r.querySelector(".med-dosage-input").value.trim();
            const freq = r.querySelector(".med-freq-input").value.trim();
            if (name) {
                list.push({
                    medicationName: name,
                    dosage: dosage,
                    frequency: freq,
                    duration: "Theo chỉ định",
                    instructions: freq
                });
            }
        });

        if (list.length === 0) {
            window.toastWarning('Vui lòng thêm ít nhất một loại thuốc hợp lệ vào đơn thuốc trước khi hoàn tất.', 'Thiếu Danh Mục Thuốc');
            return false;
        }

        document.getElementById("prescriptionItemsJsonInput").value = JSON.stringify(list);
        return true;
    }

    document.addEventListener("DOMContentLoaded", function () {
        if (document.getElementById("medicationRowsContainer")) {
            // Add default rows from sample medications
            addMedicationRow(sampleMedications[0]);
            addMedicationRow(sampleMedications[1]);
        }
    });

    const availableMeds = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AvailableMedicines, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));

    document.addEventListener("DOMContentLoaded", function () {
        const dispenseModal = document.getElementById("modalDispensePrescription");
        if (dispenseModal) {
            dispenseModal.addEventListener("show.bs.modal", function (event) {
                const btn = event.relatedTarget;
                if (!btn) return;
                const pId = btn.getAttribute("data-prescription-id");
                const patName = btn.getAttribute("data-patient-name");
                const apptCode = btn.getAttribute("data-appt-code");

                document.getElementById("dispensePrescriptionIdInput").value = pId;
                document.getElementById("dispensePrescriptionNumDisplay").textContent = "#RX-" + pId;
                document.getElementById("dispensePatientNameDisplay").textContent = patName;
                document.getElementById("dispenseApptCodeDisplay").textContent = apptCode;

                // Clear and add first row
                const container = document.getElementById("dispenseRowsContainer");
                container.innerHTML = "";
                addDispenseRow();
            });
        }
    });

    async function addDispenseRow() {
        const container = document.getElementById("dispenseRowsContainer");
        const rowId = "disp_row_" + Date.now() + "_" + Math.floor(Math.random() * 1000);

        let medOptions = '<option value="">-- Chọn thuốc trong kho --</option>';
        availableMeds.forEach(m => {
            medOptions += `<option value="${m.medicineId}">${m.medicineName} (Tồn: ${m.totalAvailableStock} ${m.unit})</option>`;
        });

        const row = document.createElement("div");
        row.className = "row g-2 align-items-center p-2 bg-light rounded border dispense-row";
        row.id = rowId;
        row.innerHTML = `
            <div class="col-12 col-md-5">
                <label class="form-label text-muted small mb-1">Mặt hàng thuốc</label>
                <select class="form-select form-select-sm sel-med" onchange="onMedicineSelected('${rowId}')">
                    ${medOptions}
                </select>
            </div>
            <div class="col-8 col-md-4">
                <label class="form-label text-muted small mb-1">Lô thuốc (Hạn dùng)</label>
                <select class="form-select form-select-sm sel-batch">
                    <option value="">-- Chọn thuốc trước --</option>
                </select>
            </div>
            <div class="col-3 col-md-2">
                <label class="form-label text-muted small mb-1">Số lượng cấp</label>
                <input type="number" class="form-control form-select-sm inp-qty" min="1" value="1" />
            </div>
            <div class="col-1 col-md-1 text-end pt-3">
                <button type="button" class="btn btn-sm btn-link text-danger p-0" onclick="document.getElementById('${rowId}').remove()" title="Xóa dòng">
                    <i class="bi bi-trash fs-5"></i>
                </button>
            </div>
        `;
        container.appendChild(row);
    }

    async function onMedicineSelected(rowId) {
        const row = document.getElementById(rowId);
        if (!row) return;
        const medSelect = row.querySelector(".sel-med");
        const batchSelect = row.querySelector(".sel-batch");
        const medId = medSelect.value;

        if (!medId) {
            batchSelect.innerHTML = '<option value="">-- Chọn thuốc trước --</option>';
            return;
        }

        batchSelect.innerHTML = '<option value="">Đang nạp lô...</option>';
        try {
            const resp = await fetch(`/Dentist/Prescriptions/${medId}/Batches`);
            const data = await resp.json();
            if (data.isSuccess && data.data && data.data.length > 0) {
                let options = "";
                data.data.forEach(b => {
                    if (b.quantityAvailable > 0 && !b.isExpired) {
                        options += `<option value="${b.medicineBatchId}">${b.batchNumber} (HSD: ${b.expiryDate} - Tồn: ${b.quantityAvailable})</option>`;
                    }
                });
                batchSelect.innerHTML = options || '<option value="">(Không có lô khả dụng)</option>';
            } else {
                batchSelect.innerHTML = '<option value="">(Không có lô)</option>';
            }
        } catch (e) {
            batchSelect.innerHTML = '<option value="">(Lỗi nạp lô)</option>';
        }
    }

    function prepareDispenseJson() {
        const rows = document.querySelectorAll(".dispense-row");
        const list = [];
        for (const r of rows) {
            const medId = parseInt(r.querySelector(".sel-med").value);
            const batchId = parseInt(r.querySelector(".sel-batch").value);
            const qty = parseInt(r.querySelector(".inp-qty").value);

            if (medId && batchId && qty > 0) {
                list.push({
                    medicineId: medId,
                    medicineBatchId: batchId,
                    quantity: qty
                });
            }
        }

        if (list.length === 0) {
            alert("Vui lòng chọn thuốc, lô thuốc và số lượng cấp phát hợp lệ.");
            return false;
        }

        document.getElementById("dispenseItemsJsonInput").value = JSON.stringify(list);
        return true;
    }

</script>
}

<datalist id="medListOptions">
    <option value="Amoxicillin 500mg"></option>
    <option value="Augmentin 625mg"></option>
    <option value="Paracetamol 500mg"></option>
    <option value="Ibuprofen 400mg"></option>
    <option value="Alphachymotrypsin 4.2mg"></option>
    <option value="Rodogyl (Spiramycin + Metronidazol)"></option>
    <option value="Nước súc miệng Chlorhexidine 0.12%"></option>
    <option value="Vitamin C 500mg"></option>
</datalist>
