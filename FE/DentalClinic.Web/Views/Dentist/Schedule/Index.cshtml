@model DentistPersonalScheduleViewModel
@{
    ViewData["Title"] = "Lịch làm việc của tôi";
}

<div class="container-fluid p-0">
    <!-- Header -->
    <div class="page-header-dc">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge-dc badge-role-dentist">Bác sĩ nha khoa</span>
                <span class="badge bg-white text-muted border small">Ca trực & Lịch khám</span>
            </div>
            <h1 class="page-title">Lịch Làm Việc & Ca Trực Của Tôi</h1>
            <p class="page-subtitle">Theo dõi lịch trực được phân công tại các chuyên khoa và kiểm tra thời gian phục vụ bệnh nhân</p>
        </div>
        <div class="page-actions d-flex gap-2">
            <a asp-controller="DentistSchedule" asp-action="Availability" class="btn btn-dc-outline">
                <i class="bi bi-clock-history me-1"></i> Trạng thái sẵn sàng / Nghỉ phép
            </a>
            <a asp-controller="DentistSchedule" asp-action="Feedback" class="btn btn-dc-primary">
                <i class="bi bi-star me-1"></i> Đánh giá từ bệnh nhân
            </a>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="card-dc mb-4">
        <div class="card-dc-body p-3">
            <form asp-controller="DentistSchedule" asp-action="Schedule" method="get" class="row g-2 align-items-center">
                <div class="col-md-4">
                    <label class="form-label small fw-semibold text-muted mb-1">Từ ngày</label>
                    <input type="date" name="fromDate" class="form-control form-control-sm" value="@Model.FromDate.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-semibold text-muted mb-1">Đến ngày</label>
                    <input type="date" name="toDate" class="form-control form-control-sm" value="@Model.ToDate.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-4 d-flex align-items-end gap-2 pt-3">
                    <button type="submit" class="btn btn-sm btn-dc-primary">
                        <i class="bi bi-filter me-1"></i> Lọc ngày
                    </button>
                    <a asp-controller="DentistSchedule" asp-action="Schedule" class="btn btn-sm btn-outline-secondary">
                        Hôm nay
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Schedules Table -->
    <div class="card-dc">
        <div class="card-dc-header d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-calendar-check text-primary"></i>
                <span class="fw-bold">Danh sách Ca trực được phân công (@Model.Schedules.Count ca)</span>
            </div>
            <div class="text-muted small">
                Từ <strong>@Model.FromDate.ToString("dd/MM/yyyy")</strong> đến <strong>@Model.ToDate.ToString("dd/MM/yyyy")</strong>
            </div>
        </div>
        <div class="card-dc-body p-0">
            <div class="table-responsive">
                <table class="table-dc mb-0">
                    <thead>
                        <tr>
                            <th style="width: 50px;">#</th>
                            <th>Ngày trực</th>
                            <th>Khung giờ làm việc</th>
                            <th>Chuyên khoa trực</th>
                            <th>Trạng thái</th>
                            <th>Ghi chú</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Schedules.Any())
                        {
                            int idx = 1;
                            foreach (var s in Model.Schedules)
                            {
                                <tr>
                                    <td class="text-muted fw-bold">@(idx++)</td>
                                    <td>
                                        <div class="fw-bold text-dark">
                                            <i class="bi bi-calendar3 me-1 text-primary"></i>@s.WorkDate.ToString("dd/MM/yyyy")
                                        </div>
                                        <div class="text-muted small">@s.WorkDate.ToString("dddd")</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle fs-6 px-3 py-2">
                                            <i class="bi bi-clock me-1"></i>@s.StartTime.ToString("HH:mm") - @s.EndTime.ToString("HH:mm")
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@s.DepartmentName</span>
                                    </td>
                                    <td>
                                        @if (s.Status == "Scheduled")
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                <i class="bi bi-check-circle me-1"></i> Đang lên lịch
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
                                                <i class="bi bi-x-circle me-1"></i> Đã hủy
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <span class="text-muted small">@(string.IsNullOrEmpty(s.Note) ? "—" : s.Note)</span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">
                                    <i class="bi bi-calendar-x fs-3 d-block mb-1"></i>
                                    Bạn không có ca trực nào được phân bổ trong khoảng thời gian này.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
