@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const calendarView = document.getElementById("calendarGridView");
        const listView = document.getElementById("calendarListView");
        const btnCalendar = document.getElementById("btnToggleCalendarView");
        const btnList = document.getElementById("btnToggleListView");
        const searchInput = document.getElementById("calendarSearchInput");
        const btnClearSearch = document.getElementById("btnClearSearch");
        const deptFilter = document.getElementById("calendarDeptFilter");

        // Toggle View Handlers
        btnCalendar.addEventListener("click", function () {
            btnCalendar.classList.add("btn-primary", "active");
            btnCalendar.classList.remove("btn-outline-primary");
            btnList.classList.remove("btn-primary", "active");
            btnList.classList.add("btn-outline-primary");
            calendarView.classList.remove("d-none");
            listView.classList.add("d-none");
        });

        btnList.addEventListener("click", function () {
            btnList.classList.add("btn-primary", "active");
            btnList.classList.remove("btn-outline-primary");
            btnCalendar.classList.remove("btn-primary", "active");
            btnCalendar.classList.add("btn-outline-primary");
            listView.classList.remove("d-none");
            calendarView.classList.add("d-none");
        });

        // Search & Filter Execution
        function applyFilters() {
            const query = (searchInput.value || "").trim().toLowerCase();
            const dept = (deptFilter ? deptFilter.value : "").trim().toLowerCase();

            // 1. Filter Calendar Cells
            const cells = document.querySelectorAll(".calendar-day-cell");
            cells.forEach(cell => {
                const jsonId = cell.getAttribute("data-json-id");
                const scriptTag = document.getElementById(jsonId);
                if (!scriptTag) return;

                let data = {};
                try {
                    data = JSON.parse(scriptTag.textContent);
                } catch (e) { return; }

                let matchesQuery = true;
                let matchesDept = true;

                // Department filter check
                if (dept) {
                    matchesDept = data.shifts.some(s => s.departmentName && s.departmentName.toLowerCase().includes(dept));
                }

                // Query search check (patient name, service, note, department, time)
                if (query) {
                    const matchShift = data.shifts.some(s => 
                        (s.departmentName && s.departmentName.toLowerCase().includes(query)) ||
                        (s.note && s.note.toLowerCase().includes(query)) ||
                        (s.startTime && s.startTime.includes(query)) ||
                        (s.endTime && s.endTime.includes(query))
                    );
                    const matchAppt = data.appointments.some(a => 
                        (a.patientName && a.patientName.toLowerCase().includes(query)) ||
                        (a.serviceName && a.serviceName.toLowerCase().includes(query)) ||
                        (a.roomName && a.roomName.toLowerCase().includes(query)) ||
                        (a.code && a.code.toLowerCase().includes(query)) ||
                        (a.patientPhone && a.patientPhone.includes(query))
                    );
                    matchesQuery = matchShift || matchAppt;
                }

                if (query || dept) {
                    if (matchesQuery && matchesDept) {
                        cell.classList.add("highlight-matched");
                        cell.classList.remove("dimmed-cell");
                    } else {
                        cell.classList.remove("highlight-matched");
                        cell.classList.add("dimmed-cell");
                    }
                } else {
                    cell.classList.remove("highlight-matched", "dimmed-cell");
                }
            });

            // 2. Filter List Rows
            const rows = document.querySelectorAll(".list-row-item");
            rows.forEach(row => {
                const rowDept = (row.getAttribute("data-dept") || "").toLowerCase();
                const rowText = row.innerText.toLowerCase();

                const deptMatch = !dept || rowDept.includes(dept);
                const queryMatch = !query || rowText.includes(query);

                row.style.display = (deptMatch && queryMatch) ? "" : "none";
            });
        }

        searchInput.addEventListener("input", applyFilters);
        if (deptFilter) deptFilter.addEventListener("change", applyFilters);
        btnClearSearch.addEventListener("click", function () {
            searchInput.value = "";
            if (deptFilter) deptFilter.value = "";
            applyFilters();
        });
    });

    // Global Modal Function
    function openDayDetailModal(jsonId) {
        const scriptTag = document.getElementById(jsonId);
        if (!scriptTag) return;

        let data = null;
        try {
            data = JSON.parse(scriptTag.textContent);
        } catch (e) {
            console.error("Invalid day json:", e);
            return;
        }

        document.getElementById("modalDaySubTitle").textContent = 
            `${data.weekDay}, ngày ${data.dateStr} ${data.isToday ? "(Hôm nay)" : ""}`;

        // Render Shifts
        const shiftsContainer = document.getElementById("modalShiftsContainer");
        if (!data.shifts || data.shifts.length === 0) {
            shiftsContainer.innerHTML = `
                <div class="alert alert-light border py-3 text-muted small d-flex align-items-center gap-2">
                    <i class="bi bi-info-circle text-secondary fs-5"></i>
                    <div>Không có ca trực nào được phân bổ trong ngày này.</div>
                </div>`;
        } else {
            let shiftsHtml = `<div class="row g-2">`;
            data.shifts.forEach(s => {
                const statusBadge = s.status === 'Scheduled' 
                    ? `<span class="badge bg-success-subtle text-success border border-success-subtle">Đang lên lịch</span>`
                    : `<span class="badge bg-secondary">Đã hủy</span>`;

                shiftsHtml += `
                    <div class="col-md-6">
                        <div class="card border rounded-3 p-3 bg-light-subtle h-100">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="fw-bold text-primary fs-14">
                                    <i class="bi bi-geo-alt-fill me-1"></i>${s.departmentName || 'Chuyên khoa trực'}
                                </span>
                                ${statusBadge}
                            </div>
                            <div class="d-flex align-items-center gap-2 text-dark fw-semibold mb-1">
                                <i class="bi bi-clock text-secondary"></i>
                                <span>Khung giờ: ${s.startTime} - ${s.endTime}</span>
                            </div>
                            ${s.note ? `<div class="small text-muted mt-1"><i class="bi bi-chat-left-text me-1"></i>${s.note}</div>` : ''}
                        </div>
                    </div>`;
            });
            shiftsHtml += `</div>`;
            shiftsContainer.innerHTML = shiftsHtml;
        }

        // Render Appointments
        const apptsContainer = document.getElementById("modalApptsContainer");
        if (!data.appointments || data.appointments.length === 0) {
            apptsContainer.innerHTML = `
                <div class="alert alert-light border py-3 text-muted small d-flex align-items-center gap-2">
                    <i class="bi bi-people text-secondary fs-5"></i>
                    <div>Chưa có lượt bệnh nhân nào được xếp lịch khám trong ngày này.</div>
                </div>`;
        } else {
            let apptsHtml = `
                <div class="table-responsive border rounded-3">
                    <table class="table table-hover align-middle mb-0 fs-13">
                        <thead class="table-light text-muted text-uppercase">
                            <tr>
                                <th class="ps-3">Giờ Khám</th>
                                <th>Bệnh Nhân</th>
                                <th>Dịch Vụ / Thủ Thuật</th>
                                <th>Phòng Khám</th>
                                <th class="text-end pe-3">Trạng Thái</th>
                            </tr>
                        </thead>
                        <tbody>`;
            data.appointments.forEach(a => {
                let statusBadge = `<span class="badge bg-primary-subtle text-primary border border-primary-subtle">${a.status}</span>`;
                if (a.status === 'Completed') {
                    statusBadge = `<span class="badge bg-success-subtle text-success border border-success-subtle">Hoàn thành</span>`;
                } else if (a.status === 'CheckedIn' || a.status === 'Waiting') {
                    statusBadge = `<span class="badge bg-warning-subtle text-warning border border-warning-subtle">Đang chờ</span>`;
                } else if (a.status === 'InService') {
                    statusBadge = `<span class="badge bg-info-subtle text-info border border-info-subtle">Đang khám</span>`;
                }

                apptsHtml += `
                    <tr>
                        <td class="ps-3 fw-bold text-primary">
                            <i class="bi bi-clock me-1"></i>${a.time || '—'}
                        </td>
                        <td>
                            <div class="fw-bold text-dark">${a.patientName}</div>
                            <div class="text-muted small">${a.patientPhone || a.code}</div>
                        </td>
                        <td><span class="fw-medium text-slate-800">${a.serviceName || 'Khám điều trị'}</span></td>
                        <td><span class="badge bg-light text-dark border">${a.roomName || 'Ghế khám phân bổ'}</span></td>
                        <td class="text-end pe-3">${statusBadge}</td>
                    </tr>`;
            });
            apptsHtml += `
                        </tbody>
                    </table>
                </div>`;
            apptsContainer.innerHTML = apptsHtml;
        }

        // Show Modal
        const modalEl = document.getElementById("modalDayDetail");
        const modalInstance = bootstrap.Modal.getOrCreateInstance(modalEl);
        modalInstance.show();
    }
</script>
}
