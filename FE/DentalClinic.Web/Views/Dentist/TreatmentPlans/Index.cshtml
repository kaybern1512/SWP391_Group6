@model DentalClinic.Web.ViewModels.Treatment.DentistTreatmentPlanListViewModel
@{
    ViewData["Title"] = "Kế Hoạch & Phác Đồ Điều Trị";
}

<div class="container-fluid px-0">
    <!-- Header & Action -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-diagram-3 me-2 text-primary"></i>Kế Hoạch & Phác Đồ Điều Trị
            </h1>
            <p class="text-muted mb-0">Thiết lập lộ trình điều trị đa giai đoạn, theo dõi tiến độ và ghi nhận thủ thuật cho bệnh nhân.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Sessions" class="btn btn-outline-secondary">
                <i class="bi bi-clipboard2-check me-1"></i>Sổ Ghi Nhận Buổi Điều Trị
            </a>
            <a asp-action="Create" class="btn btn-primary shadow-sm">
                <i class="bi bi-plus-circle me-1"></i>+ Lập Phác Đồ Mới
            </a>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Stat KPI Cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-md-4">
            <div class="card border-0 shadow-sm border-start border-primary border-4 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-muted small fw-semibold text-uppercase">Tổng số phác đồ</div>
                            <div class="h3 fw-bold text-dark mb-0">@Model.TotalPlans</div>
                        </div>
                        <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-3">
                            <i class="bi bi-card-checklist fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-md-4">
            <div class="card border-0 shadow-sm border-start border-warning border-4 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-muted small fw-semibold text-uppercase">Đang điều trị (Active)</div>
                            <div class="h3 fw-bold text-warning mb-0">@Model.ActivePlans</div>
                        </div>
                        <div class="rounded-circle bg-warning bg-opacity-10 text-warning p-3">
                            <i class="bi bi-activity fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-md-4">
            <div class="card border-0 shadow-sm border-start border-success border-4 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-muted small fw-semibold text-uppercase">Đã hoàn thành</div>
                            <div class="h3 fw-bold text-success mb-0">@Model.CompletedPlans</div>
                        </div>
                        <div class="rounded-circle bg-success bg-opacity-10 text-success p-3">
                            <i class="bi bi-check-circle fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter & Search Card -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-2 align-items-center">
                <div class="col-12 col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="search" value="@Model.SearchTerm" class="form-control border-start-0" 
                               placeholder="Tìm tên BN, mã BN, chuyên khoa..." />
                    </div>
                </div>
                <div class="col-12 col-md-3">
                    <select name="status" class="form-select">
                        <option value="">-- Tất cả trạng thái --</option>
                        <option value="Active" selected="@(Model.StatusFilter == "Active")">Đang điều trị (Active)</option>
                        <option value="Completed" selected="@(Model.StatusFilter == "Completed")">Đã hoàn thành (Completed)</option>
                        <option value="Draft" selected="@(Model.StatusFilter == "Draft")">Bản nháp (Draft)</option>
                        <option value="Cancelled" selected="@(Model.StatusFilter == "Cancelled")">Đã hủy (Cancelled)</option>
                    </select>
                </div>
                <div class="col-12 col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1">
                        <i class="bi bi-funnel me-1"></i>Lọc
                    </button>
                    @if (!string.IsNullOrEmpty(Model.SearchTerm) || !string.IsNullOrEmpty(Model.StatusFilter))
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary">Đặt lại</a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Table of Treatment Plans -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="card-title mb-0 fw-bold text-dark">
                <i class="bi bi-list-columns-reverse me-2 text-primary"></i>Danh Sách Kế Hoạch Điều Trị
            </h5>
        </div>
        @if (Model.Plans == null || Model.Plans.Count == 0)
        {
            <div class="text-center py-5">
                <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px;">
                    <i class="bi bi-diagram-3 fs-2 text-muted"></i>
                </div>
                <h5 class="fw-bold text-dark">Chưa có kế hoạch điều trị nào</h5>
                <p class="text-muted mb-3">Hiện chưa có phác đồ điều trị nào phù hợp với bộ lọc tìm kiếm.</p>
                <a asp-action="Create" class="btn btn-primary btn-sm">
                    <i class="bi bi-plus-circle me-1"></i>Lập Phác Đồ Điều Trị Đầu Tiên
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3" style="width: 100px;">Mã KH</th>
                            <th>Bệnh Nhân</th>
                            <th>Chuyên Khoa</th>
                            <th>Bác Sĩ Phụ Trách</th>
                            <th style="min-width: 180px;">Tiến Độ Điều Trị</th>
                            <th>Chi Phí Ước Tính</th>
                            <th>Trạng Thái</th>
                            <th class="text-end pe-3">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var plan in Model.Plans)
                        {
                            <tr>
                                <td class="ps-3">
                                    <span class="badge bg-light text-dark border font-monospace fs-6">
                                        #@plan.TreatmentPlanId
                                    </span>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@plan.PatientName</div>
                                    <div class="text-muted small">
                                        Mã: <span class="badge bg-secondary bg-opacity-10 text-secondary">@plan.PatientCode</span>
                                        @if (!string.IsNullOrEmpty(plan.PatientPhone))
                                        {
                                            <span>&bull; SĐT: @plan.PatientPhone</span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-primary bg-opacity-10 text-primary px-2 py-1">
                                        @plan.DepartmentName
                                    </span>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@plan.CreatedByDentistName</div>
                                    <div class="text-muted small">Lập ngày: @plan.CreatedAt.ToString("dd/MM/yyyy")</div>
                                </td>
                                <td>
                                    <div class="d-flex justify-content-between align-items-center mb-1 small">
                                        <span class="fw-semibold text-muted">@plan.CompletedItemsCount / @plan.TotalItemsCount giai đoạn</span>
                                        <span class="fw-bold text-primary">@plan.ProgressPercentage%</span>
                                    </div>
                                    <div class="progress" style="height: 7px;">
                                        <div class="progress-bar @(plan.ProgressPercentage == 100 ? "bg-success" : "bg-primary")" 
                                             role="progressbar" style="width: @plan.ProgressPercentage%" 
                                             aria-valuenow="@plan.ProgressPercentage" aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-bold text-success">
                                        @(plan.EstimatedTotal.HasValue ? plan.EstimatedTotal.Value.ToString("N0") + " ₫" : "Chưa định giá")
                                    </div>
                                </td>
                                <td>
                                    @switch (plan.Status)
                                    {
                                        case "Active":
                                            <span class="badge bg-warning text-dark px-3 py-2">
                                                <i class="bi bi-hourglass-split me-1"></i>Đang điều trị
                                            </span>
                                            break;
                                        case "Completed":
                                            <span class="badge bg-success px-3 py-2">
                                                <i class="bi bi-check-all me-1"></i>Hoàn thành
                                            </span>
                                            break;
                                        case "Draft":
                                            <span class="badge bg-secondary px-3 py-2">
                                                <i class="bi bi-pencil-square me-1"></i>Bản nháp
                                            </span>
                                            break;
                                        case "Cancelled":
                                            <span class="badge bg-danger px-3 py-2">
                                                <i class="bi bi-x-circle me-1"></i>Đã hủy
                                            </span>
                                            break;
                                        default:
                                            <span class="badge bg-light text-dark border px-3 py-2">@plan.Status</span>
                                            break;
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <div class="btn-group">
                                        <a asp-action="Detail" asp-route-id="@plan.TreatmentPlanId" 
                                           class="btn btn-sm btn-outline-primary" title="Xem chi tiết phác đồ">
                                            <i class="bi bi-eye me-1"></i>Chi tiết
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
