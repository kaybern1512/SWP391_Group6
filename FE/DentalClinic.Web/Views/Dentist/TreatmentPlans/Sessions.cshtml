@model DentalClinic.Web.ViewModels.Treatment.DentistTreatmentSessionListViewModel
@{
    ViewData["Title"] = "Sổ Ghi Nhận Buổi Điều Trị";
}

<div class="container-fluid px-0">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-clipboard2-check me-2 text-primary"></i>Sổ Ghi Nhận Buổi Điều Trị Lâm Sàng
            </h1>
            <p class="text-muted mb-0">Nhật ký theo dõi các buổi điều trị thực tế, ghi chú lâm sàng và thủ thuật đã thực hiện trên bệnh nhân.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-diagram-3 me-1"></i>Xem Phác Đồ Điều Trị
            </a>
            <button type="button" class="btn btn-success shadow-sm" data-bs-toggle="modal" data-bs-target="#newSessionModal">
                <i class="bi bi-plus-circle me-1"></i>+ Ghi Nhận Buổi Điều Trị
            </button>
        </div>
    </div>


    <!-- Search filter -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Sessions" class="row g-2 align-items-center">
                <div class="col-12 col-md-8">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="search" value="@Model.SearchTerm" class="form-control border-start-0" 
                               placeholder="Tìm kiếm theo tên bệnh nhân, ghi chú lâm sàng, kết quả..." />
                    </div>
                </div>
                <div class="col-12 col-md-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1">
                        <i class="bi bi-search me-1"></i>Tìm Kiếm
                    </button>
                    @if (!string.IsNullOrEmpty(Model.SearchTerm))
                    {
                        <a asp-action="Sessions" class="btn btn-outline-secondary">Đặt lại</a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Sessions Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="card-title mb-0 fw-bold text-dark">
                <i class="bi bi-journal-medical me-2 text-primary"></i>Danh Sách Buổi Điều Trị Đã Ghi Nhận (@Model.Sessions.Count buổi)
            </h5>
        </div>

        @if (Model.Sessions == null || Model.Sessions.Count == 0)
        {
            <div class="text-center py-5">
                <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px;">
                    <i class="bi bi-clipboard2-check fs-2 text-muted"></i>
                </div>
                <h5 class="fw-bold text-dark">Chưa có buổi điều trị nào</h5>
                <p class="text-muted mb-3">Chưa có nhật ký buổi điều trị lâm sàng nào được ghi nhận.</p>
                <button type="button" class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#newSessionModal">
                    <i class="bi bi-plus-circle me-1"></i>Ghi Nhận Buổi Đầu Tiên
                </button>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3" style="width: 140px;">Thời Gian</th>
                            <th>Bệnh Nhân</th>
                            <th>Giai Đoạn / Vị Trí Răng</th>
                            <th>Bác Sĩ Phụ Trách</th>
                            <th>Đánh Giá Kết Quả</th>
                            <th style="min-width: 200px;">Ghi Chú Lâm Sàng</th>
                            <th>Thủ Thuật Thực Hiện</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.Sessions)
                        {
                            <tr>
                                <td class="ps-3">
                                    <div class="fw-bold text-dark">@s.SessionDate.ToString("dd/MM/yyyy")</div>
                                    <div class="text-muted small">@s.SessionDate.ToString("HH:mm")</div>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@s.PatientName</div>
                                    <div class="text-muted small">
                                        Mã BN: <span class="badge bg-secondary bg-opacity-10 text-secondary">@s.PatientCode</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-semibold text-primary">
                                        Giai đoạn @s.PhaseSequenceNo: @(s.PhaseServiceName ?? "Thủ thuật")
                                    </div>
                                    @if (!string.IsNullOrEmpty(s.PhaseToothNumber))
                                    {
                                        <div class="badge bg-info text-dark">Răng: @s.PhaseToothNumber</div>
                                    }
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@s.DentistName</div>
                                    @if (!string.IsNullOrEmpty(s.AppointmentCode))
                                    {
                                        <div class="text-muted small">Mã ca: @s.AppointmentCode</div>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-success bg-opacity-10 text-success fw-bold px-3 py-2">
                                        <i class="bi bi-check-circle me-1"></i>@s.TreatmentResult
                                    </span>
                                </td>
                                <td>
                                    <div class="small text-muted" style="max-width: 250px;">
                                        @(string.IsNullOrEmpty(s.ClinicalNote) ? "--" : s.ClinicalNote)
                                    </div>
                                </td>
                                <td>
                                    @if (s.PerformedServices != null && s.PerformedServices.Count > 0)
                                    {
                                        <ul class="list-unstyled mb-0 small">
                                            @foreach (var ps in s.PerformedServices)
                                            {
                                                <li>
                                                    &bull; <strong>@ps.ServiceName</strong> (x@ps.Quantity): 
                                                    <span class="text-success fw-bold">@ps.Amount.ToString("N0") ₫</span>
                                                </li>
                                            }
                                        </ul>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">--</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- MODAL: GHI NHẬN BUỔI ĐIỀU TRỊ MỚI -->
<div class="modal fade" id="newSessionModal" tabindex="-1" aria-labelledby="newSessionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-action="RecordSession">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title fw-bold" id="newSessionModalLabel">
                        <i class="bi bi-clipboard2-check me-2"></i>Ghi Nhận Buổi Điều Trị Lâm Sàng
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-bold">Chọn Giai Đoạn Điều Trị / Bệnh Nhân <span class="text-danger">*</span></label>
                            <select name="TreatmentPlanItemId" class="form-select" required>
                                <option value="">-- Chọn giai đoạn cần ghi nhận --</option>
                                @foreach (var ph in Model.EligiblePhases)
                                {
                                    <option value="@ph.TreatmentPlanItemId">
                                        [#@ph.TreatmentPlanId] @ph.PatientName (@ph.PatientCode) &mdash; Giai đoạn @ph.SequenceNo: @ph.ServiceName @(string.IsNullOrEmpty(ph.ToothNumber) ? "" : $"({ph.ToothNumber})") &bull; @ph.PhaseStatus
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label fw-bold">Thời Gian Thực Hiện</label>
                            <input type="datetime-local" name="SessionDate" class="form-control" 
                                   value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" required />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label fw-bold">Kết Quả Thủ Thuật <span class="text-danger">*</span></label>
                            <select name="TreatmentResult" class="form-select" required>
                                <option value="Thành công tốt đẹp" selected>Thành công tốt đẹp</option>
                                <option value="Tiến triển thuận lợi">Tiến triển thuận lợi</option>
                                <option value="Đã xử lý / trám tạm">Đã xử lý / trám tạm</option>
                                <option value="Cần theo dõi thêm">Cần theo dõi thêm</option>
                                <option value="Phát sinh biến chứng nhẹ">Phát sinh biến chứng nhẹ</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-bold">Ghi Chú Tiến Trình Lâm Sàng (Clinical Note) <span class="text-danger">*</span></label>
                            <textarea name="ClinicalNote" class="form-control" rows="3" 
                                      placeholder="Mô tả cụ thể thao tác: gây tê, làm sạch ống tủy, lắp mắc cài, tình trạng vết thương..." required></textarea>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label fw-bold">Cập Nhật Trạng Thái Giai Đoạn</label>
                            <select name="MarkPhaseStatus" class="form-select">
                                <option value="Completed" selected>Hoàn thành giai đoạn này (Completed)</option>
                                <option value="InProgress">Đang tiếp tục (InProgress)</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-save me-1"></i>Lưu Buổi Điều Trị
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
