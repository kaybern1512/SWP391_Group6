@model DashboardViewModel
@{
    bool isImaging = ViewBag.IsImagingWorkspace == true;
    ViewData["Title"] = isImaging ? "Không Gian Chẩn Đoán Hình Ảnh" : "Không Gian Lâm Sàng Bác Sĩ";
    var activeDuty = ViewBag.ActiveDuty as DentalClinic.Web.Models.ApiDtos.XrayDentistRosterDto;
    var queueSummary = ViewBag.QueueSummary as DentalClinic.Web.Models.ApiDtos.ImagingQueueSummaryDto;
}

<div class="container-fluid p-0">
    @if (isImaging)
    {
        <!-- Header - Không gian Chẩn đoán Hình ảnh (BA Spec 4.2A) -->
        <div class="page-header-dc mb-4">
            <div>
                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                    <span class="badge bg-primary text-white px-2 py-1"><i class="bi bi-camera me-1"></i>Bác Sĩ Chẩn Đoán Hình Ảnh</span>
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                        <i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i> Phòng XRAY-01 - Carestream CS 8200 3D
                    </span>
                    <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle px-2 py-1">
                        <i class="bi bi-shield-check me-1"></i> ATBX: @(string.IsNullOrEmpty(activeDuty?.RadiationCertNumber) ? (Model.Code ?? "ATBX-2026-007") : activeDuty.RadiationCertNumber)
                    </span>
                </div>
                <h1 class="page-title">Không Gian Chẩn Đoán Hình Ảnh</h1>
                <p class="page-subtitle">@Model.Subtitle &bull; Bác sĩ phụ trách: <strong>BS. @Model.FullName</strong></p>
            </div>
            <div class="page-actions d-flex gap-2">
                <a href="@Url.Action("Dashboard", "DentistDashboard", new { mode = "clinical" })" class="btn btn-outline-secondary btn-sm" title="Chuyển sang giao diện khám lâm sàng">
                    <i class="bi bi-arrow-left-right me-1"></i> Không Gian Lâm Sàng
                </a>
                <a asp-controller="DentistXrayQueue" asp-action="Index" class="btn btn-dc-primary">
                    <i class="bi bi-camera me-1"></i> Vào Hàng Đợi Chụp X-Quang
                </a>
            </div>
        </div>

        <!-- 4 Thẻ KPI Ưu Tiên (BA Spec 4.2B) -->
        <div class="row g-3 mb-4">
            @foreach (var stat in Model.StatCards)
            {
                var targetStatus = stat.Title switch
                {
                    "Ca Chờ Chụp" => "Waiting",
                    "Đang Chụp" => "InProgress",
                    "Ảnh Chờ Đọc" => "Acquired",
                    "Kết Quả Chờ Xác Nhận" => "PendingSignature",
                    _ => ""
                };
                <div class="col-sm-6 col-xl-3">
                    <a href="@Url.Action("Index", "DentistXrayQueue", new { status = targetStatus })" class="text-decoration-none">
                        <div class="stat-card shadow-sm border hover-shadow transition">
                            <div class="stat-header">
                                <span class="stat-label text-dark fw-semibold">@stat.Title</span>
                                <div class="stat-icon-box stat-icon-@stat.ColorClass">
                                    <i class="bi @stat.Icon"></i>
                                </div>
                            </div>
                            <div>
                                <div class="stat-value text-@stat.ColorClass fw-bold fs-2">@stat.Value</div>
                                <div class="stat-note text-muted small">
                                    <i class="bi bi-info-circle"></i> @stat.Note
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>

        <!-- Thao Tác Chuyên Môn Bác Sĩ Chẩn Đoán Hình Ảnh (BA Spec 4.2D) -->
        <div class="mb-4">
            <h5 class="font-heading fs-6 fw-bold text-dark mb-3">
                <i class="bi bi-grid-fill text-primary me-2"></i>Quy Trình & Thao Tác Chẩn Đoán KTS
            </h5>
            <div class="row g-3">
                @foreach (var card in Model.Cards)
                {
                    <div class="col-md-6 col-lg-3">
                        <div class="card-quick-action text-center h-100 p-3 d-flex flex-column justify-content-between shadow-sm border">
                            <div>
                                <div class="quick-icon-box quick-icon-@card.ColorClass mx-auto mb-2">
                                    <i class="bi @card.Icon"></i>
                                </div>
                                <h6 class="fw-bold text-dark mb-1">@card.Title</h6>
                                <p class="text-muted small mb-3">@card.Description</p>
                            </div>
                            <div>
                                <a href="@card.ActionUrl" class="btn btn-light btn-sm text-primary w-100 fw-semibold border">
                                    @card.ActionText <i class="bi bi-arrow-right ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Khu Vực Hàng Đợi Trung Tâm (BA Spec 4.2C) -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 border-bottom d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-list-task text-primary fs-5"></i>
                    <h5 class="fw-bold text-dark mb-0">Hàng Đợi Chụp X-Quang Hiện Tại (Phòng XRAY-01)</h5>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <a asp-controller="DentistXrayQueue" asp-action="Index" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-box-arrow-up-right me-1"></i> Mở Toàn Bộ Hàng Đợi
                    </a>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">STT / Ca</th>
                                <th>Bệnh nhân</th>
                                <th>Chỉ định chụp</th>
                                <th>Thiết bị / Phòng</th>
                                <th>Trạng thái</th>
                                <th class="text-end pe-3">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var allSessions = new List<DentalClinic.Web.Models.ApiDtos.ImagingSessionDto>();
                                if (queueSummary?.ActiveSessions != null) allSessions.AddRange(queueSummary.ActiveSessions);
                                if (queueSummary?.WaitingQueue != null) allSessions.AddRange(queueSummary.WaitingQueue);
                            }
                            @if (allSessions.Any())
                            {
                                foreach (var session in allSessions.Take(5))
                                {
                                    <tr>
                                        <td class="ps-3">
                                            <span class="badge bg-primary fs-6">
                                                @(string.IsNullOrEmpty(session.QueueNumber) ? $"#{session.ImagingSessionId}" : session.QueueNumber)
                                            </span>
                                        </td>
                                        <td>
                                            <div class="fw-bold text-dark">@session.PatientName</div>
                                            <span class="small text-muted">Mã BN: @(session.PatientCode ?? $"PAT-{session.PatientUserId}")</span>
                                        </td>
                                        <td>
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                                @session.DiagnosticType
                                            </span>
                                        </td>
                                        <td>
                                            <div>@(session.EquipmentName ?? "Carestream CS 8200 3D")</div>
                                            <span class="small text-muted">Phòng: @(session.RoomCode ?? "XRAY-01")</span>
                                        </td>
                                        <td>
                                            @if (session.Status == "Waiting")
                                            {
                                                <span class="badge bg-warning text-dark"><i class="bi bi-clock me-1"></i>Chờ chụp</span>
                                            }
                                            else if (session.Status == "InProgress")
                                            {
                                                <span class="badge bg-info text-white"><i class="bi bi-hourglass-split me-1"></i>Đang chụp</span>
                                            }
                                            else if (session.Status == "ImageAcquired")
                                            {
                                                <span class="badge bg-teal text-white"><i class="bi bi-camera me-1"></i>Đã chụp hình</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success text-white"><i class="bi bi-check-circle me-1"></i>@session.Status</span>
                                            }
                                        </td>
                                        <td class="text-end pe-3">
                                            <a href="@Url.Action("Index", "DentistXrayQueue", new { sessionId = session.ImagingSessionId })" class="btn btn-sm btn-outline-primary">
                                                Xử lý ca <i class="bi bi-arrow-right ms-1"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-4 text-muted">
                                        <i class="bi bi-check-circle fs-3 d-block mb-1 text-success"></i>
                                        Hiện tại hàng đợi phòng chụp XRAY-01 đang trống. Thiết bị Carestream CS 8200 3D sẵn sàng tiếp nhận chỉ định mới.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Page Header - Không Gian Lâm Sàng Bác Sĩ -->
        <div class="page-header-dc">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="badge-dc badge-role-dentist">Bác Sĩ Nha Khoa</span>
                    <span class="badge-dc badge-status-confirmed">
                        <i class="bi bi-circle-fill" style="font-size: 0.5rem;"></i> Sẵn Sàng Tại Ghế
                    </span>
                    @if (!string.IsNullOrEmpty(Model.Code))
                    {
                        <span class="badge bg-white text-muted border small">Số CCHN: @Model.Code</span>
                    }
                </div>
                <h1 class="page-title">Xin chào, BS. @Model.FullName</h1>
                <p class="page-subtitle">@Model.Subtitle</p>
            </div>
            <div class="page-actions">
                <a href="@Url.Action("Dashboard", "DentistDashboard", new { mode = "imaging" })" class="btn btn-outline-primary btn-sm me-2" title="Chuyển sang không gian chẩn đoán hình ảnh X-quang">
                    <i class="bi bi-camera me-1"></i> Không Gian X-Quang
                </a>
                <a asp-controller="DentistSchedule" asp-action="Availability" class="btn btn-dc-outline">
                    <i class="bi bi-toggle-on me-1"></i> Cập Nhật Trạng Thái
                </a>
                <a asp-controller="DentistAppointment" asp-action="Today" class="btn btn-dc-primary">
                    <i class="bi bi-clipboard2-pulse me-1"></i> Tiếp Nhận Ca Khám
                </a>
            </div>
        </div>

        <!-- 4 KPI Stat Cards (No Fake Numbers) -->
        <div class="row g-3 mb-4">
            @foreach (var stat in Model.StatCards)
            {
                <div class="col-sm-6 col-xl-3">
                    <div class="stat-card">
                        <div class="stat-header">
                            <span class="stat-label">@stat.Title</span>
                            <div class="stat-icon-box stat-icon-@stat.ColorClass">
                                <i class="bi @stat.Icon"></i>
                            </div>
                        </div>
                        <div>
                            <div class="stat-value">@stat.Value</div>
                            <div class="stat-note">
                                <i class="bi bi-info-circle"></i> @stat.Note
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Quick Action Cards Section -->
        <div class="mb-4">
            <h5 class="font-heading fs-6 fw-bold text-dark mb-3">Quy Trình & Thao Tác Khám Chữa Bệnh</h5>
            <div class="row g-3">
                @foreach (var card in Model.Cards)
                {
                    <div class="col-md-6 col-lg-3">
                        <div class="card-quick-action text-center h-100 p-3 d-flex flex-column justify-content-between">
                            <div>
                                <div class="quick-icon-box quick-icon-@card.ColorClass mx-auto mb-2">
                                    <i class="bi @card.Icon"></i>
                                </div>
                                <h6 class="fw-bold text-dark mb-1">@card.Title</h6>
                                <p class="text-muted small mb-3">@card.Description</p>
                            </div>
                            <div>
                                <a href="@card.ActionUrl" class="btn btn-light btn-sm text-primary w-100 fw-semibold border">
                                    @card.ActionText <i class="bi bi-arrow-right ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Clinical Workspace: Next Patient Card + Chair Timeline -->
        <div class="row g-4">
            <!-- Next Patient in Chair Card -->
            <div class="col-lg-5">
                <div class="card-dc h-100">
                    <div class="card-dc-header">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-person-fill text-primary"></i>
                            <span>Bệnh Nhân Tiếp Theo Tại Ghế</span>
                        </div>
                        <span class="badge-dc badge-status-waiting">Đang Chờ Khám</span>
                    </div>
                    <div class="card-dc-body p-4 text-center">
                        <div class="empty-state-icon-box mb-2" style="width: 52px; height: 52px; font-size: 1.35rem;">
                            <i class="bi bi-person-slash text-muted"></i>
                        </div>
                        <h6 class="fw-bold text-dark mb-1">Ghế Khám Đang Sẵn Sàng</h6>
                        <p class="text-muted small mb-3">Chưa có bệnh nhân nào được điều phối vào ghế điều trị này. Khi lễ tân check-in tiếp đón, thông tin bệnh nhân và sơ đồ răng sẽ xuất hiện tại đây.</p>
                        <a asp-controller="DentistAppointment" asp-action="Today" class="btn btn-dc-outline btn-sm">
                            <i class="bi bi-arrow-clockwise me-1"></i> Xem Ca Khám Hôm Nay
                        </a>
                    </div>
                </div>
            </div>

            <!-- Today's Clinical Schedule Timeline -->
            <div class="col-lg-7">
                <div class="card-dc h-100">
                    <div class="card-dc-header">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-clock-history text-teal"></i>
                            <span>Lịch Trình Khám & Điều Trị Hôm Nay</span>
                        </div>
                        <span class="badge bg-light text-muted border small">Lịch Trình Trực</span>
                    </div>
                    <div class="card-dc-body p-0">
                        <partial name="_EmptyState" model="Model.EmptyState" />
                    </div>
                </div>
            </div>
        </div>
    }
</div>
