@{
    ViewData["Title"] = "Trang Chủ - Hệ Thống Quản Lý Phòng Khám Nha Khoa DentalCare";
}

<!-- Hero Section -->
<section class="py-5 bg-white border-bottom">
    <div class="container py-4">
        <div class="row align-items-center g-5">
            <div class="col-lg-7">
                <span class="badge-dc badge-role-patient mb-3">
                    <i class="bi bi-hospital"></i> Quản Lý Nha Khoa Đa Chuyên Khoa
                </span>
                <h1 class="display-5 fw-bold text-dark mb-3 lh-sm">
                    Hệ Thống Quản Lý <br />
                    <span class="text-primary">Nha Khoa Chuyên Nghiệp</span>
                </h1>
                <p class="lead text-muted mb-4 fs-6 lh-base">
                    Nền tảng số hóa hồ sơ bệnh án điện tử (EMR), sơ đồ răng chuẩn FDI, điều phối chuyển viện chuyên khoa và quản lý lịch hẹn thông minh.
                </p>
                <div class="d-flex flex-wrap gap-3">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
                        if (role == "Patient")
                        {
                            <a href="/Patient/Appointment/Book" class="btn btn-dc-primary btn-lg fs-6">
                                <i class="bi bi-calendar-plus-fill me-1"></i> Đặt Lịch Khám Ngay
                            </a>
                            <a href="#pricing" class="btn btn-outline-primary btn-lg fs-6">
                                <i class="bi bi-tags-fill me-1"></i> Xem Bảng Giá Dịch Vụ
                            </a>
                            <a href="/Patient/Dashboard" class="btn btn-dc-outline btn-lg fs-6">
                                <i class="bi bi-grid-1x2 me-1"></i> Cổng Bệnh Nhân
                            </a>
                        }
                        else
                        {
                            var dashboardAction = role switch
                            {
                                "Receptionist" => "/Receptionist/Dashboard",
                                "Dentist" => "/Dentist/Dashboard",
                                "DepartmentManager" => "/Department/Dashboard",
                                "SystemAdministrator" => "/Admin/Dashboard",
                                _ => "/Profile"
                            };
                            var roleLabel = role switch
                            {
                                "Receptionist" => "Lễ tân",
                                "Dentist" => "Bác sĩ",
                                "DepartmentManager" => "Trưởng khoa",
                                "SystemAdministrator" => "Quản trị viên",
                                _ => role
                            };
                            <a href="@dashboardAction" class="btn btn-dc-primary btn-lg fs-6">
                                <i class="bi bi-grid-1x2 me-1"></i> Bàn Làm Việc (@roleLabel)
                            </a>
                            <a href="#pricing" class="btn btn-dc-outline btn-lg fs-6">
                                <i class="bi bi-tags me-1"></i> Xem Bảng Giá Dịch Vụ
                            </a>
                        }
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Register" class="btn btn-dc-primary btn-lg fs-6">
                            <i class="bi bi-calendar-plus me-1"></i> Đăng Ký & Đặt Lịch
                        </a>
                        <a href="#pricing" class="btn btn-outline-primary btn-lg fs-6">
                            <i class="bi bi-tags me-1"></i> Xem Bảng Giá
                        </a>
                        <a asp-controller="Account" asp-action="Login" class="btn btn-dc-outline btn-lg fs-6">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Đăng Nhập
                        </a>
                    }
                </div>
            </div>
            <div class="col-lg-5">
                <div class="card-dc p-4 bg-light border">
                    <div class="d-flex align-items-center gap-3 mb-4">
                        <div class="clinic-brand-logo" style="width: 44px; height: 44px;">
                            <i class="bi bi-hospital fs-4"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-0 text-dark">Nha Khoa DentalCare</h5>
                            <span class="small text-muted">Hệ thống phòng khám đa chuyên khoa</span>
                        </div>
                    </div>
                    <ul class="list-unstyled mb-0">
                        <li class="d-flex align-items-center gap-3 mb-3">
                            <div class="stat-icon-box stat-icon-primary" style="width: 32px; height: 32px; font-size: 1rem;">
                                <i class="bi bi-check-lg"></i>
                            </div>
                            <span class="small fw-medium text-dark">Hồ sơ bệnh án nha khoa điện tử (EMR)</span>
                        </li>
                        <li class="d-flex align-items-center gap-3 mb-3">
                            <div class="stat-icon-box stat-icon-teal" style="width: 32px; height: 32px; font-size: 1rem;">
                                <i class="bi bi-check-lg"></i>
                            </div>
                            <span class="small fw-medium text-dark">Sơ đồ 32 răng theo chuẩn FDI quốc tế</span>
                        </li>
                        <li class="d-flex align-items-center gap-3 mb-3">
                            <div class="stat-icon-box stat-icon-info" style="width: 32px; height: 32px; font-size: 1rem;">
                                <i class="bi bi-check-lg"></i>
                            </div>
                            <span class="small fw-medium text-dark">Phác đồ điều trị đa giai đoạn & đơn thuốc điện tử</span>
                        </li>
                        <li class="d-flex align-items-center gap-3">
                            <div class="stat-icon-box stat-icon-success" style="width: 32px; height: 32px; font-size: 1rem;">
                                <i class="bi bi-check-lg"></i>
                            </div>
                            <span class="small fw-medium text-dark">Điều phối chuyển chuyên khoa và hội chẩn thuận tiện</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Specialties Section -->
<section id="specialties" class="py-5">
    <div class="container py-3">
        <div class="text-center mx-auto mb-5" style="max-width: 650px;">
            <span class="badge-dc badge-role-patient mb-2">Hệ Thống 4 Chuyên Khoa Lâm Sàng</span>
            <h2 class="fw-bold text-dark">Các Chuyên Khoa Điều Trị Chuẩn Y Khoa</h2>
            <p class="text-muted">Mỗi khoa được vận hành chuyên biệt bởi Trưởng khoa và đội ngũ bác sĩ chuyên sâu cùng hệ thống trang thiết bị hiện đại.</p>
        </div>

        <div class="row g-4">
            <!-- Khoa 1 -->
            <div class="col-md-6 col-lg-3">
                <div class="card-dc h-100 p-4 d-flex flex-column justify-content-between">
                    <div>
                        <div class="quick-icon-box quick-icon-primary mb-3">
                            <i class="bi bi-shield-check"></i>
                        </div>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle mb-2">Khoa 1</span>
                        <h5 class="fw-bold text-dark mb-2">Răng Tổng Quát & Nội Nha</h5>
                        <p class="text-muted small mb-3">
                            Khám nha khoa định kỳ, lấy cao răng siêu âm, trám răng Composite Nano và chữa tủy bảo tồn răng thật bằng trâm xoay WaveOne.
                        </p>
                    </div>
                    <div>
                        <a href="#pricing-tabs" class="text-primary small fw-bold text-decoration-none" onclick="activatePricingTab('tab-dept-1')">
                            Xem biểu giá Khoa 1 <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Khoa 2 -->
            <div class="col-md-6 col-lg-3">
                <div class="card-dc h-100 p-4 d-flex flex-column justify-content-between">
                    <div>
                        <div class="quick-icon-box quick-icon-warning mb-3">
                            <i class="bi bi-gem"></i>
                        </div>
                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle mb-2">Khoa 2</span>
                        <h5 class="fw-bold text-dark mb-2">Chỉnh Nha & Thẩm Mỹ</h5>
                        <p class="text-muted small mb-3">
                            Niềng răng mắc cài kim loại & sứ, khay niềng trong suốt Invisalign 3D, dán sứ Veneer Emax, bọc sứ Cercon HT và tẩy trắng Laser.
                        </p>
                    </div>
                    <div>
                        <a href="#pricing-tabs" class="text-warning small fw-bold text-decoration-none" onclick="activatePricingTab('tab-dept-2')">
                            Xem biểu giá Khoa 2 <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Khoa 3 -->
            <div class="col-md-6 col-lg-3">
                <div class="card-dc h-100 p-4 d-flex flex-column justify-content-between">
                    <div>
                        <div class="quick-icon-box quick-icon-info mb-3">
                            <i class="bi bi-heart-pulse"></i>
                        </div>
                        <span class="badge bg-info-subtle text-info border border-info-subtle mb-2">Khoa 3</span>
                        <h5 class="fw-bold text-dark mb-2">Phẫu Thuật & Implant</h5>
                        <p class="text-muted small mb-3">
                            Cấy ghép trụ Implant Thụy Sĩ/Hàn Quốc, nhổ răng khôn sóng siêu âm Piezotome không đau, ghép xương nâng xoang và cắt chóp nạo nang.
                        </p>
                    </div>
                    <div>
                        <a href="#pricing-tabs" class="text-info small fw-bold text-decoration-none" onclick="activatePricingTab('tab-dept-3')">
                            Xem biểu giá Khoa 3 <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Khoa 4 -->
            <div class="col-md-6 col-lg-3">
                <div class="card-dc h-100 p-4 d-flex flex-column justify-content-between">
                    <div>
                        <div class="quick-icon-box quick-icon-success mb-3">
                            <i class="bi bi-emoji-smile"></i>
                        </div>
                        <span class="badge bg-success-subtle text-success border border-success-subtle mb-2">Khoa 4</span>
                        <h5 class="fw-bold text-dark mb-2">Khoa Răng Trẻ Em</h5>
                        <p class="text-muted small mb-3">
                            Khám và bôi vecni fluor ngừa sâu, trám răng sữa bio, nhổ răng sữa êm ái với thuốc tê hương trái cây, chụp thép SSC và tiền chỉnh nha Trainer.
                        </p>
                    </div>
                    <div>
                        <a href="#pricing-tabs" class="text-success small fw-bold text-decoration-none" onclick="activatePricingTab('tab-dept-4')">
                            Xem biểu giá Khoa 4 <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Pricing Section (Bảng Giá Dịch Vụ Niêm Yết Theo Từng Khoa) -->
<section id="pricing" class="py-5 bg-light border-top border-bottom">
    <div class="container py-3">
        <div class="text-center mx-auto mb-5" style="max-width: 750px;">
            <span class="badge-dc badge-role-patient mb-2">Bảng Giá Công Khai & Minh Bạch</span>
            <h2 class="fw-bold text-dark">Bảng Giá Dịch Vụ Niêm Yết Của Từng Chuyên Khoa</h2>
            <p class="text-muted">
                Cam kết chi phí minh bạch 100%, phân định rõ ràng theo từng chuyên khoa phụ trách, không phát sinh chi phí phụ.
            </p>
        </div>

        <!-- 4 Overview Department Cards -->
        <div class="row g-4 mb-5">
            <!-- Khoa 1 Card -->
            <div class="col-md-6 col-lg-3">
                <div class="card-dc h-100 p-4 bg-white border rounded-3 shadow-sm d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div class="quick-icon-box quick-icon-primary">
                                <i class="bi bi-shield-check"></i>
                            </div>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Khoa 1</span>
                        </div>
                        <h5 class="fw-bold text-dark mb-1">Răng Tổng Quát & Nội Nha</h5>
                        <p class="text-muted small mb-3">7 dịch vụ kỹ thuật chuẩn hóa</p>
                        <div class="mb-3 pb-3 border-bottom">
                            <span class="fs-4 fw-bold text-primary">Từ 100.000 đ</span>
                            <span class="text-muted small">/ dịch vụ</span>
                        </div>
                        <ul class="list-unstyled small text-muted mb-4">
                            <li class="d-flex align-items-start gap-2 mb-2">
                                <i class="bi bi-check-circle-fill text-success pt-1"></i>
                                <span>Khám tổng quát & Lập hồ sơ răng (100.000 đ)</span>
                            </li>
                            <li class="d-flex align-items-start gap-2 mb-2">
                                <i class="bi bi-check-circle-fill text-success pt-1"></i>
                                <span>Lấy cao răng & Đánh bóng siêu âm (250.000 đ)</span>
                            </li>
                            <li class="d-flex align-items-start gap-2 mb-2">
                                <i class="bi bi-check-circle-fill text-success pt-1"></i>
                                <span>Trám răng Composite Nano (400.000 đ)</span>
                            </li>
                            <li class="d-flex align-items-start gap-2">
                                <i class="bi bi-check-circle-fill text-success pt-1"></i>
                                <span>Điều trị tủy WaveOne (1.200.000 - 1.800.000 đ)</span>
                            </li>
                        </ul>
                    </div>
                    <div>
                        <a href="/Patient/Appointment/Book" class="btn btn-outline-primary w-100 fw-semibold">
                            Đặt Lịch Khoa 1
                        </a>
                    </div>
                </div>
            </div>

            <!-- Khoa 2 Card -->
            <div class="col-md-6 col-lg-3">
                <div class="card-dc h-100 p-4 bg-white border border-warning border-2 rounded-3 shadow d-flex flex-column justify-content-between position-relative">
                    <div class="position-absolute top-0 start-50 translate-middle">
                        <span class="badge bg-warning text-dark px-3 py-1 shadow-sm fw-bold">Thẩm Mỹ Nụ Cười</span>
                    </div>
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-3 mt-1">
                            <div class="quick-icon-box quick-icon-warning">
                                <i class="bi bi-gem"></i>
                            </div>
                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Khoa 2</span>
                        </div>
                        <h5 class="fw-bold text-dark mb-1">Chỉnh Nha & Thẩm Mỹ</h5>
                        <p class="text-muted small mb-3">8 dịch vụ nụ cười toàn diện</p>
                        <div class="mb-3 pb-3 border-bottom">
                            <span class="fs-4 fw-bold text-warning-emphasis">Từ 300.000 đ</span>
                            <span class="text-muted small">/ dịch vụ</span>
                        </div>
                        <ul class="list-unstyled small text-muted mb-4">
                            <li class="d-flex align-items-start gap-2 mb-2">
                                <i class="bi bi-check-circle-fill text-success pt-1"></i>
                                <span>Tẩy trắng Laser Whitening (2.000.000 đ)</span>
                            </li>
                            <li class="d-flex align-items-start gap-2 mb-2">
                                <i class="bi bi-check-circle-fill text-success pt-1"></i>
                                <span>Niềng răng mắc cài kim loại (25.000.000 đ)</span>
                            </li>
                            <li class="d-flex align-items-start gap-2 mb-2">
                                <i class="bi bi-check-circle-fill text-success pt-1"></i>
                                <span>Niềng trong suốt Invisalign (65.000.000 đ)</span>
                            </li>
                            <li class="d-flex align-items-start gap-2">
                                <i class="bi bi-check-circle-fill text-success pt-1"></i>
                                <span>Dán sứ Veneer Emax / Cercon HT (từ 4.500.000 đ)</span>
                            </li>
                        </ul>
                    </div>
                    <div>
                        <a href="/Patient/Appointment/Book" class="btn btn-warning w-100 fw-bold shadow-sm">
                            Đặt Lịch Khoa 2
                        </a>
                    </div>
                </div>
            </div>

            <!-- Khoa 3 Card -->
            <div class="col-md-6 col-lg-3">
                <div class="card-dc h-100 p-4 bg-white border border-info border-2 rounded-3 shadow d-flex flex-column justify-content-between position-relative">
                    <div class="position-absolute top-0 start-50 translate-middle">
                        <span class="badge bg-info text-white px-3 py-1 shadow-sm fw-bold">Công Nghệ Cao</span>
                    </div>
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-3 mt-1">
                            <div class="quick-icon-box quick-icon-info">
                                <i class="bi bi-heart-pulse"></i>
                            </div>
                            <span class="badge bg-info-subtle text-info border border-info-subtle">Khoa 3</span>
                        </div>
                        <h5 class="fw-bold text-dark mb-1">Phẫu Thuật & Implant</h5>
                        <p class="text-muted small mb-3">9 dịch vụ tiểu phẫu chuyên sâu</p>
                        <div class="mb-3 pb-3 border-bottom">
                            <span class="fs-4 fw-bold text-info">Từ 500.000 đ</span>
                            <span class="text-muted small">/ dịch vụ</span>
                        </div>
                        <ul class="list-unstyled small text-muted mb-4">
                            <li class="d-flex align-items-start gap-2 mb-2">
                                <i class="bi bi-check-circle-fill text-success pt-1"></i>
                                <span>Nhổ răng khôn sóng Piezotome (1.800.000 - 2.500.000 đ)</span>
                            </li>
                            <li class="d-flex align-items-start gap-2 mb-2">
                                <i class="bi bi-check-circle-fill text-success pt-1"></i>
                                <span>Implant Dentium Hàn Quốc (14.000.000 đ)</span>
                            </li>
                            <li class="d-flex align-items-start gap-2 mb-2">
                                <i class="bi bi-check-circle-fill text-success pt-1"></i>
                                <span>Implant Straumann Thụy Sĩ (28.000.000 đ)</span>
                            </li>
                            <li class="d-flex align-items-start gap-2">
                                <i class="bi bi-check-circle-fill text-success pt-1"></i>
                                <span>Ghép xương & Nâng xoang hàm (8.000.000 đ)</span>
                            </li>
                        </ul>
                    </div>
                    <div>
                        <a href="/Patient/Appointment/Book" class="btn btn-info text-white w-100 fw-bold shadow-sm">
                            Đặt Lịch Khoa 3
                        </a>
                    </div>
                </div>
            </div>

            <!-- Khoa 4 Card -->
            <div class="col-md-6 col-lg-3">
                <div class="card-dc h-100 p-4 bg-white border rounded-3 shadow-sm d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div class="quick-icon-box quick-icon-success">
                                <i class="bi bi-emoji-smile"></i>
                            </div>
                            <span class="badge bg-success-subtle text-success border border-success-subtle">Khoa 4</span>
                        </div>
                        <h5 class="fw-bold text-dark mb-1">Khoa Răng Trẻ Em</h5>
                        <p class="text-muted small mb-3">7 dịch vụ dịu nhẹ cho bé</p>
                        <div class="mb-3 pb-3 border-bottom">
                            <span class="fs-4 fw-bold text-success">Từ 100.000 đ</span>
                            <span class="text-muted small">/ dịch vụ</span>
                        </div>
                        <ul class="list-unstyled small text-muted mb-4">
                            <li class="d-flex align-items-start gap-2 mb-2">
                                <i class="bi bi-check-circle-fill text-success pt-1"></i>
                                <span>Nhổ răng sữa vô cảm không đau (100.000 đ)</span>
                            </li>
                            <li class="d-flex align-items-start gap-2 mb-2">
                                <i class="bi bi-check-circle-fill text-success pt-1"></i>
                                <span>Khám & Bôi Flour ngừa sâu răng (150.000 đ)</span>
                            </li>
                            <li class="d-flex align-items-start gap-2 mb-2">
                                <i class="bi bi-check-circle-fill text-success pt-1"></i>
                                <span>Trám răng sữa Composite Bio (200.000 đ)</span>
                            </li>
                            <li class="d-flex align-items-start gap-2">
                                <i class="bi bi-check-circle-fill text-success pt-1"></i>
                                <span>Chữa tủy & Chụp thép SSC (850.000 đ)</span>
                            </li>
                        </ul>
                    </div>
                    <div>
                        <a href="/Patient/Appointment/Book" class="btn btn-outline-success w-100 fw-semibold">
                            Đặt Lịch Khoa 4
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- BẢNG BIỂU GIÁ CHI TIẾT THEO TỪNG KHOA (TABBED PRICING TABLE) -->
        <div id="pricing-tabs" class="card border-0 shadow-sm rounded-4 overflow-hidden mb-5">
            <div class="card-header bg-white p-4 border-bottom">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <div>
                        <h4 class="fw-bold text-dark mb-1">
                            <i class="bi bi-receipt-cutoff text-primary me-2"></i>Tra Cứu Bảng Giá Chi Tiết Theo Chuyên Khoa
                        </h4>
                        <p class="text-muted small mb-0">Chọn chuyên khoa bên dưới để xem toàn bộ danh mục dịch vụ kỹ thuật, thời lượng thực hiện và mức giá niêm yết</p>
                    </div>
                    <ul class="nav nav-pills" id="deptPricingTab" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active fw-semibold" id="tab-dept-1" data-bs-toggle="pill" data-bs-target="#pane-dept-1" type="button" role="tab">
                                <i class="bi bi-shield-check me-1"></i> Khoa 1: Răng Tổng Quát
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link fw-semibold" id="tab-dept-2" data-bs-toggle="pill" data-bs-target="#pane-dept-2" type="button" role="tab">
                                <i class="bi bi-gem me-1"></i> Khoa 2: Chỉnh Nha & Thẩm Mỹ
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link fw-semibold" id="tab-dept-3" data-bs-toggle="pill" data-bs-target="#pane-dept-3" type="button" role="tab">
                                <i class="bi bi-heart-pulse me-1"></i> Khoa 3: Phẫu Thuật & Implant
                            </button>
