<script>
    function switchHomeVideo(videoId, title, desc, btnEl) {
        var frame = document.getElementById('home3dVideoFrame');
        if (frame) {
            frame.src = 'https://www.youtube.com/embed/' + videoId + '?autoplay=1';
        }
        var titleEl = document.getElementById('home3dVideoTitle');
        if (titleEl) titleEl.innerText = title;
        var descEl = document.getElementById('home3dVideoDesc');
        if (descEl) descEl.innerText = desc;

        document.querySelectorAll('.video-selector-btn').forEach(function(b) {
            b.classList.remove('active');
        });
        if (btnEl) btnEl.classList.add('active');
    }

    window.switchAboutTab = function(tabKey) {
        var tabBtnId = 'tab-clinic-btn';
        if (tabKey === 'tab-doctors' || tabKey === '#about-doctors') tabBtnId = 'tab-doctors-btn';
        else if (tabKey === 'tab-blog' || tabKey === '#about-blog') tabBtnId = 'tab-blog-btn';

        var tabBtn = document.getElementById(tabBtnId);
        if (tabBtn && window.bootstrap && window.bootstrap.Tab) {
            var tabObj = new bootstrap.Tab(tabBtn);
            tabObj.show();
        } else if (tabBtn) {
            tabBtn.click();
        }

        var targetSection = document.getElementById('about-intro');
        if (targetSection) {
            targetSection.scrollIntoView({ behavior: 'smooth' });
        }
    };

    document.addEventListener('DOMContentLoaded', function() {
        var hash = window.location.hash;
        if (hash === '#about-clinic' || hash === '#about-doctors' || hash === '#about-blog' || hash === '#about-intro') {
            if (hash === '#about-doctors') {
                window.switchAboutTab('tab-doctors');
            } else if (hash === '#about-blog') {
                window.switchAboutTab('tab-blog');
            } else {
                window.switchAboutTab('tab-clinic');
            }
        }
    });
</script>

