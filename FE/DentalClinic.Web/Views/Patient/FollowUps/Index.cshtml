@model DentalClinic.Web.ViewModels.PostCare.PatientFollowUpIndexViewModel
@{
    ViewData["Title"] = "Lịch Hẹn Tái Khám Của Tôi";
    var today = DateTime.Today;
}

<div class="container-fluid px-0">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-calendar-heart me-2 text-primary"></i>Lịch Hẹn Tái Khám Của Tôi
            </h1>
            <p class="text-muted mb-0">Theo dõi các mốc hẹn tái khám do bác sĩ điều trị chỉ định và gửi yêu cầu dời/đặt lại lịch khi cần thiết.</p>
        </div>
        <div>
            <a asp-controller="PatientAppointment" asp-action="Book" class="btn btn-primary shadow-sm">
                <i class="bi bi-calendar-plus me-1"></i>Đặt Lịch Khám Mới
            </a>
        </div>
    </div>

    <!-- Alert Advice -->
    <div class="alert alert-primary bg-primary-subtle border-0 shadow-sm d-flex align-items-center mb-4 p-3 rounded-3">
        <i class="bi bi-info-circle-fill text-primary fs-3 me-3"></i>
        <div>
            <span class="fw-bold text-primary">Lời dặn từ Bác Sĩ Nha Khoa:</span>
            <span class="text-dark"> Việc tái khám đúng thời hạn giúp phát hiện sớm các phản ứng bất thường, cắt chỉ, kiểm tra khớp cắn và đảm bảo hiệu quả điều trị phục hồi toàn diện. Nếu bận việc đột xuất, bạn có thể gửi yêu cầu đổi lịch để bác sĩ xem xét xếp lại giờ phù hợp.</span>
        </div>
    </div>

    <!-- Change Proposals Section (Day 04) -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="card-title fw-bold mb-0 text-dark">
                <i class="bi bi-arrow-left-right me-2 text-warning"></i>Yêu Cầu Thay Đổi Lịch Hẹn (Đổi Lịch / Đặt Lại Lịch)
            </h5>
            <span class="badge bg-light text-dark border">@(Model.Proposals?.Count ?? 0) yêu cầu</span>
        </div>
        <div class="card-body p-0">
            @if (Model.Proposals == null || Model.Proposals.Count == 0)
            {
                <div class="text-center py-4">
                    <i class="bi bi-inbox text-muted fs-3 mb-2 d-block"></i>
                    <p class="text-muted small mb-0">Bạn chưa gửi yêu cầu thay đổi lịch hẹn nào. Khi cần đổi hoặc đặt lại lịch tái khám, bấm nút thao tác bên dưới.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Mã Yêu Cầu</th>
                                <th>Lịch Hẹn Gốc</th>
                                <th>Bác Sĩ Phụ Trách</th>
                                <th>Loại & Giờ Đề Xuất</th>
                                <th>Lý Do Thay Đổi</th>
                                <th>Trạng Thái</th>
                                <th class="pe-4 text-end">Thao Tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.Proposals)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold font-monospace text-primary">#REQ-@p.ProposalId</td>
                                    <td>
                                        <div class="fw-bold text-dark font-monospace">@p.AppointmentCode</div>
                                        <div class="small text-muted">
                                            @(p.CurrentStart.HasValue ? p.CurrentStart.Value.ToString("dd/MM/yyyy HH:mm") : "--")
                                        </div>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark"><i class="bi bi-person-badge text-success me-1"></i>BS. @p.DentistName</div>
                                        <div class="small text-muted">@p.DepartmentName</div>
                                    </td>
                                    <td>
                                        @if (p.IsRebook)
                                        {
                                            <span class="badge bg-warning text-dark mb-1"><i class="bi bi-calendar2-plus me-1"></i>Đặt Lại Lịch</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info text-dark mb-1"><i class="bi bi-arrow-repeat me-1"></i>Đổi Lịch</span>
                                        }
                                        <div class="fw-bold text-success fs-6">
                                            @(p.ProposedStart.HasValue ? p.ProposedStart.Value.ToString("dd/MM/yyyy HH:mm") : "--")
                                        </div>
                                    </td>
                                    <td>
                                        <div class="text-dark small text-truncate" style="max-width: 240px;" title="@p.Reason">@p.Reason</div>
                                        <div class="text-muted small">Gửi lúc: @p.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                                    </td>
                                    <td>
                                        @switch (p.Status)
                                        {
                                            case "Pending":
                                                <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i>Chờ Bác Sĩ Duyệt</span>
                                                break;
                                            case "Accepted":
                                                <span class="badge bg-success"><i class="bi bi-check2-circle me-1"></i>Đã Chấp Thuận</span>
                                                break;
                                            case "Rejected":
                                                <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Bị Từ Chối</span>
                                                break;
                                            case "Expired":
                                                <span class="badge bg-secondary"><i class="bi bi-dash-circle me-1"></i>Đã Thu Hồi</span>
                                                break;
                                            default:
                                                <span class="badge bg-light text-dark border">@p.Status</span>
                                                break;
                                        }
                                    </td>
                                    <td class="pe-4 text-end">
                                        @if (p.Status == "Pending")
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger" onclick="handleWithdrawProposal(@p.ProposalId)">
                                                <i class="bi bi-x-lg me-1"></i>Rút Yêu Cầu
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Đã xong</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- List of Follow-up Schedules -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="card-title fw-bold mb-0 text-dark">
                <i class="bi bi-clock-history me-2 text-primary"></i>Danh Sách Lịch Hẹn Tái Khám (@(Model.FollowUps?.Count ?? 0))
            </h5>
        </div>
        <div class="card-body p-0">
            @if (Model.FollowUps == null || Model.FollowUps.Count == 0)
            {
                <div class="text-center py-5">
                    <i class="bi bi-calendar-heart display-4 text-muted mb-3 d-block"></i>
                    <h6 class="fw-bold text-muted">Bạn chưa có lịch hẹn tái khám nào</h6>
                    <p class="text-muted small">Sau khi hoàn thành các buổi điều trị tại phòng khám, bác sĩ sẽ lên lịch hẹn tái khám nếu cần thiết.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Mã Chỉ Định</th>
                                <th>Chuyên Khoa & Bác Sĩ</th>
                                <th>Ngày Dự Kiến Tái Khám</th>
                                <th>Nội Dung Chỉ Định</th>
                                <th>Cuộc Hẹn Liên Kết</th>
                                <th>Trạng Thái</th>
                                <th class="pe-4 text-end">Thao Tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var f in Model.FollowUps)
                            {
                                var daysDiff = (f.RecommendedDate.Date - today).Days;
                                var isUpcoming = daysDiff >= 0;
                                <tr>
                                    <td class="ps-4 fw-bold text-primary font-monospace">#FUP-@f.FollowUpId</td>
                                    <td>
                                        <div class="fw-bold text-dark">@f.DepartmentName</div>
                                        <div class="small text-muted"><i class="bi bi-person me-1"></i>BS. @f.DentistName</div>
                                    </td>
                                    <td>
                                        <div class="fw-bold @(isUpcoming ? "text-primary fs-6" : "text-muted")">
                                            <i class="bi bi-calendar-event me-1"></i>@f.RecommendedDate.ToString("dd/MM/yyyy")
                                        </div>
                                        @if (f.Status == "Pending" || f.Status == "Confirmed")
                                        {
                                            if (daysDiff < 0)
                                            {
                                                <span class="badge bg-danger text-white">Quá hạn @Math.Abs(daysDiff) ngày</span>
                                            }
                                            else if (daysDiff == 0)
                                            {
                                                <span class="badge bg-warning text-dark fw-bold">Hôm nay</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-info-subtle text-info border">Còn @daysDiff ngày</span>
                                            }
                                        }
                                    </td>
                                    <td>
                                        <span class="text-dark small">@f.Reason</span>
                                    </td>
                                    <td>
@if (f.AppointmentId.HasValue && !string.IsNullOrWhiteSpace(f.AppointmentCode))
                                        {
                                            <div class="fw-bold font-monospace text-primary">@f.AppointmentCode</div>
                                            <a asp-controller="PatientAppointment" asp-action="Detail" asp-route-id="@f.AppointmentId" class="small text-decoration-none">
                                                <i class="bi bi-eye me-1"></i>Xem chi tiết
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Chưa xếp lịch</span>
                                        }
                                    </td>
                                    <td>
                                        @if (f.Status == "Completed")
                                        {
                                            <span class="badge bg-success"><i class="bi bi-check2-circle me-1"></i>Đã tái khám</span>
                                        }
                                        else if (f.Status == "Confirmed")
                                        {
                                            <span class="badge bg-primary text-white"><i class="bi bi-check-circle me-1"></i>Đã xác nhận đến</span>
                                        }
                                        else if (f.Status == "Scheduled")
                                        {
                                            <span class="badge bg-info text-white"><i class="bi bi-calendar-check me-1"></i>Đã lên lịch</span>
                                        }
                                        else if (daysDiff < 0)
                                        {
                                            <span class="badge bg-danger"><i class="bi bi-exclamation-triangle-fill me-1"></i>Quá hạn</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i>Chờ tái khám</span>
                                        }
                                    </td>
                                    <td class="pe-4 text-end">
                                        @if (f.Status == "Completed")
                                        {
                                            <span class="text-muted small"><i class="bi bi-check-all text-success me-1"></i>Hoàn thành</span>
                                        }
                                        else if (f.AppointmentId.HasValue)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-warning text-dark fw-semibold"
                                                    onclick="openProposalModal(@f.AppointmentId.Value, '@f.AppointmentCode', @f.DentistUserId, '@f.DentistName', '@f.DepartmentName', '@f.RecommendedDate.ToString("yyyy-MM-dd")', false)">
                                                <i class="bi bi-arrow-repeat me-1"></i>Đổi Lịch
                                            </button>
                                        }
                                        else
                                        {
                                            <a asp-controller="PatientAppointment" asp-action="Book" 
                                               asp-route-departmentId="@f.DepartmentId" 
                                               asp-route-dentistId="@f.DentistUserId" 
                                               asp-route-date="@f.RecommendedDate.ToString("yyyy-MM-dd")" 
                                               asp-route-reason="@($"Tái khám định kỳ theo chỉ định: {f.Reason}")"
                                               class="btn btn-sm btn-primary fw-semibold shadow-sm">
                                                <i class="bi bi-calendar2-check me-1"></i>1-Click Đặt Lịch
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal Yêu Cầu Đổi / Đặt Lại Lịch Tái Khám (Day 04) -->
<div class="modal fade" id="modalPatientProposal" tabindex="-1" aria-labelledby="modalPatientProposalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white py-3" id="proposalModalHeader">
                <h5 class="modal-title fw-bold" id="modalPatientProposalLabel">
                    <i class="bi bi-calendar-range-fill me-2"></i>Yêu Cầu Thay Đổi Lịch Tái Khám
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="formPatientProposal" onsubmit="return handleProposalSubmit(event);">
                @Html.AntiForgeryToken()
                <input type="hidden" id="proposalAppointmentId" name="AppointmentId" value="" />
                <input type="hidden" id="proposalDentistUserId" value="" />
                <input type="hidden" id="proposalIsRebook" name="IsRebook" value="false" />
                <input type="hidden" id="proposalSelectedStart" name="ProposedStart" value="" />
                <input type="hidden" id="proposalSelectedEnd" name="ProposedEnd" value="" />

                <div class="modal-body p-4">
                    <!-- Context Alert -->
                    <div class="row g-3 p-3 bg-light rounded-3 mb-4 border">
                        <div class="col-md-6">
                            <label class="small text-muted mb-1 d-block"><i class="bi bi-bookmark-fill text-primary me-1"></i>Mã cuộc hẹn gốc:</label>
                            <div class="fw-bold font-monospace fs-6 text-dark" id="proposalDisplayApptCode">--</div>
                            <div class="small text-muted" id="proposalDisplayDepartment">Chuyên khoa: --</div>
                        </div>
                        <div class="col-md-6">
                            <label class="small text-muted mb-1 d-block"><i class="bi bi-person-badge-fill text-success me-1"></i>Bác sĩ phụ trách:</label>
                            <div class="fw-bold fs-6 text-dark" id="proposalDisplayDentist">BS. --</div>
                            <div class="small text-muted" id="proposalDisplayTypeBadge"><span class="badge bg-info text-dark">Yêu cầu đổi lịch</span></div>
                        </div>
                    </div>

                    <!-- Date & Duration Selection -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-dark">
                                <i class="bi bi-calendar-event me-1 text-primary"></i>Chọn ngày đề xuất mới: <span class="text-danger">*</span>
                            </label>
                            <input type="date" id="proposalDateInput" class="form-control"
                                   min="@(DateTime.Today.ToString("yyyy-MM-dd"))"
                                   onchange="loadProposalSlots();" required />
                            <div class="form-text small text-muted">Vui lòng chọn ngày mong muốn tái khám để hệ thống tìm giờ trống của bác sĩ.</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-dark">
                                <i class="bi bi-hourglass-split me-1 text-primary"></i>Thời lượng dự kiến:
                            </label>
                            <select id="proposalDurationSelect" class="form-select" onchange="loadProposalSlots();">
                                <option value="30" selected>30 phút (Tái khám / Kiểm tra tiêu chuẩn)</option>
                                <option value="45">45 phút (Chỉnh nha / Kiểm tra khớp cắn)</option>
                                <option value="60">60 phút (Điều trị tủy bước tiếp theo)</option>
                            </select>
                        </div>
                    </div>

                    <!-- Available Slots Grid -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold text-dark d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-clock me-1 text-primary"></i>Khung giờ trống khả dụng của Bác sĩ: <span class="text-danger">*</span></span>
                            <span id="proposalSlotBadge" class="badge bg-light text-muted border">Chọn ngày để xem giờ</span>
                        </label>

                        <!-- Spinner -->
                        <div id="proposalSlotsSpinner" class="text-center py-4 bg-light rounded-3 d-none">
                            <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                            <span class="small text-muted">Đang tải khung giờ trống khả dụng...</span>
                        </div>

                        <!-- Slots Grid -->
                        <div id="proposalSlotsGrid" class="d-flex flex-wrap gap-2 p-3 bg-light rounded-3 border" style="min-height: 80px; max-height: 180px; overflow-y: auto;">
                            <div class="text-muted small w-100 text-center py-3">Vui lòng chọn ngày phía trên để xem các khung giờ làm việc còn trống của bác sĩ.</div>
                        </div>
                    </div>

                    <!-- Reason Textarea -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-dark">
                            <i class="bi bi-chat-left-quote me-1 text-primary"></i>Lý do yêu cầu thay đổi: <span class="text-danger">*</span>
                        </label>
                        <textarea id="proposalReasonInput" class="form-control" rows="3" required
                                  placeholder="Ví dụ: Bận việc đột xuất vào giờ hẹn cũ, xin dời sang khung giờ mới để tiện việc điều trị..."></textarea>
                        <div class="form-text small text-muted">Bác sĩ điều trị sẽ trực tiếp xem xét lý do và phản hồi chấp thuận hoặc từ chối yêu cầu.</div>
                    </div>

                    <!-- Alert message container -->
                    <div id="proposalAlertMessage" class="alert d-none py-2 px-3 small rounded-3 mb-0"></div>
                </div>

                <div class="modal-footer bg-light py-2">
                    <button type="button" class="btn btn-secondary px-3" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" id="btnSubmitProposal" class="btn btn-primary fw-bold px-4" disabled>
                        <span id="btnSubmitProposalText"><i class="bi bi-send-fill me-1"></i>Gửi Yêu Cầu</span>
                        <span id="btnSubmitProposalSpinner" class="spinner-border spinner-border-sm d-none" role="status"></span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let currentProposalModal = null;

    document.addEventListener('DOMContentLoaded', () => {
        const modalEl = document.getElementById('modalPatientProposal');
        if (modalEl) {
            currentProposalModal = new bootstrap.Modal(modalEl);
        }
    });

    function openProposalModal(appointmentId, appointmentCode, dentistUserId, dentistName, departmentName, defaultDate, isRebook) {
        document.getElementById('proposalAppointmentId').value = appointmentId;
        document.getElementById('proposalDentistUserId').value = dentistUserId;
        document.getElementById('proposalIsRebook').value = isRebook ? 'true' : 'false';
        document.getElementById('proposalSelectedStart').value = '';
        document.getElementById('proposalSelectedEnd').value = '';

        document.getElementById('proposalDisplayApptCode').textContent = appointmentCode || ('APT-' + appointmentId);
        document.getElementById('proposalDisplayDentist').textContent = 'BS. ' + (dentistName || 'Bác sĩ điều trị');
        document.getElementById('proposalDisplayDepartment').textContent = 'Chuyên khoa: ' + (departmentName || 'Nha khoa');

        const titleEl = document.getElementById('modalPatientProposalLabel');
        const badgeEl = document.getElementById('proposalDisplayTypeBadge');
        const headerEl = document.getElementById('proposalModalHeader');

        if (isRebook) {
            titleEl.innerHTML = '<i class="bi bi-calendar2-plus-fill me-2"></i>Yêu Cầu Đặt Lại Lịch Tái Khám Đã Hủy/Bỏ Lỡ';
            badgeEl.innerHTML = '<span class="badge bg-warning text-dark"><i class="bi bi-calendar2-plus me-1"></i>Đặt lại lịch mới</span>';
            headerEl.className = 'modal-header bg-warning text-dark py-3';
        } else {
            titleEl.innerHTML = '<i class="bi bi-arrow-repeat me-2"></i>Yêu Cầu Đổi Lịch Hẹn Tái Khám';
            badgeEl.innerHTML = '<span class="badge bg-info text-dark"><i class="bi bi-arrow-repeat me-1"></i>Đổi lịch</span>';
            headerEl.className = 'modal-header bg-primary text-white py-3';
        }

        const dateInput = document.getElementById('proposalDateInput');
        const tomorrow = new Date();
        tomorrow.setDate(tomorrow.getDate() + 1);
        const yyyy = tomorrow.getFullYear();
        const mm = String(tomorrow.getMonth() + 1).padStart(2, '0');
        const dd = String(tomorrow.getDate()).padStart(2, '0');
        dateInput.value = `${yyyy}-${mm}-${dd}`;

        document.getElementById('proposalReasonInput').value = '';
        document.getElementById('proposalAlertMessage').className = 'alert d-none py-2 px-3 small rounded-3 mb-0';
        document.getElementById('btnSubmitProposal').disabled = true;

        if (currentProposalModal) {
            currentProposalModal.show();
        }

        loadProposalSlots();
    }

    async function loadProposalSlots() {
        const dentistUserId = document.getElementById('proposalDentistUserId').value;
        const dateVal = document.getElementById('proposalDateInput').value;
        const duration = document.getElementById('proposalDurationSelect').value || 30;

        const grid = document.getElementById('proposalSlotsGrid');
        const spinner = document.getElementById('proposalSlotsSpinner');
        const badge = document.getElementById('proposalSlotBadge');
        const submitBtn = document.getElementById('btnSubmitProposal');

        document.getElementById('proposalSelectedStart').value = '';
        document.getElementById('proposalSelectedEnd').value = '';
        submitBtn.disabled = true;

        if (!dentistUserId || !dateVal) {
            grid.innerHTML = '<div class="text-muted small w-100 text-center py-3">Vui lòng chọn ngày phía trên.</div>';
            badge.className = 'badge bg-light text-muted border';
            badge.textContent = 'Chưa chọn ngày';
            return;
        }

        grid.classList.add('d-none');
        spinner.classList.remove('d-none');
        badge.className = 'badge bg-warning-subtle text-warning border';
        badge.textContent = 'Đang tải...';

        try {
            const res = await fetch(`/Patient/FollowUps/AvailableSlots?dentistUserId=${dentistUserId}&date=${dateVal}&durationMinutes=${duration}`);
            const slots = await res.json();

            spinner.classList.add('d-none');
            grid.classList.remove('d-none');

            if (!Array.isArray(slots) || slots.length === 0) {
                grid.innerHTML = '<div class="text-danger small w-100 text-center py-3"><i class="bi bi-exclamation-circle me-1"></i>Bác sĩ không có lịch trống vào ngày này (hoặc đã kín lịch). Vui lòng chọn ngày khác.</div>';
                badge.className = 'badge bg-danger-subtle text-danger border';
                badge.textContent = '0 slot trống';
                return;
            }

            badge.className = 'badge bg-success-subtle text-success border';
            badge.textContent = `${slots.length} slot khả dụng`;

            let html = '';
            slots.forEach(slot => {
                const sDate = new Date(slot.startTime);
                const eDate = new Date(slot.endTime);
                const sTime = sDate.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit', hour12: false });
                const eTime = eDate.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit', hour12: false });
                html += `
                    <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3 py-1 fw-semibold slot-btn"
                            onclick="selectProposalSlot(this, '${slot.startTime}', '${slot.endTime}')">
                        <i class="bi bi-clock me-1"></i>${sTime} - ${eTime}
                    </button>
                `;
            });
            grid.innerHTML = html;
        } catch (err) {
            console.error(err);
            spinner.classList.add('d-none');
            grid.classList.remove('d-none');
            grid.innerHTML = '<div class="text-danger small w-100 text-center py-3">Lỗi khi tải danh sách giờ trống. Vui lòng thử lại.</div>';
            badge.className = 'badge bg-danger-subtle text-danger border';
            badge.textContent = 'Lỗi tải slot';
        }
    }

    function selectProposalSlot(btn, startIso, endIso) {
        document.querySelectorAll('#proposalSlotsGrid .slot-btn').forEach(b => {
            b.classList.remove('btn-primary', 'text-white');
            b.classList.add('btn-outline-primary');
        });

        btn.classList.remove('btn-outline-primary');
        btn.classList.add('btn-primary', 'text-white');

        document.getElementById('proposalSelectedStart').value = startIso;
        document.getElementById('proposalSelectedEnd').value = endIso;

        const reason = document.getElementById('proposalReasonInput').value.trim();
        document.getElementById('btnSubmitProposal').disabled = false;
    }

    async function handleProposalSubmit(e) {
        e.preventDefault();

        const appointmentId = parseInt(document.getElementById('proposalAppointmentId').value);
        const proposedStart = document.getElementById('proposalSelectedStart').value;
        const proposedEnd = document.getElementById('proposalSelectedEnd').value;
        const isRebook = document.getElementById('proposalIsRebook').value === 'true';
        const reason = document.getElementById('proposalReasonInput').value.trim();

        const alertBox = document.getElementById('proposalAlertMessage');
        const submitBtn = document.getElementById('btnSubmitProposal');
        const btnText = document.getElementById('btnSubmitProposalText');
        const btnSpinner = document.getElementById('btnSubmitProposalSpinner');

        if (!proposedStart || !proposedEnd) {
            alertBox.className = 'alert alert-danger py-2 px-3 small rounded-3 mb-0';
            alertBox.textContent = 'Vui lòng bấm chọn một khung giờ trống khả dụng trên lưới.';
            return false;
        }

        if (!reason) {
            alertBox.className = 'alert alert-danger py-2 px-3 small rounded-3 mb-0';
            alertBox.textContent = 'Vui lòng nhập lý do thay đổi lịch.';
            return false;
        }

        submitBtn.disabled = true;
        btnText.classList.add('d-none');
        btnSpinner.classList.remove('d-none');
        alertBox.className = 'alert d-none';

        const token = document.querySelector('#formPatientProposal input[name="__RequestVerificationToken"]')?.value;

        try {
            const res = await fetch('/Patient/FollowUps/SubmitProposal', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token || ''
                },
                body: JSON.stringify({
                    appointmentId: appointmentId,
                    proposedStart: proposedStart,
                    proposedEnd: proposedEnd,
                    reason: reason,
                    isRebook: isRebook
                })
            });

            const data = await res.json();

            if (res.ok && data.success) {
                alertBox.className = 'alert alert-success py-2 px-3 small rounded-3 mb-0';
                alertBox.textContent = data.message || 'Gửi yêu cầu thay đổi lịch thành công! Đang tải lại...';
                setTimeout(() => {
                    window.location.reload();
                }, 1200);
            } else {
                alertBox.className = 'alert alert-danger py-2 px-3 small rounded-3 mb-0';
                alertBox.textContent = data.message || 'Có lỗi xảy ra khi gửi yêu cầu.';
                submitBtn.disabled = false;
                btnText.classList.remove('d-none');
                btnSpinner.classList.add('d-none');
            }
        } catch (err) {
            console.error(err);
            alertBox.className = 'alert alert-danger py-2 px-3 small rounded-3 mb-0';
            alertBox.textContent = 'Lỗi kết nối máy chủ. Vui lòng kiểm tra lại mạng.';
            submitBtn.disabled = false;
            btnText.classList.remove('d-none');
            btnSpinner.classList.add('d-none');
        }

        return false;
    }

    async function handleWithdrawProposal(proposalId) {
        if (!confirm('Bạn có chắc chắn muốn rút lại yêu cầu thay đổi lịch hẹn này?')) {
            return;
        }

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

        try {
            const res = await fetch(`/Patient/FollowUps/WithdrawProposal/${proposalId}`, {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': token || ''
                }
            });

            const data = await res.json();
            if (res.ok && data.success) {
                alert(data.message || 'Đã rút yêu cầu thành công.');
                window.location.reload();
            } else {
                alert(data.message || 'Không thể rút yêu cầu.');
            }
        } catch (err) {
            console.error(err);
            alert('Lỗi kết nối khi gửi yêu cầu rút lịch.');
        }
    }
</script>
}
