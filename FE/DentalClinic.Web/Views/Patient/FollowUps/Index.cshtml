@model DentalClinic.Web.ViewModels.PostCare.PatientFollowUpsViewModel
@{
    ViewData["Title"] = "Lịch Khuyến Nghị Tái Khám";
}

<div class="container-fluid p-0">
    <!-- Page Header -->
    <div class="page-header-dc mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge-dc badge-role-patient">Bệnh Nhân</span>
                <span class="badge bg-white text-muted border small">Chăm Sóc Sau Điều Trị</span>
            </div>
            <h1 class="page-title">Lịch Hẹn Tái Khám Khuyến Nghị</h1>
            <p class="page-subtitle">Theo dõi các lịch hẹn tái khám được Bác sĩ đề xuất để đảm bảo kết quả phục hồi răng miệng tối ưu.</p>
        </div>
        <div class="page-actions">
            <a asp-controller="PatientAppointment" asp-action="Book" class="btn btn-primary">
                <i class="bi bi-calendar-check me-1"></i> Đặt Lịch Khám Mới
            </a>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2" role="alert">
            <i class="bi bi-check-circle-fill fs-5"></i>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
            <div>@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- FollowUps List -->
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="font-heading fs-6 fw-bold mb-0 text-dark">
                <i class="bi bi-calendar-event text-primary me-2"></i>Danh Sách Lịch Tái Khám
            </h5>
            <span class="badge bg-light text-muted border">Tổng cộng: @Model.FollowUps.Count lịch hẹn</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Ngày Tái Khám Đề Xuất</th>
                        <th>Chuyên Khoa</th>
                        <th>Bác Sĩ Khuyến Nghị</th>
                        <th>Nội Dung / Lý Do Tái Khám</th>
                        <th>Trạng Thái</th>
                        <th>Lịch Hẹn Liên Kết</th>
                        <th class="text-end pe-3">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.FollowUps.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-calendar-check fs-1 d-block mb-2 text-success"></i>
                                Bạn hiện không có lịch hẹn tái khám nào cần theo dõi.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.FollowUps)
                        {
                            <tr>
                                <td class="ps-3">
                                    <div class="fw-bold text-dark fs-6">
                                        <i class="bi bi-clock-history me-1 text-primary"></i>
                                        @item.RecommendedDate.ToString("dd/MM/yyyy")
                                    </div>
                                    <div class="small text-muted">
                                        @if (item.RecommendedDate.Date >= DateTime.UtcNow.Date)
                                        {
                                            var daysLeft = (item.RecommendedDate.Date - DateTime.UtcNow.Date).Days;
                                            <span class="text-primary fw-medium">(Còn @daysLeft ngày)</span>
                                        }
                                        else
                                        {
                                            <span class="text-secondary">(Đã qua hạn đề xuất)</span>
                                        }
                                    </div>
                                </td>
                                <td><span class="badge bg-light text-dark border">@item.DepartmentName</span></td>
                                <td>
                                    <div class="fw-semibold text-dark">BS. @item.DentistName</div>
                                </td>
                                <td style="max-width: 280px;">
                                    <div class="text-dark small">@(item.Reason ?? "Theo dõi phục hồi sau điều trị")</div>
                                </td>
                                <td>
                                    @switch (item.Status)
                                    {
                                        case "Pending":
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">
                                                <i class="bi bi-hourglass-split me-1"></i>Chờ đặt hẹn
                                            </span>
                                            break;
                                        case "Scheduled":
                                            <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle">
                                                <i class="bi bi-check2-circle me-1"></i>Đã xếp lịch
                                            </span>
                                            break;
                                        case "Completed":
                                            <span class="badge bg-info-subtle text-info border border-info-subtle">
                                                <i class="bi bi-check-all me-1"></i>Đã tái khám
                                            </span>
                                            break;
                                        case "Cancelled":
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                                <i class="bi bi-x-circle me-1"></i>Đã hủy
                                            </span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary">@item.Status</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.AppointmentCode))
                                    {
                                        <div class="small fw-semibold text-primary">@item.AppointmentCode</div>
                                        @if (item.AppointmentDate.HasValue)
                                        {
                                            <div class="small text-muted">@item.AppointmentDate.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted small"><em>Chưa liên kết lịch hẹn</em></span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    @if (item.Status == "Pending")
                                    {
                                        <div class="d-inline-flex gap-1">
                                            <a asp-controller="PatientAppointment" asp-action="Book" class="btn btn-sm btn-primary">
                                                <i class="bi bi-calendar-check me-1"></i>Đặt Lịch
                                            </a>
                                            @if (Model.MyAppointments.Any())
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#linkModal" data-followup-id="@item.FollowUpId">
                                                    <i class="bi bi-link-45deg me-1"></i>Gắn Lịch
                                                </button>
                                            }
                                            <form asp-action="Cancel" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn hủy khuyến nghị tái khám này không?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="followUpId" value="@item.FollowUpId" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Hủy nhắc hẹn">
                                                    <i class="bi bi-x-lg"></i>
                                                </button>
                                            </form>
                                        </div>
                                    }
                                    else if (item.Status == "Scheduled" && item.AppointmentId.HasValue)
                                    {
                                        <a asp-controller="PatientAppointment" asp-action="Detail" asp-route-id="@item.AppointmentId.Value" class="btn btn-sm btn-outline-secondary">
                                            <i class="bi bi-eye me-1"></i>Xem Lịch Hẹn
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Gắn Lịch Hẹn Đã Đặt -->
<div class="modal fade" id="linkModal" tabindex="-1" aria-labelledby="linkModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form asp-action="LinkAppointment" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="followUpId" id="linkFollowUpId" value="0" />
                <div class="modal-header bg-light">
                    <h5 class="modal-title font-heading" id="linkModalLabel">
                        <i class="bi bi-link-45deg text-primary me-2"></i>Liên Kết Lịch Hẹn Đã Đặt
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="text-muted small mb-3">Chọn một lịch hẹn hợp lệ bạn đã đặt thành công để liên kết với kế hoạch tái khám này:</p>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Lịch Hẹn Của Bạn <span class="text-danger">*</span></label>
                        <select name="appointmentId" class="form-select" required>
                            <option value="">-- Chọn lịch hẹn đã đặt --</option>
                            @foreach (var appt in Model.MyAppointments)
                            {
                                <option value="@appt.AppointmentId">@appt.AppointmentCode - @appt.DepartmentName (@(appt.ScheduledStart?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Chưa định ngày")) - @appt.Status</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary px-4">Xác nhận liên kết</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var linkModal = document.getElementById('linkModal');
        if (linkModal) {
            linkModal.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                var followUpId = button.getAttribute('data-followup-id');
                document.getElementById('linkFollowUpId').value = followUpId;
            });
        }
    </script>
}
