@model DentalClinic.Web.ViewModels.PostCare.PatientFollowUpIndexViewModel
@{
    ViewData["Title"] = "Lịch Hẹn Tái Khám Của Tôi";
    var today = DateTime.Today;
}

<div class="container-fluid px-0">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-calendar-heart me-2 text-primary"></i>Lịch Hẹn Tái Khám Của Tôi
            </h1>
            <p class="text-muted mb-0">Theo dõi các mốc hẹn tái khám do bác sĩ điều trị chỉ định để bảo đảm sức khỏe răng miệng tốt nhất.</p>
        </div>
        <div>
            <a asp-controller="PatientAppointment" asp-action="Book" class="btn btn-primary shadow-sm">
                <i class="bi bi-calendar-plus me-1"></i>Đặt Lịch Khám Mới
            </a>
        </div>
    </div>

    <!-- Alert Advice -->
    <div class="alert alert-primary bg-primary-subtle border-0 shadow-sm d-flex align-items-center mb-4 p-3 rounded-3">
        <i class="bi bi-info-circle-fill text-primary fs-3 me-3"></i>
        <div>
            <span class="fw-bold text-primary">Lời dặn từ Bác Sĩ Nha Khoa:</span>
            <span class="text-dark"> Việc tái khám đúng thời hạn giúp phát hiện sớm các phản ứng bất thường, cắt chỉ, kiểm tra khớp cắn và đảm bảo hiệu quả điều trị phục hồi toàn diện.</span>
        </div>
    </div>

    <!-- List of Follow-up Schedules -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="card-title fw-bold mb-0 text-dark">
                <i class="bi bi-clock-history me-2 text-primary"></i>Danh Sách Lịch Hẹn Tái Khám (@(Model.FollowUps?.Count ?? 0))
            </h5>
        </div>
        <div class="card-body p-0">
            @if (Model.FollowUps == null || Model.FollowUps.Count == 0)
            {
                <div class="text-center py-5">
                    <i class="bi bi-calendar-heart display-4 text-muted mb-3 d-block"></i>
                    <h6 class="fw-bold text-muted">Bạn chưa có lịch hẹn tái khám nào</h6>
                    <p class="text-muted small">Sau khi hoàn thành các buổi điều trị tại phòng khám, bác sĩ sẽ lên lịch hẹn tái khám nếu cần thiết.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Mã Hẹn</th>
                                <th>Chuyên Khoa & Bác Sĩ</th>
                                <th>Ngày Dự Kiến Tái Khám</th>
                                <th>Nội Dung Chỉ Định</th>
                                <th>Trạng Thái</th>
                                <th class="pe-4 text-end">Thao Tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var f in Model.FollowUps)
                            {
                                var daysDiff = (f.RecommendedDate.Date - today).Days;
                                var isUpcoming = daysDiff >= 0;
                                <tr>
                                    <td class="ps-4 fw-bold text-primary">#FUP-@f.FollowUpId</td>
                                    <td>
                                        <div class="fw-bold text-dark">@f.DepartmentName</div>
                                        <div class="small text-muted"><i class="bi bi-person me-1"></i>BS. @f.DentistName</div>
                                    </td>
                                    <td>
                                        <div class="fw-bold @(isUpcoming ? "text-primary fs-6" : "text-muted")">
                                            <i class="bi bi-calendar-event me-1"></i>@f.RecommendedDate.ToString("dd/MM/yyyy")
                                        </div>
                                        @if (f.Status == "Pending" || f.Status == "Confirmed")
                                        {
                                            if (daysDiff < 0)
                                            {
                                                <span class="badge bg-danger text-white">Quá hạn @Math.Abs(daysDiff) ngày</span>
                                            }
                                            else if (daysDiff == 0)
                                            {
                                                <span class="badge bg-warning text-dark fw-bold">Hôm nay</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-info-subtle text-info border">Còn @daysDiff ngày</span>
                                            }
                                        }
                                    </td>
                                    <td>
                                        <span class="text-dark small">@f.Reason</span>
                                    </td>
                                    <td>
                                        @if (f.Status == "Confirmed")
                                        {
                                            <span class="badge bg-primary text-white"><i class="bi bi-check-circle me-1"></i>Đã xác nhận đến</span>
                                        }
                                        else if (f.Status == "Completed")
                                        {
                                            <span class="badge bg-success"><i class="bi bi-check2-circle me-1"></i>Đã tái khám</span>
                                        }
                                        else if (daysDiff < 0)
                                        {
                                            <span class="badge bg-danger"><i class="bi bi-exclamation-triangle-fill me-1"></i>Quá hạn</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i>Chờ tái khám</span>
                                        }
                                    </td>
                                    <td class="pe-4 text-end">
                                        @if (f.Status != "Completed")
                                        {
                                            <a asp-controller="PatientAppointment" asp-action="Book" 
                                               asp-route-departmentId="@f.DepartmentId" 
                                               asp-route-dentistId="@f.DentistUserId" 
                                               asp-route-date="@f.RecommendedDate.ToString("yyyy-MM-dd")" 
                                               asp-route-reason="@($"Tái khám định kỳ theo chỉ định: {f.Reason}")"
                                               class="btn btn-sm btn-primary fw-semibold shadow-sm">
                                                <i class="bi bi-calendar2-check me-1"></i>1-Click Đặt Lịch
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted small"><i class="bi bi-check-all text-success me-1"></i>Hoàn thành</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
