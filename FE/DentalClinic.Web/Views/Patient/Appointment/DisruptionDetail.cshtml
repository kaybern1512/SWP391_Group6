@model DentalClinic.Web.ViewModels.Appointments.PatientDisruptionViewModel
@{
    ViewData["Title"] = "Điều Phối Lịch Hẹn - Bác Sĩ Nghỉ Phép";
    var d = Model.Disruption;
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="PatientDashboard" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-controller="PatientAppointment" asp-action="Index">Lịch hẹn của tôi</a></li>
            <li class="breadcrumb-item active" aria-current="page">Xử lý gián đoạn lịch hẹn #@d.AppointmentCode</li>
        </ol>
    </nav>

    <!-- Disruption Notice Hero Banner -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden border-start border-5 border-warning bg-white">
        <div class="card-body p-4">
            <div class="d-flex align-items-start gap-3">
                <div class="bg-warning-subtle text-warning p-3 rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 56px; height: 56px;">
                    <i class="bi bi-exclamation-triangle-fill fs-3"></i>
                </div>
                <div class="flex-grow-1">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                        <span class="badge bg-warning text-dark px-3 py-1 fw-bold fs-12">
                            <i class="bi bi-clock-history me-1"></i> Bác Sĩ Xin Nghỉ Phép
                        </span>
                        <span class="text-muted small">Mã sự cố: #@d.DisruptionId</span>
                    </div>
                    <h3 class="fw-bold text-slate-800 mb-2">Thông Báo Điều Phối Lịch Khám Nha Khoa</h3>
                    <p class="text-secondary mb-3">
                        Kính gửi Quý khách <strong>@d.PatientName</strong>, bác sĩ <strong>@d.OriginalDentistName</strong> phụ trách lịch hẹn khám của Quý khách đã có lịch nghỉ phép đột xuất / công tác trong khung giờ này. Nha khoa DentalCare xin gửi lời xin lỗi chân thành về sự bất tiện này.
                    </p>
                    <div class="p-3 bg-light rounded-3 border">
                        <div class="row g-3">
                            <div class="col-md-3">
                                <div class="text-muted small">Mã Lịch Hẹn</div>
                                <div class="fw-bold text-primary">#@d.AppointmentCode</div>
                            </div>
                            <div class="col-md-3">
                                <div class="text-muted small">Dịch Vụ Khám</div>
                                <div class="fw-bold text-dark">@d.ServiceName</div>
                            </div>
                            <div class="col-md-3">
                                <div class="text-muted small">Thời Gian Ban Đầu</div>
                                <div class="fw-bold text-dark">@d.ScheduledStart.ToString("HH:mm - dd/MM/yyyy")</div>
                            </div>
                            <div class="col-md-3">
                                <div class="text-muted small">Chuyên Khoa</div>
                                <div class="fw-bold text-dark">@d.DepartmentName</div>
                            </div>
                        </div>
                    </div>
                    <div class="mt-3 small text-success fw-medium">
                        <i class="bi bi-shield-check me-1"></i>
                        Mọi quyền lợi, kết quả chẩn đoán và khoản tiền cọc (nếu có) của Quý khách đều được hệ thống bảo lưu an toàn 100%. Quý khách vui lòng chọn một trong hai phương án thuận tiện bên dưới:
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Options Section -->
    <div class="row g-4">
        <!-- OPTION 1: CHỌN BÁC SĨ THAY THẾ (GIỮ NGUYÊN GIỜ KHÁM) -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-header bg-white py-3 border-bottom d-flex align-items-center gap-2">
                    <span class="badge bg-primary rounded-circle p-2 px-3 fw-bold">1</span>
                    <h5 class="fw-bold text-slate-800 mb-0">Giữ Nguyên Giờ Khám - Đổi Bác Sĩ Cùng Khoa</h5>
                </div>
                <div class="card-body p-4 d-flex flex-column">
                    <p class="text-muted small mb-3">
                        Quý khách vẫn đến khám đúng thời gian <strong>@d.ScheduledStart.ToString("HH:mm - dd/MM/yyyy")</strong>. Hệ thống tự động gợi ý các bác sĩ nha khoa cùng chuyên khoa <em>@d.DepartmentName</em> đang có lịch trực sẵn sàng:
                    </p>

                    @if (Model.AlternativeDentists == null || !Model.AlternativeDentists.Any())
                    {
                        <div class="alert alert-light border py-3 text-muted text-center my-auto">
                            <i class="bi bi-person-x fs-2 text-secondary mb-2 d-block"></i>
                            <div>Hiện tại trong khung giờ này chưa có bác sĩ cùng chuyên khoa trống lịch trực tiếp. Quý khách vui lòng chọn <strong>Phương Án 2 (Dời lịch)</strong> hoặc liên hệ hotline để được lễ tân ưu tiên điều phối.</div>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-3 mb-4 flex-grow-1">
                            @foreach (var alt in Model.AlternativeDentists)
                            {
                                <div class="border rounded-3 p-3 bg-light-subtle d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="fw-bold text-dark fs-15">
                                            <i class="bi bi-person-check-fill text-success me-1"></i>
                                            @alt.FullName
                                        </div>
                                        <div class="text-muted small">
                                            <span>Mã BS: @(alt.EmployeeCode ?? "—")</span> &bull; 
                                            <span>@alt.Specialization</span>
                                        </div>
                                        <div class="text-secondary small mt-1">
                                            <i class="bi bi-clock me-1"></i>Trực rảnh: @alt.AvailableStart.ToString("HH:mm") - @alt.AvailableEnd.ToString("HH:mm")
                                        </div>
                                    </div>
                                    <div>
                                        <form asp-action="ChooseAlternativeDentist" asp-route-id="@d.DisruptionId" method="post" onsubmit="return confirm('Xác nhận chọn Bác sĩ @alt.FullName phụ trách lịch khám của bạn?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="newDentistUserId" value="@alt.DentistUserId" />
                                            <input type="hidden" name="actionToken" value="@Model.ActionToken" />
                                            <button type="submit" class="btn btn-outline-primary btn-sm fw-semibold px-3 py-2">
                                                <i class="bi bi-check2 me-1"></i> Chọn Bác Sĩ Này
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    <div class="mt-auto pt-3 border-top text-muted small">
                        <i class="bi bi-info-circle me-1"></i>
                        Hệ thống sẽ cập nhật bác sĩ phụ trách ngay lập tức. Số thứ tự khám tại phòng khám sẽ được cấp tự động theo ngày khi Quý khách đến làm thủ tục Check-in.
                    </div>
                </div>
            </div>
        </div>

        <!-- OPTION 2: GIỮ BÁC SĨ PHỤ TRÁCH - DỜI SANG NGÀY GIỜ KHÁC -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-header bg-white py-3 border-bottom d-flex align-items-center gap-2">
                    <span class="badge bg-success rounded-circle p-2 px-3 fw-bold">2</span>
                    <h5 class="fw-bold text-slate-800 mb-0">Giữ Bác Sĩ @d.OriginalDentistName - Dời Lịch</h5>
                </div>
                <div class="card-body p-4 d-flex flex-column">
                    <p class="text-muted small mb-3">
                        Nếu Quý khách mong muốn tiếp tục điều trị với bác sĩ <strong>@d.OriginalDentistName</strong>, vui lòng chọn ngày và giờ mới thuận tiện sau thời gian nghỉ phép của bác sĩ:
                    </p>

                    <form asp-action="RescheduleDisruption" asp-route-id="@d.DisruptionId" method="post" class="flex-grow-1 d-flex flex-column" onsubmit="return confirm('Xác nhận dời lịch hẹn khám sang thời gian đã chọn?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="actionToken" value="@Model.ActionToken" />
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-dark">Thời Gian Khám Mới Mong Muốn <span class="text-danger">*</span></label>
                            <input type="datetime-local" name="newScheduledStart" class="form-control form-control-lg fs-15" 
                                   value="@d.ScheduledStart.AddDays(2).ToString("yyyy-MM-ddTHH:mm")" required />
                            <div class="form-text text-muted">Vui lòng chọn ngày giờ làm việc từ Thứ Hai đến Chủ Nhật (07:00 - 21:00). Số thứ tự khám cũ sẽ được làm mới khi Check-in vào ngày khám mới.</div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-dark">Ghi Chú Cho Lễ Tân & Bác Sĩ (Không bắt buộc)</label>
                            <textarea name="reason" class="form-control" rows="3" placeholder="Ví dụ: Mong muốn khám buổi sáng, kiểm tra thêm răng ê buốt..."></textarea>
                        </div>

                        <div class="mt-auto pt-3 border-top">
                            <button type="submit" class="btn btn-success w-100 py-2 fw-semibold fs-15">
                                <i class="bi bi-calendar-check me-2"></i> Xác Nhận Dời Lịch Khám Mới
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Need Immediate Assistance Hotline Banner -->
    <div class="card border-0 shadow-sm rounded-4 mt-4 bg-light">
        <div class="card-body p-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="bg-primary-subtle text-primary p-3 rounded-circle">
                    <i class="bi bi-telephone-inbound-fill fs-4"></i>
                </div>
                <div>
                    <h6 class="fw-bold text-slate-800 mb-1">Cần Hỗ Trợ Điều Phối Gấp Qua Điện Thoại?</h6>
                    <div class="text-muted small">Đội ngũ lễ tân DentalCare luôn sẵn sàng hỗ trợ sắp xếp lịch khám ưu tiên cho Quý khách.</div>
                </div>
            </div>
            <div class="d-flex align-items-center gap-3">
                <a href="tel:19001234" class="btn btn-primary px-4 py-2 fw-bold">
                    <i class="bi bi-telephone me-1"></i> Hotline: 1900 1234
                </a>
                <a asp-action="Index" class="btn btn-outline-secondary px-3 py-2">
                    Quay lại danh sách
                </a>
            </div>
        </div>
    </div>
</div>
