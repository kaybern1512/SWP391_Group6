</div>

<style>
/* Stepper Styles */
.stepper-wrapper {
    position: relative;
    padding: 0 10px;
}
.step-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    z-index: 2;
    cursor: pointer;
    min-width: 80px;
}
.step-circle {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background-color: #f1f5f9;
    color: #64748b;
    border: 2px solid #e2e8f0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    margin-bottom: 6px;
    transition: all 0.25s ease;
}
.step-label {
    font-size: 0.82rem;
    font-weight: 600;
    color: #64748b;
    white-space: nowrap;
}
.step-item.active .step-circle {
    background-color: #0d6efd;
    border-color: #0d6efd;
    color: #fff;
    box-shadow: 0 0 0 4px rgba(13, 110, 253, 0.2);
}
.step-item.active .step-label {
    color: #0d6efd;
}
.step-item.completed .step-circle {
    background-color: #198754;
    border-color: #198754;
    color: #fff;
}
.step-line {
    flex-grow: 1;
    height: 3px;
    background-color: #e2e8f0;
    margin: 0 8px;
    position: relative;
    top: -16px;
    z-index: 1;
}

/* Card Selection */
.selection-card {
    border: 2px solid #e2e8f0;
    border-radius: 12px;
    cursor: pointer;
    transition: all 0.2s ease-in-out;
    background-color: #fff;
}
.selection-card:hover {
    border-color: #93c5fd;
    box-shadow: 0 4px 12px rgba(13, 110, 253, 0.08);
    transform: translateY(-2px);
}
.selection-card.active {
    border-color: #0d6efd !important;
    background-color: #eff6ff !important;
    box-shadow: 0 0 0 1px #0d6efd;
}

.selection-icon {
    width: 48px;
    height: 48px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
}

/* Slot button */
.slot-btn {
    border: 2px solid #e2e8f0;
    background-color: #fff;
    border-radius: 10px;
    padding: 12px;
    text-align: center;
    cursor: pointer;
    transition: all 0.2s ease;
}
.slot-btn:hover {
    border-color: #0d6efd;
    background-color: #f8faff;
    transform: translateY(-2px);
}
.slot-btn.active {
    border-color: #198754 !important;
    background-color: #d1e7dd !important;
    box-shadow: 0 0 0 2px #198754;
}

.quick-chip {
    transition: all 0.15s ease;
    border-color: #cbd5e1;
    background-color: #fff;
    color: #334155;
}
.quick-chip:hover {
    background-color: #e0f2fe;
    border-color: #0284c7;
    color: #0369a1;
}
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        let currentStep = 1;
        let selectedService = { id: 0, name: '', deptId: 0, deptName: '', duration: 30, price: '', isComplex: false };
        let selectedDentist = { id: null, name: 'Bất kỳ bác sĩ khả dụng' };
        let selectedSlot = null;

        function formatDayOfWeek(dateStr) {
            if (!dateStr) return '';
            const parts = dateStr.split('-');
            if (parts.length !== 3) return dateStr;
            const d = new Date(parseInt(parts[0]), parseInt(parts[1]) - 1, parseInt(parts[2]));
            const days = ['Chủ Nhật', 'Thứ Hai', 'Thứ Ba', 'Thứ Tư', 'Thứ Năm', 'Thứ Sáu', 'Thứ Bảy'];
            const dayName = days[d.getDay()];
            return `${dayName}, ${parts[2]}/${parts[1]}/${parts[0]}`;
        }

        function onSideActionClick() {
            if (currentStep < 5) {
                goToStep(currentStep + 1);
            } else if (currentStep === 5) {
                const btnSubmit = document.getElementById('btnSubmitBooking');
                if (btnSubmit) btnSubmit.click();
            }
        }

        function goToStep(step) {
            if (step > currentStep) {
                if (currentStep === 1 && selectedService.id === 0) {
                    if (window.toastWarning) {
                        window.toastWarning('Vui lòng chọn một dịch vụ nha khoa để tiếp tục.', 'Yêu Cầu Chọn');
                    } else {
                        alert('Vui lòng chọn một dịch vụ nha khoa để tiếp tục.');
                    }
                    return;
                }
                if (currentStep === 2) {
                    const dateVal = document.getElementById('inputAppointmentDate').value;
                    if (!dateVal) {
                        alert('Vui lòng chọn ngày bạn muốn đến khám.');
                        return;
                    }
                }
                if (currentStep === 3 && !selectedSlot) {
                    if (window.toastWarning) {
                        window.toastWarning('Vui lòng chọn một khung giờ hẹn còn trống để tiếp tục.', 'Yêu Cầu Chọn');
                    } else {
                        alert('Vui lòng chọn một khung giờ hẹn còn trống để tiếp tục.');
                    }
                    return;
                }
                if (currentStep === 4) {
                    const reason = document.getElementById('inputReasonForVisit').value.trim();
                    const reasonError = document.getElementById('reasonErrorMsg');
                    const reasonInput = document.getElementById('inputReasonForVisit');
                    if (reason.length < 5) {
                        if (reasonError) reasonError.classList.remove('d-none');
                        if (reasonInput) {
                            reasonInput.classList.add('is-invalid');
                            reasonInput.focus();
                        }
                        return;
                    }
                    if (reasonError) reasonError.classList.add('d-none');
                    if (reasonInput) reasonInput.classList.remove('is-invalid');
                    updateSummary();
                }
            }

            for (let i = 1; i <= 5; i++) {
                const panel = document.getElementById(`step-panel-${i}`);
                if (panel) panel.classList.add('d-none');
                const nav = document.getElementById(`step-nav-${i}`);
                if (nav) {
                    nav.classList.remove('active');
                    if (i < step) {
                        nav.classList.add('completed');
                    } else {
                        nav.classList.remove('completed');
                    }
                }
            }

            const currentPanel = document.getElementById(`step-panel-${step}`);
            if (currentPanel) currentPanel.classList.remove('d-none');
            const currentNav = document.getElementById(`step-nav-${step}`);
            if (currentNav) currentNav.classList.add('active');

            currentStep = step;
            updateSidePanel();

            if (step === 3) {
                loadSlots();
            } else if (step === 4) {
                renderDynamicServiceGuidance();
            } else if (step === 5) {
                updateSummary();
            }

            window.scrollTo({ top: 120, behavior: 'smooth' });
        }

        // BƯỚC 1: Chọn dịch vụ & Tự động gán Khoa (Service-First)
        function selectService(id, name, deptId, deptName, cardElem, duration, price, isComplex) {
            selectedService = { 
                id, 
                name, 
                deptId, 
                deptName, 
                duration: duration || 30, 
                price: price || 'Liên hệ',
                isComplex: isComplex === true || isComplex === 'true'
            };

            document.getElementById('hiddenServiceId').value = id;
            document.getElementById('hiddenDepartmentId').value = deptId;

            // Highlight card
            document.querySelectorAll('#servicesGrid .service-card').forEach(c => c.classList.remove('active'));
            if (cardElem) cardElem.classList.add('active');

            // Banner thông báo Bước 1
            const alertBox = document.getElementById('serviceSelectedAlert');
            if (alertBox) {
                alertBox.classList.remove('d-none');
                document.getElementById('alertServiceName').innerText = name;
                document.getElementById('alertDeptName').innerText = deptName;
                document.getElementById('alertServiceDuration').innerText = `${selectedService.duration} phút`;
                document.getElementById('alertServicePrice').innerText = selectedService.price;
            }

            // Cập nhật thông tin cho Bước 2
            document.getElementById('panel2ServiceName').innerText = name;
            document.getElementById('panel2DeptName').innerText = deptName;
            document.getElementById('panel2ServiceDuration').innerText = `${selectedService.duration} phút`;
            document.getElementById('panel2ServicePrice').innerText = selectedService.price;

            // Kích hoạt nút Next Bước 1
            document.getElementById('btnNext1').disabled = false;

            updateSidePanel();
            loadDentists(deptId);
        }

        // BƯỚC 1: Lọc dịch vụ theo từ khóa & Chuyên khoa
        function filterServices() {
            const query = (document.getElementById('serviceSearchInput').value || '').trim().toLowerCase();
            const deptFilter = parseInt(document.getElementById('deptFilterSelect').value) || 0;

            let visibleCount = 0;
            document.querySelectorAll('#servicesGrid .service-item').forEach(item => {
                const name = (item.getAttribute('data-name') || '').toLowerCase();
                const deptName = (item.getAttribute('data-dept-name') || '').toLowerCase();
                const deptId = parseInt(item.getAttribute('data-dept-id')) || 0;

                const matchQuery = !query || name.includes(query) || deptName.includes(query);
                const matchDept = deptFilter === 0 || deptId === deptFilter;

                if (matchQuery && matchDept) {
                    item.style.display = '';
                    visibleCount++;
                } else {
                    item.style.display = 'none';
                }
            });

            const badge = document.getElementById('badgeServiceCount');
            if (badge) badge.innerText = `${visibleCount} dịch vụ phù hợp`;

