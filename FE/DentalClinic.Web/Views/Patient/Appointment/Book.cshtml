                                </button>
                                <button type="submit" id="btnSubmitBooking" class="btn btn-success btn-lg px-5 shadow fw-bold">
                                    <i class="bi bi-send-check me-2"></i> Xác Nhận Gửi Yêu Cầu Đặt Lịch
                                </button>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- STICKY BOOKING SUMMARY PANEL (Cột Bên Phải 4/12) -->
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm sticky-top" style="top: 85px; z-index: 10;">
                        <div class="card-header bg-primary text-white py-3">
