@model DentalClinic.Web.ViewModels.Appointments.PatientBookViewModel
@{
    ViewData["Title"] = "Đặt lịch khám nha khoa";
}

<div class="container-fluid px-0">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-calendar-plus text-primary me-2"></i>Đặt Lịch Khám Nha Khoa Trực Tuyến
            </h1>
            <p class="text-muted mb-0">Hệ thống phòng khám DentalCare &bull; Đặt hẹn theo dịch vụ thực tế & chuyên khoa phù hợp</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Danh sách lịch hẹn
            </a>
        </div>
    </div>

    @if (Model.Eligibility != null && !Model.Eligibility.IsEligible)
    {
        <div class="card border-danger shadow-sm mb-4">
            <div class="card-body p-4 text-center">
                <div class="rounded-circle bg-danger-subtle text-danger d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                    <i class="bi bi-slash-circle fs-1"></i>
                </div>
                <h4 class="fw-bold text-danger mb-2">Tài Khoản Tạm Khóa Quyền Tự Đặt Lịch Online</h4>
                <p class="text-muted fs-6 mb-3 mx-auto" style="max-width: 650px;">
                    @Model.Eligibility.BlockReason
                </p>
                <div class="alert alert-warning border-warning d-inline-block text-start py-2 px-4 mb-4">
                    <i class="bi bi-telephone-fill text-warning me-2"></i>
                    Quý khách có nhu cầu khám chữa bệnh, vui lòng liên hệ hotline: <strong class="fs-5 text-dark ms-1">1900 1234</strong> hoặc đến trực tiếp phòng khám để được Lễ tân hỗ trợ.
                </div>
                <div>
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">
                        <i class="bi bi-calendar3 me-1"></i> Xem danh sách lịch hẹn của tôi
                    </a>
                </div>
            </div>
        </div>
    }
    else
    {
        @if (Model.Eligibility != null && Model.Eligibility.StrikeCount > 0)
        {
            <div class="alert alert-warning border-warning shadow-sm mb-4 py-2 d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center">
                    <i class="bi bi-exclamation-triangle-fill fs-5 me-2 text-warning"></i>
                    <div class="small">
                        <strong>Lưu ý chính sách hủy lịch:</strong> Tài khoản của bạn đang có <strong>@Model.Eligibility.StrikeCount / 3</strong> lần vi phạm trong 30 ngày qua (hủy sát giờ &lt;12h hoặc không đến khám). Vui lòng cân nhắc sắp xếp thời gian hợp lý khi đặt lịch để tránh bị tạm khóa quyền đặt lịch trực tuyến 30 ngày.
                    </div>
                </div>
                <span class="badge bg-warning text-dark px-2 py-1">@Model.Eligibility.StrikeCount/3 Vi phạm</span>
            </div>
        }

        <!-- Stepper Navigation (5 Bước Trực Quan Chuẩn Chuyên Nghiệp) -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center text-center position-relative stepper-wrapper">
                    <div class="step-item active" id="step-nav-1" onclick="goToStep(1)">
                        <div class="step-circle"><i class="bi bi-heart-pulse"></i></div>
                        <div class="step-label">1. Dịch vụ</div>
                    </div>
                    <div class="step-line"></div>
                    <div class="step-item" id="step-nav-2" onclick="goToStep(2)">
                        <div class="step-circle"><i class="bi bi-person-badge"></i></div>
                        <div class="step-label">2. Chọn bác sĩ</div>
                    </div>
                    <div class="step-line"></div>
                    <div class="step-item" id="step-nav-3" onclick="goToStep(3)">
                        <div class="step-circle"><i class="bi bi-calendar2-week"></i></div>
                        <div class="step-label">3. Ngày & Giờ</div>
                    </div>
                    <div class="step-line"></div>
                    <div class="step-item" id="step-nav-4" onclick="goToStep(4)">
                        <div class="step-circle"><i class="bi bi-card-text"></i></div>
                        <div class="step-label">4. Thông tin BN</div>
                    </div>
                    <div class="step-line"></div>
                    <div class="step-item" id="step-nav-5" onclick="goToStep(5)">
                        <div class="step-circle"><i class="bi bi-check-circle"></i></div>
                        <div class="step-label">5. Xác nhận</div>
                    </div>
                </div>
            </div>
        </div>

        <form asp-action="Book" method="post" id="bookingForm" onsubmit="return validateAndSubmitBooking(event)">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

            <input type="hidden" asp-for="DepartmentId" id="hiddenDepartmentId" />
            <input type="hidden" asp-for="RequestedServiceId" id="hiddenServiceId" />
            <input type="hidden" asp-for="DoctorSelectionMode" id="hiddenDoctorSelectionMode" value="@Model.DoctorSelectionMode" />
            <input type="hidden" asp-for="RequestedDentistUserId" id="hiddenDentistId" />
            <input type="hidden" asp-for="ScheduledStart" id="hiddenScheduledStart" />

            <div class="row g-4">
                <!-- MAIN FORM STEPS (Cột Bên Trái 8/12) -->
                <div class="col-lg-8">

                    <!-- STEP 1: CHỌN DỊCH VỤ THỰC TẾ (Service-First) -->
                    <div class="step-panel" id="step-panel-1">
                        <div class="card border-0 shadow-sm">
                            <div class="card-header bg-white py-3 border-bottom">
                                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                    <div>
                                        <h5 class="card-title mb-1 fw-bold text-primary">
                                            <i class="bi bi-heart-pulse me-2"></i>Bước 1: Chọn Dịch Vụ Nha Khoa Thực Tế
                                        </h5>
                                        <p class="text-muted small mb-0">Hệ thống nạp cấu hình thời lượng, giá tham khảo và khung giờ khám trực tiếp từ dữ liệu thực tế.</p>
                                    </div>
                                    <span class="badge bg-primary-subtle text-primary px-3 py-2 fs-6 rounded-pill" id="badgeServiceCount">
                                        @Model.Services.Count dịch vụ khả dụng
                                    </span>
                                </div>
                            </div>
                            <div class="card-body p-4">
                                <!-- Bộ lọc và tìm kiếm dịch vụ -->
                                <div class="row g-3 mb-4">
                                    <div class="col-md-7">
                                        <div class="input-group">
                                            <span class="input-group-text bg-light border-end-0 text-muted">
                                                <i class="bi bi-search"></i>
                                            </span>
                                            <input type="text" id="serviceSearchInput" class="form-control border-start-0 ps-0" placeholder="Tìm theo tên dịch vụ (ví dụ: lấy cao răng, trám răng, nhổ răng, niềng răng...)" oninput="filterServices()" />
                                        </div>
                                    </div>
                                    <div class="col-md-5">
                                        <select id="departmentFilterSelect" class="form-select" onchange="filterServices()">
                                            <option value="">-- Tất cả chuyên khoa --</option>
                                            @foreach (var dept in Model.Departments)
                                            {
                                                <option value="@dept.DepartmentId" selected="@(Model.DepartmentId == dept.DepartmentId ? "selected" : null)">
                                                    @dept.Name
                                                </option>
                                            }
                                        </select>
                                    </div>
                                </div>

                                <!-- Box cảnh báo đã chọn dịch vụ -->
                                <div id="serviceSelectedAlert" class="alert alert-success border-success d-none py-2 px-3 mb-3 rounded-3">
                                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="bi bi-check-circle-fill text-success fs-4"></i>
                                            <div>
                                                <span class="small text-muted d-block">Bạn đang chọn:</span>
                                                <strong id="alertServiceName" class="text-success fs-6"></strong>
                                                <div class="small mt-1 text-muted">
                                                    <span>Chuyên khoa: <strong id="alertDeptName" class="text-dark"></strong></span>
                                                    <span class="mx-2">&bull;</span>
                                                    <span>Thời lượng: <strong id="alertServiceDuration" class="text-primary"></strong></span>
                                                    <span class="mx-2">&bull;</span>
                                                    <span>Giá tham khảo: <strong id="alertServicePrice" class="text-primary"></strong></span>
                                                </div>
                                            </div>
                                        </div>
                                        <div>
                                            <span class="badge bg-success-subtle text-success border border-success px-3 py-2">
                                                <i class="bi bi-check2 me-1"></i>Đã chọn
                                            </span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Lưới danh sách dịch vụ -->
                                <div class="row g-3" id="servicesGrid">
                                    @if (Model.Services.Count == 0)
                                    {
                                        <div class="col-12 text-center text-muted py-5">
                                            <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                            Hiện chưa có dịch vụ nào đang mở đặt lịch trực tuyến.
                                        </div>
                                    }
                                    else
                                    {
                                        @foreach (var svc in Model.Services)
                                        {
                                            var deptName = !string.IsNullOrWhiteSpace(svc.DepartmentName) ? svc.DepartmentName : "Chuyên khoa tiếp nhận";
                                            var isSelected = Model.RequestedServiceId == svc.DepartmentServiceId;
                                            var duration = svc.DurationMinutes.HasValue && svc.DurationMinutes.Value > 0 ? svc.DurationMinutes.Value : 30;
                                            var priceStr = svc.Price.HasValue && svc.Price.Value > 0 ? svc.Price.Value.ToString("N0") + " đ" : "Miễn phí / BHYT";
                                            var hasOfficialInstructions = !string.IsNullOrWhiteSpace(svc.BookingInstructions);
                                            var isComplex = svc.RequiresConsultationFirst == true || hasOfficialInstructions ||
                                                            svc.ServiceName.Contains("Implant", StringComparison.OrdinalIgnoreCase) ||
                                                            svc.ServiceName.Contains("Niềng", StringComparison.OrdinalIgnoreCase) ||
                                                            svc.ServiceName.Contains("khôn", StringComparison.OrdinalIgnoreCase) ||
                                                            svc.ServiceName.Contains("Veneer", StringComparison.OrdinalIgnoreCase) ||
                                                            svc.ServiceName.Contains("Bọc răng", StringComparison.OrdinalIgnoreCase);

                                            <div class="col-md-6 service-item" 
                                                 data-service-id="@svc.DepartmentServiceId" 
                                                 data-dept-id="@svc.DepartmentId" 
                                                 data-dept-name="@deptName" 
                                                 data-name="@svc.ServiceName"
                                                 data-duration="@duration"
                                                 data-price="@priceStr"
                                                 data-is-complex="@(isComplex ? "true" : "false")">
                                                <div class="card h-100 selection-card service-card p-3 @(isSelected ? "active" : "")">
                                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                                        <h6 class="fw-bold mb-0 text-dark flex-grow-1 pe-2 service-name-title">@svc.ServiceName</h6>
                                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle small text-truncate" style="max-width: 160px;" title="@deptName">
                                                            @deptName
                                                        </span>
                                                    </div>
                                                    <p class="text-muted small mb-2 flex-grow-1 service-desc-text">
                                                        @(string.IsNullOrWhiteSpace(svc.Description) ? "Thăm khám, kiểm tra và điều trị chuẩn y khoa với trang thiết bị hiện đại." : svc.Description)
                                                    </p>

                                                    <div class="d-flex align-items-center justify-content-between py-2 px-2 bg-light rounded-2 mb-2">
                                                        <div class="d-flex align-items-center gap-1 text-secondary small">
                                                            <i class="bi bi-clock-history text-primary"></i>
                                                            <span>Thời lượng: <strong>@duration phút</strong></span>
                                                        </div>
                                                        <div class="small">
                                                            <span class="text-muted">Giá:</span>
                                                            <strong class="text-primary ms-1">@priceStr</strong>
                                                        </div>
                                                    </div>

                                                    @if (hasOfficialInstructions)
                                                    {
                                                        <div class="mb-2 p-2 bg-info-subtle rounded border border-info-subtle text-dark small">
                                                            <i class="bi bi-info-circle-fill text-primary me-1"></i><strong>Hướng dẫn:</strong> @svc.BookingInstructions
                                                        </div>
                                                    }
                                                    else if (isComplex)
                                                    {
                                                        <div class="mb-2 p-2 bg-warning-subtle rounded border border-warning-subtle text-dark small">
                                                            <i class="bi bi-shield-check text-warning me-1"></i><strong>Thủ thuật chuyên sâu:</strong> Cần khám tư vấn chuyên sâu trước khi thực hiện.
                                                        </div>
                                                    }

                                                    <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                                        <span class="text-primary small fw-semibold">
                                                            <i class="bi bi-check2-circle me-1"></i>Chọn dịch vụ này
                                                        </span>
                                                        <span class="selection-arrow text-muted">
                                                            <i class="bi bi-chevron-right"></i>
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                        <div id="filterEmptyAlert" class="col-12 text-center text-muted py-5 d-none">
                                            <i class="bi bi-search fs-1 d-block mb-2 text-secondary"></i>
                                            <h6>Không tìm thấy dịch vụ nào phù hợp với từ khóa tìm kiếm.</h6>
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="card-footer bg-white text-end py-3 border-top">
                                <button type="button" class="btn btn-primary btn-lg px-4 shadow-sm" id="btnNext1" disabled onclick="goToStep(2)">
                                    Tiếp tục: Chọn bác sĩ khám <i class="bi bi-arrow-right ms-1"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- STEP 2: CHỌN BÁC SĨ (OPTION A / OPTION B - QUAN TRỌNG NHẤT) -->
                    <div class="step-panel d-none" id="step-panel-2">
                        <div class="card border-0 shadow-sm">
                            <div class="card-header bg-white py-3 border-bottom">
                                <h5 class="card-title mb-0 fw-bold text-primary">
                                    <i class="bi bi-person-badge me-2"></i>Bước 2: Chọn Hình Thức Phân Công Bác Sĩ
                                </h5>
                                <p class="text-muted small mb-0 mt-1">Bạn có thể để phòng khám tự động sắp xếp hoặc chủ động chọn bác sĩ mong muốn</p>
                            </div>
                            <div class="card-body p-4">
                                <!-- Banner dịch vụ đã chọn -->
                                <div class="card bg-light-subtle border mb-4 p-3 rounded-3">
                                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                        <div>
                                            <span class="badge bg-primary-subtle text-primary mb-1">Dịch vụ đã chọn</span>
                                            <h6 class="mb-1 fw-bold text-dark fs-5" id="panel2ServiceName">--</h6>
                                            <div class="text-muted small">
                                                <i class="bi bi-hospital me-1 text-primary"></i>Chuyên khoa: <strong class="text-dark" id="panel2DeptName">--</strong>
                                                <span class="ms-3"><i class="bi bi-clock me-1 text-primary"></i>Thời lượng: <strong class="text-dark" id="panel2ServiceDuration">--</strong></span>
                                                <span class="ms-3"><i class="bi bi-tag me-1 text-primary"></i>Giá: <strong class="text-dark" id="panel2ServicePrice">--</strong></span>
                                            </div>
                                        </div>
                                        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="goToStep(1)">
                                            <i class="bi bi-pencil me-1"></i> Đổi dịch vụ
                                        </button>
                                    </div>
                                </div>

                                <!-- 2 LỰA CHỌN NGHIỆP VỤ (OPTION A vs OPTION B) -->
                                <label class="form-label fw-bold mb-3">Vui lòng chọn hình thức khám mong muốn: <span class="text-danger">*</span></label>
                                
                                <div class="row g-3 mb-4">
                                    <!-- OPTION B: PHÒNG KHÁM PHÂN CÔNG (Khuyên dùng) -->
                                    <div class="col-md-6">
                                        <div class="card selection-card p-3 h-100 option-doctor-mode active" id="cardModeClinicAssignment" onclick="setDoctorSelectionMode('ClinicAssignment')">
                                            <div class="d-flex align-items-start gap-3">
                                                <div class="selection-icon bg-success-subtle text-success rounded-3 p-3">
                                                    <i class="bi bi-hospital-fill fs-3"></i>
                                                </div>
                                                <div class="flex-grow-1">
                                                    <div class="d-flex align-items-center gap-2 mb-1">
                                                        <span class="fw-bold text-dark fs-6">Để phòng khám phân công bác sĩ phù hợp</span>
                                                        <span class="badge bg-success-subtle text-success border border-success small">Khuyên dùng</span>
                                                    </div>
                                                    <p class="text-muted small mb-0">
                                                        Lễ tân phòng khám sẽ tự động sắp xếp bác sĩ chuyên môn phù hợp nhất trong ca trực khi tiếp nhận và xác nhận lịch hẹn của bạn.
                                                    </p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- OPTION A: CHỌN BÁC SĨ CỤ THỂ (PreferredDentist) -->
                                    <div class="col-md-6">
                                        <div class="card selection-card p-3 h-100 option-doctor-mode" id="cardModePreferredDentist" onclick="setDoctorSelectionMode('PreferredDentist')">
                                            <div class="d-flex align-items-start gap-3">
                                                <div class="selection-icon bg-primary-subtle text-primary rounded-3 p-3">
                                                    <i class="bi bi-person-check-fill fs-3"></i>
                                                </div>
                                                <div class="flex-grow-1">
                                                    <div class="d-flex align-items-center gap-2 mb-1">
                                                        <span class="fw-bold text-dark fs-6">Tôi muốn chọn bác sĩ</span>
                                                    </div>
                                                    <p class="text-muted small mb-0">
                                                        Xem danh sách các bác sĩ chuyên khoa phụ trách dịch vụ này và chỉ định bác sĩ ưu tiên thăm khám cho bạn.
                                                    </p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Container danh sách bác sĩ khi chọn Option A (PreferredDentist) -->
                                <div id="dentistSelectionSubpanel" class="d-none">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <h6 class="fw-bold text-dark mb-0">
                                            <i class="bi bi-people me-1 text-primary"></i>Danh Sách Bác Sĩ Chuyên Khoa Phù Hợp:
                                        </h6>
                                        <small class="text-muted" id="dentistCountBadge">0 bác sĩ</small>
                                    </div>

                                    <div class="text-center py-4 d-none" id="dentistLoadingSpinner">
                                        <div class="spinner-border text-primary spinner-border-sm" role="status"></div>
                                        <span class="text-muted small ms-2">Đang tải danh sách bác sĩ...</span>
                                    </div>

                                    <div class="row g-3" id="dentistCardsContainer">
                                        <!-- Doctor cards dynamically injected via JS -->
                                    </div>

                                    <div id="noDentistsAlert" class="alert alert-warning d-none text-center py-3">
                                        <i class="bi bi-info-circle me-1"></i>Chuyên khoa này hiện chưa có bác sĩ cụ thể để chỉ định. Vui lòng chọn <strong>"Để phòng khám phân công bác sĩ phù hợp"</strong>.
                                    </div>
                                </div>

                                <div class="alert alert-light border rounded-3 p-3 mt-4 small text-muted">
                                    <i class="bi bi-shield-check text-primary me-1"></i><strong>Lưu ý nghiệp vụ:</strong> Nếu chọn bác sĩ cụ thể, hệ thống sẽ ghi nhận bác sĩ ưu tiên (Preferred Dentist). Lễ tân sẽ xác nhận bác sĩ này hoặc thông báo điều chỉnh nếu bác sĩ có lịch công tác đột xuất.
                                </div>
                            </div>
                            <div class="card-footer bg-white d-flex justify-content-between py-3 border-top">
                                <button type="button" class="btn btn-outline-secondary" onclick="goToStep(1)">
                                    <i class="bi bi-arrow-left me-1"></i> Quay lại Bước 1
                                </button>
                                <button type="button" class="btn btn-primary px-4 shadow-sm" id="btnNext2" onclick="goToStep(3)">
                                    Tiếp tục: Chọn ngày giờ khám <i class="bi bi-arrow-right ms-1"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- STEP 3: CHỌN NGÀY VÀ GIỜ HẸN KHÁM -->
                    <div class="step-panel d-none" id="step-panel-3">
                        <div class="card border-0 shadow-sm">
                            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <div>
                                    <h5 class="card-title mb-0 fw-bold text-primary">
                                        <i class="bi bi-calendar2-week me-2"></i>Bước 3: Chọn Ngày & Khung Giờ Hẹn Khám
                                    </h5>
                                    <p class="text-muted small mb-0">Hệ thống tra cứu các khung giờ thực tế có khả năng tiếp nhận</p>
                                </div>
                                <span class="badge bg-light text-dark border px-3 py-2 small" id="slotFilterSummary"></span>
                            </div>
                            <div class="card-body p-4">
                                <!-- 1. Chọn ngày khám -->
                                <div class="mb-4">
                                    <label class="form-label fw-bold">1. Chọn ngày khám mong muốn: <span class="text-danger">*</span></label>
                                    
                                    <!-- Quick date chips -->
                                    <div class="d-flex gap-2 mb-2">
                                        <button type="button" class="btn btn-outline-primary btn-sm flex-fill fw-semibold" onclick="setQuickDate(0)">Hôm nay</button>
                                        <button type="button" class="btn btn-outline-primary btn-sm flex-fill fw-semibold" onclick="setQuickDate(1)">Ngày mai</button>
                                        <button type="button" class="btn btn-outline-primary btn-sm flex-fill fw-semibold" onclick="setQuickDate(2)">Ngày kia</button>
                                    </div>

                                    <div class="row align-items-center g-2">
                                        <div class="col-md-6">
                                            <input type="date" asp-for="AppointmentDate" id="inputAppointmentDate" class="form-control form-control-lg fw-bold" min="@DentalClinic.Web.Controllers.Patient.PatientAppointmentController.GetClinicToday().ToString("yyyy-MM-dd")" onchange="onDateChanged()" />
                                        </div>
                                        <div class="col-md-6">
                                            <div id="selectedDateDisplay" class="text-primary fw-semibold small">
                                                <i class="bi bi-calendar-event me-1"></i><span id="dateTextFull"></span>
                                            </div>
                                        </div>
                                    </div>
                                    <small class="text-muted mt-2 d-block">
                                        <i class="bi bi-clock me-1"></i>Phòng khám đón tiếp bệnh nhân từ <strong>08:00 đến 20:00</strong> tất cả các ngày trong tuần.
                                    </small>
                                </div>

                                <hr />

                                <!-- 2. Chọn khung giờ khám -->
                                <div class="mb-2">
                                    <label class="form-label fw-bold d-flex justify-content-between align-items-center">
                                        <span>2. Chọn khung giờ khám còn trống: <span class="text-danger">*</span></span>
                                        <span class="small text-muted font-normal" id="labelSlotDoctorContext"></span>
                                    </label>

                                    <div id="slotsLoading" class="text-center py-5 d-none">
                                        <div class="spinner-border text-primary" role="status"></div>
                                        <p class="mt-2 text-muted fw-semibold">Đang tra cứu lịch trực và tính toán khung giờ trống...</p>
                                    </div>

                                    <div id="noSlotsMessage" class="alert alert-warning d-none text-center py-4 border-warning shadow-sm rounded-3">
