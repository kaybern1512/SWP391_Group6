@model DentalClinic.Web.ViewModels.Appointments.PatientBookViewModel
@{
    ViewData["Title"] = "Đặt lịch khám nha khoa";
}

<div class="container-fluid px-0">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-calendar-plus text-primary me-2"></i>Đặt Lịch Khám Nha Khoa Trực Tuyến
            </h1>
            <p class="text-muted mb-0">Hệ thống phòng khám DentalCare &bull; Đặt hẹn theo Combo dịch vụ, Dịch vụ lẻ hoặc Khám tư vấn tổng quát</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Danh sách lịch hẹn
            </a>
        </div>
    </div>

    @if (Model.Eligibility != null && !Model.Eligibility.IsEligible)
    {
        <div class="card border-danger shadow-sm mb-4">
            <div class="card-body p-4 text-center">
                <div class="rounded-circle bg-danger-subtle text-danger d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                    <i class="bi bi-slash-circle fs-1"></i>
                </div>
                <h4 class="fw-bold text-danger mb-2">Tài Khoản Tạm Khóa Quyền Tự Đặt Lịch Online</h4>
                <p class="text-muted fs-6 mb-3 mx-auto" style="max-width: 650px;">
                    @Model.Eligibility.BlockReason
                </p>
                <div class="alert alert-warning border-warning d-inline-block text-start py-2 px-4 mb-4">
                    <i class="bi bi-telephone-fill text-warning me-2"></i>
                    Quý khách có nhu cầu khám chữa bệnh, vui lòng liên hệ hotline: <strong class="fs-5 text-dark ms-1">1900 1234</strong> hoặc đến trực tiếp phòng khám để được Lễ tân hỗ trợ.
                </div>
                <div>
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">
                        <i class="bi bi-calendar3 me-1"></i> Xem danh sách lịch hẹn của tôi
                    </a>
                </div>
            </div>
        </div>
    }
    else
    {
        @if (Model.Eligibility != null && Model.Eligibility.StrikeCount > 0)
        {
            <div class="alert alert-warning border-warning shadow-sm mb-4 py-2 d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center">
                    <i class="bi bi-exclamation-triangle-fill fs-5 me-2 text-warning"></i>
                    <div class="small">
                        <strong>Lưu ý chính sách hủy lịch:</strong> Tài khoản của bạn đang có <strong>@Model.Eligibility.StrikeCount / 3</strong> lần vi phạm trong 30 ngày qua (hủy sát giờ &lt;12h hoặc không đến khám). Vui lòng sắp xếp thời gian hợp lý khi đặt lịch.
                    </div>
                </div>
                <span class="badge bg-warning text-dark px-2 py-1">@Model.Eligibility.StrikeCount/3 Vi phạm</span>
            </div>
        }

        <!-- Stepper Navigation (Chuẩn theo sơ đồ luồng quy trình mới) -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center text-center position-relative stepper-wrapper">
                    <div class="step-item active" id="step-nav-1" onclick="goToStep(1)">
                        <div class="step-circle"><i class="bi bi-diagram-3-fill"></i></div>
                        <div class="step-label">1. Chọn hình thức</div>
                    </div>
                    <div class="step-line"></div>
                    <div class="step-item" id="step-nav-2" onclick="goToStep(2)">
                        <div class="step-circle"><i class="bi bi-person-badge"></i></div>
                        <div class="step-label">2. Khoa & Bác sĩ</div>
                    </div>
                    <div class="step-line"></div>
                    <div class="step-item" id="step-nav-3" onclick="goToStep(3)">
                        <div class="step-circle"><i class="bi bi-calendar2-week"></i></div>
                        <div class="step-label">3. Ngày & Giờ</div>
                    </div>
                    <div class="step-line"></div>
                    <div class="step-item" id="step-nav-4" onclick="goToStep(4)">
                        <div class="step-circle"><i class="bi bi-person-lines-fill"></i></div>
                        <div class="step-label">4. Thông tin BN</div>
                    </div>
                    <div class="step-line"></div>
                    <div class="step-item" id="step-nav-5" onclick="goToStep(5)">
                        <div class="step-circle"><i class="bi bi-check-circle-fill"></i></div>
                        <div class="step-label">5. Xác nhận</div>
                    </div>
                </div>
            </div>
        </div>

        <form asp-action="Book" method="post" id="bookingForm" onsubmit="return validateAndSubmitBooking(event)">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

            <input type="hidden" asp-for="DepartmentId" id="hiddenDepartmentId" />
            <input type="hidden" asp-for="RequestedServiceId" id="hiddenServiceId" />
            <input type="hidden" asp-for="BookingCategory" id="hiddenBookingCategory" value="@Model.BookingCategory" />
            <input type="hidden" asp-for="SelectedComboCode" id="hiddenSelectedComboCode" value="@Model.SelectedComboCode" />
            <input type="hidden" asp-for="DoctorSelectionMode" id="hiddenDoctorSelectionMode" value="@Model.DoctorSelectionMode" />
            <input type="hidden" asp-for="RequestedDentistUserId" id="hiddenDentistId" />
            <input type="hidden" asp-for="ScheduledStart" id="hiddenScheduledStart" />

            <div class="row g-4">
                <!-- MAIN FORM STEPS (Cột Bên Trái 8/12) -->
                <div class="col-lg-8">

                    <!-- ============================================================== -->
                    <!-- BƯỚC 1: CHỌN HÌNH THỨC (COMBO / DỊCH VỤ LẺ / KHÁM TỔNG QUÁT)   -->
                    <!-- ============================================================== -->
                    <div class="step-panel" id="step-panel-1">
                        <div class="card border-0 shadow-sm mb-4">
                            <div class="card-header bg-white py-3 border-bottom">
                                <h5 class="card-title mb-1 fw-bold text-primary">
                                    <i class="bi bi-diagram-3-fill me-2"></i>Bước 1: Chọn Hình Thức Đặt Lịch
                                </h5>
                                <p class="text-muted small mb-0">Vui lòng chọn 1 trong 3 hình thức thăm khám phù hợp nhất với nhu cầu của bạn:</p>
                            </div>
                            <div class="card-body p-4">
                                <!-- 3 Nhánh Chọn Hình Thức (Cards Selector) -->
                                <div class="row g-3 mb-4">
                                    <!-- Nhánh 1: Combo Dịch Vụ -->
                                    <div class="col-md-4">
                                        <div class="category-card p-3 h-100 rounded-3 text-center position-relative cursor-pointer @(Model.BookingCategory == "Combo" ? "active" : "")"
                                             id="cat-card-combo" onclick="switchBookingCategory('Combo')">
                                            <span class="badge bg-warning text-dark position-absolute top-0 end-0 m-2 px-2 py-1 small rounded-pill">
                                                <i class="bi bi-stars me-1"></i>Tiết kiệm 20%
                                            </span>
                                            <div class="cat-icon rounded-circle bg-warning-subtle text-warning mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 56px; height: 56px;">
                                                <i class="bi bi-box2-heart-fill fs-3"></i>
                                            </div>
                                            <h6 class="fw-bold text-dark mb-1">Combo Dịch Vụ</h6>
                                            <p class="text-muted small mb-2">Trọn gói kết hợp nhiều dịch vụ tiện ích, tối ưu chi phí & thời gian.</p>
                                            <div class="small fw-semibold text-warning"><i class="bi bi-arrow-right-circle me-1"></i>Xem & chọn gói</div>
                                        </div>
                                    </div>

                                    <!-- Nhánh 2: Dịch Vụ Lẻ -->
                                    <div class="col-md-4">
                                        <div class="category-card p-3 h-100 rounded-3 text-center position-relative cursor-pointer @(Model.BookingCategory == "SingleService" ? "active" : "")"
                                             id="cat-card-single" onclick="switchBookingCategory('SingleService')">
                                            <span class="badge bg-info-subtle text-info position-absolute top-0 end-0 m-2 px-2 py-1 small rounded-pill">
                                                31 Dịch vụ
                                            </span>
                                            <div class="cat-icon rounded-circle bg-info-subtle text-info mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 56px; height: 56px;">
                                                <i class="bi bi-grid-3x3-gap-fill fs-3"></i>
                                            </div>
                                            <h6 class="fw-bold text-dark mb-1">Dịch Vụ Lẻ</h6>
                                            <p class="text-muted small mb-2">Chủ động chọn đúng thủ thuật cụ thể theo từng chuyên khoa nha khoa.</p>
                                            <div class="small fw-semibold text-info"><i class="bi bi-arrow-right-circle me-1"></i>Chọn dịch vụ cụ thể</div>
                                        </div>
                                    </div>

                                    <!-- Nhánh 3: Khám Tổng Quát / Chưa Biết Nhu Cầu -->
                                    <div class="col-md-4">
                                        <div class="category-card p-3 h-100 rounded-3 text-center position-relative cursor-pointer @(Model.BookingCategory == "GeneralCheckup" ? "active" : "")"
                                             id="cat-card-general" onclick="switchBookingCategory('GeneralCheckup')">
                                            <span class="badge bg-success text-white position-absolute top-0 end-0 m-2 px-2 py-1 small rounded-pill">
                                                Khuyên Dùng
                                            </span>
                                            <div class="cat-icon rounded-circle bg-success-subtle text-success mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 56px; height: 56px;">
                                                <i class="bi bi-clipboard2-pulse-fill fs-3"></i>
                                            </div>
                                            <h6 class="fw-bold text-dark mb-1">Khám Tổng Quát</h6>
                                            <p class="text-muted small mb-2">Chưa rõ tình trạng răng miệng? Bác sĩ sẽ thăm khám & tư vấn chuẩn xác.</p>
                                            <div class="small fw-semibold text-success"><i class="bi bi-arrow-right-circle me-1"></i>Đặt lịch khám tư vấn</div>
                                        </div>
                                    </div>
                                </div>

                                <hr class="my-4 text-muted opacity-25" />

                                <!-- NỘI DUNG NHÁNH A: COMBO DỊCH VỤ -->
                                <div id="category-content-combo" class="@(Model.BookingCategory == "Combo" ? "" : "d-none")">
                                    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                                        <div>
                                            <h6 class="fw-bold text-dark mb-0">
                                                <i class="bi bi-box2-heart text-warning me-2"></i>Danh Sách Gói Combo Tuyển Chọn
                                            </h6>
                                            <small class="text-muted">Chọn gói combo phù hợp hoặc bấm "Xem chi tiết combo" để đọc quyền lợi chi tiết</small>
                                        </div>
                                        <span class="badge bg-warning-subtle text-dark px-3 py-2 rounded-pill">
                                            @Model.Combos.Count gói ưu đãi
                                        </span>
                                    </div>

                                    <div class="row g-3">
                                        @foreach (var combo in Model.Combos)
                                        {
                                            var isSelected = Model.SelectedComboCode == combo.Code;
                                            <div class="col-md-6">
                                                <div class="card h-100 combo-card border p-3 rounded-3 position-relative @(isSelected ? "active border-warning" : "")"
                                                     id="combo-card-@combo.Code"
                                                     data-combo-code="@combo.Code"
                                                     data-dept-id="@combo.DepartmentId"
                                                     data-dept-name="@combo.DepartmentName"
                                                     data-service-id="@combo.ServiceId"
                                                     data-service-name="@combo.ServiceName"
                                                     data-duration="@combo.DurationMinutes"
                                                     data-price="@combo.ComboPrice.ToString("N0") đ">
                                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                                        <span class="badge bg-warning-subtle text-warning-emphasis fw-bold px-2 py-1 rounded-pill">
                                                            @combo.Badge
                                                        </span>
                                                        <span class="badge bg-light text-muted border">
                                                            <i class="bi bi-clock me-1"></i>@combo.DurationMinutes phút
                                                        </span>
                                                    </div>

                                                    <h6 class="fw-bold text-dark mb-1">@combo.Title</h6>
                                                    <p class="text-muted small mb-3 text-truncate-2" style="min-height: 38px;">@combo.Tagline</p>

                                                    <!-- Included summary -->
                                                    <div class="bg-light p-2 rounded small mb-3">
                                                        <div class="fw-semibold text-dark mb-1 small"><i class="bi bi-check2-circle text-success me-1"></i>Bao gồm:</div>
                                                        <ul class="list-unstyled mb-0 ps-2 small text-muted">
                                                            @foreach (var inc in combo.IncludedServices.Take(2))
                                                            {
                                                                <li class="text-truncate">&bull; @inc</li>
                                                            }
                                                            @if (combo.IncludedServices.Count > 2)
                                                            {
                                                                <li class="text-primary small fw-semibold">+ @(combo.IncludedServices.Count - 2) dịch vụ/quyền lợi khác...</li>
                                                            }
                                                        </ul>
                                                    </div>

                                                    <!-- Price & Action -->
                                                    <div class="mt-auto pt-2 border-top d-flex justify-content-between align-items-center flex-wrap gap-2">
                                                        <div>
                                                            <div class="text-decoration-line-through text-muted small">@combo.OriginalPrice.ToString("N0") đ</div>
                                                            <div class="fw-bold text-danger fs-5">@combo.ComboPrice.ToString("N0") đ</div>
                                                        </div>
                                                        <div class="d-flex gap-2">
                                                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="event.stopPropagation(); viewComboDetail('@combo.Code')">
                                                                <i class="bi bi-info-circle me-1"></i>Xem chi tiết
                                                            </button>
                                                            <button type="button" class="btn btn-warning btn-sm fw-bold px-3 btn-select-combo" onclick="selectCombo('@combo.Code')">
                                                                @(isSelected ? "Đã chọn" : "Chọn Combo")
                                                            </button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <!-- NỘI DUNG NHÁNH B: DỊCH VỤ LẺ -->
                                <div id="category-content-single" class="@(Model.BookingCategory == "SingleService" ? "" : "d-none")">
                                    <div class="row g-3 mb-3">
                                        <div class="col-md-7">
                                            <div class="input-group">
                                                <span class="input-group-text bg-light border-end-0 text-muted">
                                                    <i class="bi bi-search"></i>
                                                </span>
                                                <input type="text" id="serviceSearchInput" class="form-control border-start-0 ps-0" placeholder="Tìm theo tên dịch vụ (ví dụ: lấy cao răng, trám răng, nhổ răng khôn...)" oninput="filterServices()" />
                                            </div>
                                        </div>
                                        <div class="col-md-5">
                                            <select id="departmentFilterSelect" class="form-select" onchange="filterServices()">
                                                <option value="">-- Tất cả chuyên khoa --</option>
                                                @foreach (var dept in Model.Departments)
                                                {
                                                    <option value="@dept.DepartmentId" selected="@(Model.DepartmentId == dept.DepartmentId ? "selected" : null)">
                                                        @dept.Name
                                                    </option>
                                                }
                                            </select>
                                        </div>
                                    </div>

                                    <div class="row g-3" id="serviceListContainer" style="max-height: 520px; overflow-y: auto; padding-right: 4px;">
                                        @foreach (var s in Model.Services)
                                        {
                                            var isSelected = Model.BookingCategory == "SingleService" && Model.RequestedServiceId == s.DepartmentServiceId;
                                            <div class="col-md-6 service-item"
                                                 data-service-id="@s.DepartmentServiceId"
                                                 data-dept-id="@s.DepartmentId"
                                                 data-dept-name="@s.DepartmentName"
                                                 data-name="@s.ServiceName"
                                                 data-duration="@s.DurationMinutes"
                                                 data-price="@((s.Price ?? 0).ToString("N0")) đ">
                                                <div class="card service-card p-3 h-100 rounded-3 border @(isSelected ? "active border-primary" : "")">
                                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                                        <span class="badge bg-light text-primary border small text-truncate" style="max-width: 180px;">
                                                            @s.DepartmentName
                                                        </span>
                                                        <span class="badge bg-light text-muted border small">
                                                            <i class="bi bi-clock me-1"></i>@s.DurationMinutes phút
                                                        </span>
                                                    </div>
                                                    <h6 class="fw-bold text-dark mb-1">@s.ServiceName</h6>
                                                    <p class="text-muted small mb-2 text-truncate-2" style="min-height: 36px;">
                                                        @(string.IsNullOrWhiteSpace(s.Description) ? "Dịch vụ nha khoa tiêu chuẩn chuyên sâu." : s.Description)
                                                    </p>
                                                    <div class="mt-auto pt-2 border-top d-flex justify-content-between align-items-center">
                                                        <span class="fw-bold text-primary fs-6">@((s.Price ?? 0).ToString("N0")) đ</span>
                                                        <button type="button" class="btn btn-outline-primary btn-sm px-3 fw-semibold">
                                                            @(isSelected ? "Đã chọn" : "Chọn dịch vụ")
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                    <div id="filterEmptyAlert" class="alert alert-light border text-center my-4 d-none">
                                        <i class="bi bi-info-circle text-muted fs-4 d-block mb-1"></i>
                                        Không tìm thấy dịch vụ nào phù hợp với từ khóa hoặc chuyên khoa đã chọn.
                                    </div>
                                </div>

                                <!-- NỘI DUNG NHÁNH C: KHÁM TỔNG QUÁT / CHƯA BIẾT NHU CẦU -->
                                <div id="category-content-general" class="@(Model.BookingCategory == "GeneralCheckup" ? "" : "d-none")">
                                    <div class="card bg-success-subtle border-success-subtle p-3 rounded-3 mb-4">
                                        <div class="d-flex align-items-start gap-3">
                                            <div class="rounded-circle bg-success text-white p-2 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; flex-shrink: 0;">
                                                <i class="bi bi-lightbulb-fill fs-5"></i>
                                            </div>
                                            <div>
                                                <h6 class="fw-bold text-success-emphasis mb-1">Bạn chưa biết rõ tình trạng răng miệng hoặc muốn kiểm tra định kỳ?</h6>
                                                <p class="small text-success-emphasis mb-0">
                                                    Đừng lo lắng! Bác sĩ chuyên khoa tại DentalCare sẽ trực tiếp thăm khám tổng quát, khảo sát phim X-Quang (khi cần) và tư vấn phác đồ điều trị an toàn, minh bạch nhất trước khi tiến hành bất kỳ thủ thuật nào.
                                                </p>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Thẻ dịch vụ mặc định khám tổng quát -->
                                    <div class="card border border-success p-3 rounded-3 mb-4 shadow-sm">
                                        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
                                            <div>
                                                <span class="badge bg-success text-white px-2 py-1 rounded-pill mb-1">Dịch Vụ Khám Tư Vấn Khuyên Dùng</span>
                                                <h5 class="fw-bold text-dark mb-0">Khám Tổng Quát & Tư Vấn Chuyên Sâu</h5>
                                                <small class="text-muted"><i class="bi bi-hospital me-1"></i>Khoa Răng Hàm Mặt Tổng Quát &bull; Thời lượng: 30 phút</small>
                                            </div>
                                            <div class="text-end">
                                                <div class="fs-4 fw-bold text-success">100.000 đ</div>
                                                <small class="text-muted">Chi phí niêm yết</small>
                                            </div>
                                        </div>
                                        <p class="text-muted small mb-3">
                                            Quy trình: Kiểm tra toàn diện răng nướu & khớp cắn &bull; Đánh giá nguy cơ sâu răng và viêm nha chu &bull; Bác sĩ giải thích tình trạng và đề xuất giải pháp tối ưu.
                                        </p>
                                    </div>

                                    <!-- Nút bấm chọn triệu chứng nhanh -->
                                    <div class="mb-4">
                                        <label class="form-label fw-bold text-dark mb-2">
                                            <i class="bi bi-tags text-primary me-1"></i>Chọn nhanh triệu chứng bạn đang gặp phải (nếu có):
                                        </label>
                                        <div class="d-flex flex-wrap gap-2" id="symptomQuickChips">
                                            <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill symptom-chip" onclick="quickSelectSymptom('Đau nhức / Ê buốt răng khi ăn uống')">
                                                🦷 Đau nhức / Ê buốt khi ăn
                                            </button>
                                            <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill symptom-chip" onclick="quickSelectSymptom('Chảy máu chân răng / Viêm sưng nướu')">
                                                🩸 Chảy máu chân răng / Sưng nướu
                                            </button>
                                            <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill symptom-chip" onclick="quickSelectSymptom('Răng bị sâu / Mẻ vỡ / Có lỗ hổng')">
                                                ⚡ Sâu răng / Mẻ vỡ
                                            </button>
                                            <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill symptom-chip" onclick="quickSelectSymptom('Răng khấp khểnh, muốn tư vấn niềng răng')">
                                                ✨ Muốn tư vấn niềng răng
                                            </button>
                                            <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill symptom-chip" onclick="quickSelectSymptom('Răng ố vàng, muốn tẩy trắng / dán sứ')">
                                                💎 Muốn làm trắng răng / Thẩm mỹ
                                            </button>
                                            <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill symptom-chip" onclick="quickSelectSymptom('Khám định kỳ 6 tháng / Vệ sinh răng miệng')">
                                                🩺 Khám sức khỏe định kỳ
                                            </button>
                                        </div>
                                    </div>

                                    <div class="text-center pt-2">
                                        <button type="button" class="btn btn-success btn-lg px-5 py-2 fw-bold shadow-sm" onclick="selectGeneralCheckup()">
                                            Đặt Lịch Khám Tư Vấn Này Ngay <i class="bi bi-arrow-right ms-2"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ============================================================== -->
                    <!-- BƯỚC 2: XÁC ĐỊNH KHOA VÀ BÁC SĨ (Sau khi 3 nhánh hội tụ)        -->
                    <!-- ============================================================== -->
                    <div class="step-panel d-none" id="step-panel-2">
                        <div class="card border-0 shadow-sm">
                            <div class="card-header bg-white py-3 border-bottom">
                                <h5 class="card-title mb-1 fw-bold text-primary">
                                    <i class="bi bi-person-badge me-2"></i>Bước 2: Xác Định Khoa & Hình Thức Bác Sĩ
                                </h5>
                                <p class="text-muted small mb-0">Hệ thống tự động liên kết chuyên khoa tương ứng với dịch vụ bạn đã chọn.</p>
                            </div>
                            <div class="card-body p-4">
                                <!-- Chuyên khoa phụ trách -->
                                <div class="p-3 bg-light rounded-3 mb-4 border d-flex justify-content-between align-items-center flex-wrap gap-2">
                                    <div>
                                        <small class="text-muted d-block text-uppercase fw-semibold" style="font-size: 0.75rem;">Chuyên khoa tiếp nhận điều trị:</small>
                                        <h5 class="fw-bold text-dark mb-0" id="step2DeptName">Khoa Răng Hàm Mặt Tổng Quát</h5>
                                    </div>
                                    <div>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="goToStep(1)">
                                            <i class="bi bi-arrow-repeat me-1"></i>Đổi hình thức / dịch vụ
                                        </button>
                                    </div>
                                </div>

                                <label class="form-label fw-bold text-dark mb-2">Vui lòng chọn hình thức khám mong muốn: <span class="text-danger">*</span></label>
                                <div class="row g-3 mb-4">
                                    <!-- Option A: Clinic Assignment (Default) -->
                                    <div class="col-md-6">
                                        <div class="card selection-card p-3 h-100 cursor-pointer active" id="modeCardClinic" onclick="setDoctorSelectionMode('ClinicAssignment')">
                                            <div class="d-flex align-items-start gap-3">
                                                <div class="rounded-circle bg-success-subtle text-success p-2 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; flex-shrink: 0;">
                                                    <i class="bi bi-hospital fs-4"></i>
                                                </div>
                                                <div>
                                                    <div class="d-flex align-items-center gap-2 mb-1">
                                                        <h6 class="fw-bold text-dark mb-0">Để phòng khám phân công bác sĩ phù hợp</h6>
                                                        <span class="badge bg-success-subtle text-success small">Khuyên dùng</span>
                                                    </div>
                                                    <p class="text-muted small mb-0">Lễ tân phòng khám sẽ tự động sắp xếp bác sĩ chuyên môn phù hợp nhất trong ca trực khi tiếp nhận và xác nhận lịch hẹn của bạn.</p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Option B: Preferred Dentist -->
                                    <div class="col-md-6">
                                        <div class="card selection-card p-3 h-100 cursor-pointer" id="modeCardDoctor" onclick="setDoctorSelectionMode('PreferredDentist')">
                                            <div class="d-flex align-items-start gap-3">
                                                <div class="rounded-circle bg-primary-subtle text-primary p-2 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; flex-shrink: 0;">
                                                    <i class="bi bi-person-check fs-4"></i>
                                                </div>
                                                <div>
                                                    <h6 class="fw-bold text-dark mb-1">Tôi muốn chọn bác sĩ</h6>
                                                    <p class="text-muted small mb-0">Xem danh sách các bác sĩ chuyên khoa phụ trách dịch vụ này và chỉ định bác sĩ ưu tiên thăm khám cho bạn.</p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Danh sách bác sĩ (Chỉ hiện khi chọn Option B) -->
                                <div id="preferredDoctorSection" class="d-none">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <h6 class="fw-bold text-dark mb-0">
                                            <i class="bi bi-people me-2 text-primary"></i>Chọn bác sĩ chuyên khoa ưu tiên:
                                        </h6>
                                        <span class="badge bg-light text-muted border" id="badgeDentistCount">Đang tải danh sách...</span>
                                    </div>

                                    <div id="dentistListLoading" class="text-center py-4">
                                        <div class="spinner-border text-primary spinner-border-sm me-2" role="status"></div>
                                        <span class="text-muted small">Đang nạp danh sách bác sĩ chuyên khoa...</span>
                                    </div>

                                    <div class="row g-3" id="dentistListContainer">
                                        <!-- Rendered by JS -->
                                    </div>

                                    <div id="noDentistsAlert" class="alert alert-light border text-center my-3 d-none">
                                        <i class="bi bi-info-circle text-muted fs-4 d-block mb-1"></i>
                                        Hiện chưa có bác sĩ nào được cấu hình cho chuyên khoa này. Bạn có thể chọn hình thức "Để phòng khám phân công bác sĩ phù hợp".
                                    </div>
                                </div>

                                <div class="d-flex justify-content-between align-items-center pt-3 border-top mt-4">
                                    <button type="button" class="btn btn-outline-secondary px-4" onclick="goToStep(1)">
                                        <i class="bi bi-arrow-left me-1"></i> Quay lại Bước 1
                                    </button>
                                    <button type="button" class="btn btn-primary px-4 fw-bold" onclick="goToStep(3)">
                                        Tiếp tục: Chọn ngày giờ khám <i class="bi bi-arrow-right ms-1"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ============================================================== -->
                    <!-- BƯỚC 3: CHỌN NGÀY VÀ GIỜ KHÁM                                  -->
                    <!-- ============================================================== -->
                    <div class="step-panel d-none" id="step-panel-3">
                        <div class="card border-0 shadow-sm">
                            <div class="card-header bg-white py-3 border-bottom">
                                <h5 class="card-title mb-1 fw-bold text-primary">
                                    <i class="bi bi-calendar2-week me-2"></i>Bước 3: Chọn Ngày & Khung Giờ Khám
                                </h5>
                                <p class="text-muted small mb-0">Chọn ngày bạn mong muốn đến phòng khám và khung giờ còn trống khả dụng.</p>
                            </div>
                            <div class="card-body p-4">
                                <!-- Chọn ngày khám -->
                                <div class="mb-4">
                                    <label class="form-label fw-bold text-dark mb-2">Ngày khám mong muốn: <span class="text-danger">*</span></label>
                                    <div class="d-flex flex-wrap gap-2 mb-3">
                                        <button type="button" class="btn btn-outline-primary btn-sm quick-date-btn" onclick="setQuickDate(0)">Hôm nay</button>
                                        <button type="button" class="btn btn-outline-primary btn-sm quick-date-btn active" onclick="setQuickDate(1)">Ngày mai</button>
                                        <button type="button" class="btn btn-outline-primary btn-sm quick-date-btn" onclick="setQuickDate(2)">Ngày kia</button>
                                        <button type="button" class="btn btn-outline-primary btn-sm quick-date-btn" onclick="setQuickDate(3)">3 ngày tới</button>
                                    </div>
                                    <div class="input-group" style="max-width: 320px;">
                                        <span class="input-group-text bg-light"><i class="bi bi-calendar-event"></i></span>
                                        <input type="date" asp-for="AppointmentDate" id="inputAppointmentDate" class="form-control" onchange="onDateChanged()" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                                    </div>
                                    <div class="form-text text-muted small mt-1">
                                        Ngày đã chọn: <strong class="text-dark" id="dateTextFull">--</strong>
                                    </div>
                                </div>

                                <!-- Box thông báo đã chọn slot -->
                                <div id="slotSelectedAlert" class="alert alert-success border-success d-none py-2 px-3 mb-3 rounded-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                        <div>
                                            Khung giờ đã chọn: <strong id="alertSlotText" class="text-dark">--</strong>
                                        </div>
                                    </div>
                                </div>

                                <!-- Danh sách Khung giờ khả dụng -->
                                <div>
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <label class="form-label fw-bold text-dark mb-0">Khung giờ khám khả dụng: <span class="text-danger">*</span></label>
                                        <small class="text-muted" id="labelSlotDoctorContext">(Khung giờ còn trống theo lịch trực)</small>
                                    </div>

                                    <div id="slotsLoading" class="text-center py-4 d-none">
                                        <div class="spinner-border text-primary spinner-border-sm me-2" role="status"></div>
                                        <span class="text-muted small">Đang kiểm tra lịch trống phòng khám...</span>
                                    </div>

                                    <div id="noSlotsMessage" class="alert alert-warning border-warning d-none my-3">
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="bi bi-exclamation-circle-fill fs-5 text-warning"></i>
                                            <div>
                                                <strong>Không còn khung giờ trống trong ngày này!</strong>
                                                <div class="small" id="noSlotsDetailText">Vui lòng chọn ngày khác hoặc chuyển sang hình thức "Để phòng khám phân công bác sĩ phù hợp".</div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Ca Sáng -->
                                    <div class="mb-3" id="morningSection">
                                        <div class="small fw-bold text-muted mb-2 text-uppercase" style="font-size: 0.75rem;">
                                            <i class="bi bi-sun text-warning me-1"></i>Buổi Sáng (08:00 - 12:00)
                                        </div>
                                        <div class="row g-2" id="morningSlotsGrid">
                                            <!-- Rendered by JS -->
                                        </div>
                                    </div>

                                    <!-- Ca Chiều -->
                                    <div class="mb-3" id="afternoonSection">
                                        <div class="small fw-bold text-muted mb-2 text-uppercase" style="font-size: 0.75rem;">
                                            <i class="bi bi-sunset text-primary me-1"></i>Buổi Chiều (13:30 - 20:30)
                                        </div>
                                        <div class="row g-2" id="afternoonSlotsGrid">
                                            <!-- Rendered by JS -->
                                        </div>
                                    </div>
                                </div>

                                <div class="d-flex justify-content-between align-items-center pt-3 border-top mt-4">
                                    <button type="button" class="btn btn-outline-secondary px-4" onclick="goToStep(2)">
                                        <i class="bi bi-arrow-left me-1"></i> Quay lại Bước 2
                                    </button>
                                    <button type="button" class="btn btn-primary px-4 fw-bold" id="btnNext3" onclick="goToStep(4)" disabled>
                                        Tiếp tục: Nhập thông tin BN <i class="bi bi-arrow-right ms-1"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ============================================================== -->
                    <!-- BƯỚC 4: NHẬP THÔNG TIN BỆNH NHÂN & TRIỆU CHỨNG                  -->
                    <!-- ============================================================== -->
                    <div class="step-panel d-none" id="step-panel-4">
                        <div class="card border-0 shadow-sm">
                            <div class="card-header bg-white py-3 border-bottom">
                                <h5 class="card-title mb-1 fw-bold text-primary">
                                    <i class="bi bi-person-lines-fill me-2"></i>Bước 4: Nhập Thông Tin Bệnh Nhân & Triệu Chứng
                                </h5>
                                <p class="text-muted small mb-0">Hệ thống tự động điền thông tin tài khoản của bạn để phòng khám liên hệ và chuẩn bị hồ sơ.</p>
                            </div>
                            <div class="card-body p-4">
                                <div class="row g-3 mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label fw-bold text-dark">Họ và tên bệnh nhân:</label>
                                        <input type="text" asp-for="PatientFullName" id="inputPatientFullName" class="form-control" placeholder="Họ và tên bệnh nhân" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-bold text-dark">Số điện thoại liên hệ:</label>
                                        <input type="tel" asp-for="PatientPhoneNumber" id="inputPatientPhoneNumber" class="form-control" placeholder="Ví dụ: 0912345678" />
                                    </div>
                                    <div class="col-md-12">
                                        <label class="form-label fw-bold text-dark">Email nhận thông báo lịch hẹn:</label>
                                        <input type="email" asp-for="PatientEmail" id="inputPatientEmail" class="form-control" placeholder="email@example.com" />
                                    </div>
                                </div>

                                <!-- Lý do khám / Triệu chứng -->
                                <div class="mb-3">
                                    <label class="form-label fw-bold text-dark">
                                        Lý do khám / Triệu chứng hiện tại: <span class="text-danger">*</span>
                                    </label>
                                    <textarea asp-for="ReasonForVisit" id="inputReasonForVisit" class="form-control" rows="3" placeholder="Mô tả cụ thể tình trạng răng miệng của bạn (ví dụ: đau răng hàm dưới bên phải 2 ngày nay, cần tẩy trắng răng đón Tết...)" required></textarea>
                                    <span asp-validation-for="ReasonForVisit" class="text-danger small" id="reasonValidationError"></span>
                                </div>

                                <!-- Ghi chú thêm -->
                                <div class="mb-4">
                                    <label class="form-label fw-bold text-dark">Ghi chú thêm cho bác sĩ (nếu có):</label>
                                    <textarea asp-for="Notes" id="inputNotes" class="form-control" rows="2" placeholder="Tiền sử dị ứng thuốc tê, bệnh lý nền huyết áp, yêu cầu hỗ trợ đặc biệt..."></textarea>
                                </div>

                                <div class="d-flex justify-content-between align-items-center pt-3 border-top mt-4">
                                    <button type="button" class="btn btn-outline-secondary px-4" onclick="goToStep(3)">
                                        <i class="bi bi-arrow-left me-1"></i> Quay lại Bước 3
                                    </button>
                                    <button type="button" class="btn btn-primary px-4 fw-bold" onclick="goToStep(5)">
                                        Tiếp tục: Xem lại & Xác nhận <i class="bi bi-arrow-right ms-1"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ============================================================== -->
                    <!-- BƯỚC 5: XÁC NHẬN LỊCH HẸN                                      -->
                    <!-- ============================================================== -->
                    <div class="step-panel d-none" id="step-panel-5">
                        <div class="card border-0 shadow-sm">
                            <div class="card-header bg-white py-3 border-bottom">
                                <h5 class="card-title mb-1 fw-bold text-success">
                                    <i class="bi bi-check-circle-fill me-2"></i>Bước 5: Xác Nhận Yêu Cầu Đặt Lịch Hẹn
                                </h5>
                                <p class="text-muted small mb-0">Vui lòng rà soát lại thông tin trước khi gửi yêu cầu đến phòng khám DentalCare.</p>
                            </div>
                            <div class="card-body p-4">
                                <div class="card bg-light border-0 p-3 rounded-3 mb-4">
                                    <div class="row g-3">
                                        <div class="col-sm-6">
                                            <small class="text-muted d-block">Hình thức đặt lịch:</small>
                                            <strong class="text-dark fs-6" id="summaryCategoryText">Khám Tổng Quát</strong>
                                        </div>
                                        <div class="col-sm-6">
                                            <small class="text-muted d-block">Dịch vụ / Gói khám:</small>
                                            <strong class="text-primary fs-6" id="summaryService">--</strong>
                                        </div>
                                        <div class="col-sm-6">
                                            <small class="text-muted d-block">Chuyên khoa phụ trách:</small>
                                            <span class="text-dark fw-semibold" id="summaryDept">--</span>
                                        </div>
                                        <div class="col-sm-6">
                                            <small class="text-muted d-block">Bác sĩ khám:</small>
                                            <span class="text-dark fw-semibold" id="summaryDentist">Để phòng khám phân công</span>
                                        </div>
                                        <div class="col-sm-6">
                                            <small class="text-muted d-block">Thời gian khám:</small>
                                            <strong class="text-success fs-6" id="summarySlot">--</strong>
                                            <div class="small text-muted" id="summaryDate">--</div>
                                        </div>
                                        <div class="col-sm-6">
                                            <small class="text-muted d-block">Chi phí dự kiến & Thời lượng:</small>
                                            <strong class="text-danger fs-5" id="summaryPrice">--</strong>
                                            <span class="badge bg-light text-muted border ms-2" id="summaryDuration">-- phút</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="card border p-3 rounded-3 mb-4">
                                    <h6 class="fw-bold text-dark mb-2"><i class="bi bi-person me-2 text-primary"></i>Thông tin bệnh nhân liên hệ:</h6>
                                    <div class="row g-2 small">
                                        <div class="col-sm-6">Họ tên: <strong id="summaryPatient">--</strong></div>
                                        <div class="col-sm-6">Số điện thoại: <strong id="summaryPhone">--</strong></div>
                                        <div class="col-sm-12">Lý do khám: <span id="summaryReason" class="text-muted">--</span></div>
                                    </div>
                                </div>

                                <div class="alert alert-info border-info py-2 px-3 mb-4 small">
                                    <i class="bi bi-info-circle-fill me-1 text-info"></i>
                                    <strong>Quy định phòng khám:</strong> Yêu cầu của bạn sẽ được gửi tới Lễ tân tiếp nhận. Bạn có thể dời/hủy lịch hẹn miễn phí trước giờ khám tối thiểu 12 tiếng. Vui lòng có mặt trước giờ hẹn 10 phút.
                                </div>

                                <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                                    <button type="button" class="btn btn-outline-secondary px-4" onclick="goToStep(4)">
                                        <i class="bi bi-arrow-left me-1"></i> Quay lại Bước 4
                                    </button>
                                    <button type="submit" class="btn btn-success btn-lg px-5 py-2 fw-bold shadow-sm" id="btnSubmitBooking">
                                        <i class="bi bi-send-check me-2"></i> Xác Nhận & Đặt Lịch Hẹn
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- SIDEBAR TÓM TẮT THÔNG TIN REAL-TIME (Cột Bên Phải 4/12) -->
