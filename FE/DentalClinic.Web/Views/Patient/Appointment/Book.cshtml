        function addSymptomChip(text) {
            const textarea = document.getElementById('inputReasonForVisit');
            if (!textarea) return;
            const current = textarea.value.trim();
            if (current.includes(text)) return;

            if (current.length === 0) {
                textarea.value = text;
            } else {
                textarea.value = current + ', ' + text;
            }

            const reasonError = document.getElementById('reasonErrorMsg');
            if (reasonError) reasonError.classList.add('d-none');
            textarea.classList.remove('is-invalid');
            textarea.focus();
        }

        // Cập Nhật Tóm Tắt (Bước 5)
        function updateSummary() {
            document.getElementById('summaryDept').innerText = selectedService.deptName || '--';
            document.getElementById('summaryService').innerText = selectedService.name || '--';
            document.getElementById('summaryDuration').innerText = (selectedService.duration ? selectedService.duration + ' phút' : '30 phút');
            document.getElementById('summaryPrice').innerText = selectedService.price || 'Liên hệ';

            const dateVal = document.getElementById('inputAppointmentDate').value;
            document.getElementById('summaryDate').innerText = formatDayOfWeek(dateVal);
            document.getElementById('summarySlot').innerText = selectedSlot ? selectedSlot.display : '--';
            document.getElementById('summaryDentist').innerText = selectedDentist.name;
            document.getElementById('summaryReason').innerText = document.getElementById('inputReasonForVisit').value.trim() || '--';
        }

        // Cập Nhật Thanh Sticky Bên Phải
        function updateSidePanel() {
            // Dịch vụ
            if (selectedService.id > 0) {
                document.getElementById('sideServiceName').innerText = selectedService.name;
                document.getElementById('sideDeptName').innerHTML = `<i class="bi bi-hospital me-1 text-primary"></i>Khoa: ${selectedService.deptName}`;
                document.getElementById('sideDurationText').innerText = `${selectedService.duration} phút`;
                document.getElementById('sidePriceText').innerText = selectedService.price;
            } else {
                document.getElementById('sideServiceName').innerText = 'Chưa chọn dịch vụ';
                document.getElementById('sideDeptName').innerText = 'Vui lòng chọn ở Bước 1';
                document.getElementById('sideDurationText').innerText = '--';
                document.getElementById('sidePriceText').innerText = '--';
            }

            // Thời gian
            const dateVal = document.getElementById('inputAppointmentDate').value;
            document.getElementById('sideDateText').innerText = formatDayOfWeek(dateVal) || 'Chưa chọn ngày';
            document.getElementById('sideSlotText').innerText = selectedSlot ? ('Giờ: ' + selectedSlot.display) : 'Chưa chọn giờ';

            // Bác sĩ
            document.getElementById('sideDentistName').innerHTML = `<i class="bi bi-person-badge text-primary me-1"></i>${selectedDentist.name}`;

            // Nút hành động bên phải
            const sideBtn = document.getElementById('sideActionButton');
            if (!sideBtn) return;

            if (currentStep === 1) {
                sideBtn.innerHTML = 'Tiếp tục: Ngày & Bác sĩ <i class="bi bi-arrow-right ms-1"></i>';
                sideBtn.className = 'btn btn-primary w-100 fw-bold py-2 shadow-sm';
                sideBtn.disabled = (selectedService.id === 0);
            } else if (currentStep === 2) {
                sideBtn.innerHTML = 'Tiếp tục: Chọn giờ hẹn <i class="bi bi-arrow-right ms-1"></i>';
                sideBtn.className = 'btn btn-primary w-100 fw-bold py-2 shadow-sm';
                sideBtn.disabled = false;
            } else if (currentStep === 3) {
                sideBtn.innerHTML = 'Tiếp tục: Nhập triệu chứng <i class="bi bi-arrow-right ms-1"></i>';
                sideBtn.className = 'btn btn-primary w-100 fw-bold py-2 shadow-sm';
                sideBtn.disabled = !selectedSlot;
            } else if (currentStep === 4) {
                sideBtn.innerHTML = 'Tiếp tục: Xem lại & Xác nhận <i class="bi bi-arrow-right ms-1"></i>';
                sideBtn.className = 'btn btn-primary w-100 fw-bold py-2 shadow-sm';
                sideBtn.disabled = false;
            } else if (currentStep === 5) {
                sideBtn.innerHTML = '<i class="bi bi-send-check me-1"></i> Xác Nhận Đặt Lịch';
                sideBtn.className = 'btn btn-success w-100 fw-bold py-2 shadow-sm';
                sideBtn.disabled = false;
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            // Ngăn chặn submit lặp kép
            const form = document.getElementById('bookingForm');
            if (form) {
                form.addEventListener('submit', function () {
                    const submitBtn = document.getElementById('btnSubmitBooking');
                    if (submitBtn) {
                        submitBtn.disabled = true;
                        submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span> Đang gửi yêu cầu...';
                    }
                    const sideBtn = document.getElementById('sideActionButton');
                    if (sideBtn) {
                        sideBtn.disabled = true;
                        sideBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span> Đang gửi...';
                    }
                });
            }

            // Khởi tạo text ngày hôm nay/ngày mai
            const initialDateInput = document.getElementById('inputAppointmentDate');
            if (initialDateInput) {
                const fullText = formatDayOfWeek(initialDateInput.value);
                const dateElem = document.getElementById('dateTextFull');
                if (dateElem) dateElem.innerText = fullText;
            }

            // Gán click cho từng service card
            document.querySelectorAll('#servicesGrid .service-item').forEach(item => {
                const card = item.querySelector('.service-card');
                if (!card) return;

                card.addEventListener('click', function () {
                    const serviceId = parseInt(item.getAttribute('data-service-id')) || 0;
                    const deptId = parseInt(item.getAttribute('data-dept-id')) || 0;
                    const deptName = item.getAttribute('data-dept-name') || '';
                    const name = item.getAttribute('data-name') || '';
                    const duration = parseInt(item.getAttribute('data-duration')) || 30;
                    const price = item.getAttribute('data-price') || 'Liên hệ';
                    const isComplex = item.getAttribute('data-is-complex') === 'true';

                    selectService(serviceId, name, deptId, deptName, card, duration, price, isComplex);
                });
            });

            // Tự động chọn pre-selected service / department nếu có
            const preSelectedServiceId = parseInt('@Model.RequestedServiceId') || 0;
            const preSelectedDeptId = parseInt('@Model.DepartmentId') || 0;

            if (preSelectedServiceId > 0) {
                const targetCard = document.querySelector(`.service-item[data-service-id="${preSelectedServiceId}"]`);
                if (targetCard) {
                    const cardInner = targetCard.querySelector('.service-card');
                    if (cardInner) cardInner.click();
                }
            } else if (preSelectedDeptId > 0) {
                const deptSelect = document.getElementById('deptFilterSelect');
                if (deptSelect) {
                    deptSelect.value = preSelectedDeptId;
                    filterServices();
                }
            }

            updateSidePanel();
        });
    </script>
}
