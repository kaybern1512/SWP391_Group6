@model DentalClinic.Web.ViewModels.Appointments.PatientBookViewModel
@{
    ViewData["Title"] = "Đặt lịch khám nha khoa";
}

<div class="container-fluid px-0">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-calendar-plus text-primary me-2"></i>Đặt Lịch Khám Nha Khoa Trực Tuyến
            </h1>
            <p class="text-muted mb-0">Hệ thống phòng khám DentalCare &bull; Đặt hẹn theo nhu cầu & dịch vụ khám nhanh chóng</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Danh sách lịch hẹn
            </a>
        </div>
    </div>

    @if (Model.Eligibility != null && !Model.Eligibility.IsEligible)
    {
        <div class="card border-danger shadow-sm mb-4">
            <div class="card-body p-4 text-center">
                <div class="rounded-circle bg-danger-subtle text-danger d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                    <i class="bi bi-slash-circle fs-1"></i>
                </div>
                <h4 class="fw-bold text-danger mb-2">Tài Khoản Tạm Khóa Quyền Tự Đặt Lịch Online</h4>
                <p class="text-muted fs-6 mb-3 mx-auto" style="max-width: 650px;">
                    @Model.Eligibility.BlockReason
                </p>
                <div class="alert alert-warning border-warning d-inline-block text-start py-2 px-4 mb-4">
                    <i class="bi bi-telephone-fill text-warning me-2"></i>
                    Quý khách có nhu cầu khám chữa bệnh, vui lòng liên hệ hotline: <strong class="fs-5 text-dark ms-1">1900 1234</strong> hoặc đến trực tiếp phòng khám để được Lễ tân hỗ trợ.
                </div>
                <div>
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">
                        <i class="bi bi-calendar3 me-1"></i> Xem danh sách lịch hẹn của tôi
                    </a>
                </div>
            </div>
        </div>
    }
    else
    {
        @if (Model.Eligibility != null && Model.Eligibility.StrikeCount > 0)
        {
            <div class="alert alert-warning border-warning shadow-sm mb-4 py-2 d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center">
                    <i class="bi bi-exclamation-triangle-fill fs-5 me-2 text-warning"></i>
                    <div class="small">
                        <strong>Lưu ý chính sách hủy lịch:</strong> Tài khoản của bạn đang có <strong>@Model.Eligibility.StrikeCount / 3</strong> lần vi phạm trong 30 ngày qua (hủy sát giờ &lt;12h hoặc không đến khám). Vui lòng cân nhắc sắp xếp thời gian hợp lý khi đặt lịch để tránh bị tạm khóa quyền đặt lịch trực tuyến 30 ngày.
                    </div>
                </div>
                <span class="badge bg-warning text-dark px-2 py-1">@Model.Eligibility.StrikeCount/3 Vi phạm</span>
            </div>
        }

        <!-- Stepper Navigation (5 Bước Trực Quan) -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center text-center position-relative stepper-wrapper">
                    <div class="step-item active" id="step-nav-1" onclick="goToStep(1)">
                        <div class="step-circle"><i class="bi bi-heart-pulse"></i></div>
                        <div class="step-label">1. Dịch vụ khám</div>
                    </div>
                    <div class="step-line"></div>
                    <div class="step-item" id="step-nav-2" onclick="goToStep(2)">
                        <div class="step-circle"><i class="bi bi-calendar2-date"></i></div>
                        <div class="step-label">2. Ngày & Bác sĩ</div>
                    </div>
                    <div class="step-line"></div>
                    <div class="step-item" id="step-nav-3" onclick="goToStep(3)">
                        <div class="step-circle"><i class="bi bi-clock"></i></div>
                        <div class="step-label">3. Giờ hẹn</div>
                    </div>
                    <div class="step-line"></div>
                    <div class="step-item" id="step-nav-4" onclick="goToStep(4)">
                        <div class="step-circle"><i class="bi bi-card-text"></i></div>
                        <div class="step-label">4. Triệu chứng</div>
                    </div>
                    <div class="step-line"></div>
                    <div class="step-item" id="step-nav-5" onclick="goToStep(5)">
                        <div class="step-circle"><i class="bi bi-check-circle"></i></div>
                        <div class="step-label">5. Xác nhận</div>
                    </div>
                </div>
            </div>
        </div>

        <form asp-action="Book" method="post" id="bookingForm">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

            <input type="hidden" asp-for="DepartmentId" id="hiddenDepartmentId" />
            <input type="hidden" asp-for="RequestedServiceId" id="hiddenServiceId" />
            <input type="hidden" asp-for="RequestedDentistUserId" id="hiddenDentistId" />
            <input type="hidden" asp-for="ScheduledStart" id="hiddenScheduledStart" />

            <div class="row g-4">
                <!-- MAIN FORM STEPS (Cột Bên Trái 8/12) -->
                <div class="col-lg-8">

                    <!-- STEP 1: CHỌN NHU CẦU / DỊCH VỤ KHÁM (WF-02) -->
                    <div class="step-panel" id="step-panel-1">
                        <div class="card border-0 shadow-sm">
                            <div class="card-header bg-white py-3 border-bottom">
                                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                    <div>
                                        <h5 class="card-title mb-1 fw-bold text-primary">
                                            <i class="bi bi-heart-pulse me-2"></i>Bước 1: Chọn Nhu Cầu Khám Hoặc Dịch Vụ Khám
                                        </h5>
                                        <p class="text-muted small mb-0">Hệ thống sẽ <strong>tự động nhận diện nhóm chuyên môn tiếp nhận</strong> từ dịch vụ bạn lựa chọn.</p>
                                    </div>
                                    <span class="badge bg-primary-subtle text-primary px-3 py-2 fs-6 rounded-pill" id="badgeServiceCount">
                                        @Model.Services.Count dịch vụ khả dụng
                                    </span>
                                </div>
                            </div>
                            <div class="card-body p-4">
                                <!-- Thanh tìm kiếm nhanh & Bộ lọc phân loại theo Nhóm Dịch Vụ Khám -->
                                <div class="row g-3 mb-4">
                                    <div class="col-md-7">
                                        <div class="input-group">
                                            <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                                            <input type="text" id="serviceSearchInput" class="form-control border-start-0" placeholder="Tìm theo tên dịch vụ (cạo vôi, nhổ răng khôn, niềng răng, trám răng...)" onkeyup="filterServices()" />
                                        </div>
                                    </div>
                                    <div class="col-md-5">
                                        <select id="deptFilterSelect" class="form-select" onchange="filterServices()">
                                            <option value="0">Tất cả nhóm dịch vụ khám (@Model.Departments.Count nhóm)</option>
                                            @foreach (var dept in Model.Departments)
                                            {
                                                <option value="@dept.DepartmentId" selected="@(Model.DepartmentId == dept.DepartmentId ? "selected" : null)">
                                                    Nhóm: @dept.Name
                                                </option>
                                            }
                                        </select>
                                    </div>
                                </div>

                                <!-- Banner thông báo dịch vụ được chọn -->
                                <div id="serviceSelectedAlert" class="alert alert-success border-success d-none py-3 px-3 mb-4 rounded-3 shadow-sm">
                                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="bi bi-check-circle-fill fs-4 text-success"></i>
                                            <div>
                                                <div class="small text-muted">Dịch vụ bạn đang chọn:</div>
                                                <strong id="alertServiceName" class="text-success fs-6"></strong>
                                                <span class="text-muted ms-2">&bull; Nhóm chuyên môn: <span id="alertDeptName" class="text-dark fw-semibold"></span></span>
                                            </div>
                                        </div>
                                        <div>
                                            <span class="badge bg-success-subtle text-success border border-success px-3 py-2">
                                                <i class="bi bi-check2 me-1"></i>Đã chọn
                                            </span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Lưới danh sách dịch vụ (Bỏ hoàn toàn giá tiền và thời lượng theo yêu cầu) -->
                                <div class="row g-3" id="servicesGrid">
                                    @if (Model.Services.Count == 0)
                                    {
                                        <div class="col-12 text-center text-muted py-5">
                                            <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                            Hiện chưa có dịch vụ nào đang mở đặt lịch trực tuyến.
                                        </div>
                                    }
                                    else
                                    {
                                        @foreach (var svc in Model.Services)
                                        {
                                            var deptName = !string.IsNullOrWhiteSpace(svc.DepartmentName) ? svc.DepartmentName : "Chuyên khoa tiếp nhận";
                                            var isSelected = Model.RequestedServiceId == svc.DepartmentServiceId;

                                            <div class="col-md-6 service-item" 
                                                 data-service-id="@svc.DepartmentServiceId" 
                                                 data-dept-id="@svc.DepartmentId" 
                                                 data-dept-name="@deptName" 
                                                 data-name="@svc.ServiceName">
                                                <div class="card h-100 selection-card service-card p-3 @(isSelected ? "active" : "")">
                                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                                        <h6 class="fw-bold mb-0 text-dark flex-grow-1 pe-2 service-name-title">@svc.ServiceName</h6>
                                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle small text-truncate" style="max-width: 160px;" title="@deptName">
                                                            @deptName
                                                        </span>
                                                    </div>
                                                    <p class="text-muted small mb-3 flex-grow-1 service-desc-text">
                                                        @(string.IsNullOrWhiteSpace(svc.Description) ? "Thăm khám, kiểm tra và chẩn đoán điều trị theo tiêu chuẩn nha khoa chất lượng cao." : svc.Description)
                                                    </p>
                                                    <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                                        <span class="text-primary small fw-semibold">
                                                            <i class="bi bi-check2-circle me-1"></i>Chọn dịch vụ khám này
                                                        </span>
                                                        <span class="selection-arrow text-muted">
                                                            <i class="bi bi-chevron-right"></i>
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                        <div id="filterEmptyAlert" class="col-12 text-center text-muted py-5 d-none">
                                            <i class="bi bi-search fs-1 d-block mb-2 text-secondary"></i>
                                            <h6>Không tìm thấy dịch vụ nào phù hợp với từ khóa tìm kiếm.</h6>
                                            <p class="small text-muted mb-0">Vui lòng chọn <strong>"Tất cả nhóm dịch vụ khám"</strong> hoặc thử từ khóa khác (ví dụ: <em>khám, cạo vôi, trám răng, nhổ răng, niềng răng...</em>).</p>
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="card-footer bg-white text-end py-3 border-top">
                                <button type="button" class="btn btn-primary btn-lg px-4 shadow-sm" id="btnNext1" disabled onclick="goToStep(2)">
                                    Tiếp tục: Ngày & Bác sĩ khám <i class="bi bi-arrow-right ms-1"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- STEP 2: CHỌN NGÀY VÀ BÁC SĨ (WF-02) -->
                    <div class="step-panel d-none" id="step-panel-2">
                        <div class="card border-0 shadow-sm">
                            <div class="card-header bg-white py-3 border-bottom">
                                <h5 class="card-title mb-0 fw-bold text-primary">
                                    <i class="bi bi-calendar2-date me-2"></i>Bước 2: Chọn Ngày Hẹn & Bác Sĩ Mong Muốn
                                </h5>
                            </div>
                            <div class="card-body p-4">
                                <!-- Banner thông tin dịch vụ đang chọn -->
                                <div class="card bg-light-subtle border mb-4 p-3 rounded-3">
                                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                        <div>
                                            <span class="badge bg-primary-subtle text-primary mb-1">Dịch vụ đã chọn</span>
                                            <h6 class="mb-1 fw-bold text-dark fs-5" id="panel2ServiceName">--</h6>
                                            <div class="text-muted small">
                                                <i class="bi bi-hospital me-1 text-primary"></i>Nhóm chuyên môn phụ trách: <strong class="text-dark" id="panel2DeptName">--</strong>
                                            </div>
                                        </div>
                                        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="goToStep(1)">
                                            <i class="bi bi-pencil me-1"></i> Đổi dịch vụ khác
                                        </button>
                                    </div>
                                </div>

                                <div class="row g-4">
                                    <!-- Chọn ngày -->
                                    <div class="col-md-5">
                                        <label class="form-label fw-bold">1. Chọn ngày bạn muốn đến khám: <span class="text-danger">*</span></label>
                                        
                                        <!-- Quick date buttons -->
                                        <div class="d-flex gap-2 mb-2">
                                            <button type="button" class="btn btn-outline-primary btn-sm flex-fill" onclick="setQuickDate(0)">Hôm nay</button>
                                            <button type="button" class="btn btn-outline-primary btn-sm flex-fill" onclick="setQuickDate(1)">Ngày mai</button>
                                            <button type="button" class="btn btn-outline-primary btn-sm flex-fill" onclick="setQuickDate(2)">Ngày kia</button>
                                        </div>

                                        <input type="date" asp-for="AppointmentDate" id="inputAppointmentDate" class="form-control form-control-lg fw-bold" min="@DateTime.Today.ToString("yyyy-MM-dd")" onchange="onDateOrDentistChange()" />
                                        <div id="selectedDateDisplay" class="text-primary fw-semibold small mt-2">
                                            <i class="bi bi-calendar-event me-1"></i><span id="dateTextFull"></span>
                                        </div>
                                        <small class="text-muted mt-2 d-block">
                                            <i class="bi bi-info-circle me-1"></i>Phòng khám mở cửa đón tiếp tất cả các ngày từ <strong>08:00 đến 20:00</strong>.
                                        </small>
                                    </div>

                                    <!-- Chọn bác sĩ mong muốn (WF-02: Bác sĩ được chọn chỉ là mong muốn trước khi Manager/Trưởng khoa xác nhận) -->
                                    <div class="col-md-7">
                                        <label class="form-label fw-bold">2. Bác sĩ mong muốn khám (Tùy chọn):</label>
                                        <div class="row g-2" id="dentistOptionsGrid">
                                            <div class="col-12">
                                                <div class="card selection-card p-3 active dentist-card" data-dentist-id="" onclick="selectDentist(null, 'Bất kỳ bác sĩ khả dụng')">
                                                    <div class="d-flex align-items-center gap-3">
                                                        <div class="selection-icon bg-primary-subtle text-primary">
                                                            <i class="bi bi-people-fill fs-4"></i>
                                                        </div>
                                                        <div class="flex-grow-1">
                                                            <div class="d-flex align-items-center gap-2">
                                                                <span class="fw-bold text-dark">Bác sĩ khả dụng bất kỳ</span>
                                                                <span class="badge bg-success-subtle text-success border border-success small">Khuyên dùng</span>
                                                            </div>
                                                            <small class="text-muted d-block">Trưởng khoa sẽ tự động sắp xếp bác sĩ chuyên môn còn trống lịch sớm nhất cho bạn.</small>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-12 text-center py-3 d-none" id="dentistLoading">
                                                <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                                                <small class="text-muted ms-2">Đang tải danh sách bác sĩ chuyên môn...</small>
                                            </div>
                                            <div class="col-12" id="dentistDynamicList"></div>
                                        </div>
                                        <div class="alert alert-light border rounded-3 p-2 mt-2 mb-0 small text-muted">
                                            <i class="bi bi-shield-check text-primary me-1"></i><strong>Quy tắc phân bổ (WF-02):</strong> Lựa chọn bác sĩ mang tính chất nguyện vọng; Trưởng khoa sẽ chính thức phê duyệt và phân bổ bác sĩ khi xét duyệt lịch hẹn.
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="card-footer bg-white d-flex justify-content-between py-3 border-top">
                                <button type="button" class="btn btn-outline-secondary" onclick="goToStep(1)">
                                    <i class="bi bi-arrow-left me-1"></i> Quay lại
                                </button>
                                <button type="button" class="btn btn-primary px-4 shadow-sm" id="btnNext2" onclick="goToStep(3)">
                                    Tiếp tục: Chọn giờ hẹn <i class="bi bi-arrow-right ms-1"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- STEP 3: CHỌN GIỜ HẸN KHÁM -->
                    <div class="step-panel d-none" id="step-panel-3">
                        <div class="card border-0 shadow-sm">
                            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <div>
                                    <h5 class="card-title mb-0 fw-bold text-primary">
                                        <i class="bi bi-clock me-2"></i>Bước 3: Chọn Giờ Hẹn Khám Còn Trống
                                    </h5>
                                    <p class="text-muted small mb-0">Chọn khung giờ bạn thuận tiện đến phòng khám nhất</p>
                                </div>
                                <span class="badge bg-light text-dark border px-3 py-2 small" id="slotFilterSummary"></span>
                            </div>
                            <div class="card-body p-4">
                                <div id="slotsLoading" class="text-center py-5 d-none">
                                    <div class="spinner-border text-primary" role="status"></div>
                                    <p class="mt-2 text-muted fw-semibold">Đang tra cứu lịch làm việc và khung giờ trống...</p>
                                </div>

                                <div id="noSlotsMessage" class="alert alert-warning d-none text-center py-4 border-warning shadow-sm rounded-3">
                                    <i class="bi bi-calendar-x fs-1 d-block mb-2 text-warning"></i>
                                    <h5 class="fw-bold text-dark mb-2">Chưa tìm thấy khung giờ khám phù hợp</h5>
                                    <p class="text-muted mb-3" id="noSlotsDetailText">
                                        Trong ngày đã chọn, bác sĩ đã kín lịch hoặc ca làm việc đã hết chỗ trống.
                                    </p>
                                    <div class="d-flex justify-content-center gap-2 flex-wrap">
                                        <button type="button" class="btn btn-primary px-3 shadow-sm" onclick="goToStep(2)">
                                            <i class="bi bi-calendar-date me-1"></i> Quay lại Đổi ngày khám
                                        </button>
                                        <button type="button" class="btn btn-outline-primary px-3" onclick="switchToAnyDentistAndReload()">
                                            <i class="bi bi-people me-1"></i> Chọn "Bác sĩ bất kỳ khả dụng"
                                        </button>
                                    </div>
                                </div>

                                <!-- Container chứa các ca sáng / chiều -->
                                <div id="slotsContainerWrapper">
                                    <!-- Ca sáng -->
                                    <div id="morningSection" class="mb-4 d-none">
                                        <h6 class="fw-bold text-dark d-flex align-items-center gap-2 mb-3">
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1">
                                                <i class="bi bi-sun-fill me-1"></i>Buổi Sáng
                                            </span>
                                            <span class="text-muted small">(Khung giờ từ 08:00 đến 12:00)</span>
                                        </h6>
                                        <div class="row g-2" id="morningSlotsGrid"></div>
                                    </div>

                                    <!-- Ca chiều / tối -->
                                    <div id="afternoonSection" class="mb-3 d-none">
                                        <h6 class="fw-bold text-dark d-flex align-items-center gap-2 mb-3">
                                            <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle px-2 py-1">
                                                <i class="bi bi-sunset-fill me-1"></i>Buổi Chiều & Tối
                                            </span>
                                            <span class="text-muted small">(Khung giờ từ 13:30 đến 20:00)</span>
                                        </h6>
                                        <div class="row g-2" id="afternoonSlotsGrid"></div>
                                    </div>
                                </div>

                                <!-- Box thông báo giờ đã chọn -->
                                <div id="slotSelectedAlert" class="alert alert-success border-success d-none py-3 px-3 mt-4 rounded-3 d-flex align-items-center justify-content-between">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-check-circle-fill fs-4 text-success"></i>
                                        <div>
                                            <div class="small text-muted">Giờ hẹn đã chọn:</div>
                                            <strong class="text-success fs-5" id="alertSlotText"></strong>
                                        </div>
                                    </div>
                                    <button type="button" class="btn btn-success px-4" onclick="goToStep(4)">
                                        Tiếp tục <i class="bi bi-arrow-right ms-1"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="card-footer bg-white d-flex justify-content-between py-3 border-top">
                                <button type="button" class="btn btn-outline-secondary" onclick="goToStep(2)">
                                    <i class="bi bi-arrow-left me-1"></i> Quay lại
                                </button>
                                <button type="button" class="btn btn-primary px-4 shadow-sm" id="btnNext3" disabled onclick="goToStep(4)">
                                    Tiếp tục: Nhập triệu chứng <i class="bi bi-arrow-right ms-1"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- STEP 4: MÔ TẢ TRIỆU CHỨNG / LÝ DO KHÁM -->
                    <div class="step-panel d-none" id="step-panel-4">
                        <div class="card border-0 shadow-sm">
                            <div class="card-header bg-white py-3 border-bottom">
                                <h5 class="card-title mb-0 fw-bold text-primary">
                                    <i class="bi bi-card-text me-2"></i>Bước 4: Lý Do Thăm Khám & Triệu Chứng
                                </h5>
                            </div>
                            <div class="card-body p-4">
                                <!-- Quick chips triệu chứng thường gặp -->
                                <div class="mb-4">
                                    <label class="form-label fw-bold text-dark d-block">
                                        <i class="bi bi-magic text-primary me-1"></i>Gợi ý nhanh triệu chứng hoặc nhu cầu (bấm 1 chạm để điền):
                                    </label>
                                    <div class="d-flex flex-wrap gap-2">
                                        <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill quick-chip" onclick="addSymptomChip('Khám tổng quát định kỳ & kiểm tra răng miệng')">
                                            + Khám răng định kỳ
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill quick-chip" onclick="addSymptomChip('Đau buốt răng khi ăn đồ nóng, lạnh hoặc ngọt')">
                                            + Đau buốt khi ăn
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill quick-chip" onclick="addSymptomChip('Lấy cao răng & đánh bóng làm sạch mảng bám')">
                                            + Cạo vôi răng
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill quick-chip" onclick="addSymptomChip('Răng sâu bị thủng lỗ, cần trám răng thẩm mỹ')">
                                            + Răng sâu / Trám răng
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill quick-chip" onclick="addSymptomChip('Răng khôn mọc đau nhức, sưng nướu')">
                                            + Răng khôn mọc đau
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill quick-chip" onclick="addSymptomChip('Muốn khám tư vấn niềng răng / chỉnh nha khớp cắn')">
                                            + Tư vấn niềng răng
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill quick-chip" onclick="addSymptomChip('Chảy máu chân răng khi đánh răng, viêm nướu')">
                                            + Chảy máu nướu
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill quick-chip" onclick="addSymptomChip('Khám tư vấn trồng răng Implant / Bọc răng sứ')">
                                            + Trồng răng Implant
                                        </button>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="ReasonForVisit" class="form-label fw-bold">Mô tả chi tiết tình trạng hoặc lý do khám: <span class="text-danger">*</span></label>
                                    <textarea asp-for="ReasonForVisit" id="inputReasonForVisit" class="form-control" rows="4" placeholder="Ví dụ: Đau nhức răng hàm dưới bên trái khi ăn đồ nóng lạnh, muốn kiểm tra răng tổng quát định kỳ..."></textarea>
                                    <div id="reasonErrorMsg" class="text-danger small mt-1 d-none">
                                        <i class="bi bi-exclamation-circle me-1"></i>Vui lòng nhập lý do khám tối thiểu 5 ký tự để bác sĩ chuẩn bị chu đáo nhất.
                                    </div>
                                    <div class="form-text mt-2 text-muted">
                                        <i class="bi bi-shield-check text-success me-1"></i>Thông tin mô tả sẽ được chuyển trực tiếp cho Bác sĩ tiếp nhận ca khám để chuẩn bị vật tư y tế thích hợp.
                                    </div>
                                </div>
                            </div>
                            <div class="card-footer bg-white d-flex justify-content-between py-3 border-top">
                                <button type="button" class="btn btn-outline-secondary" onclick="goToStep(3)">
                                    <i class="bi bi-arrow-left me-1"></i> Quay lại
                                </button>
                                <button type="button" class="btn btn-primary px-4 shadow-sm" id="btnNext4" onclick="goToStep(5)">
                                    Tiếp tục: Xem lại & Xác nhận <i class="bi bi-arrow-right ms-1"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- STEP 5: XÁC NHẬN VÀ GỬI YÊU CẦU (WF-02) -->
                    <div class="step-panel d-none" id="step-panel-5">
                        <div class="card border-0 shadow-sm">
                            <div class="card-header bg-white py-3 border-bottom">
                                <h5 class="card-title mb-0 fw-bold text-success">
                                    <i class="bi bi-check-circle-fill me-2"></i>Bước 5: Kiểm Tra Lại Thông Tin & Gửi Yêu Cầu Đặt Lịch
                                </h5>
                            </div>
                            <div class="card-body p-4">
                                <div class="alert alert-info border-0 mb-4 shadow-sm rounded-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-info-circle-fill fs-4 text-info flex-shrink-0"></i>
                                        <div class="small">
                                            <strong>Quy trình tiếp nhận (WF-02):</strong> Sau khi gửi, lịch hẹn sẽ ở trạng thái <strong class="badge bg-warning text-dark">Chờ Lễ Tân Tiếp Nhận</strong>. Lễ tân và Trưởng khoa sẽ tiếp nhận, phê duyệt lịch và phân bổ bác sĩ/phòng khám chính thức.
                                        </div>
                                    </div>
                                </div>

                                <!-- Phiếu hẹn khám điện tử (Không hiện giá và thời lượng theo WF-02) -->
                                <div class="border rounded-3 p-4 bg-light-subtle shadow-sm mb-4">
                                    <div class="text-center pb-3 mb-3 border-bottom">
                                        <div class="badge bg-primary px-3 py-2 fs-6 mb-2">PHIẾU ĐĂNG KÝ KHÁM NHA KHOA ĐIỆN TỬ</div>
                                        <h5 class="fw-bold text-dark mb-0">HỆ THỐNG PHÒNG KHÁM NHA KHOA DENTALCARE</h5>
                                    </div>

                                    <div class="row g-4">
                                        <!-- Cột dịch vụ khám -->
                                        <div class="col-md-6 border-end">
                                            <h6 class="fw-bold text-primary text-uppercase small mb-3">
                                                <i class="bi bi-bookmark-check me-1"></i>Dịch Vụ Khám Đăng Ký
                                            </h6>
                                            <table class="table table-borderless table-sm mb-0">
                                                <tr>
                                                    <td class="text-muted" style="width: 150px;">Dịch vụ khám:</td>
                                                    <td class="fw-bold text-dark fs-6" id="summaryService">--</td>
                                                </tr>
                                                <tr>
                                                    <td class="text-muted">Nhóm chuyên môn:</td>
                                                    <td class="fw-semibold text-secondary" id="summaryDept">--</td>
                                                </tr>
                                                <tr>
                                                    <td class="text-muted">Bác sĩ mong muốn:</td>
                                                    <td class="fw-semibold text-dark" id="summaryDentist">Bất kỳ bác sĩ khả dụng</td>
                                                </tr>
                                            </table>
                                        </div>

                                        <!-- Cột thời gian hẹn -->
                                        <div class="col-md-6">
                                            <h6 class="fw-bold text-primary text-uppercase small mb-3">
                                                <i class="bi bi-clock-history me-1"></i>Thời Gian Hẹn Khám
                                            </h6>
                                            <table class="table table-borderless table-sm mb-0">
                                                <tr>
                                                    <td class="text-muted" style="width: 140px;">Ngày khám:</td>
                                                    <td class="fw-bold text-dark fs-6" id="summaryDate">--</td>
                                                </tr>
                                                <tr>
                                                    <td class="text-muted">Giờ hẹn:</td>
                                                    <td class="fw-bold text-success fs-5" id="summarySlot">--</td>
                                                </tr>
                                                <tr>
                                                    <td class="text-muted">Lý do khám:</td>
                                                    <td class="fst-italic text-break" id="summaryReason">--</td>
                                                </tr>
                                            </table>
                                        </div>
                                    </div>
                                </div>

                                <div class="alert alert-light border rounded-3 p-3 small text-muted">
                                    <i class="bi bi-shield-check text-success me-1"></i><strong>Quy tắc kiểm soát:</strong> Không phân bổ ghế/phòng khám ở bước này; phòng khám và bác sĩ phụ trách chính thức sẽ được thông báo sau khi Lễ tân & Trưởng khoa xét duyệt.
                                </div>
                            </div>
                            <div class="card-footer bg-white d-flex justify-content-between py-3 border-top">
                                <button type="button" class="btn btn-outline-secondary" onclick="goToStep(4)">
                                    <i class="bi bi-arrow-left me-1"></i> Sửa lại thông tin
                                </button>
                                <button type="submit" id="btnSubmitBooking" class="btn btn-success btn-lg px-5 shadow fw-bold">
                                    <i class="bi bi-send-check me-2"></i> Xác Nhận Gửi Yêu Cầu Đặt Lịch
                                </button>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- STICKY BOOKING SUMMARY PANEL (Cột Bên Phải 4/12) -->
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm sticky-top" style="top: 85px; z-index: 10;">
                        <div class="card-header bg-primary text-white py-3">
                            <h5 class="card-title mb-0 fw-bold fs-6">
                                <i class="bi bi-clipboard2-check me-2"></i>Tóm Tắt Yêu Cầu Đặt Lịch
                            </h5>
                        </div>
                        <div class="card-body p-3">
                            <!-- Dịch vụ -->
                            <div class="mb-3 pb-3 border-bottom">
                                <div class="text-muted small text-uppercase fw-semibold mb-1">Dịch vụ khám:</div>
                                <div class="fw-bold text-dark fs-6" id="sideServiceName">Chưa chọn dịch vụ</div>
                                <div class="text-muted small mt-1" id="sideDeptName">
                                    <i class="bi bi-hospital me-1"></i>Vui lòng chọn ở Bước 1
                                </div>
                            </div>

                            <!-- Thời gian khám -->
                            <div class="mb-3 pb-3 border-bottom">
                                <div class="text-muted small text-uppercase fw-semibold mb-1">Thời gian hẹn khám:</div>
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <i class="bi bi-calendar3 text-primary"></i>
                                    <span class="fw-semibold text-dark" id="sideDateText">Chưa chọn ngày</span>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-clock text-primary"></i>
                                    <span class="fw-semibold text-dark" id="sideSlotText">Chưa chọn giờ</span>
                                </div>
                            </div>

                            <!-- Bác sĩ mong muốn -->
                            <div class="mb-3 pb-3 border-bottom">
                                <div class="text-muted small text-uppercase fw-semibold mb-1">Bác sĩ mong muốn:</div>
                                <div class="fw-semibold text-dark" id="sideDentistName">
                                    <i class="bi bi-person-badge text-primary me-1"></i>Bất kỳ bác sĩ khả dụng
                                </div>
                            </div>

                            <!-- Trạng thái sau gửi -->
                            <div class="p-2 bg-light rounded small text-muted mb-3">
                                <div class="d-flex align-items-center gap-1 mb-1">
                                    <i class="bi bi-hourglass-split text-warning fw-bold"></i> Trạng thái sau gửi: <strong>Chờ Lễ tân tiếp nhận</strong>
                                </div>
                                <div class="d-flex align-items-center gap-1">
                                    <i class="bi bi-shield-check text-success fw-bold"></i> Dời / hủy lịch linh hoạt trước 12h
                                </div>
                            </div>

                            <!-- Nút hành động nhanh -->
                            <button type="button" class="btn btn-primary w-100 fw-bold py-2 shadow-sm" id="sideActionButton" onclick="onSideActionClick()">
                                Tiếp tục: Ngày & Bác sĩ <i class="bi bi-arrow-right ms-1"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    }
</div>

<style>
/* Stepper Styles */
.stepper-wrapper {
    position: relative;
    padding: 0 10px;
}
.step-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    z-index: 2;
    cursor: pointer;
    min-width: 80px;
}
.step-circle {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background-color: #f1f5f9;
    color: #64748b;
    border: 2px solid #e2e8f0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    margin-bottom: 6px;
    transition: all 0.25s ease;
}
.step-label {
    font-size: 0.82rem;
    font-weight: 600;
    color: #64748b;
    white-space: nowrap;
}
.step-item.active .step-circle {
    background-color: #0d6efd;
    border-color: #0d6efd;
    color: #fff;
    box-shadow: 0 0 0 4px rgba(13, 110, 253, 0.2);
}
.step-item.active .step-label {
    color: #0d6efd;
}
.step-item.completed .step-circle {
    background-color: #198754;
    border-color: #198754;
    color: #fff;
}
.step-item.completed .step-label {
    color: #198754;
}
.step-line {
    flex-grow: 1;
    height: 3px;
    background-color: #e2e8f0;
    margin: 0 8px;
    margin-bottom: 24px;
}

/* Card Selection */
.selection-card {
    cursor: pointer;
    border: 2px solid #e2e8f0;
    transition: all 0.2s ease-in-out;
    border-radius: 12px;
    background-color: #ffffff;
}
.selection-card:hover {
    border-color: #0d6efd;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(13, 110, 253, 0.12);
}
.selection-card.active {
    border-color: #0d6efd;
    background-color: #f0f7ff;
    box-shadow: 0 6px 16px rgba(13, 110, 253, 0.18);
}
.selection-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
}

/* Slot Card */
.slot-btn {
    cursor: pointer;
    border: 1.5px solid #e2e8f0;
    border-radius: 10px;
    padding: 12px 8px;
    text-align: center;
    background-color: #fff;
    transition: all 0.2s ease;
}
.slot-btn:hover {
    border-color: #0d6efd;
    background-color: #f0f7ff;
    transform: translateY(-1px);
}
.slot-btn.active {
    border-color: #0d6efd;
    background-color: #0d6efd;
    color: #fff !important;
    box-shadow: 0 4px 12px rgba(13, 110, 253, 0.25);
}
.slot-btn.active .text-muted,
.slot-btn.active .badge {
    color: #ffffff !important;
}

.quick-chip {
    transition: all 0.15s ease;
}
.quick-chip:hover {
    background-color: #0d6efd;
    color: #fff;
    border-color: #0d6efd;
}
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        let currentStep = 1;
        let selectedService = { id: 0, name: '', deptId: 0, deptName: '' };
        let selectedDentist = { id: null, name: 'Bất kỳ bác sĩ khả dụng' };
        let selectedSlot = null;
        let isSubmitting = false;

        function formatDayOfWeek(dateString) {
            if (!dateString) return '';
            const parts = dateString.split('-');
            if (parts.length !== 3) return '';
            const d = new Date(parts[0], parts[1] - 1, parts[2]);
            const days = ['Chủ Nhật', 'Thứ Hai', 'Thứ Ba', 'Thứ Tư', 'Thứ Năm', 'Thứ Sáu', 'Thứ Bảy'];
            return `${days[d.getDay()]}, ${parts[2]}/${parts[1]}/${parts[0]}`;
        }

        function goToStep(step) {
            if (step > currentStep) {
                if (currentStep === 1 && selectedService.id === 0) {
                    if (window.toastWarning) {
                        window.toastWarning('Vui lòng chọn một nhu cầu khám hoặc dịch vụ nha khoa để tiếp tục.', 'Yêu Cầu Chọn');
                    } else {
                        alert('Vui lòng chọn một nhu cầu khám hoặc dịch vụ nha khoa để tiếp tục.');
                    }
                    return;
                }
                if (currentStep === 2) {
                    const dateVal = document.getElementById('inputAppointmentDate').value;
                    if (!dateVal) {
                        alert('Vui lòng chọn ngày bạn muốn đến khám.');
                        return;
                    }
                }
                if (currentStep === 3 && !selectedSlot) {
                    if (window.toastWarning) {
                        window.toastWarning('Vui lòng chọn một khung giờ hẹn còn trống để tiếp tục.', 'Yêu Cầu Chọn');
                    } else {
                        alert('Vui lòng chọn một khung giờ hẹn còn trống để tiếp tục.');
                    }
                    return;
                }
                if (currentStep === 4) {
                    const reason = document.getElementById('inputReasonForVisit').value.trim();
                    const reasonError = document.getElementById('reasonErrorMsg');
                    const reasonInput = document.getElementById('inputReasonForVisit');
                    if (reason.length < 5) {
                        if (reasonError) reasonError.classList.remove('d-none');
                        if (reasonInput) {
                            reasonInput.classList.add('is-invalid');
                            reasonInput.focus();
                        }
                        return;
                    }
                    if (reasonError) reasonError.classList.add('d-none');
                    if (reasonInput) reasonInput.classList.remove('is-invalid');
                    updateSummary();
                }
            }

            for (let i = 1; i <= 5; i++) {
                const panel = document.getElementById(`step-panel-${i}`);
                if (panel) panel.classList.add('d-none');
                const nav = document.getElementById(`step-nav-${i}`);
                if (nav) {
                    nav.classList.remove('active');
                    if (i < step) {
                        nav.classList.add('completed');
                    } else {
                        nav.classList.remove('completed');
                    }
                }
            }

            const currentPanel = document.getElementById(`step-panel-${step}`);
            if (currentPanel) currentPanel.classList.remove('d-none');
            const currentNav = document.getElementById(`step-nav-${step}`);
            if (currentNav) currentNav.classList.add('active');

            currentStep = step;
            updateSidePanel();

            if (step === 3) {
                loadSlots();
            }

            // Scroll to top of panel smoothly
            window.scrollTo({ top: 120, behavior: 'smooth' });
        }

        // BƯỚC 1: Chọn dịch vụ & Tự động gán Khoa (WF-02)
        function selectService(id, name, deptId, deptName, cardElem) {
            selectedService = { id, name, deptId, deptName };

            document.getElementById('hiddenServiceId').value = id;
            document.getElementById('hiddenDepartmentId').value = deptId;

            // Highlight card
            document.querySelectorAll('#servicesGrid .service-card').forEach(c => c.classList.remove('active'));
            if (cardElem) cardElem.classList.add('active');

            // Banner thông báo
            const alertBox = document.getElementById('serviceSelectedAlert');
            if (alertBox) {
                alertBox.classList.remove('d-none');
                document.getElementById('alertServiceName').innerText = name;
                document.getElementById('alertDeptName').innerText = deptName;
            }

            // Cập nhật thông tin cho Bước 2
            document.getElementById('panel2ServiceName').innerText = name;
            document.getElementById('panel2DeptName').innerText = deptName;

            // Kích hoạt nút Next Bước 1
            document.getElementById('btnNext1').disabled = false;

            updateSidePanel();
            loadDentists(deptId);
        }

        // BƯỚC 1: Lọc dịch vụ theo từ khóa & Nhóm dịch vụ khám
        function filterServices() {
            const query = (document.getElementById('serviceSearchInput').value || '').trim().toLowerCase();
            const deptFilter = parseInt(document.getElementById('deptFilterSelect').value) || 0;

            let visibleCount = 0;
            document.querySelectorAll('#servicesGrid .service-item').forEach(item => {
                const name = (item.getAttribute('data-name') || '').toLowerCase();
                const deptName = (item.getAttribute('data-dept-name') || '').toLowerCase();
                const deptId = parseInt(item.getAttribute('data-dept-id')) || 0;

                const matchQuery = !query || name.includes(query) || deptName.includes(query);
                const matchDept = deptFilter === 0 || deptId === deptFilter;

                if (matchQuery && matchDept) {
                    item.style.display = '';
                    visibleCount++;
                } else {
                    item.style.display = 'none';
                }
            });

            const badge = document.getElementById('badgeServiceCount');
            if (badge) badge.innerText = `${visibleCount} dịch vụ phù hợp`;

            const emptyAlert = document.getElementById('filterEmptyAlert');
            if (emptyAlert) {
                emptyAlert.classList.toggle('d-none', visibleCount > 0);
            }
        }

        // BƯỚC 2: Quick Date Buttons
        function setQuickDate(offsetDays) {
            const d = new Date();
            d.setDate(d.getDate() + offsetDays);
            const year = d.getFullYear();
            const month = String(d.getMonth() + 1).padStart(2, '0');
            const day = String(d.getDate()).padStart(2, '0');
            const dateStr = `${year}-${month}-${day}`;
            const input = document.getElementById('inputAppointmentDate');
            if (input) {
                input.value = dateStr;
                onDateOrDentistChange();
            }
        }

        function onDateOrDentistChange() {
            selectedSlot = null;
            document.getElementById('hiddenScheduledStart').value = '';
            document.getElementById('btnNext3').disabled = true;

            const dateInput = document.getElementById('inputAppointmentDate');
            if (dateInput) {
                const fullText = formatDayOfWeek(dateInput.value);
                const dateElem = document.getElementById('dateTextFull');
                if (dateElem) dateElem.innerText = fullText;
            }

            updateSidePanel();
        }

        let initialDentistId = parseInt('@Model.RequestedDentistUserId') || null;

        async function loadDentists(departmentId) {
            const list = document.getElementById('dentistDynamicList');
            const loading = document.getElementById('dentistLoading');
            if (!list) return;
            list.innerHTML = '';
            if (loading) loading.classList.remove('d-none');

            try {
                const res = await fetch(`/Patient/Appointment/GetDentists?departmentId=${departmentId}`);
                const dentists = await res.json();
                if (loading) loading.classList.add('d-none');

                dentists.forEach(d => {
                    const dId = d.dentistUserId || d.userId;
                    const row = document.createElement('div');
                    row.className = 'mt-2';
                    row.innerHTML = `
                        <div class="card selection-card p-3 dentist-card ${initialDentistId && initialDentistId === dId ? 'active' : ''}" data-dentist-id="${dId}" onclick="selectDentist(${dId}, '${d.fullName}')">
                            <div class="d-flex align-items-center gap-3">
                                <div class="selection-icon bg-light text-primary">
                                    <i class="bi bi-person-badge fs-4"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="fw-bold text-dark">${d.fullName} <span class="badge bg-light text-muted border ms-1">${d.employeeCode || ''}</span></div>
                                    <small class="text-muted">${d.qualification || d.specialization || 'Bác sĩ chuyên khoa'}</small>
                                </div>
                            </div>
                        </div>
                    `;
                    list.appendChild(row);

                    if (initialDentistId && initialDentistId === dId) {
                        selectDentist(dId, d.fullName);
                        initialDentistId = null;
                    }
                });
            } catch (err) {
                if (loading) loading.classList.add('d-none');
                console.error(err);
            }
        }

        function selectDentist(id, name) {
            const dentistId = (id && parseInt(id) > 0) ? parseInt(id) : null;
            selectedDentist = { id: dentistId, name: name };
            document.getElementById('hiddenDentistId').value = dentistId ? dentistId.toString() : '';

            document.querySelectorAll('#dentistOptionsGrid .dentist-card').forEach(c => {
                const cId = c.getAttribute('data-dentist-id');
                const parsedCId = (cId && parseInt(cId) > 0) ? parseInt(cId) : null;

                if (!dentistId && !parsedCId) {
                    c.classList.add('active');
                } else if (dentistId && parsedCId === dentistId) {
                    c.classList.add('active');
                } else {
                    c.classList.remove('active');
                }
            });

            onDateOrDentistChange();
        }

        function switchToAnyDentistAndReload() {
            selectDentist(null, 'Bất kỳ bác sĩ khả dụng');
            loadSlots();
        }

        // BƯỚC 3: Tải khung giờ trống (Available Slots)
        async function loadSlots() {
            const loading = document.getElementById('slotsLoading');
            const noSlots = document.getElementById('noSlotsMessage');
            const morningSection = document.getElementById('morningSection');
            const afternoonSection = document.getElementById('afternoonSection');
            const morningGrid = document.getElementById('morningSlotsGrid');
            const afternoonGrid = document.getElementById('afternoonSlotsGrid');
            const summary = document.getElementById('slotFilterSummary');
            const alertBox = document.getElementById('slotSelectedAlert');

            const date = document.getElementById('inputAppointmentDate').value;
            const fullDateStr = formatDayOfWeek(date);
            summary.innerText = `${fullDateStr} | ${selectedDentist.name}`;

            loading.classList.remove('d-none');
            noSlots.classList.add('d-none');
            morningSection.classList.add('d-none');
            afternoonSection.classList.add('d-none');
            morningGrid.innerHTML = '';
            afternoonGrid.innerHTML = '';
            if (alertBox) alertBox.classList.add('d-none');

            selectedSlot = null;
            document.getElementById('btnNext3').disabled = true;

            const dentistParam = selectedDentist.id ? `&dentistUserId=${selectedDentist.id}` : '';
            try {
                const url = `/Patient/Appointment/GetSlots?departmentId=${selectedService.deptId}&serviceId=${selectedService.id}&date=${date}${dentistParam}`;
                const res = await fetch(url);
                const slots = await res.json();
                loading.classList.add('d-none');

                if (!slots || slots.length === 0) {
                    const detailText = document.getElementById('noSlotsDetailText');
                    if (detailText) {
                        const doctorLabel = selectedDentist.id ? `Bác sĩ ${selectedDentist.name}` : 'Nhóm dịch vụ';
                        detailText.innerText = `Vào ngày ${fullDateStr}, ${doctorLabel} không còn khung giờ trống hoặc đã kết thúc ca làm việc. Vui lòng chọn ngày khác hoặc chọn bác sĩ bất kỳ.`;
                    }
                    noSlots.classList.remove('d-none');
                    return;
                }

                let morningCount = 0;
                let afternoonCount = 0;

                slots.forEach(slot => {
                    const start = new Date(slot.startTime);
                    const startStr = `${String(start.getHours()).padStart(2, '0')}:${String(start.getMinutes()).padStart(2, '0')}`;
                    const dentistLabel = slot.dentistName || slot.recommendedDentistName || '';

                    const col = document.createElement('div');
                    col.className = 'col-6 col-sm-4 col-md-3';
                    col.innerHTML = `
                        <div class="slot-btn" data-start="${slot.startTime}" data-display="${startStr}">
                            <div class="fw-bold fs-4 text-dark mb-1">${startStr}</div>
                            <div class="small text-muted">${dentistLabel ? dentistLabel : 'Giờ trống'}</div>
                        </div>
                    `;

                    col.querySelector('.slot-btn').addEventListener('click', function() {
                        selectSlot(slot.startTime, startStr);
                    });

                    if (start.getHours() < 12) {
                        morningGrid.appendChild(col);
                        morningCount++;
                    } else {
                        afternoonGrid.appendChild(col);
                        afternoonCount++;
                    }
                });

                if (morningCount > 0) morningSection.classList.remove('d-none');
                if (afternoonCount > 0) afternoonSection.classList.remove('d-none');

            } catch (err) {
                loading.classList.add('d-none');
                morningGrid.innerHTML = '<div class="col-12 text-danger text-center">Lỗi tải khung giờ khả dụng. Vui lòng thử lại.</div>';
            }
        }

        function selectSlot(startTime, startStr) {
            selectedSlot = { start: startTime, display: startStr };
            document.getElementById('hiddenScheduledStart').value = startTime;

            document.querySelectorAll('.slot-btn').forEach(c => {
                c.classList.toggle('active', c.getAttribute('data-start') === startTime);
            });

            const alertBox = document.getElementById('slotSelectedAlert');
            if (alertBox) {
                alertBox.classList.remove('d-none');
                document.getElementById('alertSlotText').innerText = startStr;
            }

            document.getElementById('btnNext3').disabled = false;
            updateSidePanel();
        }

        // BƯỚC 4: Quick Chips Triệu Chứng
        function addSymptomChip(text) {
            const textarea = document.getElementById('inputReasonForVisit');
            if (!textarea) return;
            const current = textarea.value.trim();
            if (current.includes(text)) return;

            if (current.length === 0) {
                textarea.value = text;
            } else {
                textarea.value = current + ', ' + text;
            }

            const reasonError = document.getElementById('reasonErrorMsg');
            if (reasonError) reasonError.classList.add('d-none');
            textarea.classList.remove('is-invalid');
            textarea.focus();
        }

        // Cập Nhật Tóm Tắt (Bước 5)
        function updateSummary() {
            document.getElementById('summaryDept').innerText = selectedService.deptName || '--';
            document.getElementById('summaryService').innerText = selectedService.name || '--';

            const dateVal = document.getElementById('inputAppointmentDate').value;
            document.getElementById('summaryDate').innerText = formatDayOfWeek(dateVal);
            document.getElementById('summarySlot').innerText = selectedSlot ? selectedSlot.display : '--';
            document.getElementById('summaryDentist').innerText = selectedDentist.name;
            document.getElementById('summaryReason').innerText = document.getElementById('inputReasonForVisit').value.trim() || '--';
        }

        // Cập Nhật Thanh Sticky Bên Phải
        function updateSidePanel() {
            // Dịch vụ
            if (selectedService.id > 0) {
                document.getElementById('sideServiceName').innerText = selectedService.name;
                document.getElementById('sideDeptName').innerHTML = `<i class="bi bi-hospital me-1 text-primary"></i>Nhóm: ${selectedService.deptName}`;
            } else {
                document.getElementById('sideServiceName').innerText = 'Chưa chọn dịch vụ';
                document.getElementById('sideDeptName').innerText = 'Vui lòng chọn ở Bước 1';
            }

            // Thời gian
            const dateVal = document.getElementById('inputAppointmentDate').value;
            document.getElementById('sideDateText').innerText = formatDayOfWeek(dateVal) || 'Chưa chọn ngày';
            document.getElementById('sideSlotText').innerText = selectedSlot ? ('Giờ hẹn: ' + selectedSlot.display) : 'Chưa chọn giờ';

            // Bác sĩ
            document.getElementById('sideDentistName').innerHTML = `<i class="bi bi-person-badge text-primary me-1"></i>${selectedDentist.name}`;

            // Nút hành động bên phải
            const sideBtn = document.getElementById('sideActionButton');
            if (!sideBtn) return;

            if (currentStep === 1) {
                sideBtn.innerHTML = 'Tiếp tục: Ngày & Bác sĩ <i class="bi bi-arrow-right ms-1"></i>';
                sideBtn.className = 'btn btn-primary w-100 fw-bold py-2 shadow-sm';
                sideBtn.disabled = (selectedService.id === 0);
            } else if (currentStep === 2) {
                sideBtn.innerHTML = 'Tiếp tục: Chọn giờ hẹn <i class="bi bi-arrow-right ms-1"></i>';
                sideBtn.className = 'btn btn-primary w-100 fw-bold py-2 shadow-sm';
                sideBtn.disabled = false;
            } else if (currentStep === 3) {
                sideBtn.innerHTML = 'Tiếp tục: Nhập triệu chứng <i class="bi bi-arrow-right ms-1"></i>';
                sideBtn.className = 'btn btn-primary w-100 fw-bold py-2 shadow-sm';
                sideBtn.disabled = !selectedSlot;
            } else if (currentStep === 4) {
                sideBtn.innerHTML = 'Tiếp tục: Xem lại & Xác nhận <i class="bi bi-arrow-right ms-1"></i>';
                sideBtn.className = 'btn btn-primary w-100 fw-bold py-2 shadow-sm';
                sideBtn.disabled = false;
            } else if (currentStep === 5) {
                sideBtn.innerHTML = '<i class="bi bi-send-check me-1"></i> Gửi Yêu Cầu Đặt Lịch';
                sideBtn.className = 'btn btn-success w-100 fw-bold py-2 shadow';
                sideBtn.disabled = false;
            }
        }

        function onSideActionClick() {
            if (currentStep < 5) {
                goToStep(currentStep + 1);
            } else {
                submitBookingForm();
            }
        }

        function submitBookingForm() {
            if (isSubmitting) return false;
            isSubmitting = true;

            const submitBtn = document.getElementById('btnSubmitBooking');
            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span> Đang gửi yêu cầu...';
            }
            const sideBtn = document.getElementById('sideActionButton');
            if (sideBtn) {
                sideBtn.disabled = true;
                sideBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span> Đang gửi...';
            }

            document.getElementById('bookingForm').submit();
        }

        // Chống tạo yêu cầu trùng do bấm gửi nhiều lần (Một lần click không sinh hai lịch)
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('bookingForm');
            if (form) {
                form.addEventListener('submit', function (e) {
                    if (isSubmitting) {
                        e.preventDefault();
                        return false;
                    }
                    isSubmitting = true;

                    const submitBtn = document.getElementById('btnSubmitBooking');
                    if (submitBtn) {
                        submitBtn.disabled = true;
                        submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span> Đang gửi yêu cầu đặt lịch...';
                    }
                    const sideBtn = document.getElementById('sideActionButton');
                    if (sideBtn) {
                        sideBtn.disabled = true;
                        sideBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span> Đang gửi...';
                    }
                });
            }

            // Khởi tạo text ngày hôm nay/ngày mai
            const initialDateInput = document.getElementById('inputAppointmentDate');
            if (initialDateInput) {
                const fullText = formatDayOfWeek(initialDateInput.value);
                const dateElem = document.getElementById('dateTextFull');
                if (dateElem) dateElem.innerText = fullText;
            }

            // Gán click cho từng service card
            document.querySelectorAll('#servicesGrid .service-item').forEach(item => {
                const card = item.querySelector('.service-card');
                if (!card) return;

                card.addEventListener('click', function () {
                    const serviceId = parseInt(item.getAttribute('data-service-id')) || 0;
                    const deptId = parseInt(item.getAttribute('data-dept-id')) || 0;
                    const deptName = item.getAttribute('data-dept-name') || '';
                    const name = item.getAttribute('data-name') || '';

                    selectService(serviceId, name, deptId, deptName, card);
                });
            });

            // Tự động chọn pre-selected service / department nếu có
            const preSelectedServiceId = parseInt('@Model.RequestedServiceId') || 0;
            const preSelectedDeptId = parseInt('@Model.DepartmentId') || 0;

            if (preSelectedServiceId > 0) {
                const targetCard = document.querySelector(`.service-item[data-service-id="${preSelectedServiceId}"]`);
                if (targetCard) {
                    const cardInner = targetCard.querySelector('.service-card');
                    if (cardInner) cardInner.click();
                }
            } else if (preSelectedDeptId > 0) {
                const deptSelect = document.getElementById('deptFilterSelect');
                if (deptSelect) {
                    deptSelect.value = preSelectedDeptId;
                    filterServices();
                }
            }

            updateSidePanel();
        });
    </script>
}
