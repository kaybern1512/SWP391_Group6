@model DentalClinic.Web.ViewModels.Appointments.PatientBookViewModel
@{
    ViewData["Title"] = "Đặt lịch khám nha khoa";
}

<div class="container-fluid px-0">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">Đặt Lịch Khám Nha Khoa Trực Tuyến</h1>
            <p class="text-muted mb-0">Hệ thống phòng khám đa chuyên khoa DentalCare &bull; Đặt lịch hẹn theo nhu cầu & dịch vụ nhanh chóng</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Danh sách lịch hẹn
            </a>
        </div>
    </div>

    @if (Model.Eligibility != null && !Model.Eligibility.IsEligible)
    {
        <div class="card border-danger shadow-sm mb-4">
            <div class="card-body p-4 text-center">
                <div class="rounded-circle bg-danger-subtle text-danger d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                    <i class="bi bi-slash-circle fs-1"></i>
                </div>
                <h4 class="fw-bold text-danger mb-2">Tài Khoản Tạm Khóa Quyền Tự Đặt Lịch Online</h4>
                <p class="text-muted fs-6 mb-3 mx-auto" style="max-width: 650px;">
                    @Model.Eligibility.BlockReason
                </p>
                <div class="alert alert-warning border-warning d-inline-block text-start py-2 px-4 mb-4">
                    <i class="bi bi-telephone-fill text-warning me-2"></i>
                    Quý khách có nhu cầu khám chữa bệnh, vui lòng liên hệ hotline: <strong class="fs-5 text-dark ms-1">1900 1234</strong> hoặc đến trực tiếp phòng khám để được Lễ tân hỗ trợ.
                </div>
                <div>
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">
                        <i class="bi bi-calendar3 me-1"></i> Xem danh sách lịch hẹn của tôi
                    </a>
                </div>
            </div>
        </div>
    }
    else
    {
        @if (Model.Eligibility != null && Model.Eligibility.StrikeCount > 0)
        {
            <div class="alert alert-warning border-warning shadow-sm mb-4 py-2 d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center">
                    <i class="bi bi-exclamation-triangle-fill fs-5 me-2 text-warning"></i>
                    <div class="small">
                        <strong>Lưu ý chính sách hủy lịch:</strong> Tài khoản của bạn đang có <strong>@Model.Eligibility.StrikeCount / 3</strong> lần vi phạm trong 30 ngày qua (hủy sát giờ &lt;12h hoặc không đến khám). Vui lòng cân nhắc sắp xếp thời gian hợp lý khi đặt lịch để tránh bị tạm khóa quyền đặt lịch trực tuyến 30 ngày.
                    </div>
                </div>
                <span class="badge bg-warning text-dark px-2 py-1">@Model.Eligibility.StrikeCount/3 Vi phạm</span>
            </div>
        }

        <!-- Stepper Navigation (5 Bước Chuẩn WF-02) -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center text-center position-relative">
                    <div class="step-item active" id="step-nav-1" onclick="goToStep(1)">
                        <div class="step-circle"><i class="bi bi-heart-pulse"></i></div>
                        <div class="step-label">1. Nhu cầu / Dịch vụ</div>
                    </div>
                    <div class="step-line"></div>
                    <div class="step-item" id="step-nav-2" onclick="goToStep(2)">
                        <div class="step-circle"><i class="bi bi-calendar2-date"></i></div>
                        <div class="step-label">2. Bác sĩ & Ngày</div>
                    </div>
                    <div class="step-line"></div>
                    <div class="step-item" id="step-nav-3" onclick="goToStep(3)">
                        <div class="step-circle"><i class="bi bi-clock"></i></div>
                        <div class="step-label">3. Khung giờ</div>
                    </div>
                    <div class="step-line"></div>
                    <div class="step-item" id="step-nav-4" onclick="goToStep(4)">
                        <div class="step-circle"><i class="bi bi-card-text"></i></div>
                        <div class="step-label">4. Triệu chứng</div>
                    </div>
                    <div class="step-line"></div>
                    <div class="step-item" id="step-nav-5" onclick="goToStep(5)">
                        <div class="step-circle"><i class="bi bi-check-circle"></i></div>
                        <div class="step-label">5. Xác nhận</div>
                    </div>
                </div>
            </div>
        </div>

        <form asp-action="Book" method="post" id="bookingForm">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

            <input type="hidden" asp-for="DepartmentId" id="hiddenDepartmentId" />
            <input type="hidden" asp-for="RequestedServiceId" id="hiddenServiceId" />
            <input type="hidden" asp-for="RequestedDentistUserId" id="hiddenDentistId" />
            <input type="hidden" asp-for="ScheduledStart" id="hiddenScheduledStart" />

            <!-- STEP 1: CHỌN NHU CẦU / DỊCH VỤ NHA KHOA (WF-02 PATIENT-CENTRIC) -->
            <div class="step-panel" id="step-panel-1">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white py-3">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div>
                                <h5 class="card-title mb-1 fw-bold text-primary">
                                    <i class="bi bi-heart-pulse me-2"></i>Bước 1: Chọn nhu cầu khám hoặc dịch vụ điều trị
                                </h5>
                                <p class="text-muted small mb-0">Hệ thống sẽ tự động xác định chuyên khoa chuyên trách từ dịch vụ bạn lựa chọn.</p>
                            </div>
                            <span class="badge bg-primary-subtle text-primary px-3 py-2 fs-6" id="badgeServiceCount">
                                @Model.Services.Count dịch vụ khả dụng
                            </span>
                        </div>
                    </div>
                    <div class="card-body p-4">
                        <!-- Alert hướng dẫn bệnh nhân -->
                        <div class="alert alert-info border-0 shadow-sm d-flex align-items-center mb-4 py-2 px-3 rounded-3 bg-info-subtle text-info-emphasis">
                            <i class="bi bi-lightbulb-fill fs-5 me-2 text-info"></i>
                            <div class="small">
                                <strong>Đặt lịch thuận tiện:</strong> Quý khách chỉ cần chọn vấn đề răng miệng hoặc dịch vụ cần thực hiện (ví dụ: khám tư vấn, cạo vôi, trám răng, nhổ răng khôn, niềng răng...). DentalCare sẽ <strong>tự động nhận diện và chuyển yêu cầu đến đúng Chuyên khoa phụ trách</strong>.
                            </div>
                        </div>

                        <!-- Thanh tìm kiếm nhanh & Bộ lọc phân loại -->
                        <div class="row g-3 mb-4">
                            <div class="col-md-7">
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                                    <input type="text" id="serviceSearchInput" class="form-control border-start-0" placeholder="Tìm theo tên dịch vụ, triệu chứng (ví dụ: cạo vôi, nhổ răng khôn, niềng răng, tủy răng, sâu răng...)" onkeyup="filterServices()" />
                                </div>
                            </div>
                            <div class="col-md-5">
                                <select id="deptFilterSelect" class="form-select" onchange="filterServices()">
                                    <option value="0">Tất cả các chuyên khoa & dịch vụ</option>
                                    @foreach (var dept in Model.Departments)
                                    {
                                        <option value="@dept.DepartmentId">Khoa: @dept.Name</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <!-- Banner thông báo dịch vụ được chọn -->
                        <div id="serviceSelectedAlert" class="alert alert-success border-success d-none py-2 px-3 mb-4 d-flex align-items-center justify-content-between rounded-3 shadow-sm">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-check-circle-fill fs-5 text-success"></i>
                                <div>
                                    <span>Đã chọn dịch vụ: <strong id="alertServiceName" class="text-success fs-6"></strong></span>
                                    <span class="mx-2">&bull;</span>
                                    <span>Chuyên khoa tiếp nhận tự động: <strong id="alertDeptName" class="text-dark"></strong></span>
                                </div>
                            </div>
                            <span class="badge bg-success text-white px-3 py-1 fs-6" id="alertPrice"></span>
                        </div>

                        <!-- Lưới danh sách dịch vụ -->
                        <div class="row g-3" id="servicesGrid">
                            @if (Model.Services.Count == 0)
                            {
                                <div class="col-12 text-center text-muted py-5">
                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                    Hiện chưa có dịch vụ nào đang mở đặt lịch trực tuyến.
                                </div>
                            }
                            else
                            {
                                @foreach (var svc in Model.Services)
                                {
                                    var deptName = !string.IsNullOrWhiteSpace(svc.DepartmentName) ? svc.DepartmentName : "Chuyên khoa tiếp nhận";
                                    var priceFormatted = (svc.Price > 0) ? $"{svc.Price:N0} đ" : "Liên hệ báo giá";
                                    var isSelected = Model.RequestedServiceId == svc.DepartmentServiceId;

                                    <div class="col-md-6 col-lg-4 service-item" 
                                         data-service-id="@svc.DepartmentServiceId" 
                                         data-dept-id="@svc.DepartmentId" 
                                         data-dept-name="@deptName" 
                                         data-name="@svc.ServiceName" 
                                         data-duration="@(svc.DurationMinutes ?? 30)" 
                                         data-price="@(svc.Price)">
                                        <div class="card h-100 selection-card p-3 @(isSelected ? "active" : "")" 
                                             onclick="selectService(@svc.DepartmentServiceId, '@svc.ServiceName', @(svc.DurationMinutes ?? 30), @svc.Price, @svc.DepartmentId, '@deptName')">
                                            <div class="d-flex justify-content-between align-items-start mb-2">
                                                <h6 class="fw-bold mb-0 text-dark flex-grow-1 pe-2">@svc.ServiceName</h6>
                                                <span class="badge bg-primary text-white text-nowrap">@priceFormatted</span>
                                            </div>
                                            <p class="text-muted small mb-2 flex-grow-1">
                                                @(string.IsNullOrWhiteSpace(svc.Description) ? "Khám và chăm sóc răng miệng theo quy trình kỹ thuật cao." : svc.Description)
                                            </p>
                                            <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle small text-truncate" style="max-width: 200px;">
                                                    <i class="bi bi-hospital me-1"></i>@deptName
                                                </span>
                                                <span class="text-secondary small">
                                                    <i class="bi bi-clock me-1"></i>@(svc.DurationMinutes ?? 30) phút
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                    <div class="card-footer bg-white text-end py-3">
                        <button type="button" class="btn btn-primary btn-lg px-4 shadow-sm" id="btnNext1" disabled onclick="goToStep(2)">
                            Tiếp tục: Bác sĩ & Ngày khám <i class="bi bi-arrow-right ms-1"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- STEP 2: CHỌN NGÀY VÀ BÁC SĨ (TỰ ĐỘNG LỌC THEO KHOA ĐÃ CHỌN) -->
            <div class="step-panel d-none" id="step-panel-2">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white py-3">
                        <h5 class="card-title mb-0 fw-bold text-primary">
                            <i class="bi bi-calendar2-date me-2"></i>Bước 2: Chọn ngày hẹn và Bác sĩ phụ trách
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        <!-- Tóm tắt dịch vụ đã chọn -->
                        <div class="card bg-light-subtle border mb-4 p-3 rounded-3">
                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <div>
                                    <span class="text-muted small text-uppercase fw-semibold">Dịch vụ đã chọn:</span>
                                    <h6 class="mb-0 fw-bold text-primary fs-5" id="panel2ServiceName">--</h6>
                                    <div class="text-muted small mt-1">
                                        <i class="bi bi-hospital me-1"></i>Chuyên khoa phụ trách: <strong class="text-dark" id="panel2DeptName">--</strong>
                                        <span class="mx-2">&bull;</span>
                                        <i class="bi bi-clock me-1"></i>Thời lượng: <strong id="panel2Duration">-- phút</strong>
                                        <span class="mx-2">&bull;</span>
                                        <i class="bi bi-tag me-1"></i>Chi phí: <strong class="text-primary" id="panel2Price">-- đ</strong>
                                    </div>
                                </div>
                                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="goToStep(1)">
                                    <i class="bi bi-pencil me-1"></i> Đổi dịch vụ khác
                                </button>
                            </div>
                        </div>

                        <div class="row g-4">
                            <div class="col-md-5">
                                <label class="form-label fw-semibold">1. Chọn ngày bạn muốn đến khám: <span class="text-danger">*</span></label>
                                <input type="date" asp-for="AppointmentDate" id="inputAppointmentDate" class="form-control form-control-lg" min="@DateTime.Today.ToString("yyyy-MM-dd")" onchange="onDateOrDentistChange()" />
                                <small class="text-muted mt-1 d-block"><i class="bi bi-info-circle me-1"></i>Phòng khám mở cửa tất cả các ngày trong tuần từ 08:00 đến 20:00.</small>
                            </div>
                            <div class="col-md-7">
                                <label class="form-label fw-semibold">2. Chọn Bác sĩ mong muốn (Tùy chọn):</label>
                                <div class="row g-2" id="dentistOptionsGrid">
                                    <div class="col-12">
                                        <div class="card selection-card p-3 active" data-dentist-id="" onclick="selectDentist(null, 'Bất kỳ bác sĩ khả dụng')">
                                            <div class="d-flex align-items-center gap-3">
                                                <div class="selection-icon bg-info-subtle text-info">
                                                    <i class="bi bi-people-fill fs-4"></i>
                                                </div>
                                                <div>
                                                    <div class="fw-bold">Bác sĩ khả dụng bất kỳ (Hệ thống điều phối tối ưu - Khuyên dùng)</div>
                                                    <small class="text-muted">Trưởng khoa sẽ tự động sắp xếp bác sĩ chuyên môn còn trống lịch sớm nhất cho bạn.</small>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-12" id="dentistLoading" class="text-center py-3 d-none">
                                        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                                        <small class="text-muted ms-2">Đang tải danh sách bác sĩ chuyên khoa...</small>
                                    </div>
                                    <div class="col-12" id="dentistDynamicList"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer bg-white d-flex justify-content-between py-3">
                        <button type="button" class="btn btn-outline-secondary" onclick="goToStep(1)">
                            <i class="bi bi-arrow-left me-1"></i> Quay lại
                        </button>
                        <button type="button" class="btn btn-primary px-4 shadow-sm" id="btnNext2" onclick="goToStep(3)">
                            Tiếp tục: Chọn giờ khám <i class="bi bi-arrow-right ms-1"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- STEP 3: CHỌN TIME SLOT -->
            <div class="step-panel d-none" id="step-panel-3">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                        <h5 class="card-title mb-0 fw-bold text-primary">
                            <i class="bi bi-clock me-2"></i>Bước 3: Chọn khung giờ khám khả dụng
                        </h5>
                        <span class="text-muted small" id="slotFilterSummary"></span>
                    </div>
                    <div class="card-body p-4">
                        <div id="slotsLoading" class="text-center py-5 d-none">
                            <div class="spinner-border text-primary" role="status"></div>
                            <p class="mt-2 text-muted">Đang tra cứu lịch làm việc và khung giờ trống...</p>
                        </div>
                        <div id="noSlotsMessage" class="alert alert-warning d-none text-center py-4 border-warning shadow-sm rounded-3">
                            <i class="bi bi-calendar-x fs-1 d-block mb-2 text-warning"></i>
                            <h5 class="fw-bold text-dark mb-2">Chưa tìm thấy khung giờ khám phù hợp</h5>
                            <p class="text-muted mb-3" id="noSlotsDetailText">
                                Trong ngày đã chọn, bác sĩ đã kín lịch hoặc chuyên khoa đã hết ca làm việc trống.
                            </p>
                            <div class="d-flex justify-content-center gap-2 flex-wrap">
                                <button type="button" class="btn btn-primary px-3 shadow-sm" onclick="goToStep(2)">
                                    <i class="bi bi-calendar-date me-1"></i> Quay lại Bước 2: Đổi ngày khám
                                </button>
                                <button type="button" class="btn btn-outline-primary px-3" onclick="switchToAnyDentistAndReload()">
                                    <i class="bi bi-people me-1"></i> Chọn "Bất kỳ bác sĩ khả dụng"
                                </button>
                            </div>
                        </div>
                        <div class="row g-3" id="slotsGrid"></div>
                    </div>
                    <div class="card-footer bg-white d-flex justify-content-between py-3">
                        <button type="button" class="btn btn-outline-secondary" onclick="goToStep(2)">
                            <i class="bi bi-arrow-left me-1"></i> Quay lại
                        </button>
                        <button type="button" class="btn btn-primary px-4 shadow-sm" id="btnNext3" disabled onclick="goToStep(4)">
                            Tiếp tục: Nhập triệu chứng <i class="bi bi-arrow-right ms-1"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- STEP 4: MÔ TẢ TRIỆU CHỨNG / LÝ DO KHÁM -->
            <div class="step-panel d-none" id="step-panel-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white py-3">
                        <h5 class="card-title mb-0 fw-bold text-primary">
                            <i class="bi bi-card-text me-2"></i>Bước 4: Lý do khám / Mô tả triệu chứng
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-3">
                            <label asp-for="ReasonForVisit" class="form-label fw-semibold">Mô tả lý do khám hoặc các triệu chứng bạn đang gặp phải <span class="text-danger">*</span></label>
                            <textarea asp-for="ReasonForVisit" id="inputReasonForVisit" class="form-control" rows="4" placeholder="Ví dụ: Đau nhức răng hàm dưới bên trái khi ăn đồ nóng lạnh, muốn cạo vôi và kiểm tra tổng quát định kỳ..."></textarea>
                            <div id="reasonErrorMsg" class="text-danger small mt-1 d-none"><i class="bi bi-exclamation-circle me-1"></i>Vui lòng nhập lý do khám tối thiểu 5 ký tự.</div>
                            <span asp-validation-for="ReasonForVisit" class="text-danger small"></span>
                            <div class="form-text">Mô tả chi tiết giúp đội ngũ bác sĩ chuẩn bị chu đáo trang thiết bị và dự kiến thời gian thăm khám hiệu quả nhất cho bạn. Bạn có thể ghi chú thêm các dịch vụ khác muốn làm tại đây.</div>
                        </div>
                    </div>
                    <div class="card-footer bg-white d-flex justify-content-between py-3">
                        <button type="button" class="btn btn-outline-secondary" onclick="goToStep(3)">
                            <i class="bi bi-arrow-left me-1"></i> Quay lại
                        </button>
                        <button type="button" class="btn btn-primary px-4 shadow-sm" id="btnNext4" onclick="goToStep(5)">
                            Tiếp tục: Xem lại & Xác nhận <i class="bi bi-arrow-right ms-1"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- STEP 5: XÁC NHẬN VÀ GỬI YÊU CẦU (WF-02 SUBMIT) -->
            <div class="step-panel d-none" id="step-panel-5">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white py-3">
                        <h5 class="card-title mb-0 fw-bold text-success">
                            <i class="bi bi-check-circle me-2"></i>Bước 5: Kiểm tra thông tin & Gửi yêu cầu đặt lịch
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="alert alert-info border-0 mb-4 shadow-sm rounded-3">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-info-circle-fill fs-5 text-info"></i>
                                <div><strong>Quy trình tiếp nhận (WF-02):</strong> Sau khi bạn gửi yêu cầu, lịch hẹn sẽ ở trạng thái <strong class="badge bg-warning text-dark">Chờ Lễ tân tiếp nhận</strong> (PendingReceptionReview). Bộ phận Lễ tân và Trưởng khoa sẽ tiếp nhận, phê duyệt lịch hẹn và phân bổ bác sĩ/phòng khám chính thức.</div>
                            </div>
                        </div>

                        <div class="row g-4">
                            <div class="col-md-6">
                                <div class="border rounded p-3 bg-light-subtle h-100">
                                    <h6 class="fw-bold text-muted text-uppercase small mb-3">Thông tin dịch vụ & Chuyên khoa</h6>
                                    <table class="table table-borderless table-sm mb-0">
                                        <tr>
                                            <td class="text-muted" style="width: 140px;">Dịch vụ chọn:</td>
                                            <td class="fw-bold text-primary" id="summaryService">--</td>
                                        </tr>
                                        <tr>
                                            <td class="text-muted">Chuyên khoa:</td>
                                            <td class="fw-bold" id="summaryDept">--</td>
                                        </tr>
                                        <tr>
                                            <td class="text-muted">Thời lượng dự kiến:</td>
                                            <td id="summaryDuration">-- phút</td>
                                        </tr>
                                        <tr>
                                            <td class="text-muted">Giá tham khảo:</td>
                                            <td class="fw-bold text-success" id="summaryPrice">-- đ</td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="border rounded p-3 bg-light-subtle h-100">
                                    <h6 class="fw-bold text-muted text-uppercase small mb-3">Thời gian & Bác sĩ</h6>
                                    <table class="table table-borderless table-sm mb-0">
                                        <tr>
                                            <td class="text-muted" style="width: 140px;">Ngày khám:</td>
                                            <td class="fw-bold text-success" id="summaryDate">--</td>
                                        </tr>
                                        <tr>
                                            <td class="text-muted">Giờ hẹn:</td>
                                            <td class="fw-bold text-success fs-5" id="summarySlot">--</td>
                                        </tr>
                                        <tr>
                                            <td class="text-muted">Bác sĩ mong muốn:</td>
                                            <td class="fw-bold" id="summaryDentist">Bất kỳ bác sĩ khả dụng</td>
                                        </tr>
                                        <tr>
                                            <td class="text-muted">Lý do khám:</td>
                                            <td class="fst-italic" id="summaryReason">--</td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer bg-white d-flex justify-content-between py-3">
                        <button type="button" class="btn btn-outline-secondary" onclick="goToStep(4)">
                            <i class="bi bi-arrow-left me-1"></i> Sửa lại thông tin
                        </button>
                        <button type="submit" class="btn btn-success btn-lg px-5 shadow-sm fw-bold">
                            <i class="bi bi-send-check me-2"></i> Xác Nhận Đặt Lịch Khám
                        </button>
                    </div>
                </div>
            </div>
        </form>
    }
</div>

<style>
.step-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    z-index: 2;
    cursor: pointer;
}
.step-circle {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background-color: #e9ecef;
    color: #6c757d;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    margin-bottom: 6px;
    transition: all 0.3s ease;
}
.step-label {
    font-size: 0.82rem;
    font-weight: 600;
    color: #6c757d;
}
.step-item.active .step-circle {
    background-color: #0d6efd;
    color: #fff;
    box-shadow: 0 0 0 4px rgba(13, 110, 253, 0.2);
}
.step-item.active .step-label {
    color: #0d6efd;
}
.step-item.completed .step-circle {
    background-color: #198754;
    color: #fff;
}
.step-item.completed .step-label {
    color: #198754;
}
.step-line {
    flex-grow: 1;
    height: 3px;
    background-color: #dee2e6;
    margin: 0 10px;
    margin-bottom: 24px;
}
.selection-card {
    cursor: pointer;
    border: 2px solid #e9ecef;
    transition: all 0.25s ease;
    border-radius: 12px;
}
.selection-card:hover {
    border-color: #0d6efd;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(13, 110, 253, 0.1);
}
.selection-card.active {
    border-color: #0d6efd;
    background-color: #f8fbff;
    box-shadow: 0 4px 12px rgba(13, 110, 253, 0.15);
}
.selection-icon {
    width: 48px;
    height: 48px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
}
.slot-card {
    cursor: pointer;
    border: 2px solid #e9ecef;
    border-radius: 10px;
    padding: 12px 8px;
    text-align: center;
    transition: all 0.2s ease;
}
.slot-card:hover {
    border-color: #0d6efd;
    background-color: #f8fbff;
}
.slot-card.active {
    border-color: #0d6efd;
    background-color: #0d6efd;
    color: #fff !important;
}
.slot-card.active .text-muted,
.slot-card.active .badge {
    color: #fff !important;
}
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        let currentStep = 1;
        let selectedService = { id: 0, name: '', duration: 30, price: 0, deptId: 0, deptName: '' };
        let selectedDentist = { id: null, name: 'Bất kỳ bác sĩ khả dụng' };
        let selectedSlot = null;

        function goToStep(step) {
            if (step > currentStep) {
                if (currentStep === 1 && selectedService.id === 0) {
                    if (window.toastWarning) {
                        window.toastWarning('Vui lòng chọn một nhu cầu khám hoặc dịch vụ nha khoa để tiếp tục.', 'Yêu Cầu Chọn');
                    } else {
                        alert('Vui lòng chọn một nhu cầu khám hoặc dịch vụ nha khoa để tiếp tục.');
                    }
                    return;
                }
                if (currentStep === 3 && !selectedSlot) {
                    if (window.toastWarning) {
                        window.toastWarning('Vui lòng chọn một khung giờ hẹn còn trống để tiếp tục.', 'Yêu Cầu Chọn');
                    } else {
                        alert('Vui lòng chọn một khung giờ hẹn còn trống để tiếp tục.');
                    }
                    return;
                }
                if (currentStep === 4) {
                    const reason = document.getElementById('inputReasonForVisit').value.trim();
                    const reasonError = document.getElementById('reasonErrorMsg');
                    const reasonInput = document.getElementById('inputReasonForVisit');
                    if (reason.length < 5) {
                        if (reasonError) reasonError.classList.remove('d-none');
                        if (reasonInput) {
                            reasonInput.classList.add('is-invalid');
                            reasonInput.focus();
                        }
                        return;
                    }
                    if (reasonError) reasonError.classList.add('d-none');
                    if (reasonInput) reasonInput.classList.remove('is-invalid');
                    updateSummary();
                }
            }

            for (let i = 1; i <= 5; i++) {
                document.getElementById(`step-panel-${i}`).classList.add('d-none');
                const nav = document.getElementById(`step-nav-${i}`);
                nav.classList.remove('active');
                if (i < step) {
                    nav.classList.add('completed');
                } else {
                    nav.classList.remove('completed');
                }
            }

            document.getElementById(`step-panel-${step}`).classList.remove('d-none');
            document.getElementById(`step-nav-${step}`).classList.add('active');
            currentStep = step;

            if (step === 3) {
                loadSlots();
            }
        }

        // Bước 1: Chọn dịch vụ & Tự động gán Khoa (WF-02)
        function selectService(id, name, duration, price, deptId, deptName) {
            selectedService = { id, name, duration, price, deptId, deptName };

            document.getElementById('hiddenServiceId').value = id;
            document.getElementById('hiddenDepartmentId').value = deptId;

            // Highlight card
            document.querySelectorAll('#servicesGrid .selection-card').forEach(c => {
                const parent = c.closest('.service-item');
                const isMatch = parent && parseInt(parent.getAttribute('data-service-id')) === id;
                c.classList.toggle('active', isMatch);
            });

            // Hiển thị banner thông báo dịch vụ được chọn
            const alertBox = document.getElementById('serviceSelectedAlert');
            if (alertBox) {
                alertBox.classList.remove('d-none');
                document.getElementById('alertServiceName').innerText = name;
                document.getElementById('alertDeptName').innerText = deptName;
                document.getElementById('alertPrice').innerText = price > 0 ? (new Intl.NumberFormat('vi-VN').format(price) + ' đ') : 'Liên hệ';
            }

            // Cập nhật thông tin cho Bước 2
            document.getElementById('panel2ServiceName').innerText = name;
            document.getElementById('panel2DeptName').innerText = deptName;
            document.getElementById('panel2Duration').innerText = duration + ' phút';
            document.getElementById('panel2Price').innerText = price > 0 ? (new Intl.NumberFormat('vi-VN').format(price) + ' đ') : 'Liên hệ';

            document.getElementById('btnNext1').disabled = false;

            // Tự động tải Bác sĩ theo Khoa đã nhận diện
            loadDentists(deptId);
        }

        // Lọc dịch vụ theo từ khóa tìm kiếm & Chuyên khoa
        function filterServices() {
            const query = (document.getElementById('serviceSearchInput').value || '').trim().toLowerCase();
            const deptFilter = parseInt(document.getElementById('deptFilterSelect').value) || 0;

            let visibleCount = 0;
            document.querySelectorAll('#servicesGrid .service-item').forEach(item => {
                const name = (item.getAttribute('data-name') || '').toLowerCase();
                const deptName = (item.getAttribute('data-dept-name') || '').toLowerCase();
                const deptId = parseInt(item.getAttribute('data-dept-id')) || 0;

                const matchQuery = !query || name.includes(query) || deptName.includes(query);
                const matchDept = deptFilter === 0 || deptId === deptFilter;

                if (matchQuery && matchDept) {
                    item.style.display = '';
                    visibleCount++;
                } else {
                    item.style.display = 'none';
                }
            });

            const badge = document.getElementById('badgeServiceCount');
            if (badge) {
                badge.innerText = `${visibleCount} dịch vụ phù hợp`;
            }
        }

        let initialDentistId = parseInt('@Model.RequestedDentistUserId') || null;

        async function loadDentists(departmentId) {
            const list = document.getElementById('dentistDynamicList');
            const loading = document.getElementById('dentistLoading');
            list.innerHTML = '';
            if (loading) loading.classList.remove('d-none');

            try {
                const res = await fetch(`/Patient/Appointment/GetDentists?departmentId=${departmentId}`);
                const dentists = await res.json();
                if (loading) loading.classList.add('d-none');

                dentists.forEach(d => {
                    const dId = d.dentistUserId || d.userId;
                    const row = document.createElement('div');
                    row.className = 'mt-2';
                    row.innerHTML = `
                        <div class="card selection-card p-3 ${initialDentistId && initialDentistId === dId ? 'active' : ''}" data-dentist-id="${dId}" onclick="selectDentist(${dId}, '${d.fullName}')">
                            <div class="d-flex align-items-center gap-3">
                                <div class="selection-icon bg-light text-primary">
                                    <i class="bi bi-person-badge fs-4"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="fw-bold text-dark">${d.fullName} <span class="badge bg-light text-muted border ms-1">${d.employeeCode || ''}</span></div>
                                    <small class="text-muted">${d.qualification || d.specialization || 'Bác sĩ chuyên khoa'}</small>
                                </div>
                            </div>
                        </div>
                    `;
                    list.appendChild(row);

                    if (initialDentistId && initialDentistId === dId) {
                        selectDentist(dId, d.fullName);
                        initialDentistId = null;
                    }
                });
            } catch (err) {
                if (loading) loading.classList.add('d-none');
                console.error(err);
            }
        }

        function selectDentist(id, name) {
            const dentistId = (id && parseInt(id) > 0) ? parseInt(id) : null;
            selectedDentist = { id: dentistId, name: name };
            document.getElementById('hiddenDentistId').value = dentistId ? dentistId.toString() : '';

            document.querySelectorAll('#dentistOptionsGrid .selection-card').forEach(c => {
                const cId = c.getAttribute('data-dentist-id');
                const parsedCId = (cId && parseInt(cId) > 0) ? parseInt(cId) : null;

                if (!dentistId && !parsedCId) {
                    c.classList.add('active');
                } else if (dentistId && parsedCId === dentistId) {
                    c.classList.add('active');
                } else {
                    c.classList.remove('active');
                }
            });

            onDateOrDentistChange();
        }

        function switchToAnyDentistAndReload() {
            selectDentist(null, 'Bất kỳ bác sĩ khả dụng');
            loadSlots();
        }

        function onDateOrDentistChange() {
            selectedSlot = null;
            document.getElementById('hiddenScheduledStart').value = '';
            document.getElementById('btnNext3').disabled = true;
        }

        async function loadSlots() {
            const loading = document.getElementById('slotsLoading');
            const noSlots = document.getElementById('noSlotsMessage');
            const grid = document.getElementById('slotsGrid');
            const summary = document.getElementById('slotFilterSummary');

            const date = document.getElementById('inputAppointmentDate').value;
            summary.innerText = `Ngày: ${date} | Bác sĩ: ${selectedDentist.name}`;

            loading.classList.remove('d-none');
            noSlots.classList.add('d-none');
            grid.innerHTML = '';
            selectedSlot = null;
            document.getElementById('btnNext3').disabled = true;

            const dentistParam = selectedDentist.id ? `&dentistUserId=${selectedDentist.id}` : '';
            try {
                const url = `/Patient/Appointment/GetSlots?departmentId=${selectedService.deptId}&serviceId=${selectedService.id}&date=${date}${dentistParam}`;
                const res = await fetch(url);
                const slots = await res.json();
                loading.classList.add('d-none');

                if (!slots || slots.length === 0) {
                    const detailText = document.getElementById('noSlotsDetailText');
                    if (detailText) {
                        const doctorLabel = selectedDentist.id ? `Bác sĩ ${selectedDentist.name}` : 'Khoa';
                        detailText.innerText = `Vào ngày ${date}, ${doctorLabel} không còn khung giờ trống hoặc đã kết thúc ca làm việc trong ngày. Vui lòng chọn ngày khác hoặc chọn tùy chọn bác sĩ bất kỳ.`;
                    }
                    noSlots.classList.remove('d-none');
                    return;
                }

                slots.forEach(slot => {
                    const col = document.createElement('div');
                    col.className = 'col-6 col-md-4 col-lg-3';
                    const start = new Date(slot.startTime);
                    const timeStr = `${String(start.getHours()).padStart(2, '0')}:${String(start.getMinutes()).padStart(2, '0')}`;
                    const recDentist = slot.recommendedDentistName ? `<div class="small text-muted mt-1"><i class="bi bi-person me-1"></i>${slot.recommendedDentistName}</div>` : '';

                    col.innerHTML = `
                        <div class="slot-card" data-start="${slot.startTime}" onclick="selectSlot('${slot.startTime}', '${slot.timeDisplay}')">
                            <div class="fw-bold fs-5">${timeStr}</div>
                            <div class="small text-muted">${slot.timeDisplay}</div>
                            ${recDentist}
                        </div>
                    `;
                    grid.appendChild(col);
                });
            } catch (err) {
                loading.classList.add('d-none');
                grid.innerHTML = '<div class="col-12 text-danger text-center">Lỗi tải khung giờ khả dụng.</div>';
            }
        }

        function selectSlot(startTime, display) {
            selectedSlot = { start: startTime, display };
            document.getElementById('hiddenScheduledStart').value = startTime;

            document.querySelectorAll('#slotsGrid .slot-card').forEach(c => {
                c.classList.toggle('active', c.getAttribute('data-start') === startTime);
            });
            document.getElementById('btnNext3').disabled = false;
        }

        function updateSummary() {
            document.getElementById('summaryDept').innerText = selectedService.deptName || '--';
            document.getElementById('summaryService').innerText = selectedService.name || '--';
            document.getElementById('summaryDuration').innerText = (selectedService.duration || 30) + ' phút';
            document.getElementById('summaryPrice').innerText = selectedService.price > 0 ? (new Intl.NumberFormat('vi-VN').format(selectedService.price) + ' đ') : 'Liên hệ báo giá';

            document.getElementById('summaryDate').innerText = document.getElementById('inputAppointmentDate').value;
            document.getElementById('summarySlot').innerText = selectedSlot ? selectedSlot.display : '--';
            document.getElementById('summaryDentist').innerText = selectedDentist.name;
            document.getElementById('summaryReason').innerText = document.getElementById('inputReasonForVisit').value.trim() || '--';
        }

        // Tự động chọn dịch vụ ban đầu nếu có pre-selected serviceId hoặc departmentId
        document.addEventListener('DOMContentLoaded', function () {
            const preSelectedServiceId = parseInt('@Model.RequestedServiceId') || 0;
            const preSelectedDeptId = parseInt('@Model.DepartmentId') || 0;

            if (preSelectedServiceId > 0) {
                const targetCard = document.querySelector(`.service-item[data-service-id="${preSelectedServiceId}"]`);
                if (targetCard) {
                    const cardInner = targetCard.querySelector('.selection-card');
                    if (cardInner) cardInner.click();
                }
            } else if (preSelectedDeptId > 0) {
                const deptSelect = document.getElementById('deptFilterSelect');
                if (deptSelect) {
                    deptSelect.value = preSelectedDeptId;
                    filterServices();
                }
            }
        });
    </script>
}
