</div>

<style>
/* Stepper Styles */
.stepper-wrapper {
    position: relative;
    padding: 0 10px;
}
.step-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    z-index: 2;
    cursor: pointer;
    min-width: 80px;
}
.step-circle {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background-color: #f1f5f9;
    color: #64748b;
    border: 2px solid #e2e8f0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    margin-bottom: 6px;
    transition: all 0.25s ease;
}
.step-label {
    font-size: 0.82rem;
    font-weight: 600;
    color: #64748b;
    white-space: nowrap;
}
.step-item.active .step-circle {
    background-color: #0d6efd;
    border-color: #0d6efd;
    color: #fff;
    box-shadow: 0 0 0 4px rgba(13, 110, 253, 0.2);
}
.step-item.active .step-label {
    color: #0d6efd;
}
.step-item.completed .step-circle {
    background-color: #198754;
    border-color: #198754;
    color: #fff;
}
.step-line {
    flex-grow: 1;
    height: 3px;
    background-color: #e2e8f0;
    margin: 0 8px;
    position: relative;
    top: -16px;
    z-index: 1;
}

/* Card Selection */
.selection-card {
    border: 2px solid #e2e8f0;
    border-radius: 12px;
    cursor: pointer;
    transition: all 0.2s ease-in-out;
    background-color: #fff;
}
.selection-card:hover {
    border-color: #93c5fd;
    box-shadow: 0 4px 12px rgba(13, 110, 253, 0.08);
    transform: translateY(-2px);
}
.selection-card.active {
    border-color: #0d6efd !important;
    background-color: #eff6ff !important;
    box-shadow: 0 0 0 1px #0d6efd;
}

.selection-icon {
    width: 48px;
    height: 48px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
}

/* Slot button */
.slot-btn {
    border: 2px solid #e2e8f0;
    background-color: #fff;
    border-radius: 10px;
    padding: 12px;
    text-align: center;
    cursor: pointer;
    transition: all 0.2s ease;
}
.slot-btn:hover {
    border-color: #0d6efd;
    background-color: #f8faff;
    transform: translateY(-2px);
}
.slot-btn.active {
    border-color: #198754 !important;
    background-color: #d1e7dd !important;
    box-shadow: 0 0 0 2px #198754;
}
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        let currentStep = 1;
        let selectedService = { id: 0, name: '', deptId: 0, deptName: '', duration: 30, price: '', isComplex: false };
        let doctorSelectionMode = '@Model.DoctorSelectionMode' || 'ClinicAssignment';
        let selectedDentist = { id: null, name: 'Để phòng khám phân công bác sĩ phù hợp' };
        let selectedSlot = null;
        let isSubmitting = false;

        function formatDayOfWeek(dateStr) {
            if (!dateStr) return '';
            const parts = dateStr.split('-');
            if (parts.length !== 3) return dateStr;
            const d = new Date(parseInt(parts[0]), parseInt(parts[1]) - 1, parseInt(parts[2]));
            const days = ['Chủ Nhật', 'Thứ Hai', 'Thứ Ba', 'Thứ Tư', 'Thứ Năm', 'Thứ Sáu', 'Thứ Bảy'];
            const dayName = days[d.getDay()];
            return `${dayName}, ${parts[2]}/${parts[1]}/${parts[0]}`;
        }

        function onSideActionClick() {
            if (currentStep < 5) {
                goToStep(currentStep + 1);
            } else if (currentStep === 5) {
                const form = document.getElementById('bookingForm');
                if (form) form.requestSubmit();
            }
        }

        function goToStep(step) {
            if (step > currentStep) {
                // Validate Step 1
                if (currentStep === 1 && selectedService.id === 0) {
                    alert('Vui lòng chọn một dịch vụ nha khoa để tiếp tục.');
                    return;
                }

                // Validate Step 2
                if (currentStep === 2 && doctorSelectionMode === 'PreferredDentist' && !selectedDentist.id) {
                    alert('Bạn đã chọn hình thức "Tôi muốn chọn bác sĩ". Vui lòng chọn một bác sĩ cụ thể từ danh sách.');
                    return;
                }

                // Validate Step 3
                if (currentStep === 3) {
                    const dateVal = document.getElementById('inputAppointmentDate').value;
                    if (!dateVal) {
                        alert('Vui lòng chọn ngày bạn muốn đến khám.');
                        return;
                    }
                    if (!selectedSlot) {
                        alert('Vui lòng chọn một khung giờ hẹn còn trống để tiếp tục.');
                        return;
                    }
                }

                // Validate Step 4
                if (currentStep === 4) {
                    const reason = document.getElementById('inputReasonForVisit').value.trim();
                    const reasonError = document.getElementById('reasonErrorMsg');
                    const reasonInput = document.getElementById('inputReasonForVisit');
                    if (reason.length < 5) {
                        if (reasonError) reasonError.classList.remove('d-none');
                        if (reasonInput) {
                            reasonInput.classList.add('is-invalid');
                            reasonInput.focus();
                        }
                        return;
                    }
                    if (reasonError) reasonError.classList.add('d-none');
                    if (reasonInput) reasonInput.classList.remove('is-invalid');
                    updateSummary();
                }
            }

            for (let i = 1; i <= 5; i++) {
                const panel = document.getElementById(`step-panel-${i}`);
                if (panel) panel.classList.add('d-none');
                const nav = document.getElementById(`step-nav-${i}`);
                if (nav) {
                    nav.classList.remove('active', 'completed');
                    if (i < step) nav.classList.add('completed');
                    if (i === step) nav.classList.add('active');
                }
            }

            const currentPanel = document.getElementById(`step-panel-${step}`);
            if (currentPanel) currentPanel.classList.remove('d-none');
            currentStep = step;

            const sideAction = document.getElementById('sideActionButton');
            if (sideAction) {
                switch (step) {
                    case 1: sideAction.innerHTML = 'Tiếp tục: Chọn bác sĩ <i class="bi bi-arrow-right ms-1"></i>'; break;
                    case 2: sideAction.innerHTML = 'Tiếp tục: Chọn ngày giờ <i class="bi bi-arrow-right ms-1"></i>'; break;
                    case 3: sideAction.innerHTML = 'Tiếp tục: Nhập thông tin <i class="bi bi-arrow-right ms-1"></i>'; break;
                    case 4: sideAction.innerHTML = 'Tiếp tục: Xem lại & Xác nhận <i class="bi bi-arrow-right ms-1"></i>'; break;
                    case 5: sideAction.innerHTML = '<i class="bi bi-send-check me-2"></i> Gửi Yêu Cầu Đặt Lịch'; break;
                }
            }

            if (step === 2) {
                loadDentistsForDepartment(selectedService.deptId);
            } else if (step === 3) {
                loadAvailableSlots();
            } else if (step === 5) {
                updateSummary();
            }

            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // ============================================
        // STEP 1 LOGIC: DỊCH VỤ
        // ============================================
        function filterServices() {
            const query = (document.getElementById('serviceSearchInput').value || '').trim().toLowerCase();
            const deptId = document.getElementById('departmentFilterSelect').value;
            const items = document.querySelectorAll('.service-item');
            let visibleCount = 0;

            items.forEach(el => {
                const name = (el.getAttribute('data-name') || '').toLowerCase();
                const itemDeptId = el.getAttribute('data-dept-id');
                const matchQuery = !query || name.includes(query);
                const matchDept = !deptId || itemDeptId === deptId;

                if (matchQuery && matchDept) {
                    el.classList.remove('d-none');
                    visibleCount++;
                } else {
                    el.classList.add('d-none');
                }
            });

            const emptyAlert = document.getElementById('filterEmptyAlert');
            if (emptyAlert) {
                emptyAlert.classList.toggle('d-none', visibleCount > 0);
            }
            const countBadge = document.getElementById('badgeServiceCount');
            if (countBadge) {
                countBadge.innerText = `${visibleCount} dịch vụ khả dụng`;
            }
        }

        function selectService(id, name, deptId, deptName, duration, price, isComplex) {
            selectedService = { id, name, deptId, deptName, duration, price, isComplex };
            document.getElementById('hiddenServiceId').value = id;
            document.getElementById('hiddenDepartmentId').value = deptId;

            document.querySelectorAll('.service-card').forEach(c => c.classList.remove('active'));
            const selectedItem = document.querySelector(`.service-item[data-service-id="${id}"] .service-card`);
            if (selectedItem) selectedItem.classList.add('active');

            const alertBox = document.getElementById('serviceSelectedAlert');
            if (alertBox) alertBox.classList.remove('d-none');
            document.getElementById('alertServiceName').innerText = name;
            document.getElementById('alertDeptName').innerText = deptName;
            document.getElementById('alertServiceDuration').innerText = `${duration} phút`;
            document.getElementById('alertServicePrice').innerText = price;

            document.getElementById('sideServiceName').innerText = name;
            document.getElementById('sideDeptName').innerHTML = `<i class="bi bi-hospital me-1"></i>${deptName}`;
            document.getElementById('sideDurationText').innerText = `${duration} phút`;
            document.getElementById('sidePriceText').innerText = price;

            document.getElementById('panel2ServiceName').innerText = name;
            document.getElementById('panel2DeptName').innerText = deptName;
            document.getElementById('panel2ServiceDuration').innerText = `${duration} phút`;
            document.getElementById('panel2ServicePrice').innerText = price;

            const btnNext1 = document.getElementById('btnNext1');
            if (btnNext1) btnNext1.disabled = false;
        }

        // ============================================
        // STEP 2 LOGIC: CHỌN HÌNH THỨC BÁC SĨ
        // ============================================
        function setDoctorSelectionMode(mode) {
            doctorSelectionMode = mode;
            document.getElementById('hiddenDoctorSelectionMode').value = mode;

            const cardClinic = document.getElementById('cardModeClinicAssignment');
            const cardPreferred = document.getElementById('cardModePreferredDentist');
            const subpanel = document.getElementById('dentistSelectionSubpanel');

            if (mode === 'ClinicAssignment') {
                if (cardClinic) cardClinic.classList.add('active');
                if (cardPreferred) cardPreferred.classList.remove('active');
                if (subpanel) subpanel.classList.add('d-none');

                selectedDentist = { id: null, name: 'Để phòng khám phân công bác sĩ phù hợp' };
                document.getElementById('hiddenDentistId').value = '';
                document.getElementById('sideDentistName').innerHTML = '<i class="bi bi-hospital text-primary me-1"></i>Để phòng khám phân công bác sĩ phù hợp';
            } else {
                if (cardClinic) cardClinic.classList.remove('active');
                if (cardPreferred) cardPreferred.classList.add('active');
                if (subpanel) subpanel.classList.remove('d-none');
            }
        }

        function loadDentistsForDepartment(deptId) {
            if (!deptId) return;
            const container = document.getElementById('dentistCardsContainer');
            const spinner = document.getElementById('dentistLoadingSpinner');
            const noAlert = document.getElementById('noDentistsAlert');
            const badge = document.getElementById('dentistCountBadge');

            if (spinner) spinner.classList.remove('d-none');
            if (container) container.innerHTML = '';
            if (noAlert) noAlert.classList.add('d-none');

            fetch(`/Patient/Appointment/GetDentists?departmentId=${deptId}`)
                .then(r => r.json())
                .then(data => {
                    if (spinner) spinner.classList.add('d-none');
                    const dentists = data || [];
                    if (badge) badge.innerText = `${dentists.length} bác sĩ`;

                    if (dentists.length === 0) {
                        if (noAlert) noAlert.classList.remove('d-none');
                        return;
                    }

                    let html = '';
                    dentists.forEach(d => {
                        const isSel = selectedDentist.id === d.userId;
                        const avatar = d.avatarUrl || '/images/default-avatar.svg';
                        const exp = d.yearsOfExperience ? `${d.yearsOfExperience} năm kinh nghiệm` : 'Bác sĩ chuyên khoa';
                        const qual = d.qualification || 'Bác sĩ Răng Hàm Mặt';

                        html += `
                            <div class="col-md-6">
                                <div class="card selection-card p-3 h-100 doctor-item-card ${isSel ? 'active' : ''}" 
                                     data-dentist-id="${d.userId}"
                                     onclick="selectSpecificDentist(${d.userId}, '${escapeHtml(d.fullName)}')">
                                    <div class="d-flex align-items-center gap-3">
                                        <img src="${avatar}" alt="${escapeHtml(d.fullName)}" class="rounded-circle border" style="width: 52px; height: 52px; object-fit: cover;" onerror="this.src='/images/default-avatar.svg'" />
                                        <div class="flex-grow-1" style="min-width: 0;">
                                            <h6 class="fw-bold text-dark mb-0 text-truncate">${escapeHtml(d.fullName)}</h6>
                                            <div class="text-primary small fw-semibold text-truncate">${escapeHtml(qual)}</div>
                                            <small class="text-muted d-block">${escapeHtml(exp)}</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        `;
                    });
                    if (container) container.innerHTML = html;
                })
                .catch(err => {
                    if (spinner) spinner.classList.add('d-none');
                    if (noAlert) noAlert.classList.remove('d-none');
                });
        }

        function selectSpecificDentist(id, name) {
            selectedDentist = { id, name };
            document.getElementById('hiddenDentistId').value = id;

            document.querySelectorAll('.doctor-item-card').forEach(c => c.classList.remove('active'));
            const card = document.querySelector(`.doctor-item-card[data-dentist-id="${id}"]`);
            if (card) card.classList.add('active');

            document.getElementById('sideDentistName').innerHTML = `<i class="bi bi-person-badge text-success me-1"></i>BS. ${escapeHtml(name)}`;
        }

        function escapeHtml(str) {
            if (!str) return '';
            return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
        }

        // ============================================
        // STEP 3 LOGIC: NGÀY VÀ GIỜ HẸN
        // ============================================
        function setQuickDate(offsetDays) {
            const now = new Date();
            now.setDate(now.getDate() + offsetDays);
            const dateStr = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;
            const dateInput = document.getElementById('inputAppointmentDate');
            if (dateInput) {
                dateInput.value = dateStr;
                onDateChanged();
            }
        }

        function onDateChanged() {
            const dateVal = document.getElementById('inputAppointmentDate').value;
            const fullText = formatDayOfWeek(dateVal);
            const textElem = document.getElementById('dateTextFull');
            if (textElem) textElem.innerText = fullText;

            const sideDate = document.getElementById('sideDateText');
            if (sideDate) sideDate.innerText = fullText || 'Chưa chọn ngày';

            selectedSlot = null;
            document.getElementById('hiddenScheduledStart').value = '';
            const btnNext3 = document.getElementById('btnNext3');
            if (btnNext3) btnNext3.disabled = true;
            const slotAlert = document.getElementById('slotSelectedAlert');
            if (slotAlert) slotAlert.classList.add('d-none');

            loadAvailableSlots();
        }

        function loadAvailableSlots() {
            const deptId = selectedService.deptId;
            const serviceId = selectedService.id;
            const date = document.getElementById('inputAppointmentDate').value;
            const dentistId = doctorSelectionMode === 'PreferredDentist' ? selectedDentist.id : '';

            const loading = document.getElementById('slotsLoading');
            const noSlots = document.getElementById('noSlotsMessage');
            const morningSec = document.getElementById('morningSection');
            const afterSec = document.getElementById('afternoonSection');
            const morningGrid = document.getElementById('morningSlotsGrid');
            const afterGrid = document.getElementById('afternoonSlotsGrid');
            const contextLabel = document.getElementById('labelSlotDoctorContext');

            if (contextLabel) {
                contextLabel.innerText = doctorSelectionMode === 'PreferredDentist' && selectedDentist.id
                    ? `(Lịch trống của BS. ${selectedDentist.name})`
                    : '(Khung giờ trống có bác sĩ trực khả dụng)';
            }

            if (!deptId || !serviceId || !date) return;

            if (loading) loading.classList.remove('d-none');
            if (noSlots) noSlots.classList.add('d-none');
            if (morningSec) morningSec.classList.add('d-none');
            if (afterSec) afterSec.classList.add('d-none');
            if (morningGrid) morningGrid.innerHTML = '';
            if (afterGrid) afterGrid.innerHTML = '';

            const url = `/Patient/Appointment/GetSlots?departmentId=${deptId}&serviceId=${serviceId}&date=${date}&dentistUserId=${dentistId || ''}`;

            fetch(url)
                .then(r => r.json())
                .then(slots => {
                    if (loading) loading.classList.add('d-none');

                    if (!slots || slots.length === 0) {
                        if (noSlots) noSlots.classList.remove('d-none');
                        const detail = document.getElementById('noSlotsDetailText');
                        if (detail) {
                            detail.innerText = doctorSelectionMode === 'PreferredDentist'
                                ? `Bác sĩ ${selectedDentist.name} hiện đã kín lịch trong ngày ${date}. Bạn có thể đổi sang ngày khác hoặc chọn "Để phòng khám phân công bác sĩ phù hợp".`
                                : `Không còn khung giờ trống trong ngày ${date}. Vui lòng chọn ngày tiếp theo.`;
                        }
                        return;
                    }

                    let morningHtml = '';
                    let afterHtml = '';
                    let morningCount = 0;
                    let afterCount = 0;

                    slots.forEach(s => {
                        const start = new Date(s.startTime);
                        const end = new Date(s.endTime);
                        const timeStr = `${String(start.getHours()).padStart(2, '0')}:${String(start.getMinutes()).padStart(2, '0')}`;
                        const endTimeStr = `${String(end.getHours()).padStart(2, '0')}:${String(end.getMinutes()).padStart(2, '0')}`;
                        const isoStart = s.startTime;
                        const isMorning = start.getHours() < 12;

                        const btnHtml = `
                            <div class="col-4 col-sm-3 col-md-2">
                                <div class="slot-btn text-center" 
                                     data-slot-start="${isoStart}" 
                                     data-slot-text="${timeStr} - ${endTimeStr}"
                                     onclick="selectSlot('${isoStart}', '${timeStr} - ${endTimeStr}')">
                                    <div class="fw-bold fs-6 text-dark">${timeStr}</div>
                                    <small class="text-muted d-block" style="font-size: 0.7rem;">đến ${endTimeStr}</small>
                                </div>
                            </div>
                        `;

                        if (isMorning) {
                            morningHtml += btnHtml;
                            morningCount++;
                        } else {
                            afterHtml += btnHtml;
                            afterCount++;
                        }
                    });

                    if (morningCount > 0) {
                        if (morningGrid) morningGrid.innerHTML = morningHtml;
                        if (morningSec) morningSec.classList.remove('d-none');
                    }
                    if (afterCount > 0) {
                        if (afterGrid) afterGrid.innerHTML = afterHtml;
                        if (afterSec) afterSec.classList.remove('d-none');
                    }
                })
                .catch(err => {
                    if (loading) loading.classList.add('d-none');
                    if (noSlots) noSlots.classList.remove('d-none');
                });
        }

        function selectSlot(isoStart, displayTime) {
            selectedSlot = { start: isoStart, text: displayTime };
            document.getElementById('hiddenScheduledStart').value = isoStart;

            document.querySelectorAll('.slot-btn').forEach(b => b.classList.remove('active'));
            const clicked = document.querySelector(`.slot-btn[data-slot-start="${isoStart}"]`);
            if (clicked) clicked.classList.add('active');

            const dateVal = document.getElementById('inputAppointmentDate').value;
            const fullDate = formatDayOfWeek(dateVal);

            const alertBox = document.getElementById('slotSelectedAlert');
            if (alertBox) alertBox.classList.remove('d-none');
            document.getElementById('alertSlotText').innerText = `${displayTime} &bull; ${fullDate}`;

            document.getElementById('sideSlotText').innerText = displayTime;

            const btnNext3 = document.getElementById('btnNext3');
            if (btnNext3) btnNext3.disabled = false;
        }

        function switchToClinicAssignmentAndReload() {
            setDoctorSelectionMode('ClinicAssignment');
            loadAvailableSlots();
        }

        // ============================================
        // STEP 5: TÓM TẮT & XÁC NHẬN
        // ============================================
        function updateSummary() {
            document.getElementById('summaryService').innerText = selectedService.name || '--';
            document.getElementById('summaryDept').innerText = selectedService.deptName || '--';
            document.getElementById('summaryDuration').innerText = `${selectedService.duration} phút`;
            document.getElementById('summaryPrice').innerText = selectedService.price || '--';

            const dentistDisplay = doctorSelectionMode === 'PreferredDentist' && selectedDentist.id
                ? `BS. ${selectedDentist.name} (Bác sĩ yêu cầu)`
                : 'Để phòng khám phân công bác sĩ phù hợp';
            document.getElementById('summaryDentist').innerText = dentistDisplay;

            const dateVal = document.getElementById('inputAppointmentDate').value;
            document.getElementById('summaryDate').innerText = formatDayOfWeek(dateVal);
            document.getElementById('summarySlot').innerText = selectedSlot ? selectedSlot.text : '--';

            const name = document.getElementById('inputPatientFullName').value || 'Bệnh nhân';
            const phone = document.getElementById('inputPatientPhoneNumber').value || '--';
            const reason = document.getElementById('inputReasonForVisit').value || '--';

            document.getElementById('summaryPatient').innerText = name;
            document.getElementById('summaryPhone').innerText = phone;
            document.getElementById('summaryReason').innerText = reason;
        }

        // ============================================
        // ANTI DOUBLE-CLICK SUBMIT
        // ============================================
        function validateAndSubmitBooking(e) {
            if (isSubmitting) {
                e.preventDefault();
                return false;
            }

            const reason = document.getElementById('inputReasonForVisit').value.trim();
            if (reason.length < 5) {
                alert('Vui lòng nhập lý do khám tối thiểu 5 ký tự.');
                goToStep(4);
                e.preventDefault();
                return false;
            }

            if (!selectedSlot || !document.getElementById('hiddenScheduledStart').value) {
                alert('Vui lòng chọn khung giờ khám hợp lệ.');
                goToStep(3);
                e.preventDefault();
                return false;
            }

            isSubmitting = true;
            const submitBtn = document.getElementById('btnSubmitBooking');
            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Đang gửi yêu cầu...';
            }
            return true;
        }

        // Init on DOM ready
        document.addEventListener('DOMContentLoaded', function () {
            // Bind service click events
            document.querySelectorAll('.service-item').forEach(el => {
                el.addEventListener('click', function () {
                    const id = parseInt(this.getAttribute('data-service-id'));
                    const deptId = parseInt(this.getAttribute('data-dept-id'));
                    const deptName = this.getAttribute('data-dept-name');
                    const name = this.getAttribute('data-name');
                    const duration = parseInt(this.getAttribute('data-duration') || 30);
                    const price = this.getAttribute('data-price');
                    const isComplex = this.getAttribute('data-is-complex') === 'true';
                    selectService(id, name, deptId, deptName, duration, price, isComplex);
                });
            });

            // Check preselected service
            const initialServiceId = parseInt('@Model.RequestedServiceId');
            if (initialServiceId > 0) {
                const target = document.querySelector(`.service-item[data-service-id="${initialServiceId}"]`);
                if (target) target.click();
            }

            // Init date display
            const initialDate = document.getElementById('inputAppointmentDate').value;
            if (initialDate) {
                const textElem = document.getElementById('dateTextFull');
                if (textElem) textElem.innerText = formatDayOfWeek(initialDate);
                const sideDate = document.getElementById('sideDateText');
                if (sideDate) sideDate.innerText = formatDayOfWeek(initialDate);
            }
        });
    </script>
}
