@using DentalClinic.Web.Models.ApiDtos
@model DentalClinic.Web.ViewModels.MedicalRecord.PatientMedicalRecordIndexViewModel
@{
    ViewData["Title"] = "Hồ Sơ Bệnh Án Của Tôi";
    var record = Model.Record;
}

<style>
    .odontogram-wrapper {
        background: #f8fafc;
        border-radius: 12px;
        padding: 20px;
        border: 1px solid #e2e8f0;
    }
    .arch-container {
        display: flex;
        justify-content: center;
        gap: 6px;
        flex-wrap: wrap;
        margin-bottom: 12px;
    }
    .quadrant-group {
        display: flex;
        gap: 5px;
    }
    .quadrant-divider {
        width: 2px;
        background: #cbd5e1;
        margin: 0 8px;
    }
    .tooth-card {
        width: 44px;
        height: 65px;
        background: #ffffff;
        border: 2px solid #cbd5e1;
        border-radius: 8px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: space-between;
        padding: 4px 2px;
        position: relative;
    }
    .tooth-number {
        font-size: 0.75rem;
        font-weight: 700;
        color: #1e293b;
    }
    .tooth-icon {
        font-size: 1.1rem;
    }
    .tooth-status-tag {
        font-size: 0.55rem;
        font-weight: 700;
        padding: 1px 2px;
        border-radius: 3px;
        text-transform: uppercase;
        width: 100%;
        text-align: center;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .tooth-healthy { border-color: #94a3b8; }
    .tooth-healthy .tooth-icon { color: #64748b; }
    .tooth-healthy .tooth-status-tag { background: #f1f5f9; color: #475569; }

    .tooth-caries { border-color: #ef4444; background: #fff1f2; }
    .tooth-caries .tooth-icon { color: #dc2626; }
    .tooth-caries .tooth-status-tag { background: #fee2e2; color: #b91c1c; }

    .tooth-filled { border-color: #0284c7; background: #f0f9ff; }
    .tooth-filled .tooth-icon { color: #0284c7; }
    .tooth-filled .tooth-status-tag { background: #e0f2fe; color: #0369a1; }

    .tooth-missing { border-color: #64748b; background: #e2e8f0; opacity: 0.6; }
    .tooth-missing .tooth-icon { color: #475569; }
    .tooth-missing .tooth-status-tag { background: #cbd5e1; color: #334155; }

    .tooth-crown { border-color: #eab308; background: #fefce8; }
    .tooth-crown .tooth-icon { color: #ca8a04; }
    .tooth-crown .tooth-status-tag { background: #fef9c3; color: #a16207; }

    .tooth-pulpitis { border-color: #a855f7; background: #faf5ff; }
    .tooth-pulpitis .tooth-icon { color: #9333ea; }
    .tooth-pulpitis .tooth-status-tag { background: #f3e8ff; color: #7e22ce; }

    .tooth-extractionneeded { border-color: #f97316; background: #fff7ed; }
    .tooth-extractionneeded .tooth-icon { color: #ea580c; }
    .tooth-extractionneeded .tooth-status-tag { background: #ffedd5; color: #c2410c; }
</style>

<div class="container-fluid px-4 py-4">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary-subtle text-primary fw-medium px-2 py-1 fs-12">
                    <i class="bi bi-person-heart me-1"></i> Bệnh nhân
                </span>
                <span class="badge bg-light text-muted fw-normal px-2 py-1 fs-12">Hồ Sơ Sức Khỏe</span>
            </div>
            <h1 class="h3 fw-bold text-slate-800 mb-0">Hồ Sơ Bệnh Án Răng Miệng Của Tôi</h1>
            <p class="text-muted small mb-0 mt-1">Theo dõi tình trạng sức khỏe răng miệng, sơ đồ răng cá nhân và lịch sử các đợt khám điều trị</p>
        </div>
    </div>

    @if (record != null)
    {
        <!-- Patient Info Card -->
        <div class="card border-0 shadow-sm rounded-3 mb-4 bg-white p-3">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-primary-subtle text-primary p-3 rounded-circle fs-3 fw-bold">
                        <i class="bi bi-person-circle"></i>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2">
                            <h4 class="fw-bold text-slate-800 mb-0">@record.PatientName</h4>
                            <span class="badge bg-secondary-subtle text-secondary border">@record.PatientCode</span>
                        </div>
                        <div class="text-muted small mt-1 d-flex flex-wrap gap-3">
                            <span><i class="bi bi-telephone me-1"></i>@(record.PatientPhone ?? "—")</span>
                            <span><i class="bi bi-gender-ambiguous me-1"></i>@(record.Gender ?? "—")</span>
                            <span><i class="bi bi-calendar3 me-1"></i>@(record.DateOfBirth?.ToString("dd/MM/yyyy") ?? "—") (@(record.Age.HasValue ? $"{record.Age} tuổi" : "—"))</span>
                            <span><i class="bi bi-geo-alt me-1"></i>@(record.Address ?? "—")</span>
                        </div>
                    </div>
                </div>
                <div class="text-end">
                    <div class="text-muted small">Ngày khởi tạo hồ sơ:</div>
                    <div class="fw-bold text-dark">@record.CreatedAt.ToString("dd/MM/yyyy")</div>
                </div>
            </div>
        </div>

        <!-- Odontogram -->
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                <h5 class="card-title fw-bold text-slate-800 mb-0 d-flex align-items-center gap-2">
                    <i class="bi bi-grid-3x3-gap-fill text-primary"></i>
                    <span>Sơ Đồ Răng Cá Nhân (Odontogram)</span>
                </h5>
                <span class="badge bg-light text-muted border">32 Răng</span>
            </div>
            <div class="card-body p-4">
                <div class="odontogram-wrapper">
                    <div class="text-center small fw-bold text-muted mb-2 text-uppercase letter-spacing-1">
                        <i class="bi bi-arrow-up-circle me-1"></i> Hàm Trên
                    </div>
                    <div class="arch-container">
                        <div class="quadrant-group">
                            @for (int i = 18; i >= 11; i--)
                            {
                                var tStr = i.ToString();
                                var tooth = record.CurrentOdontogram.FirstOrDefault(x => x.ToothNumber == tStr) ?? new OdontogramEntryDto { ToothNumber = tStr, Condition = "Healthy" };
                                var condClass = $"tooth-{tooth.Condition.ToLower()}";
                                <div class="tooth-card @condClass" title="Răng @tStr: @tooth.Condition">
                                    <span class="tooth-number">@tStr</span>
                                    <i class="bi bi-shield-fill tooth-icon"></i>
                                    <span class="tooth-status-tag">@tooth.Condition</span>
                                </div>
                            }
                        </div>
                        <div class="quadrant-divider"></div>
                        <div class="quadrant-group">
                            @for (int i = 21; i <= 28; i++)
                            {
                                var tStr = i.ToString();
                                var tooth = record.CurrentOdontogram.FirstOrDefault(x => x.ToothNumber == tStr) ?? new OdontogramEntryDto { ToothNumber = tStr, Condition = "Healthy" };
                                var condClass = $"tooth-{tooth.Condition.ToLower()}";
                                <div class="tooth-card @condClass" title="Răng @tStr: @tooth.Condition">
                                    <span class="tooth-number">@tStr</span>
                                    <i class="bi bi-shield-fill tooth-icon"></i>
                                    <span class="tooth-status-tag">@tooth.Condition</span>
                                </div>
                            }
                        </div>
                    </div>

                    <hr class="my-3 text-slate-300" />

                    <div class="arch-container">
                        <div class="quadrant-group">
                            @for (int i = 48; i >= 41; i--)
                            {
                                var tStr = i.ToString();
                                var tooth = record.CurrentOdontogram.FirstOrDefault(x => x.ToothNumber == tStr) ?? new OdontogramEntryDto { ToothNumber = tStr, Condition = "Healthy" };
                                var condClass = $"tooth-{tooth.Condition.ToLower()}";
                                <div class="tooth-card @condClass" title="Răng @tStr: @tooth.Condition">
                                    <span class="tooth-number">@tStr</span>
                                    <i class="bi bi-shield-fill tooth-icon"></i>
                                    <span class="tooth-status-tag">@tooth.Condition</span>
                                </div>
                            }
                        </div>
                        <div class="quadrant-divider"></div>
                        <div class="quadrant-group">
                            @for (int i = 31; i <= 38; i++)
                            {
                                var tStr = i.ToString();
                                var tooth = record.CurrentOdontogram.FirstOrDefault(x => x.ToothNumber == tStr) ?? new OdontogramEntryDto { ToothNumber = tStr, Condition = "Healthy" };
                                var condClass = $"tooth-{tooth.Condition.ToLower()}";
                                <div class="tooth-card @condClass" title="Răng @tStr: @tooth.Condition">
                                    <span class="tooth-number">@tStr</span>
                                    <i class="bi bi-shield-fill tooth-icon"></i>
                                    <span class="tooth-status-tag">@tooth.Condition</span>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="text-center small fw-bold text-muted mt-2 text-uppercase letter-spacing-1">
                        <i class="bi bi-arrow-down-circle me-1"></i> Hàm Dưới
                    </div>
                </div>

                <!-- Legend -->
                <div class="d-flex flex-wrap align-items-center justify-content-center gap-3 mt-3 pt-2 text-muted fs-12">
                    <span class="d-flex align-items-center gap-1"><span class="badge bg-secondary p-1 rounded-circle"></span> Khỏe mạnh</span>
                    <span class="d-flex align-items-center gap-1"><span class="badge bg-danger p-1 rounded-circle"></span> Sâu răng</span>
                    <span class="d-flex align-items-center gap-1"><span class="badge bg-primary p-1 rounded-circle"></span> Đã trám</span>
                    <span class="d-flex align-items-center gap-1"><span class="badge bg-dark p-1 rounded-circle"></span> Mất răng</span>
                    <span class="d-flex align-items-center gap-1"><span class="badge bg-warning p-1 rounded-circle"></span> Bọc sứ</span>
                    <span class="d-flex align-items-center gap-1"><span class="badge bg-info p-1 rounded-circle"></span> Viêm tủy</span>
                </div>
            </div>
        </div>

        <!-- History -->
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                <h5 class="card-title fw-bold text-slate-800 mb-0 d-flex align-items-center gap-2">
                    <i class="bi bi-clock-history text-primary"></i>
                    <span>Lịch Sử Các Lần Khám & Chẩn Đoán</span>
                    <span class="badge bg-secondary-subtle text-secondary rounded-pill fs-12 ms-1">@record.ClinicalEntries.Count lần</span>
                </h5>
            </div>
            <div class="card-body p-4 pt-2">
                @if (record.ClinicalEntries.Any())
                {
                    @foreach (var entry in record.ClinicalEntries)
                    {
                        <div class="card border rounded-3 p-3 mb-3 bg-light-subtle">
                            <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                                <span class="fw-bold text-dark fs-15">
                                    <i class="bi bi-calendar-check me-1 text-primary"></i>Ngày khám: @entry.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                </span>
                                <span class="text-muted small">Bác sĩ khám: <strong>@entry.DentistName</strong></span>
                            </div>
                            <div class="row g-2 fs-14">
                                <div class="col-12">
                                    <div class="text-muted small fw-semibold">Chẩn đoán:</div>
                                    <div class="fw-bold text-primary">@entry.Diagnosis</div>
                                </div>
                                @if (!string.IsNullOrEmpty(entry.ClinicalNotes))
                                {
                                    <div class="col-12">
                                        <div class="text-muted small fw-semibold">Lời dặn của bác sĩ:</div>
                                        <div class="text-muted fst-italic">@entry.ClinicalNotes</div>
                                    </div>
                                }
                                @if (entry.ImagingRecords.Any())
                                {
                                    <div class="col-12 mt-2 pt-2 border-top">
                                        <div class="fw-semibold text-slate-800 small mb-2 d-flex align-items-center gap-2">
                                            <i class="bi bi-images text-primary"></i>
                                            <span>Phim X-Quang & Hình Ảnh Nha Khoa</span>
                                            <span class="badge bg-primary-subtle text-primary rounded-pill fs-11">@entry.ImagingRecords.Count ảnh</span>
                                        </div>
                                        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-2">
                                            @foreach (var img in entry.ImagingRecords)
                                            {
                                                var badgeColor = img.ImagingType switch
                                                {
                                                    "Panorama" => "bg-primary",
                                                    "Periapical" => "bg-info text-white",
                                                    "Cephalometric" => "bg-success",
                                                    "Intraoral" => "bg-warning text-dark",
                                                    _ => "bg-secondary"
                                                };
                                                var imgUrl = Url.Action("ImageContent", "PatientMedicalRecord", new { id = img.ImagingRecordId });
                                                <div class="col">
                                                    <div class="card h-100 border shadow-none bg-dark text-white rounded-3 overflow-hidden position-relative imaging-card">
                                                        <div class="position-relative" style="height: 120px; background: #020617; overflow: hidden; display: flex; align-items: center; justify-content: center;">
                                                            <img src="@imgUrl" alt="@img.ImagingType"
                                                                 class="img-fluid w-100 h-100 object-fit-cover cursor-pointer"
                                                                 onclick="openPatientLightbox('@imgUrl', '@img.ImagingType', '@img.CreatedAt.ToString("dd/MM/yyyy HH:mm")', '@(img.ResultSummary?.Replace("'", "\\'"))')"
                                                                 title="Nhấp để phóng to ảnh X-quang" />
                                                            <span class="position-absolute top-0 start-0 m-1 badge @badgeColor fs-10 shadow-sm">
                                                                @img.ImagingType
                                                            </span>
                                                        </div>
                                                        <div class="card-body p-2 bg-slate-900 fs-11 text-slate-300">
                                                            <div class="text-white-50 mb-1"><i class="bi bi-clock me-1"></i>@img.CreatedAt.ToString("dd/MM/yyyy")</div>
                                                            @if (!string.IsNullOrEmpty(img.ResultSummary))
                                                            {
                                                                <div class="text-truncate text-white" title="@img.ResultSummary">
                                                                    <i class="bi bi-chat-left-dots me-1 text-primary"></i>@img.ResultSummary
                                                                </div>
                                                            }
                                                            <button type="button" class="btn btn-xs btn-outline-light w-100 mt-2 py-1 fs-11"
                                                                    onclick="openPatientLightbox('@imgUrl', '@img.ImagingType', '@img.CreatedAt.ToString("dd/MM/yyyy HH:mm")', '@(img.ResultSummary?.Replace("'", "\\'"))')">
                                                                <i class="bi bi-arrows-fullscreen me-1"></i> Phóng to xem
                                                            </button>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-journal-x fs-1 d-block mb-2 text-secondary"></i>
                        Bạn chưa có lịch sử chẩn đoán lâm sàng nào.
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-3 p-5 text-center text-muted">
            <i class="bi bi-journal-medical fs-1 d-block mb-2 text-secondary"></i>
            <h5>Hồ sơ bệnh án điện tử của bạn đang được khởi tạo trên hệ thống.</h5>
            <p class="small text-muted">Khi bạn đến khám tại phòng khám, các bác sĩ sẽ ghi nhận chẩn đoán và cập nhật sơ đồ răng của bạn tại đây.</p>
        </div>
    }
</div>

<!-- ==================================================== -->
<!-- PATIENT LIGHTBOX & DIAGNOSTIC VIEWER -->
<!-- ==================================================== -->
<div class="modal fade" id="patientLightboxModal" tabindex="-1" aria-labelledby="patientLightboxModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content bg-slate-950 text-white border-0">
            <div class="modal-header bg-slate-900 border-bottom border-slate-800 py-2 px-3 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <span id="pLbTypeBadge" class="badge bg-primary fs-14">Panorama</span>
                    <span id="pLbDateText" class="text-slate-400 small ms-2"></span>
                </div>

                <!-- Viewer Controls Toolbar -->
                <div class="d-flex align-items-center gap-1 bg-slate-800 px-2 py-1 rounded-pill border border-slate-700">
                    <button type="button" class="btn btn-sm btn-dark text-white rounded-circle p-2" onclick="pLbZoom(0.25)" title="Phóng to (+)">
                        <i class="bi bi-zoom-in"></i>
                    </button>
                    <button type="button" class="btn btn-sm btn-dark text-white rounded-circle p-2" onclick="pLbZoom(-0.25)" title="Thu nhỏ (-)">
                        <i class="bi bi-zoom-out"></i>
                    </button>
                    <button type="button" class="btn btn-sm btn-dark text-white rounded-pill px-3 py-1" onclick="pLbReset()" title="Kích thước gốc (1:1)">
                        <i class="bi bi-arrows-angle-contract me-1"></i> <span id="pLbScalePercent">100%</span>
                    </button>
                    <div class="vr bg-secondary mx-1 my-1"></div>
                    <button type="button" class="btn btn-sm btn-dark text-white rounded-circle p-2" onclick="pLbRotate()" title="Xoay 90 độ">
                        <i class="bi bi-arrow-clockwise"></i>
                    </button>
                    <button type="button" id="pLbInvertBtn" class="btn btn-sm btn-dark text-warning rounded-pill px-3 py-1" onclick="pLbToggleInvert()" title="Chế độ âm bản X-quang (Invert colors)">
                        <i class="bi bi-circle-half me-1"></i> Âm bản (Invert)
                    </button>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <a id="pLbOpenDirectLink" href="#" target="_blank" class="btn btn-sm btn-outline-light rounded-pill px-3" title="Mở ảnh trong tab riêng">
                        <i class="bi bi-box-arrow-up-right me-1"></i> Mở Tab Mới
                    </a>
                    <button type="button" class="btn btn-sm btn-outline-danger rounded-circle p-2" data-bs-dismiss="modal" aria-label="Close" title="Đóng Lightbox (ESC)">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </div>

            <div class="modal-body p-0 position-relative d-flex align-items-center justify-content-center overflow-hidden"
                 id="pLbViewport"
                 style="height: calc(100vh - 120px); background: #030712; cursor: grab; user-select: none;">
                <img id="pLbMainImage" src="" alt="Dental Image"
                     style="max-width: 90vw; max-height: 80vh; object-fit: contain; transform-origin: center center; transition: filter 0.2s ease;" />
            </div>

            <div class="modal-footer bg-slate-900 border-top border-slate-800 py-2 px-4 justify-content-between">
                <div id="pLbSummaryContainer" class="text-slate-300 small">
                    <strong class="text-white me-1"><i class="bi bi-file-earmark-medical me-1 text-primary"></i>Kết luận chẩn đoán:</strong>
                    <span id="pLbSummaryText" class="fst-italic text-slate-300">Không có ghi chú.</span>
                </div>
                <div class="text-slate-500 fs-12">
                    <span><i class="bi bi-mouse me-1"></i>Kéo chuột để di chuyển (Pan) • Cuộn chuột để phóng to/thu nhỏ (Zoom)</span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let pLbScale = 1;
        let pLbRotation = 0;
        let pLbIsInverted = false;
        let pLbPosX = 0;
        let pLbPosY = 0;
        let pLbIsDragging = false;
        let pLbStartX = 0;
        let pLbStartY = 0;

        function openPatientLightbox(imgUrl, imagingType, dateStr, summary) {
            const modalEl = document.getElementById('patientLightboxModal');
            const mainImg = document.getElementById('pLbMainImage');
            const typeBadge = document.getElementById('pLbTypeBadge');
            const dateText = document.getElementById('pLbDateText');
            const summaryText = document.getElementById('pLbSummaryText');
            const directLink = document.getElementById('pLbOpenDirectLink');

            mainImg.src = imgUrl;
            directLink.href = imgUrl;
            typeBadge.innerText = imagingType || 'X-Quang';
            dateText.innerText = dateStr ? 'Chụp ngày: ' + dateStr : '';
            summaryText.innerText = summary && summary.trim() !== '' ? summary : 'Không có ghi chú lâm sàng bổ sung.';

            pLbReset();

            const modal = new bootstrap.Modal(modalEl);
            modal.show();
        }

        function pLbUpdateTransform() {
            const img = document.getElementById('pLbMainImage');
            const percent = document.getElementById('pLbScalePercent');
            if (img) {
                img.style.transform = `translate(${pLbPosX}px, ${pLbPosY}px) scale(${pLbScale}) rotate(${pLbRotation}deg)`;
                img.style.filter = pLbIsInverted ? 'invert(100%) contrast(120%)' : 'none';
                if (percent) {
                    percent.innerText = Math.round(pLbScale * 100) + '%';
                }
            }
        }

        function pLbZoom(delta) {
            pLbScale = Math.max(0.25, Math.min(6.0, pLbScale + delta));
            pLbUpdateTransform();
        }

        function pLbRotate() {
            pLbRotation = (pLbRotation + 90) % 360;
            pLbUpdateTransform();
        }

        function pLbReset() {
            pLbScale = 1;
            pLbRotation = 0;
            pLbIsInverted = false;
            pLbPosX = 0;
            pLbPosY = 0;
            const invertBtn = document.getElementById('pLbInvertBtn');
            if (invertBtn) {
                invertBtn.classList.remove('btn-warning');
                invertBtn.classList.add('btn-dark');
            }
            pLbUpdateTransform();
        }

        function pLbToggleInvert() {
            pLbIsInverted = !pLbIsInverted;
            const invertBtn = document.getElementById('pLbInvertBtn');
            if (invertBtn) {
                if (pLbIsInverted) {
                    invertBtn.classList.remove('btn-dark');
                    invertBtn.classList.add('btn-warning');
                } else {
                    invertBtn.classList.remove('btn-warning');
                    invertBtn.classList.add('btn-dark');
                }
            }
            pLbUpdateTransform();
        }

        document.addEventListener("DOMContentLoaded", function() {
            const viewport = document.getElementById('pLbViewport');
            if (viewport) {
                viewport.addEventListener('mousedown', function(e) {
                    if (e.button === 0) {
                        pLbIsDragging = true;
                        pLbStartX = e.clientX - pLbPosX;
                        pLbStartY = e.clientY - pLbPosY;
                        viewport.style.cursor = 'grabbing';
                    }
                });

                window.addEventListener('mousemove', function(e) {
                    if (pLbIsDragging) {
                        pLbPosX = e.clientX - pLbStartX;
                        pLbPosY = e.clientY - pLbStartY;
                        pLbUpdateTransform();
                    }
                });

                window.addEventListener('mouseup', function() {
                    if (pLbIsDragging) {
                        pLbIsDragging = false;
                        viewport.style.cursor = 'grab';
                    }
                });

                viewport.addEventListener('wheel', function(e) {
                    e.preventDefault();
                    const delta = e.deltaY < 0 ? 0.2 : -0.2;
                    pLbZoom(delta);
                }, { passive: false });
            }
        });
    </script>
}
