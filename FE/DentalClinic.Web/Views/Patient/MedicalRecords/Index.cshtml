@using DentalClinic.Web.Models.ApiDtos
@model DentalClinic.Web.ViewModels.MedicalRecord.PatientMedicalRecordIndexViewModel
@{
    ViewData["Title"] = "Hồ Sơ Bệnh Án Của Tôi";
    var record = Model.Record;
}

@section Styles {
    <link rel="stylesheet" href="~/css/medical-imaging-viewer.css" asp-append-version="true" />
}

<style>
    .odontogram-wrapper {
        background: #f8fafc;
        border-radius: 12px;
        padding: 20px;
        border: 1px solid #e2e8f0;
    }
    .arch-container {
        display: flex;
        justify-content: center;
        gap: 6px;
        flex-wrap: wrap;
        margin-bottom: 12px;
    }
    .quadrant-group {
        display: flex;
        gap: 5px;
    }
    .quadrant-divider {
        width: 2px;
        background: #cbd5e1;
        margin: 0 8px;
    }
    .tooth-card {
        width: 44px;
        height: 65px;
        background: #ffffff;
        border: 2px solid #cbd5e1;
        border-radius: 8px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: space-between;
        padding: 4px 2px;
        position: relative;
    }
    .tooth-number {
        font-size: 0.75rem;
        font-weight: 700;
        color: #1e293b;
    }
    .tooth-icon {
        font-size: 1.1rem;
    }
    .tooth-status-tag {
        font-size: 0.55rem;
        font-weight: 700;
        padding: 1px 2px;
        border-radius: 3px;
        text-transform: uppercase;
        width: 100%;
        text-align: center;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .tooth-healthy { border-color: #94a3b8; }
    .tooth-healthy .tooth-icon { color: #64748b; }
    .tooth-healthy .tooth-status-tag { background: #f1f5f9; color: #475569; }

    .tooth-caries { border-color: #ef4444; background: #fff1f2; }
    .tooth-caries .tooth-icon { color: #dc2626; }
    .tooth-caries .tooth-status-tag { background: #fee2e2; color: #b91c1c; }

    .tooth-filled { border-color: #0284c7; background: #f0f9ff; }
    .tooth-filled .tooth-icon { color: #0284c7; }
    .tooth-filled .tooth-status-tag { background: #e0f2fe; color: #0369a1; }

    .tooth-missing { border-color: #64748b; background: #e2e8f0; opacity: 0.6; }
    .tooth-missing .tooth-icon { color: #475569; }
    .tooth-missing .tooth-status-tag { background: #cbd5e1; color: #334155; }

    .tooth-crown { border-color: #eab308; background: #fefce8; }
    .tooth-crown .tooth-icon { color: #ca8a04; }
    .tooth-crown .tooth-status-tag { background: #fef9c3; color: #a16207; }

    .tooth-pulpitis { border-color: #a855f7; background: #faf5ff; }
    .tooth-pulpitis .tooth-icon { color: #9333ea; }
    .tooth-pulpitis .tooth-status-tag { background: #f3e8ff; color: #7e22ce; }

    .tooth-extractionneeded { border-color: #f97316; background: #fff7ed; }
    .tooth-extractionneeded .tooth-icon { color: #ea580c; }
    .tooth-extractionneeded .tooth-status-tag { background: #ffedd5; color: #c2410c; }

    /* Imaging Gallery & Lightbox Styles */
    .img-thumbnail-fit {
        object-fit: cover;
        object-position: center;
        transition: transform 0.25s ease;
    }
    .imaging-preview-container:hover .img-thumbnail-fit {
        transform: scale(1.05);
    }
    .imaging-zoom-overlay {
        transition: opacity 0.2s ease;
        pointer-events: none;
    }
    .imaging-preview-container:hover .imaging-zoom-overlay {
        opacity: 1 !important;
    }
    .fs-11 { font-size: 0.72rem; }
    .text-truncate-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .btn-xs {
        padding: 0.15rem 0.5rem;
        font-size: 0.75rem;
        border-radius: 4px;
    }
    .bg-purple-subtle { background-color: #f3e8ff; color: #7e22ce; }
    .border-purple-subtle { border-color: #d8b4fe !important; }
</style>

<div class="container-fluid px-4 py-4">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary-subtle text-primary fw-medium px-2 py-1 fs-12">
                    <i class="bi bi-person-heart me-1"></i> Bệnh nhân
                </span>
                <span class="badge bg-light text-muted fw-normal px-2 py-1 fs-12">Hồ Sơ Sức Khỏe</span>
            </div>
            <h1 class="h3 fw-bold text-slate-800 mb-0">Hồ Sơ Bệnh Án Răng Miệng Của Tôi</h1>
            <p class="text-muted small mb-0 mt-1">Theo dõi tình trạng sức khỏe răng miệng, sơ đồ răng cá nhân và lịch sử các đợt khám điều trị</p>
        </div>
    </div>

    @if (record != null)
    {
        <!-- Patient Info Card -->
        <div class="card border-0 shadow-sm rounded-3 mb-4 bg-white p-3">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-primary-subtle text-primary p-3 rounded-circle fs-3 fw-bold">
                        <i class="bi bi-person-circle"></i>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2">
                            <h4 class="fw-bold text-slate-800 mb-0">@record.PatientName</h4>
                            <span class="badge bg-secondary-subtle text-secondary border">@record.PatientCode</span>
                        </div>
                        <div class="text-muted small mt-1 d-flex flex-wrap gap-3">
                            <span><i class="bi bi-telephone me-1"></i>@(record.PatientPhone ?? "—")</span>
                            <span><i class="bi bi-gender-ambiguous me-1"></i>@(record.Gender ?? "—")</span>
                            <span><i class="bi bi-calendar3 me-1"></i>@(record.DateOfBirth?.ToString("dd/MM/yyyy") ?? "—") (@(record.Age.HasValue ? $"{record.Age} tuổi" : "—"))</span>
                            <span><i class="bi bi-geo-alt me-1"></i>@(record.Address ?? "—")</span>
                        </div>
                    </div>
                </div>
                <div class="text-end">
                    <div class="text-muted small">Ngày khởi tạo hồ sơ:</div>
                    <div class="fw-bold text-dark">@record.CreatedAt.ToString("dd/MM/yyyy")</div>
                </div>
            </div>
        </div>

        <!-- Odontogram -->
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                <h5 class="card-title fw-bold text-slate-800 mb-0 d-flex align-items-center gap-2">
                    <i class="bi bi-grid-3x3-gap-fill text-primary"></i>
                    <span>Sơ Đồ Răng Cá Nhân (Odontogram)</span>
                </h5>
                <span class="badge bg-light text-muted border">32 Răng</span>
            </div>
            <div class="card-body p-4">
                <div class="odontogram-wrapper">
                    <div class="text-center small fw-bold text-muted mb-2 text-uppercase letter-spacing-1">
                        <i class="bi bi-arrow-up-circle me-1"></i> Hàm Trên
                    </div>
                    <div class="arch-container">
                        <div class="quadrant-group">
                            @for (int i = 18; i >= 11; i--)
                            {
                                var tStr = i.ToString();
                                var tooth = record.CurrentOdontogram.FirstOrDefault(x => x.ToothNumber == tStr) ?? new OdontogramEntryDto { ToothNumber = tStr, Condition = "Healthy" };
                                var condClass = $"tooth-{tooth.Condition.ToLower()}";
                                <div class="tooth-card @condClass" title="Răng @tStr: @tooth.Condition">
                                    <span class="tooth-number">@tStr</span>
                                    <i class="bi bi-shield-fill tooth-icon"></i>
                                    <span class="tooth-status-tag">@tooth.Condition</span>
                                </div>
                            }
                        </div>
                        <div class="quadrant-divider"></div>
                        <div class="quadrant-group">
                            @for (int i = 21; i <= 28; i++)
                            {
                                var tStr = i.ToString();
                                var tooth = record.CurrentOdontogram.FirstOrDefault(x => x.ToothNumber == tStr) ?? new OdontogramEntryDto { ToothNumber = tStr, Condition = "Healthy" };
                                var condClass = $"tooth-{tooth.Condition.ToLower()}";
                                <div class="tooth-card @condClass" title="Răng @tStr: @tooth.Condition">
                                    <span class="tooth-number">@tStr</span>
                                    <i class="bi bi-shield-fill tooth-icon"></i>
                                    <span class="tooth-status-tag">@tooth.Condition</span>
                                </div>
                            }
                        </div>
                    </div>

                    <hr class="my-3 text-slate-300" />

                    <div class="arch-container">
                        <div class="quadrant-group">
                            @for (int i = 48; i >= 41; i--)
                            {
                                var tStr = i.ToString();
                                var tooth = record.CurrentOdontogram.FirstOrDefault(x => x.ToothNumber == tStr) ?? new OdontogramEntryDto { ToothNumber = tStr, Condition = "Healthy" };
                                var condClass = $"tooth-{tooth.Condition.ToLower()}";
                                <div class="tooth-card @condClass" title="Răng @tStr: @tooth.Condition">
                                    <span class="tooth-number">@tStr</span>
                                    <i class="bi bi-shield-fill tooth-icon"></i>
                                    <span class="tooth-status-tag">@tooth.Condition</span>
                                </div>
                            }
                        </div>
                        <div class="quadrant-divider"></div>
                        <div class="quadrant-group">
                            @for (int i = 31; i <= 38; i++)
                            {
                                var tStr = i.ToString();
                                var tooth = record.CurrentOdontogram.FirstOrDefault(x => x.ToothNumber == tStr) ?? new OdontogramEntryDto { ToothNumber = tStr, Condition = "Healthy" };
                                var condClass = $"tooth-{tooth.Condition.ToLower()}";
                                <div class="tooth-card @condClass" title="Răng @tStr: @tooth.Condition">
                                    <span class="tooth-number">@tStr</span>
                                    <i class="bi bi-shield-fill tooth-icon"></i>
                                    <span class="tooth-status-tag">@tooth.Condition</span>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="text-center small fw-bold text-muted mt-2 text-uppercase letter-spacing-1">
                        <i class="bi bi-arrow-down-circle me-1"></i> Hàm Dưới
                    </div>
                </div>

                <!-- Legend -->
                <div class="d-flex flex-wrap align-items-center justify-content-center gap-3 mt-3 pt-2 text-muted fs-12">
                    <span class="d-flex align-items-center gap-1"><span class="badge bg-secondary p-1 rounded-circle"></span> Khỏe mạnh</span>
                    <span class="d-flex align-items-center gap-1"><span class="badge bg-danger p-1 rounded-circle"></span> Sâu răng</span>
                    <span class="d-flex align-items-center gap-1"><span class="badge bg-primary p-1 rounded-circle"></span> Đã trám</span>
                    <span class="d-flex align-items-center gap-1"><span class="badge bg-dark p-1 rounded-circle"></span> Mất răng</span>
                    <span class="d-flex align-items-center gap-1"><span class="badge bg-warning p-1 rounded-circle"></span> Bọc sứ</span>
                    <span class="d-flex align-items-center gap-1"><span class="badge bg-info p-1 rounded-circle"></span> Viêm tủy</span>
                </div>
            </div>
        </div>

        <!-- History -->
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                <h5 class="card-title fw-bold text-slate-800 mb-0 d-flex align-items-center gap-2">
                    <i class="bi bi-clock-history text-primary"></i>
                    <span>Lịch Sử Các Lần Khám & Chẩn Đoán</span>
                    <span class="badge bg-secondary-subtle text-secondary rounded-pill fs-12 ms-1">@record.ClinicalEntries.Count lần</span>
                </h5>
            </div>
            <div class="card-body p-4 pt-2">
                @if (record.ClinicalEntries.Any())
                {
                    @foreach (var entry in record.ClinicalEntries)
                    {
                        <div class="card border rounded-3 p-3 mb-3 bg-light-subtle">
                            <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                                <span class="fw-bold text-dark fs-15">
                                    <i class="bi bi-calendar-check me-1 text-primary"></i>Ngày khám: @entry.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                </span>
                                <span class="text-muted small">Bác sĩ khám: <strong>@entry.DentistName</strong></span>
                            </div>
                            <div class="row g-2 fs-14">
                                <div class="col-12">
                                    <div class="text-muted small fw-semibold">Chẩn đoán:</div>
                                    <div class="fw-bold text-primary">@entry.Diagnosis</div>
                                </div>
                                @if (!string.IsNullOrEmpty(entry.ClinicalNotes))
                                {
                                    <div class="col-12">
                                        <div class="text-muted small fw-semibold">Lời dặn của bác sĩ:</div>
                                        <div class="text-muted fst-italic">@entry.ClinicalNotes</div>
                                    </div>
                                }
                                <!-- Phim X-quang / Hình ảnh điều trị (Patient Thumbnail Gallery - Commit 18) -->
                                <div class="col-12 mt-3 pt-3 border-top">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="text-muted small fw-bold text-uppercase d-flex align-items-center gap-1">
                                            <i class="bi bi-images text-primary"></i>
                                            <span>Phim X-quang & Hình ảnh điều trị</span>
                                            <span class="badge bg-primary-subtle text-primary ms-1">@entry.ImagingRecords.Count</span>
                                        </span>
                                    </div>

                                    @if (entry.ImagingRecords.Any())
                                    {
                                        <div class="row g-3">
                                            @foreach (var img in entry.ImagingRecords)
                                            {
                                                var isDicom = (!string.IsNullOrEmpty(img.FileUrl) && (img.FileUrl.EndsWith(".dcm", StringComparison.OrdinalIgnoreCase) || img.FileUrl.EndsWith(".dicom", StringComparison.OrdinalIgnoreCase))) ||
                                                              img.ImagingType.Equals("DICOM", StringComparison.OrdinalIgnoreCase);
                                                var safeUrl = Url.Action("ImagingContent", "PatientMedicalRecord", new { imagingRecordId = img.ImagingRecordId });
                                                var badgeColor = img.ImagingType switch
                                                {
                                                    "Panorama" => "bg-primary-subtle text-primary border-primary-subtle",
                                                    "Periapical" => "bg-info-subtle text-info border-info-subtle",
                                                    "Cephalometric" => "bg-purple-subtle text-purple border-purple-subtle",
                                                    "Intraoral" => "bg-success-subtle text-success border-success-subtle",
                                                    _ => "bg-secondary-subtle text-secondary border-secondary-subtle"
                                                };

                                                <div class="col-6 col-md-4 col-lg-3">
                                                    <div class="card h-100 border rounded-3 shadow-none overflow-hidden imaging-thumbnail-card bg-white">
                                                        <div class="d-flex align-items-center justify-content-between px-2 pt-2 pb-1 border-bottom bg-light-subtle">
                                                            <span class="badge @badgeColor small text-truncate fw-semibold">
                                                                <i class="bi bi-film me-1"></i>@img.ImagingType
                                                            </span>
                                                            <span class="text-muted fs-11" title="@img.CreatedAt.ToString("dd/MM/yyyy HH:mm")">
                                                                @img.CreatedAt.ToString("dd/MM/yyyy")
                                                            </span>
                                                        </div>

                                                        @if (isDicom)
                                                        {
                                                            <div class="p-3 text-center bg-light d-flex flex-column align-items-center justify-content-center" style="min-height: 140px;">
                                                                <i class="bi bi-file-earmark-medical-fill text-primary" style="font-size: 2.2rem;"></i>
                                                                <span class="badge bg-primary-subtle text-primary border mt-2 small">DICOM PS 3.10</span>
                                                                <span class="text-muted small mt-1" style="font-size: 0.75rem;">Định dạng y tế chuyên dụng</span>
                                                                <a href="@safeUrl" class="btn btn-xs btn-outline-primary mt-2" download>
                                                                    <i class="bi bi-download me-1"></i> Tải file .dcm
                                                                </a>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <div class="imaging-preview-container position-relative bg-dark text-center" style="height: 140px; cursor: pointer;"
                                                                 onclick="openImagingLightbox('@safeUrl', '@img.ImagingType', '@(img.ResultSummary?.Replace("'", "\\'") ?? "")', '@img.CreatedAt.ToString("dd/MM/yyyy HH:mm")', false)"
                                                                 title="Nhấn để phóng to xem chi tiết">
                                                                <img src="@safeUrl"
                                                                     class="w-100 h-100 img-thumbnail-fit"
                                                                     alt="@img.ImagingType"
                                                                     loading="lazy"
                                                                     onerror="this.onerror=null; this.parentElement.innerHTML='<div class=\'p-3 text-center text-muted small h-100 d-flex flex-column align-items-center justify-content-center\'><i class=\'bi bi-image-fill fs-2 text-secondary mb-1\'></i> Không thể tải ảnh an toàn</div>';" />
                                                                <div class="imaging-zoom-overlay position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center text-white bg-dark bg-opacity-25 opacity-0">
                                                                    <i class="bi bi-zoom-in fs-4"></i>
                                                                </div>
                                                            </div>
                                                        }

                                                        <div class="p-2 border-top bg-white flex-grow-1 d-flex flex-column justify-content-between">
                                                            <div class="small text-slate-700 text-truncate-2" title="@img.ResultSummary">
                                                                <i class="bi bi-chat-left-text me-1 text-muted"></i>
                                                                @if (!string.IsNullOrWhiteSpace(img.ResultSummary))
                                                                {
                                                                    <span>@img.ResultSummary</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="text-muted fst-italic">Chưa có kết luận</span>
                                                                }
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-center py-3 px-2 bg-light-subtle rounded-3 border border-dashed text-muted small my-2">
                                            <i class="bi bi-film fs-4 d-block mb-1 text-secondary opacity-50"></i>
                                            <span>Chưa có phim X-quang hoặc hình ảnh điều trị nào cho ca khám này.</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-journal-x fs-1 d-block mb-2 text-secondary"></i>
                        Bạn chưa có lịch sử chẩn đoán lâm sàng nào.
                    </div>
                }
            </div>
        </div>

        <!-- Modal Phóng To Ảnh X-Quang Cho Bệnh Nhân (Lightbox - Commit 19 & Day 01: Zoom In / Zoom Out) -->
        <div class="modal fade" id="imagingLightboxModal" tabindex="-1" aria-labelledby="imagingLightboxModalLabel" aria-hidden="true" role="dialog" aria-modal="true">
            <div class="modal-dialog modal-xl modal-dialog-centered">
                <div class="modal-content bg-dark text-white border-0 shadow-lg overflow-hidden">
                    <div class="modal-header border-secondary border-opacity-50 py-2 px-3 bg-dark d-flex flex-wrap align-items-center justify-content-between gap-2">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-aspect-ratio text-info fs-5"></i>
                            <span class="badge bg-primary text-white px-2 py-1" id="lightboxTypeBadge">X-Quang</span>
                            <span class="text-white-50 small ms-2" id="lightboxDate"></span>
                        </div>

                        <!-- Medical Imaging Zoom Toolbar (Day 01) -->
                        <div class="imaging-zoom-toolbar btn-toolbar d-flex align-items-center gap-1 px-2 py-1" role="toolbar" aria-label="Thanh công cụ thu phóng X-quang">
                            <button type="button" id="btnZoomOut" class="btn btn-sm btn-outline-light border-0 px-2 py-1" title="Thu nhỏ (-)" aria-label="Thu nhỏ">
                                <i class="bi bi-dash-lg"></i>
                            </button>
                            <span id="zoomPercentageBadge" class="badge font-monospace px-2 py-1" title="Tỷ lệ thu phóng hiện tại" aria-live="polite">
                                100%
                            </span>
                            <button type="button" id="btnZoomIn" class="btn btn-sm btn-outline-light border-0 px-2 py-1" title="Phóng to (+)" aria-label="Phóng to">
                                <i class="bi bi-plus-lg"></i>
                            </button>
                            <div class="vr bg-secondary opacity-50 mx-1 my-1"></div>
                            <button type="button" id="btnFitScreen" class="btn btn-sm btn-outline-light border-0 px-2 py-1 d-flex align-items-center gap-1" title="Vừa khung nhìn (Fit to Screen - Phím F)" aria-label="Vừa khung nhìn">
                                <i class="bi bi-arrows-angle-contract"></i>
                                <span class="d-none d-sm-inline small">Vừa khung</span>
                            </button>
                            <button type="button" id="btnResetView" class="btn btn-sm btn-outline-light border-0 px-2 py-1 d-flex align-items-center gap-1" title="Đặt lại góc nhìn (Reset 100% - Phím 0 / R)" aria-label="Đặt lại góc nhìn">
                                <i class="bi bi-arrow-counterclockwise"></i>
                                <span class="d-none d-sm-inline small">Đặt lại</span>
                            </button>
                        </div>

                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng (Esc)"></button>
                    </div>
                    <div id="imagingViewport" class="modal-body p-0 position-relative d-flex justify-content-center align-items-center bg-black imaging-viewport" style="min-height: 440px; height: 72vh; max-height: 75vh; overflow: hidden; user-select: none;">
                        <!-- Loading State -->
                        <div id="lightboxLoadingSpinner" class="position-absolute d-flex flex-column align-items-center justify-content-center text-white" style="z-index: 10;">
                            <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                                <span class="visually-hidden">Đang tải phim X-quang...</span>
                            </div>
                            <span class="small text-white-50 mt-2">Đang tải ảnh chuẩn nét...</span>
                        </div>

                        <!-- Error State -->
                        <div id="lightboxErrorAlert" class="p-4 text-center text-warning d-none" style="z-index: 10;">
                            <i class="bi bi-exclamation-triangle-fill fs-1 text-warning mb-2 d-block"></i>
                            <h6 class="text-white">Không thể hiển thị ảnh phóng to</h6>
                            <p class="small text-white-50 mb-0">Tệp ảnh có thể đã bị xóa hoặc phiên truy cập đã hết hạn. Vui lòng thử tải lại trang.</p>
                        </div>

                        <!-- Image Stage & Viewer Image -->
                        <div id="imagingStage" class="imaging-stage">
                            <img id="lightboxImage"
                                 src=""
                                 class="img-fluid d-none imaging-viewer-img"
                                 alt="Phóng to phim X-quang nha khoa"
                                 draggable="false" />
                        </div>
                    </div>
                    <div class="modal-footer border-secondary border-opacity-50 py-2 px-3 justify-content-between bg-dark">
                        <div class="text-start flex-grow-1 me-3">
                            <div class="small fw-semibold text-info mb-0"><i class="bi bi-journal-text me-1"></i>Kết luận đọc phim / Lời dặn:</div>
                            <div id="lightboxResultSummary" class="text-white-50 small text-wrap"></div>
                        </div>
                        <div class="d-flex gap-2 align-items-center">
                            <span class="text-white-50 small me-2 d-none d-lg-inline">
                                <i class="bi bi-mouse me-1"></i>Cuộn chuột hoặc bấm +/- để thu phóng
                            </span>
                            <a id="lightboxDownloadBtn" href="#" download class="btn btn-sm btn-outline-light">
                                <i class="bi bi-download me-1"></i> Tải ảnh
                            </a>
                            <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">
                                <i class="bi bi-x-lg me-1"></i> Đóng (Esc)
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-3 p-5 text-center text-muted">
            <i class="bi bi-journal-medical fs-1 d-block mb-2 text-secondary"></i>
            <h5>Hồ sơ bệnh án điện tử của bạn đang được khởi tạo trên hệ thống.</h5>
            <p class="small text-muted">Khi bạn đến khám tại phòng khám, các bác sĩ sẽ ghi nhận chẩn đoán và cập nhật sơ đồ răng của bạn tại đây.</p>
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/medical-imaging-viewer.js" asp-append-version="true"></script>
    <script>
        let lightboxModalInstance = null;

        function openImagingLightbox(imageUrl, imagingType, resultSummary, createdAt, isDicom) {
            if (isDicom) {
                return;
            }

            const modalEl = document.getElementById('imagingLightboxModal');
            if (!modalEl) return;

            const imgEl = document.getElementById('lightboxImage');
            const spinner = document.getElementById('lightboxLoadingSpinner');
            const errorAlert = document.getElementById('lightboxErrorAlert');
            const typeBadge = document.getElementById('lightboxTypeBadge');
            const dateEl = document.getElementById('lightboxDate');
            const summaryEl = document.getElementById('lightboxResultSummary');
            const downloadBtn = document.getElementById('lightboxDownloadBtn');

            // Reset UI states
            if (imgEl) {
                imgEl.classList.add('d-none');
                imgEl.src = '';
            }
            if (spinner) spinner.classList.remove('d-none');
            if (errorAlert) errorAlert.classList.add('d-none');

            if (typeBadge) typeBadge.textContent = imagingType || 'X-Quang';
            if (dateEl) dateEl.textContent = createdAt ? ('Ngày chụp: ' + createdAt) : '';
            if (summaryEl) summaryEl.textContent = resultSummary && resultSummary.trim().length > 0 ? resultSummary : 'Chưa có ghi nhận kết luận đọc phim.';
            if (downloadBtn) {
                downloadBtn.href = imageUrl;
            }

            // Bind image load events
            if (imgEl) {
                imgEl.onload = function () {
                    if (spinner) spinner.classList.add('d-none');
                    imgEl.classList.remove('d-none');
                    if (window.MedicalImagingViewer) {
                        window.MedicalImagingViewer.resetView();
                    }
                };
                imgEl.onerror = function () {
                    if (spinner) spinner.classList.add('d-none');
                    if (errorAlert) errorAlert.classList.remove('d-none');
                };
                imgEl.src = imageUrl;
            }

            if (!lightboxModalInstance) {
                lightboxModalInstance = new bootstrap.Modal(modalEl, {
                    keyboard: true,
                    backdrop: true
                });
            }
            if (window.MedicalImagingViewer) {
                window.MedicalImagingViewer.init();
                window.MedicalImagingViewer.resetView();
            }
            lightboxModalInstance.show();
        }

        // Clean up modal on hide
        document.addEventListener("DOMContentLoaded", function () {
            const modalEl = document.getElementById('imagingLightboxModal');
            if (modalEl) {
                modalEl.addEventListener('hidden.bs.modal', function () {
                    const imgEl = document.getElementById('lightboxImage');
                    if (imgEl) {
                        imgEl.onload = null;
                        imgEl.onerror = null;
                        imgEl.src = '';
                        imgEl.classList.add('d-none');
                    }
                });
            }
        });
    </script>
}
