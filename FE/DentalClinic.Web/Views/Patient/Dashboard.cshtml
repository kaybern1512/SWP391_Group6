@model DashboardViewModel
@{
    ViewData["Title"] = "Cổng Bệnh Nhân";
}

<div class="container-fluid p-0">
    <!-- Page Header -->
    <div class="page-header-dc">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge-dc badge-role-patient">Bệnh Nhân</span>
                @if (!string.IsNullOrEmpty(Model.Code))
                {
                    <span class="badge bg-white text-muted border small">Mã BN: @Model.Code</span>
                }
            </div>
            <h1 class="page-title">Chào mừng trở lại, @Model.FullName</h1>
            <p class="page-subtitle">@Model.Subtitle</p>
        </div>
        <div class="page-actions">
            <a asp-controller="Profile" asp-action="Index" class="btn btn-dc-outline">
                <i class="bi bi-person-circle me-1"></i> Hồ Sơ Của Tôi
            </a>
            <a asp-controller="PatientAppointment" asp-action="Book" class="btn btn-dc-primary">
                <i class="bi bi-calendar-plus me-1"></i> Đặt Lịch Khám
            </a>
        </div>
    </div>

    <!-- 4 KPI Stat Cards (No Fake Numbers) -->
    <div class="row g-3 mb-4">
        @foreach (var stat in Model.StatCards)
        {
            <div class="col-sm-6 col-xl-3">
                <div class="stat-card">
                    <div class="stat-header">
                        <span class="stat-label">@stat.Title</span>
                        <div class="stat-icon-box stat-icon-@stat.ColorClass">
                            <i class="bi @stat.Icon"></i>
                        </div>
                    </div>
                    <div>
                        <div class="stat-value">@stat.Value</div>
                        <div class="stat-note">
                            <i class="bi bi-info-circle"></i> @stat.Note
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Quick Action Cards Section -->
    <div class="mb-4">
        <h5 class="font-heading fs-6 fw-bold text-dark mb-3">Thao Tác Lâm Sàng Nhanh</h5>
        <div class="row g-3">
            @foreach (var card in Model.Cards)
            {
                <div class="col-md-6 col-lg-4 col-xl-2">
                    <div class="card-quick-action text-center h-100 p-3 d-flex flex-column justify-content-between">
                        <div>
                            <div class="quick-icon-box quick-icon-@card.ColorClass mx-auto mb-2">
                                <i class="bi @card.Icon"></i>
                            </div>
                            <h6 class="fw-bold text-dark mb-1">@card.Title</h6>
                            <p class="text-muted small mb-3">@card.Description</p>
                        </div>
                        <div>
                            <a href="@card.ActionUrl" class="btn btn-light btn-sm text-primary w-100 fw-semibold border">
                                @card.ActionText <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Two-Column Context Workspace -->
    <div class="row g-4">
        <!-- Upcoming Visits & Treatment Schedule -->
        <div class="col-lg-8">
            <div class="card-dc">
                <div class="card-dc-header">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-calendar-event text-primary"></i>
                        <span>Lịch Khám Sắp Tới & Tiến Độ Điều Trị</span>
                    </div>
                    <span class="badge-dc badge-status-neutral">Trực Tiếp</span>
                </div>
                <div class="card-dc-body p-0">
                    <partial name="_EmptyState" model="Model.EmptyState" />
                </div>
            </div>
        </div>

        <!-- Invoices & Billing Summary -->
        <div class="col-lg-4">
            <div class="card-dc mb-4">
                <div class="card-dc-header">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-receipt text-warning"></i>
                        <span>Hóa Đơn & Viện Phí</span>
                    </div>
                </div>
                <div class="card-dc-body p-4 text-center">
                    <div class="empty-state-icon-box mb-2" style="width: 48px; height: 48px; font-size: 1.25rem;">
                        <i class="bi bi-check2-circle text-success"></i>
                    </div>
                    <h6 class="fw-bold text-dark mb-1">Không Có Hóa Đơn Tồn Đọng</h6>
                    <p class="text-muted small mb-0">Tất cả các dịch vụ khám và điều trị nha khoa trước đây đều đã được hoàn tất thanh toán.</p>
                </div>
            </div>

            <!-- Clinic Contact Notice -->
            <div class="card-dc bg-light border">
                <div class="card-dc-body p-3">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <i class="bi bi-hospital text-primary"></i>
                        <span class="fw-semibold text-dark small">Phòng Khám Nha Khoa DentalCare</span>
                    </div>
                    <p class="text-muted small mb-2">Cần thay đổi lịch hẹn hoặc nhận hỗ trợ nha khoa khẩn cấp? Vui lòng liên hệ quầy tiếp đón lễ tân.</p>
                    <a href="tel:19001234" class="btn btn-dc-outline btn-sm w-100">
                        <i class="bi bi-telephone me-1"></i> Tổng Đài Hỗ Trợ: 1900 1234
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
