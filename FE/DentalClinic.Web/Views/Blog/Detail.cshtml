@model DentalClinic.Web.ViewModels.Blog.BlogDetailViewModel
@{
    var post = Model.Post;
    ViewData["Title"] = $"{post.Title} - Nha Khoa DentalCare";

    // Extract YouTube video ID for facade pattern (avoids loading heavy iframe at page load)
    string? ytId = null;
    if (!string.IsNullOrWhiteSpace(post.VideoUrl))
    {
        var vUrl = post.VideoUrl.Trim();
        if (vUrl.Contains("/embed/"))
        {
            var s = vUrl.IndexOf("/embed/") + 7;
            var e = vUrl.IndexOf('?', s);
            ytId = e > 0 ? vUrl.Substring(s, e - s) : vUrl.Substring(s);
        }
        else if (vUrl.Contains("youtu.be/"))
        {
            var s = vUrl.IndexOf("youtu.be/") + 9;
            var e = vUrl.IndexOf('?', s);
            ytId = e > 0 ? vUrl.Substring(s, e - s) : vUrl.Substring(s);
        }
        else if (vUrl.Contains("?v="))
        {
            var s = vUrl.IndexOf("?v=") + 3;
            var e = vUrl.IndexOf('&', s);
            ytId = e > 0 ? vUrl.Substring(s, e - s) : vUrl.Substring(s);
        }
    }
    bool isYouTube = !string.IsNullOrWhiteSpace(ytId);
}

<!-- Reading Progress Bar -->
<div id="blogReadingProgressWrapper" style="position:fixed;top:0;left:0;right:0;z-index:1050;height:3px;background:transparent;pointer-events:none;" aria-hidden="true">
    <div id="blogReadingProgress" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"
         style="height:100%;width:0%;background:linear-gradient(90deg,#0d6efd,#0dcaf0);transition:width 0.1s linear;"></div>
</div>

<div class="blog-detail-container pb-5">
    <!-- Breadcrumb -->
    <div class="bg-light py-2 border-bottom">
        <div class="container">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Trang Chủ</a></li>
                    <li class="breadcrumb-item"><a asp-controller="Blog" asp-action="Index" class="text-decoration-none">Blog</a></li>
                    <li class="breadcrumb-item">
                        <a asp-controller="Blog" asp-action="Index" asp-route-category="@post.CategorySlug" class="text-decoration-none">
                            @post.CategoryName
                        </a>
                    </li>
                    <li class="breadcrumb-item active text-truncate" style="max-width: 300px;" aria-current="page">@post.Title</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Article Header -->
    <header class="py-4 bg-white border-bottom">
        <div class="container" style="max-width: 900px;">
            <div class="d-flex align-items-center gap-2 mb-3">
                <a asp-controller="Blog" asp-action="Index" asp-route-category="@post.CategorySlug"
                   class="badge bg-primary text-decoration-none px-3 py-2 rounded-pill">
                    @post.CategoryName
                </a>
                @if (post.IsFeatured)
                {
                    <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold">
                        <i class="bi bi-star-fill me-1"></i>Nổi Bật
                    </span>
                }
                @if (isYouTube)
                {
                    <span class="badge bg-danger text-white px-3 py-2 rounded-pill">
                        <i class="bi bi-play-circle-fill me-1"></i>Có Video 3D
                    </span>
                }
            </div>

            <h1 class="display-6 fw-bold text-dark mb-3 lh-sm">
                @post.Title
            </h1>

            @if (!string.IsNullOrWhiteSpace(post.Summary))
            {
                <p class="lead text-muted fs-6 mb-4 lh-base">
                    @post.Summary
                </p>
            }

            <!-- Author & Metadata Row -->
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 pt-3 border-top">
                <div class="d-flex align-items-center gap-3">
                    @if (!string.IsNullOrWhiteSpace(post.AuthorAvatarUrl))
                    {
                        <img src="@post.AuthorAvatarUrl"
                             alt="@post.AuthorName"
                             class="rounded-circle border"
                             style="width: 44px; height: 44px; object-fit: cover;"
                             loading="lazy"
                             decoding="async"
                             onerror="this.src='/images/doctors/dr-phuong-thao.svg'" />
                    }
                    else
                    {
                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                            <i class="bi bi-person-fill fs-5"></i>
                        </div>
                    }
                    <div>
                        <div class="fw-bold text-dark">@post.AuthorName</div>
                        <div class="text-muted small"><i class="bi bi-mortarboard-fill text-primary me-1"></i>Tiến sĩ Y khoa (PhD) - Trưởng khoa Nội nha &amp; Phục hình</div>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-3 text-muted small">
                    <span title="Ngày xuất bản"><i class="bi bi-calendar3 me-1"></i>@((post.PublishedAt ?? post.CreatedAt).ToString("dd/MM/yyyy"))</span>
                    <span title="Lượt xem"><i class="bi bi-eye me-1"></i>@post.ViewCount lượt xem</span>
                    <span title="Thời gian đọc"><i class="bi bi-clock me-1"></i>~@(Math.Max(1, (post.Content?.Split(' ')?.Length ?? 250) / 250)) phút đọc</span>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content Area -->
    <div class="container py-4" style="max-width: 900px;">

        <!-- Featured Media: YouTube Facade (lazy) or local video or thumbnail -->
        @if (isYouTube)
        {
            <div class="blog-featured-video mb-4">
                <!-- YouTube Facade: renders thumbnail + play button, loads iframe only on click -->
                <div class="yt-facade ratio ratio-16x9 rounded-4 overflow-hidden shadow-sm border"
                     data-yt-facade
                     data-yt-id="@ytId"
                     data-yt-title="@post.Title">
                    <!-- JS in blog-lazy.js will render thumbnail + play button here -->
                </div>
                <p class="text-muted small text-center mt-2 mb-0">
                    <i class="bi bi-play-circle text-danger me-1"></i>
                    Video mô phỏng 3D — Bấm để phát · Nguồn: YouTube (No-Cookie Embed)
                </p>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(post.VideoUrl))
        {
            <div class="blog-featured-video mb-4">
                <video controls preload="metadata"
                       poster="@post.ThumbnailUrl"
                       class="w-100 rounded-4 shadow-sm"
                       style="max-height: 480px; object-fit: contain; background: #000;">
                    <source src="@post.VideoUrl" />
                    Trình duyệt của bạn không hỗ trợ phát thẻ video.
                </video>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(post.ThumbnailUrl))
        {
            <div class="blog-article-thumb-hero mb-4">
                <img src="@post.ThumbnailUrl"
                     alt="@post.Title"
                     class="img-fluid w-100 rounded-4 shadow-sm blog-zoomable-img"
                     loading="lazy"
                     decoding="async"
                     onerror="this.src='/images/blog/viem-tuy-rang-banner.svg'" />
            </div>
        }

        <!-- Social Share Bar Top -->
        <div class="d-flex align-items-center justify-content-between p-3 bg-light rounded-3 mb-4">
            <span class="small fw-semibold text-muted">
                <i class="bi bi-share me-1"></i>Chia sẻ bài viết này:
            </span>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill d-flex align-items-center gap-1" id="copyShareBtn">
                    <i class="bi bi-link-45deg"></i> Sao chép liên kết
                </button>
                <a href="https://www.facebook.com/sharer/sharer.php?u=@Uri.EscapeDataString(Context.Request.Scheme + "://" + Context.Request.Host + Context.Request.Path)"
                   target="_blank" rel="noopener noreferrer" class="share-btn share-btn-facebook" title="Chia sẻ Facebook">
                    <i class="bi bi-facebook"></i>
                </a>
                <a href="https://twitter.com/intent/tweet?url=@Uri.EscapeDataString(Context.Request.Scheme + "://" + Context.Request.Host + Context.Request.Path)&text=@Uri.EscapeDataString(post.Title)"
                   target="_blank" rel="noopener noreferrer" class="share-btn share-btn-twitter" title="Chia sẻ Twitter">
                    <i class="bi bi-twitter-x"></i>
                </a>
            </div>
        </div>

        <!-- Article HTML Content (Sanitized) -->
        <article class="blog-article-content bg-white p-4 p-md-5 rounded-4 shadow-sm border mb-4">
            @Html.Raw(post.Content)
        </article>

        <!-- Doctor PhD Profile Box & Booking CTA -->
        <div class="doctor-phd-card mb-5">
            <div class="row align-items-center g-4">
                <div class="col-auto text-center">
                    <img src="@(!string.IsNullOrWhiteSpace(post.AuthorAvatarUrl) ? post.AuthorAvatarUrl : "/images/doctors/dr-phuong-thao.svg")"
                         alt="@post.AuthorName"
                         class="doctor-phd-avatar"
                         loading="lazy"
                         decoding="async"
                         onerror="this.src='/images/doctors/dr-phuong-thao.svg'" />
                    <div class="mt-2">
                        <span class="badge bg-primary text-white rounded-pill px-2.5 py-1 small">
                            <i class="bi bi-patch-check-fill me-1"></i>Tiến Sĩ Y Khoa
                        </span>
                    </div>
                </div>
                <div class="col">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="badge bg-info-subtle text-info-emphasis rounded-pill px-2 fw-semibold small">Bác Sĩ Cố Vấn Chuyên Môn</span>
                        <span class="text-muted small"><i class="bi bi-award-fill text-warning me-1"></i>15 năm kinh nghiệm</span>
                    </div>
                    <h4 class="fw-bold text-dark mb-1">@post.AuthorName</h4>
                    <p class="text-primary fw-medium small mb-2">
                        <i class="bi bi-mortarboard-fill me-1"></i>Tiến sĩ Y khoa (PhD) - Đại học Y Dược | Trưởng khoa Nội nha &amp; Phục hình DentalCare
                    </p>
                    <p class="text-muted small mb-0 lh-sm">
                        Chuyên gia đầu ngành về điều trị tủy vi phẫu, cấy ghép Implant kỹ thuật số và phục hình răng sứ thẩm mỹ. Từng tu nghiệp chuyên sâu tại Đại học Bordeaux (Pháp).
                    </p>
                </div>
                <div class="col-md-auto text-md-end">
                    <a href="/Patient/Appointment/Book" class="btn btn-primary rounded-pill px-4 py-2.5 fw-semibold shadow-sm">
                        <i class="bi bi-calendar2-plus me-1"></i> Đặt Lịch Khám Với TS. BS.
                    </a>
                </div>
            </div>
        </div>

        <!-- Related Posts Section -->
        @if (post.RelatedPosts != null && post.RelatedPosts.Count > 0)
        {
            <div class="related-posts-section mt-5 pt-4 border-top">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h3 class="fw-bold text-dark mb-0 fs-5">
                        <i class="bi bi-journal-text text-primary me-2"></i>Bài Viết Liên Quan Cùng Chuyên Mục
                    </h3>
                    <a asp-controller="Blog" asp-action="Index" asp-route-category="@post.CategorySlug"
                       class="text-decoration-none small text-primary fw-semibold">
                        Xem thêm <i class="bi bi-arrow-right"></i>
                    </a>
                </div>

                <div class="row g-3">
                    @foreach (var rel in post.RelatedPosts)
                    {
                        <div class="col-md-6">
                            <div class="card h-100 border rounded-3 p-3 shadow-sm hover-shadow transition">
                                <div class="d-flex gap-3">
                                    <div style="width: 100px; height: 75px; flex-shrink: 0; border-radius: 8px; overflow: hidden;">
                                        <img src="@(!string.IsNullOrWhiteSpace(rel.ThumbnailUrl) ? rel.ThumbnailUrl : "/images/blog/viem-tuy-rang-banner.svg")"
                                             alt="@rel.Title"
                                             loading="lazy"
                                             decoding="async"
                                             style="width: 100%; height: 100%; object-fit: cover;" />
                                    </div>
                                    <div class="d-flex flex-column justify-content-between flex-grow-1 overflow-hidden">
                                        <h6 class="mb-1 fw-bold lh-sm">
                                            <a asp-controller="Blog" asp-action="Detail" asp-route-slug="@rel.Slug"
                                               class="text-dark text-decoration-none text-truncate-2">
                                                @rel.Title
                                            </a>
                                        </h6>
                                        <div class="d-flex justify-content-between align-items-center text-muted small" style="font-size: 0.75rem;">
                                            <span><i class="bi bi-clock me-1"></i>@((rel.PublishedAt ?? rel.CreatedAt).ToString("dd/MM/yyyy"))</span>
                                            <span><i class="bi bi-eye me-1"></i>@rel.ViewCount</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

<!-- Image Lightbox Modal -->
<div class="modal fade" id="blogImageLightboxModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content bg-transparent border-0 text-center position-relative">
            <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-3 z-3"
                    data-bs-dismiss="modal" aria-label="Close"></button>
            <img src="" id="blogLightboxModalImg"
                 class="img-fluid rounded-4 shadow-lg mx-auto"
                 style="max-height: 85vh; object-fit: contain; background: #000;" />
        </div>
    </div>
</div>

@section Scripts {
    <!-- blog-lazy.js handles: YouTube facade, lazy images, lightbox, reading progress, smooth scroll -->
    <script src="~/js/blog-lazy.js" defer></script>
    <script>
        // Copy Share URL
        document.getElementById('copyShareBtn')?.addEventListener('click', function () {
            navigator.clipboard.writeText(window.location.href).then(function () {
                var btn = document.getElementById('copyShareBtn');
                var orig = btn.innerHTML;
                btn.innerHTML = '<i class="bi bi-check-lg text-success"></i> Đã sao chép!';
                setTimeout(function () { btn.innerHTML = orig; }, 2500);
            }).catch(function () { alert('Không thể sao chép liên kết.'); });
        });
    </script>
}
