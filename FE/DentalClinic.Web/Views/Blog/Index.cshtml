@model DentalClinic.Web.ViewModels.Blog.BlogIndexViewModel
@{
    ViewData["Title"] = "Kiến Thức Nha Khoa - Cẩm Nang Sức Khỏe Răng Miệng";
    var items = Model.PagedResult.Items;
    var totalPages = Model.PagedResult.TotalPages;
    var currentPage = Model.CurrentPage;
}

<div class="blog-index-container pb-5">
    <!-- Hero Banner -->
    <section class="blog-periopixel-section border-bottom mb-4">
        <div class="container py-2 text-center">
            <span class="badge-dc badge-role-patient mb-2">
                <i class="bi bi-journal-medical me-1"></i> Kiến Thức Chuyên Môn Chuẩn Y Khoa
            </span>
            <h1 class="display-6 fw-bold text-dark mb-2">Cẩm Nang Sức Khỏe & Thẩm Mỹ Nha Khoa</h1>
            <p class="lead text-muted fs-6 mx-auto mb-4" style="max-width: 680px;">
                Tổng hợp bài viết, kiến thức điều trị và lời khuyên chăm sóc răng miệng từ đội ngũ bác sĩ chuyên khoa DentalCare.
            </p>

            <!-- Search Bar -->
            <form method="get" asp-controller="Blog" asp-action="Index" class="mx-auto" style="max-width: 540px;">
                @if (!string.IsNullOrWhiteSpace(Model.CurrentCategorySlug))
                {
                    <input type="hidden" name="category" value="@Model.CurrentCategorySlug" />
                }
                <div class="input-group input-group-lg shadow-sm rounded-pill overflow-hidden border">
                    <span class="input-group-text bg-white border-0 ps-3">
                        <i class="bi bi-search text-muted"></i>
                    </span>
                    <input type="text"
                           name="keyword"
                           value="@Model.CurrentKeyword"
                           class="form-control border-0 fs-6 shadow-none"
                           placeholder="Tìm kiếm bài viết (VD: niềng răng, sâu răng, implant...)" />
                    @if (!string.IsNullOrWhiteSpace(Model.CurrentKeyword))
                    {
                        <a asp-controller="Blog" asp-action="Index" asp-route-category="@Model.CurrentCategorySlug" class="btn btn-white border-0 text-muted d-flex align-items-center" title="Xóa tìm kiếm">
                            <i class="bi bi-x-circle"></i>
                        </a>
                    }
                    <button class="btn btn-primary px-4 fw-semibold border-0" type="submit">
                        Tìm Kiếm
                    </button>
                </div>
            </form>
        </div>
    </section>

    <div class="container">
        <!-- Doctor PhD Advisory Board Banner -->
        <div class="doctor-phd-card mb-4">
            <div class="row align-items-center g-3">
                <div class="col-auto text-center">
                    <img src="/images/doctors/dr-phuong-thao.svg" alt="TS. BS. Nguyễn Thị Phương Thảo" class="doctor-phd-avatar" loading="lazy" decoding="async" onerror="this.src='/images/doctors/dr-phuong-thao.svg'" />
                </div>
                <div class="col">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="badge bg-primary text-white rounded-pill px-2.5 py-1 small">
                            <i class="bi bi-patch-check-fill me-1"></i>Hội Đồng Cố Vấn Chuyên Môn
                        </span>
                        <span class="text-muted small"><i class="bi bi-award-fill text-warning me-1"></i>Tiến Sĩ Y Khoa (PhD)</span>
                    </div>
                    <h4 class="fw-bold text-dark mb-1">TS. BS. Nguyễn Thị Phương Thảo &amp; Ban Chuyên Gia Nha Khoa</h4>
                    <p class="text-muted small mb-0">
                        100% bài viết kiến thức y khoa được trực tiếp biên soạn, kiểm duyệt và cập nhật bởi Tiến sĩ Y khoa, Trưởng khoa và các bác sĩ chuyên khoa cấp I tại DentalCare.
                    </p>
                </div>
                <div class="col-md-auto text-md-end">
                    <a href="/Patient/Appointment/Book" class="btn btn-outline-primary rounded-pill px-3 py-2 fw-semibold">
                        <i class="bi bi-calendar2-check me-1"></i> Đặt Hẹn Tư Vấn
                    </a>
                </div>
            </div>
        </div>

        <!-- Periopixel 3D Dental Education Showcase -->
        @if (string.IsNullOrWhiteSpace(Model.CurrentKeyword) && string.IsNullOrWhiteSpace(Model.CurrentCategorySlug) && Model.CurrentPage <= 1)
        {
            <div class="row g-4 mb-4">
                <div class="col-md-6">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden position-relative" style="background: linear-gradient(135deg, #f0fdf4 0%, #ffffff 100%); border-left: 4px solid #16a34a !important;">
                        <div class="p-4 d-flex flex-column justify-content-between h-100">
                            <div>
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <span class="badge bg-success text-white rounded-pill px-2.5 py-1 small">
                                        <i class="bi bi-play-circle-fill me-1"></i>3D Dental Education
                                    </span>
                                    <span class="text-muted small">Mô Phỏng Trực Quan</span>
                                </div>
                                <h4 class="fw-bold text-dark mb-2">Video Mô Phỏng 3D Điều Trị Viêm Tủy Răng &amp; Implant</h4>
                                <p class="text-muted small mb-3">
                                    Quan sát chi tiết cấu trúc giải phẫu buồng tủy, quá trình vi khuẩn xâm lấn và quy trình điều trị tủy vi phẫu đạt chuẩn y khoa quốc tế.
                                </p>
                            </div>
                            <div class="text-center my-2 p-2 bg-white rounded-3 border">
                                <img src="/images/blog/periopixel-dental-arch.png" alt="Mô phỏng 3D cung răng và nướu" class="img-fluid rounded-3 blog-zoomable-img" loading="lazy" decoding="async" style="max-height: 180px; object-fit: contain;" />
                            </div>
                            <div class="pt-3 border-top mt-3 d-flex justify-content-between align-items-center">
                                <a asp-controller="Blog" asp-action="Detail" asp-route-slug="dieu-tri-viem-tuy-rang-nhu-the-nao" class="btn btn-sm btn-outline-success rounded-pill px-3 fw-semibold">
                                    Xem Bài Viết &amp; Video <i class="bi bi-arrow-right ms-1"></i>
                                </a>
                                <span class="text-muted small"><i class="bi bi-check-circle-fill text-success me-1"></i>Nguồn: Periopixel 3D</span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden position-relative" style="background: linear-gradient(135deg, #eff6ff 0%, #ffffff 100%); border-left: 4px solid #2563eb !important;">
                        <div class="p-4 d-flex flex-column justify-content-between h-100">
                            <div>
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <span class="badge bg-primary text-white rounded-pill px-2.5 py-1 small">
                                        <i class="bi bi-camera-reels-fill me-1"></i>Bespoke 3D Patient Guide
                                    </span>
                                    <span class="text-muted small">Cẩm Nang Sức Khỏe</span>
                                </div>
                                <h4 class="fw-bold text-dark mb-2">Video 3D Kỹ Thuật Chải Răng Bass Cải Tiến &amp; Bảo Vệ Nướu</h4>
                                <p class="text-muted small mb-3">
                                    Hướng dẫn góc đặt lông bàn chải 45 độ, vệ sinh mảng bám viền nướu và sử dụng chỉ nha khoa bảo tồn men răng không mòn.
                                </p>
                            </div>
                            <div class="text-center my-2 p-2 bg-white rounded-3 border">
                                <img src="/images/blog/cham-soc-rang-mieng-3d.png" alt="Mô phỏng 3D kỹ thuật chải răng" class="img-fluid rounded-3 blog-zoomable-img" loading="lazy" decoding="async" style="max-height: 180px; object-fit: contain;" />
                            </div>
                            <div class="pt-3 border-top mt-3 d-flex justify-content-between align-items-center">
                                <a asp-controller="Blog" asp-action="Detail" asp-route-slug="huong-dan-cham-soc-rang-mieng-dung-cach-6-thoi-quen" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-semibold">
                                    Xem Hướng Dẫn 3D <i class="bi bi-arrow-right ms-1"></i>
                                </a>
                                <span class="text-muted small"><i class="bi bi-check-circle-fill text-primary me-1"></i>Nguồn: Periopixel 3D</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Category Filter Pills -->
        <div class="d-flex flex-wrap align-items-center gap-2 mb-4 pb-2 border-bottom">
            <span class="text-muted small fw-semibold me-2 d-none d-md-inline">
                <i class="bi bi-funnel me-1"></i>Chuyên mục:
            </span>
            <a asp-controller="Blog" asp-action="Index" asp-route-keyword="@Model.CurrentKeyword"
               class="blog-cat-pill @(string.IsNullOrWhiteSpace(Model.CurrentCategorySlug) ? "active" : "")">
                Tất Cả
            </a>
            @foreach (var cat in Model.Categories)
            {
                <a asp-controller="Blog" asp-action="Index"
                   asp-route-category="@cat.Slug"
                   asp-route-keyword="@Model.CurrentKeyword"
                   class="blog-cat-pill @(string.Equals(Model.CurrentCategorySlug, cat.Slug, StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                    <span>@cat.Name</span>
                    @if (cat.PostCount > 0)
                    {
                        <span class="badge rounded-pill">@cat.PostCount</span>
                    }
                </a>
            }
        </div>

        <!-- Search / Category Summary Info -->
        @if (!string.IsNullOrWhiteSpace(Model.CurrentCategorySlug) || !string.IsNullOrWhiteSpace(Model.CurrentKeyword))
        {
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="small text-muted">
                    Tìm thấy <strong class="text-dark">@Model.PagedResult.TotalCount</strong> bài viết
                    @if (!string.IsNullOrWhiteSpace(Model.CurrentCategorySlug))
                    {
                        var activeCat = Model.Categories.FirstOrDefault(c => string.Equals(c.Slug, Model.CurrentCategorySlug, StringComparison.OrdinalIgnoreCase));
                        <span>trong chuyên mục <strong>@(activeCat?.Name ?? Model.CurrentCategorySlug)</strong></span>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.CurrentKeyword))
                    {
                        <span>với từ khóa <em>"@Model.CurrentKeyword"</em></span>
                    }
                </div>
                <a asp-controller="Blog" asp-action="Index" class="btn btn-link btn-sm text-decoration-none text-muted p-0">
                    <i class="bi bi-arrow-counterclockwise me-1"></i>Xem tất cả bài viết
                </a>
            </div>
        }

        <!-- Post Cards Grid -->
        @if (items != null && items.Count > 0)
        {
            <div class="row g-4">
                @foreach (var post in items)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="blog-card">
                            <div class="blog-card-thumb-wrapper">
                                <a asp-controller="Blog" asp-action="Detail" asp-route-slug="@post.Slug">
                                    <img src="@(!string.IsNullOrWhiteSpace(post.ThumbnailUrl) ? post.ThumbnailUrl : "/images/blog/viem-tuy-rang-banner.svg")"
                                         onerror="this.src='/images/blog/viem-tuy-rang-banner.svg'"
                                         alt="@post.Title"
                                         class="blog-card-thumb"
                                         loading="lazy" decoding="async" />
                                </a>
                                <a asp-controller="Blog" asp-action="Index" asp-route-category="@post.CategorySlug" class="blog-badge-category">
                                    @post.CategoryName
                                </a>
                                @if (post.IsFeatured)
                                {
                                    <span class="blog-badge-featured">
                                        <i class="bi bi-star-fill me-1"></i>Nổi bật
                                    </span>
                                }
                            </div>
                            <div class="blog-card-body">
                                <h2 class="blog-card-title">
                                    <a asp-controller="Blog" asp-action="Detail" asp-route-slug="@post.Slug">
                                        @post.Title
                                    </a>
                                </h2>
                                <p class="blog-card-summary">
                                    @(!string.IsNullOrWhiteSpace(post.Summary) ? post.Summary : "Đọc bài viết chi tiết để hiểu rõ hơn về các phương pháp chăm sóc và điều trị nha khoa hiện đại...")
                                </p>
                                <div class="blog-card-footer">
                                    <div class="blog-card-author">
                                        @if (!string.IsNullOrWhiteSpace(post.AuthorAvatarUrl))
                                        {
                                            <img src="@(!string.IsNullOrWhiteSpace(post.AuthorAvatarUrl) ? post.AuthorAvatarUrl : "/images/doctors/dr-phuong-thao.svg")" alt="@post.AuthorName" loading="lazy" decoding="async" onerror="this.src='/images/doctors/dr-phuong-thao.svg'" />
                                        }
                                        else
                                        {
                                            <i class="bi bi-person-circle fs-6 text-primary"></i>
                                        }
                                        <span class="fw-semibold text-dark text-truncate" style="max-width: 140px;" title="@post.AuthorName">
                                            @post.AuthorName
                                        </span>
                                    </div>
                                    <div class="d-flex align-items-center gap-2">
                                        <span title="Ngày đăng"><i class="bi bi-clock me-1"></i>@((post.PublishedAt ?? post.CreatedAt).ToString("dd/MM/yyyy"))</span>
                                        <span title="Lượt xem"><i class="bi bi-eye me-1"></i>@post.ViewCount</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Pagination -->
            @if (totalPages > 1)
            {
                <nav class="mt-5" aria-label="Blog navigation">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                            <a class="page-link rounded-start-pill"
                               asp-controller="Blog"
                               asp-action="Index"
                               asp-route-category="@Model.CurrentCategorySlug"
                               asp-route-keyword="@Model.CurrentKeyword"
                               asp-route-page="@(currentPage - 1)">
                                <i class="bi bi-chevron-left me-1"></i>Trước
                            </a>
                        </li>
                        @for (int p = 1; p <= totalPages; p++)
                        {
                            <li class="page-item @(p == currentPage ? "active" : "")">
                                <a class="page-link"
                                   asp-controller="Blog"
                                   asp-action="Index"
                                   asp-route-category="@Model.CurrentCategorySlug"
                                   asp-route-keyword="@Model.CurrentKeyword"
                                   asp-route-page="@p">
                                    @p
                                </a>
                            </li>
                        }
                        <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                            <a class="page-link rounded-end-pill"
                               asp-controller="Blog"
                               asp-action="Index"
                               asp-route-category="@Model.CurrentCategorySlug"
                               asp-route-keyword="@Model.CurrentKeyword"
                               asp-route-page="@(currentPage + 1)">
                                Sau<i class="bi bi-chevron-right ms-1"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            }
        }
        else
        {
            <div class="bg-white rounded-4 p-5 text-center border my-4">
                <div class="mb-3 text-muted">
                    <i class="bi bi-journal-x display-4"></i>
                </div>
                <h4 class="fw-bold text-dark mb-2">Không tìm thấy bài viết phù hợp</h4>
                <p class="text-muted small mb-4" style="max-width: 480px; margin: 0 auto;">
                    Không có bài viết nào khớp với từ khóa tìm kiếm hoặc chuyên mục đã chọn. Vui lòng thử lại với từ khóa khác.
                </p>
                <a asp-controller="Blog" asp-action="Index" class="btn btn-outline-primary rounded-pill px-4">
                    <i class="bi bi-arrow-left me-1"></i> Xem Tất Cả Bài Viết
                </a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/blog-lazy.js" defer></script>
    <script>
        // Apply loaded class to images when they finish loading (for fade-in CSS)
        document.querySelectorAll('img[loading="lazy"]').forEach(function (img) {
            if (img.complete) {
                img.classList.add('loaded');
            } else {
                img.addEventListener('load', function () { this.classList.add('loaded'); });
            }
        });
    </script>
}
