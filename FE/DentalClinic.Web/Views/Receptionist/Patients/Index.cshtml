@model DentalClinic.Web.ViewModels.Receptionist.ReceptionistPatientListViewModel
@{
    ViewData["Title"] = "Hồ Sơ Bệnh Nhân";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-4 py-4">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary-subtle text-primary fw-medium px-2 py-1 fs-12">
                    <i class="bi bi-person-lines-fill me-1"></i> Sổ Quản Lý Bệnh Nhân
                </span>
                <span class="badge bg-light text-muted fw-normal px-2 py-1 fs-12">Hồ Sơ Điện Tử (EMR)</span>
            </div>
            <h1 class="h3 fw-bold text-slate-800 mb-0">Hồ Sơ Bệnh Nhân</h1>
            <p class="text-muted small mb-0 mt-1">Tra cứu danh bạ hồ sơ bệnh nhân và tiếp nhận khách hàng mới trực tiếp tại quầy</p>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-primary d-flex align-items-center gap-2 shadow-sm" data-bs-toggle="modal" data-bs-target="#modalRegisterWalkIn">
                <i class="bi bi-person-plus-fill"></i>
                <span>Tiếp Nhận Bệnh Nhân Mới</span>
            </button>
        </div>
    </div>


    <!-- Search Bar -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-md-9 col-lg-10">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" name="search" value="@Model.Search" class="form-control bg-light border-start-0" 
                               placeholder="Tìm kiếm theo Mã bệnh nhân, Họ tên, Số điện thoại hoặc Email...">
                    </div>
                </div>
                <div class="col-md-3 col-lg-2 d-flex gap-2">
                    <button type="submit" class="btn btn-dark w-100 d-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-funnel"></i>
                        <span>Tìm Kiếm</span>
                    </button>
                    @if (!string.IsNullOrEmpty(Model.Search))
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary" title="Xóa bộ lọc">
                            <i class="bi bi-x-lg"></i>
                        </a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Patients Table -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
            <h5 class="card-title fw-bold text-slate-800 mb-0 d-flex align-items-center gap-2">
                <i class="bi bi-people text-primary"></i>
                <span>Danh Sách Bệnh Nhân</span>
                <span class="badge bg-secondary-subtle text-secondary rounded-pill fs-12 ms-1">@Model.Patients.Count hồ sơ</span>
            </h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-muted fs-13 text-uppercase">
                    <tr>
                        <th class="ps-4">Mã Bệnh Nhân</th>
                        <th>Họ Và Tên</th>
                        <th>Số Điện Thoại</th>
                        <th>Email</th>
                        <th>Trạng Thái</th>
                        <th>Ngày Tiếp Nhận</th>
                    </tr>
                </thead>
                <tbody class="fs-14">
                    @if (Model.Patients.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <div class="mb-2"><i class="bi bi-inbox fs-1 text-secondary opacity-50"></i></div>
                                <div>Không tìm thấy bệnh nhân nào phù hợp với từ khóa tìm kiếm.</div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var patient in Model.Patients)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="badge bg-light text-primary border font-monospace fw-bold px-2 py-1">
                                        @(patient.Code ?? $"BN-{patient.UserId}")
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="avatar-sm bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 36px; height: 36px;">
                                            @(patient.FullName.Length > 0 ? patient.FullName[0].ToString().ToUpper() : "P")
                                        </div>
                                        <div>
                                            <div class="fw-bold text-slate-800">@patient.FullName</div>
                                            <small class="text-muted">ID: #@patient.UserId</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(patient.PhoneNumber))
                                    {
                                        <span class="text-slate-700"><i class="bi bi-telephone text-muted me-1"></i>@patient.PhoneNumber</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic">Chưa cập nhật</span>
                                    }
                                </td>
                                <td>
                                    <span class="text-slate-600">@patient.Email</span>
                                </td>
                                <td>
                                    @if (patient.Status == "Active")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                            <i class="bi bi-check-circle me-1"></i>Hoạt động
                                        </span>
                                    }
                                    else if (patient.Status == "Locked")
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                            <i class="bi bi-lock me-1"></i>Đã khóa
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1">
                                            <i class="bi bi-hourglass-split me-1"></i>@patient.Status
                                        </span>
                                    }
                                </td>
                                <td>
                                    <span class="text-muted">@patient.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal: Tiếp Nhận Bệnh Nhân Mới (Walk-in) -->
<div class="modal fade" id="modalRegisterWalkIn" tabindex="-1" aria-labelledby="modalRegisterWalkInLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold" id="modalRegisterWalkInLabel">
                    <i class="bi bi-person-plus-fill me-2"></i>Tiếp Nhận Bệnh Nhân Mới Tại Quầy
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="RegisterWalkIn" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="alert alert-info py-2 px-3 fs-13 mb-3 d-flex align-items-center gap-2">
                        <i class="bi bi-info-circle-fill fs-5"></i>
                        <div>Đăng ký nhanh hồ sơ cho bệnh nhân đến khám trực tiếp. Mật khẩu mặc định là <code>Password123@@</code>.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-slate-700">Họ và tên bệnh nhân <span class="text-danger">*</span></label>
                        <input type="text" asp-for="NewPatient.FullName" class="form-control" placeholder="Ví dụ: Nguyễn Văn An" required />
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-slate-700">Số điện thoại <span class="text-danger">*</span></label>
                            <input type="tel" asp-for="NewPatient.PhoneNumber" class="form-control" placeholder="0901234567" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-slate-700">Giới tính</label>
                            <select asp-for="NewPatient.Gender" class="form-select">
                                <option value="Nam">Nam</option>
                                <option value="Nữ">Nữ</option>
                                <option value="Khác">Khác</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-slate-700">Địa chỉ Email <span class="text-danger">*</span></label>
                        <input type="email" asp-for="NewPatient.Email" class="form-control" placeholder="patient@example.com" required />
                        <small class="text-muted fs-12">Dùng để gửi thông báo lịch hẹn và hóa đơn điều trị.</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-slate-700">Ngày sinh</label>
                        <input type="date" asp-for="NewPatient.DateOfBirth" class="form-control" />
                    </div>
                </div>
                <div class="modal-footer bg-light border-0 py-3">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-primary px-4 fw-medium">
                        <i class="bi bi-check-lg me-1"></i>Lưu Hồ Sơ
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
