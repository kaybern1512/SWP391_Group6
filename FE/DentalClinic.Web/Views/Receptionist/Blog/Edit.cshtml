@model DentalClinic.Web.ViewModels.Blog.DentistBlogEditViewModel
@{
    var isEdit = Model.BlogPostId.HasValue && Model.BlogPostId.Value > 0;
    ViewData["Title"] = isEdit ? "Chỉnh Sửa Bài Viết - Lễ Tân" : "Viết Bài Mới - Lễ Tân";
}

@section Styles {
    <!-- Quill Rich Text Editor CDN CSS -->
    <link href="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.snow.css" rel="stylesheet" />
    <style>
        .ql-editor {
            min-height: 350px;
            font-size: 1.05rem;
            line-height: 1.7;
        }
        .thumbnail-preview-box {
            width: 100%;
            height: 200px;
            border: 2px dashed #cbd5e1;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #f8fafc;
            overflow: hidden;
            position: relative;
        }
        .thumbnail-preview-box img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
    </style>
}

<div class="container-fluid py-3" style="max-width: 1000px;">
    <!-- Breadcrumb & Header -->
    <div class="mb-4">
        <a asp-controller="ReceptionistBlog" asp-action="Index" class="btn btn-link text-decoration-none p-0 text-muted small mb-2">
            <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách bài viết
        </a>
        <h3 class="fw-bold text-dark mb-1">
            <i class="bi bi-pencil-square text-primary me-2"></i>@(isEdit ? "Chỉnh Sửa Bài Viết" : "Soạn Thảo Bài Viết Mới")
        </h3>
        <p class="text-muted small mb-0">Biên soạn tin tức, cẩm nang chăm sóc răng miệng và gửi Ban Quản Trị phê duyệt xuất bản.</p>
    </div>

    @if (!string.IsNullOrEmpty(Model.RejectionReason))
    {
        <div class="alert alert-danger border-0 shadow-sm rounded-4 mb-4 p-3" role="alert">
            <div class="d-flex align-items-center gap-2 mb-1">
                <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
                <h6 class="fw-bold mb-0 text-danger">Bài viết cần điều chỉnh (Ban Quản Trị đã từ chối bản trước)</h6>
            </div>
            <p class="mb-1 text-dark"><strong>Lý do từ chối:</strong> @Model.RejectionReason</p>
            <div class="small text-muted">Vui lòng cập nhật lại nội dung theo yêu cầu trên, sau đó nhấn <strong>Gửi Ban Quản Trị Duyệt</strong> để nộp lại.</div>
        </div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <strong>Vui lòng kiểm tra lại thông tin:</strong>
            <div asp-validation-summary="All" class="small mt-1 text-danger"></div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <form method="post"
          asp-controller="ReceptionistBlog"
          asp-action="@(isEdit ? "Edit" : "Create")"
          asp-route-id="@(isEdit ? Model.BlogPostId : null)"
          enctype="multipart/form-data"
          id="blogPostForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="BlogPostId" />
        <input type="hidden" asp-for="ThumbnailUrl" id="thumbnailUrlInput" />
        <input type="hidden" asp-for="Status" id="postStatusInput" />

        <div class="row g-4">
            <!-- Left / Main Column: Content -->
            <div class="col-lg-8">
                <!-- Title Card -->
                <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold text-dark">Tiêu Đề Bài Viết <span class="text-danger">*</span></label>
                        <input asp-for="Title" class="form-control form-control-lg rounded-3" placeholder="Nhập tiêu đề rõ ràng, thu hút..." maxlength="250" required />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-0">
                        <label asp-for="Summary" class="form-label fw-semibold text-dark">Tóm Tắt Ngắn (Mô tả hiển thị trên trang chủ) <span class="text-danger">*</span></label>
                        <textarea asp-for="Summary" class="form-control rounded-3" rows="3" placeholder="Tóm tắt ngắn gọn nội dung bài viết trong 2 - 3 câu..." maxlength="500" required></textarea>
                        <span asp-validation-for="Summary" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Rich Text Editor Card -->
                <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                    <label class="form-label fw-semibold text-dark mb-2">Nội Dung Chi Tiết <span class="text-danger">*</span></label>
                    <div id="quillEditorContainer" class="rounded-3">@Html.Raw(Model.Content)</div>
                    <textarea asp-for="Content" id="hiddenContent" style="display:none;"></textarea>
                    <span asp-validation-for="Content" class="text-danger small"></span>
                </div>

                <!-- 3D Video Link Card -->
                <div class="card border-0 shadow-sm rounded-4 p-4">
                    <h6 class="fw-bold text-dark mb-2">
                        <i class="bi bi-youtube text-danger me-2"></i>Video Clip Mô Phỏng (YouTube Embed - Tùy chọn)
                    </h6>
                    <p class="text-muted small mb-3">Dán liên kết video YouTube hướng dẫn chăm sóc hoặc thủ thuật để bài viết thêm sinh động.</p>
                    <input asp-for="VideoUrl" class="form-control rounded-3" placeholder="Ví dụ: https://www.youtube.com/watch?v=VR8IQ9QFdWw" />
                    <span asp-validation-for="VideoUrl" class="text-danger small"></span>
                </div>
            </div>

            <!-- Right Column: Settings, Category, Thumbnail & Actions -->
            <div class="col-lg-4">
                <!-- Category Card -->
                <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                    <h6 class="fw-bold text-dark mb-3">
                        <i class="bi bi-tag text-primary me-2"></i>Chuyên Mục <span class="text-danger">*</span>
                    </h6>
                    <select asp-for="CategoryId" class="form-select rounded-3 mb-2" required>
                        <option value="">-- Chọn chuyên mục --</option>
                        @if (Model.Categories != null)
                        {
                            foreach (var cat in Model.Categories)
                            {
                                <option value="@cat.CategoryId" selected="@(Model.CategoryId == cat.CategoryId)">@cat.Name</option>
                            }
                        }
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger small"></span>
                </div>

                <!-- Thumbnail Card -->
                <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                    <h6 class="fw-bold text-dark mb-3">
                        <i class="bi bi-image text-primary me-2"></i>Ảnh Bìa Đại Diện
                    </h6>
                    <div class="thumbnail-preview-box mb-3" id="thumbnailBox">
                        @if (!string.IsNullOrWhiteSpace(Model.ThumbnailUrl))
                        {
                            <img src="@Model.ThumbnailUrl" id="thumbnailPreviewImg" alt="Thumbnail Preview" />
                        }
                        else
                        {
                            <img id="thumbnailPreviewImg" src="" style="display:none;" alt="Preview" />
                            <div class="text-center text-muted" id="previewPlaceholder">
                                <i class="bi bi-cloud-arrow-up fs-2"></i>
                                <div class="small mt-1">Chưa có ảnh bìa</div>
                            </div>
                        }
                    </div>
                    <input type="file" name="thumbnailFile" id="thumbnailFileInput" class="form-control form-control-sm" accept=".jpg,.jpeg,.png,.webp" />
                    <div class="form-text small">Hỗ trợ định dạng: JPG, PNG, WEBP. Tối đa 5 MB.</div>
                </div>

                <!-- Submit / Actions Card -->
                <div class="card border-0 shadow-sm rounded-4 p-4">
                    <h6 class="fw-bold text-dark mb-3">
                        <i class="bi bi-send-check text-primary me-2"></i>Quy Trình Duyệt
                    </h6>
                    <div class="d-grid gap-2">
                        <button type="button" class="btn btn-primary rounded-pill py-2 fw-semibold" id="submitPendingBtn">
                            <i class="bi bi-send-fill me-1"></i> Gửi Ban Quản Trị Duyệt
                        </button>
                        <button type="button" class="btn btn-outline-secondary rounded-pill py-2" id="submitDraftBtn">
                            <i class="bi bi-save me-1"></i> Lưu Bản Nháp
                        </button>
                        <a asp-controller="ReceptionistBlog" asp-action="Index" class="btn btn-link text-muted small text-decoration-none mt-1">
                            Hủy bỏ
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <!-- Quill Rich Text Editor CDN JS -->
    <script src="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.js"></script>
    <!-- Blog Editor & Media Upload Manager JS -->
    <script src="~/js/blog-editor.js" asp-append-version="true"></script>
    <script>
        // 1. Initialize Blog Editor Manager
        const blogEditor = new BlogEditorManager({
            quillContainerSelector: '#quillEditorContainer',
            hiddenContentSelector: '#hiddenContent',
            uploadUrl: '/Receptionist/Blog/UploadMedia',
            blogPostId: @(Model.BlogPostId.HasValue ? Model.BlogPostId.Value.ToString() : "null")
        });

        // 2. Live Thumbnail Preview
        const thumbnailFileInput = document.getElementById('thumbnailFileInput');
        const previewImg = document.getElementById('thumbnailPreviewImg');
        const previewPlaceholder = document.getElementById('previewPlaceholder');

        thumbnailFileInput?.addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(evt) {
                    previewImg.src = evt.target.result;
                    previewImg.style.display = 'block';
                    if (previewPlaceholder) previewPlaceholder.style.display = 'none';
                };
                reader.readAsDataURL(file);
            }
        });

        // 3. Submit Handlers
        const form = document.getElementById('blogPostForm');
        const postStatusInput = document.getElementById('postStatusInput');

        function prepareAndSubmit(status) {
            const html = blogEditor.syncContent();
            if (!html || html === '<p><br></p>') {
                alert('Vui lòng nhập nội dung bài viết.');
                return;
            }
            postStatusInput.value = status;
            form.submit();
        }

        document.getElementById('submitPendingBtn')?.addEventListener('click', function() {
            prepareAndSubmit('PendingReview');
        });

        document.getElementById('submitDraftBtn')?.addEventListener('click', function() {
            prepareAndSubmit('Draft');
        });
    </script>
}
