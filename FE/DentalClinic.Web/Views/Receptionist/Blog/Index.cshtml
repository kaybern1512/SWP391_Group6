@model DentalClinic.Web.ViewModels.Blog.DentistBlogIndexViewModel
@{
    ViewData["Title"] = "Quản Lý Bài Viết Truyền Thông - Lễ Tân";
    var items = Model.PagedResult.Items;
    var totalPages = Model.PagedResult.TotalPages;
    var currentPage = Model.CurrentPage;
}

<div class="container-fluid py-3">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1">
                <i class="bi bi-journal-richtext text-primary me-2"></i>Bài Viết & Tin Tức Của Tôi
            </h3>
            <p class="text-muted small mb-0">Biên soạn tin tức phòng khám, cẩm nang chăm sóc răng miệng và gửi Ban Quản Trị duyệt xuất bản.</p>
        </div>
        <div>
            <a asp-controller="ReceptionistBlog" asp-action="Create" class="btn btn-primary d-inline-flex align-items-center gap-2 rounded-pill px-4 py-2 shadow-sm">
                <i class="bi bi-plus-circle"></i>
                <span class="fw-semibold">Tạo Bài Viết Mới</span>
            </a>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="card border-0 shadow-sm rounded-4 p-3 mb-4">
        <form method="get" asp-controller="ReceptionistBlog" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light border-end-0">
                        <i class="bi bi-search text-muted"></i>
                    </span>
                    <input type="text"
                           name="keyword"
                           value="@Model.CurrentKeyword"
                           class="form-control bg-light border-start-0"
                           placeholder="Tìm theo tiêu đề bài viết..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select form-select-sm bg-light">
                    <option value="">-- Tất cả trạng thái --</option>
                    <option value="Draft" selected="@(Model.CurrentStatus == "Draft")">Bản nháp (Draft)</option>
                    <option value="PendingReview" selected="@(Model.CurrentStatus == "PendingReview")">Chờ duyệt (PendingReview)</option>
                    <option value="Published" selected="@(Model.CurrentStatus == "Published")">Đã xuất bản (Published)</option>
                    <option value="Rejected" selected="@(Model.CurrentStatus == "Rejected")">Bị từ chối (Rejected)</option>
                    <option value="Archived" selected="@(Model.CurrentStatus == "Archived")">Đã lưu trữ (Archived)</option>
                </select>
            </div>
            <div class="col-md-auto d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary rounded-pill px-3">
                    <i class="bi bi-funnel me-1"></i> Lọc
                </button>
                <a asp-controller="ReceptionistBlog" asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>

    <!-- Posts Table -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        @if (items != null && items.Count > 0)
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 70px;">Ảnh</th>
                            <th>Tiêu đề & Chuyên mục</th>
                            <th style="width: 150px;">Trạng thái</th>
                            <th style="width: 110px;" class="text-center">Lượt xem</th>
                            <th style="width: 130px;">Ngày tạo</th>
                            <th style="width: 130px;" class="text-end">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var post in items)
                        {
                            <tr>
                                <td>
                                    <img src="@(!string.IsNullOrWhiteSpace(post.ThumbnailUrl) ? post.ThumbnailUrl : "/images/blog/viem-tuy-rang-banner.svg")"
                                         alt="@post.Title"
                                         class="rounded-3 border object-fit-cover"
                                         style="width: 54px; height: 38px;"
                                         onerror="this.src='/images/blog/viem-tuy-rang-banner.svg'" />
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark text-truncate" style="max-width: 480px;">
                                        @post.Title
                                    </div>
                                    <div class="small text-muted d-flex align-items-center gap-2 mt-1">
                                        <span class="badge bg-light text-secondary border">@post.CategoryName</span>
                                        @if (post.IsFeatured)
                                        {
                                            <span class="badge bg-warning text-dark"><i class="bi bi-star-fill me-1"></i>Nổi bật</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(post.VideoUrl))
                                        {
                                            <span class="badge bg-danger-subtle text-danger"><i class="bi bi-camera-video me-1"></i>Có Video 3D</span>
                                        }
                                    </div>
                                    @if (!string.IsNullOrEmpty(post.RejectionReason))
                                    {
                                        <div class="small text-danger mt-1">
                                            <i class="bi bi-exclamation-circle me-1"></i>Lý do từ chối: @post.RejectionReason
                                        </div>
                                    }
                                </td>
                                <td>
                                    @switch (post.Status)
                                    {
                                        case "Draft":
                                            <span class="badge bg-secondary-subtle text-secondary px-2.5 py-1.5 rounded-pill">
                                                <i class="bi bi-file-earmark me-1"></i>Bản nháp
                                            </span>
                                            break;
                                        case "PendingReview":
                                            <span class="badge bg-warning-subtle text-warning-emphasis px-2.5 py-1.5 rounded-pill">
                                                <i class="bi bi-hourglass-split me-1"></i>Chờ Admin duyệt
                                            </span>
                                            break;
                                        case "Published":
                                            <span class="badge bg-success-subtle text-success px-2.5 py-1.5 rounded-pill">
                                                <i class="bi bi-check-circle me-1"></i>Đã xuất bản
                                            </span>
                                            break;
                                        case "Rejected":
                                            <span class="badge bg-danger-subtle text-danger px-2.5 py-1.5 rounded-pill">
                                                <i class="bi bi-x-circle me-1"></i>Bị từ chối
                                            </span>
                                            break;
                                        case "Archived":
                                            <span class="badge bg-dark-subtle text-dark px-2.5 py-1.5 rounded-pill">
                                                <i class="bi bi-archive me-1"></i>Lưu trữ
                                            </span>
                                            break;
                                        default:
                                            <span class="badge bg-light text-dark">@post.Status</span>
                                            break;
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="fw-medium text-dark"><i class="bi bi-eye text-muted me-1"></i>@post.ViewCount</span>
                                </td>
                                <td class="small text-muted">
                                    @post.CreatedAt.ToString("dd/MM/yyyy")
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        @if (post.Status == "Published")
                                        {
                                            <a asp-controller="Blog" asp-action="Detail" asp-route-slug="@post.Slug" target="_blank" class="btn btn-outline-secondary" title="Xem bài viết công khai">
                                                <i class="bi bi-box-arrow-up-right"></i>
                                            </a>
                                        }
                                        <a asp-controller="ReceptionistBlog" asp-action="Edit" asp-route-id="@post.BlogPostId" class="btn btn-outline-primary" title="Chỉnh sửa bài viết">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        @if (post.Status == "Draft" || post.Status == "Rejected")
                                        {
                                            <button type="button"
                                                    class="btn btn-outline-danger"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#deleteModal-@post.BlogPostId"
                                                    title="Xóa bài viết">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                    </div>

                                    @if (post.Status == "Draft" || post.Status == "Rejected")
                                    {
                                        <!-- Modal Xóa -->
                                        <div class="modal fade text-start" id="deleteModal-@post.BlogPostId" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content border-0 shadow-lg rounded-4">
                                                    <div class="modal-header border-0 pb-0">
                                                        <h5 class="modal-title fw-bold text-danger">Xác Nhận Xóa Bài Viết</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body py-3">
                                                        <p class="mb-1">Bạn có chắc chắn muốn xóa bài viết sau?</p>
                                                        <div class="p-2.5 bg-light rounded-3 fw-semibold text-dark small text-truncate">
                                                            @post.Title
                                                        </div>
                                                        <div class="text-muted small mt-2">Hành động này không thể hoàn tác.</div>
                                                    </div>
                                                    <div class="modal-footer border-0 pt-0">
                                                        <button type="button" class="btn btn-sm btn-light rounded-pill px-3" data-bs-dismiss="modal">Hủy</button>
                                                        <form method="post" asp-controller="ReceptionistBlog" asp-action="Delete" asp-route-id="@post.BlogPostId">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="btn btn-sm btn-danger rounded-pill px-3">Xóa vĩnh viễn</button>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            @if (totalPages > 1)
            {
                <div class="d-flex justify-content-between align-items-center p-3 border-top">
                    <div class="small text-muted">
                        Trang @currentPage / @totalPages (Tổng cộng @Model.PagedResult.TotalCount bài viết)
                    </div>
                    <ul class="pagination pagination-sm mb-0">
                        @if (currentPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link"
                                   asp-controller="ReceptionistBlog"
                                   asp-action="Index"
                                   asp-route-page="@(currentPage - 1)"
                                   asp-route-status="@Model.CurrentStatus"
                                   asp-route-keyword="@Model.CurrentKeyword">
                                    <i class="bi bi-chevron-left"></i>
                                </a>
                            </li>
                        }
                        @for (int p = 1; p <= totalPages; p++)
                        {
                            <li class="page-item @(p == currentPage ? "active" : "")">
                                <a class="page-link"
                                   asp-controller="ReceptionistBlog"
                                   asp-action="Index"
                                   asp-route-page="@p"
                                   asp-route-status="@Model.CurrentStatus"
                                   asp-route-keyword="@Model.CurrentKeyword">
                                    @p
                                </a>
                            </li>
                        }
                        @if (currentPage < totalPages)
                        {
                            <li class="page-item">
                                <a class="page-link"
                                   asp-controller="ReceptionistBlog"
                                   asp-action="Index"
                                   asp-route-page="@(currentPage + 1)"
                                   asp-route-status="@Model.CurrentStatus"
                                   asp-route-keyword="@Model.CurrentKeyword">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            }
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-journal-x fs-1 text-muted"></i>
                <h5 class="fw-bold text-dark mt-3">Chưa có bài viết nào</h5>
                <p class="text-muted small">Hãy bắt đầu tạo bài viết truyền thông hoặc cẩm nang nha khoa đầu tiên của bạn.</p>
                <a asp-controller="ReceptionistBlog" asp-action="Create" class="btn btn-sm btn-primary rounded-pill px-4 mt-1">
                    <i class="bi bi-plus-circle me-1"></i> Viết bài mới ngay
                </a>
            </div>
        }
    </div>
</div>
