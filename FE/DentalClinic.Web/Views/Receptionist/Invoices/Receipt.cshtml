@model DentalClinic.Web.ViewModels.Invoices.BillingInvoiceDetailViewModel
@{
    ViewData["Title"] = "Prime Receipt";
    var invoice = Model.Invoice;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-3">
                        <div>
                            <div class="text-muted small">DentalCare Clinic</div>
                            <h4 class="mb-0">Biên lai thanh toán</h4>
                        </div>
                        <span class="badge bg-success">@invoice.PaymentStatus</span>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <div class="text-muted small">Mã hóa đơn</div>
                            <div class="fw-semibold">@invoice.InvoiceCode</div>
                        </div>
                        <div class="col-md-6">
                            <div class="text-muted small">Ngày thanh toán</div>
                            <div class="fw-semibold">@((invoice.PaidAt ?? DateTime.Now).ToString("dd/MM/yyyy HH:mm"))</div>
                        </div>
                        <div class="col-md-6">
                            <div class="text-muted small">Bệnh nhân</div>
                            <div class="fw-semibold">@invoice.PatientName</div>
                        </div>
                        <div class="col-md-6">
                            <div class="text-muted small">Phương thức</div>
                            <div class="fw-semibold">@invoice.PaymentMethod</div>
                        </div>
                    </div>

                    <table class="table table-borderless align-middle">
                        <thead>
                            <tr class="border-bottom">
                                <th>Dịch vụ</th>
                                <th class="text-end">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in invoice.Items)
                            {
                                <tr>
                                    <td>@item.Description</td>
                                    <td class="text-end">@item.Amount.ToString("N0") đ</td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <div class="border-top pt-3 mt-3 d-flex justify-content-between align-items-center">
                        <span class="fw-semibold">Tổng thanh toán</span>
                        <span class="fw-bold fs-5 text-success">@invoice.TotalAmount.ToString("N0") đ</span>
                    </div>

                    <div class="mt-4 text-center">
                        <a asp-action="Index" class="btn btn-dc-outline me-2">Quay lại</a>
                        <a asp-action="DownloadReceiptPdf" asp-route-id="@invoice.InvoiceId" class="btn btn-dc-primary me-2">Tải PDF</a>
                        <button type="button" class="btn btn-outline-primary" onclick="window.print();">In biên lai</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
