@model DentalClinic.Web.ViewModels.PostCare.ReceptionistFollowUpIndexViewModel
@{
    ViewData["Title"] = "Nhắc Lịch Tái Khám - Bàn Lễ Tân";
    var curDate = Model.DateFilter ?? "all";
    var curStatus = Model.CallStatusFilter ?? "all";
}

@Html.AntiForgeryToken()

<div class="container-fluid px-0">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-telephone-outbound me-2 text-primary"></i>Danh Sách Nhắc Lịch Tái Khám
            </h1>
            <p class="text-muted mb-0">Theo dõi, gọi điện nhắc bệnh nhân và cập nhật trạng thái lịch tái khám sau điều trị.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill fs-6">
                <i class="bi bi-calendar-check me-1"></i>Hôm nay: @DateTime.Today.ToString("dd/MM/yyyy")
            </span>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Stat Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100 border-start border-4 border-primary">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-muted small fw-medium">Hôm nay cần nhắc</div>
                            <div class="h4 fw-bold mb-0 text-primary">@Model.TodayCount</div>
                        </div>
                        <div class="rounded-circle bg-primary bg-opacity-10 p-2 text-primary">
                            <i class="bi bi-calendar-day fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100 border-start border-4 border-warning">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-muted small fw-medium">Chưa gọi điện</div>
                            <div class="h4 fw-bold mb-0 text-warning">@Model.NotCalledCount</div>
                        </div>
                        <div class="rounded-circle bg-warning bg-opacity-10 p-2 text-warning">
                            <i class="bi bi-telephone-x fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100 border-start border-4 border-success">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-muted small fw-medium">Đã gọi xác nhận</div>
                            <div class="h4 fw-bold mb-0 text-success">@Model.CalledCount</div>
                        </div>
                        <div class="rounded-circle bg-success bg-opacity-10 p-2 text-success">
                            <i class="bi bi-telephone-check fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100 border-start border-4 border-danger">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-muted small fw-medium">Không liên lạc được</div>
                            <div class="h4 fw-bold mb-0 text-danger">@Model.UnreachableCount</div>
                        </div>
                        <div class="rounded-circle bg-danger bg-opacity-10 p-2 text-danger">
                            <i class="bi bi-telephone-minus fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <!-- Date Filters -->
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <span class="text-muted small fw-semibold me-1"><i class="bi bi-funnel me-1"></i>Thời gian:</span>
                    <a asp-action="Index" asp-route-dateFilter="all" asp-route-callStatus="@curStatus"
                       class="btn btn-sm @(curDate == "all" ? "btn-primary" : "btn-outline-secondary")">
                        Tất cả
                    </a>
                    <a asp-action="Index" asp-route-dateFilter="today" asp-route-callStatus="@curStatus"
                       class="btn btn-sm @(curDate == "today" ? "btn-primary" : "btn-outline-secondary")">
                        <i class="bi bi-clock me-1"></i>Hôm nay (@Model.TodayCount)
                    </a>
                    <a asp-action="Index" asp-route-dateFilter="tomorrow" asp-route-callStatus="@curStatus"
                       class="btn btn-sm @(curDate == "tomorrow" ? "btn-primary" : "btn-outline-secondary")">
                        <i class="bi bi-calendar2-day me-1"></i>Ngày mai (@Model.TomorrowCount)
                    </a>
                </div>

                <!-- Call Status Filters -->
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <span class="text-muted small fw-semibold me-1">Trạng thái gọi:</span>
                    <a asp-action="Index" asp-route-dateFilter="@curDate" asp-route-callStatus="all"
                       class="btn btn-sm @(curStatus == "all" ? "btn-secondary" : "btn-outline-secondary")">
                        Tất cả
                    </a>
                    <a asp-action="Index" asp-route-dateFilter="@curDate" asp-route-callStatus="NotCalled"
                       class="btn btn-sm @(curStatus == "NotCalled" ? "btn-warning text-dark" : "btn-outline-secondary")">
                        Chưa gọi
                    </a>
                    <a asp-action="Index" asp-route-dateFilter="@curDate" asp-route-callStatus="Called"
                       class="btn btn-sm @(curStatus == "Called" ? "btn-success" : "btn-outline-secondary")">
                        Đã gọi
                    </a>
                    <a asp-action="Index" asp-route-dateFilter="@curDate" asp-route-callStatus="Unreachable"
                       class="btn btn-sm @(curStatus == "Unreachable" ? "btn-danger" : "btn-outline-secondary")">
                        Không liên lạc được
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Operational Guideline Alert -->
    <div class="alert alert-info border-0 shadow-sm py-2 px-3 mb-4 d-flex align-items-center gap-2 small">
        <i class="bi bi-info-circle-fill fs-5 text-primary"></i>
        <div>
            <strong>Quy định nghiệp vụ lễ tân:</strong> Lễ tân thực hiện gọi điện nhắc lịch, ghi nhận nhật ký cuộc gọi và có thể 
            <strong>Xác nhận</strong> bệnh nhân sẽ đến, <strong>Dời lịch</strong> tái khám theo nguyện vọng của bệnh nhân hoặc đánh dấu <strong>Hoàn tất</strong> sau khi bệnh nhân đã khám xong.
        </div>
    </div>

    <!-- Reminders Table -->
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Ngày giờ tái khám</th>
                        <th>Bệnh nhân</th>
                        <th>Số điện thoại</th>
                        <th>Bác sĩ phụ trách</th>
                        <th>Lịch hẹn</th>
                        <th>Trạng thái nhắc</th>
                        <th>Nhật ký cuộc gọi</th>
                        <th class="text-end pe-4" style="min-width: 260px;">Thao tác CSKH</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Reminders.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-5">
                                <i class="bi bi-telephone-x fs-1 text-secondary opacity-50 d-block mb-2"></i>
                                Không có lịch tái khám nào phù hợp với bộ lọc hiện tại.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Reminders)
                        {
                            var rowClass = item.CallStatus == "Called" ? "table-light" : item.CallStatus == "Unreachable" ? "table-danger table-opacity-10" : "";
                            <tr class="@rowClass" id="reminder-row-@item.FollowUpId">
                                <td class="ps-4">
                                    <div class="fw-bold text-dark">
                                        @if (item.ScheduledStart.HasValue)
                                        {
                                            @item.ScheduledStart.Value.ToString("dd/MM/yyyy HH:mm")
                                        }
                                        else
                                        {
                                            @item.FollowUpDate.ToString("dd/MM/yyyy")
                                        }
                                    </div>
                                    @if (item.ScheduledStart.HasValue)
                                    {
                                        <div class="small text-muted">@item.ScheduledStart.Value.ToString("HH:mm") - @item.ScheduledEnd?.ToString("HH:mm")</div>
                                    }
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@item.PatientName</div>
                                    @if (!string.IsNullOrWhiteSpace(item.PatientCode))
                                    {
                                        <div class="small text-muted font-monospace">@item.PatientCode</div>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.PatientPhoneNumber))
                                    {
                                        <a href="tel:@item.PatientPhoneNumber" class="btn btn-sm btn-outline-success fw-bold text-decoration-none py-1 px-2">
                                            <i class="bi bi-telephone-fill me-1"></i>@item.PatientPhoneNumber
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small fst-italic">Chưa có SĐT</span>
                                    }
                                </td>
                                <td>
                                    <div class="fw-semibold">BS. @item.DentistName</div>
                                    <div class="small text-muted">@item.DepartmentName</div>
                                </td>
                                <td>
                                    @if (item.AppointmentId.HasValue)
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                            <i class="bi bi-calendar2-check me-1"></i>Đã lên lịch (@(item.AppointmentCode ?? "APT"))
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
                                            Chờ xếp lịch
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (item.CallStatus == "Called")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                            <i class="bi bi-check-circle-fill me-1"></i>Đã gọi
                                        </span>
                                    }
                                    else if (item.CallStatus == "Unreachable")
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                            <i class="bi bi-x-circle-fill me-1"></i>Không liên lạc được
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1">
                                            <i class="bi bi-hourglass-split me-1"></i>Chưa gọi
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (item.LastCalledAt.HasValue)
                                    {
                                        <div class="small text-dark fw-medium">
                                            @item.LastCalledAt.Value.ToLocalTime().ToString("dd/MM HH:mm")
                                            <span class="text-muted">bởi @(item.LastCallerName ?? "Lễ tân")</span>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(item.CallNote))
                                        {
                                            <div class="small text-muted text-truncate" style="max-width: 200px;" title="@item.CallNote">
                                                <i class="bi bi-chat-left-text me-1"></i>@item.CallNote
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="small text-muted fst-italic">Chưa có ghi nhận</span>
                                    }
                                </td>
                                <td class="text-end pe-4 text-nowrap">
                                    <div class="btn-group btn-group-sm shadow-sm" role="group">
                                        <!-- 1. Ghi nhận cuộc gọi (AJAX Modal - Safe data attributes) -->
                                        <button type="button"
                                                class="btn btn-primary btn-open-call-modal"
                                                data-followup-id="@item.FollowUpId"
                                                data-patient-name="@item.PatientName"
                                                data-phone-number="@(item.PatientPhoneNumber ?? "")"
                                                data-time-str="@(item.ScheduledStart.HasValue ? item.ScheduledStart.Value.ToString("dd/MM/yyyy HH:mm") : item.FollowUpDate.ToString("dd/MM/yyyy"))"
                                                data-call-status="@item.CallStatus"
                                                data-call-note="@(item.CallNote ?? "")"
                                                title="Ghi nhận nhật ký cuộc gọi">
                                            <i class="bi bi-telephone-plus me-1"></i>Ghi nhận
                                        </button>

                                        <!-- 2. Xác nhận cuộc gọi / chuyển sang Đã Xác Nhận -->
                                        @if (item.AppointmentStatus != "Confirmed" && item.AppointmentStatus != "Completed")
                                        {
                                            <form asp-action="Confirm" asp-route-id="@item.FollowUpId" asp-route-dateFilter="@curDate" asp-route-callStatus="@curStatus" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-primary" title="Xác nhận bệnh nhân đã đồng ý đến tái khám">
                                                    <i class="bi bi-telephone-check me-1"></i>Xác nhận
                                                </button>
                                            </form>
                                        }

                                        <!-- 3. Dời lịch tái khám -->
                                        @if (item.AppointmentStatus != "Completed")
                                        {
                                            @if (item.AppointmentId.HasValue)
                                            {
                                                <span class="badge bg-light text-secondary border d-inline-flex align-items-center py-1 px-2"
                                                      title="Lịch tái khám đã có cuộc hẹn chính thức (#@(item.AppointmentCode)). Việc đổi lịch cần do bệnh nhân đề xuất qua Cổng bệnh nhân hoặc bác sĩ phụ trách phê duyệt để tránh trùng ca/ghế.">
                                                    <i class="bi bi-lock-fill me-1 text-muted"></i>#@(item.AppointmentCode)
                                                </span>
                                            }
                                            else
                                            {
                                                <button type="button"
                                                    class="btn btn-outline-secondary btn-open-reschedule-modal"
                                                    data-followup-id="@item.FollowUpId"
                                                    data-patient-name="@item.PatientName"
                                                    data-patient-code="@(item.PatientCode ?? "")"
                                                    data-dentist-name="@item.DentistName"
                                                    data-department-name="@item.DepartmentName"
                                                    data-default-date="@(item.FollowUpDate > DateTime.Today ? item.FollowUpDate.ToString("yyyy-MM-dd") : DateTime.Today.AddDays(3).ToString("yyyy-MM-dd"))"
                                                    title="Dời ngày hẹn tái khám theo yêu cầu của bệnh nhân">
                                                <i class="bi bi-calendar-range me-1"></i>Dời lịch
                                            </button>

                                            }

                                            <!-- 4. Hoàn tất tái khám -->
                                            @if (!item.AppointmentId.HasValue)
                                            {
                                            <form asp-action="Complete" asp-route-id="@item.FollowUpId" asp-route-dateFilter="@curDate" asp-route-callStatus="@curStatus" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-success" title="Đánh dấu bệnh nhân đã hoàn tất tái khám" onclick="return confirm('Xác nhận bệnh nhân đã tái khám hoàn tất?');">
                                                    <i class="bi bi-check-lg me-1"></i>Xong
                                                </button>
                                            </form>
                                            }
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Ghi Nhận Cuộc Gọi -->
<div class="modal fade" id="modalCallStatus" tabindex="-1" aria-labelledby="modalCallStatusLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold" id="modalCallStatusLabel">
                    <i class="bi bi-telephone-outbound text-primary me-2"></i>Ghi Nhận Cuộc Gọi Nhắc Lịch
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="callStatusForm" onsubmit="handleCallStatusSubmit(event)">
                <div class="modal-body p-4">
                    <input type="hidden" id="callFollowUpId" name="FollowUpId" />

                    <!-- Patient Summary Card -->
                    <div class="card bg-light border-0 mb-3">
                        <div class="card-body p-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="fw-bold text-dark fs-6" id="modalPatientName">—</span>
                                <span class="badge bg-primary-subtle text-primary" id="modalFollowUpTime">—</span>
                            </div>
                            <div class="small">
                                <span class="text-muted">Số điện thoại: </span>
                                <a id="modalPhoneLink" href="#" class="fw-bold text-success text-decoration-none">
                                    <i class="bi bi-telephone-fill me-1"></i><span>—</span>
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- Call Status Options -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-dark">Kết quả liên hệ: <span class="text-danger">*</span></label>
                        <div class="d-flex flex-column gap-2">
                            <div class="form-check p-2 border rounded-3 hover-bg-light">
                                <input class="form-check-input ms-1 me-2" type="radio" name="callStatusRadio" id="statusCalled" value="Called" checked>
                                <label class="form-check-label fw-medium text-success" for="statusCalled">
                                    <i class="bi bi-check-circle-fill me-1"></i>Đã gọi được (Bệnh nhân nghe máy và xác nhận)
                                </label>
                            </div>
                            <div class="form-check p-2 border rounded-3 hover-bg-light">
                                <input class="form-check-input ms-1 me-2" type="radio" name="callStatusRadio" id="statusUnreachable" value="Unreachable">
                                <label class="form-check-label fw-medium text-danger" for="statusUnreachable">
                                    <i class="bi bi-x-circle-fill me-1"></i>Không liên lạc được (Thuê bao, máy bận, không bắt máy)
                                </label>
                            </div>
                            <div class="form-check p-2 border rounded-3 hover-bg-light">
                                <input class="form-check-input ms-1 me-2" type="radio" name="callStatusRadio" id="statusNotCalled" value="NotCalled">
                                <label class="form-check-label fw-medium text-secondary" for="statusNotCalled">
                                    <i class="bi bi-hourglass-split me-1"></i>Chưa gọi (Cần liên hệ sau)
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- Call Notes -->
                    <div class="mb-3">
                        <label for="callNote" class="form-label fw-semibold text-dark">Ghi chú cuộc gọi:</label>
                        <textarea class="form-control" id="callNote" name="Note" rows="3"
                                  placeholder="Ví dụ: Bệnh nhân xác nhận đến đúng giờ; hoặc bệnh nhân dặn gọi lại vào buổi chiều..."></textarea>
                    </div>

                    <div id="callModalError" class="alert alert-danger py-2 small d-none" role="alert"></div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary fw-semibold" id="btnSaveCallStatus">
                        <span class="spinner-border spinner-border-sm me-1 d-none" id="btnSaveSpinner" role="status" aria-hidden="true"></span>
                        <i class="bi bi-check2-circle me-1" id="btnSaveIcon"></i>Lưu Kết Quả
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Dời Lịch Tái Khám (Reusable & An toàn injection) -->
<div class="modal fade" id="modalRescheduleFollowUp" tabindex="-1" aria-labelledby="modalRescheduleFollowUpLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form id="rescheduleFollowUpForm" method="post" action="">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-light">
                    <h5 class="modal-title fw-bold" id="modalRescheduleFollowUpLabel">
                        <i class="bi bi-calendar-range text-primary me-2"></i>Dời Ngày Tái Khám
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3 p-3 bg-light rounded-3 border">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="fw-bold text-dark fs-6" id="reschedulePatientName">—</span>
                            <span class="badge bg-secondary-subtle text-secondary" id="reschedulePatientCode">—</span>
                        </div>
                        <div class="small text-muted">
                            <i class="bi bi-person-badge text-success me-1"></i>Bác sĩ: <span id="rescheduleDentistName">—</span>
                            (<span id="rescheduleDepartmentName">—</span>)
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-dark">
                            <i class="bi bi-calendar-event text-primary me-1"></i>Chọn ngày hẹn tái khám mới <span class="text-danger">*</span>
                        </label>
                        <input type="date" id="rescheduleNewDate" name="newDate" class="form-control" min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" required />
                        <div class="form-text">Ngày hẹn mới phải từ ngày mai trở đi.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-dark">
                            <i class="bi bi-chat-left-text text-secondary me-1"></i>Ghi chú cuộc gọi / Lý do dời ngày
                        </label>
                        <textarea id="rescheduleNote" name="note" class="form-control" rows="3" placeholder="Ví dụ: Bệnh nhân bận công tác, xin dời sang tuần sau..."></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary fw-semibold">
                        <i class="bi bi-calendar-check me-1"></i>Lưu Ngày Mới
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let currentModalInstance = null;

    document.addEventListener('DOMContentLoaded', function () {
        // Safe event binding for call modal using dataset
        document.querySelectorAll('.btn-open-call-modal').forEach(function (btn) {
            btn.addEventListener('click', function () {
                const followUpId = this.dataset.followupId;
                const patientName = this.dataset.patientName || '';
                const phoneNumber = this.dataset.phoneNumber || '';
                const timeStr = this.dataset.timeStr || '';
                const currentStatus = this.dataset.callStatus || '';
                const currentNote = this.dataset.callNote || '';

                openCallModal(followUpId, patientName, phoneNumber, timeStr, currentStatus, currentNote);
            });
        });

        // Safe event binding for reschedule modal using dataset
        document.querySelectorAll('.btn-open-reschedule-modal').forEach(function (btn) {
            btn.addEventListener('click', function () {
                const followUpId = this.dataset.followupId;
                const patientName = this.dataset.patientName || '';
                const patientCode = this.dataset.patientCode || '';
                const dentistName = this.dataset.dentistName || '';
                const departmentName = this.dataset.departmentName || '';
                const defaultDate = this.dataset.defaultDate || '';

                openRescheduleModal(followUpId, patientName, patientCode, dentistName, departmentName, defaultDate);
            });
        });
    });

    function openRescheduleModal(followUpId, patientName, patientCode, dentistName, departmentName, defaultDate) {
        const form = document.getElementById('rescheduleFollowUpForm');
        form.action = '/Receptionist/FollowUps/Reschedule/' + encodeURIComponent(followUpId) + '?dateFilter=@curDate&callStatus=@curStatus';

        document.getElementById('reschedulePatientName').textContent = patientName;
        document.getElementById('reschedulePatientCode').textContent = patientCode;
        document.getElementById('rescheduleDentistName').textContent = dentistName;
        document.getElementById('rescheduleDepartmentName').textContent = departmentName;
        document.getElementById('rescheduleNewDate').value = defaultDate;
        document.getElementById('rescheduleNote').value = '';

        const modalEl = document.getElementById('modalRescheduleFollowUp');
        const modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
        modal.show();
    }

    function openCallModal(followUpId, patientName, phoneNumber, timeStr, currentStatus, currentNote) {
        document.getElementById('callFollowUpId').value = followUpId;
        document.getElementById('modalPatientName').textContent = patientName;
        document.getElementById('modalFollowUpTime').textContent = timeStr;

        const phoneLink = document.getElementById('modalPhoneLink');
        if (phoneNumber && phoneNumber.trim().length > 0) {
            phoneLink.href = 'tel:' + encodeURIComponent(phoneNumber.trim());
            phoneLink.querySelector('span').textContent = phoneNumber;
            phoneLink.classList.remove('d-none');
        } else {
            phoneLink.querySelector('span').textContent = 'Chưa có SĐT';
            phoneLink.removeAttribute('href');
        }

        // Set radio
        if (currentStatus === 'Called') {
            document.getElementById('statusCalled').checked = true;
        } else if (currentStatus === 'Unreachable') {
            document.getElementById('statusUnreachable').checked = true;
        } else {
            document.getElementById('statusNotCalled').checked = true;
        }

        document.getElementById('callNote').value = currentNote || '';
        document.getElementById('callModalError').classList.add('d-none');

        const modalEl = document.getElementById('modalCallStatus');
        currentModalInstance = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
        currentModalInstance.show();
    }

    async function handleCallStatusSubmit(e) {
        e.preventDefault();

        const followUpId = parseInt(document.getElementById('callFollowUpId').value);
        const selectedRadio = document.querySelector('input[name="callStatusRadio"]:checked');
        const callStatus = selectedRadio ? selectedRadio.value : 'Called';
        const note = document.getElementById('callNote').value.trim();

        const btnSave = document.getElementById('btnSaveCallStatus');
        const spinner = document.getElementById('btnSaveSpinner');
        const icon = document.getElementById('btnSaveIcon');
        const errDiv = document.getElementById('callModalError');

        btnSave.disabled = true;
        spinner.classList.remove('d-none');
        icon.classList.add('d-none');
        errDiv.classList.add('d-none');

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

        try {
            const res = await fetch('/Receptionist/FollowUps/UpdateCallStatus', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token || ''
                },
                body: JSON.stringify({
                    followUpId: followUpId,
                    callStatus: callStatus,
                    note: note
                })
            });

            const data = await res.json();

            btnSave.disabled = false;
            spinner.classList.add('d-none');
            icon.classList.remove('d-none');

            if (res.ok && data.success) {
                if (currentModalInstance) {
                    currentModalInstance.hide();
                }

                // Update UI without full page refresh
                const row = document.getElementById(`reminder-row-${followUpId}`);
                if (row) {
                    row.className = callStatus === 'Called' ? 'table-light' : (callStatus === 'Unreachable' ? 'table-danger table-opacity-10' : '');
                }

                // Reload to reflect all stats
                window.location.reload();
            } else {
                errDiv.textContent = data.message || 'Không thể lưu trạng thái cuộc gọi. Vui lòng thử lại.';
                errDiv.classList.remove('d-none');
            }
        } catch (err) {
            console.error(err);
            btnSave.disabled = false;
            spinner.classList.add('d-none');
            icon.classList.remove('d-none');
            errDiv.textContent = 'Lỗi kết nối máy chủ khi gửi dữ liệu.';
            errDiv.classList.remove('d-none');
        }
    }
</script>
}
