@model DentalClinic.Web.ViewModels.PostCare.ReceptionistFollowUpsViewModel
@{
    ViewData["Title"] = "Điều Phối Chăm Sóc & Tái Khám";
}

<div class="container-fluid p-0">
    <!-- Page Header -->
    <div class="page-header-dc mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge-dc badge-role-receptionist">Lễ Tân / CSKH</span>
                <span class="badge bg-white text-muted border small">Chăm Sóc Sau Điều Trị</span>
            </div>
            <h1 class="page-title">Theo Dõi Lịch Tái Khám Của Bệnh Nhân</h1>
            <p class="page-subtitle">Quản lý danh sách các ca được bác sĩ chỉ định tái khám, liên hệ nhắc hẹn và hỗ trợ đặt lịch.</p>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2" role="alert">
            <i class="bi bi-check-circle-fill fs-5"></i>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
            <div>@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Stat Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white">
                <div class="text-muted small fw-medium">Cần Nhắc Hẹn (Pending)</div>
                <div class="fs-3 fw-bold text-warning">@Model.PendingCount</div>
            </div>
        </div>
        <div class="col-sm-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white">
                <div class="text-muted small fw-medium">Đã Xếp Lịch Hẹn</div>
                <div class="fs-3 fw-bold text-success">@Model.ScheduledCount</div>
            </div>
        </div>
        <div class="col-sm-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white">
                <div class="text-muted small fw-medium">Tổng Hồ Sơ Theo Dõi</div>
                <div class="fs-3 fw-bold text-primary">@Model.FollowUps.Count</div>
            </div>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-md-3">
                    <select name="status" class="form-select form-select-sm">
                        <option value="">-- Tất cả trạng thái --</option>
                        <option value="Pending" selected="@(Model.StatusFilter == "Pending")">Chờ liên hệ (Pending)</option>
                        <option value="Scheduled" selected="@(Model.StatusFilter == "Scheduled")">Đã xếp lịch (Scheduled)</option>
                        <option value="Completed" selected="@(Model.StatusFilter == "Completed")">Đã hoàn thành</option>
                        <option value="Cancelled" selected="@(Model.StatusFilter == "Cancelled")">Đã hủy</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <input type="date" name="fromDate" class="form-control form-control-sm" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" placeholder="Từ ngày" />
                </div>
                <div class="col-md-3">
                    <input type="date" name="toDate" class="form-control form-control-sm" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" placeholder="Đến ngày" />
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-sm btn-primary flex-grow-1">
                        <i class="bi bi-filter me-1"></i>Lọc
                    </button>
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Đặt lại</a>
                </div>
            </form>
        </div>
    </div>

    <!-- FollowUps Table -->
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Mã Theo Dõi</th>
                        <th>Bệnh Nhân & Số Điện Thoại</th>
                        <th>Ngày Tái Khám Đề Xuất</th>
                        <th>Khoa & Bác Sĩ Đề Xuất</th>
                        <th>Ghi Chú Khuyến Nghị</th>
                        <th>Trạng Thái</th>
                        <th class="text-end pe-3">Cập Nhật Trạng Thái</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.FollowUps.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                Không tìm thấy lịch tái khám nào phù hợp.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.FollowUps)
                        {
                            <tr>
                                <td class="ps-3 fw-bold text-primary">#FOL-@item.FollowUpId</td>
                                <td>
                                    <div class="fw-semibold">@item.PatientName</div>
                                    <div class="small text-muted">
                                        <i class="bi bi-telephone me-1"></i>@(item.PatientPhone ?? "Chưa có SĐT")
                                        • Mã BN: @item.PatientCode
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@item.RecommendedDate.ToString("dd/MM/yyyy")</div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@item.DepartmentName</span>
                                    <div class="small text-muted">BS. @item.DentistName</div>
                                </td>
                                <td style="max-width: 250px;">
                                    <div class="text-truncate-2 small">@(item.Reason ?? "Theo dõi phục hồi")</div>
                                </td>
                                <td>
                                    @switch (item.Status)
                                    {
                                        case "Pending":
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">Cần liên hệ</span>
                                            break;
                                        case "Scheduled":
                                            <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle">Đã đặt hẹn</span>
                                            break;
                                        case "Completed":
                                            <span class="badge bg-info-subtle text-info border">Hoàn thành</span>
                                            break;
                                        case "Cancelled":
                                            <span class="badge bg-danger-subtle text-danger border">Đã hủy</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary">@item.Status</span>
                                            break;
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <div class="btn-group btn-group-sm">
                                        @if (item.Status == "Pending")
                                        {
                                            <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#receptionistLinkModal" data-followup-id="@item.FollowUpId" data-patient-name="@item.PatientName" title="Liên kết lịch hẹn đã đặt">
                                                <i class="bi bi-link-45deg"></i> Gắn lịch hẹn
                                            </button>
                                            <form asp-action="UpdateStatus" method="post" class="d-inline ms-1" onsubmit="return confirm('Xác nhận hủy theo dõi lịch tái khám này?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="followUpId" value="@item.FollowUpId" />
                                                <input type="hidden" name="Status" value="Cancelled" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm" title="Hủy theo dõi">
                                                    <i class="bi bi-x"></i> Hủy
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted small"><em>Không có thao tác</em></span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Gắn Lịch Hẹn Cho Lễ Tân -->
<div class="modal fade" id="receptionistLinkModal" tabindex="-1" aria-labelledby="receptionistLinkModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form asp-action="UpdateStatus" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="followUpId" id="recLinkFollowUpId" value="0" />
                <input type="hidden" name="Status" value="Scheduled" />
                <div class="modal-header bg-light">
                    <h5 class="modal-title font-heading" id="receptionistLinkModalLabel">
                        <i class="bi bi-link-45deg text-primary me-2"></i>Liên Kết Lịch Hẹn Khám
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="text-muted small mb-3">Nhập Mã ID lịch hẹn bệnh nhân <strong id="recPatientName"></strong> đã đặt thành công để chuyển trạng thái sang Đã xếp lịch (Scheduled):</p>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Mã ID Lịch Hẹn (Appointment ID) <span class="text-danger">*</span></label>
                        <input type="number" name="AppointmentId" class="form-control" required placeholder="Ví dụ: 501" min="1" />
                        <div class="form-text small text-muted">Hệ thống sẽ kiểm tra bảo đảm lịch hẹn thuộc về bệnh nhân và chưa gắn cho ca tái khám khác.</div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary px-4">Gắn lịch hẹn</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var receptionistLinkModal = document.getElementById('receptionistLinkModal');
        if (receptionistLinkModal) {
            receptionistLinkModal.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                document.getElementById('recLinkFollowUpId').value = button.getAttribute('data-followup-id');
                document.getElementById('recPatientName').textContent = button.getAttribute('data-patient-name');
            });
        }
    </script>
}
