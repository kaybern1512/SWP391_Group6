@model DentalClinic.Web.ViewModels.PostCare.ReceptionistFollowUpIndexViewModel
@{
    ViewData["Title"] = "Theo Dõi & Nhắc Hẹn Tái Khám";
}

<div class="container-fluid px-0">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-calendar-heart text-primary me-2"></i>Theo Dõi Lịch Hẹn Tái Khám
            </h1>
            <p class="text-muted mb-0">Quầy Lễ Tân &bull; Chăm sóc khách hàng và liên hệ nhắc lịch tái khám sau điều trị</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-clockwise me-1"></i> Làm mới
            </a>
            <a asp-controller="ReceptionistAppointment" asp-action="Requests" class="btn btn-outline-primary">
                <i class="bi bi-calendar-check me-1"></i> Yêu cầu đặt lịch
            </a>
        </div>
    </div>

    <!-- KPI Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-primary bg-opacity-10 text-primary p-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                        <i class="bi bi-calendar-range fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-medium">Tổng lịch theo dõi</div>
                        <div class="fs-4 fw-bold text-dark">@Model.TotalCount</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 border-start border-success border-4">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-success bg-opacity-10 text-success p-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                        <i class="bi bi-calendar2-event fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-medium">Cần tái khám hôm nay</div>
                        <div class="fs-4 fw-bold text-success">@Model.TodayCount</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 border-start border-info border-4">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-info bg-opacity-10 text-info p-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                        <i class="bi bi-clock-history fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-medium">Sắp đến hạn</div>
                        <div class="fs-4 fw-bold text-info">@Model.UpcomingCount</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 border-start border-danger border-4">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="rounded-3 bg-danger bg-opacity-10 text-danger p-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                        <i class="bi bi-exclamation-triangle fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-medium">Đã quá hạn</div>
                        <div class="fs-4 fw-bold text-danger">@Model.OverdueCount</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter & Search Section -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <!-- Quick Filter Tabs -->
            <div class="d-flex flex-wrap gap-2 mb-3 pb-3 border-bottom">
                <a asp-action="Index" asp-route-quickFilter="all" class="btn btn-sm @(Model.QuickFilter == "all" ? "btn-primary" : "btn-light")">
                    <i class="bi bi-grid-fill me-1"></i> Tất cả (@Model.TotalCount)
                </a>
                <a asp-action="Index" asp-route-quickFilter="today" class="btn btn-sm @(Model.QuickFilter == "today" ? "btn-success text-white" : "btn-light")">
                    <i class="bi bi-calendar-check me-1"></i> Hôm nay
                </a>
                <a asp-action="Index" asp-route-quickFilter="week" class="btn btn-sm @(Model.QuickFilter == "week" ? "btn-info text-white" : "btn-light")">
                    <i class="bi bi-calendar-week me-1"></i> 7 ngày tới
                </a>
                <a asp-action="Index" asp-route-quickFilter="overdue" class="btn btn-sm @(Model.QuickFilter == "overdue" ? "btn-danger text-white" : "btn-light")">
                    <i class="bi bi-exclamation-octagon me-1"></i> Đã quá hạn
                </a>
                <a asp-action="Index" asp-route-quickFilter="upcoming" class="btn btn-sm @(Model.QuickFilter == "upcoming" ? "btn-secondary text-white" : "btn-light")">
                    <i class="bi bi-hourglass me-1"></i> Sắp tới
                </a>
            </div>

            <!-- Custom Filter Form -->
            <form method="get" asp-action="Index" class="row g-3 align-items-end">
                <input type="hidden" name="quickFilter" value="custom" />

                <div class="col-12 col-md-3">
                    <label class="form-label small fw-semibold text-muted">Từ ngày</label>
                    <input type="date" name="fromDate" class="form-control form-control-sm" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" />
                </div>

                <div class="col-12 col-md-3">
                    <label class="form-label small fw-semibold text-muted">Đến ngày</label>
                    <input type="date" name="toDate" class="form-control form-control-sm" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" />
                </div>

                <div class="col-12 col-md-2">
                    <label class="form-label small fw-semibold text-muted">Trạng thái</label>
                    <select name="status" class="form-select form-select-sm">
                        <option value="">-- Tất cả --</option>
                        <option value="Pending" selected="@(Model.StatusFilter == "Pending")">Chờ tái khám</option>
                        <option value="Completed" selected="@(Model.StatusFilter == "Completed")">Đã tái khám</option>
                        <option value="Cancelled" selected="@(Model.StatusFilter == "Cancelled")">Đã hủy</option>
                    </select>
                </div>

                <div class="col-12 col-md-3">
                    <label class="form-label small fw-semibold text-muted">Tìm kiếm bệnh nhân / Bác sĩ</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                        <input type="text" name="search" class="form-control" placeholder="Tên, SĐT, Mã BN..." value="@Model.SearchKeyword" />
                    </div>
                </div>

                <div class="col-12 col-md-1 d-flex gap-1">
                    <button type="submit" class="btn btn-sm btn-primary w-100" title="Áp dụng lọc">
                        <i class="bi bi-funnel"></i>
                    </button>
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary" title="Đặt lại">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Follow-up Schedule Table -->
    @if (Model.FollowUps.Count == 0)
    {
        <div class="card border-0 shadow-sm text-center py-5">
            <div class="card-body">
                <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center mb-3" style="width: 72px; height: 72px;">
                    <i class="bi bi-calendar-x fs-2 text-muted"></i>
                </div>
                <h5 class="fw-bold text-dark">Không tìm thấy lịch tái khám phù hợp</h5>
                <p class="text-muted mb-3">Không có bản ghi tái khám nào khớp với điều kiện lọc hoặc từ khóa tìm kiếm hiện tại.</p>
                <a asp-action="Index" class="btn btn-sm btn-primary">
                    <i class="bi bi-arrow-repeat me-1"></i> Xem tất cả lịch tái khám
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0 fw-bold text-dark">
                    <i class="bi bi-list-check me-2 text-primary"></i>Danh Sách Bệnh Nhân Cần Tái Khám (@Model.FollowUps.Count bệnh nhân)
                </h5>
                <span class="badge bg-light text-muted fw-normal">Sắp xếp theo ngày tái khám gần nhất</span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3" style="width: 100px;">Mã Lịch</th>
                            <th style="min-width: 220px;">Bệnh Nhân & Liên Hệ</th>
                            <th style="min-width: 170px;">Ngày Hẹn Tái Khám</th>
                            <th style="min-width: 200px;">Bác Sĩ & Chuyên Khoa</th>
                            <th>Nội Dung / Dặn Dò</th>
                            <th style="width: 130px;">Trạng Thái</th>
                            <th class="text-end pe-3" style="width: 140px;">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.FollowUps)
                        {
                            var rowClass = item.IsToday ? "table-success-subtle" : (item.IsOverdue ? "table-warning-subtle" : "");
                            <tr class="@rowClass">
                                <td class="ps-3">
                                    <span class="fw-bold text-primary font-monospace">#@item.FollowUpId</span>
                                    @if (!string.IsNullOrEmpty(item.AppointmentCode))
                                    {
                                        <div class="text-muted small">Hẹn: @item.AppointmentCode</div>
                                    }
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@item.PatientName</div>
                                    <div class="d-flex align-items-center gap-2 mt-1">
                                        @if (!string.IsNullOrEmpty(item.PatientCode))
                                        {
                                            <span class="badge bg-light text-secondary border font-monospace">@item.PatientCode</span>
                                        }
                                        @if (!string.IsNullOrEmpty(item.PhoneNumber))
                                        {
                                            <a href="tel:@item.PhoneNumber" class="text-primary text-decoration-none small fw-semibold" title="Gọi điện nhắc hẹn">
                                                <i class="bi bi-telephone-fill me-1 text-success"></i>@item.PhoneNumber
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted small italic">Chưa có SĐT</span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">
                                        <i class="bi bi-calendar3 me-1 text-primary"></i>@item.RecommendedDate.ToString("dd/MM/yyyy")
                                    </div>
                                    @if (item.IsToday)
                                    {
                                        <span class="badge bg-success mt-1">
                                            <i class="bi bi-alarm me-1"></i>Hôm nay
                                        </span>
                                    }
                                    else if (item.IsOverdue)
                                    {
                                        var overdueDays = (DateTime.UtcNow.Date - item.RecommendedDate.Date).Days;
                                        <span class="badge bg-danger mt-1">
                                            <i class="bi bi-exclamation-triangle-fill me-1"></i>Quá hạn @overdueDays ngày
                                        </span>
                                    }
                                    else
                                    {
                                        var daysLeft = (item.RecommendedDate.Date - DateTime.UtcNow.Date).Days;
                                        <span class="badge bg-info text-white mt-1">
                                            <i class="bi bi-hourglass-split me-1"></i>Còn @daysLeft ngày
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">BS. @item.DentistName</div>
                                    <div class="text-muted small">
                                        <i class="bi bi-diagram-2 me-1"></i>@item.DepartmentName
                                    </div>
                                </td>
                                <td>
                                    <div class="text-truncate" style="max-width: 280px;" title="@item.Reason">
                                        @(string.IsNullOrWhiteSpace(item.Reason) ? "Tái khám theo dõi" : item.Reason)
                                    </div>
                                </td>
                                <td>
                                    @if (item.Status == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark px-2 py-1">
                                            <i class="bi bi-hourglass-split me-1"></i>Chờ tái khám
                                        </span>
                                    }
                                    else if (item.Status == "Completed")
                                    {
                                        <span class="badge bg-success px-2 py-1">
                                            <i class="bi bi-check-circle me-1"></i>Đã tái khám
                                        </span>
                                    }
                                    else if (item.Status == "Cancelled")
                                    {
                                        <span class="badge bg-secondary px-2 py-1">
                                            <i class="bi bi-x-circle me-1"></i>Đã hủy
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-dark border">@item.Status</span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <div class="btn-group">
                                        @if (!string.IsNullOrEmpty(item.PhoneNumber))
                                        {
                                            <a href="tel:@item.PhoneNumber" class="btn btn-sm btn-outline-success" title="Gọi điện nhắc hẹn">
                                                <i class="bi bi-telephone-outbound"></i>
                                            </a>
                                        }
                                        <button type="button" class="btn btn-sm btn-outline-primary"
                                                onclick="showDetailModal('@item.FollowUpId', '@Html.Raw(Html.Encode(item.PatientName))', '@item.PatientCode', '@item.PhoneNumber', '@item.RecommendedDate.ToString("dd/MM/yyyy")', '@Html.Raw(Html.Encode(item.DentistName))', '@Html.Raw(Html.Encode(item.DepartmentName))', '@Html.Raw(Html.Encode(item.Reason ?? "Không có dặn dò bổ sung"))', '@item.Status')"
                                                title="Xem thông tin chi tiết">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<!-- Modal Chi Tiết Tái Khám -->
<div class="modal fade" id="followUpDetailModal" tabindex="-1" aria-labelledby="followUpDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold text-dark" id="followUpDetailModalLabel">
                    <i class="bi bi-calendar-heart text-primary me-2"></i>Chi Tiết Lịch Hẹn Tái Khám
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="mb-3 pb-3 border-bottom">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted small">Mã lịch hẹn:</span>
                        <span class="fw-bold text-primary font-monospace" id="modalFollowUpId"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-6">
                        <label class="text-muted small mb-1">Bệnh nhân</label>
                        <div class="fw-bold text-dark" id="modalPatientName"></div>
                        <div class="text-muted small" id="modalPatientCode"></div>
                    </div>
                    <div class="col-6">
                        <label class="text-muted small mb-1">Số điện thoại liên hệ</label>
                        <div id="modalPhoneContainer"></div>
                    </div>
                    <div class="col-6">
                        <label class="text-muted small mb-1">Bác sĩ phụ trách</label>
                        <div class="fw-semibold text-dark" id="modalDentistName"></div>
                    </div>
                    <div class="col-6">
                        <label class="text-muted small mb-1">Chuyên khoa</label>
                        <div class="text-dark" id="modalDepartmentName"></div>
                    </div>
                    <div class="col-6">
                        <label class="text-muted small mb-1">Ngày hẹn tái khám</label>
                        <div class="fw-bold text-primary" id="modalDate"></div>
                    </div>
                    <div class="col-6">
                        <label class="text-muted small mb-1">Trạng thái</label>
                        <div id="modalStatus"></div>
                    </div>
                </div>

                <div class="mb-2">
                    <label class="text-muted small mb-1">Nội dung / Dặn dò của bác sĩ</label>
                    <div class="p-3 bg-light rounded text-dark small" id="modalReason" style="white-space: pre-wrap;"></div>
                </div>

                <div class="alert alert-info d-flex align-items-center gap-2 mt-3 mb-0 py-2 small">
                    <i class="bi bi-info-circle-fill fs-5"></i>
                    <div>
                        Lễ tân liên hệ bệnh nhân qua số điện thoại để xác nhận sự có mặt hoặc tư vấn đăng ký giờ khám phù hợp.
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Đóng</button>
                <a href="#" id="modalCallBtn" class="btn btn-success btn-sm">
                    <i class="bi bi-telephone-outbound me-1"></i> Gọi ngay
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showDetailModal(id, patientName, patientCode, phone, date, dentistName, deptName, reason, status) {
            document.getElementById('modalFollowUpId').textContent = '#' + id;
            document.getElementById('modalPatientName').textContent = patientName;
            document.getElementById('modalPatientCode').textContent = patientCode ? 'Mã: ' + patientCode : '';
            
            var phoneContainer = document.getElementById('modalPhoneContainer');
            var callBtn = document.getElementById('modalCallBtn');
            if (phone && phone !== 'null' && phone !== '') {
                phoneContainer.innerHTML = '<a href="tel:' + phone + '" class="fw-bold text-success text-decoration-none"><i class="bi bi-telephone-fill me-1"></i>' + phone + '</a>';
                callBtn.href = 'tel:' + phone;
                callBtn.style.display = 'inline-block';
            } else {
                phoneContainer.innerHTML = '<span class="text-muted small italic">Chưa có số điện thoại</span>';
                callBtn.style.display = 'none';
            }

            document.getElementById('modalDentistName').textContent = 'BS. ' + dentistName;
            document.getElementById('modalDepartmentName').textContent = deptName;
            document.getElementById('modalDate').textContent = date;
            
            var statusEl = document.getElementById('modalStatus');
            if (status === 'Pending') {
                statusEl.innerHTML = '<span class="badge bg-warning text-dark">Chờ tái khám</span>';
            } else if (status === 'Completed') {
                statusEl.innerHTML = '<span class="badge bg-success">Đã tái khám</span>';
            } else if (status === 'Cancelled') {
                statusEl.innerHTML = '<span class="badge bg-secondary">Đã hủy</span>';
            } else {
                statusEl.innerHTML = '<span class="badge bg-light text-dark border">' + status + '</span>';
            }

            document.getElementById('modalReason').textContent = reason;

            var modal = new bootstrap.Modal(document.getElementById('followUpDetailModal'));
            modal.show();
        }
    </script>
}
