@model List<DentalClinic.Web.Models.ApiDtos.InvoiceDto>
@{
    ViewData["Title"] = "Quản lý Hóa Đơn & Thu Viện Phí";
    var billableAppointments = ViewBag.BillableAppointments as List<DentalClinic.Web.Models.ApiDtos.CompletedAppointmentForBillingDto> ?? new();
    var currentStatus = ViewBag.CurrentStatus as string;
    var searchTerm = ViewBag.SearchTerm as string;
    var fromDate = ViewBag.FromDate as string;
    var toDate = ViewBag.ToDate as string;

    var totalInvoices = Model.Count;
    var unpaidCount = Model.Count(i => i.Status == "Unpaid");
    var partialCount = Model.Count(i => i.Status == "PartiallyPaid");
    var paidCount = Model.Count(i => i.Status == "Paid");
    var totalRevenue = Model.Sum(i => i.PaidAmount);
}

<div class="container-fluid px-0">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-receipt-cutoff text-primary me-2"></i>Quản Lý Hóa Đơn & Thanh Toán
            </h1>
            <p class="text-muted mb-0">Quầy Thu Ngân & Lễ Tân &bull; Lập hóa đơn ca khám, thu tiền viện phí và in biên lai</p>
        </div>
        <div class="d-flex gap-2">
            <a href="#billableSection" class="btn btn-outline-primary shadow-sm">
                <i class="bi bi-clock-history me-1"></i> Ca khám chờ lập hóa đơn (@billableAppointments.Count(a => !a.HasInvoice))
            </a>
        </div>
    </div>

    <!-- Alert Messages -->
    <partial name="_AlertMessage" />

    <!-- KPI Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 border-start border-4 border-primary">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Tổng Hóa Đơn</span>
                            <h3 class="fw-bold mb-0 mt-1">@totalInvoices</h3>
                        </div>
                        <div class="rounded-circle bg-primary bg-opacity-10 p-3 text-primary">
                            <i class="bi bi-receipt fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 border-start border-4 border-danger">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Chưa Thanh Toán</span>
                            <h3 class="fw-bold text-danger mb-0 mt-1">@unpaidCount</h3>
                        </div>
                        <div class="rounded-circle bg-danger bg-opacity-10 p-3 text-danger">
                            <i class="bi bi-exclamation-circle fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 border-start border-4 border-warning">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Đặt Cọc / Trả Một Phần</span>
                            <h3 class="fw-bold text-warning mb-0 mt-1">@partialCount</h3>
                        </div>
                        <div class="rounded-circle bg-warning bg-opacity-10 p-3 text-warning">
                            <i class="bi bi-pie-chart fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 border-start border-4 border-success">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold">Đã Thu Viện Phí</span>
                            <h3 class="fw-bold text-success mb-0 mt-1">@totalRevenue.ToString("N0") đ</h3>
                        </div>
                        <div class="rounded-circle bg-success bg-opacity-10 p-3 text-success">
                            <i class="bi bi-cash-stack fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Navigation Tabs -->
    <ul class="nav nav-pills mb-4 gap-2" id="billingTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active px-4 py-2 fw-semibold" id="invoices-tab" data-bs-toggle="pill" data-bs-target="#invoicesPanel" type="button" role="tab">
                <i class="bi bi-journal-text me-1"></i> Danh Sách Hóa Đơn (@Model.Count)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link px-4 py-2 fw-semibold" id="billable-tab" data-bs-toggle="pill" data-bs-target="#billablePanel" type="button" role="tab">
                <i class="bi bi-clock-history me-1"></i> Ca Khám Chờ Lập Hóa Đơn (@billableAppointments.Count(a => !a.HasInvoice))
            </button>
        </li>
    </ul>

    <div class="tab-content" id="billingTabContent">
        <!-- TAB 1: INVOICES LIST -->
        <div class="tab-pane fade show active" id="invoicesPanel" role="tabpanel">
            <!-- Filter Bar -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-3">
                    <form method="get" asp-action="Index" class="row g-2 align-items-end">
                        <div class="col-12 col-md-3">
                            <label class="form-label small text-muted mb-1">Tìm kiếm</label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                                <input type="text" name="search" value="@searchTerm" class="form-control" placeholder="Mã HĐ, BN, SĐT, Mã hẹn..." />
                            </div>
                        </div>

                        <div class="col-12 col-md-2">
                            <label class="form-label small text-muted mb-1">Trạng thái thanh toán</label>
                            <select name="status" class="form-select form-select-sm">
                                <option value="">-- Tất cả trạng thái --</option>
                                <option value="Unpaid" selected="@(currentStatus == "Unpaid")">Chưa thanh toán</option>
                                <option value="PartiallyPaid" selected="@(currentStatus == "PartiallyPaid")">Đã đặt cọc một phần</option>
                                <option value="Paid" selected="@(currentStatus == "Paid")">Đã thanh toán đủ</option>
                                <option value="Cancelled" selected="@(currentStatus == "Cancelled")">Đã hủy</option>
                            </select>
                        </div>

                        <div class="col-6 col-md-2">
                            <label class="form-label small text-muted mb-1">Từ ngày</label>
                            <input type="date" name="fromDate" value="@fromDate" class="form-control form-control-sm" />
                        </div>

                        <div class="col-6 col-md-2">
                            <label class="form-label small text-muted mb-1">Đến ngày</label>
                            <input type="date" name="toDate" value="@toDate" class="form-control form-control-sm" />
                        </div>

                        <div class="col-12 col-md-3 d-flex gap-2">
                            <button type="submit" class="btn btn-primary btn-sm px-3 flex-grow-1">
                                <i class="bi bi-funnel me-1"></i> Lọc
                            </button>
                            <a asp-action="Index" class="btn btn-light btn-sm px-3 border">
                                <i class="bi bi-arrow-counterclockwise me-1"></i> Đặt lại
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Invoices Table -->
            @if (Model.Count == 0)
            {
                <div class="card border-0 shadow-sm text-center py-5">
                    <div class="card-body">
                        <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px;">
                            <i class="bi bi-receipt fs-2 text-muted"></i>
                        </div>
                        <h5 class="fw-bold text-dark">Chưa có hóa đơn nào</h5>
                        <p class="text-muted mb-0">Không có hóa đơn viện phí phù hợp với bộ lọc hiện tại.</p>
                    </div>
                </div>
            }
            else
            {
                <div class="card border-0 shadow-sm">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Mã Hóa Đơn</th>
                                    <th>Bệnh Nhân</th>
                                    <th>Ca Khám & Bác Sĩ</th>
                                    <th>Tổng Tiền</th>
                                    <th>Đã Thanh Toán</th>
                                    <th>Còn Lại</th>
                                    <th>Trạng Thái</th>
                                    <th>Ngày Tạo</th>
                                    <th class="text-end pe-3">Thao Tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var inv in Model)
                                {
                                    <tr>
                                        <td class="ps-3">
                                            <a asp-action="Detail" asp-route-id="@inv.InvoiceId" class="fw-bold text-primary font-monospace text-decoration-none">
                                                @inv.InvoiceCode
                                            </a>
                                            <div class="text-muted small">Thu ngân: @(inv.GeneratedByName ?? "Lễ tân")</div>
                                        </td>
                                        <td>
                                            <div class="fw-semibold text-dark">@inv.PatientName</div>
                                            <div class="text-muted small">
                                                <i class="bi bi-telephone me-1"></i>@(inv.PatientPhoneNumber ?? "Chưa có")
                                                @if (!string.IsNullOrEmpty(inv.PatientCode))
                                                {
                                                    <span> &bull; @inv.PatientCode</span>
                                                }
                                            </div>
                                        </td>
                                        <td>
                                            <div class="fw-semibold">@inv.DepartmentName</div>
                                            <div class="text-muted small">
                                                <i class="bi bi-person me-1"></i>@(inv.DentistName ?? "Chưa phân bổ")
                                                @if (!string.IsNullOrEmpty(inv.AppointmentCode))
                                                {
                                                    <span> &bull; <span class="badge bg-light text-dark font-monospace">@inv.AppointmentCode</span></span>
                                                }
                                            </div>
                                        </td>
                                        <td>
                                            <span class="fw-bold text-dark fs-6">@inv.TotalAmount.ToString("N0") đ</span>
                                            @if (inv.DiscountAmount > 0)
                                            {
                                                <div class="text-danger small"><i class="bi bi-tag-fill me-1"></i>Giảm @inv.DiscountAmount.ToString("N0") đ</div>
                                            }
                                        </td>
                                        <td>
                                            <span class="fw-semibold text-success">@inv.PaidAmount.ToString("N0") đ</span>
                                        </td>
                                        <td>
                                            @if (inv.RemainingAmount > 0)
                                            {
                                                <span class="fw-bold text-danger">@inv.RemainingAmount.ToString("N0") đ</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted small"><i class="bi bi-check-circle-fill text-success me-1"></i>Đã đủ</span>
                                            }
                                        </td>
                                        <td>
                                            @if (inv.Status == "Paid")
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2">
                                                    <i class="bi bi-check-circle me-1"></i>Đã thanh toán
                                                </span>
                                            }
                                            else if (inv.Status == "PartiallyPaid")
                                            {
                                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-3 py-2">
                                                    <i class="bi bi-hourglass-split me-1"></i>Đặt cọc một phần
                                                </span>
                                            }
                                            else if (inv.Status == "Unpaid")
                                            {
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2">
                                                    <i class="bi bi-clock me-1"></i>Chưa thanh toán
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary px-3 py-2">@inv.Status</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="text-muted small">@inv.CreatedAt.ToString("dd/MM/yyyy")</div>
                                            <div class="text-muted small">@inv.CreatedAt.ToString("HH:mm")</div>
                                        </td>
                                        <td class="text-end pe-3">
                                            <div class="btn-group btn-group-sm">
                                                <a asp-action="Detail" asp-route-id="@inv.InvoiceId" class="btn btn-outline-primary" title="Xem chi tiết & thu tiền">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                                <a asp-action="Print" asp-route-id="@inv.InvoiceId" target="_blank" class="btn btn-outline-secondary" title="In phiếu thu">
                                                    <i class="bi bi-printer"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>

        <!-- TAB 2: BILLABLE APPOINTMENTS WAITING FOR INVOICE -->
        <div class="tab-pane fade" id="billablePanel" role="tabpanel">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="card-title mb-0 fw-bold text-dark">
                            <i class="bi bi-clock-history text-primary me-2"></i>Ca Khám Đang / Đã Thực Hiện Cần Lập Hóa Đơn
                        </h5>
                        <p class="text-muted small mb-0 mt-1">Danh sách bệnh nhân đang khám hoặc hoàn thành ca khám chờ thu ngân kết toán viện phí</p>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Mã Hẹn</th>
                                <th>Bệnh Nhân</th>
                                <th>Chuyên Khoa</th>
                                <th>Bác Sĩ Phụ Trách</th>
                                <th>Thời Gian</th>
                                <th>Trạng Thái Ca Khám</th>
                                <th>Tình Trạng Hóa Đơn</th>
                                <th class="text-end pe-3">Hành Động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!billableAppointments.Any())
                            {
                                <tr>
                                    <td colspan="8" class="text-center py-4 text-muted">
                                        Không có ca khám nào đang chờ lập hóa đơn.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var appt in billableAppointments)
                                {
                                    <tr>
                                        <td class="ps-3">
                                            <span class="fw-bold font-monospace text-primary">@appt.AppointmentCode</span>
                                        </td>
                                        <td>
                                            <div class="fw-semibold">@appt.PatientName</div>
                                            <div class="text-muted small"><i class="bi bi-telephone me-1"></i>@(appt.PatientPhone ?? "--")</div>
                                        </td>
                                        <td>@appt.DepartmentName</td>
                                        <td><i class="bi bi-person me-1 text-muted"></i>@appt.DentistName</td>
                                        <td>
                                            <div class="small">@(appt.ScheduledStart?.ToString("dd/MM/yyyy HH:mm") ?? "--")</div>
                                        </td>
                                        <td>
                                            <span class="badge bg-info-subtle text-info border border-info-subtle px-2 py-1">@appt.Status</span>
                                        </td>
                                        <td>
                                            @if (appt.HasInvoice)
                                            {
                                                <span class="badge bg-success-subtle text-success">
                                                    <i class="bi bi-check me-1"></i>Đã lập (#@appt.InvoiceCode)
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning-subtle text-warning">
                                                    <i class="bi bi-exclamation-circle me-1"></i>Chưa lập hóa đơn
                                                </span>
                                            }
                                        </td>
                                        <td class="text-end pe-3">
                                            @if (appt.HasInvoice)
                                            {
                                                <a asp-action="Index" asp-route-search="@appt.InvoiceCode" class="btn btn-outline-primary btn-sm">
                                                    <i class="bi bi-receipt me-1"></i>Xem Hóa Đơn
                                                </a>
                                            }
                                            else
                                            {
                                                <a asp-action="Create" asp-route-appointmentId="@appt.AppointmentId" class="btn btn-primary btn-sm shadow-sm">
                                                    <i class="bi bi-plus-circle me-1"></i> Lập Hóa Đơn
                                                </a>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
