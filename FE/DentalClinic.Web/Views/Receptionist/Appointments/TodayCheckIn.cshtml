@model DentalClinic.Web.ViewModels.Appointments.ReceptionistTodayCheckInViewModel
@{
    ViewData["Title"] = "Thủ tục Check-in Bệnh nhân Hôm nay";
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-person-lines-fill text-primary me-2"></i>Bàn Tiếp Đón & Quản Lý Ca Khám Hôm Nay
            </h1>
            <p class="text-muted mb-0">Ngày: <strong class="text-primary">@DateTime.Today.ToString("dd/MM/yyyy")</strong> &bull; Theo dõi tiến trình ca khám: Chưa check-in, Đã check-in, Đang khám và Chờ thu phí</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="ReceptionistBilling" asp-action="Index" asp-route-tab="billable" class="btn btn-outline-success fw-semibold shadow-sm">
                <i class="bi bi-receipt-cutoff me-1"></i> Thu Viện Phí & Hóa Đơn
            </a>
            <a asp-action="Requests" class="btn btn-outline-secondary">
                <i class="bi bi-inbox me-1"></i> Yêu cầu mới chờ duyệt
            </a>
        </div>
    </div>

    @{
        var allAppts = Model.ConfirmedAppointments;
        var totalCount = allAppts.Count;
        var unCheckInCount = allAppts.Count(a => a.Status == "Confirmed");
        var checkedInCount = allAppts.Count(a => a.Status == "CheckedIn" || a.Status == "Waiting");
        var inServiceCount = allAppts.Count(a => a.Status == "InService");
        var completedCount = allAppts.Count(a => a.Status == "Completed");
        var noShowCount = allAppts.Count(a => a.Status == "NoShow");
    }

    <!-- 4 Operational KPI Stat Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 border-start border-4 border-info h-100 kpi-card" style="cursor: pointer;" onclick="filterTableByStatus('Confirmed')">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small text-uppercase fw-semibold">Chưa Check-in</div>
                        <h3 class="fw-bold text-info mb-0 mt-1">@unCheckInCount</h3>
                        <div class="text-muted small mt-1"><i class="bi bi-clock"></i> Chờ bệnh nhân đến</div>
                    </div>
                    <div class="rounded-circle bg-info bg-opacity-10 p-3 text-info">
                        <i class="bi bi-hourglass fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 border-start border-4 border-success h-100 kpi-card" style="cursor: pointer;" onclick="filterTableByStatus('CheckedIn')">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small text-uppercase fw-semibold">Đã Check-in</div>
                        <h3 class="fw-bold text-success mb-0 mt-1">@checkedInCount</h3>
                        <div class="text-muted small mt-1"><i class="bi bi-check2-circle"></i> Đang chờ vào ghế</div>
                    </div>
                    <div class="rounded-circle bg-success bg-opacity-10 p-3 text-success">
                        <i class="bi bi-person-check fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 border-start border-4 border-primary h-100 kpi-card" style="cursor: pointer;" onclick="filterTableByStatus('InService')">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small text-uppercase fw-semibold">Đang Khám Tại Ghế</div>
                        <h3 class="fw-bold text-primary mb-0 mt-1">@inServiceCount</h3>
                        <div class="text-muted small mt-1"><i class="bi bi-heart-pulse"></i> Bác sĩ đang điều trị</div>
                    </div>
                    <div class="rounded-circle bg-primary bg-opacity-10 p-3 text-primary">
                        <i class="bi bi-activity fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 border-start border-4 border-warning h-100 kpi-card" style="cursor: pointer;" onclick="filterTableByStatus('Completed')">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small text-uppercase fw-semibold">Khám Xong (Chờ Thu Phí)</div>
                        <h3 class="fw-bold text-warning mb-0 mt-1">@completedCount</h3>
                        <div class="text-muted small mt-1"><i class="bi bi-receipt"></i> Cần xuất hóa đơn</div>
                    </div>
                    <div class="rounded-circle bg-warning bg-opacity-10 p-3 text-warning">
                        <i class="bi bi-receipt-cutoff fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Search Form -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <form asp-action="TodayCheckIn" method="get" class="row g-2 align-items-center">
                <div class="col-md-9">
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="search" value="@Model.SearchQuery" class="form-control form-control-lg" placeholder="Tìm theo Mã hẹn, Mã bệnh nhân, Họ tên hoặc Số điện thoại..." />
                    </div>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-lg flex-grow-1">
                        Tìm kiếm
                    </button>
                    @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
                    {
                        <a asp-action="TodayCheckIn" class="btn btn-light btn-lg">
                            <i class="bi bi-x-lg"></i>
                        </a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Quick Status Filter Pills -->
    <div class="d-flex flex-wrap gap-2 mb-3 align-items-center">
        <span class="text-muted small fw-semibold me-1"><i class="bi bi-funnel me-1"></i>Lọc trạng thái:</span>
        <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1 fw-semibold filter-pill active" data-filter="all" onclick="filterTableByStatus('all')">
            Tất Cả (@totalCount)
        </button>
        <button type="button" class="btn btn-sm btn-outline-info rounded-pill px-3 py-1 fw-semibold filter-pill" data-filter="Confirmed" onclick="filterTableByStatus('Confirmed')">
            <i class="bi bi-clock me-1"></i>Chưa Check-in (@unCheckInCount)
        </button>
        <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-3 py-1 fw-semibold filter-pill" data-filter="CheckedIn" onclick="filterTableByStatus('CheckedIn')">
            <i class="bi bi-person-check me-1"></i>Đã Check-in (@checkedInCount)
        </button>
        <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1 fw-semibold filter-pill" data-filter="InService" onclick="filterTableByStatus('InService')">
            <i class="bi bi-heart-pulse-fill me-1"></i>Đang Khám Tại Ghế (@inServiceCount)
        </button>
        <button type="button" class="btn btn-sm btn-outline-warning text-dark rounded-pill px-3 py-1 fw-semibold filter-pill" data-filter="Completed" onclick="filterTableByStatus('Completed')">
            <i class="bi bi-check-circle-fill me-1"></i>Khám Xong (Chờ Thu Phí) (@completedCount)
        </button>
        @if (noShowCount > 0)
        {
            <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 py-1 fw-semibold filter-pill" data-filter="NoShow" onclick="filterTableByStatus('NoShow')">
                <i class="bi bi-person-x me-1"></i>Vắng Mặt (@noShowCount)
            </button>
        }
    </div>

    @if (Model.ConfirmedAppointments.Count == 0)
    {
        <div class="card border-0 shadow-sm text-center py-5">
            <div class="card-body">
                <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px;">
                    <i class="bi bi-calendar-check fs-2 text-muted"></i>
                </div>
                <h5 class="fw-bold text-dark">Chưa có lịch khám nào cho ngày hôm nay</h5>
                <p class="text-muted mb-0">Không tìm thấy bệnh nhân nào có lịch khám đã xác nhận trong ngày hôm nay.</p>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0 fw-bold text-dark">
                    <i class="bi bi-list-check me-2 text-primary"></i>Danh Sách Ca Khám Trong Ngày (@Model.ConfirmedAppointments.Count lượt khám)
                </h5>
                <span class="badge bg-light text-muted border px-2 py-1 small">
                    <i class="bi bi-arrow-repeat me-1"></i>Tự động phân nhóm trạng thái
                </span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="todayAppointmentsTable">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3 text-center" style="width: 90px;">STT</th>
                            <th>Mã Hẹn</th>
                            <th>Bệnh Nhân</th>
                            <th>Dịch Vụ & Khoa</th>
                            <th>Khung Giờ</th>
                            <th>Bác Sĩ & Ghế</th>
                            <th>Tiến Trình Ca Khám</th>
                            <th class="text-end pe-3">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr id="noFilterResultsRow" style="display: none;">
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 text-muted d-block mb-2"></i>
                                <span class="fw-semibold">Không tìm thấy ca khám nào thuộc phân loại trạng thái này.</span>
                            </td>
                        </tr>
                        @foreach (var appt in Model.ConfirmedAppointments)
                        {
                            <tr class="appointment-row" data-status="@appt.Status">
                                <td class="ps-3 text-center">
                                    @if (!string.IsNullOrEmpty(appt.QueueNumber))
                                    {
                                        <div class="badge bg-primary fs-5 px-3 py-2 font-monospace shadow-sm">
                                            @appt.QueueNumber
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">--</span>
                                    }
                                </td>
                                <td>
                                    <span class="fw-bold font-monospace text-dark">@appt.AppointmentCode</span>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@appt.PatientName</div>
                                    <div class="text-muted small">Mã: @appt.PatientCode &bull; SĐT: <strong>@(appt.PatientPhone ?? "N/A")</strong></div>
                                </td>
                                <td>
                                    <div class="fw-semibold">@appt.ServiceName</div>
                                    <div class="text-muted small"><i class="bi bi-building me-1"></i>@appt.DepartmentName</div>
                                </td>
                                <td>
                                    <div class="fw-bold text-success fs-6">
                                        @(appt.ScheduledStart?.ToString("HH:mm") ?? "--") - @(appt.ScheduledEnd?.ToString("HH:mm") ?? "--")
                                    </div>
                                    <div class="text-muted small">Thời lượng: @(appt.DurationMinutes ?? 30) phút</div>
                                </td>
                                <td>
                                    <div class="fw-semibold text-primary"><i class="bi bi-person me-1"></i>@(appt.AssignedDentistName ?? "Chưa phân bổ")</div>
                                    <div class="text-muted small">
                                        <i class="bi bi-geo-alt me-1"></i>@(appt.RoomName ?? "--") &bull; Ghế @(appt.DentalChairName ?? "--")
                                    </div>
                                </td>
                                <td>
                                    @if (appt.Status == "CheckedIn")
                                    {
                                        <span class="badge bg-success px-3 py-2">
                                            <i class="bi bi-check-all me-1"></i>Đã Check-in
                                        </span>
                                        <div class="text-muted small mt-1">
                                            Lúc: @(appt.CheckedInAt?.ToString("HH:mm") ?? "--")
                                        </div>
                                    }
                                    else if (appt.Status == "Waiting")
                                    {
                                        <span class="badge bg-warning text-dark px-3 py-2">
                                            <i class="bi bi-hourglass-split me-1"></i>Đang chờ vào khám
                                        </span>
                                    }
                                    else if (appt.Status == "InService")
                                    {
                                        <span class="badge bg-primary px-3 py-2">
                                            <i class="bi bi-heart-pulse-fill me-1"></i>Đang điều trị tại ghế
                                        </span>
                                    }
                                    else if (appt.Status == "Completed")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success px-3 py-2 fw-bold">
                                            <i class="bi bi-check-circle-fill me-1"></i>Khám xong - Chờ thu phí
                                        </span>
                                    }
                                    else if (appt.Status == "NoShow")
                                    {
                                        <span class="badge bg-danger px-3 py-2">
                                            <i class="bi bi-person-x me-1"></i>Vắng mặt (No-Show)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info text-dark px-3 py-2">
                                            <i class="bi bi-clock me-1"></i>Chờ đến phòng khám
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    @if (appt.Status == "Confirmed")
                                    {
                                        <div class="d-flex gap-2 justify-content-end">
                                            <button type="button" class="btn btn-success btn-sm px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#checkInModal-@appt.AppointmentId">
                                                <i class="bi bi-person-check-fill me-1"></i> Check-in
                                            </button>
                                            <button type="button" class="btn btn-outline-warning text-dark btn-sm px-2 shadow-sm" data-bs-toggle="modal" data-bs-target="#cancelModal-@appt.AppointmentId" title="Hủy lịch hẹn (0 gậy phạt)">
                                                <i class="bi bi-x-circle me-1"></i> Hủy Hẹn
                                            </button>
                                            <button type="button" class="btn btn-outline-danger btn-sm px-2 shadow-sm" data-bs-toggle="modal" data-bs-target="#noShowModal-@appt.AppointmentId" title="Đánh dấu bệnh nhân vắng mặt">
                                                <i class="bi bi-person-x me-1"></i> Vắng mặt
                                            </button>
                                        </div>

                                        <!-- CheckIn Modal -->
                                        <div class="modal fade text-start" id="checkInModal-@appt.AppointmentId" tabindex="-1">
                                            <div class="modal-dialog">
                                                <form asp-action="CheckIn" asp-route-id="@appt.AppointmentId" method="post" class="modal-content">
                                                    @Html.AntiForgeryToken()
                                                    <div class="modal-header">
                                                        <h5 class="modal-title">Xác Nhận Check-in Bệnh Nhân</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        <div class="p-3 bg-light rounded mb-3">
                                                            <div class="d-flex justify-content-between mb-2">
                                                                <span class="text-muted">Số thứ tự:</span>
                                                                <span class="fw-bold fs-5 text-primary">@appt.QueueNumber</span>
                                                            </div>
                                                            <div class="d-flex justify-content-between mb-2">
                                                                <span class="text-muted">Bệnh nhân:</span>
                                                                <span class="fw-bold">@appt.PatientName (@appt.PatientCode)</span>
                                                            </div>
                                                            <div class="d-flex justify-content-between mb-2">
                                                                <span class="text-muted">Dịch vụ:</span>
                                                                <span>@appt.ServiceName</span>
                                                            </div>
                                                            <div class="d-flex justify-content-between">
                                                                <span class="text-muted">Bác sĩ & Phòng:</span>
                                                                <span class="fw-semibold">@appt.AssignedDentistName &bull; @appt.RoomName</span>
                                                            </div>
                                                        </div>
                                                        <div class="mb-3">
                                                            <label class="form-label">Ghi chú tiếp đón:</label>
                                                            <input type="text" name="note" class="form-control" placeholder="Bệnh nhân đã đến sảnh, sẵn sàng vào phòng khám..." />
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                                                        <button type="submit" class="btn btn-success fw-bold">Hoàn Tất Check-In</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>

                                        <!-- Cancel Modal -->
                                        <div class="modal fade text-start" id="cancelModal-@appt.AppointmentId" tabindex="-1">
                                            <div class="modal-dialog">
                                                <form asp-action="Cancel" asp-route-id="@appt.AppointmentId" method="post" class="modal-content">
                                                    @Html.AntiForgeryToken()
                                                    <div class="modal-header bg-warning text-dark">
                                                        <h5 class="modal-title"><i class="bi bi-x-circle me-2"></i>Hủy Lịch Hẹn (Lễ Tân / Phòng Khám)</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        <div class="p-3 bg-light rounded mb-3">
                                                            <div class="d-flex justify-content-between mb-2">
                                                                <span class="text-muted">Mã lịch hẹn:</span>
                                                                <span class="fw-bold font-monospace">@appt.AppointmentCode</span>
                                                            </div>
                                                            <div class="d-flex justify-content-between mb-2">
                                                                <span class="text-muted">Bệnh nhân:</span>
                                                                <span class="fw-bold">@appt.PatientName (@appt.PatientCode)</span>
                                                            </div>
                                                            <div class="d-flex justify-content-between mb-2">
                                                                <span class="text-muted">Khung giờ:</span>
                                                                <span class="fw-semibold text-primary">@(appt.ScheduledStart?.ToString("HH:mm") ?? "--") - @(appt.ScheduledEnd?.ToString("HH:mm") ?? "--")</span>
                                                            </div>
                                                            <div class="d-flex justify-content-between">
                                                                <span class="text-muted">Bác sĩ:</span>
                                                                <span class="fw-semibold">@(appt.AssignedDentistName ?? "Chưa phân bổ")</span>
                                                            </div>
                                                        </div>
                                                        <div class="alert alert-info border-info small mb-3">
                                                            <i class="bi bi-shield-check me-1 text-primary"></i>
                                                            <strong>Chính sách công bằng:</strong> Khi Lễ tân hỗ trợ hủy lịch hẹn do bệnh nhân gọi điện xin hủy trước hoặc do phòng khám điều chỉnh, bệnh nhân <strong>KHÔNG</strong> bị tính điểm phạt gậy vi phạm.
                                                        </div>
                                                        <div class="mb-3">
                                                            <label class="form-label fw-semibold">Lý do hủy hẹn <span class="text-danger">*</span>:</label>
                                                            <select class="form-select mb-2" onchange="document.getElementById('customReason-@appt.AppointmentId').value = this.value">
                                                                <option value="">-- Chọn lý do thường gặp --</option>
                                                                <option value="Bệnh nhân gọi điện báo bận đột xuất, xin hủy hẹn">Bệnh nhân gọi điện báo bận đột xuất, xin hủy hẹn</option>
                                                                <option value="Bệnh nhân xin dời lịch sang ngày khác">Bệnh nhân xin dời lịch sang ngày khác</option>
                                                                <option value="Bác sĩ có lịch cấp cứu / phẫu thuật đột xuất">Bác sĩ có lịch cấp cứu / phẫu thuật đột xuất</option>
                                                                <option value="Phòng khám bảo trì trang thiết bị chuyên khoa">Phòng khám bảo trì trang thiết bị chuyên khoa</option>
                                                                <option value="Bệnh nhân có triệu chứng không phù hợp điều trị hôm nay">Bệnh nhân có triệu chứng không phù hợp điều trị hôm nay</option>
                                                            </select>
                                                            <textarea id="customReason-@appt.AppointmentId" name="reason" class="form-control" rows="2" required placeholder="Hoặc nhập chi tiết lý do hủy lịch tại đây..."></textarea>
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                                                        <button type="submit" class="btn btn-warning fw-bold text-dark">Xác Nhận Hủy Lịch</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>

                                        <!-- NoShow Modal -->
                                        <div class="modal fade text-start" id="noShowModal-@appt.AppointmentId" tabindex="-1">
                                            <div class="modal-dialog">
                                                <form asp-action="NoShow" asp-route-id="@appt.AppointmentId" method="post" class="modal-content">
                                                    @Html.AntiForgeryToken()
                                                    <div class="modal-header bg-danger text-white">
                                                        <h5 class="modal-title"><i class="bi bi-exclamation-triangle-fill me-2"></i>Đánh Dấu Vắng Mặt (No-Show)</h5>
                                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        <div class="p-3 bg-light rounded mb-3">
                                                            <div class="d-flex justify-content-between mb-2">
                                                                <span class="text-muted">Mã lịch hẹn:</span>
                                                                <span class="fw-bold font-monospace">@appt.AppointmentCode</span>
                                                            </div>
                                                            <div class="d-flex justify-content-between mb-2">
                                                                <span class="text-muted">Bệnh nhân:</span>
                                                                <span class="fw-bold">@appt.PatientName (@appt.PatientCode)</span>
                                                            </div>
                                                            <div class="d-flex justify-content-between mb-2">
                                                                <span class="text-muted">Khung giờ:</span>
                                                                <span class="fw-semibold text-primary">@(appt.ScheduledStart?.ToString("HH:mm") ?? "--") - @(appt.ScheduledEnd?.ToString("HH:mm") ?? "--")</span>
                                                            </div>
                                                            <div class="d-flex justify-content-between">
                                                                <span class="text-muted">Bác sĩ:</span>
                                                                <span class="fw-semibold">@(appt.AssignedDentistName ?? "Chưa phân bổ")</span>
                                                            </div>
                                                        </div>
                                                        <div class="alert alert-warning border-warning small mb-3">
                                                            <i class="bi bi-info-circle me-1"></i>
                                                            Đánh dấu <strong>Vắng mặt (No-Show)</strong> sẽ giải phóng chỗ của bác sĩ và tính <strong>1 gậy vi phạm</strong> cho tài khoản bệnh nhân theo chính sách phòng khám.
                                                        </div>
                                                        <div class="mb-3">
                                                            <label class="form-label">Lý do / Ghi chú vắng mặt:</label>
                                                            <input type="text" name="note" class="form-control" placeholder="Ví dụ: Gọi điện không nghe máy, quá giờ hẹn 30 phút..." />
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                                                        <button type="submit" class="btn btn-danger fw-bold">Xác Nhận Vắng Mặt</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    }
                                    else if (appt.Status == "NoShow")
                                    {
                                        <span class="text-danger small"><i class="bi bi-person-x me-1"></i>Đã báo vắng</span>
                                    }
                                    else if (appt.Status == "Waiting")
                                    {
                                        <div class="d-flex gap-2 justify-content-end">
                                            <button type="button" class="btn btn-outline-warning text-dark btn-sm px-2 shadow-sm" data-bs-toggle="modal" data-bs-target="#cancelModal-@appt.AppointmentId" title="Hủy lịch hẹn (0 gậy phạt)">
                                                <i class="bi bi-x-circle me-1"></i> Hủy Hẹn
                                            </button>
                                            <a asp-controller="ReceptionistBilling" asp-action="Create" asp-route-appointmentId="@appt.AppointmentId" class="btn btn-outline-primary btn-sm" title="Lập hóa đơn viện phí">
                                                <i class="bi bi-receipt me-1"></i>Viện phí
                                            </a>
                                        </div>

                                        <!-- Cancel Modal for Waiting -->
                                        <div class="modal fade text-start" id="cancelModal-@appt.AppointmentId" tabindex="-1">
                                            <div class="modal-dialog">
                                                <form asp-action="Cancel" asp-route-id="@appt.AppointmentId" method="post" class="modal-content">
                                                    @Html.AntiForgeryToken()
                                                    <div class="modal-header bg-warning text-dark">
                                                        <h5 class="modal-title"><i class="bi bi-x-circle me-2"></i>Hủy Lịch Hẹn Đang Chờ Khám</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        <p>Bệnh nhân <strong>@appt.PatientName</strong> đã check-in nhưng cần hủy hẹn và rời khỏi phòng khám.</p>
                                                        <div class="mb-3">
                                                            <label class="form-label fw-semibold">Lý do hủy hẹn <span class="text-danger">*</span>:</label>
                                                            <textarea name="reason" class="form-control" rows="2" required placeholder="Nhập lý do bệnh nhân hủy hẹn..."></textarea>
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                                                        <button type="submit" class="btn btn-warning fw-bold text-dark">Xác Nhận Hủy Lịch</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    }
                                    else if (appt.Status == "Completed")
                                    {
                                        <div class="d-flex justify-content-end gap-1">
                                            <a asp-controller="ReceptionistBilling" asp-action="Create" asp-route-appointmentId="@appt.AppointmentId" class="btn btn-success btn-sm shadow-sm fw-bold px-3 py-2 text-nowrap" title="Xuất hóa đơn viện phí và thu tiền">
                                                <i class="bi bi-receipt-cutoff me-1"></i> Xuất Hóa Đơn
                                            </a>
                                        </div>
                                    }
                                    else if (appt.Status == "InService")
                                    {
                                        <div class="d-flex justify-content-end gap-1">
                                            <span class="badge bg-light text-muted border px-3 py-2 small" title="Bác sĩ đang thực hiện ca khám tại ghế">
                                                <i class="bi bi-heart-pulse text-danger me-1"></i>Đang trên ghế khám
                                            </span>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="d-flex justify-content-end gap-1">
                                            <a asp-controller="ReceptionistBilling" asp-action="Create" asp-route-appointmentId="@appt.AppointmentId" class="btn btn-outline-primary btn-sm" title="Lập hóa đơn viện phí">
                                                <i class="bi bi-receipt me-1"></i>Viện phí
                                            </a>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@section Scripts {
<script>
function filterTableByStatus(status) {
    const rows = document.querySelectorAll('#todayAppointmentsTable tbody tr.appointment-row');
    const pills = document.querySelectorAll('.filter-pill');
    
    pills.forEach(p => {
        if (p.getAttribute('data-filter') === status) {
            p.classList.add('active');
            p.classList.remove('btn-outline-secondary', 'btn-outline-info', 'btn-outline-success', 'btn-outline-primary', 'btn-outline-warning', 'btn-outline-danger');
            if (status === 'Confirmed') p.classList.add('btn-info', 'text-white');
            else if (status === 'CheckedIn') p.classList.add('btn-success', 'text-white');
            else if (status === 'InService') p.classList.add('btn-primary', 'text-white');
            else if (status === 'Completed') p.classList.add('btn-warning', 'text-dark');
            else if (status === 'NoShow') p.classList.add('btn-danger', 'text-white');
            else p.classList.add('btn-secondary', 'text-white');
        } else {
            p.classList.remove('active', 'btn-info', 'btn-success', 'btn-primary', 'btn-warning', 'btn-danger', 'btn-secondary', 'text-white');
            const f = p.getAttribute('data-filter');
            if (f === 'Confirmed') p.classList.add('btn-outline-info');
            else if (f === 'CheckedIn') p.classList.add('btn-outline-success');
            else if (f === 'InService') p.classList.add('btn-outline-primary');
            else if (f === 'Completed') p.classList.add('btn-outline-warning', 'text-dark');
            else if (f === 'NoShow') p.classList.add('btn-outline-danger');
            else p.classList.add('btn-outline-secondary');
        }
    });

    let visibleCount = 0;
    rows.forEach(row => {
        const rowStatus = row.getAttribute('data-status');
        if (status === 'all') {
            row.style.display = '';
            visibleCount++;
        } else if (status === 'CheckedIn') {
            if (rowStatus === 'CheckedIn' || rowStatus === 'Waiting') {
                row.style.display = '';
                visibleCount++;
            } else {
                row.style.display = 'none';
            }
        } else if (rowStatus === status) {
            row.style.display = '';
            visibleCount++;
        } else {
            row.style.display = 'none';
        }
    });

    const noMatchRow = document.getElementById('noFilterResultsRow');
    if (noMatchRow) {
        noMatchRow.style.display = visibleCount === 0 ? '' : 'none';
    }
}

document.addEventListener('DOMContentLoaded', function() {
    const urlParams = new URLSearchParams(window.location.search);
    const initialStatus = urlParams.get('status') || '@(Model.StatusFilter ?? "")';
    if (initialStatus) {
        filterTableByStatus(initialStatus);
    }
});
</script>
}
