@model DentalClinic.Web.ViewModels.Treatment.DepartmentTreatmentProgressViewModel
@{
    ViewData["Title"] = "Giám Sát Tiến Độ Điều Trị Chuyên Khoa";
}

<div class="container-fluid px-0">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-graph-up me-2 text-primary"></i>Giám Sát Tiến Độ Điều Trị Chuyên Khoa
            </h1>
            <p class="text-muted mb-0">Theo dõi toàn diện các phác đồ điều trị, tiến độ từng giai đoạn và phân công bác sĩ trong khoa.</p>
        </div>
    </div>


    <!-- Stat KPI Cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-md-3">
            <div class="card border-0 shadow-sm border-start border-primary border-4 h-100">
                <div class="card-body">
                    <div class="text-muted small fw-semibold text-uppercase">Tổng số phác đồ khoa</div>
                    <div class="h3 fw-bold text-dark mb-0">@Model.Summary.TotalPlans</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-md-3">
            <div class="card border-0 shadow-sm border-start border-warning border-4 h-100">
                <div class="card-body">
                    <div class="text-muted small fw-semibold text-uppercase">Đang điều trị</div>
                    <div class="h3 fw-bold text-warning mb-0">@Model.Summary.ActivePlans</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-md-3">
            <div class="card border-0 shadow-sm border-start border-success border-4 h-100">
                <div class="card-body">
                    <div class="text-muted small fw-semibold text-uppercase">Đã hoàn thành</div>
                    <div class="h3 fw-bold text-success mb-0">@Model.Summary.CompletedPlans</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-md-3">
            <div class="card border-0 shadow-sm border-start border-info border-4 h-100">
                <div class="card-body">
                    <div class="text-muted small fw-semibold text-uppercase">Giai đoạn đang chờ/làm</div>
                    <div class="h3 fw-bold text-info mb-0">@Model.Summary.PendingPhases</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Search filter -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-2 align-items-center">
                <div class="col-12 col-md-8">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="search" value="@Model.SearchTerm" class="form-control border-start-0" 
                               placeholder="Tìm theo tên bệnh nhân, mã bệnh nhân, khoa..." />
                    </div>
                </div>
                <div class="col-12 col-md-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1">
                        <i class="bi bi-funnel me-1"></i>Lọc
                    </button>
                    @if (!string.IsNullOrEmpty(Model.SearchTerm))
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary">Đặt lại</a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Table of plans in department -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="card-title mb-0 fw-bold text-dark">
                <i class="bi bi-diagram-3 me-2 text-primary"></i>Danh Sách Phác Đồ Điều Trị Thuộc Chuyên Khoa
            </h5>
        </div>

        @if (Model.Summary.Plans == null || Model.Summary.Plans.Count == 0)
        {
            <div class="text-center py-5">
                <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px;">
                    <i class="bi bi-diagram-3 fs-2 text-muted"></i>
                </div>
                <h5 class="fw-bold text-dark">Chưa có phác đồ nào trong chuyên khoa</h5>
                <p class="text-muted mb-0">Hiện tại khoa chưa có phác đồ điều trị nào đang hoạt động.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3" style="width: 100px;">Mã KH</th>
                            <th>Bệnh Nhân</th>
                            <th>Chuyên Khoa</th>
                            <th>Bác Sĩ Khởi Tạo</th>
                            <th style="min-width: 180px;">Tiến Độ Điều Trị</th>
                            <th>Chi Phí Ước Tính</th>
                            <th>Trạng Thái</th>
                            <th class="text-end pe-3">Giám Sát</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var plan in Model.Summary.Plans)
                        {
                            <tr>
                                <td class="ps-3">
                                    <span class="badge bg-light text-dark border font-monospace fs-6">
                                        #@plan.TreatmentPlanId
                                    </span>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@plan.PatientName</div>
                                    <div class="text-muted small">
                                        Mã: <span class="badge bg-secondary bg-opacity-10 text-secondary">@plan.PatientCode</span>
                                        @if (!string.IsNullOrEmpty(plan.PatientPhone))
                                        {
                                            <span>&bull; SĐT: @plan.PatientPhone</span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-primary bg-opacity-10 text-primary px-2 py-1">
                                        @plan.DepartmentName
                                    </span>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@plan.CreatedByDentistName</div>
                                    <div class="text-muted small">Lập ngày: @plan.CreatedAt.ToString("dd/MM/yyyy")</div>
                                </td>
                                <td>
                                    <div class="d-flex justify-content-between align-items-center mb-1 small">
                                        <span class="fw-semibold text-muted">@plan.CompletedItemsCount / @plan.TotalItemsCount giai đoạn</span>
                                        <span class="fw-bold text-primary">@plan.ProgressPercentage%</span>
                                    </div>
                                    <div class="progress" style="height: 7px;">
                                        <div class="progress-bar @(plan.ProgressPercentage == 100 ? "bg-success" : "bg-primary")" 
                                             role="progressbar" style="width: @plan.ProgressPercentage%"></div>
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-bold text-success">
                                        @(plan.EstimatedTotal.HasValue ? plan.EstimatedTotal.Value.ToString("N0") + " ₫" : "0 ₫")
                                    </div>
                                </td>
                                <td>
                                    @switch (plan.Status)
                                    {
                                        case "Active":
                                            <span class="badge bg-warning text-dark px-3 py-2">
                                                <i class="bi bi-hourglass-split me-1"></i>Đang điều trị
                                            </span>
                                            break;
                                        case "Completed":
                                            <span class="badge bg-success px-3 py-2">
                                                <i class="bi bi-check-all me-1"></i>Hoàn thành
                                            </span>
                                            break;
                                        case "Draft":
                                            <span class="badge bg-secondary px-3 py-2">
                                                <i class="bi bi-pencil-square me-1"></i>Bản nháp
                                            </span>
                                            break;
                                        case "Cancelled":
                                            <span class="badge bg-danger px-3 py-2">
                                                <i class="bi bi-x-circle me-1"></i>Đã hủy
                                            </span>
                                            break;
                                        default:
                                            <span class="badge bg-light text-dark border px-3 py-2">@plan.Status</span>
                                            break;
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <a asp-action="Detail" asp-route-id="@plan.TreatmentPlanId" 
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-search me-1"></i>Xem Phác Đồ
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
