@model DentalClinic.Web.ViewModels.PostCare.DepartmentReferralsViewModel
@{
    ViewData["Title"] = "Hội Chẩn & Chuyển Khoa Chuyên Môn";
}

<div class="container-fluid p-0">
    <!-- Page Header -->
    <div class="page-header-dc mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge-dc badge-role-departmentmanager">Trưởng Khoa</span>
                <span class="badge bg-white text-muted border small">Hội Chẩn Liên Chuyên Khoa</span>
            </div>
            <h1 class="page-title">Tiếp Nhận & Điều Phối Chuyển Khoa</h1>
            <p class="page-subtitle">Xem xét các ca bệnh chuyển đến từ các khoa khác, phê duyệt và phân công bác sĩ điều trị tiếp nhận.</p>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2" role="alert">
            <i class="bi bi-check-circle-fill fs-5"></i>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
            <div>@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Stat Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-sm-4">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-medium">Chờ Xử Lý</div>
                        <div class="fs-3 fw-bold text-warning">@Model.PendingCount</div>
                    </div>
                    <div class="rounded-circle p-3 bg-warning-subtle text-warning">
                        <i class="bi bi-hourglass-split fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-medium">Đã Tiếp Nhận / Phân Công</div>
                        <div class="fs-3 fw-bold text-success">@Model.AcceptedCount</div>
                    </div>
                    <div class="rounded-circle p-3 bg-success-subtle text-success">
                        <i class="bi bi-person-check fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-medium">Đã Từ Chối</div>
                        <div class="fs-3 fw-bold text-danger">@Model.RejectedCount</div>
                    </div>
                    <div class="rounded-circle p-3 bg-danger-subtle text-danger">
                        <i class="bi bi-x-circle fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Tabs -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <div class="d-flex flex-wrap gap-2 align-items-center justify-content-between">
                <div class="btn-group" role="group">
                    <a asp-action="Index" class="btn btn-sm @(string.IsNullOrEmpty(Model.StatusFilter) ? "btn-primary" : "btn-outline-secondary")">
                        Tất cả (@Model.Referrals.Count)
                    </a>
                    <a asp-action="Index" asp-route-status="Pending" class="btn btn-sm @(Model.StatusFilter == "Pending" ? "btn-warning" : "btn-outline-secondary")">
                        Chờ duyệt (@Model.PendingCount)
                    </a>
                    <a asp-action="Index" asp-route-status="Accepted" class="btn btn-sm @(Model.StatusFilter == "Accepted" ? "btn-success" : "btn-outline-secondary")">
                        Đã tiếp nhận
                    </a>
                    <a asp-action="Index" asp-route-status="Assigned" class="btn btn-sm @(Model.StatusFilter == "Assigned" ? "btn-info text-white" : "btn-outline-secondary")">
                        Đã phân công bác sĩ
                    </a>
                    <a asp-action="Index" asp-route-status="Rejected" class="btn btn-sm @(Model.StatusFilter == "Rejected" ? "btn-danger" : "btn-outline-secondary")">
                        Đã từ chối (@Model.RejectedCount)
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Referrals Table -->
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Mã Phiếu</th>
                        <th>Bệnh Nhân</th>
                        <th>Khoa & Bác Sĩ Gửi</th>
                        <th>Mức Độ Ưu Tiên</th>
                        <th>Lý Do Hội Chẩn / Chuyển Khoa</th>
                        <th>Bác Sĩ Tiếp Nhận</th>
                        <th>Trạng Thái</th>
                        <th>Thời Gian Gửi</th>
                        <th class="text-end pe-3">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Referrals.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                Không có phiếu chuyển khoa nào theo tiêu chí lọc.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Referrals)
                        {
                            <tr>
                                <td class="ps-3 fw-bold text-primary">#REF-@item.ReferralId</td>
                                <td>
                                    <div class="fw-semibold">@item.PatientName</div>
                                    <div class="small text-muted">@item.PatientCode @(string.IsNullOrEmpty(item.PatientPhone) ? "" : $"• {item.PatientPhone}")</div>
                                </td>
                                <td>
                                    <span class="badge bg-secondary-subtle text-secondary mb-1">@item.FromDepartmentName</span>
                                    <div class="small text-dark"><i class="bi bi-person me-1"></i>@item.ReferringDentistName</div>
                                </td>
                                <td>
                                    @if (item.Urgency == "Urgent")
                                    {
                                        <span class="badge bg-danger text-white fw-bold shadow-sm">
                                            <i class="bi bi-exclamation-triangle-fill me-1"></i>Khẩn cấp
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border">Bình thường</span>
                                    }
                                </td>
                                <td style="max-width: 280px;">
                                    <div class="text-truncate-2 small" title="@item.Reason">@item.Reason</div>
                                    @if (!string.IsNullOrEmpty(item.ClinicalFindings))
                                    {
                                        <div class="text-muted small mt-1"><em>Lâm sàng: @item.ClinicalFindings</em></div>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.AssignedDentistName))
                                    {
                                        <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle">
                                            <i class="bi bi-person-check-fill me-1"></i>@item.AssignedDentistName
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small"><em>Chưa chỉ định</em></span>
                                    }
                                </td>
                                <td>
                                    @switch (item.Status)
                                    {
                                        case "Pending":
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">Chờ duyệt</span>
                                            break;
                                        case "Accepted":
                                            <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle">Đã tiếp nhận</span>
                                            break;
                                        case "Assigned":
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Đã phân công</span>
                                            break;
                                        case "Rejected":
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Đã từ chối</span>
                                            break;
                                        case "Completed":
                                            <span class="badge bg-dark-subtle text-dark border">Hoàn thành</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary">@item.Status</span>
                                            break;
                                    }
                                </td>
                                <td class="small text-muted">
                                    @item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                    @if (item.ReviewedAt.HasValue)
                                    {
                                        <div class="text-muted extra-small">Duyệt: @item.ReviewedAt.Value.ToLocalTime().ToString("dd/MM/yyyy")</div>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    @if (item.Status == "Pending")
                                    {
                                        <button type="button" class="btn btn-sm btn-primary"
                                                data-bs-toggle="modal"
                                                data-bs-target="#reviewModal"
                                                data-referral-id="@item.ReferralId"
                                                data-patient-name="@item.PatientName"
                                                data-from-dept="@item.FromDepartmentName"
                                                data-reason="@item.Reason">
                                            <i class="bi bi-shield-check me-1"></i>Duyệt ca
                                        </button>
                                    }
                                    else if (item.Status == "Accepted")
                                    {
                                        <button type="button" class="btn btn-sm btn-info text-white"
                                                data-bs-toggle="modal"
                                                data-bs-target="#reviewModal"
                                                data-referral-id="@item.ReferralId"
                                                data-patient-name="@item.PatientName"
                                                data-from-dept="@item.FromDepartmentName"
                                                data-reason="@item.Reason"
                                                data-force-assign="true">
                                            <i class="bi bi-person-plus me-1"></i>Phân công BS
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                                data-bs-toggle="modal"
                                                data-bs-target="#detailModal"
                                                data-referral-id="@item.ReferralId"
                                                data-patient-name="@item.PatientName"
                                                data-from-dept="@item.FromDepartmentName"
                                                data-assigned-dentist="@(item.AssignedDentistName ?? "Chưa phân công")"
                                                data-status="@item.Status"
                                                data-reason="@item.Reason"
                                                data-reviewer="@(item.ReviewedByName ?? "Trưởng khoa")">
                                            <i class="bi bi-eye me-1"></i>Chi tiết
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Duyệt / Phân Công -->
<div class="modal fade" id="reviewModal" tabindex="-1" aria-labelledby="reviewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form asp-action="Review" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="referralId" id="modalReferralId" value="0" />

                <div class="modal-header bg-light">
                    <h5 class="modal-title font-heading" id="reviewModalLabel">
                        <i class="bi bi-clipboard-check text-primary me-2"></i>Duyệt Phiếu Chuyển Khoa
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body p-4">
                    <div class="mb-3 p-3 bg-light rounded-3">
                        <div class="small text-muted">Bệnh nhân: <strong id="modalPatientName" class="text-dark"></strong></div>
                        <div class="small text-muted">Khoa chuyển đến: <strong id="modalFromDept" class="text-dark"></strong></div>
                        <div class="small text-muted mt-1">Lý do: <span id="modalReason" class="text-dark"></span></div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Hành động <span class="text-danger">*</span></label>
                        <select name="Action" id="modalAction" class="form-select" required onchange="toggleDentistSelection()">
                            <option value="Accept">Tiếp nhận (Không chỉ định bác sĩ ngay)</option>
                            <option value="Assign" selected>Tiếp nhận & Phân công bác sĩ trong khoa</option>
                            <option value="Reject">Từ chối tiếp nhận</option>
                        </select>
                    </div>

                    <div class="mb-3" id="dentistSelectionGroup">
                        <label class="form-label fw-semibold">Chỉ định Bác sĩ điều trị <span class="text-danger">*</span></label>
                        <select name="AssignedDentistUserId" id="modalAssignedDentist" class="form-select">
                            <option value="">-- Chọn bác sĩ thuộc khoa --</option>
                            @foreach (var d in Model.Dentists)
                            {
                                <option value="@d.DentistUserId">BS. @d.DentistName @(string.IsNullOrEmpty(d.Specialization) ? "" : $"({d.Specialization})")</option>
                            }
                        </select>
                        <div class="form-text small text-muted">Bác sĩ được chọn sẽ nhận được thông báo tiếp nhận ca điều trị này.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Ghi chú duyệt / Lý do</label>
                        <textarea name="ReviewNote" class="form-control" rows="3" placeholder="Nhập ghi chú hoặc lý do nếu từ chối..."></textarea>
                    </div>
                </div>

                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary px-4">Xác nhận</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Chi Tiết Phiếu Đã Xử Lý -->
<div class="modal fade" id="detailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light">
                <h5 class="modal-title font-heading">
                    <i class="bi bi-info-circle text-primary me-2"></i>Chi Tiết Phiếu Chuyển Khoa
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">Bệnh nhân:</dt>
                    <dd class="col-sm-8 fw-semibold" id="detailPatientName"></dd>

                    <dt class="col-sm-4 text-muted">Khoa gửi:</dt>
                    <dd class="col-sm-8" id="detailFromDept"></dd>

                    <dt class="col-sm-4 text-muted">Trạng thái:</dt>
                    <dd class="col-sm-8" id="detailStatus"></dd>

                    <dt class="col-sm-4 text-muted">Bác sĩ tiếp nhận:</dt>
                    <dd class="col-sm-8" id="detailAssignedDentist"></dd>

                    <dt class="col-sm-4 text-muted">Người duyệt:</dt>
                    <dd class="col-sm-8" id="detailReviewer"></dd>

                    <dt class="col-sm-4 text-muted">Nội dung phiếu:</dt>
                    <dd class="col-sm-8" id="detailReason"></dd>
                </dl>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleDentistSelection() {
            var action = document.getElementById('modalAction').value;
            var group = document.getElementById('dentistSelectionGroup');
            var select = document.getElementById('modalAssignedDentist');
            if (action === 'Assign') {
                group.style.display = 'block';
                select.required = true;
            } else if (action === 'Accept') {
                group.style.display = 'block';
                select.required = false;
            } else {
                group.style.display = 'none';
                select.required = false;
            }
        }

        var reviewModal = document.getElementById('reviewModal');
        if (reviewModal) {
            reviewModal.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                document.getElementById('modalReferralId').value = button.getAttribute('data-referral-id');
                document.getElementById('modalPatientName').textContent = button.getAttribute('data-patient-name');
                document.getElementById('modalFromDept').textContent = button.getAttribute('data-from-dept');
                document.getElementById('modalReason').textContent = button.getAttribute('data-reason');
                var forceAssign = button.getAttribute('data-force-assign');
                if (forceAssign === 'true') {
                    document.getElementById('modalAction').value = 'Assign';
                }
                toggleDentistSelection();
            });
        }

        var detailModal = document.getElementById('detailModal');
        if (detailModal) {
            detailModal.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                document.getElementById('detailPatientName').textContent = button.getAttribute('data-patient-name');
                document.getElementById('detailFromDept').textContent = button.getAttribute('data-from-dept');
                document.getElementById('detailStatus').textContent = button.getAttribute('data-status');
                document.getElementById('detailAssignedDentist').textContent = button.getAttribute('data-assigned-dentist');
                document.getElementById('detailReviewer').textContent = button.getAttribute('data-reviewer');
                document.getElementById('detailReason').textContent = button.getAttribute('data-reason');
            });
        }
    </script>
}
