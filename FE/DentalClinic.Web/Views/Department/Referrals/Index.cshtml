@model DentalClinic.Web.ViewModels.PostCare.DepartmentReferralIndexViewModel
@{
    ViewData["Title"] = "Xử Lý Ca Hội Chẩn & Chuyển Khoa";
}

<div class="container-fluid px-0">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-arrow-left-right me-2 text-primary"></i>Xử Lý Ca Hội Chẩn & Chuyển Khoa
            </h1>
            <p class="text-muted mb-0">Thẩm định yêu cầu chuyển khoa từ các chuyên khoa khác, tiếp nhận và phân công bác sĩ chuyên trách trong khoa @Model.DepartmentName.</p>
        </div>
    </div>

    <!-- Status Filter Buttons -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-2 d-flex flex-wrap gap-2 align-items-center">
            <span class="text-muted small fw-bold px-2 text-uppercase">Bộ lọc trạng thái:</span>
            <a asp-action="Index" asp-route-status="" class="btn btn-sm @(string.IsNullOrEmpty(Model.StatusFilter) ? "btn-primary" : "btn-outline-secondary")">
                Tất Cả (@Model.Referrals.Count)
            </a>
            <a asp-action="Index" asp-route-status="Pending" class="btn btn-sm @(Model.StatusFilter == "Pending" ? "btn-warning text-dark fw-bold" : "btn-outline-warning text-dark")">
                <i class="bi bi-clock me-1"></i>Chờ Tiếp Nhận
            </a>
            <a asp-action="Index" asp-route-status="Assigned" class="btn btn-sm @(Model.StatusFilter == "Assigned" ? "btn-success" : "btn-outline-success")">
                <i class="bi bi-person-check me-1"></i>Đã Phân Bác Sĩ
            </a>
            <a asp-action="Index" asp-route-status="Rejected" class="btn btn-sm @(Model.StatusFilter == "Rejected" ? "btn-danger" : "btn-outline-danger")">
                <i class="bi bi-x-circle me-1"></i>Đã Từ Chối
            </a>
        </div>
    </div>

    <!-- Table of Incoming Referrals -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3 border-bottom">
            <h5 class="card-title fw-bold mb-0 text-dark">
                <i class="bi bi-inbox me-2 text-primary"></i>Danh Sách Bệnh Nhân Chuyển Đến
            </h5>
        </div>
        <div class="card-body p-0">
            @if (Model.Referrals == null || Model.Referrals.Count == 0)
            {
                <div class="text-center py-5">
                    <i class="bi bi-check-circle display-4 text-muted mb-3 d-block"></i>
                    <h6 class="fw-bold text-muted">Hiện không có ca chuyển khoa nào cần xử lý</h6>
                    <p class="text-muted small">Khi các bác sĩ chuyên khoa khác gửi yêu cầu chuyển viện/chuyên khoa đến khoa của bạn, danh sách sẽ hiển thị ở đây.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Mã Phiếu</th>
                                <th>Bệnh Nhân</th>
                                <th>Chuyển Từ</th>
                                <th>Bác Sĩ Gửi</th>
                                <th>Lý Do Hội Chẩn / Lâm Sàng</th>
                                <th>Trạng Thái</th>
                                <th>Bác Sĩ Tiếp Nhận</th>
                                <th class="pe-4 text-end">Hành Động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model.Referrals)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-primary">#REF-@r.ReferralId</td>
                                    <td>
                                        <div class="fw-bold text-dark">@r.PatientName</div>
                                        <div class="small text-muted">@(r.PatientCode ?? "BN-" + r.PatientUserId)</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@r.FromDepartmentName</span>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark">@r.ReferringDentistName</div>
                                        <div class="small text-muted">@r.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                                    </td>
                                    <td style="max-width: 250px;">
                                        <div class="text-truncate" title="@r.Reason">@r.Reason</div>
                                    </td>
                                    <td>
                                        @if (r.Status == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i>Chờ tiếp nhận</span>
                                        }
                                        else if (r.Status == "Assigned" || r.Status == "Accepted")
                                        {
                                            <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Đã phân công</span>
                                        }
                                        else if (r.Status == "Rejected")
                                        {
                                            <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Từ chối</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@r.Status</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(r.AssignedDentistName))
                                        {
                                            <span class="text-success fw-semibold"><i class="bi bi-person-check me-1"></i>@r.AssignedDentistName</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">Chưa phân công</span>
                                        }
                                    </td>
                                    <td class="pe-4 text-end">
                                        @if (r.Status == "Pending")
                                        {
                                            <div class="d-inline-flex gap-1">
                                                <button type="button" class="btn btn-sm btn-success" data-bs-toggle="modal" data-bs-target="#reviewModal" 
                                                        data-referral-id="@r.ReferralId" data-patient-name="@r.PatientName" data-reason="@r.Reason">
                                                    <i class="bi bi-check-lg me-1"></i>Tiếp Nhận & Phân Bác Sĩ
                                                </button>
                                                <form method="post" asp-action="Review" asp-route-id="@r.ReferralId" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn từ chối ca chuyển khoa này không?');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="Status" value="Rejected" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Từ chối">
                                                        <i class="bi bi-x-lg"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small"><i class="bi bi-check2-all me-1"></i>Đã duyệt</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- MODAL DUYỆT & TIẾP NHẬN PHÂN BÁC SĨ -->
<div class="modal fade" id="reviewModal" tabindex="-1" aria-labelledby="reviewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form id="reviewForm" method="post" action="">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Status" value="Accepted" />
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title fw-bold" id="reviewModalLabel">
                        <i class="bi bi-person-check me-2"></i>Tiếp Nhận & Phân Bổ Bác Sĩ Chuyên Trách
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold text-uppercase">Bệnh nhân:</label>
                        <div id="modalPatientName" class="fw-bold text-dark fs-5"></div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold text-uppercase">Lý do chuyển khoa:</label>
                        <div id="modalReason" class="p-3 bg-light rounded text-dark small border"></div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Chỉ định bác sĩ trong khoa <span class="text-danger">*</span></label>
                        <select name="AssignedDentistUserId" class="form-select" required>
                            <option value="">-- Chọn bác sĩ điều trị chuyên trách --</option>
                            @foreach (var d in Model.Dentists)
                            {
                                <option value="@d.DentistUserId">@d.FullName @(string.IsNullOrEmpty(d.Specialization) ? "" : $"({d.Specialization})")</option>
                            }
                        </select>
                        <div class="form-text">Bác sĩ được phân công sẽ nhận thông báo và có quyền tiếp nhận phác đồ điều trị của bệnh nhân.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Ghi chú duyệt</label>
                        <textarea name="ReviewNote" class="form-control" rows="2" placeholder="Ghi chú phân bổ của Trưởng khoa (tùy chọn)"></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-success fw-semibold">
                        <i class="bi bi-check2-circle me-1"></i>Xác Nhận Tiếp Nhận & Phân Bác Sĩ
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const reviewModal = document.getElementById('reviewModal');
            if (reviewModal) {
                reviewModal.addEventListener('show.bs.modal', function (event) {
                    const button = event.relatedTarget;
                    const referralId = button.getAttribute('data-referral-id');
                    const patientName = button.getAttribute('data-patient-name');
                    const reason = button.getAttribute('data-reason');

                    document.getElementById('modalPatientName').textContent = patientName;
                    document.getElementById('modalReason').textContent = reason;
                    document.getElementById('reviewForm').action = '/Department/Referrals/Review/' + referralId;
                });
            }
        });
    </script>
}
