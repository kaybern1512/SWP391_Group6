@model DentalClinic.Web.ViewModels.Blog.DentistBlogIndexViewModel
@{
    ViewData["Title"] = "Quản Lý Bài Viết Chuyên Môn - Trưởng Khoa";
    var items = Model.PagedResult.Items;
    var totalPages = Model.PagedResult.TotalPages;
    var currentPage = Model.CurrentPage;
}

<div class="container-fluid py-3">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1">
                <i class="bi bi-journal-richtext text-primary me-2"></i>Bài Viết Chuyên Môn Của Tôi
            </h3>
            <p class="text-muted small mb-0">Biên soạn kiến thức chuyên khoa nha khoa, quản lý bản nháp và gửi Ban Quản Trị duyệt xuất bản.</p>
        </div>
        <div>
            <a asp-controller="DepartmentBlog" asp-action="Create" class="btn btn-primary d-inline-flex align-items-center gap-2 rounded-pill px-4 py-2 shadow-sm">
                <i class="bi bi-plus-circle"></i>
                <span class="fw-semibold">Viết Bài Chuyên Môn Mới</span>
            </a>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="card border-0 shadow-sm rounded-4 p-3 mb-4">
        <form method="get" asp-controller="DepartmentBlog" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light border-end-0">
                        <i class="bi bi-search text-muted"></i>
                    </span>
                    <input type="text"
                           name="keyword"
                           value="@Model.CurrentKeyword"
                           class="form-control bg-light border-start-0"
                           placeholder="Tìm theo tiêu đề bài viết..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select form-select-sm bg-light">
                    <option value="">-- Tất cả trạng thái --</option>
                    <option value="Draft" selected="@(Model.CurrentStatus == "Draft")">Bản nháp (Draft)</option>
                    <option value="PendingReview" selected="@(Model.CurrentStatus == "PendingReview")">Chờ duyệt (PendingReview)</option>
                    <option value="Published" selected="@(Model.CurrentStatus == "Published")">Đã xuất bản (Published)</option>
                    <option value="Archived" selected="@(Model.CurrentStatus == "Archived")">Đã lưu trữ (Archived)</option>
                </select>
            </div>
            <div class="col-md-auto d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary rounded-pill px-3">
                    <i class="bi bi-funnel me-1"></i> Lọc
                </button>
                <a asp-controller="DepartmentBlog" asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>

    <!-- Posts Table -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        @if (items != null && items.Count > 0)
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 70px;">Ảnh</th>
                            <th>Tiêu đề & Chuyên mục</th>
                            <th style="width: 140px;">Trạng thái</th>
                            <th style="width: 110px;" class="text-center">Lượt xem</th>
                            <th style="width: 130px;">Ngày tạo</th>
                            <th style="width: 130px;" class="text-end">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var post in items)
                        {
                            <tr>
                                <td>
                                    <img src="@(!string.IsNullOrWhiteSpace(post.ThumbnailUrl) ? post.ThumbnailUrl : "/images/blog/viem-tuy-rang-banner.svg")"
                                         alt="@post.Title"
                                         class="rounded-3 border object-fit-cover"
                                         style="width: 54px; height: 38px;"
                                         onerror="this.src='/images/blog/viem-tuy-rang-banner.svg'" />
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark text-truncate" style="max-width: 480px;">
                                        @post.Title
                                    </div>
                                    <div class="small text-muted d-flex align-items-center gap-2 mt-1">
                                        <span class="badge bg-light text-secondary border">@post.CategoryName</span>
                                        @if (post.IsFeatured)
                                        {
                                            <span class="badge bg-warning text-dark"><i class="bi bi-star-fill me-1"></i>Nổi bật</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(post.VideoUrl))
                                        {
                                            <span class="badge bg-danger-subtle text-danger"><i class="bi bi-camera-video me-1"></i>Có Video 3D</span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    @switch (post.Status)
                                    {
                                        case "Draft":
                                            <span class="badge bg-secondary-subtle text-secondary px-2.5 py-1.5 rounded-pill">
                                                <i class="bi bi-file-earmark me-1"></i>Bản nháp
                                            </span>
                                            break;
                                        case "PendingReview":
                                            <span class="badge bg-warning-subtle text-warning-emphasis px-2.5 py-1.5 rounded-pill">
                                                <i class="bi bi-hourglass-split me-1"></i>Chờ Admin duyệt
                                            </span>
                                            break;
                                        case "Published":
                                            <span class="badge bg-success-subtle text-success px-2.5 py-1.5 rounded-pill">
                                                <i class="bi bi-check-circle me-1"></i>Đã xuất bản
                                            </span>
                                            break;
                                        case "Archived":
                                            <span class="badge bg-dark-subtle text-dark px-2.5 py-1.5 rounded-pill">
                                                <i class="bi bi-archive me-1"></i>Lưu trữ
                                            </span>
                                            break;
                                        default:
                                            <span class="badge bg-light text-dark">@post.Status</span>
                                            break;
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="fw-medium text-dark"><i class="bi bi-eye text-muted me-1"></i>@post.ViewCount</span>
                                </td>
                                <td class="small text-muted">
                                    @post.CreatedAt.ToString("dd/MM/yyyy")
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        @if (post.Status == "Published")
                                        {
                                            <a asp-controller="Blog" asp-action="Detail" asp-route-slug="@post.Slug" target="_blank" class="btn btn-outline-secondary" title="Xem bài viết công khai">
                                                <i class="bi bi-box-arrow-up-right"></i>
                                            </a>
                                        }
                                        <a asp-controller="DepartmentBlog" asp-action="Edit" asp-route-id="@post.BlogPostId" class="btn btn-outline-primary" title="Chỉnh sửa bài viết">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        @if (post.Status == "Draft")
                                        {
                                            <button type="button"
                                                    class="btn btn-outline-danger"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#deleteModal-@post.BlogPostId"
                                                    title="Xóa bài viết">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                    </div>

                                    <!-- Delete Modal for Drafts -->
                                    @if (post.Status == "Draft")
                                    {
                                        <div class="modal fade text-start" id="deleteModal-@post.BlogPostId" tabindex="-1">
                                            <div class="modal-dialog modal-dialog-centered modal-sm">
                                                <div class="modal-content rounded-4 border-0 shadow">
                                                    <div class="modal-body p-4 text-center">
                                                        <i class="bi bi-exclamation-triangle text-danger display-5 mb-3"></i>
                                                        <h6 class="fw-bold mb-2">Xác nhận xóa bản nháp?</h6>
                                                        <p class="text-muted small mb-4">Hành động này không thể hoàn tác.</p>
                                                        <div class="d-flex justify-content-center gap-2">
                                                            <button type="button" class="btn btn-sm btn-light rounded-pill px-3" data-bs-dismiss="modal">Hủy</button>
                                                            <form method="post" asp-controller="DepartmentBlog" asp-action="Delete" asp-route-id="@post.BlogPostId">
                                                                @Html.AntiForgeryToken()
                                                                <button type="submit" class="btn btn-sm btn-danger rounded-pill px-3">Xác nhận xóa</button>
                                                            </form>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            @if (totalPages > 1)
            {
                <div class="card-footer bg-white border-0 py-3">
                    <ul class="pagination pagination-sm justify-content-center mb-0">
                        <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                            <a class="page-link" asp-controller="DepartmentBlog" asp-action="Index"
                               asp-route-page="@(currentPage - 1)"
                               asp-route-status="@Model.CurrentStatus"
                               asp-route-keyword="@Model.CurrentKeyword">Trước</a>
                        </li>
                        @for (int p = 1; p <= totalPages; p++)
                        {
                            <li class="page-item @(p == currentPage ? "active" : "")">
                                <a class="page-link" asp-controller="DepartmentBlog" asp-action="Index"
                                   asp-route-page="@p"
                                   asp-route-status="@Model.CurrentStatus"
                                   asp-route-keyword="@Model.CurrentKeyword">@p</a>
                            </li>
                        }
                        <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                            <a class="page-link" asp-controller="DepartmentBlog" asp-action="Index"
                               asp-route-page="@(currentPage + 1)"
                               asp-route-status="@Model.CurrentStatus"
                               asp-route-keyword="@Model.CurrentKeyword">Sau</a>
                        </li>
                    </ul>
                </div>
            }
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-journal-x text-muted display-4 mb-3"></i>
                <h5 class="fw-semibold text-muted mb-2">Chưa có bài viết chuyên môn nào</h5>
                <p class="text-muted small mb-3">Hãy tạo bài viết đầu tiên để chia sẻ kiến thức nha khoa chuẩn y khoa.</p>
                <a asp-controller="DepartmentBlog" asp-action="Create" class="btn btn-primary rounded-pill px-4">
                    <i class="bi bi-plus-circle me-1"></i> Soạn Bài Viết Mới
                </a>
            </div>
        }
    </div>
</div>
