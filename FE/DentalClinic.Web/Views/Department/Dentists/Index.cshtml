@using System.Globalization
@model DentalClinic.Web.ViewModels.Department.DepartmentDentistsViewModel
@{
    ViewData["Title"] = "Phân Bổ Bác Sĩ Chuyên Khoa";
    var viCulture = new CultureInfo("vi-VN");
    var activeCount = Model.Allocations.Count(a => a.Status == "Active");
    var inactiveCount = Model.Allocations.Count(a => a.Status != "Active");
}

<div class="container-fluid px-4 py-4">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary-subtle text-primary fw-medium px-2 py-1 fs-12">
                    <i class="bi bi-shield-check me-1"></i> Trưởng Khoa / Quản Lý Chuyên Khoa
                </span>
                <span class="badge bg-light text-muted fw-normal px-2 py-1 fs-12">Điều Động Nhân Sự</span>
            </div>
            <h1 class="h3 fw-bold text-slate-800 mb-0">Phân Bổ Bác Sĩ Vào Chuyên Khoa</h1>
            <p class="text-muted small mb-0 mt-1">Quản lý phân công bác sĩ vào khoa điều trị lâm sàng, cấp quyền phân ca trực và theo dõi trạng thái nhân sự</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="DepartmentSchedule" asp-action="Index" class="btn btn-outline-secondary d-flex align-items-center gap-2">
                <i class="bi bi-calendar-range"></i>
                <span>Xem Lịch Trực Khoa</span>
            </a>
            <button type="button" class="btn btn-primary d-flex align-items-center gap-2 shadow-sm" data-bs-toggle="modal" data-bs-target="#assignDentistModal">
                <i class="bi bi-person-plus"></i>
                <span>Phân Bổ Bác Sĩ Mới</span>
            </button>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-4 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill fs-5"></i>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 mb-4 shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
            <div>@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Stat Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold">Tổng Phân Bổ Bác Sĩ</div>
                        <div class="h4 fw-bold text-primary mb-0 mt-1">@Model.Allocations.Count</div>
                        <div class="text-muted small" style="font-size: 0.75rem;">Lượt bác sĩ được phân công vào khoa</div>
                    </div>
                    <div class="bg-primary-subtle text-primary rounded-3 p-3">
                        <i class="bi bi-people fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold">Đang Hoạt Động</div>
                        <div class="h4 fw-bold text-success mb-0 mt-1">@activeCount</div>
                        <div class="text-muted small" style="font-size: 0.75rem;">Sẵn sàng phân ca & tiếp nhận bệnh nhân</div>
                    </div>
                    <div class="bg-success-subtle text-success rounded-3 p-3">
                        <i class="bi bi-person-check fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold">Tạm Ngưng Phân Ca</div>
                        <div class="h4 fw-bold text-warning mb-0 mt-1">@inactiveCount</div>
                        <div class="text-muted small" style="font-size: 0.75rem;">Tạm dừng điều động chuyên khoa</div>
                    </div>
                    <div class="bg-warning-subtle text-warning rounded-3 p-3">
                        <i class="bi bi-person-dash fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form asp-controller="DepartmentDentist" asp-action="Index" method="get" class="row g-2 align-items-center">
                <div class="col-md-5">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="search" class="form-control border-start-0" placeholder="Tìm theo tên bác sĩ, mã nhân viên, email..." value="@Model.Search" />
                    </div>
                </div>
                <div class="col-md-5">
                    <select name="departmentId" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="">-- Tất cả chuyên khoa --</option>
                        @foreach (var d in Model.Departments)
                        {
                            <option value="@d.DepartmentId" selected="@(Model.DepartmentId == d.DepartmentId)">
                                @d.Name
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-sm btn-primary w-100">
                        <i class="bi bi-filter me-1"></i> Lọc
                    </button>
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary" title="Đặt lại bộ lọc">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Dentist Allocations Table -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-person-lines-fill text-primary fs-5"></i>
                <span class="fw-bold text-slate-800">Danh Sách Bác Sĩ Đã Phân Bổ (@Model.Allocations.Count bác sĩ)</span>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 50px;">#</th>
                            <th>Bác sĩ</th>
                            <th>Thông tin liên hệ</th>
                            <th>Chuyên môn</th>
                            <th>Chuyên khoa tiếp nhận</th>
                            <th>Ngày phân bổ</th>
                            <th>Trạng thái</th>
                            <th class="text-end">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Allocations.Any())
                        {
                            int idx = 1;
                            foreach (var a in Model.Allocations)
                            {
                                <tr>
                                    <td class="text-muted fw-bold">@(idx++)</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="avatar-sm bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 36px; height: 36px;">
                                                @(string.IsNullOrEmpty(a.DentistName) ? "BS" : a.DentistName.Substring(0, 1))
                                            </div>
                                            <div>
                                                <div class="fw-bold text-dark">@a.DentistName</div>
                                                <div class="text-muted small" style="font-size: 0.75rem;">Mã NV: @(a.DentistCode ?? $"UID-{a.DentistUserId}")</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="small text-dark">
                                            <i class="bi bi-envelope me-1 text-muted"></i>@(a.DentistEmail ?? "—")
                                        </div>
                                        @if (!string.IsNullOrEmpty(a.DentistPhone))
                                        {
                                            <div class="small text-muted mt-1">
                                                <i class="bi bi-telephone me-1 text-muted"></i>@a.DentistPhone
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-secondary border">
                                            @(string.IsNullOrEmpty(a.Specialty) ? "Nha khoa tổng quát" : a.Specialty)
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle fs-12">
                                            <i class="bi bi-hospital me-1"></i>@a.DepartmentName
                                        </span>
                                    </td>
                                    <td class="small text-muted">
                                        @a.AssignedAt.ToString("dd/MM/yyyy HH:mm")
                                    </td>
                                    <td>
                                        @if (a.Status == "Active")
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                <i class="bi bi-check-circle me-1"></i> Hoạt động
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
                                                <i class="bi bi-pause-circle me-1"></i> Tạm ngưng
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end text-nowrap">
                                        <a asp-controller="DepartmentSchedule" asp-action="Index" asp-route-departmentId="@a.DepartmentId" asp-route-dentistUserId="@a.DentistUserId" class="btn btn-sm btn-outline-primary me-1" title="Xem lịch trực của bác sĩ">
                                            <i class="bi bi-calendar3 me-1"></i> Lịch trực
                                        </a>
                                        <form asp-controller="DepartmentDentist" asp-action="ToggleStatus" asp-route-id="@a.DentistDepartmentId" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn thay đổi trạng thái phân bổ của bác sĩ này?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="returnDepartmentId" value="@Model.DepartmentId" />
                                            <button type="submit" class="btn btn-sm @(a.Status == "Active" ? "btn-outline-warning" : "btn-outline-success")">
                                                <i class="bi @(a.Status == "Active" ? "bi-pause" : "bi-play")"></i>
                                                @(a.Status == "Active" ? "Tạm ngưng" : "Kích hoạt")
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted">
                                    <i class="bi bi-person-x fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                    Chưa có bác sĩ nào được phân bổ vào chuyên khoa này.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- MODAL: PHÂN BỔ BÁC SĨ MỚI -->
<div class="modal fade" id="assignDentistModal" tabindex="-1" aria-labelledby="assignDentistModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold" id="assignDentistModalLabel">
                    <i class="bi bi-person-plus me-2"></i> Phân Bổ Bác Sĩ Vào Chuyên Khoa
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="DepartmentDentist" asp-action="Assign" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Chọn Bác sĩ <span class="text-danger">*</span></label>
                        <select asp-for="AssignForm.DentistUserId" class="form-select" required>
                            <option value="">-- Chọn bác sĩ nha khoa --</option>
                            @foreach (var doc in Model.Dentists)
                            {
                                <option value="@doc.UserId">@doc.FullName (@(doc.Code ?? doc.Email))</option>
                            }
                        </select>
                        <div class="form-text small">Chỉ những bác sĩ có tài khoản hợp lệ trên hệ thống mới hiển thị tại đây.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Chuyên khoa tiếp nhận <span class="text-danger">*</span></label>
                        <select asp-for="AssignForm.DepartmentId" class="form-select" required>
                            @foreach (var d in Model.Departments)
                            {
                                <option value="@d.DepartmentId">@d.Name</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Trạng thái phân bổ</label>
                        <select asp-for="AssignForm.Status" class="form-select">
                            <option value="Active">Hoạt động (Cho phép xếp ca trực ngay)</option>
                            <option value="Inactive">Tạm ngưng</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary fw-semibold">
                        <i class="bi bi-check-lg me-1"></i> Xác Nhận Phân Bổ
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
