@model DentalClinic.Web.Models.Reports.DepartmentPerformanceReportDto
@{
    ViewData["Title"] = $"Báo Cáo Năng Suất Bác Sĩ - {Model.DepartmentName}";
    var departments = ViewBag.Departments as List<DentalClinic.Web.Models.ApiDtos.DepartmentDto> ?? new();
    var selectedDeptId = ViewBag.SelectedDepartmentId as long?;
    var fromDate = ViewBag.FromDate as string;
    var toDate = ViewBag.ToDate as string;
}

<div class="container-fluid px-0">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-person-workspace text-primary me-2"></i>Báo Cáo Năng Suất & Đánh Giá Bác Sĩ
            </h1>
            <p class="text-muted mb-0">Chuyên khoa: <strong>@Model.DepartmentName</strong> &bull; Trưởng khoa phụ trách: @(Model.ManagerName ?? "--")</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="ExportPerformance"
               asp-route-departmentId="@selectedDeptId"
               asp-route-fromDate="@fromDate"
               asp-route-toDate="@toDate"
               class="btn btn-success shadow-sm">
                <i class="bi bi-file-earmark-excel me-1"></i> Xuất Báo Cáo Excel (CSV)
            </a>
        </div>
    </div>

    <!-- Alert Messages -->
    <partial name="_AlertMessage" />

    <!-- Filter Bar -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Performance" class="row g-2 align-items-end">
                <div class="col-12 col-md-4">
                    <label class="form-label small text-muted mb-1">Chọn chuyên khoa</label>
                    <select name="departmentId" class="form-select form-select-sm" onchange="this.form.submit()">
                        @foreach (var d in departments)
                        {
                            <option value="@d.DepartmentId" selected="@(selectedDeptId == d.DepartmentId)">@d.Name</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label small text-muted mb-1">Từ ngày</label>
                    <input type="date" name="fromDate" value="@fromDate" class="form-control form-control-sm" />
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label small text-muted mb-1">Đến ngày</label>
                    <input type="date" name="toDate" value="@toDate" class="form-control form-control-sm" />
                </div>
                <div class="col-12 col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-sm px-3 flex-grow-1">
                        <i class="bi bi-funnel me-1"></i> Lọc
                    </button>
                    <a asp-action="Performance" asp-route-departmentId="@selectedDeptId" class="btn btn-light btn-sm px-3 border" title="Đặt lại ngày">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Department Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 border-start border-4 border-primary">
                <div class="card-body">
                    <span class="text-muted small text-uppercase fw-semibold">Đội Ngũ Bác Sĩ</span>
                    <h3 class="fw-bold text-dark mb-0 mt-1">@Model.TotalDentists</h3>
                    <div class="small text-muted mt-1">Bác sĩ thuộc khoa @Model.DepartmentName</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 border-start border-4 border-success">
                <div class="card-body">
                    <span class="text-muted small text-uppercase fw-semibold">Ca Khám Hoàn Thành</span>
                    <h3 class="fw-bold text-success mb-0 mt-1">@Model.CompletedAppointments</h3>
                    <div class="small text-muted mt-1">trên tổng số @Model.TotalAppointments lịch hẹn</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 border-start border-4 border-warning">
                <div class="card-body">
                    <span class="text-muted small text-uppercase fw-semibold">Đánh Giá Trung Bình</span>
                    <h3 class="fw-bold text-warning mb-0 mt-1">
                        @Model.OverallDepartmentRating.ToString("F1") <i class="bi bi-star-fill fs-5"></i>
                    </h3>
                    <div class="small text-muted mt-1">Theo nhận xét từ bệnh nhân</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 border-start border-4 border-info">
                <div class="card-body">
                    <span class="text-muted small text-uppercase fw-semibold">Doanh Thu Khoa Tạo Ra</span>
                    <h3 class="fw-bold text-primary mb-0 mt-1">@Model.TotalDepartmentRevenue.ToString("N0") đ</h3>
                    <div class="small text-muted mt-1">Tổng viện phí các ca khám</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Dentist Performance Table -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0 fw-bold text-dark">
                <i class="bi bi-trophy text-warning me-2"></i>Bảng Thống Kê Hiệu Suất Từng Bác Sĩ
            </h5>
            <span class="text-muted small">Sắp xếp theo số ca khám hoàn tất</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Bác Sĩ</th>
                        <th>Mã NV</th>
                        <th class="text-center">Tổng Ca Khám</th>
                        <th class="text-center">Đã Hoàn Thành</th>
                        <th class="text-center">Tỷ Lệ Hoàn Thành</th>
                        <th class="text-center">Đánh Giá (Sao)</th>
                        <th class="text-center">Số Lượt Đánh Giá</th>
                        <th class="text-end">Doanh Thu Đóng Góp</th>
                        <th class="text-end pe-3">Chi Tiết</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Dentists.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted">
                                Khoa này hiện chưa có dữ liệu bác sĩ hoặc ca khám trong kỳ báo cáo.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var d in Model.Dentists)
                        {
                            <tr>
                                <td class="ps-3">
                                    <div class="fw-bold text-dark">@d.DentistName</div>
                                    <div class="small text-muted">@d.DepartmentName</div>
                                </td>
                                <td>
                                    <span class="font-monospace small bg-light px-2 py-1 rounded">@(d.EmployeeCode ?? "--")</span>
                                </td>
                                <td class="text-center fw-semibold">@d.TotalAppointments</td>
                                <td class="text-center fw-bold text-success">@d.CompletedAppointments</td>
                                <td class="text-center">
                                    <div class="d-flex align-items-center justify-content-center gap-2">
                                        <div class="progress flex-grow-1" style="height: 6px; max-width: 70px;">
                                            <div class="progress-bar bg-success" role="progressbar" style="width: @d.CompletionRate%;"></div>
                                        </div>
                                        <span class="small fw-semibold">@d.CompletionRate%</span>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <div class="d-inline-flex align-items-center gap-1 bg-warning bg-opacity-10 text-dark px-2 py-1 rounded fw-bold">
                                        <i class="bi bi-star-fill text-warning"></i>
                                        <span>@d.AverageRating.ToString("F1")</span>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-light text-muted border">@d.TotalFeedbacks lượt</span>
                                </td>
                                <td class="text-end fw-bold text-primary">
                                    @d.TotalRevenueGenerated.ToString("N0") đ
                                </td>
                                <td class="text-end pe-3">
                                    <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#feedbackModal-@d.DentistUserId">
                                        <i class="bi bi-chat-quote me-1"></i> Xem Nhận Xét
                                    </button>

                                    <!-- Feedback Modal -->
                                    <div class="modal fade text-start" id="feedbackModal-@d.DentistUserId" tabindex="-1">
                                        <div class="modal-dialog modal-dialog-scrollable">
                                            <div class="modal-content">
                                                <div class="modal-header bg-light">
                                                    <h5 class="modal-title fw-bold">
                                                        <i class="bi bi-star-fill text-warning me-2"></i>Đánh Giá Của Bác Sĩ @d.DentistName
                                                    </h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body p-4">
                                                    <!-- Star rating breakdown -->
                                                    <div class="p-3 bg-light rounded-3 mb-4">
                                                        <div class="d-flex align-items-center gap-3 mb-3">
                                                            <h1 class="display-5 fw-bold mb-0 text-warning">@d.AverageRating.ToString("F1")</h1>
                                                            <div>
                                                                <div class="text-warning fs-5">
                                                                    @for (int s = 1; s <= 5; s++)
                                                                    {
                                                                        if (s <= Math.Round(d.AverageRating))
                                                                        {
                                                                            <i class="bi bi-star-fill"></i>
                                                                        }
                                                                        else
                                                                        {
                                                                            <i class="bi bi-star"></i>
                                                                        }
                                                                    }
                                                                </div>
                                                                <div class="small text-muted">Dựa trên @d.TotalFeedbacks đánh giá của bệnh nhân</div>
                                                            </div>
                                                        </div>

                                                        <div class="small">
                                                            <div class="d-flex align-items-center gap-2 mb-1">
                                                                <span style="width: 45px;">5 sao:</span>
                                                                <div class="progress flex-grow-1" style="height: 6px;">
                                                                    <div class="progress-bar bg-success" style="width: @(d.TotalFeedbacks > 0 ? (d.FiveStarCount * 100 / d.TotalFeedbacks) : 0)%;"></div>
                                                                </div>
                                                                <span class="text-muted" style="width: 30px;">@d.FiveStarCount</span>
                                                            </div>
                                                            <div class="d-flex align-items-center gap-2 mb-1">
                                                                <span style="width: 45px;">4 sao:</span>
                                                                <div class="progress flex-grow-1" style="height: 6px;">
                                                                    <div class="progress-bar bg-info" style="width: @(d.TotalFeedbacks > 0 ? (d.FourStarCount * 100 / d.TotalFeedbacks) : 0)%;"></div>
                                                                </div>
                                                                <span class="text-muted" style="width: 30px;">@d.FourStarCount</span>
                                                            </div>
                                                            <div class="d-flex align-items-center gap-2 mb-1">
                                                                <span style="width: 45px;">3 sao:</span>
                                                                <div class="progress flex-grow-1" style="height: 6px;">
                                                                    <div class="progress-bar bg-warning" style="width: @(d.TotalFeedbacks > 0 ? (d.ThreeStarCount * 100 / d.TotalFeedbacks) : 0)%;"></div>
                                                                </div>
                                                                <span class="text-muted" style="width: 30px;">@d.ThreeStarCount</span>
                                                            </div>
                                                            <div class="d-flex align-items-center gap-2">
                                                                <span style="width: 45px;">1-2 sao:</span>
                                                                <div class="progress flex-grow-1" style="height: 6px;">
                                                                    <div class="progress-bar bg-danger" style="width: @(d.TotalFeedbacks > 0 ? ((d.OneStarCount + d.TwoStarCount) * 100 / d.TotalFeedbacks) : 0)%;"></div>
                                                                </div>
                                                                <span class="text-muted" style="width: 30px;">@(d.OneStarCount + d.TwoStarCount)</span>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <h6 class="fw-bold mb-3">Nhận xét gần đây của bệnh nhân:</h6>
                                                    @if (!d.RecentFeedbacks.Any())
                                                    {
                                                        <div class="text-muted small text-center py-3">Chưa có bình luận nhận xét chi tiết.</div>
                                                    }
                                                    else
                                                    {
                                                        <div class="list-group list-group-flush">
                                                            @foreach (var fb in d.RecentFeedbacks)
                                                            {
                                                                <div class="list-group-item px-0 py-2">
                                                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                                                        <span class="fw-semibold small">@fb.PatientName</span>
                                                                        <span class="text-warning small">
                                                                            @for (int s = 1; s <= fb.DentistRating; s++)
                                                                            {
                                                                                <i class="bi bi-star-fill"></i>
                                                                            }
                                                                        </span>
                                                                    </div>
                                                                    <div class="small text-muted fst-italic mb-1">
                                                                        "@(string.IsNullOrWhiteSpace(fb.Comment) ? "Bác sĩ tận tình, khám chu đáo." : fb.Comment)"
                                                                    </div>
                                                                    <div class="text-muted" style="font-size: 0.75rem;">@fb.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                                <div class="modal-footer bg-light">
                                                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Đóng</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
