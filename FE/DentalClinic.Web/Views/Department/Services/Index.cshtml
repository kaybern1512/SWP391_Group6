@using System.Globalization
@model DentalClinic.Web.ViewModels.Department.DepartmentServicesViewModel
@{
    ViewData["Title"] = "Dịch Vụ & Bảng Giá Khoa";
    var viCulture = new CultureInfo("vi-VN");
    var activeCount = Model.Services.Count(s => s.Status == "Active");
    var inactiveCount = Model.Services.Count(s => s.Status != "Active");
}

<div class="container-fluid px-4 py-4">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary-subtle text-primary fw-medium px-2 py-1 fs-12">
                    <i class="bi bi-shield-check me-1"></i> Trưởng Khoa / Quản Lý Chuyên Khoa
                </span>
                <span class="badge bg-light text-muted fw-normal px-2 py-1 fs-12">Biểu Giá & Kỹ Thuật</span>
            </div>
            <h1 class="h3 fw-bold text-slate-800 mb-0">Dịch Vụ & Bảng Giá Chuyên Khoa</h1>
            <p class="text-muted small mb-0 mt-1">Quản lý danh mục dịch vụ kỹ thuật, thời lượng thực hiện và niêm yết đơn giá theo từng chuyên khoa</p>
        </div>
        <div>
            <button type="button" class="btn btn-primary d-flex align-items-center gap-2 shadow-sm" data-bs-toggle="modal" data-bs-target="#createServiceModal">
                <i class="bi bi-plus-circle"></i>
                <span>Thêm Dịch Vụ Mới</span>
            </button>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-4 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill fs-5"></i>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 mb-4 shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
            <div>@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Stat Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold">Tổng Dịch Vụ Khoa</div>
                        <div class="h4 fw-bold text-primary mb-0 mt-1">@Model.Services.Count</div>
                        <div class="text-muted small" style="font-size: 0.75rem;">Danh mục kỹ thuật được niêm yết</div>
                    </div>
                    <div class="bg-primary-subtle text-primary rounded-3 p-3">
                        <i class="bi bi-tags fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold">Đang Hoạt Động</div>
                        <div class="h4 fw-bold text-success mb-0 mt-1">@activeCount</div>
                        <div class="text-muted small" style="font-size: 0.75rem;">Sẵn sàng chỉ định điều trị</div>
                    </div>
                    <div class="bg-success-subtle text-success rounded-3 p-3">
                        <i class="bi bi-check-circle fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold">Tạm Ngưng Áp Dụng</div>
                        <div class="h4 fw-bold text-warning mb-0 mt-1">@inactiveCount</div>
                        <div class="text-muted small" style="font-size: 0.75rem;">Tạm dừng tiếp nhận mới</div>
                    </div>
                    <div class="bg-warning-subtle text-warning rounded-3 p-3">
                        <i class="bi bi-pause-circle fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form asp-controller="DepartmentService" asp-action="Index" method="get" class="row g-2 align-items-center">
                <div class="col-md-5">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="search" class="form-control border-start-0" placeholder="Tìm theo tên dịch vụ, mã kỹ thuật hoặc mô tả..." value="@Model.Search" />
                    </div>
                </div>
                <div class="col-md-5">
                    <select name="departmentId" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="">-- Tất cả chuyên khoa --</option>
                        @foreach (var d in Model.Departments)
                        {
                            <option value="@d.DepartmentId" selected="@(Model.DepartmentId == d.DepartmentId)">
                                @d.Name
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-sm btn-primary w-100">
                        <i class="bi bi-filter me-1"></i> Lọc
                    </button>
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary" title="Đặt lại bộ lọc">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Service Table -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-list-check text-primary fs-5"></i>
                <span class="fw-bold text-slate-800">Bảng Giá Dịch Vụ Điều Trị (@Model.Services.Count dịch vụ)</span>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 50px;">#</th>
                            <th>Mã & Tên dịch vụ</th>
                            <th>Chuyên khoa</th>
                            <th class="text-end">Đơn giá niêm yết</th>
                            <th class="text-center">Thời lượng</th>
                            <th>Mô tả</th>
                            <th>Trạng thái</th>
                            <th class="text-end">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Services.Any())
                        {
                            int idx = 1;
                            foreach (var s in Model.Services)
                            {
                                <tr>
                                    <td class="text-muted fw-bold">@(idx++)</td>
                                    <td>
                                        <div class="fw-bold text-dark">@s.ServiceName</div>
                                        <div class="text-muted small" style="font-size: 0.75rem;">Mã kỹ thuật: DV-@s.DepartmentServiceId</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-primary border">@s.DepartmentName</span>
                                    </td>
                                    <td class="text-end">
                                        <span class="fw-bold text-success fs-6">
                                            @s.Price.ToString("N0", viCulture) đ
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-secondary-subtle text-secondary border">
                                            <i class="bi bi-clock me-1"></i>@(s.DurationMinutes.HasValue ? $"{s.DurationMinutes} phút" : "Chưa đặt")
                                        </span>
                                    </td>
                                    <td>
                                        <span class="text-muted small text-truncate d-inline-block" style="max-width: 200px;" title="@s.Description">
                                            @(string.IsNullOrEmpty(s.Description) ? "—" : s.Description)
                                        </span>
                                    </td>
                                    <td>
                                        @if (s.Status == "Active")
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                <i class="bi bi-check-circle me-1"></i> Hoạt động
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
                                                <i class="bi bi-pause-circle me-1"></i> Tạm ngưng
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end text-nowrap">
                                        <button type="button" class="btn btn-sm btn-outline-primary me-1"
                                                onclick="openEditServiceModal(@s.DepartmentServiceId, @s.DepartmentId, '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(s.ServiceName))', @s.Price, @(s.DurationMinutes ?? 0), '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(s.Description ?? ""))', '@s.Status')">
                                            <i class="bi bi-pencil-square me-1"></i> Sửa
                                        </button>
                                        <form asp-controller="DepartmentService" asp-action="ToggleStatus" asp-route-id="@s.DepartmentServiceId" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn thay đổi trạng thái kích hoạt dịch vụ này?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="returnDepartmentId" value="@Model.DepartmentId" />
                                            <button type="submit" class="btn btn-sm @(s.Status == "Active" ? "btn-outline-warning" : "btn-outline-success")">
                                                <i class="bi @(s.Status == "Active" ? "bi-pause" : "bi-play")"></i>
                                                @(s.Status == "Active" ? "Tạm ngưng" : "Kích hoạt")
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted">
                                    <i class="bi bi-tags fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                    Không có dịch vụ nào phù hợp với điều kiện tìm kiếm.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- MODAL: THÊM DỊCH VỤ MỚI -->
<div class="modal fade" id="createServiceModal" tabindex="-1" aria-labelledby="createServiceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold" id="createServiceModalLabel">
                    <i class="bi bi-plus-circle me-2"></i> Thêm Dịch Vụ Điều Trị Mới
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="DepartmentService" asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Chuyên khoa trực thuộc <span class="text-danger">*</span></label>
                        <select asp-for="CreateForm.DepartmentId" class="form-select" required>
                            @foreach (var d in Model.Departments)
                            {
                                <option value="@d.DepartmentId">@d.Name</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tên dịch vụ kỹ thuật <span class="text-danger">*</span></label>
                        <input asp-for="CreateForm.ServiceName" type="text" class="form-control" placeholder="Ví dụ: Trám răng thẩm mỹ Composite..." required />
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold">Đơn giá niêm yết (VNĐ) <span class="text-danger">*</span></label>
                            <input asp-for="CreateForm.Price" type="number" step="1000" min="0" class="form-control" placeholder="500000" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">Thời lượng ước tính (phút)</label>
                            <input asp-for="CreateForm.DurationMinutes" type="number" min="5" step="5" class="form-control" placeholder="30" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Mô tả quy trình kỹ thuật</label>
                        <textarea asp-for="CreateForm.Description" class="form-control" rows="3" placeholder="Mô tả chỉ định, quy trình và vật tư áp dụng..."></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Trạng thái khởi tạo</label>
                        <select asp-for="CreateForm.Status" class="form-select">
                            <option value="Active">Hoạt động (Áp dụng ngay)</option>
                            <option value="Inactive">Tạm ngưng</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary fw-semibold">
                        <i class="bi bi-check-lg me-1"></i> Thêm Dịch Vụ
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL: CẬP NHẬT DỊCH VỤ -->
<div class="modal fade" id="editServiceModal" tabindex="-1" aria-labelledby="editServiceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-slate-800 text-white">
                <h5 class="modal-title fw-bold" id="editServiceModalLabel">
                    <i class="bi bi-pencil-square me-2"></i> Chỉnh Sửa Dịch Vụ & Đơn Giá
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="editServiceForm" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Chuyên khoa trực thuộc <span class="text-danger">*</span></label>
                        <select id="edit_DepartmentId" name="DepartmentId" class="form-select" required>
                            @foreach (var d in Model.Departments)
                            {
                                <option value="@d.DepartmentId">@d.Name</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tên dịch vụ kỹ thuật <span class="text-danger">*</span></label>
                        <input id="edit_ServiceName" name="ServiceName" type="text" class="form-control" required />
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold">Đơn giá niêm yết (VNĐ) <span class="text-danger">*</span></label>
                            <input id="edit_Price" name="Price" type="number" step="1000" min="0" class="form-control" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">Thời lượng ước tính (phút)</label>
                            <input id="edit_DurationMinutes" name="DurationMinutes" type="number" min="5" step="5" class="form-control" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Mô tả quy trình kỹ thuật</label>
                        <textarea id="edit_Description" name="Description" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Trạng thái</label>
                        <select id="edit_Status" name="Status" class="form-select">
                            <option value="Active">Hoạt động</option>
                            <option value="Inactive">Tạm ngưng</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary fw-semibold">
                        <i class="bi bi-save me-1"></i> Lưu Thay Đổi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function openEditServiceModal(serviceId, departmentId, serviceName, price, duration, description, status) {
        document.getElementById('editServiceForm').action = '/Department/Services/Update/' + serviceId;
        document.getElementById('edit_DepartmentId').value = departmentId;
        document.getElementById('edit_ServiceName').value = serviceName;
        document.getElementById('edit_Price').value = price;
        document.getElementById('edit_DurationMinutes').value = duration || '';
        document.getElementById('edit_Description').value = description || '';
        document.getElementById('edit_Status').value = status;

        const modal = new bootstrap.Modal(document.getElementById('editServiceModal'));
        modal.show();
    }
</script>
}
