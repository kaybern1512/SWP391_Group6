@model DentalClinic.Web.ViewModels.Appointments.DepartmentReviewViewModel
@{
    ViewData["Title"] = $"Phân bổ tài nguyên & Phê duyệt {Model.Appointment.AppointmentCode}";
    var appt = Model.Appointment;
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <a asp-action="Requests" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-left"></i>
                </a>
                <h1 class="h3 fw-bold text-dark mb-0">Điều Phối Lịch Khám: <span class="text-primary font-monospace">@appt.AppointmentCode</span></h1>
            </div>
            <p class="text-muted mb-0">Khoa: <strong>@appt.DepartmentName</strong> &bull; Bệnh nhân: <strong>@appt.PatientName (@appt.PatientCode)</strong></p>
        </div>
        <div>
            <span class="badge bg-warning text-dark fs-6 px-3 py-2">
                <i class="bi bi-hourglass-split me-1"></i>Chờ Trưởng Khoa Phân Bổ
            </span>
        </div>
    </div>

    <!-- PATIENT & REQUEST OVERVIEW -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white py-3">
            <h5 class="card-title mb-0 fw-semibold text-dark">
                <i class="bi bi-person-lines-fill me-2 text-primary"></i>Thông Tin Bệnh Nhân & Yêu Cầu Ban Đầu
            </h5>
        </div>
        <div class="card-body p-4">
            <div class="row g-3">
                <div class="col-md-3">
                    <span class="text-muted small">Bệnh nhân:</span>
                    <div class="fw-bold fs-6">@appt.PatientName</div>
                    <div class="small text-muted">Mã HS: @appt.PatientCode &bull; SĐT: @(appt.PatientPhone ?? "N/A")</div>
                </div>
                <div class="col-md-3">
                    <span class="text-muted small">Dịch vụ yêu cầu:</span>
                    <div class="fw-bold text-primary">@appt.ServiceName</div>
                    <div class="small text-muted">Thời lượng: @(appt.DurationMinutes ?? 30) phút</div>
                </div>
                <div class="col-md-3">
                    <span class="text-muted small">Khung giờ bệnh nhân mong muốn:</span>
                    <div class="fw-bold text-success fs-6">
                        @(appt.ScheduledStart?.ToString("dd/MM/yyyy HH:mm") ?? "--")
                    </div>
                    <div class="small text-muted">đến @(appt.ScheduledEnd?.ToString("HH:mm") ?? "--")</div>
                </div>
                <div class="col-md-3">
                    <span class="text-muted small">Bác sĩ bệnh nhân mong muốn:</span>
                    <div class="fw-bold text-dark">
                        @(string.IsNullOrWhiteSpace(appt.RequestedDentistName) ? "Bất kỳ bác sĩ khả dụng" : appt.RequestedDentistName)
                    </div>
                </div>
                <div class="col-12">
                    <span class="text-muted small">Lý do khám / Triệu chứng bệnh nhân mô tả:</span>
                    <div class="p-3 bg-light rounded fst-italic">@appt.ReasonForVisit</div>
                </div>
            </div>
        </div>
    </div>

    <!-- ACTION TABS: CONFIRM vs PROPOSE CHANGE -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom-0 pt-3">
            <ul class="nav nav-pills card-header-pills" id="reviewTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active fw-bold px-4" id="confirm-tab" data-bs-toggle="tab" data-bs-target="#confirmTabPane" type="button" role="tab">
                        <i class="bi bi-check2-circle me-1"></i> Phương Án 1: Phê Duyệt & Phân Bổ Tài Nguyên
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link fw-bold px-4 text-warning" id="propose-tab" data-bs-toggle="tab" data-bs-target="#proposeTabPane" type="button" role="tab">
                        <i class="bi bi-arrow-repeat me-1"></i> Phương Án 2: Đề Xuất Điều Chỉnh Cho Bệnh Nhân
                    </button>
                </li>
            </ul>
        </div>
        <div class="card-body p-4">
            <div class="tab-content" id="reviewTabsContent">
                <!-- TAB 1: PHÊ DUYỆT & GÁN TÀI NGUYÊN -->
                <div class="tab-pane fade show active" id="confirmTabPane" role="tabpanel">
                    <div class="alert alert-success border-0 mb-4">
                        <i class="bi bi-info-circle-fill me-2"></i>
                        Xác nhận lịch hẹn khi đáp ứng đúng bác sĩ yêu cầu (hoặc bệnh nhân chọn bác sĩ bất kỳ), phân bổ Phòng khám và Ghế điều trị còn trống. Sau khi xác nhận, hệ thống sẽ <strong>tự động cấp số thứ tự vào viện (Queue Number)</strong>.
                    </div>

                    <form asp-action="Confirm" asp-route-id="@appt.AppointmentId" method="post">
                        @Html.AntiForgeryToken()
                        <div class="row g-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">1. Bác sĩ chuyên khoa phụ trách <span class="text-danger">*</span></label>
                                <select asp-for="AssignedDentistUserId" class="form-select form-select-lg" required>
                                    <option value="">-- Chọn Bác Sĩ Phụ Trách --</option>
                                    @foreach (var d in Model.Dentists)
                                    {
                                        <option value="@d.DentistUserId" selected="@(d.DentistUserId == Model.AssignedDentistUserId)">
                                            @d.FullName (@d.EmployeeCode) - @(d.Specialization ?? "Bác sĩ khoa") @(d.IsAvailable ? "" : " [Trùng lịch]")
                                        </option>
                                    }
                                </select>
                                <div class="form-text">Bác sĩ thuộc khoa và đã đăng ký lịch làm việc trong ngày.</div>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label fw-bold">2. Phòng khám điều trị <span class="text-danger">*</span></label>
                                <select asp-for="RoomId" id="selectRoom" class="form-select form-select-lg" required onchange="filterChairs()">
                                    <option value="">-- Chọn Phòng --</option>
                                    @foreach (var r in Model.Rooms)
                                    {
                                        <option value="@r.RoomId" selected="@(r.RoomId == Model.RoomId)">
                                            @r.RoomName (@r.RoomCode) @(r.IsOccupied ? " [Đang bận]" : " [Trống]")
                                        </option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label fw-bold">3. Ghế nha khoa <span class="text-danger">*</span></label>
                                <select asp-for="DentalChairId" id="selectChair" class="form-select form-select-lg" required>
                                    <option value="">-- Chọn Ghế --</option>
                                    @foreach (var c in Model.Chairs)
                                    {
                                        <option value="@c.DentalChairId" data-room-id="@c.RoomId" selected="@(c.DentalChairId == Model.DentalChairId)">
                                            Ghế @c.ChairNumber @(c.IsOccupied ? " [Đang dùng]" : " [Trống]")
                                        </option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold">4. Thời gian bắt đầu chính thức <span class="text-danger">*</span></label>
                                <input type="datetime-local" asp-for="ScheduledStart" class="form-control form-control-lg" value="@(Model.ScheduledStart?.ToString("yyyy-MM-ddTHH:mm"))" required />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold">5. Thời gian kết thúc dự kiến <span class="text-danger">*</span></label>
                                <input type="datetime-local" asp-for="ScheduledEnd" class="form-control form-control-lg" value="@(Model.ScheduledEnd?.ToString("yyyy-MM-ddTHH:mm"))" required />
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-bold">Ghi chú điều phối (Tùy chọn):</label>
                                <input type="text" asp-for="AssignmentNote" class="form-control" placeholder="Ghi chú phân bổ trang thiết bị, vật tư cho buổi khám..." />
                            </div>

                            <div class="col-12 text-end pt-3">
                                <button type="submit" class="btn btn-success btn-lg px-5 shadow-sm fw-bold">
                                    <i class="bi bi-check-lg me-1"></i> Phê Duyệt & Xác Nhận Lịch Hẹn
                                </button>
                            </div>
                        </div>
                    </form>
                </div>

                <!-- TAB 2: ĐỀ XUẤT THAY ĐỔI -->
                <div class="tab-pane fade" id="proposeTabPane" role="tabpanel">
                    <div class="alert alert-warning border-0 mb-4">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        Sử dụng chức năng này khi <strong>Bác sĩ yêu cầu không thể tiếp nhận</strong> hoặc <strong>không còn ghế trống</strong> tại khung giờ bệnh nhân mong muốn. Hệ thống sẽ chuyển trạng thái lịch hẹn sang <em>AwaitingPatientResponse</em> để bệnh nhân xác nhận.
                    </div>

                    <form asp-action="ProposeChange" asp-route-id="@appt.AppointmentId" method="post">
                        @Html.AntiForgeryToken()
                        <div class="row g-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Bác sĩ đề xuất thay thế:</label>
                                <select asp-for="ProposedDentistUserId" class="form-select form-select-lg">
                                    <option value="">-- Giữ nguyên hoặc để khoa sắp xếp --</option>
                                    @foreach (var d in Model.Dentists)
                                    {
                                        <option value="@d.DentistUserId">
                                            @d.FullName (@d.EmployeeCode) - @(d.Specialization ?? "Bác sĩ khoa")
                                        </option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label fw-bold">Thời gian bắt đầu đề xuất:</label>
                                <input type="datetime-local" asp-for="ProposedStart" class="form-control form-control-lg" value="@(Model.ProposedStart?.ToString("yyyy-MM-ddTHH:mm"))" />
                            </div>

                            <div class="col-md-3">
                                <label class="form-label fw-bold">Thời gian kết thúc đề xuất:</label>
                                <input type="datetime-local" asp-for="ProposedEnd" class="form-control form-control-lg" value="@(Model.ProposedEnd?.ToString("yyyy-MM-ddTHH:mm"))" />
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-bold text-danger">Lý do điều chỉnh (Hiển thị trực tiếp cho bệnh nhân xem) <span class="text-danger">*</span></label>
                                <textarea asp-for="ProposalReason" class="form-control" rows="3" required placeholder="Ví dụ: Bác sĩ yêu cầu bận ca phẫu thuật phức tạp lúc 09:00, đề xuất chuyển sang Bác sĩ Thảo hoặc dời sang 14:00 cùng ngày..."></textarea>
                                <div class="form-text">Giải thích rõ ràng và lịch sự giúp bệnh nhân nhanh chóng đồng ý với phương án điều chỉnh.</div>
                            </div>

                            <div class="col-12 text-end pt-3">
                                <button type="submit" class="btn btn-warning btn-lg px-5 shadow-sm fw-bold text-dark">
                                    <i class="bi bi-send me-1"></i> Gửi Đề Xuất Cho Bệnh Nhân
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function filterChairs() {
            const roomId = document.getElementById('selectRoom').value;
            const chairSelect = document.getElementById('selectChair');
            const options = chairSelect.querySelectorAll('option[data-room-id]');

            options.forEach(opt => {
                if (!roomId || opt.getAttribute('data-room-id') === roomId) {
                    opt.style.display = '';
                } else {
                    opt.style.display = 'none';
                    if (opt.selected) {
                        chairSelect.value = '';
                    }
                }
            });
        }

        document.addEventListener('DOMContentLoaded', () => {
            filterChairs();
        });
    </script>
}
