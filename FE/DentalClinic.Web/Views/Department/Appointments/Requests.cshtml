@model DentalClinic.Web.ViewModels.Appointments.DepartmentRequestsViewModel
@{
    ViewData["Title"] = "Hàng đợi phân bổ lịch khám chuyên khoa";
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">Hàng Đợi Phân Bổ Lịch Khám</h1>
            <p class="text-muted mb-0">Bàn làm việc Trưởng khoa &bull; Xét duyệt yêu cầu, phân bổ Bác sĩ, Phòng khám và Ghế điều trị</p>
        </div>
    </div>

    @if (Model.Requests.Count == 0)
    {
        <div class="card border-0 shadow-sm text-center py-5">
            <div class="card-body">
                <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px;">
                    <i class="bi bi-check2-all fs-2 text-success"></i>
                </div>
                <h5 class="fw-bold text-dark">Đã hoàn thành toàn bộ yêu cầu</h5>
                <p class="text-muted mb-0">Hiện không có yêu cầu khám nào đang chờ Trưởng khoa phân bổ tài nguyên.</p>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0 fw-bold text-dark">
                    <i class="bi bi-clock-history me-2 text-info"></i>Yêu cầu chờ điều phối chuyên khoa (@Model.Requests.Count yêu cầu)
                </h5>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Mã Hẹn</th>
                            <th>Bệnh Nhân</th>
                            <th>Dịch Vụ Yêu Cầu</th>
                            <th>Thời Gian Mong Muốn</th>
                            <th>Bác Sĩ Mong Muốn</th>
                            <th>Lý Do Khám</th>
                            <th class="text-end pe-3">Hành Động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var req in Model.Requests)
                        {
                            <tr>
                                <td class="ps-3">
                                    <span class="fw-bold text-primary font-monospace">@req.AppointmentCode</span>
                                    <div class="text-muted small">@req.CreatedAt.ToString("dd/MM HH:mm")</div>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@req.PatientName</div>
                                    <div class="text-muted small">Mã: @req.PatientCode &bull; SĐT: @(req.PatientPhone ?? "N/A")</div>
                                </td>
                                <td>
                                    <div class="fw-semibold">@req.ServiceName</div>
                                    <div class="text-muted small">Thời lượng: @(req.DurationMinutes ?? 30) phút</div>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@(req.ScheduledStart?.ToString("dd/MM/yyyy HH:mm") ?? "--")</div>
                                    <div class="text-muted small">đến @(req.ScheduledEnd?.ToString("HH:mm") ?? "--")</div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(req.RequestedDentistName))
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                            <i class="bi bi-person me-1"></i>@req.RequestedDentistName
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border">
                                            <i class="bi bi-shuffle me-1"></i>Bác sĩ bất kỳ
                                        </span>
                                    }
                                </td>
                                <td style="max-width: 220px;">
                                    <div class="small text-truncate" title="@req.ReasonForVisit">
                                        @req.ReasonForVisit
                                    </div>
                                </td>
                                <td class="text-end pe-3">
                                    <a asp-action="Review" asp-route-id="@req.AppointmentId" class="btn btn-primary btn-sm px-3 shadow-sm">
                                        <i class="bi bi-clipboard2-pulse me-1"></i> Phân Bổ & Duyệt
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
