@{
    ViewData["Title"] = "Chấm Công & Điểm Danh";
    var role = ViewBag.Role as string ?? "";

    var todayShifts = ViewBag.TodayShifts as List<DentalClinic.Web.Models.ApiDtos.TodayShiftAttendanceDto> 
        ?? new List<DentalClinic.Web.Models.ApiDtos.TodayShiftAttendanceDto>();
    var history = ViewBag.History as List<DentalClinic.Web.Models.ApiDtos.StaffAttendanceRecordDto> 
        ?? new List<DentalClinic.Web.Models.ApiDtos.StaffAttendanceRecordDto>();
    var corrections = ViewBag.Corrections as List<DentalClinic.Web.Models.ApiDtos.AttendanceCorrectionRequestDto> 
        ?? new List<DentalClinic.Web.Models.ApiDtos.AttendanceCorrectionRequestDto>();
}

<div class="container-fluid px-4 py-3">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-clock-history text-primary me-2"></i>Chấm Công & Điểm Danh Ca Làm Việc
            </h2>
            <p class="text-muted small mb-0">Nhân viên: <strong>@ViewBag.FullName</strong> | Vai trò: <strong>@(role == "Dentist" ? "Bác sĩ nha khoa" : "Tiếp tân quầy")</strong></p>
        </div>
        <div class="mt-2 mt-md-0">
            <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#correctionModal">
                <i class="bi bi-pencil-square me-1"></i>Gửi giải trình điều chỉnh công
            </button>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Today's Assigned Shifts & Punch Action Cards -->
    <div class="row g-3 mb-4">
        <div class="col-12">
            <h5 class="fw-bold text-secondary mb-3"><i class="bi bi-calendar-event me-2"></i>Ca Làm Việc Hôm Nay (@DateTime.Now.ToString("dd/MM/yyyy"))</h5>
        </div>

        @if (todayShifts.Any())
        {
            foreach (var item in todayShifts)
            {
                var s = item.Shift;
                var r = item.AttendanceRecord;

                <div class="col-12 col-md-6 col-xl-4">
                    <div class="card h-100 shadow-sm border @(item.CanClockOut ? "border-primary" : "border-0")">
                        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                            <div>
                                <span class="badge @(role == "Dentist" ? "bg-info-subtle text-info" : "bg-primary-subtle text-primary") me-1">@s.ShiftName</span>
                                @if (!string.IsNullOrEmpty(s.DepartmentName))
                                {
                                    <small class="text-muted d-block mt-1">@s.DepartmentName</small>
                                }
                            </div>
                            <div>
                                @if (r == null)
                                {
                                    <span class="badge bg-secondary">Chưa bắt đầu</span>
                                }
                                else if (r.ActualClockIn != null && r.ActualClockOut == null)
                                {
                                    <span class="badge bg-success">Đang trong ca</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-dark border">Đã hoàn thành</span>
                                }
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div>
                                    <small class="text-muted d-block">Khung giờ quy định:</small>
                                    <span class="fw-bold fs-5 text-dark">@s.StartTime.ToString("HH:mm") - @s.EndTime.ToString("HH:mm")</span>
                                </div>
                                <div class="text-end">
                                    <small class="text-muted d-block">Giờ làm thực tế:</small>
                                    <span class="fw-bold fs-5 text-success">@(r?.WorkedHours.ToString("N1") ?? "0") h</span>
                                </div>
                            </div>

                            <div class="p-2 bg-light rounded small mb-3">
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="text-muted">Chấm vào:</span>
                                    <strong class="@(r?.LateMinutes > 0 ? "text-danger" : "text-dark")">
                                        @(r?.ClockInTimeUtc.HasValue == true ? r.ClockInTimeUtc.Value.ToString("HH:mm") : "--:--")
                                        @if (r?.LateMinutes > 0)
                                        {
                                            <span class="badge bg-danger-subtle text-danger ms-1">Trễ @(r.LateMinutes)p</span>
                                        }
                                    </strong>
                                </div>
                                <div class="d-flex justify-content-between">
                                    <span class="text-muted">Chấm ra:</span>
                                    <strong class="@(r?.EarlyLeaveMinutes > 0 ? "text-warning" : "text-dark")">
                                        @(r?.ClockOutTimeUtc.HasValue == true ? r.ClockOutTimeUtc.Value.ToString("HH:mm") : "--:--")
                                        @if (r?.EarlyLeaveMinutes > 0)
                                        {
                                            <span class="badge bg-warning-subtle text-dark ms-1">Sớm @(r.EarlyLeaveMinutes)p</span>
                                        }
                                    </strong>
                                </div>
                            </div>

                            @if (item.CanClockIn)
                            {
                                <form method="post" asp-action="ClockIn">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="shiftIdentifier" value="@s.ShiftIdentifier" />
                                    <button type="submit" class="btn btn-success w-100 py-2 fw-bold">
                                        <i class="bi bi-box-arrow-in-right me-1"></i>Chấm Công Vào Ca
                                    </button>
                                </form>
                            }
                            else if (item.CanClockOut)
                            {
                                <form method="post" asp-action="ClockOut">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="attendanceId" value="@r?.AttendanceId" />
                                    <input type="hidden" name="shiftIdentifier" value="@s.ShiftIdentifier" />
                                    <button type="submit" class="btn btn-danger w-100 py-2 fw-bold">
                                        <i class="bi bi-box-arrow-right me-1"></i>Chấm Công Ra Ca
                                    </button>
                                </form>
                            }
                            else
                            {
                                <button type="button" class="btn btn-light w-100 py-2 text-muted" disabled>
                                    <i class="bi bi-check2-circle me-1"></i>Đã Hoàn Thành Điểm Danh
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-info border-0 shadow-sm">
                    <i class="bi bi-info-circle me-2"></i>Hôm nay bạn không có ca làm việc nào được phân công.
                </div>
            </div>
        }
    </div>

    <!-- Attendance History Table -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-0 text-secondary"><i class="bi bi-clock me-2"></i>Lịch Sử Điểm Danh (30 ngày gần nhất)</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 text-center" style="font-size: 0.9rem;">
                    <thead class="table-light">
                        <tr>
                            <th>Ngày</th>
                            <th>Lịch Phân Công</th>
                            <th>Giờ Vào</th>
                            <th>Giờ Ra</th>
                            <th>Tổng Thời Gian</th>
                            <th>Trạng Thái</th>
                            <th>Điều Chỉnh / Ghi Chú</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (history.Any())
                        {
                            foreach (var h in history)
                            {
                                <tr>
                                    <td>@h.WorkDate.ToString("dd/MM/yyyy")</td>
                                    <td>@h.ScheduledStartTime.ToString("HH:mm") - @h.ScheduledEndTime.ToString("HH:mm")</td>
                                    <td>@(h.ClockInTimeUtc.HasValue ? h.ClockInTimeUtc.Value.ToString("HH:mm") : "--:--")</td>
                                    <td>@(h.ClockOutTimeUtc.HasValue ? h.ClockOutTimeUtc.Value.ToString("HH:mm") : "--:--")</td>
                                    <td class="fw-bold text-success">@h.WorkedHours.ToString("N1") h</td>
                                    <td>
                                        <span class="badge @(h.Status == "OnTime" ? "bg-success-subtle text-success" : (h.Status == "Late" ? "bg-warning-subtle text-dark" : "bg-light text-dark")) border">
                                            @h.StatusName
                                        </span>
                                    </td>
                                    <td class="text-start small text-muted">@h.AdjustmentNote</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="7" class="text-center py-3 text-muted">Chưa có lịch sử chấm công nào.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- My Corrections Table -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-0 text-secondary"><i class="bi bi-file-earmark-text me-2"></i>Yêu Cầu Giải Trình & Điều Chỉnh Đã Gửi</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 text-center" style="font-size: 0.9rem;">
                    <thead class="table-light">
                        <tr>
                            <th>Ngày Công</th>
                            <th>Giờ Vào Đề Xuất</th>
                            <th>Giờ Ra Đề Xuất</th>
                            <th>Lý Do</th>
                            <th>Trạng Thái Duyệt</th>
                            <th>Phản Hồi Từ Admin</th>
                            <th>Ngày Gửi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (corrections.Any())
                        {
                            foreach (var c in corrections)
                            {
                                <tr>
                                    <td>@c.WorkDate.ToString("dd/MM/yyyy")</td>
                                    <td>@(c.RequestedClockIn.HasValue ? c.RequestedClockIn.Value.ToString("HH:mm") : "Giữ nguyên")</td>
                                    <td>@(c.RequestedClockOut.HasValue ? c.RequestedClockOut.Value.ToString("HH:mm") : "Giữ nguyên")</td>
                                    <td class="text-start">
                                        <div class="fw-bold">@c.Reason</div>
                                        <small class="text-muted">@c.Explanation</small>
                                    </td>
                                    <td>
                                        <span class="badge @(c.Status == "Approved" ? "bg-success" : (c.Status == "Rejected" ? "bg-danger" : "bg-warning text-dark"))">
                                            @c.StatusName
                                        </span>
                                    </td>
                                    <td class="text-start small">@c.ReviewNote</td>
                                    <td>@c.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="7" class="text-center py-3 text-muted">Chưa có yêu cầu giải trình nào.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Submit Correction Request Modal -->
<div class="modal fade" id="correctionModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-action="SubmitCorrection">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-pencil-square me-2"></i>Gửi Giải Trình Điều Chỉnh Chấm Công</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Chọn ca làm việc cần điều chỉnh:</label>
                        <select name="attendanceId" class="form-select" required>
                            <option value="">-- Chọn ngày công trong lịch sử --</option>
                            @foreach (var h in history)
                            {
                                <option value="@h.AttendanceId">
                                    @h.WorkDate.ToString("dd/MM/yyyy") - (@h.ScheduledStartTime.ToString("HH:mm") - @h.ScheduledEndTime.ToString("HH:mm")) [@h.StatusName]
                                </option>
                            }
                        </select>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-bold">Giờ vào đề xuất:</label>
                            <input type="datetime-local" name="requestedClockIn" class="form-control form-control-sm" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold">Giờ ra đề xuất:</label>
                            <input type="datetime-local" name="requestedClockOut" class="form-control form-control-sm" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Lý do điều chỉnh:</label>
                        <input type="text" name="reason" class="form-control" required placeholder="Ví dụ: Quên bấm ra ca, Cấp cứu ngoài giờ..." />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Giải trình chi tiết:</label>
                        <textarea name="explanation" class="form-control" rows="3" placeholder="Mô tả cụ thể tình huống để Admin xét duyệt..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-primary btn-sm">Gửi yêu cầu điều chỉnh</button>
                </div>
            </form>
        </div>
    </div>
</div>
