<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DentalCare</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" />

    <!-- Bootstrap 5 CSS & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

    <!-- App Theme Stylesheets -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
<div class="auth-wrapper">
    <!-- Left Hero Section -->
    <div class="auth-sidebar">
        <div>
            <div class="auth-brand">
                <div class="auth-brand-logo">
                    <i class="bi bi-hospital"></i>
                </div>
                <div>
                    <div class="auth-brand-title">DentalCare</div>
                    <span class="auth-brand-subtitle">Hệ Thống Quản Lý Phòng Khám</span>
                </div>
            </div>

            <div class="mt-2">
                <span class="badge-dc badge-role-patient mb-3" style="background-color: rgba(255,255,255,0.12); color: #ffffff; border: 1px solid rgba(255,255,255,0.2);">
                    <i class="bi bi-shield-check"></i> Phòng Khám Nha Khoa Đa Chuyên Khoa
                </span>
                <h1 class="auth-hero-headline">Quản Lý Lâm Sàng & Hồ Sơ Nha Khoa Tập Trung</h1>
                <p class="auth-hero-description">
                    Số hóa hồ sơ bệnh án điện tử, theo dõi sơ đồ 32 răng chuẩn FDI, điều phối ca khám chuyên khoa và giám sát phác đồ điều trị toàn diện.
                </p>
            </div>
        </div>

        <!-- Benefit Statements -->
        <div class="auth-benefits-list">
            <div class="auth-benefit-item">
                <div class="auth-benefit-icon">
                    <i class="bi bi-shield-lock"></i>
                </div>
                <div>
                    <div class="auth-benefit-title">Bảo Mật Truy Cập Đa Vai Trò</div>
                    <div class="auth-benefit-desc">Phân quyền chặt chẽ theo vai trò y tế và mã hóa xác thực phiên làm việc.</div>
                </div>
            </div>

            <div class="auth-benefit-item">
                <div class="auth-benefit-icon">
                    <i class="bi bi-envelope-check"></i>
                </div>
                <div>
                    <div class="auth-benefit-title">Xác Thực Danh Tính OTP</div>
                    <div class="auth-benefit-desc">Xác thực danh tính qua Email và SMS OTP, bảo đảm chính xác hồ sơ bệnh nhân.</div>
                </div>
            </div>

            <div class="auth-benefit-item">
                <div class="auth-benefit-icon">
                    <i class="bi bi-journal-medical"></i>
                </div>
                <div>
                    <div class="auth-benefit-title">Hồ Sơ Bệnh Án Điện Tử (EMR)</div>
                    <div class="auth-benefit-desc">Theo dõi lịch sử khám, sơ đồ răng, đơn thuốc và kế hoạch điều trị trọn đời.</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Form Section -->
    <div class="auth-main">
        <div class="auth-card">
            <!-- Mobile Brand Header -->
            <div class="d-lg-none d-flex align-items-center gap-2 mb-4 justify-content-center">
                <div class="clinic-brand-logo" style="width: 38px; height: 38px;">
                    <i class="bi bi-hospital"></i>
                </div>
                <span class="fw-bold fs-5 text-dark">DentalCare</span>
            </div>

            <partial name="_AlertMessage" />

            @RenderBody()

            <div class="mt-4 pt-3 border-top text-center text-muted small">
                <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">
                    <i class="bi bi-arrow-left me-1"></i> Quay về Trang Chủ
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Universal Confirmation Modal -->
<partial name="_ConfirmModal" />

<!-- Bootstrap 5 JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
