@using System.Security.Claims
@{
    var role = User.FindFirst(ClaimTypes.Role)?.Value ?? "Patient";
    var fullName = User.FindFirst(ClaimTypes.Name)?.Value ?? "User";
    var avatarUrl = User.FindFirst("AvatarUrl")?.Value;
    if (string.IsNullOrEmpty(avatarUrl) || avatarUrl == "/images/default-avatar.png")
    {
        avatarUrl = "/images/default-avatar.svg";
    }
    var currentCtrl = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<aside class="app-sidebar" id="appSidebar">
    <!-- Brand Header -->
    <div class="sidebar-header">
        <div class="clinic-brand-logo">
            <i class="bi bi-hospital"></i>
        </div>
        <div class="clinic-brand-text">
            <div class="clinic-name">DentalCare</div>
            <span class="clinic-tagline">Hệ Thống Quản Lý Nha Khoa</span>
        </div>
    </div>

    <!-- Navigation Groups -->
    <div class="sidebar-nav">
        @if (role == "Patient")
        {
            <div class="nav-group-title">Tổng Quan</div>
            <a class="sidebar-link @(currentCtrl == "PatientDashboard" ? "active" : "")" asp-controller="PatientDashboard" asp-action="Dashboard">
                <i class="bi bi-grid-1x2"></i>
                <span>Cổng Bệnh Nhân</span>
            </a>

            <div class="nav-group-title">Khám & Chăm Sóc</div>
            <a class="sidebar-link @(currentCtrl == "PatientAppointment" && currentAction == "Book" ? "active" : "")" asp-controller="PatientAppointment" asp-action="Book">
                <i class="bi bi-calendar-plus"></i>
                <span>Đặt Lịch Khám</span>
            </a>
            <a class="sidebar-link @(currentCtrl == "PatientAppointment" && currentAction != "Book" ? "active" : "")" asp-controller="PatientAppointment" asp-action="Index">
                <i class="bi bi-calendar3"></i>
                <span>Lịch Khám Của Tôi</span>
            </a>
            <a class="sidebar-link @(currentCtrl == "PatientMedicalRecord" ? "active" : "")" asp-controller="PatientMedicalRecord" asp-action="Index">
                <i class="bi bi-journal-medical"></i>
                <span>Hồ Sơ Bệnh Án & Sơ Đồ Răng</span>
            </a>
            <a class="sidebar-link @(currentCtrl == "PatientPrescription" ? "active" : "")" asp-controller="PatientPrescription" asp-action="Index">
                <i class="bi bi-capsule"></i>
                <span>Đơn Thuốc Điện Tử</span>
            </a>
            <a class="sidebar-link @(currentCtrl == "PatientTreatmentPlan" ? "active" : "")" asp-controller="PatientTreatmentPlan" asp-action="Index">
                <i class="bi bi-card-checklist"></i>
                <span>Kế Hoạch Điều Trị</span>
            </a>

            <div class="nav-group-title">Quản Lý & Thông Báo</div>
            <a class="sidebar-link @(currentCtrl == "PatientInvoice" ? "active" : "")" asp-controller="PatientInvoice" asp-action="Index">
                <i class="bi bi-receipt"></i>
                <span>Hóa Đơn & Thanh Toán</span>
            </a>
            <a class="sidebar-link @(currentCtrl == "Notification" ? "active" : "")" asp-controller="Notification" asp-action="Index">
                <i class="bi bi-bell"></i>
                <span>Thông Báo Hệ Thống</span>
            </a>
        }
        else if (role == "Receptionist")
        {
            <div class="nav-group-title">Tổng Quan</div>
            <a class="sidebar-link @(currentCtrl == "ReceptionistDashboard" ? "active" : "")" asp-controller="ReceptionistDashboard" asp-action="Dashboard">
                <i class="bi bi-grid-1x2"></i>
                <span>Bàn Tiếp Đón Lễ Tân</span>
            </a>

            <div class="nav-group-title">Tiếp Nhận & Lịch Hẹn</div>
            <a class="sidebar-link @(currentCtrl == "ReceptionistAppointment" && currentAction == "TodayCheckIn" ? "active" : "")" asp-controller="ReceptionistAppointment" asp-action="TodayCheckIn">
                <i class="bi bi-person-check"></i>
                <span>Check-in Tiếp Nhận Bệnh Nhân</span>
            </a>
            <a class="sidebar-link @(currentCtrl == "ReceptionistAppointment" && currentAction == "Requests" ? "active" : "")" asp-controller="ReceptionistAppointment" asp-action="Requests">
                <i class="bi bi-calendar-check"></i>
                <span>Yêu Cầu Đặt Lịch Hẹn</span>
            </a>

            <div class="nav-group-title">Hồ Sơ & Viện Phí</div>
            <a class="sidebar-link @(currentCtrl == "ReceptionistPatient" ? "active" : "")" asp-controller="ReceptionistPatient" asp-action="Index">
                <i class="bi bi-people"></i>
                <span>Sổ Quản Lý Bệnh Nhân</span>
            </a>
            <a class="sidebar-link @(currentCtrl == "ReceptionistBilling" ? "active" : "")" asp-controller="ReceptionistBilling" asp-action="Index">
                <i class="bi bi-file-earmark-text"></i>
                <span>Hóa Đơn & Thu Viện Phí</span>
            </a>
        }
        else if (role == "Dentist")
        {
            <div class="nav-group-title">Tổng Quan</div>
            <a class="sidebar-link @(currentCtrl == "DentistDashboard" ? "active" : "")" asp-controller="DentistDashboard" asp-action="Dashboard">
                <i class="bi bi-grid-1x2"></i>
                <span>Không Gian Bác Sĩ</span>
            </a>

            <div class="nav-group-title">Khám & Điều Trị Lâm Sàng</div>
            <a class="sidebar-link @(currentCtrl == "DentistAppointment" ? "active" : "")" asp-controller="DentistAppointment" asp-action="Today">
                <i class="bi bi-calendar-check"></i>
                <span>Ca Khám Hôm Nay</span>
            </a>
            <a class="sidebar-link @(currentCtrl == "DentistMedicalRecord" ? "active" : "")" asp-controller="DentistMedicalRecord" asp-action="Index">
                <i class="bi bi-journal-medical"></i>
                <span>Hồ Sơ Bệnh Án & Sơ Đồ Răng</span>
            </a>
            <a class="sidebar-link @(currentCtrl == "DentistTreatmentPlan" && currentAction != "Sessions" ? "active" : "")" asp-controller="DentistTreatmentPlan" asp-action="Index">
                <i class="bi bi-diagram-3"></i>
                <span>Phác Đồ & Kế Hoạch Điều Trị</span>
            </a>
            <a class="sidebar-link @(currentCtrl == "DentistTreatmentPlan" && currentAction == "Sessions" ? "active" : "")" asp-controller="DentistTreatmentPlan" asp-action="Sessions">
                <i class="bi bi-clipboard2-check"></i>
                <span>Ghi Nhận Buổi Điều Trị</span>
            </a>
            <a class="sidebar-link @(currentCtrl == "DentistPrescription" ? "active" : "")" asp-controller="DentistPrescription" asp-action="Index">
                <i class="bi bi-capsule"></i>
                <span>Kê Đơn Thuốc Điện Tử</span>
            </a>
            <a class="sidebar-link" href="#" onclick="alert('Tính năng Hội Chẩn & Chuyển Khoa đang được hoàn thiện theo phân công nhiệm vụ.'); return false;">
                <i class="bi bi-arrow-left-right"></i>
                <span>Hội Chẩn & Chuyển Khoa</span>
            </a>

            <div class="nav-group-title">Lịch Trình & Đánh Giá</div>
            <a class="sidebar-link @(currentCtrl == "DentistSchedule" && currentAction == "Schedule" ? "active" : "")" asp-controller="DentistSchedule" asp-action="Schedule">
                <i class="bi bi-calendar-week"></i>
                <span>Lịch Làm Việc Của Tôi</span>
            </a>
            <a class="sidebar-link @(currentCtrl == "DentistSchedule" && currentAction == "Availability" ? "active" : "")" asp-controller="DentistSchedule" asp-action="Availability">
                <i class="bi bi-toggle-on"></i>
                <span>Trạng Thái & Nghỉ Phép</span>
            </a>
            <a class="sidebar-link @(currentCtrl == "DentistSchedule" && currentAction == "Feedback" ? "active" : "")" asp-controller="DentistSchedule" asp-action="Feedback">
                <i class="bi bi-star"></i>
                <span>Đánh Giá Từ Bệnh Nhân</span>
            </a>
        }
        else if (role == "DepartmentManager")
        {
            <div class="nav-group-title">Tổng Quan</div>
            <a class="sidebar-link @(currentCtrl == "DepartmentDashboard" ? "active" : "")" asp-controller="DepartmentDashboard" asp-action="Dashboard">
                <i class="bi bi-grid-1x2"></i>
                <span>Bàn Quản Lý Chuyên Khoa</span>
            </a>

            <div class="nav-group-title">Điều Phối Chuyên Môn</div>
            <a class="sidebar-link @(currentCtrl == "DepartmentAppointment" ? "active" : "")" asp-controller="DepartmentAppointment" asp-action="Requests">
                <i class="bi bi-check2-square"></i>
                <span>Duyệt & Phân Bổ Ca Khám</span>
            </a>
            <a class="sidebar-link" href="#" onclick="alert('Tính năng Hội Chẩn & Chuyển Khoa đang được hoàn thiện theo phân công nhiệm vụ.'); return false;">
                <i class="bi bi-arrow-left-right"></i>
                <span>Xử Lý Ca Chuyển Khoa</span>
            </a>
            <a class="sidebar-link @(currentCtrl == "DepartmentTreatment" ? "active" : "")" asp-controller="DepartmentTreatment" asp-action="Index">
                <i class="bi bi-graph-up"></i>
                <span>Giám Sát Tiến Độ Điều Trị</span>
            </a>

            <div class="nav-group-title">Vận Hành Chuyên Khoa</div>
            <a class="sidebar-link" href="#" onclick="alert('Tính năng Phân Bổ Bác Sĩ đang được hoàn thiện theo phân công nhiệm vụ.'); return false;">
                <i class="bi bi-person-plus"></i>
                <span>Phân Bổ Bác Sĩ</span>
            </a>
            <a class="sidebar-link @(currentCtrl == "DepartmentSchedule" ? "active" : "")" asp-controller="DepartmentSchedule" asp-action="Index">
                <i class="bi bi-calendar-range"></i>
                <span>Lịch Trực Bác Sĩ</span>
            </a>
            <a class="sidebar-link" href="#" onclick="alert('Tính năng Dịch Vụ & Bảng Giá Khoa đang được hoàn thiện theo phân công nhiệm vụ.'); return false;">
                <i class="bi bi-tags"></i>
                <span>Dịch Vụ & Bảng Giá Khoa</span>
            </a>
            <a class="sidebar-link @(currentCtrl == "DepartmentReport" ? "active" : "")" asp-controller="DepartmentReport" asp-action="Performance">
                <i class="bi bi-file-earmark-bar-graph"></i>
                <span>Báo Cáo Hiệu Suất Khoa</span>
            </a>
        }
        else if (role == "SystemAdministrator")
        {
            <div class="nav-group-title">Tổng quan</div>
            <a class="sidebar-link @(currentCtrl == "AdminDashboard" && currentAction == "Dashboard" ? "active" : "")" asp-controller="AdminDashboard" asp-action="Dashboard">
                <i class="bi bi-grid-1x2"></i>
                <span>Admin Console</span>
            </a>

            <div class="nav-group-title">Quản trị Danh mục</div>
            <a class="sidebar-link @(currentCtrl == "AdminDepartment" ? "active" : "")" asp-controller="AdminDepartment" asp-action="Index">
                <i class="bi bi-hospital"></i>
                <span>Quản lý Chuyên khoa</span>
            </a>
            <a class="sidebar-link @(currentCtrl == "AdminService" ? "active" : "")" asp-controller="AdminService" asp-action="Index">
                <i class="bi bi-tags"></i>
                <span>Danh mục Dịch vụ</span>
            </a>
            <a class="sidebar-link @(currentCtrl == "AdminRoomChair" ? "active" : "")" asp-controller="AdminRoomChair" asp-action="Index">
                <i class="bi bi-door-open"></i>
                <span>Phòng & Ghế nha khoa</span>
            </a>

            <div class="nav-group-title">Người dùng & Phân quyền</div>
            <a class="sidebar-link @(currentCtrl == "AdminUser" ? "active" : "")" asp-controller="AdminUser" asp-action="Index">
                <i class="bi bi-people"></i>
                <span>Tài khoản Người dùng</span>
            </a>

            <div class="nav-group-title">Báo cáo & Giám sát</div>
            <a class="sidebar-link @(currentCtrl == "AdminReport" ? "active" : "")" asp-controller="AdminReport" asp-action="Revenue">
                <i class="bi bi-bar-chart-line"></i>
                <span>Báo Cáo Doanh Thu</span>
            </a>
            <a class="sidebar-link @(currentCtrl == "AdminDashboard" && currentAction == "Reports" ? "active" : "")" asp-controller="AdminDashboard" asp-action="Reports">
                <i class="bi bi-graph-up-arrow"></i>
                <span>Tổng Quan Ca Khám</span>
            </a>
            <a class="sidebar-link @(currentCtrl == "AdminAuditLog" ? "active" : "")" asp-controller="AdminAuditLog" asp-action="Index">
                <i class="bi bi-shield-check"></i>
                <span>Nhật ký Kiểm toán (Logs)</span>
            </a>
        }

        <!-- Account Section Shared Across Roles -->
        <div class="nav-group-title">Tài Khoản</div>
        <a class="sidebar-link @(currentCtrl == "Profile" ? "active" : "")" asp-controller="Profile" asp-action="Index">
            <i class="bi bi-person-circle"></i>
            <span>Hồ Sơ Của Tôi</span>
        </a>
        <a class="sidebar-link @(currentCtrl == "Account" && currentAction == "ChangePassword" ? "active" : "")" asp-controller="Account" asp-action="ChangePassword">
            <i class="bi bi-key"></i>
            <span>Đổi Mật Khẩu</span>
        </a>
    </div>

    <!-- Mini Profile Footer -->
    <div class="sidebar-footer">
        <div class="sidebar-mini-profile">
            <img src="@avatarUrl" alt="Avatar" class="sidebar-avatar" onerror="this.src='/images/default-avatar.svg'" />
            <div class="sidebar-user-meta">
                <div class="sidebar-user-name" title="@fullName">@fullName</div>
                <div class="sidebar-user-role">@role</div>
            </div>
        </div>
        <form method="post" asp-controller="Account" asp-action="Logout" class="m-0 p-0 d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-link text-secondary p-0 border-0" title="Đăng Xuất" data-confirm="Bạn có chắc chắn muốn đăng xuất khỏi hệ thống phòng khám DentalCare không?">
                <i class="bi bi-box-arrow-right fs-6"></i>
            </button>
        </form>
    </div>
</aside>
