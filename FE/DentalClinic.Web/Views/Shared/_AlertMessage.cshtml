<!-- Universal App Toast Container (Top Right Floating Notifications) -->
<div class="toast-container position-fixed top-0 end-0 p-3" id="appToastContainer" style="z-index: 1095;">
@if (TempData["SuccessMessage"] != null)
{
    <div class="toast show align-items-center shadow-lg rounded-3 mb-2 bg-white border-start border-4 border-success dc-toast" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="5000">
        <div class="toast-header bg-transparent border-0 pb-0 pt-2 px-3">
            <i class="bi bi-check-circle-fill text-success me-2 fs-5"></i>
            <strong class="me-auto text-dark small fw-bold">Thành Công</strong>
            <small class="text-muted" style="font-size: 0.725rem;">Vừa xong</small>
            <button type="button" class="btn-close ms-2" data-bs-dismiss="toast" aria-label="Đóng"></button>
        </div>
        <div class="toast-body pt-1 pb-3 px-3 text-secondary" style="font-size: 0.875rem;">
            @TempData["SuccessMessage"]
        </div>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="toast show align-items-center shadow-lg rounded-3 mb-2 bg-white border-start border-4 border-danger dc-toast" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="6500">
        <div class="toast-header bg-transparent border-0 pb-0 pt-2 px-3">
            <i class="bi bi-x-circle-fill text-danger me-2 fs-5"></i>
            <strong class="me-auto text-dark small fw-bold">Thông Báo Lỗi</strong>
            <small class="text-muted" style="font-size: 0.725rem;">Vừa xong</small>
            <button type="button" class="btn-close ms-2" data-bs-dismiss="toast" aria-label="Đóng"></button>
        </div>
        <div class="toast-body pt-1 pb-3 px-3 text-secondary" style="font-size: 0.875rem;">
            @TempData["ErrorMessage"]
        </div>
    </div>
}

@if (TempData["WarningMessage"] != null)
{
    <div class="toast show align-items-center shadow-lg rounded-3 mb-2 bg-white border-start border-4 border-warning dc-toast" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="5500">
        <div class="toast-header bg-transparent border-0 pb-0 pt-2 px-3">
            <i class="bi bi-exclamation-triangle-fill text-warning me-2 fs-5"></i>
            <strong class="me-auto text-dark small fw-bold">Cảnh Báo</strong>
            <small class="text-muted" style="font-size: 0.725rem;">Vừa xong</small>
            <button type="button" class="btn-close ms-2" data-bs-dismiss="toast" aria-label="Đóng"></button>
        </div>
        <div class="toast-body pt-1 pb-3 px-3 text-secondary" style="font-size: 0.875rem;">
            @TempData["WarningMessage"]
        </div>
    </div>
}

@if (TempData["InfoMessage"] != null)
{
    <div class="toast show align-items-center shadow-lg rounded-3 mb-2 bg-white border-start border-4 border-info dc-toast" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="5000">
        <div class="toast-header bg-transparent border-0 pb-0 pt-2 px-3">
            <i class="bi bi-info-circle-fill text-info me-2 fs-5"></i>
            <strong class="me-auto text-dark small fw-bold">Thông Báo</strong>
            <small class="text-muted" style="font-size: 0.725rem;">Vừa xong</small>
            <button type="button" class="btn-close ms-2" data-bs-dismiss="toast" aria-label="Đóng"></button>
        </div>
        <div class="toast-body pt-1 pb-3 px-3 text-secondary" style="font-size: 0.875rem;">
            @TempData["InfoMessage"]
        </div>
    </div>
}
</div>
