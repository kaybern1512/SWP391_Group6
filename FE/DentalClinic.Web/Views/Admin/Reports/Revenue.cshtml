@model DentalClinic.Web.Models.Reports.RevenueReportDto
@{
    ViewData["Title"] = "Báo Cáo Phân Tích Doanh Thu";
    var departments = ViewBag.Departments as List<DentalClinic.Web.Models.ApiDtos.DepartmentDto> ?? new();
    var selectedDeptId = ViewBag.SelectedDepartmentId as long?;
    var fromDate = ViewBag.FromDate as string;
    var toDate = ViewBag.ToDate as string;

    var recoveryRate = Model.TotalRevenue > 0 ? Math.Round((double)(Model.TotalPaid * 100 / Model.TotalRevenue), 1) : 0;
}

<div class="container-fluid px-0">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-graph-up-arrow text-primary me-2"></i>Báo Cáo & Phân Tích Doanh Thu
            </h1>
            <p class="text-muted mb-0">Hệ thống phân tích tài chính &bull; Biểu đồ doanh thu theo thời gian, tỷ trọng chuyên khoa và xuất file Excel / CSV</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="ExportRevenueXlsx"
               asp-route-fromDate="@fromDate"
               asp-route-toDate="@toDate"
               asp-route-departmentId="@selectedDeptId"
               class="btn btn-success shadow-sm">
                <i class="bi bi-file-earmark-spreadsheet me-1"></i> Xuất Excel (.xlsx)
            </a>
            <a asp-action="ExportRevenueCsv"
               asp-route-fromDate="@fromDate"
               asp-route-toDate="@toDate"
               asp-route-departmentId="@selectedDeptId"
               class="btn btn-outline-success shadow-sm">
                <i class="bi bi-file-earmark-text me-1"></i> Xuất CSV (UTF-8)
            </a>
        </div>
    </div>

    <!-- Alert Messages -->
    <partial name="_AlertMessage" />

    <!-- Filter Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Revenue" class="row g-2 align-items-end">
                <div class="col-12 col-md-3">
                    <label class="form-label small text-muted mb-1">Từ ngày</label>
                    <input type="date" name="fromDate" value="@fromDate" class="form-control form-control-sm" />
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label small text-muted mb-1">Đến ngày</label>
                    <input type="date" name="toDate" value="@toDate" class="form-control form-control-sm" />
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label small text-muted mb-1">Lọc theo chuyên khoa</label>
                    <select name="departmentId" class="form-select form-select-sm">
                        <option value="">-- Tất cả các chuyên khoa --</option>
                        @foreach (var d in departments)
                        {
                            <option value="@d.DepartmentId" selected="@(selectedDeptId == d.DepartmentId)">@d.Name</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-sm px-3 flex-grow-1">
                        <i class="bi bi-funnel me-1"></i> Áp dụng
                    </button>
                    <a asp-action="Revenue" class="btn btn-light btn-sm px-3 border" title="Đặt lại">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Stat KPI Cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 border-start border-4 border-primary">
                <div class="card-body">
                    <span class="text-muted small text-uppercase fw-semibold">Tổng Doanh Thu Hóa Đơn</span>
                    <h3 class="fw-bold text-primary mb-1 mt-1">@Model.TotalRevenue.ToString("N0") đ</h3>
                    <div class="small text-muted"><i class="bi bi-receipt me-1"></i>@Model.TotalInvoices hóa đơn phát sinh</div>
                    @if (Model.PreviousPeriodRevenue > 0)
                    {
                        <div class="small mt-1 pt-1 border-top">
                            @if (Model.RevenueGrowthPercentage >= 0)
                            {
                                <span class="text-success fw-semibold"><i class="bi bi-arrow-up-right"></i> +@Model.RevenueGrowthPercentage%</span>
                            }
                            else
                            {
                                <span class="text-danger fw-semibold"><i class="bi bi-arrow-down-right"></i> @Model.RevenueGrowthPercentage%</span>
                            }
                            <span class="text-muted ms-1">(Kỳ trước: @Model.PreviousPeriodRevenue.ToString("N0") đ)</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 border-start border-4 border-success">
                <div class="card-body">
                    <span class="text-muted small text-uppercase fw-semibold">Số Tiền Thực Thu</span>
                    <h3 class="fw-bold text-success mb-1 mt-1">@Model.TotalPaid.ToString("N0") đ</h3>
                    <div class="small text-success fw-semibold"><i class="bi bi-check-circle me-1"></i>@recoveryRate% tổng viện phí</div>
                    @if (Model.PreviousPeriodPaid > 0)
                    {
                        <div class="small mt-1 pt-1 border-top">
                            @if (Model.PaidGrowthPercentage >= 0)
                            {
                                <span class="text-success fw-semibold"><i class="bi bi-arrow-up-right"></i> +@Model.PaidGrowthPercentage%</span>
                            }
                            else
                            {
                                <span class="text-danger fw-semibold"><i class="bi bi-arrow-down-right"></i> @Model.PaidGrowthPercentage%</span>
                            }
                            <span class="text-muted ms-1">(Kỳ trước: @Model.PreviousPeriodPaid.ToString("N0") đ)</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 border-start border-4 border-danger">
                <div class="card-body">
                    <span class="text-muted small text-uppercase fw-semibold">Số Tiền Còn Chờ Thu</span>
                    <h3 class="fw-bold text-danger mb-1 mt-1">@Model.TotalRemaining.ToString("N0") đ</h3>
                    <div class="small text-muted">
                        <i class="bi bi-hourglass-split me-1"></i>@Model.UnpaidInvoices HĐ chưa trả, @Model.PartiallyPaidInvoices HĐ cọc
                        @if (Model.CancelledInvoices > 0)
                        {
                            <span class="badge bg-secondary-subtle text-secondary border small ms-1">@Model.CancelledInvoices HĐ hủy</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 border-start border-4 border-info">
                <div class="card-body">
                    <span class="text-muted small text-uppercase fw-semibold">Hóa Đơn Hoàn Tất</span>
                    <h3 class="fw-bold text-dark mb-1 mt-1">@Model.PaidInvoices</h3>
                    <div class="small text-muted">trên tổng số @Model.TotalInvoices hóa đơn</div>
                    <div class="small text-muted mt-1 pt-1 border-top">
                        <i class="bi bi-clock-history me-1"></i>Từ @(Model.FromDate?.ToString("dd/MM/yyyy") ?? "--") đến @(Model.ToDate?.ToString("dd/MM/yyyy") ?? "--")
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row -->
    <div class="row g-4 mb-4">
        <!-- Line Chart: Revenue Trend (Day / Week / Month) -->
        <div class="col-12 col-xl-8">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-header bg-white py-3 d-flex flex-wrap justify-content-between align-items-center gap-2 border-bottom">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-activity text-primary fs-5"></i>
                        <h5 class="card-title mb-0 fw-bold text-dark" id="chartTitle">Xu Hướng Doanh Thu Theo Ngày</h5>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <div class="btn-group btn-group-sm" role="group" aria-label="Kỳ hiển thị">
                            <button type="button" class="btn btn-outline-primary active" id="btnDaily">Ngày</button>
                            <button type="button" class="btn btn-outline-primary" id="btnWeekly">Tuần</button>
                            <button type="button" class="btn btn-outline-primary" id="btnMonthly">Tháng</button>
                        </div>
                    </div>
                </div>
                <div class="card-body p-3">
                    <div style="height: 320px; position: relative;">
                        <canvas id="revenueLineChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Doughnut Chart: Department Distribution -->
        <div class="col-12 col-xl-4">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
                    <h5 class="card-title mb-0 fw-bold text-dark">
                        <i class="bi bi-pie-chart text-success me-2"></i>Tỷ Trọng Theo Chuyên Khoa
                    </h5>
                    <span class="badge bg-light text-muted border font-monospace">Doughnut</span>
                </div>
                <div class="card-body p-3 d-flex flex-column justify-content-center">
                    <div style="height: 240px; position: relative;">
                        <canvas id="departmentDoughnutChart"></canvas>
                    </div>
                    <div class="mt-3">
                        <ul class="list-unstyled mb-0 small">
                            @foreach (var dept in Model.DepartmentDistribution.Take(4))
                            {
                                <li class="d-flex justify-content-between py-1 border-bottom">
                                    <span class="fw-semibold">@dept.DepartmentName</span>
                                    <span>@dept.TotalRevenue.ToString("N0") đ (@dept.RevenuePercentage%)</span>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Details Table -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-header bg-white py-3 d-flex flex-wrap justify-content-between align-items-center gap-2 border-bottom">
            <div>
                <h5 class="card-title mb-0 fw-bold text-dark">
                    <i class="bi bi-table text-primary me-2"></i>Chi Tiết Hóa Đơn Trong Kỳ Báo Cáo (@Model.Invoices.Count hóa đơn)
                </h5>
                <span class="text-muted small">Từ ngày @(Model.FromDate?.ToString("dd/MM/yyyy") ?? "--") đến @(Model.ToDate?.ToString("dd/MM/yyyy") ?? "--")</span>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="ExportRevenueXlsx"
                   asp-route-fromDate="@fromDate"
                   asp-route-toDate="@toDate"
                   asp-route-departmentId="@selectedDeptId"
                   class="btn btn-outline-success btn-sm">
                    <i class="bi bi-file-earmark-spreadsheet me-1"></i> Tải bảng tính Excel (.xlsx)
                </a>
                <a asp-action="ExportRevenueCsv"
                   asp-route-fromDate="@fromDate"
                   asp-route-toDate="@toDate"
                   asp-route-departmentId="@selectedDeptId"
                   class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-download me-1"></i> Tải CSV
                </a>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Mã Hóa Đơn</th>
                        <th>Bệnh Nhân</th>
                        <th>Chuyên Khoa & Bác Sĩ</th>
                        <th>Ngày Lập</th>
                        <th class="text-end">Tổng Tiền</th>
                        <th class="text-end">Đã Thu</th>
                        <th class="text-end">Còn Lại</th>
                        <th class="text-center">Trạng Thái</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Invoices.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">
                                Không có phát sinh hóa đơn trong khoảng thời gian đã chọn.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var inv in Model.Invoices)
                        {
                            <tr>
                                <td class="ps-3">
                                    <a asp-controller="ReceptionistBilling" asp-action="Detail" asp-route-id="@inv.InvoiceId" class="fw-bold font-monospace text-primary text-decoration-none">
                                        @inv.InvoiceCode
                                    </a>
                                </td>
                                <td>
                                    <div class="fw-semibold">@inv.PatientName</div>
                                    <div class="small text-muted"><i class="bi bi-telephone me-1"></i>@(inv.PatientPhoneNumber ?? "--")</div>
                                </td>
                                <td>
                                    <div>@inv.DepartmentName</div>
                                    <div class="small text-muted"><i class="bi bi-person me-1"></i>@inv.DentistName</div>
                                </td>
                                <td>
                                    <div class="small">@inv.CreatedAt.ToString("dd/MM/yyyy")</div>
                                    <div class="small text-muted">@inv.CreatedAt.ToString("HH:mm")</div>
                                </td>
                                <td class="text-end fw-bold">@inv.TotalAmount.ToString("N0") đ</td>
                                <td class="text-end fw-semibold text-success">@inv.PaidAmount.ToString("N0") đ</td>
                                <td class="text-end fw-bold @(inv.RemainingAmount > 0 ? "text-danger" : "text-muted")">
                                    @inv.RemainingAmount.ToString("N0") đ
                                </td>
                                <td class="text-center">
                                    @if (inv.Status == "Paid")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Đã đủ</span>
                                    }
                                    else if (inv.Status == "PartiallyPaid")
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1">Đặt cọc</span>
                                    }
                                    else if (inv.Status == "Cancelled")
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">Đã hủy</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">Chưa thu</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Trend data sets
            const dailyLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DailyTrend.Select(d => d.DisplayDate)));
            const dailyRevenueData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DailyTrend.Select(d => d.Revenue)));
            const dailyPaidData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DailyTrend.Select(d => d.PaidAmount)));

            const weeklyLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.WeeklyTrend.Select(w => w.WeekLabel)));
            const weeklyRevenueData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.WeeklyTrend.Select(w => w.Revenue)));
            const weeklyPaidData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.WeeklyTrend.Select(w => w.PaidAmount)));

            const monthlyLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyTrend.Select(m => m.MonthLabel)));
            const monthlyRevenueData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyTrend.Select(m => m.Revenue)));
            const monthlyPaidData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyTrend.Select(m => m.PaidAmount)));

            const ctxLine = document.getElementById('revenueLineChart').getContext('2d');
            const lineChart = new Chart(ctxLine, {
                type: 'line',
                data: {
                    labels: dailyLabels,
                    datasets: [
                        {
                            label: 'Doanh thu phát sinh (VNĐ)',
                            data: dailyRevenueData,
                            borderColor: '#0d6efd',
                            backgroundColor: 'rgba(13, 110, 253, 0.1)',
                            fill: true,
                            tension: 0.3,
                            borderWidth: 2,
                            pointRadius: 3
                        },
                        {
                            label: 'Thực thu tiền mặt/chuyển khoản (VNĐ)',
                            data: dailyPaidData,
                            borderColor: '#198754',
                            backgroundColor: 'rgba(25, 135, 84, 0.05)',
                            borderDash: [5, 5],
                            tension: 0.3,
                            borderWidth: 2,
                            pointRadius: 2
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'top' },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return context.dataset.label + ': ' + new Intl.NumberFormat('vi-VN').format(context.raw) + ' đ';
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(value) {
                                    if (value >= 1000000) return (value / 1000000) + ' tr';
                                    if (value >= 1000) return (value / 1000) + ' k';
                                    return value;
                                }
                            }
                        }
                    }
                }
            });

            // Toggle Day / Week / Month
            const btnDaily = document.getElementById('btnDaily');
            const btnWeekly = document.getElementById('btnWeekly');
            const btnMonthly = document.getElementById('btnMonthly');
            const chartTitle = document.getElementById('chartTitle');

            function setActiveButton(btn) {
                [btnDaily, btnWeekly, btnMonthly].forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
            }

            if (btnDaily && btnWeekly && btnMonthly) {
                btnDaily.addEventListener('click', function() {
                    setActiveButton(btnDaily);
                    chartTitle.textContent = 'Xu Hướng Doanh Thu Theo Ngày';
                    lineChart.data.labels = dailyLabels;
                    lineChart.data.datasets[0].data = dailyRevenueData;
                    lineChart.data.datasets[1].data = dailyPaidData;
                    lineChart.update();
                });

                btnWeekly.addEventListener('click', function() {
                    setActiveButton(btnWeekly);
                    chartTitle.textContent = 'Xu Hướng Doanh Thu Theo Tuần';
                    lineChart.data.labels = weeklyLabels;
                    lineChart.data.datasets[0].data = weeklyRevenueData;
                    lineChart.data.datasets[1].data = weeklyPaidData;
                    lineChart.update();
                });

                btnMonthly.addEventListener('click', function() {
                    setActiveButton(btnMonthly);
                    chartTitle.textContent = 'Xu Hướng Doanh Thu Theo Tháng';
                    lineChart.data.labels = monthlyLabels;
                    lineChart.data.datasets[0].data = monthlyRevenueData;
                    lineChart.data.datasets[1].data = monthlyPaidData;
                    lineChart.update();
                });
            }

            // Doughnut Chart: Department Distribution
            const doughnutLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DepartmentDistribution.Select(d => d.DepartmentName)));
            const doughnutData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DepartmentDistribution.Select(d => d.TotalRevenue)));

            const ctxDoughnut = document.getElementById('departmentDoughnutChart').getContext('2d');
            new Chart(ctxDoughnut, {
                type: 'doughnut',
                data: {
                    labels: doughnutLabels.length ? doughnutLabels : ['Không có số liệu'],
                    datasets: [{
                        data: doughnutData.length ? doughnutData : [1],
                        backgroundColor: [
                            '#0d6efd', '#20c997', '#ffc107', '#fd7e14', '#6f42c1', '#d63384', '#0dcaf0'
                        ],
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    const val = context.raw;
                                    return context.label + ': ' + new Intl.NumberFormat('vi-VN').format(val) + ' đ';
                                }
                            }
                        }
                    },
                    cutout: '65%'
                }
            });
        });
    </script>
}
