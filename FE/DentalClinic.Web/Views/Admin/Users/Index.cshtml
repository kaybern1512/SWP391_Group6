@model UserManageViewModel
@{
    ViewData["Title"] = "Quản lý Tài khoản & Phân quyền";
}

<div class="container-fluid p-0">
    <!-- Header -->
    <div class="page-header-dc">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <a asp-controller="AdminDashboard" asp-action="Dashboard" class="text-decoration-none text-muted small">
                    <i class="bi bi-chevron-left"></i> Tổng quan
                </a>
                <span class="text-muted small">&bull;</span>
                <span class="badge-dc badge-role-systemadministrator">Bảo mật & Người dùng</span>
            </div>
            <h1 class="page-title">Quản lý Tài khoản & Quyền hạn Cán bộ Nhân viên</h1>
            <p class="page-subtitle">Mô hình 4 vai trò chuẩn: Bệnh nhân, Bác sĩ, Lễ tân và Quản trị viên. Quản lý phân quyền và thông tin nhân viên.</p>
        </div>
        <div class="page-actions">
            <button type="button" class="btn btn-dc-primary" data-bs-toggle="modal" data-bs-target="#createStaffModal">
                <i class="bi bi-person-plus me-1"></i> Thêm Nhân Viên Mới
            </button>
        </div>
    </div>

    <!-- Filter & Search Bar -->
    <div class="card-dc mb-4">
        <div class="card-dc-body p-3">
            <form asp-controller="AdminUser" asp-action="Index" method="get" class="row g-2 align-items-center">
                <div class="col-md-4">
                    <label class="form-label small fw-semibold text-muted mb-1">Lọc theo vai trò (Role)</label>
                    <select name="role" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="">-- Tất cả vai trò --</option>
                        <option value="Patient" selected="@(Model.RoleFilter == "Patient")">Bệnh nhân (Patient)</option>
                        <option value="Dentist" selected="@(Model.RoleFilter == "Dentist")">Bác sĩ nha khoa (Dentist)</option>
                        <option value="Receptionist" selected="@(Model.RoleFilter == "Receptionist")">Lễ tân (Receptionist)</option>
                        <option value="SystemAdministrator" selected="@(Model.RoleFilter == "SystemAdministrator")">Quản trị viên (SystemAdministrator)</option>
                    </select>
                </div>
                <div class="col-md-5">
                    <label class="form-label small fw-semibold text-muted mb-1">Tìm kiếm theo tên / email / SĐT</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" name="search" class="form-control" placeholder="Nhập tên, email hoặc số điện thoại..." value="@Model.SearchKeyword" />
                    </div>
                </div>
                <div class="col-md-3 d-flex align-items-end gap-2 pt-3">
                    <button type="submit" class="btn btn-sm btn-dc-primary">
                        <i class="bi bi-filter me-1"></i> Tìm kiếm
                    </button>
                    <a asp-controller="AdminUser" asp-action="Index" class="btn btn-sm btn-outline-secondary">
                        Đặt lại
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Users Table -->
    <div class="card-dc">
        <div class="card-dc-header d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-people text-warning"></i>
                <span class="fw-bold">Danh sách Tài khoản Người dùng (@Model.Users.Count)</span>
            </div>
        </div>
        <div class="card-dc-body p-0">
            <div class="table-responsive">
                <table class="table-dc mb-0">
                    <thead>
                        <tr>
                            <th style="width: 50px;">#</th>
                            <th>Mã định danh</th>
                            <th>Họ và tên</th>
                            <th>Email & Điện thoại</th>
                            <th>Vai trò (Role)</th>
                            <th>Chuyên môn / Ghi chú</th>
                            <th>Trạng thái</th>
                            <th>Ngày tạo</th>
                            <th class="text-end">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Users.Any())
                        {
                            int uIdx = 1;
                            foreach (var u in Model.Users)
                            {
                                <tr>
                                    <td class="text-muted fw-bold">@(uIdx++)</td>
                                    <td>
                                        <div class="fw-bold text-dark">@(string.IsNullOrEmpty(u.Code) ? $"UID-{u.UserId}" : u.Code)</div>
                                        <div class="text-muted small">ID: @u.UserId</div>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark">@u.FullName</div>
                                    </td>
                                    <td>
                                        <div><i class="bi bi-envelope me-1 text-muted"></i>@(u.Email ?? "—")</div>
                                        @if (!string.IsNullOrEmpty(u.PhoneNumber))
                                        {
                                            <div class="text-muted small"><i class="bi bi-telephone me-1"></i>@u.PhoneNumber</div>
                                        }
                                    </td>
                                    <td>
                                        @if (u.Role == "Patient")
                                        {
                                            <span class="badge bg-primary-subtle text-primary border">Bệnh nhân</span>
                                        }
                                        else if (u.Role == "Dentist")
                                        {
                                            <span class="badge bg-success-subtle text-success border">Bác sĩ nha khoa</span>
                                        }
                                        else if (u.Role == "Receptionist")
                                        {
                                            <span class="badge bg-info-subtle text-info border">Lễ tân phòng khám</span>
                                        }
                                        else if (u.Role == "SystemAdministrator")
                                        {
                                            <span class="badge bg-danger-subtle text-danger border">Quản trị viên (Admin)</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark border">@u.Role</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(u.Specialty))
                                        {
                                            <span class="badge bg-light text-dark border">
                                                <i class="bi bi-award me-1 text-primary"></i>@u.Specialty
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">—</span>
                                        }
                                    </td>
                                    <td>
                                        @if (u.Status == "Active")
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                <i class="bi bi-check-circle me-1"></i> Hoạt động
                                            </span>
                                        }
                                        else if (u.Status == "Locked")
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                                <i class="bi bi-lock me-1"></i> Đang bị khóa
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
                                                @u.Status
                                            </span>
                                        }
                                    </td>
                                    <td class="text-nowrap small text-muted">
                                        @u.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                    </td>
                                    <td class="text-end text-nowrap">
                                        @if (u.Role != "Patient")
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-primary me-1 btn-edit-staff"
                                                    data-id="@u.UserId"
                                                    data-name="@u.FullName"
                                                    data-phone="@u.PhoneNumber"
                                                    data-role="@u.Role"
                                                    data-specialty="@u.Specialty">
                                                <i class="bi bi-pencil-square"></i> Sửa
                                            </button>
                                        }
                                        <button type="button" class="btn btn-sm @(u.Status == "Locked" ? "btn-outline-success" : "btn-outline-danger") btn-toggle-lock"
                                                data-id="@u.UserId"
                                                data-name="@u.FullName"
                                                data-status="@u.Status">
                                            <i class="bi @(u.Status == "Locked" ? "bi-unlock" : "bi-lock")"></i>
                                            @(u.Status == "Locked" ? "Mở khóa" : "Khóa")
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center py-4 text-muted">
                                    <i class="bi bi-people fs-3 d-block mb-1"></i>
                                    Không tìm thấy tài khoản người dùng nào phù hợp.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Thêm Cán Bộ Nhân Viên Mới -->
<div class="modal fade" id="createStaffModal" tabindex="-1" aria-labelledby="createStaffLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form asp-controller="AdminUser" asp-action="CreateStaff" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnRole" value="@Model.RoleFilter" />
                <input type="hidden" name="returnSearch" value="@Model.SearchKeyword" />
                <div class="modal-header">
                    <h5 class="modal-title font-heading" id="createStaffLabel">
                        <i class="bi bi-person-plus text-primary me-2"></i>Thêm Mới Cán Bộ Nhân Viên
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Vai trò nhân viên <span class="text-danger">*</span></label>
                            <select name="Role" id="staffRoleSelect" class="form-select" required>
                                <option value="Dentist">Bác sĩ nha khoa (Dentist)</option>
                                <option value="Receptionist">Lễ tân phòng khám (Receptionist)</option>
                                <option value="SystemAdministrator">Quản trị viên (SystemAdministrator)</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Họ và tên <span class="text-danger">*</span></label>
                            <input type="text" name="FullName" class="form-control" placeholder="Ví dụ: Bác sĩ Nguyễn Văn A" required maxlength="100" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Địa chỉ Email (Đăng nhập) <span class="text-danger">*</span></label>
                            <input type="email" name="Email" class="form-control" placeholder="bacsi@dentalcare.com" required maxlength="256" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Mật khẩu khởi tạo <span class="text-danger">*</span></label>
                            <input type="password" name="Password" class="form-control" placeholder="Tối thiểu 6 ký tự..." required minlength="6" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Số điện thoại liên hệ</label>
                            <input type="tel" name="PhoneNumber" class="form-control" placeholder="0901234567" maxlength="20" />
                        </div>
                        <div class="col-md-6" id="dentistDeptBlock">
                            <label class="form-label fw-semibold">Chuyên khoa trực thuộc (nếu là Bác sĩ)</label>
                            <select name="DepartmentId" class="form-select">
                                <option value="">-- Chọn chuyên khoa --</option>
                                @foreach (var d in Model.Departments)
                                {
                                    <option value="@d.DepartmentId">@d.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-12" id="dentistSpecialtyBlock">
                            <label class="form-label fw-semibold">Trình độ / Chuyên môn / Chứng chỉ hành nghề</label>
                            <input type="text" name="Specialty" class="form-control" placeholder="Ví dụ: Thạc sĩ Bác sĩ Chỉnh nha, Chứng chỉ Cấy ghép Implant Quốc tế..." maxlength="200" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-dc-primary">Tạo Tài Khoản Nhân Viên</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Sửa Thông Tin Cán Bộ Nhân Viên -->
<div class="modal fade" id="editStaffModal" tabindex="-1" aria-labelledby="editStaffLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="editStaffForm" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnRole" value="@Model.RoleFilter" />
                <input type="hidden" name="returnSearch" value="@Model.SearchKeyword" />
                <div class="modal-header">
                    <h5 class="modal-title font-heading" id="editStaffLabel">
                        <i class="bi bi-pencil-square text-primary me-2"></i>Cập Nhật Thông Tin Nhân Viên
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Họ và tên <span class="text-danger">*</span></label>
                        <input type="text" name="FullName" id="editStaffFullName" class="form-control" required maxlength="100" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Số điện thoại</label>
                        <input type="tel" name="PhoneNumber" id="editStaffPhone" class="form-control" maxlength="20" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Vai trò (Role)</label>
                        <select name="Role" id="editStaffRole" class="form-select">
                            <option value="Dentist">Bác sĩ nha khoa (Dentist)</option>
                            <option value="Receptionist">Lễ tân phòng khám (Receptionist)</option>
                            <option value="SystemAdministrator">Quản trị viên (SystemAdministrator)</option>
                        </select>
                    </div>
                    <div class="mb-3" id="editSpecialtyWrapper">
                        <label class="form-label fw-semibold">Trình độ / Chuyên môn</label>
                        <input type="text" name="Specialty" id="editStaffSpecialty" class="form-control" maxlength="200" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-dc-primary">Lưu Thay Đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Khóa / Mở khóa tài khoản -->
<div class="modal fade" id="toggleLockModal" tabindex="-1" aria-labelledby="toggleLockLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="toggleLockForm" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnRole" value="@Model.RoleFilter" />
                <input type="hidden" name="returnSearch" value="@Model.SearchKeyword" />
                <div class="modal-header">
                    <h5 class="modal-title font-heading" id="toggleLockLabel">
                        Xác nhận thao tác tài khoản
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p id="lockConfirmText" class="mb-3"></p>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Lý do thực hiện (sẽ ghi nhận vào Audit Log):</label>
                        <textarea name="reason" class="form-control" rows="3" placeholder="Ví dụ: Yêu cầu kỷ luật nội bộ, bảo mật thông tin, nhân viên nghỉ việc..." required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" id="lockConfirmBtn" class="btn btn-danger">Xác nhận</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Lock modal
            const lockModal = new bootstrap.Modal(document.getElementById('toggleLockModal'));
            const lockForm = document.getElementById('toggleLockForm');
            const lockText = document.getElementById('lockConfirmText');
            const lockBtn = document.getElementById('lockConfirmBtn');

            document.querySelectorAll('.btn-toggle-lock').forEach(b => {
                b.addEventListener('click', function () {
                    const id = this.dataset.id;
                    const name = this.dataset.name;
                    const status = this.dataset.status;
                    const isLocked = status === 'Locked';

                    lockForm.action = '/Admin/Users/ToggleLock/' + id;
                    if (isLocked) {
                        lockText.innerHTML = `Bạn có chắc chắn muốn <strong>MỞ KHÓA</strong> tài khoản của <strong>${name}</strong>?`;
                        lockBtn.className = 'btn btn-success';
                        lockBtn.textContent = 'Xác nhận Mở Khóa';
                    } else {
                        lockText.innerHTML = `<div class="d-flex align-items-center mb-2"><div class="spinner-border spinner-border-sm text-primary me-2"></div><span class="small text-muted">Đang phân tích tác động vận hành...</span></div>Bạn có chắc chắn muốn <strong>KHÓA</strong> tài khoản của <strong>${name}</strong>?`;
                        lockBtn.className = 'btn btn-danger';
                        lockBtn.textContent = 'Xác nhận Khóa Tài Khoản';

                        fetch('/api/admin/impact/user-lock/' + id)
                            .then(r => r.json())
                            .then(data => {
                                if (data && data.success && data.data) {
                                    let html = `Bạn có chắc chắn muốn <strong>KHÓA</strong> tài khoản của <strong>${name}</strong>?`;
                                    if (data.data.warnings && data.data.warnings.length > 0) {
                                        html += `<div class="alert alert-warning mt-2 text-start small mb-0"><i class="bi bi-exclamation-triangle-fill me-1"></i><strong>Cảnh báo tác động vận hành:</strong><ul class="mb-0 ps-3 mt-1">`;
                                        data.data.warnings.forEach(w => { html += `<li>${w}</li>`; });
                                        html += `</ul></div>`;
                                    }
                                    lockText.innerHTML = html;
                                }
                            })
                            .catch(() => {
                                lockText.innerHTML = `Bạn có chắc chắn muốn <strong>KHÓA</strong> tài khoản của <strong>${name}</strong>? Người dùng sẽ không thể đăng nhập vào hệ thống.`;
                            });
                        lockBtn.className = 'btn btn-danger';
                        lockBtn.textContent = 'Xác nhận Khóa Tài Khoản';
                    }

                    lockModal.show();
                });
            });

            // Edit staff modal
            const editModalEl = document.getElementById('editStaffModal');
            if (editModalEl) {
                const editModal = new bootstrap.Modal(editModalEl);
                const editForm = document.getElementById('editStaffForm');
                document.querySelectorAll('.btn-edit-staff').forEach(btn => {
                    btn.addEventListener('click', function () {
                        const id = this.dataset.id;
                        editForm.action = '/Admin/Users/UpdateStaff/' + id;
                        document.getElementById('editStaffFullName').value = this.dataset.name || '';
                        document.getElementById('editStaffPhone').value = this.dataset.phone || '';
                        document.getElementById('editStaffRole').value = this.dataset.role || 'Dentist';
                        document.getElementById('editStaffSpecialty').value = this.dataset.specialty || '';
                        editModal.show();
                    });
                });
            }

            // Role change handler for Create
            const roleSelect = document.getElementById('staffRoleSelect');
            const deptBlock = document.getElementById('dentistDeptBlock');
            const specBlock = document.getElementById('dentistSpecialtyBlock');
            if (roleSelect && deptBlock && specBlock) {
                roleSelect.addEventListener('change', function () {
                    if (this.value === 'Dentist') {
                        deptBlock.style.display = 'block';
                        specBlock.style.display = 'block';
                    } else {
                        deptBlock.style.display = 'none';
                        specBlock.style.display = 'none';
                    }
                });
            }
        });
    </script>
}
