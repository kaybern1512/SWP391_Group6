<!-- Modal Phân công Trực Phòng X-quang -->
<div class="modal fade" id="assignXrayModal" tabindex="-1" aria-labelledby="assignXrayLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form asp-controller="AdminRoomChair" asp-action="AssignXrayRoster" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title font-heading" id="assignXrayLabel">
                        <i class="bi bi-camera-fill text-dc-primary me-2"></i>Phân Công Bác Sĩ Trực Phòng X-Quang
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Phòng X-quang <span class="text-danger">*</span></label>
                            <select name="roomId" id="assignRoomId" class="form-select" required>
                                @foreach (var rm in Model.Rooms.Where(r => r.RoomCode.Contains("XRAY", StringComparison.OrdinalIgnoreCase) || (!string.IsNullOrEmpty(r.RoomName) && r.RoomName.Contains("X-quang", StringComparison.OrdinalIgnoreCase))))
                                {
                                    <option value="@rm.RoomId" selected="@(rm.RoomCode == "XRAY-01")">Phòng @rm.RoomCode - @rm.RoomName</option>
                                }
                                @if (!Model.Rooms.Any(r => r.RoomCode.Contains("XRAY", StringComparison.OrdinalIgnoreCase)))
                                {
                                    @foreach (var rm in Model.Rooms)
                                    {
                                        <option value="@rm.RoomId">Phòng @rm.RoomCode - @rm.RoomName</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Thiết bị chụp <span class="text-danger">*</span></label>
                            <select name="equipmentId" id="assignEquipmentId" class="form-select" required>
                                @if (equipments.Any())
                                {
                                    foreach (var eq in equipments)
                                    {
                                        <option value="@eq.EquipmentId" selected="@(eq.EquipmentCode == "XRAY-MACH-01")">@eq.EquipmentCode - @eq.EquipmentName</option>
                                    }
                                }
                                else
                                {
                                    <option value="1">XRAY-MACH-01 - Máy chụp X-quang KTS Vatech Pax-i</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Ngày trực <span class="text-danger">*</span></label>
                            <input type="date" name="workDate" class="form-control" value="@rosterDate" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Ca làm việc <span class="text-danger">*</span></label>
                            <select name="shiftType" id="assignShiftType" class="form-select" required>
                                <option value="Morning" selected>Ca Sáng (07:30 - 11:30)</option>
                                <option value="Afternoon">Ca Chiều (13:30 - 17:30)</option>
                                <option value="Evening">Ca Tối (17:30 - 20:30)</option>
                                <option value="Custom">Khung giờ tùy chọn</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label fw-semibold">Bắt đầu</label>
                            <input type="time" name="startTime" id="assignStartTime" class="form-control" value="07:30" required />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label fw-semibold">Kết thúc</label>
                            <input type="time" name="endTime" id="assignEndTime" class="form-control" value="11:30" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Bác sĩ phụ trách chính <span class="text-danger">*</span></label>
                            <select name="dentistUserId" class="form-select" required>
                                <option value="">-- Chọn bác sĩ có chứng chỉ ATBX --</option>
                                @foreach (var d in qualifiedDentists)
                                {
                                    <option value="@d.UserId">
                                        BS. @d.FullName (@(string.IsNullOrEmpty(d.RadiationCertNumber) ? "Có chứng chỉ ATBX" : d.RadiationCertNumber))
                                    </option>
                                }
                            </select>
                            <div class="form-text small text-muted">
                                <i class="bi bi-shield-check text-success me-1"></i>Chỉ bác sĩ có chứng chỉ An toàn bức xạ mới được phân công.
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Bác sĩ dự phòng (Tùy chọn)</label>
                            <select name="backupDentistUserId" class="form-select">
                                <option value="">-- Không phân công bác sĩ dự phòng --</option>
                                @foreach (var d in qualifiedDentists)
                                {
                                    <option value="@d.UserId">
                                        BS. @d.FullName (@(string.IsNullOrEmpty(d.RadiationCertNumber) ? "Có chứng chỉ ATBX" : d.RadiationCertNumber))
                                    </option>
                                }
                            </select>
                            <div class="form-text small text-muted">
                                Tiếp quản ca trực khi bác sĩ chính nghỉ phép hoặc vắng mặt đột xuất.
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Ghi chú vận hành</label>
                            <textarea name="notes" class="form-control" rows="2" placeholder="Ghi chú phân công, thiết bị bàn giao hoặc yêu cầu lâm sàng..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-dc-primary">
                        <i class="bi bi-check-lg me-1"></i>Lưu Phân Công
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

