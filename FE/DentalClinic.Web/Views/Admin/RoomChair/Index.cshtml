                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Edit Room modal
            const editRoomModal = new bootstrap.Modal(document.getElementById('editRoomModal'));
            document.querySelectorAll('.btn-edit-room').forEach(btn => {
                btn.addEventListener('click', function () {
                    document.getElementById('editRoomId').value = this.dataset.id;
                    document.getElementById('editRoomCode').value = this.dataset.code;
                    document.getElementById('editRoomName').value = this.dataset.name || '';
                    document.getElementById('editRoomDepartmentId').value = this.dataset.departmentid || '';
                    document.getElementById('editRoomStatus').value = this.dataset.status || 'Active';
                    document.getElementById('editRoomIsExclusive').checked = (this.dataset.exclusive === 'true');
                    editRoomModal.show();
                });
            });

            // Edit Chair modal
            const editChairModal = new bootstrap.Modal(document.getElementById('editChairModal'));
            document.querySelectorAll('.btn-edit-chair').forEach(btn => {
                btn.addEventListener('click', function () {
                    document.getElementById('editChairId').value = this.dataset.id;
                    document.getElementById('editChairRoomId').value = this.dataset.roomid;
                    document.getElementById('editChairCode').value = this.dataset.code;
                    document.getElementById('editChairStatus').value = this.dataset.status || 'Active';
                    editChairModal.show();
                });
            });

            // Shift selector time sync
            const shiftSelect = document.getElementById('assignShiftType');
            const startTimeInput = document.getElementById('assignStartTime');
            const endTimeInput = document.getElementById('assignEndTime');
            if (shiftSelect && startTimeInput && endTimeInput) {
                shiftSelect.addEventListener('change', function () {
                    switch (this.value) {
                        case 'Morning':
                            startTimeInput.value = '07:30';
                            endTimeInput.value = '11:30';
                            break;
                        case 'Afternoon':
                            startTimeInput.value = '13:30';
                            endTimeInput.value = '17:30';
                            break;
                        case 'Evening':
                            startTimeInput.value = '17:30';
                            endTimeInput.value = '20:30';
                            break;
                    }
                });
            }

            // Replace Xray Doctor modal
            const replaceXrayModalEl = document.getElementById('replaceXrayModal');
            if (replaceXrayModalEl) {
                const replaceXrayModal = new bootstrap.Modal(replaceXrayModalEl);
                document.querySelectorAll('.btn-replace-xray').forEach(btn => {
                    btn.addEventListener('click', function () {
                        document.getElementById('replaceRosterId').value = this.dataset.id;
                        document.getElementById('replaceCurrentDentist').textContent = this.dataset.dentist || '';
                        document.getElementById('replaceCurrentRoom').textContent = this.dataset.room || '';
                        document.getElementById('replaceCurrentShift').textContent = this.dataset.shift || '';
                        document.getElementById('replaceCurrentDate').textContent = this.dataset.date || '';
                        replaceXrayModal.show();
                    });
                });
            }
        });
    </script>
}
