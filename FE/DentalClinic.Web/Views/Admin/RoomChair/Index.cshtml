@model RoomChairManageViewModel
@{
    ViewData["Title"] = "Quản lý Phòng khám, Ghế & Trực X-Quang";
    var xrayRosters = ViewBag.XrayRosters as List<DentalClinic.Web.Models.ApiDtos.XrayDentistRosterDto> ?? new();
    var qualifiedDentists = ViewBag.QualifiedDentists as List<DentalClinic.Web.Models.ApiDtos.QualifiedDentistDto> ?? new();
    var equipments = ViewBag.Equipments as List<DentalClinic.Web.Models.ApiDtos.ImagingEquipmentDto> ?? new();
    var rosterDate = ViewBag.RosterDate as string ?? DateTime.Today.ToString("yyyy-MM-dd");
}

<div class="container-fluid p-0">
    <!-- Header -->
    <div class="page-header-dc">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <a asp-controller="AdminDashboard" asp-action="Dashboard" class="text-decoration-none text-muted small">
                    <i class="bi bi-chevron-left"></i> Tổng quan
                </a>
                <span class="text-muted small">&bull;</span>
                <span class="badge-dc badge-role-systemadministrator">Cơ sở vật chất</span>
            </div>
            <h1 class="page-title">Quản lý Phòng khám, Ghế & Trực X-Quang</h1>
            <p class="page-subtitle">Quản trị phân bổ không gian khám chữa bệnh, trạng thái vận hành ghế và phân công bác sĩ trực phòng X-quang</p>
        </div>
        <div class="page-actions d-flex gap-2">
            <button type="button" class="btn btn-dc-outline" data-bs-toggle="modal" data-bs-target="#createRoomModal">
                <i class="bi bi-door-open me-1"></i> Thêm Phòng Khám
            </button>
            <button type="button" class="btn btn-outline-info" data-bs-toggle="modal" data-bs-target="#assignXrayModal">
                <i class="bi bi-camera me-1"></i> Phân công Bác sĩ X-Quang
            </button>
            <button type="button" class="btn btn-dc-primary" data-bs-toggle="modal" data-bs-target="#createChairModal">
                <i class="bi bi-plus-lg me-1"></i> Thêm Ghế Nha Khoa
            </button>
        </div>
    </div>

    <!-- Navigation Tabs -->
    <ul class="nav nav-pills mb-4" id="roomChairTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link @(Model.ActiveTab == "rooms" ? "active" : "") fw-semibold" id="rooms-tab" data-bs-toggle="tab" data-bs-target="#rooms-pane" type="button" role="tab">
                <i class="bi bi-door-open me-1"></i> Danh sách Phòng khám (@Model.Rooms.Count)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(Model.ActiveTab == "chairs" ? "active" : "") fw-semibold" id="chairs-tab" data-bs-toggle="tab" data-bs-target="#chairs-pane" type="button" role="tab">
                <i class="bi bi-grid-3x3-gap me-1"></i> Ghế nha khoa (@Model.Chairs.Count)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(Model.ActiveTab == "xray-roster" ? "active" : "") fw-semibold" id="xray-roster-tab" data-bs-toggle="tab" data-bs-target="#xray-roster-pane" type="button" role="tab">
                <i class="bi bi-camera me-1"></i> Trực Phòng X-Quang (@xrayRosters.Count)
            </button>
        </li>
    </ul>

    <div class="tab-content" id="roomChairTabContent">
        <!-- PANE 1: PHÒNG KHÁM -->
        <div class="tab-pane fade @(Model.ActiveTab == "rooms" ? "show active" : "")" id="rooms-pane" role="tabpanel">
            <div class="card-dc">
                <div class="card-dc-header d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-door-open text-primary"></i>
                        <span class="fw-bold">Phòng khám trong cơ sở (@Model.Rooms.Count phòng)</span>
                    </div>
                </div>
                <div class="card-dc-body p-0">
                    <div class="table-responsive">
                        <table class="table-dc mb-0">
                            <thead>
                                <tr>
                                    <th style="width: 50px;">#</th>
                                    <th>Mã phòng</th>
                                    <th>Tên phòng</th>
                                    <th>Khoa trực thuộc</th>
                                    <th class="text-center">Số lượng ghế</th>
                                    <th class="text-center">Ghế sẵn sàng</th>
                                    <th>Trạng thái phòng</th>
                                    <th class="text-end">Hành động</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Rooms.Any())
                                {
                                    int rIdx = 1;
                                    foreach (var rm in Model.Rooms)
                                    {
                                        <tr>
                                            <td class="text-muted fw-bold">@(rIdx++)</td>
                                            <td>
                                                <div class="fw-bold text-dark">@rm.RoomCode</div>
                                                <div class="text-muted small">ID: @rm.RoomId</div>
@if (rm.IsExclusive)
{
    <span class="badge bg-danger-subtle text-danger border border-danger-subtle small mt-1">
        <i class="bi bi-shield-lock me-1"></i>Vô trùng độc quyền
    </span>
}
                                            </td>
                                            <td>
                                                <span class="fw-semibold">@(string.IsNullOrEmpty(rm.RoomName) ? "Phòng " + rm.RoomCode : rm.RoomName)</span>
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(rm.DepartmentName))
                                                {
                                                    <span class="badge bg-primary-subtle text-primary border">@rm.DepartmentName</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-light text-muted border">Chưa gán</span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                <a asp-controller="AdminRoomChair" asp-action="Index" asp-route-tab="chairs" asp-route-roomId="@rm.RoomId" class="badge bg-light text-primary border text-decoration-none">
                                                    @rm.ChairsCount ghế
                                                </a>
                                            </td>
                                            <td class="text-center">
                                                <span class="badge bg-success-subtle text-success border">
                                                    @rm.ActiveChairsCount ghế hoạt động
                                                </span>
                                            </td>
                                            <td>
                                                @if (rm.Status == "Active")
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                        <i class="bi bi-check-circle me-1"></i> Sẵn sàng (Active)
                                                    </span>
                                                }
                                                else if (rm.Status == "Maintenance")
                                                {
                                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle">
                                                        <i class="bi bi-tools me-1"></i> Bảo trì (Maintenance)
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
                                                        <i class="bi bi-pause-circle me-1"></i> Tạm dừng (Inactive)
                                                    </span>
                                                }
                                            </td>
                                            <td class="text-end text-nowrap">
                                                <button type="button" class="btn btn-sm btn-outline-primary me-1 btn-edit-room"
                                                        data-id="@rm.RoomId"
                                                        data-code="@rm.RoomCode"
                                                        data-name="@rm.RoomName"
                                                        data-departmentid="@(rm.DepartmentId?.ToString() ?? "")"
                                                        data-status="@rm.Status"
                                                        data-exclusive="@(rm.IsExclusive ? "true" : "false")">
                                                    <i class="bi bi-pencil-square"></i> Sửa
                                                </button>
                                                <!-- Dropdown đổi nhanh trạng thái -->
                                                <div class="btn-group">
                                                    <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown">
                                                        Trạng thái
                                                    </button>
                                                    <ul class="dropdown-menu dropdown-menu-end">
                                                        <li>
                                                            <form asp-controller="AdminRoomChair" asp-action="UpdateRoomStatus" asp-route-id="@rm.RoomId" method="post">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="status" value="Active" />
                                                                <button type="submit" class="dropdown-item text-success"><i class="bi bi-check-circle me-1"></i> Kích hoạt (Active)</button>
                                                            </form>
                                                        </li>
                                                        <li>
                                                            <form asp-controller="AdminRoomChair" asp-action="UpdateRoomStatus" asp-route-id="@rm.RoomId" method="post">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="status" value="Maintenance" />
                                                                <button type="submit" class="dropdown-item text-warning"><i class="bi bi-tools me-1"></i> Bảo trì (Maintenance)</button>
                                                            </form>
                                                        </li>
                                                        <li>
                                                            <form asp-controller="AdminRoomChair" asp-action="UpdateRoomStatus" asp-route-id="@rm.RoomId" method="post">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="status" value="Inactive" />
                                                                <button type="submit" class="dropdown-item text-secondary"><i class="bi bi-pause-circle me-1"></i> Tạm ngưng (Inactive)</button>
                                                            </form>
                                                        </li>
                                                    </ul>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="7" class="text-center py-4 text-muted">
                                            <i class="bi bi-door-closed fs-3 d-block mb-1"></i>
                                            Chưa có phòng khám nào được cấu hình trong hệ thống.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- PANE 2: GHẾ NHA KHOA -->
        <div class="tab-pane fade @(Model.ActiveTab == "chairs" ? "show active" : "")" id="chairs-pane" role="tabpanel">
            <!-- Filter by Room for Chairs -->
            <div class="card-dc mb-4">
                <div class="card-dc-body p-3">
                    <form asp-controller="AdminRoomChair" asp-action="Index" method="get" class="row g-2 align-items-center">
                        <input type="hidden" name="tab" value="chairs" />
                        <div class="col-md-5">
                            <label class="form-label small fw-semibold text-muted mb-1">Lọc ghế theo phòng khám</label>
                            <select name="roomId" class="form-select form-select-sm" onchange="this.form.submit()">
                                <option value="">-- Tất cả phòng khám --</option>
                                @foreach (var rm in Model.Rooms)
                                {
                                    <option value="@rm.RoomId" selected="@(Model.SelectedRoomId == rm.RoomId)">
                                        Phòng @rm.RoomCode @(string.IsNullOrEmpty(rm.RoomName) ? "" : $"({rm.RoomName})")
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3 pt-3">
                            <a asp-controller="AdminRoomChair" asp-action="Index" asp-route-tab="chairs" class="btn btn-sm btn-outline-secondary">
                                Xem tất cả ghế
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card-dc">
                <div class="card-dc-header d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-grid-3x3-gap text-teal"></i>
                        <span class="fw-bold">Danh sách Ghế nha khoa (@Model.Chairs.Count ghế)</span>
                    </div>
                </div>
                <div class="card-dc-body p-0">
                    <div class="table-responsive">
                        <table class="table-dc mb-0">
                            <thead>
                                <tr>
                                    <th style="width: 50px;">#</th>
                                    <th>Mã ghế</th>
                                    <th>Vị trí phòng</th>
                                    <th>Trạng thái ghế</th>
                                    <th class="text-end">Hành động</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Chairs.Any())
                                {
                                    int cIdx = 1;
                                    foreach (var chair in Model.Chairs)
                                    {
                                        <tr>
                                            <td class="text-muted fw-bold">@(cIdx++)</td>
                                            <td>
                                                <div class="fw-bold text-dark">@chair.ChairCode</div>
                                                <div class="text-muted small">ID: @chair.DentalChairId</div>
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    <i class="bi bi-door-open text-primary"></i>
                                                    <div>
                                                        <div class="fw-semibold text-dark">Phòng @chair.RoomCode</div>
                                                        @if (!string.IsNullOrEmpty(chair.RoomName))
                                                        {
                                                            <div class="text-muted small">@chair.RoomName</div>
                                                        }
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                @if (chair.Status == "Active")
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                        <i class="bi bi-check-circle me-1"></i> Sẵn sàng sử dụng
                                                    </span>
                                                }
                                                else if (chair.Status == "Maintenance")
                                                {
                                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle">
                                                        <i class="bi bi-tools me-1"></i> Đang bảo trì
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
                                                        <i class="bi bi-pause-circle me-1"></i> Tạm dừng hoạt động
                                                    </span>
                                                }
                                            </td>
                                            <td class="text-end text-nowrap">
                                                <button type="button" class="btn btn-sm btn-outline-primary me-1 btn-edit-chair"
                                                        data-id="@chair.DentalChairId"
                                                        data-roomid="@chair.RoomId"
                                                        data-code="@chair.ChairCode"
                                                        data-status="@chair.Status">
                                                    <i class="bi bi-pencil-square"></i> Sửa
                                                </button>
                                                <!-- Dropdown đổi nhanh trạng thái ghế -->
                                                <div class="btn-group">
                                                    <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown">
                                                        Trạng thái
                                                    </button>
                                                    <ul class="dropdown-menu dropdown-menu-end">
                                                        <li>
                                                            <form asp-controller="AdminRoomChair" asp-action="UpdateChairStatus" asp-route-id="@chair.DentalChairId" method="post">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="status" value="Active" />
                                                                <input type="hidden" name="roomId" value="@Model.SelectedRoomId" />
                                                                <button type="submit" class="dropdown-item text-success"><i class="bi bi-check-circle me-1"></i> Kích hoạt (Active)</button>
                                                            </form>
                                                        </li>
                                                        <li>
                                                            <form asp-controller="AdminRoomChair" asp-action="UpdateChairStatus" asp-route-id="@chair.DentalChairId" method="post">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="status" value="Maintenance" />
                                                                <input type="hidden" name="roomId" value="@Model.SelectedRoomId" />
                                                                <button type="submit" class="dropdown-item text-warning"><i class="bi bi-tools me-1"></i> Bảo trì (Maintenance)</button>
                                                            </form>
                                                        </li>
                                                        <li>
                                                            <form asp-controller="AdminRoomChair" asp-action="UpdateChairStatus" asp-route-id="@chair.DentalChairId" method="post">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="status" value="Inactive" />
                                                                <input type="hidden" name="roomId" value="@Model.SelectedRoomId" />
                                                                <button type="submit" class="dropdown-item text-secondary"><i class="bi bi-pause-circle me-1"></i> Tạm ngưng (Inactive)</button>
                                                            </form>
                                                        </li>
                                                    </ul>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center py-4 text-muted">
                                            <i class="bi bi-grid-3x3 fs-3 d-block mb-1"></i>
                                            Không tìm thấy ghế nha khoa nào theo điều kiện lọc.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- PANE 3: TRỰC PHÒNG X-QUANG -->
        <div class="tab-pane fade @(Model.ActiveTab == "xray-roster" ? "show active" : "")" id="xray-roster-pane" role="tabpanel">
            <!-- Filter by Date for X-Ray Rosters -->
            <div class="card-dc mb-4">
                <div class="card-dc-body p-3">
                    <form asp-controller="AdminRoomChair" asp-action="Index" method="get" class="row g-2 align-items-center">
                        <input type="hidden" name="tab" value="xray-roster" />
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold text-muted mb-1">Ngày trực ca phòng X-quang</label>
                            <input type="date" name="rosterDate" class="form-control form-control-sm" value="@rosterDate" onchange="this.form.submit()" />
                        </div>
                        <div class="col-md-5 pt-3">
                            <button type="submit" class="btn btn-sm btn-outline-primary me-2">
                                <i class="bi bi-funnel me-1"></i> Xem lịch ngày này
                            </button>
                            <a asp-controller="AdminRoomChair" asp-action="Index" asp-route-tab="xray-roster" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-calendar-event me-1"></i> Hôm nay
                            </a>
                        </div>
                        <div class="col-md-3 text-end pt-3">
                            <button type="button" class="btn btn-sm btn-dc-primary" data-bs-toggle="modal" data-bs-target="#assignXrayModal">
                                <i class="bi bi-plus-lg me-1"></i> Phân công ca trực mới
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card-dc">
                <div class="card-dc-header d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-camera text-primary"></i>
                        <span class="fw-bold">Lịch phân công Bác sĩ trực phòng X-quang (@xrayRosters.Count ca)</span>
                    </div>
                    <span class="badge bg-light text-dark border">
                        <i class="bi bi-calendar3 me-1"></i>Ngày: @(DateOnly.TryParse(rosterDate, out var dt) ? dt.ToString("dd/MM/yyyy") : rosterDate)
                    </span>
                </div>
                <div class="card-dc-body p-0">
                    <div class="table-responsive">
                        <table class="table-dc mb-0">
                            <thead>
                                <tr>
                                    <th style="width: 50px;">#</th>
                                    <th>Ca trực & Khung giờ</th>
                                    <th>Phòng & Thiết bị</th>
                                    <th>Bác sĩ trực chính (Có chứng chỉ ATBX)</th>
                                    <th>Bác sĩ dự phòng</th>
                                    <th>Trạng thái</th>
                                    <th>Ghi chú</th>
                                    <th class="text-end">Hành động</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (xrayRosters.Any())
                                {
                                    int rIdx = 1;
                                    foreach (var roster in xrayRosters)
                                    {
                                        <tr>
                                            <td class="text-muted fw-bold">@(rIdx++)</td>
                                            <td>
                                                @{
                                                    var shiftBadge = roster.ShiftType switch
                                                    {
                                                        "Morning" => "bg-primary text-white",
                                                        "Afternoon" => "bg-warning text-dark",
                                                        "Evening" => "bg-info text-dark",
                                                        _ => "bg-secondary text-white"
                                                    };
                                                    var shiftLabel = roster.ShiftType switch
                                                    {
                                                        "Morning" => "Ca Sáng",
                                                        "Afternoon" => "Ca Chiều",
                                                        "Evening" => "Ca Tối",
                                                        _ => roster.ShiftType
                                                    };
                                                }
                                                <span class="badge @shiftBadge mb-1">@shiftLabel</span>
                                                <div class="fw-bold text-dark font-monospace">
                                                    @roster.StartTime.ToString(@"hh\:mm") - @roster.EndTime.ToString(@"hh\:mm")
                                                </div>
                                            </td>
                                            <td>
                                                <div class="fw-bold text-dark">
                                                    <i class="bi bi-door-open text-primary me-1"></i>@roster.RoomCode - @roster.RoomName
                                                </div>
                                                <div class="text-muted small">
                                                    <i class="bi bi-cpu me-1"></i>@roster.EquipmentName (@roster.EquipmentCode)
                                                </div>
                                            </td>
                                            <td>
                                                <div class="fw-bold text-dark">
                                                    <i class="bi bi-person-badge text-teal me-1"></i>@roster.DentistFullName
                                                </div>
                                                @if (roster.HasRadiationSafetyCert)
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle small">
                                                        <i class="bi bi-shield-check me-1"></i>ATBX: @(roster.RadiationCertNumber ?? "Đã cấp")
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle small">
                                                        <i class="bi bi-exclamation-triangle me-1"></i>Chưa có ATBX
                                                    </span>
                                                }
                                                @if (roster.IsDentistOnLeave)
                                                {
                                                    <div class="mt-1">
                                                        <span class="badge bg-danger text-white">
                                                            <i class="bi bi-calendar-x me-1"></i>ĐANG NGHỈ PHÉP
                                                        </span>
                                                    </div>
                                                }
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(roster.BackupDentistFullName))
                                                {
                                                    <div class="text-dark">
                                                        <i class="bi bi-person me-1"></i>@roster.BackupDentistFullName
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted small">-- Không có --</span>
                                                }
                                            </td>
                                            <td>
                                                @if (roster.Status == "Active")
                                                {
                                                    <span class="badge bg-success text-white">Đang áp dụng</span>
                                                }
                                                else if (roster.Status == "Replaced")
                                                {
                                                    <span class="badge bg-info text-white">Đã điều chuyển</span>
                                                }
                                                else if (roster.Status == "Cancelled")
                                                {
                                                    <span class="badge bg-secondary text-white">Đã hủy</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-light text-dark border">@roster.Status</span>
                                                }
                                            </td>
                                            <td>
                                                <span class="small text-muted">@(string.IsNullOrWhiteSpace(roster.Notes) ? "--" : roster.Notes)</span>
                                            </td>
                                            <td class="text-end">
                                                @if (roster.Status == "Active")
                                                {
                                                    <div class="btn-group">
                                                        <button type="button" class="btn btn-sm btn-outline-primary btn-replace-xray"
                                                                data-id="@roster.RosterId"
                                                                data-dentist="@roster.DentistFullName"
                                                                data-room="@roster.RoomCode"
                                                                data-shift="@shiftLabel"
                                                                data-date="@roster.WorkDate.ToString("yyyy-MM-dd")">
                                                            <i class="bi bi-arrow-left-right me-1"></i> Điều chuyển
                                                        </button>
                                                        <form asp-controller="AdminRoomChair" asp-action="CancelXrayRoster" method="post" class="d-inline"
                                                              onsubmit="return confirm('Bạn có chắc chắn muốn hủy ca trực phòng X-quang này?');">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="rosterId" value="@roster.RosterId" />
                                                            <input type="hidden" name="rosterDate" value="@rosterDate" />
                                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Hủy ca trực">
                                                                <i class="bi bi-x-circle"></i>
                                                            </button>
                                                        </form>
                                                    </div>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="8" class="text-center py-4 text-muted">
                                            <i class="bi bi-calendar-x fs-3 d-block mb-1"></i>
                                            Chưa có ca trực phòng X-quang nào được phân công trong ngày này.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

