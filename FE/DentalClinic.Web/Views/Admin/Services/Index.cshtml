@model ServiceManageViewModel
@{
    ViewData["Title"] = "Quản lý Bảng giá Dịch vụ";
}

<div class="container-fluid p-0">
    <!-- Header -->
    <div class="page-header-dc">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <a asp-controller="AdminDashboard" asp-action="Dashboard" class="text-decoration-none text-muted small">
                    <i class="bi bi-chevron-left"></i> Tổng quan
                </a>
                <span class="text-muted small">&bull;</span>
                <span class="badge-dc badge-role-systemadministrator">Danh mục hệ thống</span>
            </div>
            <h1 class="page-title">Quản lý Danh mục & Bảng giá Dịch vụ Nha khoa</h1>
            <p class="page-subtitle">Quản lý 31+ dịch vụ theo chuyên khoa, cấu hình thời lượng riêng biệt, loại dịch vụ và yêu cầu phòng vô trùng</p>
        </div>
        <div class="page-actions">
            <button type="button" class="btn btn-dc-primary" data-bs-toggle="modal" data-bs-target="#createServiceModal">
                <i class="bi bi-plus-lg me-1"></i> Thêm Dịch vụ Mới
            </button>
        </div>
    </div>

    <!-- Filter & Search Bar -->
    <div class="card-dc mb-4">
        <div class="card-dc-body p-3">
            <form asp-controller="AdminService" asp-action="Index" method="get" class="row g-2 align-items-center">
                <div class="col-md-4">
                    <label class="form-label small fw-semibold text-muted mb-1">Lọc theo chuyên khoa</label>
                    <select name="departmentId" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="">-- Tất cả các chuyên khoa --</option>
                        @foreach (var dept in Model.Departments)
                        {
                            <option value="@dept.DepartmentId" selected="@(Model.SelectedDepartmentId == dept.DepartmentId)">
                                @dept.Name
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-5">
                    <label class="form-label small fw-semibold text-muted mb-1">Tìm kiếm dịch vụ</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" name="search" class="form-control" placeholder="Nhập tên dịch vụ hoặc mô tả..." value="@Model.SearchKeyword" />
                    </div>
                </div>
                <div class="col-md-3 d-flex align-items-end gap-2 pt-3">
                    <button type="submit" class="btn btn-sm btn-dc-primary">
                        <i class="bi bi-filter me-1"></i> Áp dụng
                    </button>
                    <a asp-controller="AdminService" asp-action="Index" class="btn btn-sm btn-outline-secondary">
                        Đặt lại
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Services Table -->
    <div class="card-dc">
        <div class="card-dc-header d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-tags text-teal"></i>
                <span class="fw-bold">Danh sách Dịch vụ Nha khoa (@Model.Services.Count)</span>
            </div>
        </div>
        <div class="card-dc-body p-0">
            <div class="table-responsive">
                <table class="table-dc mb-0">
                    <thead>
                        <tr>
                            <th style="width: 50px;">#</th>
                            <th>Tên Dịch vụ & Phân loại</th>
                            <th>Chuyên khoa</th>
                            <th class="text-center">Thời lượng riêng</th>
                            <th class="text-end">Đơn giá niêm yết</th>
                            <th>Yêu cầu lâm sàng</th>
                            <th>Trạng thái</th>
                            <th class="text-end">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Services.Any())
                        {
                            int index = 1;
                            foreach (var srv in Model.Services)
                            {
                                <tr>
                                    <td class="text-muted fw-bold">@(index++)</td>
                                    <td>
                                        <div class="fw-bold text-dark">@srv.ServiceName</div>
                                        <div class="d-flex align-items-center gap-1 mt-1 flex-wrap">
                                            <span class="badge bg-light text-secondary border">Mã: SRV-@srv.DepartmentServiceId</span>
                                            @switch (srv.ServiceType)
                                            {
                                                case "Consultation":
                                                    <span class="badge bg-info-subtle text-info border border-info-subtle">
                                                        <i class="bi bi-chat-square-text me-1"></i>Khám & Tư vấn
                                                    </span>
                                                    break;
                                                case "Surgery":
                                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                                        <i class="bi bi-heart-pulse me-1"></i>Phẫu thuật
                                                    </span>
                                                    break;
                                                case "Cosmetic":
                                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle">
                                                        <i class="bi bi-stars me-1"></i>Thẩm mỹ
                                                    </span>
                                                    break;
                                                case "Pediatric":
                                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                                        <i class="bi bi-emoji-smile me-1"></i>Nha khoa trẻ em
                                                    </span>
                                                    break;
                                                default:
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                        <i class="bi bi-tools me-1"></i>Điều trị
                                                    </span>
                                                    break;
                                            }
                                        </div>
                                        @if (!string.IsNullOrEmpty(srv.Description))
                                        {
                                            <div class="text-muted small mt-1 text-truncate" style="max-width: 280px;" title="@srv.Description">
                                                @srv.Description
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-primary border">@srv.DepartmentName</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-dark-subtle text-dark border px-2 py-1">
                                            <i class="bi bi-clock me-1 text-primary"></i>@(srv.DurationMinutes.HasValue ? srv.DurationMinutes + " phút" : "30 phút")
                                        </span>
                                    </td>
                                    <td class="text-end fw-bold text-success">
                                        @srv.Price.ToString("N0") đ
                                    </td>
                                    <td>
                                        <div class="d-flex flex-column gap-1">
                                            @if (srv.RequiresExclusiveRoom)
                                            {
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle small text-start">
                                                    <i class="bi bi-shield-lock me-1"></i>Phòng vô trùng độc quyền
                                                </span>
                                            }
                                            @if (srv.RequiresConsultationFirst)
                                            {
                                                <span class="badge bg-info-subtle text-info border border-info-subtle small text-start">
                                                    <i class="bi bi-clipboard-check me-1"></i>Cần khám tư vấn trước
                                                </span>
                                            }
                                            @if (srv.MinLeadTimeHours > 0)
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary border small text-start">
                                                    <i class="bi bi-hourglass-split me-1"></i>Đặt trước: @srv.MinLeadTimeHours giờ
                                                </span>
                                            }
                                            @if (!srv.RequiresExclusiveRoom && !srv.RequiresConsultationFirst && srv.MinLeadTimeHours == 0)
                                            {
                                                <span class="text-muted small">Tiêu chuẩn</span>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        @if (srv.Status == "Active")
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                <i class="bi bi-check-circle me-1"></i> Hoạt động
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
                                                <i class="bi bi-pause-circle me-1"></i> Tạm ngưng
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end text-nowrap">
                                        <button type="button" class="btn btn-sm btn-outline-primary me-1 btn-edit-srv"
                                                data-id="@srv.DepartmentServiceId"
                                                data-deptid="@srv.DepartmentId"
                                                data-name="@srv.ServiceName"
                                                data-desc="@srv.Description"
                                                data-duration="@srv.DurationMinutes"
                                                data-price="@srv.Price"
                                                data-status="@srv.Status"
                                                data-servicetype="@srv.ServiceType"
                                                data-exclusive="@(srv.RequiresExclusiveRoom ? "true" : "false")"
                                                data-consultation="@(srv.RequiresConsultationFirst ? "true" : "false")"
                                                data-leadtime="@srv.MinLeadTimeHours"
                                                data-instructions="@srv.BookingInstructions">
                                            <i class="bi bi-pencil-square"></i> Sửa
                                        </button>
                                        <form asp-controller="AdminService" asp-action="ToggleStatus" asp-route-id="@srv.DepartmentServiceId" method="post" class="d-inline" data-confirm="Bạn có chắc chắn muốn thay đổi trạng thái dịch vụ này?">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm @(srv.Status == "Active" ? "btn-outline-warning" : "btn-outline-success")">
                                                <i class="bi @(srv.Status == "Active" ? "bi-pause" : "bi-play")"></i>
                                                @(srv.Status == "Active" ? "Tạm dừng" : "Kích hoạt")
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">
                                    <i class="bi bi-tags fs-3 d-block mb-1"></i>
                                    Không tìm thấy dịch vụ nào phù hợp với điều kiện tìm kiếm.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Thêm Dịch vụ -->
<div class="modal fade" id="createServiceModal" tabindex="-1" aria-labelledby="createServiceLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form asp-controller="AdminService" asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title font-heading" id="createServiceLabel">
                        <i class="bi bi-plus-circle text-teal me-2"></i>Thêm Mới Dịch Vụ Nha Khoa
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Thuộc chuyên khoa <span class="text-danger">*</span></label>
                            <select name="DepartmentId" class="form-select" required>
                                <option value="">-- Chọn chuyên khoa --</option>
                                @foreach (var dept in Model.Departments)
                                {
                                    <option value="@dept.DepartmentId" selected="@(Model.SelectedDepartmentId == dept.DepartmentId)">
                                        @dept.Name
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Loại hình dịch vụ <span class="text-danger">*</span></label>
                            <select name="ServiceType" class="form-select" required>
                                <option value="Treatment" selected>Điều trị nha khoa (Treatment)</option>
                                <option value="Consultation">Khám & Tư vấn (Consultation)</option>
                                <option value="Surgery">Phẫu thuật / Tiểu phẫu (Surgery)</option>
                                <option value="Cosmetic">Nha khoa Thẩm mỹ (Cosmetic)</option>
                                <option value="Pediatric">Nha khoa Trẻ em (Pediatric)</option>
                            </select>
                        </div>
                        <div class="col-md-8">
                            <label class="form-label fw-semibold">Tên dịch vụ <span class="text-danger">*</span></label>
                            <input type="text" name="ServiceName" class="form-control" placeholder="Ví dụ: Lấy cao răng, Điều trị tủy răng, Cấy ghép Implant..." required maxlength="150" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Trạng thái</label>
                            <select name="Status" class="form-select">
                                <option value="Active">Đang hoạt động (Active)</option>
                                <option value="Inactive">Tạm dừng (Inactive)</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Thời lượng riêng cho slot đặt lịch (phút) <span class="text-danger">*</span></label>
                            <input type="number" name="DurationMinutes" class="form-control" value="30" min="5" max="480" required />
                            <div class="form-text small">Thời lượng riêng từng dịch vụ, KHÔNG ép chung vào thời lượng khám thông thường.</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Đơn giá niêm yết (VNĐ) <span class="text-danger">*</span></label>
                            <input type="number" name="Price" class="form-control" placeholder="0" min="0" step="1000" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Mô tả dịch vụ</label>
                            <textarea name="Description" class="form-control" rows="2" placeholder="Mô tả kỹ thuật, quy trình hoặc chỉ định chuyên môn..." maxlength="500"></textarea>
                        </div>
                        <div class="col-md-6">
                            <div class="card bg-light border-0 p-3 rounded-3 h-100">
                                <div class="form-check form-switch mb-2">
                                    <input class="form-check-input" type="checkbox" name="RequiresExclusiveRoom" value="true" id="createReqRoom" />
                                    <label class="form-check-label fw-semibold" for="createReqRoom">Yêu cầu phòng vô trùng độc quyền</label>
                                </div>
                                <div class="small text-muted">Áp dụng cho phẫu thuật Implant, nhổ răng khôn phức tạp cần phòng cách ly riêng.</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card bg-light border-0 p-3 rounded-3 h-100">
                                <div class="form-check form-switch mb-2">
                                    <input class="form-check-input" type="checkbox" name="RequiresConsultationFirst" value="true" id="createReqConsult" />
                                    <label class="form-check-label fw-semibold" for="createReqConsult">Bắt buộc khám tư vấn trước</label>
                                </div>
                                <div class="small text-muted">Bệnh nhân cần khám tổng quát hoặc chụp phim X-Quang trước khi thực hiện dịch vụ này.</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Thời gian đặt trước tối thiểu (giờ)</label>
                            <input type="number" name="MinLeadTimeHours" class="form-control" value="0" min="0" max="168" />
                            <div class="form-text small">Ví dụ: Phẫu thuật cần chuẩn bị vật tư trước 24 giờ.</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Hướng dẫn chuẩn bị cho bệnh nhân</label>
                            <textarea name="BookingInstructions" class="form-control" rows="2" placeholder="Ví dụ: Nhịn ăn trước phẫu thuật 4 tiếng, mang theo phim chụp..." maxlength="1000"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-dc-primary">Lưu Dịch Vụ</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Sửa Dịch vụ -->
<div class="modal fade" id="editServiceModal" tabindex="-1" aria-labelledby="editServiceLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form asp-controller="AdminService" asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="DepartmentServiceId" id="editSrvId" />
                <div class="modal-header">
                    <h5 class="modal-title font-heading" id="editServiceLabel">
                        <i class="bi bi-pencil-square text-teal me-2"></i>Chỉnh Sửa Dịch Vụ Nha Khoa
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Thuộc chuyên khoa <span class="text-danger">*</span></label>
                            <select name="DepartmentId" id="editSrvDeptId" class="form-select" required>
                                @foreach (var dept in Model.Departments)
                                {
                                    <option value="@dept.DepartmentId">@dept.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Loại hình dịch vụ <span class="text-danger">*</span></label>
                            <select name="ServiceType" id="editSrvType" class="form-select" required>
                                <option value="Treatment">Điều trị nha khoa (Treatment)</option>
                                <option value="Consultation">Khám & Tư vấn (Consultation)</option>
                                <option value="Surgery">Phẫu thuật / Tiểu phẫu (Surgery)</option>
                                <option value="Cosmetic">Nha khoa Thẩm mỹ (Cosmetic)</option>
                                <option value="Pediatric">Nha khoa Trẻ em (Pediatric)</option>
                            </select>
                        </div>
                        <div class="col-md-8">
                            <label class="form-label fw-semibold">Tên dịch vụ <span class="text-danger">*</span></label>
                            <input type="text" name="ServiceName" id="editSrvName" class="form-control" required maxlength="150" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Trạng thái</label>
                            <select name="Status" id="editSrvStatus" class="form-select">
                                <option value="Active">Đang hoạt động (Active)</option>
                                <option value="Inactive">Tạm dừng (Inactive)</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Thời lượng riêng cho slot đặt lịch (phút) <span class="text-danger">*</span></label>
                            <input type="number" name="DurationMinutes" id="editSrvDuration" class="form-control" min="5" max="480" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Đơn giá niêm yết (VNĐ) <span class="text-danger">*</span></label>
                            <input type="number" name="Price" id="editSrvPrice" class="form-control" min="0" step="1000" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Mô tả dịch vụ</label>
                            <textarea name="Description" id="editSrvDesc" class="form-control" rows="2" maxlength="500"></textarea>
                        </div>
                        <div class="col-md-6">
                            <div class="card bg-light border-0 p-3 rounded-3 h-100">
                                <div class="form-check form-switch mb-2">
                                    <input class="form-check-input" type="checkbox" name="RequiresExclusiveRoom" value="true" id="editReqRoom" />
                                    <label class="form-check-label fw-semibold" for="editReqRoom">Yêu cầu phòng vô trùng độc quyền</label>
                                </div>
                                <div class="small text-muted">Áp dụng cho phẫu thuật Implant, nhổ răng khôn phức tạp.</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card bg-light border-0 p-3 rounded-3 h-100">
                                <div class="form-check form-switch mb-2">
                                    <input class="form-check-input" type="checkbox" name="RequiresConsultationFirst" value="true" id="editReqConsult" />
                                    <label class="form-check-label fw-semibold" for="editReqConsult">Bắt buộc khám tư vấn trước</label>
                                </div>
                                <div class="small text-muted">Bệnh nhân cần khám tư vấn trước khi làm thủ thuật.</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Thời gian đặt trước tối thiểu (giờ)</label>
                            <input type="number" name="MinLeadTimeHours" id="editSrvLeadTime" class="form-control" min="0" max="168" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Hướng dẫn chuẩn bị cho bệnh nhân</label>
                            <textarea name="BookingInstructions" id="editSrvInstructions" class="form-control" rows="2" maxlength="1000"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-dc-primary">Lưu Thay Đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const editModalEl = document.getElementById('editServiceModal');
            if (editModalEl) {
                const editModal = new bootstrap.Modal(editModalEl);
                document.querySelectorAll('.btn-edit-srv').forEach(btn => {
                    btn.addEventListener('click', function () {
                        document.getElementById('editSrvId').value = this.dataset.id;
                        document.getElementById('editSrvDeptId').value = this.dataset.deptid;
                        document.getElementById('editSrvName').value = this.dataset.name;
                        document.getElementById('editSrvDesc').value = this.dataset.desc || '';
                        document.getElementById('editSrvDuration').value = this.dataset.duration || 30;
                        document.getElementById('editSrvPrice').value = this.dataset.price;
                        document.getElementById('editSrvStatus').value = this.dataset.status || 'Active';
                        document.getElementById('editSrvType').value = this.dataset.servicetype || 'Treatment';
                        document.getElementById('editReqRoom').checked = (this.dataset.exclusive === 'true');
                        document.getElementById('editReqConsult').checked = (this.dataset.consultation === 'true');
                        document.getElementById('editSrvLeadTime').value = this.dataset.leadtime || 0;
                        document.getElementById('editSrvInstructions').value = this.dataset.instructions || '';
                        editModal.show();
                    });
                });
            }
        });
    </script>
}
