@using DentalClinic.Web.Models.ApiDtos
@using DentalClinic.Web.Helpers
@using System.Text.Json
@{
    ViewData["Title"] = "Lịch Làm Việc Lễ Tân";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string activeTab = ViewBag.ActiveTab ?? "weekly";
    int year = ViewBag.Year;
    int month = ViewBag.Month;
    int weekOffset = ViewBag.WeekOffset ?? 0;
    DateOnly weekStart = ViewBag.WeekStartDate ?? ClinicTimeHelper.TodayDateOnly;
    DateOnly weekEnd = ViewBag.WeekEndDate ?? weekStart.AddDays(6);
    long? filterReceptionistId = ViewBag.ReceptionistUserId;

    var monthlyData = ViewBag.MonthlyData as MonthlyReceptionistScheduleDto;
    var leaves = ViewBag.Leaves as List<ReceptionistLeaveRequestDto> ?? new();
    var swaps = ViewBag.Swaps as List<ReceptionistShiftSwapRequestDto> ?? new();
    var incidents = ViewBag.Incidents as List<ReceptionistCoverageIncidentDto> ?? new();
    var templates = ViewBag.Templates as List<ReceptionistShiftTemplateDto> ?? new();
    var receptionists = ViewBag.Receptionists as List<AdminUserDto> ?? new();

    int pendingLeavesCount = leaves.Count(l => l.Status == "Pending");
    int pendingSwapsCount = swaps.Count(s => s.Status == "PendingAdminApproval");
    int openIncidentsCount = incidents.Count(i => i.Status == "Open");

    var morningTpl = templates.FirstOrDefault(t => t.StartTime < new TimeOnly(13, 0));
    var afternoonTpl = templates.FirstOrDefault(t => t.StartTime >= new TimeOnly(13, 0));
    int morningReq = morningTpl?.MinStaffRequired ?? 0;
    int afternoonReq = afternoonTpl?.MinStaffRequired ?? 0;

    int prevMonth = month - 1;
    int prevYear = year;
    if (prevMonth < 1) { prevMonth = 12; prevYear--; }

    int nextMonth = month + 1;
    int nextYear = year;
    if (nextMonth > 12) { nextMonth = 1; nextYear++; }

    var today = ClinicTimeHelper.TodayDateOnly;
    var weekDays = new List<DateOnly>();
    for (int i = 0; i < 7; i++)
    {
        weekDays.Add(weekStart.AddDays(i));
    }
    string[] dayNamesVn = { "Thứ Hai", "Thứ Ba", "Thứ Tư", "Thứ Năm", "Thứ Sáu", "Thứ Bảy", "Chủ Nhật" };
}

<style>
    /* DentalCare Scheduling Custom Styles */
    .schedule-shift-cell {
        min-height: 125px;
        cursor: pointer;
        transition: all 0.15s ease-in-out;
        border: 1px solid #e9ecef !important;
        position: relative;
    }
    .schedule-shift-cell:hover {
        background-color: #f8f9fa !important;
        box-shadow: inset 0 0 0 1px #0d6efd;
    }
    .schedule-shift-cell.active-shift-cell {
        background-color: #f0f7ff !important;
        box-shadow: inset 0 0 0 2px #0d6efd !important;
    }
    .monthly-day-cell {
        min-height: 115px;
        height: 115px;
        cursor: pointer;
        transition: all 0.15s ease-in-out;
        overflow: hidden;
        border: 1px solid #e9ecef !important;
    }
    .monthly-day-cell:hover {
        background-color: #f8f9fa !important;
        box-shadow: inset 0 0 0 1px #0d6efd;
    }
    .monthly-day-cell.active-shift-cell {
        background-color: #f0f7ff !important;
        box-shadow: inset 0 0 0 2px #0d6efd !important;
    }
    #shiftDetailsDrawer {
        width: 460px;
        max-width: 100vw;
    }
    @@media (max-width: 576px) {
        #shiftDetailsDrawer {
            width: 100vw;
        }
    }
</style>

<div class="container-fluid py-3">
    <!-- Header: Tiêu đề & Mô tả phụ -->
    <div class="d-flex justify-content-between align-items-start mb-3 flex-wrap gap-2">
        <div>
            <h2 class="h4 fw-bold text-dark mb-1">
                <i class="bi bi-people-fill text-primary me-2"></i>Lịch Làm Việc Lễ Tân
            </h2>
            <p class="text-muted small mb-0">Theo dõi, phân công và quản lý nhân sự theo ca làm việc.</p>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Stat Highlights -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100">
                <div class="d-flex align-items-center">
                    <div class="bg-primary-subtle text-primary p-3 rounded-circle me-3">
                        <i class="bi bi-calendar-week fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Tổng ca trực tháng</div>
                        <div class="fs-4 fw-bold text-dark">@(monthlyData?.Days.Sum(d => d.Shifts.Count) ?? 0)</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100">
                <div class="d-flex align-items-center">
                    <div class="bg-warning-subtle text-warning p-3 rounded-circle me-3">
                        <i class="bi bi-hourglass-split fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Đơn nghỉ chờ duyệt</div>
                        <div class="fs-4 fw-bold text-dark">@pendingLeavesCount</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100">
                <div class="d-flex align-items-center">
                    <div class="bg-info-subtle text-info p-3 rounded-circle me-3">
                        <i class="bi bi-arrow-left-right fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Đổi ca chờ duyệt</div>
                        <div class="fs-4 fw-bold text-dark">@pendingSwapsCount</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100">
                <div class="d-flex align-items-center">
                    <div class="bg-danger-subtle text-danger p-3 rounded-circle me-3">
                        <i class="bi bi-shield-exclamation fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Sự cố thiếu nhân sự</div>
                        <div class="fs-4 fw-bold text-danger">@openIncidentsCount</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Thanh Hành Động Hợp Nhất (Action Bar & Reorganized Navigation) -->
    <div class="card border-0 shadow-sm rounded-3 mb-4 bg-white p-2">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <!-- Nhóm xem lịch & Quản lý -->
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <div class="btn-group p-1 bg-light rounded-pill border" role="group">
                    <a href="@Url.Action("Index", "AdminReceptionistSchedule", new { tab = "weekly", weekOffset, receptionistUserId = filterReceptionistId })" 
                       class="btn btn-sm rounded-pill px-3 @(activeTab == "weekly" ? "btn-primary text-white shadow-sm" : "btn-light text-secondary")" id="btnTabWeekly">
                        <i class="bi bi-calendar-week me-1"></i> Lịch Tuần
                    </a>
                    <a href="@Url.Action("Index", "AdminReceptionistSchedule", new { tab = "monthly", year, month, receptionistUserId = filterReceptionistId })" 
                       class="btn btn-sm rounded-pill px-3 @(activeTab == "monthly" ? "btn-primary text-white shadow-sm" : "btn-light text-secondary")" id="btnTabMonthly">
                        <i class="bi bi-calendar-month me-1"></i> Lịch Tháng
                    </a>
                </div>

                <!-- Menu Quản Lý Nhân Sự -->
                <div class="dropdown">
                    <button class="btn btn-sm @(activeTab != "weekly" && activeTab != "monthly" ? "btn-primary text-white" : "btn-outline-secondary") dropdown-toggle rounded-pill px-3" 
                            type="button" data-bs-toggle="dropdown" aria-expanded="false" id="workforceManagementDropdown">
                        <i class="bi bi-sliders me-1"></i> Quản Lý Nhân Sự
                        @if (pendingLeavesCount > 0 || pendingSwapsCount > 0 || openIncidentsCount > 0)
                        {
                            <span class="badge bg-danger rounded-pill ms-1">@(pendingLeavesCount + pendingSwapsCount + openIncidentsCount)</span>
                        }
                    </button>
                    <ul class="dropdown-menu shadow border-0 rounded-3 mt-1">
                        <li>
                            <a class="dropdown-item @(activeTab == "bulk" ? "active" : "") d-flex justify-content-between align-items-center py-2" 
                               href="@Url.Action("Index", new { tab = "bulk", year, month })" id="menuItemBulk">
                                <span><i class="bi bi-calendar-plus me-2 text-primary"></i>Phân Ca & Sao Chép Tháng</span>
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item @(activeTab == "leaves" ? "active" : "") d-flex justify-content-between align-items-center py-2" 
                               href="@Url.Action("Index", new { tab = "leaves", year, month })" id="menuItemLeaves">
                                <span><i class="bi bi-calendar2-x me-2 text-warning"></i>Đơn Xin Nghỉ Phép</span>
                                @if (pendingLeavesCount > 0)
                                {
                                    <span class="badge bg-warning text-dark rounded-pill ms-2">@pendingLeavesCount</span>
                                }
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item @(activeTab == "swaps" ? "active" : "") d-flex justify-content-between align-items-center py-2" 
                               href="@Url.Action("Index", new { tab = "swaps", year, month })" id="menuItemSwaps">
                                <span><i class="bi bi-arrow-left-right me-2 text-info"></i>Yêu Cầu Đổi Ca</span>
                                @if (pendingSwapsCount > 0)
                                {
                                    <span class="badge bg-info text-dark rounded-pill ms-2">@pendingSwapsCount</span>
                                }
                            </a>
                        </li>
                        <li><hr class="dropdown-divider my-1"></li>
                        <li>
                            <a class="dropdown-item @(activeTab == "incidents" ? "active" : "") d-flex justify-content-between align-items-center py-2" 
                               href="@Url.Action("Index", new { tab = "incidents", year, month })" id="menuItemIncidents">
                                <span><i class="bi bi-exclamation-octagon me-2 text-danger"></i>Giám Sát Nhân Lực & Sự Cố</span>
                                @if (openIncidentsCount > 0)
                                {
                                    <span class="badge bg-danger rounded-pill ms-2">@openIncidentsCount</span>
                                }
                            </a>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Điều Hướng Thời Gian, Lọc Nhân Viên & Nút Phân Công -->
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <!-- Điều hướng khoảng thời gian -->
                @if (activeTab == "weekly")
                {
                    <div class="d-flex align-items-center gap-1 bg-light p-1 rounded-pill border">
                        <a href="@Url.Action("Index", "AdminReceptionistSchedule", new { tab = "weekly", weekOffset = weekOffset - 1, receptionistUserId = filterReceptionistId })" 
                           class="btn btn-outline-secondary btn-sm border-0 rounded-circle" title="Tuần trước" id="btnPrevWeek">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                        <a href="@Url.Action("Index", "AdminReceptionistSchedule", new { tab = "weekly", weekOffset = 0, receptionistUserId = filterReceptionistId })" 
                           class="btn btn-sm border-0 rounded-pill px-2 @(weekOffset == 0 ? "btn-primary text-white" : "btn-light text-secondary")" id="btnTodayWeek">
                            Hôm nay
                        </a>
                        <span class="fw-bold px-2 text-dark small" id="weekRangeLabel">@weekStart.ToString("dd/MM") - @weekEnd.ToString("dd/MM/yyyy")</span>
                        <a href="@Url.Action("Index", "AdminReceptionistSchedule", new { tab = "weekly", weekOffset = weekOffset + 1, receptionistUserId = filterReceptionistId })" 
                           class="btn btn-outline-secondary btn-sm border-0 rounded-circle" title="Tuần sau" id="btnNextWeek">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </div>
                }
                else
                {
                    <div class="d-flex align-items-center gap-1 bg-light p-1 rounded-pill border">
                        <a href="@Url.Action("Index", "AdminReceptionistSchedule", new { tab = activeTab, year = prevYear, month = prevMonth, receptionistUserId = filterReceptionistId })" 
                           class="btn btn-outline-secondary btn-sm border-0 rounded-circle" title="Tháng trước" id="btnPrevMonth">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                        <a href="@Url.Action("Index", "AdminReceptionistSchedule", new { tab = activeTab, year = today.Year, month = today.Month, receptionistUserId = filterReceptionistId })" 
                           class="btn btn-sm border-0 rounded-pill px-2 @(year == today.Year && month == today.Month ? "btn-primary text-white" : "btn-light text-secondary")" id="btnTodayMonth">
                            Hôm nay
                        </a>
                        <span class="fw-bold px-2 text-dark small" id="monthRangeLabel">Tháng @month/@year</span>
                        <a href="@Url.Action("Index", "AdminReceptionistSchedule", new { tab = activeTab, year = nextYear, month = nextMonth, receptionistUserId = filterReceptionistId })" 
                           class="btn btn-outline-secondary btn-sm border-0 rounded-circle" title="Tháng sau" id="btnNextMonth">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </div>
                }

                <!-- Bộ lọc nhân viên -->
                <form method="get" class="d-inline-flex m-0">
                    <input type="hidden" name="tab" value="@activeTab" />
                    @if (activeTab == "weekly")
                    {
                        <input type="hidden" name="weekOffset" value="@weekOffset" />
                    }
                    else
                    {
                        <input type="hidden" name="year" value="@year" />
                        <input type="hidden" name="month" value="@month" />
                    }
                    <select name="receptionistUserId" class="form-select form-select-sm rounded-pill" style="min-width: 170px;" onchange="this.form.submit()" id="receptionistFilterSelect">
                        <option value="">-- Tất cả lễ tân --</option>
                        @foreach (var r in receptionists)
                        {
                            <option value="@r.UserId" selected="@(filterReceptionistId == r.UserId)">@r.FullName</option>
                        }
                    </select>
                </form>

                <!-- Nút Phân công ca -->
                <button type="button" class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#createShiftModal" id="btnHeaderAssign">
                    <i class="bi bi-plus-lg me-1"></i> Phân công ca
                </button>
            </div>
        </div>
    </div>

    <!-- ========================================== -->
    <!-- TAB 1: LỊCH TRỰC THEO TUẦN (WEEKLY VIEW)   -->
    <!-- ========================================== -->
    @if (activeTab == "weekly")
    {
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <div class="fw-bold text-dark">
                    <i class="bi bi-calendar2-range text-primary me-2"></i>Lưới Lịch Tuần (@weekStart.ToString("dd/MM/yyyy") - @weekEnd.ToString("dd/MM/yyyy"))
                </div>
                <div class="small text-muted">
                    <i class="bi bi-info-circle me-1"></i>Nhấp vào bất kỳ ô ca trực nào để xem và quản lý danh sách người trực
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-bordered mb-0 align-top" style="table-layout: fixed; min-width: 950px;" id="weeklyScheduleTable">
                        <thead class="table-light text-center">
                            <tr>
                                <th style="width: 130px;" class="align-middle bg-light text-muted small fw-bold">Ca Trực</th>
                                @for (int i = 0; i < 7; i++)
                                {
                                    var d = weekDays[i];
                                    bool isCurToday = (d == today);
                                    <th class="@(isCurToday ? "bg-primary-subtle border-primary text-primary" : "") p-2">
                                        <div class="fw-bold @(i >= 5 ? "text-danger" : "text-dark")">@dayNamesVn[i]</div>
                                        <div class="small text-muted">@d.ToString("dd/MM")</div>
                                        @if (isCurToday)
                                        {
                                            <span class="badge bg-primary text-white mt-1" style="font-size: 9px;">Hôm nay</span>
                                        }
                                    </th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            <!-- CA SÁNG: 08:00 - 12:00 -->
                            <tr>
                                <td class="bg-light align-middle text-center p-2">
                                    <div class="fw-bold text-warning-emphasis mb-1">
                                        <i class="bi bi-sun-fill text-warning me-1"></i>Ca Sáng
                                    </div>
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle small">08:00 - 12:00</span>
                                </td>
                                @for (int i = 0; i < 7; i++)
                                {
                                    var d = weekDays[i];
                                    var dayDto = monthlyData?.Days.FirstOrDefault(x => x.Date == d);
                                    var morningShifts = dayDto?.Shifts
                                        .Where(s => s.StartTime < new TimeOnly(13, 0))
                                        .ToList() ?? new List<ReceptionistWorkScheduleDto>();
                                    var dayLeaves = dayDto?.ApprovedLeaves ?? new List<ReceptionistLeaveSummaryDto>();

                                    int mCount = morningShifts.Count;
                                    bool isPast = d < today;

                                    var staffPayload = morningShifts.Select(s => new
                                    {
                                        scheduleId = s.ReceptionistScheduleId,
                                        userId = s.ReceptionistUserId,
                                        name = s.ReceptionistName,
                                        code = s.EmployeeCode,
                                        startTime = s.StartTime.ToString("HH:mm"),
                                        endTime = s.EndTime.ToString("HH:mm"),
                                        isOnLeave = dayLeaves.Any(l => l.ReceptionistUserId == s.ReceptionistUserId),
                                        status = s.Status,
                                        notes = s.Notes ?? ""
                                    }).ToList();

                                    <td class="schedule-shift-cell p-2 align-middle text-center @(d == today ? "bg-primary-subtle bg-opacity-10" : "bg-white")"
                                        data-date="@d.ToString("yyyy-MM-dd")"
                                        data-date-display="@($"{dayNamesVn[i]}, {d:dd/MM/yyyy}")"
                                        data-shift="morning"
                                        data-shift-name="Ca Sáng"
                                        data-shift-time="08:00 - 12:00"
                                        data-is-past="@(isPast ? "true" : "false")"
                                        data-req-count="@morningReq"
                                        data-staff-json="@JsonSerializer.Serialize(staffPayload)"
                                        onclick="openShiftDrawerFromCell(this)">
                                        
                                        <div class="d-flex flex-column align-items-center justify-content-center py-2">
                                            <!-- Staff Icon & Count -->
                                            <div class="fw-bold fs-6 mb-1 text-dark">
                                                <i class="bi bi-people-fill text-primary me-1"></i> @mCount người
                                            </div>

                                            <!-- Staffing Requirement Status -->
                                            <div class="mb-2">
                                                @if (mCount == 0)
                                                {
                                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle small fw-normal">
                                                        0 người — Chưa phân công
                                                    </span>
                                                }
                                                else if (morningReq > 0 && mCount < morningReq)
                                                {
                                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle small fw-normal">
                                                        @mCount người — Thiếu nhân sự
                                                    </span>
                                                }
                                                else if (morningReq > 0 && mCount >= morningReq)
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle small fw-normal">
                                                        Đủ nhân sự
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle small fw-normal">
                                                        @mCount người trực
                                                    </span>
                                                }
                                            </div>

                                            <!-- Action Link -->
                                            <div class="text-primary small fw-semibold d-inline-flex align-items-center">
                                                <i class="bi bi-person-lines-fill me-1"></i>Xem người trực
                                            </div>
                                        </div>
                                    </td>
                                }
                            </tr>

                            <!-- CA CHIỀU: 13:30 - 17:30 -->
                            <tr>
                                <td class="bg-light align-middle text-center p-2">
                                    <div class="fw-bold text-primary mb-1">
                                        <i class="bi bi-sunset-fill text-primary me-1"></i>Ca Chiều
                                    </div>
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle small">13:30 - 17:30</span>
                                </td>
                                @for (int i = 0; i < 7; i++)
                                {
                                    var d = weekDays[i];
                                    var dayDto = monthlyData?.Days.FirstOrDefault(x => x.Date == d);
                                    var afternoonShifts = dayDto?.Shifts
                                        .Where(s => s.StartTime >= new TimeOnly(13, 0))
                                        .ToList() ?? new List<ReceptionistWorkScheduleDto>();
                                    var dayLeaves = dayDto?.ApprovedLeaves ?? new List<ReceptionistLeaveSummaryDto>();

                                    int aCount = afternoonShifts.Count;
                                    bool isPast = d < today;

                                    var staffPayload = afternoonShifts.Select(s => new
                                    {
                                        scheduleId = s.ReceptionistScheduleId,
                                        userId = s.ReceptionistUserId,
                                        name = s.ReceptionistName,
                                        code = s.EmployeeCode,
                                        startTime = s.StartTime.ToString("HH:mm"),
                                        endTime = s.EndTime.ToString("HH:mm"),
                                        isOnLeave = dayLeaves.Any(l => l.ReceptionistUserId == s.ReceptionistUserId),
                                        status = s.Status,
                                        notes = s.Notes ?? ""
                                    }).ToList();

                                    <td class="schedule-shift-cell p-2 align-middle text-center @(d == today ? "bg-primary-subtle bg-opacity-10" : "bg-white")"
                                        data-date="@d.ToString("yyyy-MM-dd")"
                                        data-date-display="@($"{dayNamesVn[i]}, {d:dd/MM/yyyy}")"
                                        data-shift="afternoon"
                                        data-shift-name="Ca Chiều"
                                        data-shift-time="13:30 - 17:30"
                                        data-is-past="@(isPast ? "true" : "false")"
                                        data-req-count="@afternoonReq"
                                        data-staff-json="@JsonSerializer.Serialize(staffPayload)"
                                        onclick="openShiftDrawerFromCell(this)">
                                        
                                        <div class="d-flex flex-column align-items-center justify-content-center py-2">
                                            <!-- Staff Icon & Count -->
                                            <div class="fw-bold fs-6 mb-1 text-dark">
                                                <i class="bi bi-people-fill text-primary me-1"></i> @aCount người
                                            </div>

                                            <!-- Staffing Requirement Status -->
                                            <div class="mb-2">
                                                @if (aCount == 0)
                                                {
                                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle small fw-normal">
                                                        0 người — Chưa phân công
                                                    </span>
                                                }
                                                else if (afternoonReq > 0 && aCount < afternoonReq)
                                                {
                                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle small fw-normal">
                                                        @aCount người — Thiếu nhân sự
                                                    </span>
                                                }
                                                else if (afternoonReq > 0 && aCount >= afternoonReq)
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle small fw-normal">
                                                        Đủ nhân sự
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle small fw-normal">
                                                        @aCount người trực
                                                    </span>
                                                }
                                            </div>

                                            <!-- Action Link -->
                                            <div class="text-primary small fw-semibold d-inline-flex align-items-center">
                                                <i class="bi bi-person-lines-fill me-1"></i>Xem người trực
                                            </div>
                                        </div>
                                    </td>
                                }
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <!-- ========================================== -->
    <!-- TAB 2: LỊCH TRỰC THEO THÁNG (MONTHLY VIEW) -->
    <!-- ========================================== -->
    @if (activeTab == "monthly")
    {
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <div class="fw-bold text-dark">
                    <i class="bi bi-calendar-month text-primary me-2"></i>Lưới Lịch Làm Việc Tháng @month/@year
                </div>
                <div class="small text-muted">
                    <i class="bi bi-info-circle me-1"></i>Nhấp vào ngày bất kỳ để xem chi tiết hai ca sáng/chiều
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-bordered mb-0 text-center" style="table-layout: fixed; min-width: 950px;" id="monthlyScheduleTable">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 14.28%;">Thứ 2</th>
                                <th style="width: 14.28%;">Thứ 3</th>
                                <th style="width: 14.28%;">Thứ 4</th>
                                <th style="width: 14.28%;">Thứ 5</th>
                                <th style="width: 14.28%;">Thứ 6</th>
                                <th style="width: 14.28%;">Thứ 7</th>
                                <th style="width: 14.28%;">Chủ Nhật</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (monthlyData != null && monthlyData.Days.Any())
                            {
                                int firstDayDow = (int)monthlyData.Days.First().Date.DayOfWeek;
                                int offset = firstDayDow == 0 ? 6 : firstDayDow - 1; // 0=Mon, 6=Sun
                                int totalCells = offset + monthlyData.Days.Count;
                                int rows = (int)Math.Ceiling((double)totalCells / 7);

                                int dayIndex = 0;
                                for (int r = 0; r < rows; r++)
                                {
                                    <tr>
                                        @for (int c = 0; c < 7; c++)
                                        {
                                            int cellIndex = r * 7 + c;
                                            if (cellIndex < offset || dayIndex >= monthlyData.Days.Count)
                                            {
                                                <td class="bg-light text-muted p-2" style="height: 115px;"></td>
                                            }
                                            else
                                            {
                                                var day = monthlyData.Days[dayIndex];
                                                dayIndex++;
                                                bool isToday = day.Date == ClinicTimeHelper.TodayDateOnly;
                                                bool isPast = day.Date < today;

                                                var dayMorningShifts = day.Shifts.Where(s => s.StartTime < new TimeOnly(13, 0)).ToList();
                                                var dayAfternoonShifts = day.Shifts.Where(s => s.StartTime >= new TimeOnly(13, 0)).ToList();
                                                var dayLeaves = day.ApprovedLeaves ?? new List<ReceptionistLeaveSummaryDto>();

                                                var morningPayload = dayMorningShifts.Select(s => new
                                                {
                                                    scheduleId = s.ReceptionistScheduleId,
                                                    userId = s.ReceptionistUserId,
                                                    name = s.ReceptionistName,
                                                    code = s.EmployeeCode,
                                                    startTime = s.StartTime.ToString("HH:mm"),
                                                    endTime = s.EndTime.ToString("HH:mm"),
                                                    isOnLeave = dayLeaves.Any(l => l.ReceptionistUserId == s.ReceptionistUserId),
                                                    status = s.Status,
                                                    notes = s.Notes ?? ""
                                                }).ToList();

                                                var afternoonPayload = dayAfternoonShifts.Select(s => new
                                                {
                                                    scheduleId = s.ReceptionistScheduleId,
                                                    userId = s.ReceptionistUserId,
                                                    name = s.ReceptionistName,
                                                    code = s.EmployeeCode,
                                                    startTime = s.StartTime.ToString("HH:mm"),
                                                    endTime = s.EndTime.ToString("HH:mm"),
                                                    isOnLeave = dayLeaves.Any(l => l.ReceptionistUserId == s.ReceptionistUserId),
                                                    status = s.Status,
                                                    notes = s.Notes ?? ""
                                                }).ToList();

                                                <td class="monthly-day-cell p-2 align-top text-start @(isToday ? "border-primary bg-primary-subtle bg-opacity-10" : "bg-white")"
                                                    data-date="@day.Date.ToString("yyyy-MM-dd")"
                                                    data-date-display="@($"{day.Date:dd/MM/yyyy}")"
                                                    data-is-past="@(isPast ? "true" : "false")"
                                                    data-morning-staff-json="@JsonSerializer.Serialize(morningPayload)"
                                                    data-afternoon-staff-json="@JsonSerializer.Serialize(afternoonPayload)"
                                                    data-morning-req="@morningReq"
                                                    data-afternoon-req="@afternoonReq"
                                                    onclick="openDayDrawerFromCell(this)">
                                                    
                                                    <!-- Day Number Header & Alerts -->
                                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                                        <span class="badge @(isToday ? "bg-primary" : "bg-secondary") rounded-pill">
                                                            @day.Date.Day
                                                        </span>
                                                        @if (day.DistinctApprovedLeaveCount > 0)
                                                        {
                                                            <span class="badge bg-warning text-dark" style="font-size: 0.7rem;" title="@day.DistinctApprovedLeaveCount lễ tân nghỉ phép">
                                                                @day.DistinctApprovedLeaveCount nghỉ
                                                            </span>
                                                        }
                                                    </div>

                                                    <!-- Shift Summaries (No individual staff names, no overflow) -->
                                                    <div class="d-flex flex-column gap-1">
                                                        <div class="p-1 px-2 rounded bg-warning-subtle text-warning-emphasis border border-warning-subtle d-flex justify-content-between align-items-center">
                                                            <span style="font-size: 0.72rem;" class="fw-semibold">
                                                                <i class="bi bi-sun-fill me-1 text-warning"></i>Ca sáng:
                                                            </span>
                                                            <span class="badge bg-white text-dark border" style="font-size: 0.7rem;">
                                                                @dayMorningShifts.Count người
                                                            </span>
                                                        </div>

                                                        <div class="p-1 px-2 rounded bg-primary-subtle text-primary border border-primary-subtle d-flex justify-content-between align-items-center">
                                                            <span style="font-size: 0.72rem;" class="fw-semibold">
                                                                <i class="bi bi-sunset-fill me-1 text-primary"></i>Ca chiều:
                                                            </span>
                                                            <span class="badge bg-white text-dark border" style="font-size: 0.7rem;">
                                                                @dayAfternoonShifts.Count người
                                                            </span>
                                                        </div>

                                                        @if (day.HasCoverageShortage && day.Date >= today)
                                                        {
                                                            <div class="text-danger small mt-1 fw-semibold" style="font-size: 0.68rem;">
                                                                <i class="bi bi-exclamation-triangle-fill me-1"></i>Thiếu nhân sự
                                                            </div>
                                                        }
                                                    </div>
                                                </td>
                                            }
                                        }
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <!-- ========================================== -->
    <!-- TAB 3: PHÂN CA & SAO CHÉP THÁNG (BULK)     -->
    <!-- ========================================== -->
    @if (activeTab == "bulk")
    {
        <div class="row g-4">
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0 fw-bold text-primary"><i class="bi bi-calendar-plus me-2"></i>Phân Ca Hàng Loạt Theo Tháng</h5>
                    </div>
                    <div class="card-body p-4">
                        <form method="post" action="@Url.Action("BulkApply")" id="bulkScheduleForm">
                            <input type="hidden" name="Year" value="@year" />
                            <input type="hidden" name="Month" value="@month" />

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Ca Mẫu (Shift Template)</label>
                                <select name="ShiftTemplateId" class="form-select" required id="bulkTemplateSelect">
                                    @foreach (var t in templates)
                                    {
                                        <option value="@t.ShiftTemplateId">@t.TemplateName (@t.StartTime.ToString("HH:mm") - @t.EndTime.ToString("HH:mm"))</option>
                                    }
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Chọn Lễ Tân Trực Ca</label>
                                <div class="row g-2 border rounded p-2 bg-light">
                                    @foreach (var r in receptionists)
                                    {
                                        <div class="col-md-6">
                                            <div class="form-check">
                                                <input class="form-check-input bulk-staff-check" type="checkbox" name="ReceptionistUserIds" value="@r.UserId" id="staff_@r.UserId">
                                                <label class="form-check-label small fw-medium" for="staff_@r.UserId">
                                                    @r.FullName (@r.Email)
                                                </label>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Các Ngày Trong Tuần Áp Dụng</label>
                                <div class="d-flex gap-2 flex-wrap">
                                    @{
                                        string[] dows = { "Thứ 2", "Thứ 3", "Thứ 4", "Thứ 5", "Thứ 6", "Thứ 7", "Chủ Nhật" };
                                        for (int i = 1; i <= 7; i++)
                                        {
                                            <div class="form-check form-check-inline">
                                                <input class="form-check-input bulk-dow-check" type="checkbox" name="DaysOfWeek" value="@i" id="dow_@i" checked>
                                                <label class="form-check-label" for="dow_@i">@dows[i - 1]</label>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>

                            <div class="form-check mb-4">
                                <input class="form-check-input" type="checkbox" name="OverwriteExisting" value="true" id="overwriteCheck">
                                <label class="form-check-label text-muted" for="overwriteCheck">
                                    Ghi đè ca trực đã có sẵn trên những ngày này
                                </label>
                            </div>

                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-outline-primary" id="btnPreviewBulk">
                                    <i class="bi bi-eye me-1"></i> Xem Trước (Preview)
                                </button>
                                <button type="submit" class="btn btn-primary" id="btnApplyBulk">
                                    <i class="bi bi-check-lg me-1"></i> Áp Dụng Lịch Tháng (Apply)
                                </button>
                            </div>
                        </form>

                        <div id="bulkPreviewResult" class="mt-4 d-none">
                            <div class="alert alert-info">
                                <h6 class="fw-bold mb-2"><i class="bi bi-info-circle me-1"></i> Kết Quả Xem Trước:</h6>
                                <p class="mb-1" id="previewProposedCount"></p>
                                <p class="mb-1" id="previewConflictCount"></p>
                                <div id="previewWarnings" class="small text-danger"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Copy Month Column -->
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0 fw-bold text-success"><i class="bi bi-files me-2"></i>Sao Chép Lịch Từ Tháng Khác</h5>
                    </div>
                    <div class="card-body p-4">
                        <form method="post" action="@Url.Action("CopyMonth")">
                            <input type="hidden" name="TargetYear" value="@year" />
                            <input type="hidden" name="TargetMonth" value="@month" />

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Tháng Nguồn (Cần sao chép)</label>
                                <div class="row g-2">
                                    <div class="col-6">
                                        <select name="SourceMonth" class="form-select">
                                            @for (int m = 1; m <= 12; m++)
                                            {
                                                <option value="@m" selected="@(m == prevMonth)">Tháng @m</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-6">
                                        <input type="number" name="SourceYear" value="@prevYear" class="form-control" />
                                    </div>
                                </div>
                            </div>

                            <div class="mb-4">
                                <label class="form-label fw-semibold">Tháng Đích</label>
                                <input type="text" class="form-control bg-light" value="Tháng @month / @year" readonly />
                            </div>

                            <div class="form-check mb-4">
                                <input class="form-check-input" type="checkbox" name="OverwriteExisting" value="true" id="copyOverwrite">
                                <label class="form-check-label text-muted" for="copyOverwrite">
                                    Ghi đè ca trực đã có trong tháng đích
                                </label>
                            </div>

                            <button type="submit" class="btn btn-success w-100" id="btnCopyMonth">
                                <i class="bi bi-copy me-1"></i> Thực Hiện Sao Chép
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- ========================================== -->
    <!-- TAB 4: ĐƠN XIN NGHỈ PHÉP (LEAVES)          -->
    <!-- ========================================== -->
    @if (activeTab == "leaves")
    {
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-calendar2-x text-warning me-2"></i>Danh Sách Đơn Xin Nghỉ Phép</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="leaveRequestsTable">
                        <thead class="table-light">
                            <tr>
                                <th>Lễ Tân</th>
                                <th>Loại Nghỉ</th>
                                <th>Thời Gian</th>
                                <th>Lý Do</th>
                                <th>Ngày Gửi</th>
                                <th>Trạng Thái</th>
                                <th class="text-end">Thao Tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!leaves.Any())
                            {
                                <tr>
                                    <td colspan="7" class="text-center text-muted py-4">Chưa có đơn xin nghỉ phép nào.</td>
                                </tr>
                            }
                            @foreach (var l in leaves)
                            {
                                <tr>
                                    <td>
                                        <span class="fw-semibold">@l.ReceptionistName</span>
                                        <div class="small text-muted">@l.EmployeeCode</div>
                                    </td>
                                    <td><span class="badge bg-secondary">@l.LeaveType</span></td>
                                    <td>
                                        <div>@l.StartDate.ToString("dd/MM/yyyy") - @l.EndDate.ToString("dd/MM/yyyy")</div>
                                        @if (l.StartTime.HasValue && l.EndTime.HasValue)
                                        {
                                            <small class="text-muted">(@l.StartTime.Value.ToString("HH:mm") - @l.EndTime.Value.ToString("HH:mm"))</small>
                                        }
                                    </td>
                                    <td>@l.Reason</td>
                                    <td>@l.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        @if (l.Status == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark">Chờ Duyệt</span>
                                        }
                                        else if (l.Status == "Approved")
                                        {
                                            <span class="badge bg-success">Đã Duyệt</span>
                                        }
                                        else if (l.Status == "Rejected")
                                        {
                                            <span class="badge bg-danger">Đã Từ Chối</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@l.Status</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (l.Status == "Pending")
                                        {
                                            <button class="btn btn-outline-info btn-sm btn-preview-impact me-1" data-leave-id="@l.LeaveRequestId" title="Xem trước tác động nhân sự">
                                                <i class="bi bi-shield-check"></i> Kiểm Tra
                                            </button>
                                            <form method="post" action="@Url.Action("ApproveLeave", new { leaveId = l.LeaveRequestId })" class="d-inline">
                                                <button type="submit" class="btn btn-success btn-sm btn-approve-leave me-1" onclick="return confirm('Bạn có chắc chắn muốn duyệt đơn nghỉ này?');">
                                                    <i class="bi bi-check-lg"></i> Duyệt
                                                </button>
                                            </form>
                                            <button class="btn btn-outline-danger btn-sm btn-reject-modal" data-leave-id="@l.LeaveRequestId" data-bs-toggle="modal" data-bs-target="#rejectLeaveModal">
                                                <i class="bi bi-x-lg"></i> Từ Chối
                                            </button>
                                        }
                                        else if (l.Status == "Approved")
                                        {
                                            <form method="post" action="@Url.Action("CancelLeave", new { leaveId = l.LeaveRequestId })" class="d-inline">
                                                <button type="submit" class="btn btn-outline-secondary btn-sm" onclick="return confirm('Hủy lịch nghỉ phép đã duyệt này?');">
                                                    Hủy Nghỉ
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <!-- ========================================== -->
    <!-- TAB 5: YÊU CẦU ĐỔI CA (SHIFTS SWAPS)        -->
    <!-- ========================================== -->
    @if (activeTab == "swaps")
    {
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-arrow-left-right text-info me-2"></i>Yêu Cầu Hoán Đổi Ca Trực</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="shiftSwapsTable">
                        <thead class="table-light">
                            <tr>
                                <th>Người Đề Xuất</th>
                                <th>Đồng Nghiệp Nhận</th>
                                <th>Ca Đề Xuất</th>
                                <th>Ca Đối Ứng</th>
                                <th>Lý Do</th>
                                <th>Trạng Thái</th>
                                <th class="text-end">Quyết Định Admin</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!swaps.Any())
                            {
                                <tr>
                                    <td colspan="7" class="text-center text-muted py-4">Chưa có yêu cầu đổi ca nào.</td>
                                </tr>
                            }
                            @foreach (var s in swaps)
                            {
                                <tr>
                                    <td><span class="fw-semibold">@s.RequestingReceptionistName</span></td>
                                    <td><span class="fw-semibold">@s.TargetReceptionistName</span></td>
                                    <td>
                                        <div>@s.SourceWorkDate.ToString("dd/MM/yyyy")</div>
                                        <small class="text-muted">@s.SourceStartTime.ToString("HH:mm") - @s.SourceEndTime.ToString("HH:mm")</small>
                                    </td>
                                    <td>
                                        @if (s.TargetWorkDate.HasValue)
                                        {
                                            <div>@s.TargetWorkDate.Value.ToString("dd/MM/yyyy")</div>
                                            <small class="text-muted">@s.TargetStartTime?.ToString("HH:mm") - @s.TargetEndTime?.ToString("HH:mm")</small>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Chuyển hẳn 1 chiều</span>
                                        }
                                    </td>
                                    <td>@s.Reason</td>
                                    <td>
                                        @if (s.Status == "PendingCounterparty")
                                        {
                                            <span class="badge bg-secondary">Chờ Đồng Nghiệp Nhận</span>
                                        }
                                        else if (s.Status == "PendingAdminApproval")
                                        {
                                            <span class="badge bg-warning text-dark">Chờ Admin Duyệt</span>
                                        }
                                        else if (s.Status == "Approved")
                                        {
                                            <span class="badge bg-success">Đã Đổi Ca</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">@s.Status</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (s.Status == "PendingAdminApproval")
                                        {
                                            <form method="post" action="@Url.Action("DecideSwap", new { swapId = s.SwapRequestId })" class="d-inline">
                                                <input type="hidden" name="approve" value="true" />
                                                <button type="submit" class="btn btn-success btn-sm me-1 btn-approve-swap" onclick="return confirm('Xác nhận duyệt đổi ca trực này?');">
                                                    <i class="bi bi-check-lg"></i> Duyệt Đổi Ca
                                                </button>
                                            </form>
                                            <form method="post" action="@Url.Action("DecideSwap", new { swapId = s.SwapRequestId })" class="d-inline">
                                                <input type="hidden" name="approve" value="false" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Từ chối đổi ca?');">
                                                    <i class="bi bi-x-lg"></i> Từ Chối
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <!-- ========================================== -->
    <!-- TAB 6: GIÁM SÁT NHÂN LỰC & SỰ CỐ           -->
    <!-- ========================================== -->
    @if (activeTab == "incidents")
    {
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-shield-exclamation text-danger me-2"></i>Giám Sát Nhân Lực & Sự Cố Thiếu Người</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="coverageIncidentsTable">
                        <thead class="table-light">
                            <tr>
                                <th>Ngày & Khung Giờ</th>
                                <th>Nhân Sự Bị Ảnh Hưởng</th>
                                <th>Số Người Trực (Hiện/Yêu Cầu)</th>
                                <th>Thiếu Hụt</th>
                                <th>Lý Do Vắng Mặt</th>
                                <th>Trạng Thái</th>
                                <th class="text-end">Thao Tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!incidents.Any())
                            {
                                <tr>
                                    <td colspan="7" class="text-center text-muted py-4">Không có sự cố thiếu nhân sự nào.</td>
                                </tr>
                            }
                            @foreach (var i in incidents)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">@i.WorkDate.ToString("dd/MM/yyyy")</div>
                                        <small class="text-muted">@i.ShiftStartTime.ToString("HH:mm") - @i.ShiftEndTime.ToString("HH:mm")</small>
                                    </td>
                                    <td>@(i.AffectedReceptionistName ?? "Vắng khẩn cấp")</td>
                                    <td>
                                        <span class="badge @(i.AvailableStaffCount < i.RequiredMinimumCount ? "bg-danger" : "bg-success")">
                                            @i.AvailableStaffCount / @i.RequiredMinimumCount người
                                        </span>
                                    </td>
                                    <td>
                                        @if (i.ShortageCount > 0)
                                        {
                                            <span class="badge bg-danger">Thiếu @i.ShortageCount người</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Đủ</span>
                                        }
                                    </td>
                                    <td>@i.Reason</td>
                                    <td>
                                        <span class="badge @(i.Status == "Open" ? "bg-danger" : "bg-success")">@i.Status</span>
                                    </td>
                                    <td class="text-end">
                                        @if (i.Status == "Open")
                                        {
                                            <button class="btn btn-primary btn-sm btn-resolve-incident" data-incident-id="@i.IncidentId" data-bs-toggle="modal" data-bs-target="#resolveIncidentModal">
                                                <i class="bi bi-person-plus"></i> Điều Phối Bổ Sung
                                            </button>
                                        }
                                        else
                                        {
                                            <small class="text-muted">Đã xử lý: @i.ReplacementReceptionistName</small>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

<!-- ========================================== -->
<!-- RIGHT-SIDE DRAWER: CHI TIẾT CA TRỰC        -->
<!-- ========================================== -->
<div class="offcanvas offcanvas-end shadow-lg" tabindex="-1" id="shiftDetailsDrawer" aria-labelledby="shiftDetailsDrawerTitle">
    <div class="offcanvas-header border-bottom bg-light">
        <div>
            <h5 class="offcanvas-title fw-bold text-dark mb-0" id="shiftDetailsDrawerTitle">
                <i class="bi bi-calendar2-check text-primary me-2"></i>Chi Tiết Ca Trực
            </h5>
            <div class="text-muted small mt-1" id="shiftDetailsDrawerSubtitle">
                Thứ Hai, 16/11/2026 · Ca Sáng (08:00 - 12:00)
            </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body d-flex flex-column p-0">
        <div id="shiftDrawerContent" class="flex-grow-1 p-3 overflow-auto">
            <!-- Nội dung được nạp động từ JS -->
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- MODAL: XÁC NHẬN HỦY CA TRỰC                -->
<!-- ========================================== -->
<div class="modal fade" id="deleteShiftConfirmModal" tabindex="-1" aria-labelledby="deleteShiftConfirmModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" action="@Url.Action("DeleteSchedule")" id="deleteShiftForm">
                <input type="hidden" name="scheduleId" id="delScheduleId" value="0" />
                <input type="hidden" name="year" id="delYear" value="@year" />
                <input type="hidden" name="month" id="delMonth" value="@month" />
                <input type="hidden" name="tab" id="delTab" value="@activeTab" />
                <input type="hidden" name="weekOffset" id="delWeekOffset" value="@weekOffset" />

                <div class="modal-header border-bottom">
                    <h5 class="modal-title fw-bold text-danger" id="deleteShiftConfirmModalLabel">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>Xác Nhận Hủy Phân Công Ca Trực
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body py-4">
                    <p class="text-muted mb-3">Bạn có chắc chắn muốn hủy phân công ca trực này không? Thao tác này sẽ xóa ca trực khỏi lịch làm việc.</p>
                    <div class="card bg-light border p-3 rounded-3">
                        <div class="mb-2">
                            <span class="text-muted small">Nhân viên:</span>
                            <div class="fw-bold text-dark fs-6" id="delStaffNameText">Nguyễn Thị Lan</div>
                        </div>
                        <div class="mb-2">
                            <span class="text-muted small">Ngày làm việc:</span>
                            <div class="fw-semibold text-dark" id="delDateText">16/11/2026</div>
                        </div>
                        <div>
                            <span class="text-muted small">Ca trực:</span>
                            <div class="fw-semibold text-primary" id="delShiftText">Ca Sáng (08:00 - 12:00)</div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top">
                    <button type="button" class="btn btn-secondary px-3" data-bs-dismiss="modal">Quay Lại</button>
                    <button type="submit" class="btn btn-danger px-3" id="btnConfirmDeleteShift">
                        <i class="bi bi-trash3-fill me-1"></i> Xác Nhận Hủy
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- MODAL: THÊM CA TRỰC ĐƠN LẺ                 -->
<!-- ========================================== -->
<div class="modal fade" id="createShiftModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" action="@Url.Action("CreateSchedule")" id="createShiftForm">
                <input type="hidden" name="tab" value="@activeTab" />
                <input type="hidden" name="weekOffset" value="@weekOffset" />

                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Phân Công Ca Trực Lễ Tân</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Lễ Tân</label>
                        <select name="ReceptionistUserId" class="form-select" required id="modalStaffSelect">
                            @foreach (var r in receptionists)
                            {
                                <option value="@r.UserId">@r.FullName (@r.Email)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Ngày Làm Việc</label>
                        <input type="date" name="WorkDate" class="form-control" value="@ClinicTimeHelper.Today.ToString("yyyy-MM-dd")" required id="modalWorkDateInput" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Ca Làm Việc Cố Định</label>
                        <select id="receptionistShiftSelect" class="form-select" onchange="updateReceptionistShiftTimes(this.value)">
                            <option value="morning" data-start="08:00:00" data-end="12:00:00" data-tpl="@(templates.FirstOrDefault(t => t.StartTime < new TimeOnly(13, 0))?.ShiftTemplateId)">Ca Sáng (08:00 - 12:00)</option>
                            <option value="afternoon" data-start="13:30:00" data-end="17:30:00" data-tpl="@(templates.FirstOrDefault(t => t.StartTime >= new TimeOnly(13, 0))?.ShiftTemplateId)">Ca Chiều (13:30 - 17:30)</option>
                        </select>
                        <input type="hidden" name="StartTime" id="modalShiftStartTime" value="08:00:00" />
                        <input type="hidden" name="EndTime" id="modalShiftEndTime" value="12:00:00" />
                        <input type="hidden" name="ShiftTemplateId" id="modalShiftTemplateId" value="@(templates.FirstOrDefault(t => t.StartTime < new TimeOnly(13, 0))?.ShiftTemplateId)" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Ghi Chú</label>
                        <input type="text" name="Notes" class="form-control" placeholder="Tùy chọn..." id="modalNotesInput" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary" id="btnSubmitCreateShift">Lưu Ca Trực</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Kiểm Tra Tác Động Nghỉ Phép (Rule 1 & Rule 2) -->
<div class="modal fade" id="impactModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="bi bi-shield-check text-primary me-2"></i>Kiểm Tra Quy Chuẩn Nhân Sự (Rule 1 & Rule 2)</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="impactModalBody">
                <div class="text-center py-4">
                    <div class="spinner-border text-primary" role="status"></div>
                    <div class="mt-2 text-muted">Đang tính toán nhân sự các ca...</div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Từ Chối Đơn Nghỉ -->
<div class="modal fade" id="rejectLeaveModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" id="rejectLeaveForm">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold text-danger">Từ Chối Đơn Xin Nghỉ Phép</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Lý Do Từ Chối (Bắt buộc)</label>
                        <textarea name="reason" class="form-control" rows="3" required placeholder="Nhập lý do từ chối đơn..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-danger">Xác Nhận Từ Chối</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Giải Quyết Sự Cố Thiếu Người -->
<div class="modal fade" id="resolveIncidentModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" id="resolveIncidentForm">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold text-primary">Điều Phối Nhân Sự Thay Thế</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Chọn Lễ Tân Trực Thay</label>
                        <select name="ReplacementReceptionistUserId" class="form-select">
                            <option value="">-- Không phân người thay (chỉ ghi nhận) --</option>
                            @foreach (var r in receptionists)
                            {
                                <option value="@r.UserId">@r.FullName (@r.Email)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Phương Án Xử Lý & Ghi Chú</label>
                        <textarea name="ResolutionNotes" class="form-control" rows="3" required placeholder="Nhập phương án điều phối xử lý..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary" id="btnConfirmResolveIncident">Lưu Phương Án</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function escapeHtml(str) {
        if (!str) return '';
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }

    function updateReceptionistShiftTimes(val) {
        const sel = document.getElementById('receptionistShiftSelect');
        if (!sel) return;
        const opt = sel.options[sel.selectedIndex];
        document.getElementById('modalShiftStartTime').value = opt.getAttribute('data-start') || '08:00:00';
        document.getElementById('modalShiftEndTime').value = opt.getAttribute('data-end') || '12:00:00';
        const tpl = opt.getAttribute('data-tpl');
        document.getElementById('modalShiftTemplateId').value = tpl || '';
    }

    // Mở Modal Phân Công và điền sẵn ngày + ca
    function openAssignModal(date, shift) {
        // Đóng Drawer nếu đang mở
        const drawerEl = document.getElementById('shiftDetailsDrawer');
        if (drawerEl) {
            const drawerInstance = bootstrap.Offcanvas.getInstance(drawerEl);
            if (drawerInstance) {
                drawerInstance.hide();
            }
        }

        const dateInput = document.getElementById('modalWorkDateInput');
        if (dateInput && date) {
            dateInput.value = date;
        }

        const shiftSelect = document.getElementById('receptionistShiftSelect');
        if (shiftSelect && shift) {
            shiftSelect.value = (shift === 'afternoon') ? 'afternoon' : 'morning';
            updateReceptionistShiftTimes(shiftSelect.value);
        }

        const modalEl = document.getElementById('createShiftModal');
        if (modalEl) {
            const modalInstance = bootstrap.Modal.getOrCreateInstance(modalEl);
            modalInstance.show();
        }
    }

    // Mở Modal Xác Nhận Hủy Ca Trực
    function confirmDeleteShift(scheduleId, staffName, dateStr, shiftStr) {
        document.getElementById('delScheduleId').value = scheduleId;
        document.getElementById('delStaffNameText').textContent = staffName;
        document.getElementById('delDateText').textContent = dateStr;
        document.getElementById('delShiftText').textContent = shiftStr;

        const modalEl = document.getElementById('deleteShiftConfirmModal');
        if (modalEl) {
            const modalInstance = bootstrap.Modal.getOrCreateInstance(modalEl);
            modalInstance.show();
        }
    }

    // Mở Drawer Chi Tiết Ca Trực (từ Lịch Tuần)
    function openShiftDrawerFromCell(cell) {
        document.querySelectorAll('.schedule-shift-cell').forEach(c => c.classList.remove('active-shift-cell'));
        document.querySelectorAll('.monthly-day-cell').forEach(c => c.classList.remove('active-shift-cell'));
        cell.classList.add('active-shift-cell');

        const date = cell.getAttribute('data-date');
        const dateDisplay = cell.getAttribute('data-date-display');
        const shift = cell.getAttribute('data-shift');
        const shiftName = cell.getAttribute('data-shift-name');
        const shiftTime = cell.getAttribute('data-shift-time');
        const isPast = cell.getAttribute('data-is-past') === 'true';
        const reqCount = parseInt(cell.getAttribute('data-req-count') || '0');
        let staffList = [];
        try {
            staffList = JSON.parse(cell.getAttribute('data-staff-json') || '[]');
        } catch (e) {
            console.error('Error parsing staff JSON', e);
            staffList = [];
        }

        // Cập nhật Header Drawer
        document.getElementById('shiftDetailsDrawerTitle').innerHTML = '<i class="bi bi-calendar2-check text-primary me-2"></i>Chi Tiết Ca Trực';
        document.getElementById('shiftDetailsDrawerSubtitle').textContent = `${dateDisplay} · ${shiftName} (${shiftTime})`;

        // Xóa hoàn toàn trạng thái cũ
        const contentEl = document.getElementById('shiftDrawerContent');
        contentEl.innerHTML = '';

        let html = '';

        // Block Thống Kê & Trạng Thái Ca
        html += `
        <div class="card bg-light border-0 p-3 rounded-3 mb-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small">Tổng số trực ca:</span>
                    <div class="fs-5 fw-bold text-dark"><i class="bi bi-people-fill text-primary me-1"></i> ${staffList.length} lễ tân</div>
                </div>
                <div>`;
        if (staffList.length === 0) {
            html += `<span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Chưa phân công</span>`;
        } else if (reqCount > 0 && staffList.length < reqCount) {
            html += `<span class="badge bg-warning text-dark"><i class="bi bi-exclamation-triangle-fill me-1"></i>Thiếu nhân sự (${staffList.length}/${reqCount})</span>`;
        } else if (reqCount > 0 && staffList.length >= reqCount) {
            html += `<span class="badge bg-success"><i class="bi bi-check-circle-fill me-1"></i>Đủ nhân sự (${staffList.length}/${reqCount})</span>`;
        } else {
            html += `<span class="badge bg-primary-subtle text-primary border border-primary-subtle">${staffList.length} người trực</span>`;
        }
        html += `</div>
            </div>`;

        const hasLeave = staffList.some(s => s.isOnLeave);
        if (hasLeave) {
            html += `
            <div class="alert alert-warning py-2 px-3 small mt-3 mb-0">
                <i class="bi bi-exclamation-circle-fill me-1"></i>Có nhân sự trong ca đang có đơn nghỉ phép được duyệt.
            </div>`;
        }
        html += `</div>`;

        // Danh Sách Nhân Sự hoặc Empty State
        if (staffList.length === 0) {
            html += `
            <div class="text-center py-5 px-3 bg-white rounded-3 border border-dashed mb-3">
                <div class="text-muted mb-2"><i class="bi bi-calendar-x fs-1"></i></div>
                <h6 class="fw-bold text-dark mb-1">Chưa có lễ tân được phân công cho ca này.</h6>
                <p class="text-muted small mb-3">Hiện chưa có nhân sự nào được chỉ định trực ${shiftName.toLowerCase()} ngày này.</p>
                ${!isPast ? `
                <button type="button" class="btn btn-primary btn-sm px-3 rounded-pill" onclick="openAssignModal('${date}', '${shift}')">
                    <i class="bi bi-person-plus-fill me-1"></i> Phân công nhân viên
                </button>` : `<span class="badge bg-secondary small">Ca trực đã qua (Chỉ đọc)</span>`}
            </div>`;
        } else {
            html += `<h6 class="fw-bold text-dark mb-2"><i class="bi bi-person-lines-fill text-primary me-1"></i>Danh Sách Lễ Tân Trực Ca (${staffList.length})</h6>`;
            html += `<div class="d-flex flex-column gap-2 mb-3">`;

            staffList.forEach(s => {
                const initial = s.name ? s.name.trim().charAt(s.name.trim().length - 1).toUpperCase() : 'L';
                html += `
                <div class="card border rounded-3 p-3 shadow-xs bg-white">
                    <div class="d-flex justify-content-between align-items-start gap-2">
                        <div class="d-flex align-items-center gap-2">
                            <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 38px; height: 38px; flex-shrink: 0;">
                                ${escapeHtml(initial)}
                            </div>
                            <div>
                                <div class="fw-bold text-dark text-break" style="line-height: 1.35; max-width: 250px;">
                                    ${escapeHtml(s.name)}
                                </div>
                                <div class="text-muted small mt-1">
                                    ${s.code ? `<span class="badge bg-light text-muted border me-1">${escapeHtml(s.code)}</span>` : ''}
                                    <span>Lễ tân (Receptionist)</span>
                                </div>
                            </div>
                        </div>
                        <div>
                            ${s.isOnLeave ? '<span class="badge bg-warning text-dark border border-warning" style="font-size: 0.72rem;">Nghỉ phép</span>' : '<span class="badge bg-success-subtle text-success border border-success-subtle" style="font-size: 0.72rem;">Trực ca</span>'}
                        </div>
                    </div>
                    <hr class="my-2 opacity-25" />
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="small text-muted">
                            <i class="bi bi-clock me-1 text-primary"></i>${escapeHtml(s.startTime)} - ${escapeHtml(s.endTime)}
                        </div>
                        <div>
                            ${isPast ? `
                                <button type="button" class="btn btn-sm btn-outline-secondary" disabled title="Không thể hủy ca trong quá khứ">
                                    <i class="bi bi-lock me-1"></i>Đã qua
                                </button>
                            ` : `
                                <button type="button" class="btn btn-sm btn-outline-danger" onclick="confirmDeleteShift(${s.scheduleId}, '${escapeHtml(s.name)}', '${escapeHtml(dateDisplay)}', '${escapeHtml(shiftName)} (${escapeHtml(shiftTime)})')">
                                    <i class="bi bi-trash3 me-1"></i>Hủy ca
                                </button>
                            `}
                        </div>
                    </div>
                    ${s.notes ? `<div class="mt-2 small text-muted fst-italic bg-light p-2 rounded"><i class="bi bi-chat-left-text me-1"></i>${escapeHtml(s.notes)}</div>` : ''}
                </div>`;
            });
            html += `</div>`;
        }

        // Action Footer
        html += `
        <div class="d-flex gap-2 pt-3 border-top mt-auto">
            ${!isPast ? `
            <button type="button" class="btn btn-primary flex-grow-1 rounded-pill" onclick="openAssignModal('${date}', '${shift}')">
                <i class="bi bi-plus-lg me-1"></i> Thêm người vào ca
            </button>` : ''}
            <button type="button" class="btn btn-outline-secondary rounded-pill px-3" data-bs-dismiss="offcanvas">
                Đóng
            </button>
        </div>`;

        contentEl.innerHTML = html;

        const drawerEl = document.getElementById('shiftDetailsDrawer');
        const drawerInstance = bootstrap.Offcanvas.getOrCreateInstance(drawerEl);
        drawerInstance.show();
    }

    // Mở Drawer Chi Tiết Ngày Làm Việc (từ Lịch Tháng)
    function openDayDrawerFromCell(cell) {
        document.querySelectorAll('.schedule-shift-cell').forEach(c => c.classList.remove('active-shift-cell'));
        document.querySelectorAll('.monthly-day-cell').forEach(c => c.classList.remove('active-shift-cell'));
        cell.classList.add('active-shift-cell');

        const date = cell.getAttribute('data-date');
        const dateDisplay = cell.getAttribute('data-date-display');
        const isPast = cell.getAttribute('data-is-past') === 'true';
        const morningReq = parseInt(cell.getAttribute('data-morning-req') || '0');
        const afternoonReq = parseInt(cell.getAttribute('data-afternoon-req') || '0');

        let morningStaff = [];
        let afternoonStaff = [];
        try {
            morningStaff = JSON.parse(cell.getAttribute('data-morning-staff-json') || '[]');
            afternoonStaff = JSON.parse(cell.getAttribute('data-afternoon-staff-json') || '[]');
        } catch (e) {
            console.error('Error parsing month staff JSON', e);
        }

        document.getElementById('shiftDetailsDrawerTitle').innerHTML = '<i class="bi bi-calendar2-day text-primary me-2"></i>Chi Tiết Ngày Làm Việc';
        document.getElementById('shiftDetailsDrawerSubtitle').textContent = `Ngày: ${dateDisplay}`;

        const contentEl = document.getElementById('shiftDrawerContent');
        contentEl.innerHTML = '';

        let html = '';

        // SECTION 1: CA SÁNG (08:00 - 12:00)
        html += `
        <div class="card border rounded-3 p-3 mb-3 bg-light shadow-xs">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <div>
                    <h6 class="fw-bold text-dark mb-0">
                        <i class="bi bi-sun-fill text-warning me-1"></i>Ca Sáng (08:00 - 12:00)
                    </h6>
                    <span class="small text-muted">${morningStaff.length} người trực</span>
                </div>
                ${!isPast ? `
                <button type="button" class="btn btn-outline-primary btn-sm rounded-pill" onclick="openAssignModal('${date}', 'morning')">
                    <i class="bi bi-plus-lg me-1"></i>Thêm vào ca
                </button>` : ''}
            </div>`;

        if (morningStaff.length === 0) {
            html += `<div class="p-3 text-center bg-white rounded border border-dashed small text-muted">Chưa có lễ tân trực ca sáng.</div>`;
        } else {
            html += `<div class="d-flex flex-column gap-2">`;
            morningStaff.forEach(s => {
                html += `
                <div class="card p-2 bg-white border rounded shadow-xs d-flex flex-row justify-content-between align-items-center">
                    <div>
                        <div class="fw-bold text-dark small text-break">${escapeHtml(s.name)}</div>
                        <div class="text-muted" style="font-size: 0.72rem;">${s.code ? escapeHtml(s.code) + ' · ' : ''}08:00 - 12:00</div>
                    </div>
                    <div>
                        ${isPast ? `
                            <span class="badge bg-secondary">Đã qua</span>
                        ` : `
                            <button type="button" class="btn btn-sm btn-outline-danger p-1 px-2" onclick="confirmDeleteShift(${s.scheduleId}, '${escapeHtml(s.name)}', '${escapeHtml(dateDisplay)}', 'Ca Sáng (08:00 - 12:00)')" title="Hủy ca">
                                <i class="bi bi-trash3"></i>
                            </button>
                        `}
                    </div>
                </div>`;
            });
            html += `</div>`;
        }
        html += `</div>`;

        // SECTION 2: CA CHIỀU (13:30 - 17:30)
        html += `
        <div class="card border rounded-3 p-3 mb-3 bg-light shadow-xs">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <div>
                    <h6 class="fw-bold text-dark mb-0">
                        <i class="bi bi-sunset-fill text-primary me-1"></i>Ca Chiều (13:30 - 17:30)
                    </h6>
                    <span class="small text-muted">${afternoonStaff.length} người trực</span>
                </div>
                ${!isPast ? `
                <button type="button" class="btn btn-outline-primary btn-sm rounded-pill" onclick="openAssignModal('${date}', 'afternoon')">
                    <i class="bi bi-plus-lg me-1"></i>Thêm vào ca
                </button>` : ''}
            </div>`;

        if (afternoonStaff.length === 0) {
            html += `<div class="p-3 text-center bg-white rounded border border-dashed small text-muted">Chưa có lễ tân trực ca chiều.</div>`;
        } else {
            html += `<div class="d-flex flex-column gap-2">`;
            afternoonStaff.forEach(s => {
                html += `
                <div class="card p-2 bg-white border rounded shadow-xs d-flex flex-row justify-content-between align-items-center">
                    <div>
                        <div class="fw-bold text-dark small text-break">${escapeHtml(s.name)}</div>
                        <div class="text-muted" style="font-size: 0.72rem;">${s.code ? escapeHtml(s.code) + ' · ' : ''}13:30 - 17:30</div>
                    </div>
                    <div>
                        ${isPast ? `
                            <span class="badge bg-secondary">Đã qua</span>
                        ` : `
                            <button type="button" class="btn btn-sm btn-outline-danger p-1 px-2" onclick="confirmDeleteShift(${s.scheduleId}, '${escapeHtml(s.name)}', '${escapeHtml(dateDisplay)}', 'Ca Chiều (13:30 - 17:30)')" title="Hủy ca">
                                <i class="bi bi-trash3"></i>
                            </button>
                        `}
                    </div>
                </div>`;
            });
            html += `</div>`;
        }
        html += `</div>`;

        // Footer
        html += `
        <div class="d-flex justify-content-end pt-3 border-top mt-auto">
            <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="offcanvas">
                Đóng
            </button>
        </div>`;

        contentEl.innerHTML = html;

        const drawerEl = document.getElementById('shiftDetailsDrawer');
        const drawerInstance = bootstrap.Offcanvas.getOrCreateInstance(drawerEl);
        drawerInstance.show();
    }

    document.addEventListener('DOMContentLoaded', function () {
        // Double-click prevention on create shift
        const createForm = document.getElementById('createShiftForm');
        if (createForm) {
            createForm.addEventListener('submit', function () {
                const btn = document.getElementById('btnSubmitCreateShift');
                if (btn) {
                    btn.disabled = true;
                    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang lưu...';
                }
            });
        }

        // Double-click prevention on delete shift
        const deleteForm = document.getElementById('deleteShiftForm');
        if (deleteForm) {
            deleteForm.addEventListener('submit', function () {
                const btn = document.getElementById('btnConfirmDeleteShift');
                if (btn) {
                    btn.disabled = true;
                    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang hủy...';
                }
            });
        }

        // Bulk Preview
        const btnPreview = document.getElementById('btnPreviewBulk');
        if (btnPreview) {
            btnPreview.addEventListener('click', async function () {
                const staffChecks = document.querySelectorAll('.bulk-staff-check:checked');
                const dowChecks = document.querySelectorAll('.bulk-dow-check:checked');
                const templateId = document.getElementById('bulkTemplateSelect').value;
                const overwrite = document.getElementById('overwriteCheck').checked;

                const staffIds = Array.from(staffChecks).map(c => parseInt(c.value));
                const dows = Array.from(dowChecks).map(c => parseInt(c.value));

                if (staffIds.length === 0) {
                    alert('Vui lòng chọn ít nhất 1 lễ tân.');
                    return;
                }

                const res = await fetch('@Url.Action("BulkPreview")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        year: @year,
                        month: @month,
                        receptionistUserIds: staffIds,
                        daysOfWeek: dows,
                        shiftTemplateId: parseInt(templateId),
                        overwriteExisting: overwrite
                    })
                });

                const json = await res.json();
                const container = document.getElementById('bulkPreviewResult');
                container.classList.remove('d-none');

                if (json.isSuccess && json.data) {
                    document.getElementById('previewProposedCount').textContent = `Dự kiến tạo: ${json.data.proposedShiftsCount} ca trực. (Ghi đè: ${json.data.overwrittenShiftsCount})`;
                    document.getElementById('previewConflictCount').textContent = `Xung đột đơn nghỉ phép: ${json.data.conflictWithLeaveCount} ca (sẽ được bỏ qua).`;
                    const warnDiv = document.getElementById('previewWarnings');
                    warnDiv.innerHTML = json.data.warnings.map(w => `<div>• ${escapeHtml(w)}</div>`).join('');
                }
            });
        }

        // Leave Impact Preview
        document.querySelectorAll('.btn-preview-impact').forEach(btn => {
            btn.addEventListener('click', async function () {
                const leaveId = this.dataset.leaveId;
                const modal = new bootstrap.Modal(document.getElementById('impactModal'));
                modal.show();

                const res = await fetch('@Url.Action("GetLeaveImpact", "AdminReceptionistSchedule")/' + leaveId);
                const json = await res.json();
                const body = document.getElementById('impactModalBody');

                if (json.isSuccess && json.data) {
                    const data = json.data;
                    let html = `<div class="mb-3">
                        <h6 class="fw-bold ${data.canApprove ? 'text-success' : 'text-danger'}">
                            <i class="bi ${data.canApprove ? 'bi-check-circle-fill' : 'bi-x-circle-fill'} me-1"></i>
                            Đánh giá: ${data.canApprove ? 'ĐỦ ĐIỀU KIỆN PHÊ DUYỆT' : 'KHÔNG ĐỦ ĐIỀU KIỆN PHÊ DUYỆT'}
                        </h6>
                    </div>`;

                    if (data.validationMessages && data.validationMessages.length > 0) {
                        html += `<div class="alert alert-danger py-2 small">
                            ${data.validationMessages.map(m => `<div>• ${escapeHtml(m)}</div>`).join('')}
                        </div>`;
                    }

                    html += `<table class="table table-sm table-bordered">
                        <thead class="table-light">
                            <tr>
                                <th>Ngày</th>
                                <th>Số người đã nghỉ</th>
                                <th>Sau khi duyệt</th>
                                <th>Quy tắc 1 (Max 2)</th>
                                <th>Quy tắc 2 (Min 2/ca)</th>
                            </tr>
                        </thead>
                        <tbody>`;

                    data.dailyImpacts.forEach(di => {
                        const rule1Ok = !di.exceedsMaxLeavesPerDay;
                        const understaffed = di.shiftCoverages.filter(s => s.isUnderstaffed);
                        const rule2Ok = understaffed.length === 0;

                        html += `<tr>
                            <td>${di.date}</td>
                            <td>${di.currentApprovedLeavesCount} người</td>
                            <td>${di.postApprovalLeavesCount} người</td>
                            <td><span class="badge ${rule1Ok ? 'bg-success' : 'bg-danger'}">${rule1Ok ? 'Hợp lệ' : 'Vi phạm (>2)'}</span></td>
                            <td><span class="badge ${rule2Ok ? 'bg-success' : 'bg-danger'}">${rule2Ok ? 'Đủ người' : 'Thiếu người'}</span></td>
                        </tr>`;
                    });

                    html += `</tbody></table>`;
                    body.innerHTML = html;
                } else {
                    body.innerHTML = `<div class="alert alert-danger">Không thể kiểm tra tác động: ${escapeHtml(json.message) || 'Lỗi hệ thống'}</div>`;
                }
            });
        });

        // Reject Leave Modal
        document.querySelectorAll('.btn-reject-modal').forEach(btn => {
            btn.addEventListener('click', function () {
                const leaveId = this.dataset.leaveId;
                document.getElementById('rejectLeaveForm').action = '@Url.Action("RejectLeave", "AdminReceptionistSchedule")/' + leaveId;
            });
        });

        // Resolve Incident Modal
        document.querySelectorAll('.btn-resolve-incident').forEach(btn => {
            btn.addEventListener('click', function () {
                const incidentId = this.dataset.incidentId;
                document.getElementById('resolveIncidentForm').action = '@Url.Action("ResolveIncident", "AdminReceptionistSchedule")/' + incidentId;
            });
        });
    });
</script>
}
