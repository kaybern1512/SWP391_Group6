@model AdminDentistScheduleManageViewModel
@{
    var schedule = Model.MonthlySchedule;
    var currentYear = Model.SelectedYear;
    var currentMonth = Model.SelectedMonth;
    var prevMonth = currentMonth == 1 ? 12 : currentMonth - 1;
    var prevYear = currentMonth == 1 ? currentYear - 1 : currentYear;
    var nextMonth = currentMonth == 12 ? 1 : currentMonth + 1;
    var nextYear = currentMonth == 12 ? currentYear + 1 : currentYear;
    var today = DateOnly.FromDateTime(DateTime.Today);
}

<!-- Filters Bar -->
<div class="card-dc mb-4">
    <div class="card-dc-body p-3">
        <form asp-controller="AdminDentistSchedule" asp-action="Index" method="get" class="row g-2 align-items-end">
            <input type="hidden" name="tab" value="monthly" />

            <!-- Month Navigator -->
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted mb-1">Tháng & Năm</label>
                <div class="input-group input-group-sm">
                    <a asp-controller="AdminDentistSchedule" asp-action="Index"
                       asp-route-tab="monthly"
                       asp-route-year="@prevYear"
                       asp-route-month="@prevMonth"
                       asp-route-departmentId="@Model.SelectedDepartmentId"
                       asp-route-dentistUserId="@Model.SelectedDentistId"
                       class="btn btn-outline-secondary" title="Tháng trước">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                    <select name="month" class="form-select form-select-sm text-center fw-bold" onchange="this.form.submit()">
                        @for (int m = 1; m <= 12; m++)
                        {
                            <option value="@m" selected="@(currentMonth == m)">Tháng @m</option>
                        }
                    </select>
                    <select name="year" class="form-select form-select-sm text-center fw-bold" onchange="this.form.submit()">
                        @for (int y = DateTime.Today.Year - 1; y <= DateTime.Today.Year + 2; y++)
                        {
                            <option value="@y" selected="@(currentYear == y)">@y</option>
                        }
                    </select>
                    <a asp-controller="AdminDentistSchedule" asp-action="Index"
                       asp-route-tab="monthly"
                       asp-route-year="@nextYear"
                       asp-route-month="@nextMonth"
                       asp-route-departmentId="@Model.SelectedDepartmentId"
                       asp-route-dentistUserId="@Model.SelectedDentistId"
                       class="btn btn-outline-secondary" title="Tháng sau">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </div>
            </div>

            <!-- Department Filter -->
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted mb-1">Chuyên khoa</label>
                <select name="departmentId" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">-- Tất cả chuyên khoa --</option>
                    @foreach (var d in Model.Departments)
                    {
                        <option value="@d.DepartmentId" selected="@(Model.SelectedDepartmentId == d.DepartmentId)">@d.Name</option>
                    }
                </select>
            </div>

            <!-- Dentist Filter -->
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted mb-1">Bác sĩ nha khoa</label>
                <select name="dentistUserId" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">-- Tất cả bác sĩ --</option>
                    @foreach (var d in Model.Dentists)
                    {
                        <option value="@d.UserId" selected="@(Model.SelectedDentistId == d.UserId)">@d.FullName @(!string.IsNullOrEmpty(d.Code) ? $"({d.Code})" : "")</option>
                    }
                </select>
            </div>

            <!-- Action Buttons -->
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-dc-primary flex-grow-1">
                    <i class="bi bi-funnel me-1"></i>Lọc
                </button>
                <a asp-controller="AdminDentistSchedule" asp-action="Index" asp-route-tab="monthly" class="btn btn-sm btn-outline-secondary" title="Đặt lại về mặc định">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- KPI Summary Cards -->
@if (schedule != null)
{
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card-dc border-start border-4 border-primary">
                <div class="card-dc-body p-3">
                    <div class="d-flex align-items-center justify-content-between mb-1">
                        <span class="text-muted small fw-semibold">Tổng ngày trực</span>
                        <span class="badge bg-primary-subtle text-primary rounded-pill"><i class="bi bi-calendar-check"></i></span>
                    </div>
                    <div class="fs-4 fw-bold text-dark">@schedule.TotalWorkingDays <span class="fs-6 fw-normal text-muted">ngày</span></div>
                    <div class="text-xs text-muted">Trong tháng @schedule.Month/@schedule.Year</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card-dc border-start border-4 border-info">
                <div class="card-dc-body p-3">
                    <div class="d-flex align-items-center justify-content-between mb-1">
                        <span class="text-muted small fw-semibold">Tổng giờ làm việc</span>
                        <span class="badge bg-info-subtle text-info rounded-pill"><i class="bi bi-clock-history"></i></span>
                    </div>
                    <div class="fs-4 fw-bold text-dark">@schedule.TotalWorkingHours <span class="fs-6 fw-normal text-muted">giờ</span></div>
                    <div class="text-xs text-muted">Ca trực phân công hợp lệ</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card-dc border-start border-4 border-warning">
                <div class="card-dc-body p-3">
                    <div class="d-flex align-items-center justify-content-between mb-1">
                        <span class="text-muted small fw-semibold">Nghỉ phép / Vắng</span>
                        <span class="badge bg-warning-subtle text-warning rounded-pill"><i class="bi bi-person-x"></i></span>
                    </div>
                    <div class="fs-4 fw-bold text-dark">@schedule.TotalOffDays <span class="fs-6 fw-normal text-muted">ngày</span></div>
                    <div class="text-xs text-muted">Đã ghi nhận vắng mặt</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card-dc border-start border-4 border-success">
                <div class="card-dc-body p-3">
                    <div class="d-flex align-items-center justify-content-between mb-1">
                        <span class="text-muted small fw-semibold">Lịch hẹn đã chốt</span>
                        <span class="badge bg-success-subtle text-success rounded-pill"><i class="bi bi-calendar2-heart"></i></span>
                    </div>
                    <div class="fs-4 fw-bold text-dark">@schedule.TotalConfirmedAppointments <span class="fs-6 fw-normal text-muted">lịch hẹn</span></div>
                    <div class="text-xs text-muted">Bệnh nhân đã đặt khám</div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Monthly Calendar Grid -->
<div class="card-dc mb-4 shadow-sm">
    <div class="card-dc-header py-3 d-flex justify-content-between align-items-center bg-white border-bottom">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-calendar3 text-primary fs-5"></i>
            <span class="fw-bold fs-6">Lịch Phân Công Trực Tháng @currentMonth/@currentYear</span>
            @if (Model.SelectedDentistId.HasValue && schedule?.DentistName != null)
            {
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle ms-2">
                    <i class="bi bi-person-fill me-1"></i>@schedule.DentistName
                </span>
            }
            @if (Model.SelectedDepartmentId.HasValue && schedule?.DepartmentName != null)
            {
                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle ms-1">
                    <i class="bi bi-building me-1"></i>@schedule.DepartmentName
                </span>
            }
        </div>
        <div class="d-flex gap-2">
            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1"><i class="bi bi-circle-fill me-1" style="font-size: 8px;"></i>Đang mở đặt hẹn</span>
            <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1"><i class="bi bi-circle-fill me-1" style="font-size: 8px;"></i>Nghỉ phép/Bận</span>
        </div>
    </div>
    <div class="card-dc-body p-0">
        <!-- Day Names Header (7 Columns) -->
        <div class="row g-0 text-center fw-semibold text-muted border-bottom py-2 bg-light small">
            <div class="col">Thứ Hai</div>
            <div class="col">Thứ Ba</div>
            <div class="col">Thứ Tư</div>
            <div class="col">Thứ Năm</div>
            <div class="col">Thứ Sáu</div>
            <div class="col text-primary">Thứ Bảy</div>
            <div class="col text-danger">Chủ Nhật</div>
        </div>

        @if (schedule != null && schedule.Days.Count > 0)
        {
            <!-- Grid Days -->
            <div class="row g-0">
                @for (int i = 0; i < schedule.Days.Count; i++)
                {
                    var day = schedule.Days[i];
                    bool isToday = day.Date == today;
                    string dayCardClass = !day.IsCurrentMonth
                        ? "bg-light text-muted opacity-50"
                        : (isToday ? "bg-primary-subtle bg-opacity-25 border-primary border-2" : "bg-white");

                    <div class="col-12 col-md border-bottom border-end p-2 d-flex flex-column @dayCardClass" style="min-height: 140px; min-width: 14.28%;">
                        <!-- Day Header -->
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="fw-bold @(day.IsWeekend ? (day.DayOfWeek == 7 ? "text-danger" : "text-primary") : "text-dark")" style="font-size: 0.95rem;">
                                @day.Date.Day
                            </span>
                            @if (isToday)
                            {
                                <span class="badge bg-primary text-white" style="font-size: 9px;">Hôm nay</span>
                            }
                            @if (day.ConfirmedAppointmentsCount > 0)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle" style="font-size: 9px;" title="@day.ConfirmedAppointmentsCount lịch hẹn đã xác nhận">
                                    <i class="bi bi-person-check-fill me-1"></i>@day.ConfirmedAppointmentsCount
                                </span>
                            }
                        </div>

                        <!-- Leave Status -->
                        @if (day.IsOnLeave)
                        {
                            <div class="badge bg-warning-subtle text-warning border border-warning-subtle text-wrap text-start p-1 mb-1" style="font-size: 10px;">
                                <i class="bi bi-slash-circle me-1"></i>Nghỉ: @(string.IsNullOrWhiteSpace(day.LeaveReason) ? "Nghỉ phép" : day.LeaveReason)
                            </div>
                        }

                        <!-- Shifts List -->
                        <div class="shifts-container flex-grow-1 overflow-auto mb-1" style="max-height: 110px;">
                            @if (day.Shifts.Count > 0)
                            {
                                @foreach (var s in day.Shifts)
                                {
                                    <div class="shift-pill p-1 px-2 rounded mb-1 border d-flex justify-content-between align-items-center @(s.Status == "Scheduled" ? "bg-white border-primary-subtle" : "bg-light text-muted")" style="font-size: 11px;">
                                        <div class="d-flex align-items-center text-truncate">
                                            <i class="bi bi-clock-fill text-primary me-1" style="font-size: 10px;"></i>
                                            <strong>@s.StartTime.ToString("HH:mm")-@s.EndTime.ToString("HH:mm")</strong>
                                        </div>
                                        <span class="badge bg-light text-secondary border ms-1" style="font-size: 9px;">@s.DepartmentName</span>
                                    </div>
                                }
                            }
                            else if (!day.IsOnLeave && day.IsCurrentMonth)
                            {
                                <div class="text-center text-muted py-2" style="font-size: 11px;">
                                    <span class="fst-italic opacity-75">Chưa phân ca</span>
                                </div>
                            }
                        </div>

                        <!-- Action Button -->
                        @if (day.IsCurrentMonth)
                        {
                            <button type="button"
                                    class="btn btn-sm btn-outline-secondary py-0 px-1 w-100 mt-auto text-xs btn-daily-override"
                                    data-date="@day.Date.ToString("yyyy-MM-dd")"
                                    data-on-leave="@(day.IsOnLeave ? "true" : "false")"
                                    data-leave-reason="@(day.LeaveReason ?? "")"
                                    data-appt-count="@day.ConfirmedAppointmentsCount"
                                    data-shifts='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(day.Shifts.Select(sh => new { startTime = sh.StartTime.ToString("HH:mm"), endTime = sh.EndTime.ToString("HH:mm"), note = sh.Note ?? "" })))'
                                    onclick="handleDailyOverrideClick(this)">
                                <i class="bi bi-pencil-square me-1"></i>Sửa ca ngày
                            </button>
                        }
                    </div>

                    @* Break rows every 7 days on desktop *@
                    @if ((i + 1) % 7 == 0 && (i + 1) < schedule.Days.Count)
                    {
                        @:</div><div class="row g-0">
                    }
                }
            </div>
        }
        else
        {
            <div class="p-5 text-center text-muted">
                <i class="bi bi-calendar-x fs-1 text-secondary opacity-50 mb-2"></i>
                <div class="fw-semibold">Không tìm thấy dữ liệu phân công lịch trực cho tháng này.</div>
                <p class="small text-muted mb-3">Hãy chọn bác sĩ / chuyên khoa hoặc bấm nút <strong>Phân công hàng loạt</strong> để tạo ca trực nhanh.</p>
                <button type="button" class="btn btn-dc-primary btn-sm" data-bs-toggle="modal" data-bs-target="#bulkScheduleModal">
                    <i class="bi bi-calendar-plus me-1"></i>Tạo Phân Công Ngay
                </button>
            </div>
        }
    </div>
</div>

<!-- ========================================================================= -->
<!-- MODAL 1: BULK SCHEDULE ASSIGNMENT -->
<!-- ========================================================================= -->
<div class="modal fade" id="bulkScheduleModal" tabindex="-1" aria-labelledby="bulkScheduleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title font-heading" id="bulkScheduleModalLabel">
                    <i class="bi bi-calendar-plus text-primary me-2"></i>Phân Công Lịch Trực Hàng Loạt
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="bulkScheduleForm">
                    <!-- Step 1: Doctor & Department -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Chuyên khoa <span class="text-danger">*</span></label>
                            <select id="bulkDepartmentId" class="form-select" required>
                                <option value="">-- Chọn chuyên khoa --</option>
                                @foreach (var d in Model.Departments)
                                {
                                    <option value="@d.DepartmentId" selected="@(Model.SelectedDepartmentId == d.DepartmentId)">@d.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Bác sĩ áp dụng <span class="text-danger">*</span></label>
                            <select id="bulkDentistIds" class="form-select" multiple size="4" required>
                                @foreach (var d in Model.Dentists)
                                {
                                    <option value="@d.UserId" selected="@(Model.SelectedDentistId == d.UserId)">@d.FullName @(!string.IsNullOrEmpty(d.Code) ? $"({d.Code})" : "")</option>
                                }
                            </select>
                            <div class="form-text text-xs">Giữ phím Ctrl (hoặc Cmd) để chọn nhiều bác sĩ cùng lúc.</div>
                        </div>
                    </div>

                    <!-- Step 2: Date Range -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Từ ngày <span class="text-danger">*</span></label>
                            <input type="date" id="bulkFromDate" class="form-control" value="@(new DateOnly(currentYear, currentMonth, 1).ToString("yyyy-MM-dd"))" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Đến ngày <span class="text-danger">*</span></label>
                            <input type="date" id="bulkToDate" class="form-control" value="@(new DateOnly(currentYear, currentMonth, DateTime.DaysInMonth(currentYear, currentMonth)).ToString("yyyy-MM-dd"))" required />
                        </div>
                    </div>

                    <!-- Step 3: Days of Week Selection -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold small mb-2">Các ngày trong tuần áp dụng <span class="text-danger">*</span></label>
                        <div class="d-flex flex-wrap gap-2">
                            <div class="form-check form-check-inline">
                                <input class="form-check-input bulk-dow" type="checkbox" id="dow1" value="1" checked>
                                <label class="form-check-label" for="dow1">Thứ 2</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input bulk-dow" type="checkbox" id="dow2" value="2" checked>
                                <label class="form-check-label" for="dow2">Thứ 3</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input bulk-dow" type="checkbox" id="dow3" value="3" checked>
                                <label class="form-check-label" for="dow3">Thứ 4</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input bulk-dow" type="checkbox" id="dow4" value="4" checked>
                                <label class="form-check-label" for="dow4">Thứ 5</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input bulk-dow" type="checkbox" id="dow5" value="5" checked>
                                <label class="form-check-label" for="dow5">Thứ 6</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input bulk-dow" type="checkbox" id="dow6" value="6">
                                <label class="form-check-label text-primary" for="dow6">Thứ 7</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input bulk-dow" type="checkbox" id="dow7" value="7">
                                <label class="form-check-label text-danger" for="dow7">Chủ Nhật</label>
                            </div>
                        </div>
                    </div>

                    <!-- Step 4: Shifts Configuration -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label class="form-label fw-semibold small mb-0">Cấu hình ca trực hàng ngày <span class="text-danger">*</span></label>
                            <div class="btn-group btn-group-sm">
                                <button type="button" class="btn btn-outline-secondary" onclick="setBulkPreset('morning')">Ca Sáng (8h-12h)</button>
                                <button type="button" class="btn btn-outline-secondary" onclick="setBulkPreset('afternoon')">Ca Chiều (13h30-17h30)</button>
                                <button type="button" class="btn btn-outline-secondary" onclick="setBulkPreset('fullday')">Cả Ngày</button>
                            </div>
                        </div>
                        <div id="bulkShiftsContainer" class="border rounded p-2 bg-light">
                            <!-- Dynamic shift rows -->
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-primary mt-2" onclick="addBulkShiftRow('08:00', '12:00', 'Ca Sáng')">
                            <i class="bi bi-plus-circle me-1"></i>Thêm ca trực
                        </button>
                    </div>

                    <!-- Step 5: Options -->
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="bulkOverwrite">
                        <label class="form-check-label small" for="bulkOverwrite">
                            Ghi đè ca trực cũ nếu chưa có lịch hẹn của bệnh nhân
                        </label>
                    </div>

                    <!-- Preview Section -->
                    <div id="bulkPreviewSection" class="mt-3 p-3 border rounded bg-white" style="display: none;">
                        <h6 class="fw-bold d-flex align-items-center justify-content-between">
                            <span><i class="bi bi-shield-check text-success me-2"></i>Kết quả kiểm tra trước (Preview)</span>
                            <span id="bulkPreviewBadge" class="badge bg-secondary">0 ca</span>
                        </h6>
                        <div class="row g-2 mb-2 text-center text-xs">
                            <div class="col"><span class="badge bg-success-subtle text-success w-100 py-1" id="statValid">0 Hợp lệ</span></div>
                            <div class="col"><span class="badge bg-warning-subtle text-warning w-100 py-1" id="statDuplicate">0 Đã có sẵn</span></div>
                            <div class="col"><span class="badge bg-danger-subtle text-danger w-100 py-1" id="statConflict">0 Xung đột/Lịch hẹn</span></div>
                            <div class="col"><span class="badge bg-secondary-subtle text-secondary w-100 py-1" id="statLeave">0 Trùng nghỉ phép</span></div>
                        </div>
                        <div class="table-responsive" style="max-height: 180px; overflow-y: auto;">
                            <table class="table table-sm table-bordered text-xs mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Bác sĩ</th>
                                        <th>Ngày</th>
                                        <th>Giờ</th>
                                        <th>Trạng thái</th>
                                        <th>Ghi chú</th>
                                    </tr>
                                </thead>
                                <tbody id="bulkPreviewTableBody">
                                    <!-- Items will be populated here -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-outline-primary" id="btnBulkPreview" onclick="handleBulkPreview()">
                    <i class="bi bi-eye me-1"></i>Kiểm Tra Xung Đột (Preview)
                </button>
                <button type="button" class="btn btn-dc-primary" id="btnBulkApply" onclick="handleBulkApply()" disabled>
                    <i class="bi bi-check2-circle me-1"></i>Áp Dụng Phân Công
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- MODAL 2: COPY SCHEDULE FROM PREVIOUS MONTH -->
<!-- ========================================================================= -->
<div class="modal fade" id="copyMonthModal" tabindex="-1" aria-labelledby="copyMonthModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title font-heading" id="copyMonthModalLabel">
                    <i class="bi bi-copy text-primary me-2"></i>Sao Chép Lịch Trực Từ Tháng Trước
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="copyMonthForm">
                    <div class="row g-3 mb-3">
                        <div class="col-md-6 border-end">
                            <label class="form-label fw-bold text-muted small">THÁNG NGUỒN (SAO CHÉP TỪ)</label>
                            <div class="row g-2">
                                <div class="col-6">
                                    <label class="form-label small">Tháng</label>
                                    <select id="copySourceMonth" class="form-select form-select-sm">
                                        @for (int m = 1; m <= 12; m++)
                                        {
                                            <option value="@m" selected="@(prevMonth == m)">Tháng @m</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-6">
                                    <label class="form-label small">Năm</label>
                                    <select id="copySourceYear" class="form-select form-select-sm">
                                        @for (int y = DateTime.Today.Year - 1; y <= DateTime.Today.Year + 2; y++)
                                        {
                                            <option value="@y" selected="@(prevYear == y)">@y</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-primary small">THÁNG ĐÍCH (ÁP DỤNG ĐẾN)</label>
                            <div class="row g-2">
                                <div class="col-6">
                                    <label class="form-label small">Tháng</label>
                                    <select id="copyTargetMonth" class="form-select form-select-sm" disabled>
                                        <option value="@currentMonth" selected>Tháng @currentMonth</option>
                                    </select>
                                </div>
                                <div class="col-6">
                                    <label class="form-label small">Năm</label>
                                    <select id="copyTargetYear" class="form-select form-select-sm" disabled>
                                        <option value="@currentYear" selected>@currentYear</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Lọc theo chuyên khoa</label>
                            <select id="copyDepartmentId" class="form-select form-select-sm">
                                <option value="">-- Tất cả chuyên khoa --</option>
                                @foreach (var d in Model.Departments)
                                {
                                    <option value="@d.DepartmentId" selected="@(Model.SelectedDepartmentId == d.DepartmentId)">@d.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Lọc theo bác sĩ</label>
                            <select id="copyDentistId" class="form-select form-select-sm">
                                <option value="">-- Tất cả bác sĩ --</option>
                                @foreach (var d in Model.Dentists)
                                {
                                    <option value="@d.UserId" selected="@(Model.SelectedDentistId == d.UserId)">@d.FullName @(!string.IsNullOrEmpty(d.Code) ? $"({d.Code})" : "")</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold mb-1">Phương thức sao chép</label>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="copyMode" id="copyModePattern" value="DayOfWeekPattern" checked>
                            <label class="form-check-label small" for="copyModePattern">
                                <strong>Theo thứ trong tuần (Day of Week pattern):</strong> Phân bổ các ca Thứ 2 tháng trước sang Thứ 2 tháng này, đảm bảo nhịp trực tuần đều đặn (Khuyên dùng).
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="copyMode" id="copyModeExact" value="ExactDayMatch">
                            <label class="form-check-label small" for="copyModeExact">
                                <strong>Trùng ngày chính xác (Exact day):</strong> Ngày 1 sang ngày 1, ngày 15 sang ngày 15 (Bỏ qua ngày thừa nếu tháng khác số ngày).
                            </label>
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="copyExcludeLeaves" checked>
                                <label class="form-check-label small" for="copyExcludeLeaves">
                                    Bỏ qua các ngày bác sĩ đã đăng ký nghỉ phép trong tháng mới
                                </label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="copySkipConflicts" checked>
                                <label class="form-check-label small" for="copySkipConflicts">
                                    Tự động bỏ qua các ca bị trùng lặp hoặc xung đột
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- Preview Section -->
                    <div id="copyPreviewSection" class="p-3 border rounded bg-white" style="display: none;">
                        <h6 class="fw-bold d-flex align-items-center justify-content-between mb-2">
                            <span><i class="bi bi-info-circle text-info me-2"></i>Xem trước kết quả sao chép</span>
                            <span id="copyPreviewBadge" class="badge bg-secondary">0 ca</span>
                        </h6>
                        <div class="alert alert-info py-2 small mb-2" id="copyPreviewSummary">
                            Đang nạp thông tin...
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-outline-primary" id="btnCopyPreview" onclick="handleCopyPreview()">
                    <i class="bi bi-eye me-1"></i>Kiểm Tra (Preview)
                </button>
                <button type="button" class="btn btn-dc-primary" id="btnCopyApply" onclick="handleCopyApply()" disabled>
                    <i class="bi bi-copy me-1"></i>Thực Hiện Sao Chép
                </button>
            </div>
        </div>
    </div>
</div>

