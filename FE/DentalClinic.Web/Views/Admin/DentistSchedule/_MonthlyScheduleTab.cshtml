<!-- ========================================================================= -->
<!-- JAVASCRIPT LOGIC -->
<!-- ========================================================================= -->
<script>
    // Shift row management for Bulk
    function addBulkShiftRow(start = '08:00', end = '12:00', note = '') {
        const container = document.getElementById('bulkShiftsContainer');
        const row = document.createElement('div');
        row.className = 'row g-2 align-items-center mb-2 bulk-shift-row';
        row.innerHTML = `
            <div class="col-4">
                <input type="time" class="form-control form-control-sm shift-start" value="${start}" required />
            </div>
            <div class="col-4">
                <input type="time" class="form-control form-control-sm shift-end" value="${end}" required />
            </div>
            <div class="col-3">
                <input type="text" class="form-control form-control-sm shift-note" value="${note}" placeholder="Ghi chú" />
            </div>
            <div class="col-1 text-center">
                <button type="button" class="btn btn-link text-danger p-0" onclick="this.closest('.bulk-shift-row').remove()">
                    <i class="bi bi-trash"></i>
                </button>
            </div>
        `;
        container.appendChild(row);
    }

    function setBulkPreset(preset) {
        const container = document.getElementById('bulkShiftsContainer');
        container.innerHTML = '';
        if (preset === 'morning') {
            addBulkShiftRow('08:00', '12:00', 'Ca Sáng');
        } else if (preset === 'afternoon') {
            addBulkShiftRow('13:30', '17:30', 'Ca Chiều');
        } else if (preset === 'fullday') {
            addBulkShiftRow('08:00', '12:00', 'Ca Sáng');
            addBulkShiftRow('13:30', '17:30', 'Ca Chiều');
        }
    }

    // Initialize bulk shift rows on load
    document.addEventListener('DOMContentLoaded', function () {
        setBulkPreset('fullday');
    });

    // Bulk Preview AJAX
    async function handleBulkPreview() {
        const deptId = document.getElementById('bulkDepartmentId').value;
        const dentistSelect = document.getElementById('bulkDentistIds');
        const dentistIds = Array.from(dentistSelect.selectedOptions).map(opt => parseInt(opt.value));
        const fromDate = document.getElementById('bulkFromDate').value;
        const toDate = document.getElementById('bulkToDate').value;
        const overwrite = document.getElementById('bulkOverwrite').checked;

        const dowCheckboxes = document.querySelectorAll('.bulk-dow:checked');
        const daysOfWeek = Array.from(dowCheckboxes).map(cb => parseInt(cb.value));

        if (!deptId) { alert('Vui lòng chọn Chuyên khoa.'); return; }
        if (dentistIds.length === 0) { alert('Vui lòng chọn ít nhất một Bác sĩ.'); return; }
        if (!fromDate || !toDate) { alert('Vui lòng nhập khoảng ngày.'); return; }
        if (daysOfWeek.length === 0) { alert('Vui lòng chọn ít nhất một ngày trong tuần.'); return; }

        const shiftRows = document.querySelectorAll('.bulk-shift-row');
        const shifts = [];
        shiftRows.forEach(row => {
            const s = row.querySelector('.shift-start').value;
            const e = row.querySelector('.shift-end').value;
            const n = row.querySelector('.shift-note').value;
            if (s && e) shifts.push({ startTime: s, endTime: e, note: n });
        });

        if (shifts.length === 0) { alert('Vui lòng cấu hình ít nhất một ca trực.'); return; }

        const payload = {
            departmentId: parseInt(deptId),
            dentistUserIds: dentistIds,
            fromDate: fromDate,
            toDate: toDate,
            daysOfWeek: daysOfWeek,
            shifts: shifts,
            overwriteExisting: overwrite
        };

        const btnPreview = document.getElementById('btnBulkPreview');
        btnPreview.disabled = true;
        btnPreview.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang kiểm tra...';

        try {
            const resp = await fetch('/Admin/DentistSchedule/BulkPreview', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const res = await resp.json();

            if (res.isSuccess && res.data) {
                const data = res.data;
                document.getElementById('bulkPreviewSection').style.display = 'block';
                document.getElementById('bulkPreviewBadge').innerText = `${data.totalProposedShifts} ca đề xuất`;
                document.getElementById('statValid').innerText = `${data.validShiftsCount} Hợp lệ`;
                document.getElementById('statDuplicate').innerText = `${data.duplicateShiftsCount} Đã có`;
                document.getElementById('statConflict').innerText = `${data.overlapShiftsCount + data.appointmentConflictCount} Xung đột`;
                document.getElementById('statLeave').innerText = `${data.leaveConflictCount} Trùng nghỉ`;

                const tbody = document.getElementById('bulkPreviewTableBody');
                tbody.innerHTML = '';
                data.items.slice(0, 50).forEach(item => {
                    const tr = document.createElement('tr');
                    const badgeClass = item.status === 'Valid' ? 'bg-success-subtle text-success' : (item.status === 'Duplicate' ? 'bg-warning-subtle text-warning' : 'bg-danger-subtle text-danger');
                    tr.innerHTML = `
                        <td>${item.dentistName}</td>
                        <td>${item.workDate}</td>
                        <td>${item.startTime} - ${item.endTime}</td>
                        <td><span class="badge ${badgeClass}">${item.status}</span></td>
                        <td>${item.message || ''}</td>
                    `;
                    tbody.appendChild(tr);
                });

                document.getElementById('btnBulkApply').disabled = false;
            } else {
                alert(res.message || 'Lỗi khi kiểm tra lịch.');
            }
        } catch (err) {
            console.error(err);
            alert('Lỗi kết nối máy chủ.');
        } finally {
            btnPreview.disabled = false;
            btnPreview.innerHTML = '<i class="bi bi-eye me-1"></i>Kiểm Tra Xung Đột (Preview)';
        }
    }

    // Bulk Apply AJAX
    async function handleBulkApply() {
        const deptId = document.getElementById('bulkDepartmentId').value;
        const dentistSelect = document.getElementById('bulkDentistIds');
        const dentistIds = Array.from(dentistSelect.selectedOptions).map(opt => parseInt(opt.value));
        const fromDate = document.getElementById('bulkFromDate').value;
        const toDate = document.getElementById('bulkToDate').value;
        const overwrite = document.getElementById('bulkOverwrite').checked;

        const dowCheckboxes = document.querySelectorAll('.bulk-dow:checked');
        const daysOfWeek = Array.from(dowCheckboxes).map(cb => parseInt(cb.value));

        const shiftRows = document.querySelectorAll('.bulk-shift-row');
        const shifts = [];
        shiftRows.forEach(row => {
            const s = row.querySelector('.shift-start').value;
            const e = row.querySelector('.shift-end').value;
            const n = row.querySelector('.shift-note').value;
            if (s && e) shifts.push({ startTime: s, endTime: e, note: n });
        });

        const payload = {
            departmentId: parseInt(deptId),
            dentistUserIds: dentistIds,
            fromDate: fromDate,
            toDate: toDate,
            daysOfWeek: daysOfWeek,
            shifts: shifts,
            overwriteExisting: overwrite,
            skipConflicts: true
        };

        const btnApply = document.getElementById('btnBulkApply');
        btnApply.disabled = true;
        btnApply.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang lưu...';

        try {
            const resp = await fetch('/Admin/DentistSchedule/BulkApply', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const res = await resp.json();

            if (res.isSuccess && res.data) {
                alert(`Hoàn thành! Đã tạo ${res.data.createdCount} ca trực mới, bỏ qua ${res.data.skippedCount} ca xung đột.`);
                window.location.reload();
            } else {
                alert(res.message || 'Không thể áp dụng phân công.');
                btnApply.disabled = false;
                btnApply.innerHTML = '<i class="bi bi-check2-circle me-1"></i>Áp Dụng Phân Công';
            }
        } catch (err) {
            console.error(err);
            alert('Lỗi kết nối máy chủ.');
            btnApply.disabled = false;
            btnApply.innerHTML = '<i class="bi bi-check2-circle me-1"></i>Áp Dụng Phân Công';
        }
    }

    // Copy Month AJAX
    async function handleCopyPreview() {
        const sourceMonth = parseInt(document.getElementById('copySourceMonth').value);
        const sourceYear = parseInt(document.getElementById('copySourceYear').value);
        const targetMonth = parseInt(document.getElementById('copyTargetMonth').value);
        const targetYear = parseInt(document.getElementById('copyTargetYear').value);
        const deptId = document.getElementById('copyDepartmentId').value;
        const dentistId = document.getElementById('copyDentistId').value;
        const mode = document.querySelector('input[name="copyMode"]:checked').value;
        const excludeLeaves = document.getElementById('copyExcludeLeaves').checked;
        const skipConflicts = document.getElementById('copySkipConflicts').checked;

        const payload = {
            sourceYear: sourceYear,
            sourceMonth: sourceMonth,
            targetYear: targetYear,
            targetMonth: targetMonth,
            departmentId: deptId ? parseInt(deptId) : null,
            dentistUserId: dentistId ? parseInt(dentistId) : null,
            mode: mode,
            excludeLeaves: excludeLeaves,
            skipConflicts: skipConflicts
        };

        const btnPreview = document.getElementById('btnCopyPreview');
        btnPreview.disabled = true;
        btnPreview.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang nạp...';

        try {
            const resp = await fetch('/Admin/DentistSchedule/CopyMonthPreview', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const res = await resp.json();

            if (res.isSuccess && res.data) {
                const data = res.data;
                document.getElementById('copyPreviewSection').style.display = 'block';
                document.getElementById('copyPreviewBadge').innerText = `${data.proposedShiftsCount} ca đề xuất`;
                document.getElementById('copyPreviewSummary').innerHTML = `
                    Từ tháng <strong>${sourceMonth}/${sourceYear}</strong> tìm thấy <strong>${data.sourceShiftsCount}</strong> ca trực gốc.<br/>
                    Sẽ sao chép sang tháng <strong>${targetMonth}/${targetYear}</strong>: <strong>${data.validCount}</strong> ca hợp lệ, <strong>${data.conflictCount}</strong> ca xung đột/trùng lặp.
                `;
                document.getElementById('btnCopyApply').disabled = false;
            } else {
                alert(res.message || 'Lỗi khi kiểm tra sao chép.');
            }
        } catch (err) {
            console.error(err);
            alert('Lỗi kết nối máy chủ.');
        } finally {
            btnPreview.disabled = false;
            btnPreview.innerHTML = '<i class="bi bi-eye me-1"></i>Kiểm Tra (Preview)';
        }
    }

    async function handleCopyApply() {
        const sourceMonth = parseInt(document.getElementById('copySourceMonth').value);
        const sourceYear = parseInt(document.getElementById('copySourceYear').value);
        const targetMonth = parseInt(document.getElementById('copyTargetMonth').value);
        const targetYear = parseInt(document.getElementById('copyTargetYear').value);
        const deptId = document.getElementById('copyDepartmentId').value;
        const dentistId = document.getElementById('copyDentistId').value;
        const mode = document.querySelector('input[name="copyMode"]:checked').value;
        const excludeLeaves = document.getElementById('copyExcludeLeaves').checked;
        const skipConflicts = document.getElementById('copySkipConflicts').checked;

        const payload = {
            sourceYear: sourceYear,
            sourceMonth: sourceMonth,
            targetYear: targetYear,
            targetMonth: targetMonth,
            departmentId: deptId ? parseInt(deptId) : null,
            dentistUserId: dentistId ? parseInt(dentistId) : null,
            mode: mode,
            excludeLeaves: excludeLeaves,
            skipConflicts: skipConflicts
        };

        const btnApply = document.getElementById('btnCopyApply');
        btnApply.disabled = true;
        btnApply.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang sao chép...';

        try {
            const resp = await fetch('/Admin/DentistSchedule/CopyMonthApply', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const res = await resp.json();

            if (res.isSuccess && res.data) {
                alert(`Hoàn thành! Đã sao chép thành công ${res.data.createdCount} ca trực sang tháng ${targetMonth}/${targetYear}.`);
                window.location.reload();
            } else {
                alert(res.message || 'Không thể sao chép lịch.');
                btnApply.disabled = false;
                btnApply.innerHTML = '<i class="bi bi-copy me-1"></i>Thực Hiện Sao Chép';
            }
        } catch (err) {
            console.error(err);
            alert('Lỗi kết nối máy chủ.');
            btnApply.disabled = false;
            btnApply.innerHTML = '<i class="bi bi-copy me-1"></i>Thực Hiện Sao Chép';
        }
    }

    // Daily Override Modal Logic
    
    function handleDailyOverrideClick(btn) {
        const dateStr = btn.getAttribute('data-date');
        const isOnLeave = btn.getAttribute('data-on-leave') === 'true';
        const leaveReason = btn.getAttribute('data-leave-reason');
        const apptCount = parseInt(btn.getAttribute('data-appt-count') || '0', 10);
        const shiftsJson = btn.getAttribute('data-shifts');
        openDailyOverrideModal(dateStr, isOnLeave, leaveReason, apptCount, shiftsJson);
    }

    function openDailyOverrideModal(dateStr, isOnLeave, leaveReason, apptCount, shiftsJson) {
        document.getElementById('overrideDate').value = dateStr;
        document.getElementById('overrideDateDisplay').value = dateStr;

        const isDayOffCb = document.getElementById('overrideIsDayOff');
        isDayOffCb.checked = isOnLeave;
        document.getElementById('overrideLeaveReason').value = leaveReason || '';
        toggleDayOffSection();

        const guardAlert = document.getElementById('appointmentGuardAlert');
        if (apptCount > 0) {
            guardAlert.style.display = 'block';
            document.getElementById('guardApptCount').innerText = apptCount;
        } else {
            guardAlert.style.display = 'none';
        }

        const container = document.getElementById('overrideShiftsContainer');
        container.innerHTML = '';

        try {
            const shifts = typeof shiftsJson === 'string' ? JSON.parse(shiftsJson) : shiftsJson;
            if (shifts && shifts.length > 0) {
                shifts.forEach(s => addOverrideShiftRow(s.startTime || '08:00', s.endTime || '12:00', s.note || ''));
            } else if (!isOnLeave) {
                addOverrideShiftRow('08:00', '12:00', 'Ca Sáng');
                addOverrideShiftRow('13:30', '17:30', 'Ca Chiều');
            }
        } catch (e) {
            console.error(e);
            addOverrideShiftRow('08:00', '12:00', '');
        }

        const modal = new bootstrap.Modal(document.getElementById('dailyOverrideModal'));
        modal.show();
    }

    function toggleDayOffSection() {
        const isDayOff = document.getElementById('overrideIsDayOff').checked;
        document.getElementById('dayOffReasonGroup').style.display = isDayOff ? 'block' : 'none';
        document.getElementById('shiftsEditorGroup').style.display = isDayOff ? 'none' : 'block';
    }

    function addOverrideShiftRow(start = '08:00', end = '12:00', note = '') {
        const container = document.getElementById('overrideShiftsContainer');
        const row = document.createElement('div');
        row.className = 'row g-2 align-items-center mb-2 override-shift-row';
        row.innerHTML = `
            <div class="col-4">
                <input type="time" class="form-control form-control-sm override-shift-start" value="${start}" required />
            </div>
            <div class="col-4">
                <input type="time" class="form-control form-control-sm override-shift-end" value="${end}" required />
            </div>
            <div class="col-3">
                <input type="text" class="form-control form-control-sm override-shift-note" value="${note}" placeholder="Ghi chú" />
            </div>
            <div class="col-1 text-center">
                <button type="button" class="btn btn-link text-danger p-0" onclick="this.closest('.override-shift-row').remove()">
                    <i class="bi bi-trash"></i>
                </button>
            </div>
        `;
        container.appendChild(row);
    }

    async function handleSaveOverride() {
        const dateStr = document.getElementById('overrideDate').value;
        const dentistId = parseInt(document.getElementById('overrideDentistId').value);
        const deptId = parseInt(document.getElementById('overrideDepartmentId').value);
        const isDayOff = document.getElementById('overrideIsDayOff').checked;
        const leaveReason = document.getElementById('overrideLeaveReason').value;

        if (!dentistId || !deptId || !dateStr) {
            alert('Thông tin không đầy đủ.');
            return;
        }

        const shifts = [];
        if (!isDayOff) {
            const rows = document.querySelectorAll('.override-shift-row');
            rows.forEach(r => {
                const s = r.querySelector('.override-shift-start').value;
                const e = r.querySelector('.override-shift-end').value;
                const n = r.querySelector('.override-shift-note').value;
                if (s && e) shifts.push({ startTime: s, endTime: e, note: n });
            });
        }

        const payload = {
            dentistUserId: dentistId,
            departmentId: deptId,
            workDate: dateStr,
            isDayOff: isDayOff,
            leaveReason: leaveReason,
            shifts: shifts
        };

        const btnSave = document.getElementById('btnSaveOverride');
        btnSave.disabled = true;
        btnSave.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang lưu...';

        try {
            const resp = await fetch('/Admin/DentistSchedule/DailyOverride', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const res = await resp.json();

            if (res.isSuccess) {
                alert('Đã cập nhật ca trực ngày thành công!');
                window.location.reload();
            } else {
                alert(res.message || 'Không thể lưu ca trực.');
                btnSave.disabled = false;
                btnSave.innerHTML = '<i class="bi bi-save me-1"></i>Lưu Thay Đổi Ca Trực';
            }
        } catch (err) {
            console.error(err);
            alert('Lỗi kết nối máy chủ.');
            btnSave.disabled = false;
            btnSave.innerHTML = '<i class="bi bi-save me-1"></i>Lưu Thay Đổi Ca Trực';
        }
    }
</script>
