@model AdminDentistScheduleManageViewModel
@using DentalClinic.Web.Helpers
@{
    var schedule = Model.MonthlySchedule;
    var currentYear = Model.SelectedYear;
    var currentMonth = Model.SelectedMonth;
    var prevMonth = currentMonth == 1 ? 12 : currentMonth - 1;
    var prevYear = currentMonth == 1 ? currentYear - 1 : currentYear;
    var nextMonth = currentMonth == 12 ? 1 : currentMonth + 1;
    var nextYear = currentMonth == 12 ? currentYear + 1 : currentYear;
    var today = ClinicTimeHelper.TodayDateOnly;
}

<!-- Filters Bar -->
<div class="card-dc mb-4">
    <div class="card-dc-body p-3">
        <form asp-controller="AdminDentistSchedule" asp-action="Index" method="get" class="row g-2 align-items-end">
            <input type="hidden" name="tab" value="monthly" />

            <!-- Month Navigator -->
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted mb-1">Tháng & Năm</label>
                <div class="input-group input-group-sm">
                    <a asp-controller="AdminDentistSchedule" asp-action="Index"
                       asp-route-tab="monthly"
                       asp-route-year="@prevYear"
                       asp-route-month="@prevMonth"
                       asp-route-departmentId="@Model.SelectedDepartmentId"
                       asp-route-dentistUserId="@Model.SelectedDentistId"
                       class="btn btn-outline-secondary" title="Tháng trước">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                    <select name="month" class="form-select form-select-sm text-center fw-bold" onchange="this.form.submit()">
                        @for (int m = 1; m <= 12; m++)
                        {
                            <option value="@m" selected="@(currentMonth == m)">Tháng @m</option>
                        }
                    </select>
                    <select name="year" class="form-select form-select-sm text-center fw-bold" onchange="this.form.submit()">
                        @for (int y = DateTime.Today.Year - 1; y <= DateTime.Today.Year + 2; y++)
                        {
                            <option value="@y" selected="@(currentYear == y)">@y</option>
                        }
                    </select>
                    <a asp-controller="AdminDentistSchedule" asp-action="Index"
                       asp-route-tab="monthly"
                       asp-route-year="@nextYear"
                       asp-route-month="@nextMonth"
                       asp-route-departmentId="@Model.SelectedDepartmentId"
                       asp-route-dentistUserId="@Model.SelectedDentistId"
                       class="btn btn-outline-secondary" title="Tháng sau">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </div>
            </div>

            <!-- Department Filter -->
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted mb-1">Chuyên khoa</label>
                <select name="departmentId" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">-- Tất cả chuyên khoa --</option>
                    @foreach (var d in Model.Departments)
                    {
                        <option value="@d.DepartmentId" selected="@(Model.SelectedDepartmentId == d.DepartmentId)">@d.Name</option>
                    }
                </select>
            </div>

            <!-- Dentist Filter -->
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted mb-1">Bác sĩ nha khoa</label>
                <select name="dentistUserId" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">-- Tất cả bác sĩ --</option>
                    @foreach (var d in Model.Dentists)
                    {
                        <option value="@d.UserId" selected="@(Model.SelectedDentistId == d.UserId)">@d.FullName @(!string.IsNullOrEmpty(d.Code) ? $"({d.Code})" : "")</option>
                    }
                </select>
            </div>

            <!-- Action Buttons -->
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-dc-primary flex-grow-1">
                    <i class="bi bi-funnel me-1"></i>Lọc
                </button>
                <a asp-controller="AdminDentistSchedule" asp-action="Index" asp-route-tab="monthly" class="btn btn-sm btn-outline-secondary" title="Đặt lại về mặc định">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- KPI Summary Cards -->
@if (schedule != null)
{
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card-dc border-start border-4 border-primary">
                <div class="card-dc-body p-3">
                    <div class="d-flex align-items-center justify-content-between mb-1">
                        <span class="text-muted small fw-semibold">Tổng ngày trực</span>
                        <span class="badge bg-primary-subtle text-primary rounded-pill"><i class="bi bi-calendar-check"></i></span>
                    </div>
                    <div class="fs-4 fw-bold text-dark">@schedule.TotalWorkingDays <span class="fs-6 fw-normal text-muted">ngày</span></div>
                    <div class="text-xs text-muted">Trong tháng @schedule.Month/@schedule.Year</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card-dc border-start border-4 border-info">
                <div class="card-dc-body p-3">
                    <div class="d-flex align-items-center justify-content-between mb-1">
                        <span class="text-muted small fw-semibold">Tổng giờ làm việc</span>
                        <span class="badge bg-info-subtle text-info rounded-pill"><i class="bi bi-clock-history"></i></span>
                    </div>
                    <div class="fs-4 fw-bold text-dark">@schedule.TotalWorkingHours <span class="fs-6 fw-normal text-muted">giờ</span></div>
                    <div class="text-xs text-muted">Ca trực phân công hợp lệ</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card-dc border-start border-4 border-warning">
                <div class="card-dc-body p-3">
                    <div class="d-flex align-items-center justify-content-between mb-1">
                        <span class="text-muted small fw-semibold">Nghỉ phép / Vắng</span>
                        <span class="badge bg-warning-subtle text-warning rounded-pill"><i class="bi bi-person-x"></i></span>
                    </div>
                    <div class="fs-4 fw-bold text-dark">@schedule.TotalOffDays <span class="fs-6 fw-normal text-muted">ngày</span></div>
                    <div class="text-xs text-muted">Đã ghi nhận vắng mặt</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card-dc border-start border-4 border-success">
                <div class="card-dc-body p-3">
                    <div class="d-flex align-items-center justify-content-between mb-1">
                        <span class="text-muted small fw-semibold">Lịch hẹn đã chốt</span>
                        <span class="badge bg-success-subtle text-success rounded-pill"><i class="bi bi-calendar2-heart"></i></span>
                    </div>
                    <div class="fs-4 fw-bold text-dark">@schedule.TotalConfirmedAppointments <span class="fs-6 fw-normal text-muted">lịch hẹn</span></div>
                    <div class="text-xs text-muted">Bệnh nhân đã đặt khám</div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Monthly Calendar Grid -->
<div class="card-dc mb-4 shadow-sm">
    <div class="card-dc-header py-3 d-flex justify-content-between align-items-center bg-white border-bottom">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-calendar3 text-primary fs-5"></i>
            <span class="fw-bold fs-6">Lịch Phân Công Trực Tháng @currentMonth/@currentYear</span>
            @if (Model.SelectedDentistId.HasValue && schedule?.DentistName != null)
            {
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle ms-2">
                    <i class="bi bi-person-fill me-1"></i>@schedule.DentistName
                </span>
            }
            @if (Model.SelectedDepartmentId.HasValue && schedule?.DepartmentName != null)
            {
                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle ms-1">
                    <i class="bi bi-building me-1"></i>@schedule.DepartmentName
                </span>
            }
        </div>
        <div class="d-flex gap-2">
            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1"><i class="bi bi-circle-fill me-1" style="font-size: 8px;"></i>Đang mở đặt hẹn</span>
            <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1"><i class="bi bi-circle-fill me-1" style="font-size: 8px;"></i>Nghỉ phép/Bận</span>
        </div>
    </div>
    <div class="card-dc-body p-0">
        <!-- Day Names Header (7 Columns) -->
        <div class="row g-0 text-center fw-semibold text-muted border-bottom py-2 bg-light small">
            <div class="col">Thứ Hai</div>
            <div class="col">Thứ Ba</div>
            <div class="col">Thứ Tư</div>
            <div class="col">Thứ Năm</div>
            <div class="col">Thứ Sáu</div>
            <div class="col text-primary">Thứ Bảy</div>
            <div class="col text-danger">Chủ Nhật</div>
        </div>

        @if (schedule != null && schedule.Days.Count > 0)
        {
            <!-- Grid Days -->
            <div class="row g-0">
                @for (int i = 0; i < schedule.Days.Count; i++)
                {
                    var day = schedule.Days[i];
                    bool isToday = day.Date == today;
                    var morningCount = day.Shifts.Count(s => s.StartTime.Hour < 12);
                    var afternoonCount = day.Shifts.Count(s => s.StartTime.Hour >= 12);
                    var leaveCount = day.IsOnLeave ? 1 : 0;
                    var apptCount = day.ConfirmedAppointmentsCount;
                    string dayCardClass = !day.IsCurrentMonth
                        ? "bg-light text-muted opacity-50"
                        : (isToday ? "bg-primary-subtle bg-opacity-25 border-primary border-2" : "bg-white");

                    <div class="col-12 col-md border-bottom border-end p-2 d-flex flex-column @dayCardClass day-calendar-cell"
                         style="min-height: 125px; min-width: 14.28%; cursor: pointer;"
                         data-date="@day.Date.ToString("yyyy-MM-dd")"
                         data-date-display="@day.Date.ToString("dd/MM/yyyy") (@day.DayOfWeekName)"
                         data-morning-count="@morningCount"
                         data-afternoon-count="@afternoonCount"
                         data-leave-count="@leaveCount"
                         data-appt-count="@apptCount"
                         data-on-leave="@(day.IsOnLeave ? "true" : "false")"
                         data-leave-reason="@(day.LeaveReason ?? "")"
                         data-shifts='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(day.Shifts.Select(sh => new { startTime = sh.StartTime.ToString("HH:mm"), endTime = sh.EndTime.ToString("HH:mm"), dentistName = sh.DentistName, deptName = sh.DepartmentName, note = sh.Note ?? "" })))'
                         onclick="openDayDetailFromCell(this)">
                        
                        <!-- Day Header -->
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="fw-bold @(day.IsWeekend ? (day.DayOfWeek == 7 ? "text-danger" : "text-primary") : "text-dark")" style="font-size: 0.95rem;">
                                @day.Date.Day
                            </span>
                            @if (isToday)
                            {
                                <span class="badge bg-primary text-white" style="font-size: 9px;">Hôm nay</span>
                            }
                            @if (apptCount > 0)
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle" style="font-size: 9px;" title="@apptCount lịch hẹn / cảnh báo">
                                    <i class="bi bi-calendar-event me-1"></i>@apptCount
                                </span>
                            }
                        </div>

                        <!-- Shift & Attendance Overview Badges -->
                        <div class="d-flex flex-column gap-1 flex-grow-1 justify-content-center">
                            <div class="d-flex justify-content-between align-items-center px-2 py-1 rounded bg-primary-subtle text-primary border border-primary-subtle" style="font-size: 11px;">
                                <span><i class="bi bi-sun me-1"></i>Sáng:</span>
                                <span class="fw-bold">@morningCount BS</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center px-2 py-1 rounded bg-info-subtle text-info-emphasis border border-info-subtle" style="font-size: 11px;">
                                <span><i class="bi bi-sunset me-1"></i>Chiều:</span>
                                <span class="fw-bold">@afternoonCount BS</span>
                            </div>
                            @if (day.IsOnLeave)
                            {
                                <div class="d-flex justify-content-between align-items-center px-2 py-1 rounded bg-warning-subtle text-warning-emphasis border border-warning-subtle" style="font-size: 11px;">
                                    <span><i class="bi bi-person-x me-1"></i>Nghỉ:</span>
                                    <span class="fw-bold">1 người</span>
                                </div>
                            }
                            @if (apptCount > 0)
                            {
                                <div class="d-flex justify-content-between align-items-center px-2 py-1 rounded bg-danger-subtle text-danger border border-danger-subtle" style="font-size: 11px;">
                                    <span><i class="bi bi-exclamation-triangle me-1"></i>Cảnh báo:</span>
                                    <span class="fw-bold">@apptCount ca</span>
                                </div>
                            }
                        </div>
                    </div>

                    @* Break rows every 7 days on desktop *@
                    @if ((i + 1) % 7 == 0 && (i + 1) < schedule.Days.Count)
                    {
                        @:</div><div class="row g-0">
                    }
                }
            </div>
        }
        else
        {
            <div class="p-5 text-center text-muted">
                <i class="bi bi-calendar-x fs-1 text-secondary opacity-50 mb-2"></i>
                <div class="fw-semibold">Không tìm thấy dữ liệu phân công lịch trực cho tháng này.</div>
                <p class="small text-muted mb-3">Hãy chọn bác sĩ / chuyên khoa hoặc bấm nút <strong>Phân công hàng loạt</strong> để tạo ca trực nhanh.</p>
                <button type="button" class="btn btn-dc-primary btn-sm" data-bs-toggle="modal" data-bs-target="#bulkScheduleModal">
                    <i class="bi bi-calendar-plus me-1"></i>Tạo Phân Công Ngay
                </button>
            </div>
        }
    </div>
</div>

<!-- ========================================================================= -->
<!-- MODAL: CHI TIẾT NGÀY PHÂN CÔNG LỊCH TRỰC (THAY THẾ NÚT SỬA LẶP LẠI)        -->
<!-- ========================================================================= -->
<div class="modal fade" id="monthDayDetailModal" tabindex="-1" aria-labelledby="monthDayDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg border-0">
            <div class="modal-header bg-light">
                <h5 class="modal-title font-heading fw-bold" id="monthDayDetailModalLabel">
                    <i class="bi bi-calendar-day text-primary me-2"></i>Chi Tiết Ngày: <span id="mddDateDisplay" class="text-primary"></span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <!-- Overview Statistics -->
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <div class="p-2 rounded bg-primary-subtle text-primary border border-primary-subtle text-center">
                            <div class="small fw-semibold">Ca Sáng (08:00 - 12:00)</div>
                            <div class="fs-5 fw-bold" id="mddMorningCount">0 BS</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-2 rounded bg-info-subtle text-info-emphasis border border-info-subtle text-center">
                            <div class="small fw-semibold">Ca Chiều (13:30 - 17:30)</div>
                            <div class="fs-5 fw-bold" id="mddAfternoonCount">0 BS</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-2 rounded bg-warning-subtle text-warning-emphasis border border-warning-subtle text-center">
                            <div class="small fw-semibold">Bác Sĩ Nghỉ Phép</div>
                            <div class="fs-5 fw-bold" id="mddLeaveCount">0 người</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-2 rounded bg-danger-subtle text-danger border border-danger-subtle text-center">
                            <div class="small fw-semibold">Lịch Hẹn / Cảnh Báo</div>
                            <div class="fs-5 fw-bold" id="mddApptCount">0 ca</div>
                        </div>
                    </div>
                </div>

                <!-- Leave reason banner if any -->
                <div id="mddLeaveAlert" class="alert alert-warning py-2 small mb-3" style="display: none;">
                    <i class="bi bi-info-circle me-1 fw-bold"></i>
                    <strong>Ghi chú vắng mặt:</strong> <span id="mddLeaveReason"></span>
                </div>

                <!-- Shifts Detail List -->
                <div class="mb-3">
                    <h6 class="fw-bold small text-muted text-uppercase mb-2">Danh sách ca trực phân công</h6>
                    <div id="mddShiftsList" class="d-flex flex-column gap-2" style="max-height: 220px; overflow-y: auto;">
                        <!-- Populated by JS -->
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-dc-primary" id="btnOpenOverrideFromDetail" onclick="handleOpenOverrideFromDetail()">
                    <i class="bi bi-pencil-square me-1"></i>Điều Chỉnh Ca Trực / Nghỉ Phép
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- MODAL 2: COPY SCHEDULE FROM PREVIOUS MONTH -->
<!-- ========================================================================= -->
<div class="modal fade" id="copyMonthModal" tabindex="-1" aria-labelledby="copyMonthModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title font-heading" id="copyMonthModalLabel">
                    <i class="bi bi-copy text-primary me-2"></i>Sao Chép Lịch Trực Từ Tháng Trước
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="copyMonthForm">
                    <div class="row g-3 mb-3">
                        <div class="col-md-6 border-end">
                            <label class="form-label fw-bold text-muted small">THÁNG NGUỒN (SAO CHÉP TỪ)</label>
                            <div class="row g-2">
                                <div class="col-6">
                                    <label class="form-label small">Tháng</label>
                                    <select id="copySourceMonth" class="form-select form-select-sm">
                                        @for (int m = 1; m <= 12; m++)
                                        {
                                            <option value="@m" selected="@(prevMonth == m)">Tháng @m</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-6">
                                    <label class="form-label small">Năm</label>
                                    <select id="copySourceYear" class="form-select form-select-sm">
                                        @for (int y = DateTime.Today.Year - 1; y <= DateTime.Today.Year + 2; y++)
                                        {
                                            <option value="@y" selected="@(prevYear == y)">@y</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-primary small">THÁNG ĐÍCH (ÁP DỤNG ĐẾN)</label>
                            <div class="row g-2">
                                <div class="col-6">
                                    <label class="form-label small">Tháng</label>
                                    <select id="copyTargetMonth" class="form-select form-select-sm" disabled>
                                        <option value="@currentMonth" selected>Tháng @currentMonth</option>
                                    </select>
                                </div>
                                <div class="col-6">
                                    <label class="form-label small">Năm</label>
                                    <select id="copyTargetYear" class="form-select form-select-sm" disabled>
                                        <option value="@currentYear" selected>@currentYear</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Lọc theo chuyên khoa</label>
                            <select id="copyDepartmentId" class="form-select form-select-sm">
                                <option value="">-- Tất cả chuyên khoa --</option>
                                @foreach (var d in Model.Departments)
                                {
                                    <option value="@d.DepartmentId" selected="@(Model.SelectedDepartmentId == d.DepartmentId)">@d.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Lọc theo bác sĩ</label>
                            <select id="copyDentistId" class="form-select form-select-sm">
                                <option value="">-- Tất cả bác sĩ --</option>
                                @foreach (var d in Model.Dentists)
                                {
                                    <option value="@d.UserId" selected="@(Model.SelectedDentistId == d.UserId)">@d.FullName @(!string.IsNullOrEmpty(d.Code) ? $"({d.Code})" : "")</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold mb-1">Phương thức sao chép</label>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="copyMode" id="copyModePattern" value="DayOfWeekPattern" checked>
                            <label class="form-check-label small" for="copyModePattern">
                                <strong>Theo thứ trong tuần (Day of Week pattern):</strong> Phân bổ các ca Thứ 2 tháng trước sang Thứ 2 tháng này, đảm bảo nhịp trực tuần đều đặn (Khuyên dùng).
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="copyMode" id="copyModeExact" value="ExactDayMatch">
                            <label class="form-check-label small" for="copyModeExact">
                                <strong>Trùng ngày chính xác (Exact day):</strong> Ngày 1 sang ngày 1, ngày 15 sang ngày 15 (Bỏ qua ngày thừa nếu tháng khác số ngày).
                            </label>
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="copyExcludeLeaves" checked>
                                <label class="form-check-label small" for="copyExcludeLeaves">
                                    Bỏ qua các ngày bác sĩ đã đăng ký nghỉ phép trong tháng mới
                                </label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="copySkipConflicts" checked>
                                <label class="form-check-label small" for="copySkipConflicts">
                                    Tự động bỏ qua các ca bị trùng lặp hoặc xung đột
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- Preview Section -->
                    <div id="copyPreviewSection" class="p-3 border rounded bg-white" style="display: none;">
                        <h6 class="fw-bold d-flex align-items-center justify-content-between mb-2">
                            <span><i class="bi bi-info-circle text-info me-2"></i>Xem trước kết quả sao chép</span>
                            <span id="copyPreviewBadge" class="badge bg-secondary">0 ca</span>
                        </h6>
                        <div class="alert alert-info py-2 small mb-2" id="copyPreviewSummary">
                            Đang nạp thông tin...
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-outline-primary" id="btnCopyPreview" onclick="handleCopyPreview()">
                    <i class="bi bi-eye me-1"></i>Kiểm Tra (Preview)
                </button>
                <button type="button" class="btn btn-dc-primary" id="btnCopyApply" onclick="handleCopyApply()" disabled>
                    <i class="bi bi-copy me-1"></i>Thực Hiện Sao Chép
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<script>
// Copy Month AJAX
    async function handleCopyPreview() {
        const sourceMonth = parseInt(document.getElementById('copySourceMonth').value);
        const sourceYear = parseInt(document.getElementById('copySourceYear').value);
        const targetMonth = parseInt(document.getElementById('copyTargetMonth').value);
        const targetYear = parseInt(document.getElementById('copyTargetYear').value);
        const deptId = document.getElementById('copyDepartmentId').value;
        const dentistId = document.getElementById('copyDentistId').value;
        const mode = document.querySelector('input[name="copyMode"]:checked').value;
        const excludeLeaves = document.getElementById('copyExcludeLeaves').checked;
        const skipConflicts = document.getElementById('copySkipConflicts').checked;

        const payload = {
            sourceYear: sourceYear,
            sourceMonth: sourceMonth,
            targetYear: targetYear,
            targetMonth: targetMonth,
            departmentId: deptId ? parseInt(deptId) : null,
            dentistUserId: dentistId ? parseInt(dentistId) : null,
            mode: mode,
            excludeLeaves: excludeLeaves,
            skipConflicts: skipConflicts
        };

        const btnPreview = document.getElementById('btnCopyPreview');
        btnPreview.disabled = true;
        btnPreview.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang nạp...';

        try {
            const resp = await fetch('/Admin/DentistSchedule/CopyMonthPreview', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const res = await resp.json();

            if (res.isSuccess && res.data) {
                const data = res.data;
                document.getElementById('copyPreviewSection').style.display = 'block';
                document.getElementById('copyPreviewBadge').innerText = `${data.proposedShiftsCount} ca đề xuất`;
                document.getElementById('copyPreviewSummary').innerHTML = `
                    Từ tháng <strong>${sourceMonth}/${sourceYear}</strong> tìm thấy <strong>${data.sourceShiftsCount}</strong> ca trực gốc.<br/>
                    Sẽ sao chép sang tháng <strong>${targetMonth}/${targetYear}</strong>: <strong>${data.validCount}</strong> ca hợp lệ, <strong>${data.conflictCount}</strong> ca xung đột/trùng lặp.
                `;
                document.getElementById('btnCopyApply').disabled = false;
            } else {
                alert(res.message || 'Lỗi khi kiểm tra sao chép.');
            }
        } catch (err) {
            console.error(err);
            alert('Lỗi kết nối máy chủ.');
        } finally {
            btnPreview.disabled = false;
            btnPreview.innerHTML = '<i class="bi bi-eye me-1"></i>Kiểm Tra (Preview)';
        }
    }

    async function handleCopyApply() {
        const sourceMonth = parseInt(document.getElementById('copySourceMonth').value);
        const sourceYear = parseInt(document.getElementById('copySourceYear').value);
        const targetMonth = parseInt(document.getElementById('copyTargetMonth').value);
        const targetYear = parseInt(document.getElementById('copyTargetYear').value);
        const deptId = document.getElementById('copyDepartmentId').value;
        const dentistId = document.getElementById('copyDentistId').value;
        const mode = document.querySelector('input[name="copyMode"]:checked').value;
        const excludeLeaves = document.getElementById('copyExcludeLeaves').checked;
        const skipConflicts = document.getElementById('copySkipConflicts').checked;

        const payload = {
            sourceYear: sourceYear,
            sourceMonth: sourceMonth,
            targetYear: targetYear,
            targetMonth: targetMonth,
            departmentId: deptId ? parseInt(deptId) : null,
            dentistUserId: dentistId ? parseInt(dentistId) : null,
            mode: mode,
            excludeLeaves: excludeLeaves,
            skipConflicts: skipConflicts
        };

        const btnApply = document.getElementById('btnCopyApply');
        btnApply.disabled = true;
        btnApply.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang sao chép...';

        try {
            const resp = await fetch('/Admin/DentistSchedule/CopyMonthApply', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const res = await resp.json();

            if (res.isSuccess && res.data) {
                alert(`Hoàn thành! Đã sao chép thành công ${res.data.createdCount} ca trực sang tháng ${targetMonth}/${targetYear}.`);
                window.location.reload();
            } else {
                alert(res.message || 'Không thể sao chép lịch.');
                btnApply.disabled = false;
                btnApply.innerHTML = '<i class="bi bi-copy me-1"></i>Thực Hiện Sao Chép';
            }
        } catch (err) {
            console.error(err);
            alert('Lỗi kết nối máy chủ.');
            btnApply.disabled = false;
            btnApply.innerHTML = '<i class="bi bi-copy me-1"></i>Thực Hiện Sao Chép';
        }
    }

    let currentDetailCellData = null;

    function openDayDetailFromCell(cell) {
        try {
            currentDetailCellData = {
                date: cell.getAttribute('data-date'),
                dateDisplay: cell.getAttribute('data-date-display'),
                morningCount: cell.getAttribute('data-morning-count'),
                afternoonCount: cell.getAttribute('data-afternoon-count'),
                leaveCount: cell.getAttribute('data-leave-count'),
                apptCount: cell.getAttribute('data-appt-count'),
                onLeave: cell.getAttribute('data-on-leave') === 'true',
                leaveReason: cell.getAttribute('data-leave-reason') || '',
                shifts: JSON.parse(cell.getAttribute('data-shifts') || '[]')
            };

            document.getElementById('mddDateDisplay').textContent = currentDetailCellData.dateDisplay || currentDetailCellData.date;
            document.getElementById('mddMorningCount').textContent = (currentDetailCellData.morningCount || 0) + ' BS';
            document.getElementById('mddAfternoonCount').textContent = (currentDetailCellData.afternoonCount || 0) + ' BS';
            document.getElementById('mddLeaveCount').textContent = (currentDetailCellData.leaveCount || 0) + ' người';
            document.getElementById('mddApptCount').textContent = (currentDetailCellData.apptCount || 0) + ' ca';

            const leaveAlert = document.getElementById('mddLeaveAlert');
            if (currentDetailCellData.onLeave) {
                leaveAlert.style.display = 'block';
                document.getElementById('mddLeaveReason').textContent = currentDetailCellData.leaveReason || 'Nghỉ phép';
            } else {
                leaveAlert.style.display = 'none';
            }

            const shiftsList = document.getElementById('mddShiftsList');
            shiftsList.innerHTML = '';
            if (!currentDetailCellData.shifts || currentDetailCellData.shifts.length === 0) {
                shiftsList.innerHTML = '<div class="text-center text-muted small py-3 border rounded bg-light">Chưa có ca trực nào được phân công trong ngày này.</div>';
            } else {
                currentDetailCellData.shifts.forEach(s => {
                    const shiftDiv = document.createElement('div');
                    shiftDiv.className = 'p-2 rounded border bg-white d-flex justify-content-between align-items-center';
                    shiftDiv.innerHTML = `
                        <div>
                            <div class="fw-bold text-dark small"><i class="bi bi-clock me-1 text-primary"></i>${s.startTime} - ${s.endTime}</div>
                            <div class="text-muted small">${s.dentistName ? s.dentistName : 'Bác sĩ'} ${s.deptName ? '• ' + s.deptName : ''}</div>
                        </div>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle">${s.note || 'Ca trực'}</span>
                    `;
                    shiftsList.appendChild(shiftDiv);
                });
            }

            const detailModal = new bootstrap.Modal(document.getElementById('monthDayDetailModal'));
            detailModal.show();
        } catch (e) {
            console.error('Failed to open day detail modal:', e);
        }
    }

    function handleOpenOverrideFromDetail() {
        if (!currentDetailCellData) return;
        const detailModalEl = document.getElementById('monthDayDetailModal');
        const modalInstance = bootstrap.Modal.getInstance(detailModalEl);
        if (modalInstance) modalInstance.hide();

        if (typeof openDailyOverrideModal === 'function') {
            openDailyOverrideModal(
                currentDetailCellData.date,
                currentDetailCellData.onLeave,
                currentDetailCellData.leaveReason,
                parseInt(currentDetailCellData.apptCount || '0', 10),
                currentDetailCellData.shifts
            );
        }
    }

    </script>
