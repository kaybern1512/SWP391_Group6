@model AdminDentistScheduleManageViewModel
@using DentalClinic.Web.Helpers
@{
    var schedule = Model.MonthlySchedule;
    var currentYear = Model.SelectedYear;
    var currentMonth = Model.SelectedMonth;
    var prevMonth = currentMonth == 1 ? 12 : currentMonth - 1;
    var prevYear = currentMonth == 1 ? currentYear - 1 : currentYear;
    var nextMonth = currentMonth == 12 ? 1 : currentMonth + 1;
    var nextYear = currentMonth == 12 ? currentYear + 1 : currentYear;
    var today = ClinicTimeHelper.TodayDateOnly;
}

<!-- KPI Summary Cards -->
@if (schedule != null)
{
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card-dc border-start border-4 border-primary">
                <div class="card-dc-body p-3">
                    <div class="d-flex align-items-center justify-content-between mb-1">
                        <span class="text-muted small fw-semibold">Tổng ngày trực</span>
                        <span class="badge bg-primary-subtle text-primary rounded-pill"><i class="bi bi-calendar-check"></i></span>
                    </div>
                    <div class="fs-4 fw-bold text-dark">@schedule.TotalWorkingDays <span class="fs-6 fw-normal text-muted">ngày</span></div>
                    <div class="text-xs text-muted">Trong tháng @schedule.Month/@schedule.Year</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card-dc border-start border-4 border-info">
                <div class="card-dc-body p-3">
                    <div class="d-flex align-items-center justify-content-between mb-1">
                        <span class="text-muted small fw-semibold">Tổng giờ làm việc</span>
                        <span class="badge bg-info-subtle text-info rounded-pill"><i class="bi bi-clock-history"></i></span>
                    </div>
                    <div class="fs-4 fw-bold text-dark">@schedule.TotalWorkingHours <span class="fs-6 fw-normal text-muted">giờ</span></div>
                    <div class="text-xs text-muted">Ca trực phân công hợp lệ</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card-dc border-start border-4 border-warning">
                <div class="card-dc-body p-3">
                    <div class="d-flex align-items-center justify-content-between mb-1">
                        <span class="text-muted small fw-semibold">Nghỉ phép / Vắng</span>
                        <span class="badge bg-warning-subtle text-warning rounded-pill"><i class="bi bi-person-x"></i></span>
                    </div>
                    <div class="fs-4 fw-bold text-dark">@schedule.TotalOffDays <span class="fs-6 fw-normal text-muted">ngày</span></div>
                    <div class="text-xs text-muted">Đã ghi nhận vắng mặt</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card-dc border-start border-4 border-success">
                <div class="card-dc-body p-3">
                    <div class="d-flex align-items-center justify-content-between mb-1">
                        <span class="text-muted small fw-semibold">Lịch hẹn đã chốt</span>
                        <span class="badge bg-success-subtle text-success rounded-pill"><i class="bi bi-calendar2-heart"></i></span>
                    </div>
                    <div class="fs-4 fw-bold text-dark">@schedule.TotalConfirmedAppointments <span class="fs-6 fw-normal text-muted">lịch hẹn</span></div>
                    <div class="text-xs text-muted">Bệnh nhân đã đặt khám</div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Monthly Calendar Grid -->
<div class="card-dc mb-4 shadow-sm">
    <div class="card-dc-header py-3 d-flex justify-content-between align-items-center bg-white border-bottom">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-calendar3 text-primary fs-5"></i>
            <span class="fw-bold fs-6">Lịch Phân Công Trực Tháng @currentMonth/@currentYear</span>
            @if (Model.SelectedDentistId.HasValue && schedule?.DentistName != null)
            {
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle ms-2">
                    <i class="bi bi-person-fill me-1"></i>@schedule.DentistName
                </span>
            }
            @if (Model.SelectedDepartmentId.HasValue && schedule?.DepartmentName != null)
            {
                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle ms-1">
                    <i class="bi bi-building me-1"></i>@schedule.DepartmentName
                </span>
            }
        </div>
        <div class="d-flex gap-2">
            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1"><i class="bi bi-circle-fill me-1" style="font-size: 8px;"></i>Đang mở đặt hẹn</span>
            <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1"><i class="bi bi-circle-fill me-1" style="font-size: 8px;"></i>Nghỉ phép/Bận</span>
        </div>
    </div>
    <div class="card-dc-body p-0">
        @if (schedule != null && schedule.Days.Count > 0)
        {
            <div class="table-responsive">
                <table class="table table-bordered mb-0" style="table-layout: fixed; min-width: 950px;" id="dentistMonthlyCalendarTable">
                    <thead class="table-light text-center small fw-semibold text-muted">
                        <tr>
                            <th style="width: 14.28%;">Thứ Hai</th>
                            <th style="width: 14.28%;">Thứ Ba</th>
                            <th style="width: 14.28%;">Thứ Tư</th>
                            <th style="width: 14.28%;">Thứ Năm</th>
                            <th style="width: 14.28%;">Thứ Sáu</th>
                            <th style="width: 14.28%;" class="text-primary">Thứ Bảy</th>
                            <th style="width: 14.28%;" class="text-danger">Chủ Nhật</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int firstDayDow = (int)schedule.Days.First().Date.DayOfWeek;
                            int offset = firstDayDow == 0 ? 6 : firstDayDow - 1; // 0=Mon, 6=Sun
                            int totalCells = offset + schedule.Days.Count;
                            int rows = (int)Math.Ceiling((double)totalCells / 7);

                            int dayIndex = 0;
                            for (int r = 0; r < rows; r++)
                            {
                                <tr>
                                    @for (int c = 0; c < 7; c++)
                                    {
                                        int cellIndex = r * 7 + c;
                                        if (cellIndex < offset || dayIndex >= schedule.Days.Count)
                                        {
                                            <td class="bg-light text-muted p-2 align-top" style="height: 125px; width: 14.28%;"></td>
                                        }
                                        else
                                        {
                                            var day = schedule.Days[dayIndex++];
                                            bool isToday = day.Date == today;
                                            var morningCount = day.Shifts.Count(s => s.StartTime.Hour < 12);
                                            var afternoonCount = day.Shifts.Count(s => s.StartTime.Hour >= 12);
                                            var leaveCount = day.Leaves.Count;
                                            var apptCount = day.Appointments.Count;
                                            var conflictCount = day.Conflicts.Count;
                                            string dayCardClass = !day.IsCurrentMonth
                                                ? "bg-light text-muted opacity-50"
                                                : (isToday ? "bg-primary-subtle bg-opacity-25 border-primary border-2" : "bg-white");

                                            <td class="p-2 align-top @dayCardClass day-calendar-cell"
                                                style="height: 125px; width: 14.28%; cursor: pointer;"
                                                data-date="@day.Date.ToString("yyyy-MM-dd")"
                                                data-date-display="@day.Date.ToString("dd/MM/yyyy") (@day.DayOfWeekName)"
                                                data-morning-count="@morningCount"
                                                data-afternoon-count="@afternoonCount"
                                                data-leave-count="@leaveCount"
                                                data-appt-count="@apptCount"
                                                data-conflict-count="@conflictCount"
                                                data-on-leave="@(day.IsOnLeave ? "true" : "false")"
                                                data-leave-reason="@(day.LeaveReason ?? "")"
                                                data-shifts='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(day.Shifts.Select(sh => new { startTime = sh.StartTime.ToString("HH:mm"), endTime = sh.EndTime.ToString("HH:mm"), dentistUserId = sh.DentistUserId, dentistName = sh.DentistName, deptName = sh.DepartmentName, status = sh.Status ?? "Scheduled", note = sh.Note ?? "" })))'
                                                data-leaves='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(day.Leaves.Select(l => new { leaveId = l.LeaveRequestId, dentistId = l.DentistUserId, dentistName = l.DentistName, deptName = l.DepartmentName ?? "", period = l.PeriodDisplay, status = l.Status, reason = l.Reason ?? "" })))'
                                                data-appts='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(day.Appointments.Select(a => new { apptId = a.AppointmentId, code = a.AppointmentCode, dentistName = a.DentistName, serviceName = a.ServiceName, startTime = a.ScheduledStart.ToString("HH:mm"), endTime = a.ScheduledEnd.ToString("HH:mm"), status = a.Status })))'
                                                data-conflicts='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(day.Conflicts.Select(c => new { dentistName = c.DentistName, timeRange = c.TimeRange, reason = c.Reason, severity = c.Severity })))'
                                                onclick="openDayDetailFromCell(this)">
                                                
                                                <!-- Day Header -->
                                                <div class="d-flex justify-content-between align-items-center mb-1">
                                                    <span class="fw-bold @(day.IsWeekend ? (day.DayOfWeek == 7 ? "text-danger" : "text-primary") : "text-dark")" style="font-size: 0.95rem;">
                                                        @day.Date.Day
                                                    </span>
                                                    <div class="d-flex align-items-center gap-1">
                                                        @if (isToday)
                                                        {
                                                            <span class="badge bg-primary text-white" style="font-size: 9px;">Hôm nay</span>
                                                        }
                                                        @if (conflictCount > 0)
                                                        {
                                                            <span class="badge bg-danger text-white" style="font-size: 9px;" title="@conflictCount cảnh báo xung đột">
                                                                <i class="bi bi-exclamation-triangle-fill"></i> @conflictCount
                                                            </span>
                                                        }
                                                        else if (apptCount > 0)
                                                        {
                                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle" style="font-size: 9px;" title="@apptCount lịch hẹn trong ngày">
                                                                <i class="bi bi-calendar-check me-1"></i>@apptCount
                                                            </span>
                                                        }
                                                    </div>
                                                </div>

                                                <!-- Shift & Attendance Overview Badges -->
                                                <div class="d-flex flex-column gap-1 justify-content-center">
                                                    <div class="d-flex justify-content-between align-items-center px-2 py-1 rounded bg-primary-subtle text-primary border border-primary-subtle" style="font-size: 11px;">
                                                        <span><i class="bi bi-sun me-1"></i>Sáng:</span>
                                                        <span class="fw-bold">@morningCount BS</span>
                                                    </div>
                                                    <div class="d-flex justify-content-between align-items-center px-2 py-1 rounded bg-info-subtle text-info-emphasis border border-info-subtle" style="font-size: 11px;">
                                                        <span><i class="bi bi-sunset me-1"></i>Chiều:</span>
                                                        <span class="fw-bold">@afternoonCount BS</span>
                                                    </div>
                                                    @if (leaveCount > 0)
                                                    {
                                                        <div class="d-flex justify-content-between align-items-center px-2 py-1 rounded bg-warning-subtle text-warning-emphasis border border-warning-subtle" style="font-size: 11px;">
                                                            <span><i class="bi bi-person-x me-1"></i>Nghỉ:</span>
                                                            <span class="fw-bold">@leaveCount người</span>
                                                        </div>
                                                    }
                                                    @if (conflictCount > 0)
                                                    {
                                                        <div class="d-flex justify-content-between align-items-center px-2 py-1 rounded bg-danger-subtle text-danger border border-danger-subtle" style="font-size: 11px;">
                                                            <span><i class="bi bi-exclamation-triangle me-1"></i>Cảnh báo:</span>
                                                            <span class="fw-bold">@conflictCount ca</span>
                                                        </div>
                                                    }
                                                </div>
                                            </td>
                                        }
                                    }
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-5 text-center text-muted">
                <i class="bi bi-calendar-x fs-1 text-secondary opacity-50 mb-2"></i>
                <div class="fw-semibold">Không tìm thấy dữ liệu phân công lịch trực cho tháng này.</div>
                <p class="small text-muted mb-3">Hãy chọn bác sĩ / chuyên khoa hoặc bấm nút <strong>Phân công hàng loạt</strong> để tạo ca trực nhanh.</p>
                <button type="button" class="btn btn-dc-primary btn-sm" data-bs-toggle="modal" data-bs-target="#bulkScheduleModal">
                    <i class="bi bi-calendar-plus me-1"></i>Tạo Phân Công Ngay
                </button>
            </div>
        }
    </div>
</div>

<!-- ========================================================================= -->
<!-- MODAL: CHI TIẾT NGÀY PHÂN CÔNG LỊCH TRỰC                                  -->
<!-- ========================================================================= -->
<div class="modal fade" id="monthDayDetailModal" tabindex="-1" aria-labelledby="monthDayDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" style="max-width: 880px;">
        <div class="modal-content shadow-lg border-0">
            <div class="modal-header bg-light py-3 px-4 border-bottom">
                <h5 class="modal-title font-heading fw-bold text-dark d-flex align-items-center" id="monthDayDetailModalLabel">
                    <i class="bi bi-calendar3-event text-primary me-2 fs-5"></i>
                    <span id="mddHeaderTitle">Chi tiết lịch trực</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <!-- Summary: 3 số liệu gọn -->
                <div class="d-flex flex-wrap align-items-center gap-2 mb-3 pb-3 border-bottom">
                    <div class="px-3 py-2 rounded bg-primary-subtle text-primary border border-primary-subtle d-flex align-items-center gap-2">
                        <i class="bi bi-sun-fill text-primary"></i>
                        <span>Ca sáng: <strong id="mddMorningBadge">0 bác sĩ</strong></span>
                    </div>
                    <div class="px-3 py-2 rounded bg-info-subtle text-info-emphasis border border-info-subtle d-flex align-items-center gap-2">
                        <i class="bi bi-sunset-fill text-info-emphasis"></i>
                        <span>Ca chiều: <strong id="mddAfternoonBadge">0 bác sĩ</strong></span>
                    </div>
                    <div id="mddConflictBadgeWrap" class="px-3 py-2 rounded bg-danger-subtle text-danger border border-danger-subtle d-flex align-items-center gap-2" style="display: none;">
                        <i class="bi bi-exclamation-triangle-fill text-danger"></i>
                        <span>Cần kiểm tra: <strong id="mddConflictBadge">0</strong></span>
                    </div>
                </div>

                <!-- BÁC SĨ TRỰC: NHÓM A (CA SÁNG) & NHÓM B (CA CHIỀU) - 2 CỘT -->
                <div class="row g-3 mb-4">
                    <!-- Nhóm A: Ca Sáng (08:00 - 12:00) -->
                    <div class="col-12 col-md-6">
                        <div class="card h-100 border shadow-none bg-light-subtle">
                            <div class="card-header bg-white py-2 px-3 d-flex justify-content-between align-items-center border-bottom">
                                <span class="fw-bold small text-primary text-uppercase">
                                    <i class="bi bi-sun me-1"></i>Ca Sáng (08:00 – 12:00)
                                </span>
                                <span class="badge bg-primary text-white" id="mddMorningHeaderCount">0 BS</span>
                            </div>
                            <div class="card-body p-3" id="mddMorningList">
                                <!-- Populated by JS -->
                            </div>
                        </div>
                    </div>

                    <!-- Nhóm B: Ca Chiều (13:30 - 17:30) -->
                    <div class="col-12 col-md-6">
                        <div class="card h-100 border shadow-none bg-light-subtle">
                            <div class="card-header bg-white py-2 px-3 d-flex justify-content-between align-items-center border-bottom">
                                <span class="fw-bold small text-info-emphasis text-uppercase">
                                    <i class="bi bi-sunset me-1"></i>Ca Chiều (13:30 – 17:30)
                                </span>
                                <span class="badge bg-info text-white" id="mddAfternoonHeaderCount">0 BS</span>
                            </div>
                            <div class="card-body p-3" id="mddAfternoonList">
                                <!-- Populated by JS -->
                            </div>
                        </div>
                    </div>
                </div>

                <!-- NHÓM C: BÁC SĨ NGHỈ PHÉP -->
                <div class="mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="fw-bold small text-secondary text-uppercase mb-0">
                            <i class="bi bi-person-x-fill text-warning me-1"></i>Bác Sĩ Nghỉ Phép
                        </h6>
                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle" id="mddLeaveCountBadge">0</span>
                    </div>
                    <div id="mddLeavesContainer">
                        <!-- Populated by JS -->
                    </div>
                </div>

                <!-- NHÓM D: LỊCH HẸN & CẢNH BÁO (2 CỘT) -->
                <div class="row g-3">
                    <!-- D.1: Lịch Hẹn Trong Ngày -->
                    <div class="col-12 col-md-6">
                        <div class="card h-100 border shadow-none bg-light-subtle">
                            <div class="card-header bg-white py-2 px-3 d-flex justify-content-between align-items-center border-bottom">
                                <span class="fw-bold small text-dark text-uppercase">
                                    <i class="bi bi-calendar-check me-1 text-primary"></i>Lịch Hẹn Trong Ngày
                                </span>
                                <span class="badge bg-secondary" id="mddApptCountBadge">0</span>
                            </div>
                            <div class="card-body p-3" id="mddApptsContainer">
                                <!-- Populated by JS -->
                            </div>
                        </div>
                    </div>

                    <!-- D.2: Cảnh Báo Xung Đột -->
                    <div class="col-12 col-md-6">
                        <div class="card h-100 border shadow-none bg-light-subtle">
                            <div class="card-header bg-white py-2 px-3 d-flex justify-content-between align-items-center border-bottom">
                                <span class="fw-bold small text-dark text-uppercase">
                                    <i class="bi bi-exclamation-triangle-fill me-1 text-danger"></i>Cảnh Báo Xung Đột
                                </span>
                                <span class="badge bg-danger text-white" id="mddConflictCountBadge">0</span>
                            </div>
                            <div class="card-body p-3" id="mddConflictsContainer">
                                <!-- Populated by JS -->
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light py-2 px-4 border-top d-flex justify-content-between">
                <button type="button" class="btn btn-secondary px-3" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-dc-primary px-3" id="btnOpenOverrideFromDetail" onclick="handleOpenOverrideFromDetail()">
                    <i class="bi bi-pencil-square me-1"></i>Điều Chỉnh Ca Trực / Nghỉ Phép
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- MODAL 2: COPY SCHEDULE FROM PREVIOUS MONTH -->
<!-- ========================================================================= -->
<div class="modal fade" id="copyMonthModal" tabindex="-1" aria-labelledby="copyMonthModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title font-heading" id="copyMonthModalLabel">
                    <i class="bi bi-copy text-primary me-2"></i>Sao Chép Lịch Trực Từ Tháng Trước
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="copyMonthForm">
                    <div class="row g-3 mb-3">
                        <div class="col-md-6 border-end">
                            <label class="form-label fw-bold text-muted small">THÁNG NGUỒN (SAO CHÉP TỪ)</label>
                            <div class="row g-2">
                                <div class="col-6">
                                    <label class="form-label small">Tháng</label>
                                    <select id="copySourceMonth" class="form-select form-select-sm">
                                        @for (int m = 1; m <= 12; m++)
                                        {
                                            <option value="@m" selected="@(prevMonth == m)">Tháng @m</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-6">
                                    <label class="form-label small">Năm</label>
                                    <select id="copySourceYear" class="form-select form-select-sm">
                                        @for (int y = DateTime.Today.Year - 1; y <= DateTime.Today.Year + 2; y++)
                                        {
                                            <option value="@y" selected="@(prevYear == y)">@y</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-primary small">THÁNG ĐÍCH (ÁP DỤNG ĐẾN)</label>
                            <div class="row g-2">
                                <div class="col-6">
                                    <label class="form-label small">Tháng</label>
                                    <select id="copyTargetMonth" class="form-select form-select-sm" disabled>
                                        <option value="@currentMonth" selected>Tháng @currentMonth</option>
                                    </select>
                                </div>
                                <div class="col-6">
                                    <label class="form-label small">Năm</label>
                                    <select id="copyTargetYear" class="form-select form-select-sm" disabled>
                                        <option value="@currentYear" selected>@currentYear</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Lọc theo chuyên khoa</label>
                            <select id="copyDepartmentId" class="form-select form-select-sm">
                                <option value="">-- Tất cả chuyên khoa --</option>
                                @foreach (var d in Model.Departments)
                                {
                                    <option value="@d.DepartmentId" selected="@(Model.SelectedDepartmentId == d.DepartmentId)">@d.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Lọc theo bác sĩ</label>
                            <select id="copyDentistId" class="form-select form-select-sm">
                                <option value="">-- Tất cả bác sĩ --</option>
                                @foreach (var d in Model.Dentists)
                                {
                                    <option value="@d.UserId" selected="@(Model.SelectedDentistId == d.UserId)">@d.FullName @(!string.IsNullOrEmpty(d.Code) ? $"({d.Code})" : "")</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold mb-1">Phương thức sao chép</label>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="copyMode" id="copyModePattern" value="DayOfWeekPattern" checked>
                            <label class="form-check-label small" for="copyModePattern">
                                <strong>Theo thứ trong tuần (Day of Week pattern):</strong> Phân bổ các ca Thứ 2 tháng trước sang Thứ 2 tháng này, đảm bảo nhịp trực tuần đều đặn (Khuyên dùng).
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="copyMode" id="copyModeExact" value="ExactDayMatch">
                            <label class="form-check-label small" for="copyModeExact">
                                <strong>Trùng ngày chính xác (Exact day):</strong> Ngày 1 sang ngày 1, ngày 15 sang ngày 15 (Bỏ qua ngày thừa nếu tháng khác số ngày).
                            </label>
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="copyExcludeLeaves" checked>
                                <label class="form-check-label small" for="copyExcludeLeaves">
                                    Bỏ qua các ngày bác sĩ đã đăng ký nghỉ phép trong tháng mới
                                </label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="copySkipConflicts" checked>
                                <label class="form-check-label small" for="copySkipConflicts">
                                    Tự động bỏ qua các ca bị trùng lặp hoặc xung đột
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- Preview Section -->
                    <div id="copyPreviewSection" class="p-3 border rounded bg-white" style="display: none;">
                        <h6 class="fw-bold d-flex align-items-center justify-content-between mb-2">
                            <span><i class="bi bi-info-circle text-info me-2"></i>Xem trước kết quả sao chép</span>
                            <span id="copyPreviewBadge" class="badge bg-secondary">0 ca</span>
                        </h6>
                        <div class="alert alert-info py-2 small mb-2" id="copyPreviewSummary">
                            Đang nạp thông tin...
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-outline-primary" id="btnCopyPreview" onclick="handleCopyPreview()">
                    <i class="bi bi-eye me-1"></i>Kiểm Tra (Preview)
                </button>
                <button type="button" class="btn btn-dc-primary" id="btnCopyApply" onclick="handleCopyApply()" disabled>
                    <i class="bi bi-copy me-1"></i>Thực Hiện Sao Chép
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<script>
// Copy Month AJAX
    async function handleCopyPreview() {
        const sourceMonth = parseInt(document.getElementById('copySourceMonth').value);
        const sourceYear = parseInt(document.getElementById('copySourceYear').value);
        const targetMonth = parseInt(document.getElementById('copyTargetMonth').value);
        const targetYear = parseInt(document.getElementById('copyTargetYear').value);
        const deptId = document.getElementById('copyDepartmentId').value;
        const dentistId = document.getElementById('copyDentistId').value;
        const mode = document.querySelector('input[name="copyMode"]:checked').value;
        const excludeLeaves = document.getElementById('copyExcludeLeaves').checked;
        const skipConflicts = document.getElementById('copySkipConflicts').checked;

        const payload = {
            sourceYear: sourceYear,
            sourceMonth: sourceMonth,
            targetYear: targetYear,
            targetMonth: targetMonth,
            departmentId: deptId ? parseInt(deptId) : null,
            dentistUserId: dentistId ? parseInt(dentistId) : null,
            mode: mode,
            excludeLeaves: excludeLeaves,
            skipConflicts: skipConflicts
        };

        const btnPreview = document.getElementById('btnCopyPreview');
        btnPreview.disabled = true;
        btnPreview.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang nạp...';

        try {
            const resp = await fetch('/Admin/DentistSchedule/CopyMonthPreview', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const res = await resp.json();

            if (res.isSuccess && res.data) {
                const data = res.data;
                document.getElementById('copyPreviewSection').style.display = 'block';
                document.getElementById('copyPreviewBadge').innerText = `${data.proposedShiftsCount} ca đề xuất`;
                document.getElementById('copyPreviewSummary').innerHTML = `
                    Từ tháng <strong>${sourceMonth}/${sourceYear}</strong> tìm thấy <strong>${data.sourceShiftsCount}</strong> ca trực gốc.<br/>
                    Sẽ sao chép sang tháng <strong>${targetMonth}/${targetYear}</strong>: <strong>${data.validCount}</strong> ca hợp lệ, <strong>${data.conflictCount}</strong> ca xung đột/trùng lặp.
                `;
                document.getElementById('btnCopyApply').disabled = false;
            } else {
                alert(res.message || 'Lỗi khi kiểm tra sao chép.');
            }
        } catch (err) {
            console.error(err);
            alert('Lỗi kết nối máy chủ.');
        } finally {
            btnPreview.disabled = false;
            btnPreview.innerHTML = '<i class="bi bi-eye me-1"></i>Kiểm Tra (Preview)';
        }
    }

    async function handleCopyApply() {
        const sourceMonth = parseInt(document.getElementById('copySourceMonth').value);
        const sourceYear = parseInt(document.getElementById('copySourceYear').value);
        const targetMonth = parseInt(document.getElementById('copyTargetMonth').value);
        const targetYear = parseInt(document.getElementById('copyTargetYear').value);
        const deptId = document.getElementById('copyDepartmentId').value;
        const dentistId = document.getElementById('copyDentistId').value;
        const mode = document.querySelector('input[name="copyMode"]:checked').value;
        const excludeLeaves = document.getElementById('copyExcludeLeaves').checked;
        const skipConflicts = document.getElementById('copySkipConflicts').checked;

        const payload = {
            sourceYear: sourceYear,
            sourceMonth: sourceMonth,
            targetYear: targetYear,
            targetMonth: targetMonth,
            departmentId: deptId ? parseInt(deptId) : null,
            dentistUserId: dentistId ? parseInt(dentistId) : null,
            mode: mode,
            excludeLeaves: excludeLeaves,
            skipConflicts: skipConflicts
        };

        const btnApply = document.getElementById('btnCopyApply');
        btnApply.disabled = true;
        btnApply.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang sao chép...';

        try {
            const resp = await fetch('/Admin/DentistSchedule/CopyMonthApply', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const res = await resp.json();

            if (res.isSuccess && res.data) {
                alert(`Hoàn thành! Đã sao chép thành công ${res.data.createdCount} ca trực sang tháng ${targetMonth}/${targetYear}.`);
                window.location.reload();
            } else {
                alert(res.message || 'Không thể sao chép lịch.');
                btnApply.disabled = false;
                btnApply.innerHTML = '<i class="bi bi-copy me-1"></i>Thực Hiện Sao Chép';
            }
        } catch (err) {
            console.error(err);
            alert('Lỗi kết nối máy chủ.');
            btnApply.disabled = false;
            btnApply.innerHTML = '<i class="bi bi-copy me-1"></i>Thực Hiện Sao Chép';
        }
    }

    let currentDetailCellData = null;

    function formatDoctorName(name) {
        if (!name) return 'Bác sĩ';
        let clean = name.trim();
        // Remove technical brackets like [Phân công hàng loạt] from name if present
        clean = clean.replace(/\[.*?\]/g, '').trim();
        if (clean.startsWith('BS.') || clean.startsWith('Bác sĩ')) return clean;
        return `BS. ${clean}`;
    }

    function translateApptStatus(status) {
        switch (status) {
            case 'Confirmed': return 'Đã xác nhận';
            case 'CheckedIn': return 'Đã check-in';
            case 'Waiting': return 'Đang chờ';
            case 'Called': return 'Đã gọi vào';
            case 'InService': return 'Đang thực hiện';
            case 'Completed': return 'Hoàn thành';
            case 'Cancelled': return 'Đã hủy';
            default: return status || 'Lịch hẹn';
        }
    }

    function renderShiftDoctorList(shifts, containerId, standardStart, standardEnd, approvedLeaveDoctorIds) {
        const container = document.getElementById(containerId);
        container.innerHTML = '';
        if (!shifts || shifts.length === 0) {
            container.innerHTML = '<div class="text-center text-muted small py-3 border rounded bg-white">Không có bác sĩ trực ca này.</div>';
            return;
        }

        // Sort by doctor name consistently
        const sortedShifts = [...shifts].sort((a, b) => (a.dentistName || '').localeCompare(b.dentistName || '', 'vi'));
        const isTruncated = sortedShifts.length > 5;

        const listDiv = document.createElement('div');
        listDiv.className = 'd-flex flex-column gap-2';

        sortedShifts.forEach((s, idx) => {
            const item = document.createElement('div');
            item.className = 'p-2 rounded border bg-white d-flex justify-content-between align-items-center shadow-2xs';
            if (idx >= 5) item.classList.add('d-none', 'extra-doctor-item');

            const isStandard = s.startTime === standardStart && s.endTime === standardEnd;
            const timeBadge = !isStandard 
                ? `<span class="badge bg-light text-dark border ms-1"><i class="bi bi-clock me-1"></i>${s.startTime} - ${s.endTime}</span>`
                : '';
            
            const isConflict = approvedLeaveDoctorIds && approvedLeaveDoctorIds.has(s.dentistUserId);
            let statusBadge = '';
            if (isConflict) {
                statusBadge = '<span class="badge bg-danger-subtle text-danger border border-danger-subtle ms-1">Trùng lịch nghỉ phép</span>';
            } else if (s.status === 'Cancelled') {
                statusBadge = '<span class="badge bg-secondary ms-1">Đã hủy</span>';
            }

            item.innerHTML = `
                <div>
                    <div class="fw-bold text-dark small">${formatDoctorName(s.dentistName)} ${timeBadge}</div>
                    <div class="text-muted" style="font-size: 12px;">${s.deptName || 'Khoa Răng Tổng Quát'}</div>
                </div>
                <div>${statusBadge}</div>
            `;
            listDiv.appendChild(item);
        });

        container.appendChild(listDiv);

        if (isTruncated) {
            const btnMore = document.createElement('button');
            btnMore.type = 'button';
            btnMore.className = 'btn btn-link btn-sm text-decoration-none p-0 mt-2 text-primary fw-semibold';
            btnMore.innerHTML = `Xem tất cả (${sortedShifts.length}) <i class="bi bi-chevron-down"></i>`;
            btnMore.onclick = function() {
                const extras = container.querySelectorAll('.extra-doctor-item');
                const isExpanding = extras.length > 0 && extras[0].classList.contains('d-none');
                extras.forEach(el => el.classList.toggle('d-none'));
                this.innerHTML = isExpanding 
                    ? `Thu gọn <i class="bi bi-chevron-up"></i>` 
                    : `Xem tất cả (${sortedShifts.length}) <i class="bi bi-chevron-down"></i>`;
            };
            container.appendChild(btnMore);
        }
    }

    function openDayDetailFromCell(cell) {
        try {
            currentDetailCellData = {
                date: cell.getAttribute('data-date'),
                dateDisplay: cell.getAttribute('data-date-display'),
                morningCount: parseInt(cell.getAttribute('data-morning-count') || '0', 10),
                afternoonCount: parseInt(cell.getAttribute('data-afternoon-count') || '0', 10),
                leaveCount: parseInt(cell.getAttribute('data-leave-count') || '0', 10),
                apptCount: parseInt(cell.getAttribute('data-appt-count') || '0', 10),
                conflictCount: parseInt(cell.getAttribute('data-conflict-count') || '0', 10),
                onLeave: cell.getAttribute('data-on-leave') === 'true',
                leaveReason: cell.getAttribute('data-leave-reason') || '',
                shifts: JSON.parse(cell.getAttribute('data-shifts') || '[]'),
                leaves: JSON.parse(cell.getAttribute('data-leaves') || '[]'),
                appts: JSON.parse(cell.getAttribute('data-appts') || '[]'),
                conflicts: JSON.parse(cell.getAttribute('data-conflicts') || '[]')
            };

            // 1. Dynamic Header: "Chi tiết lịch trực — Thứ X, dd/MM/yyyy"
            const dParts = currentDetailCellData.date.split('-');
            const dObj = new Date(parseInt(dParts[0]), parseInt(dParts[1]) - 1, parseInt(dParts[2]));
            const dowNames = ['Chủ Nhật', 'Thứ Hai', 'Thứ Ba', 'Thứ Tư', 'Thứ Năm', 'Thứ Sáu', 'Thứ Bảy'];
            const dow = dowNames[dObj.getDay()];
            const dateStr = `${String(dObj.getDate()).padStart(2, '0')}/${String(dObj.getMonth() + 1).padStart(2, '0')}/${dObj.getFullYear()}`;
            document.getElementById('mddHeaderTitle').textContent = `Chi tiết lịch trực — ${dow}, ${dateStr}`;

            // Set of doctor IDs with approved leave on this day
            const approvedLeaveDoctorIds = new Set(
                currentDetailCellData.leaves
                    .filter(l => (l.status || '').toLowerCase() === 'approved')
                    .map(l => l.dentistId)
            );

            // Separate Morning and Afternoon shifts
            const morningShifts = currentDetailCellData.shifts.filter(s => {
                const hour = parseInt((s.startTime || '08:00').split(':')[0], 10);
                return hour < 12;
            });

            const afternoonShifts = currentDetailCellData.shifts.filter(s => {
                const hour = parseInt((s.startTime || '13:30').split(':')[0], 10);
                return hour >= 12;
            });

            // Valid working shifts (doctors without approved leave)
            const validMorningShifts = morningShifts.filter(s => !approvedLeaveDoctorIds.has(s.dentistUserId));
            const validAfternoonShifts = afternoonShifts.filter(s => !approvedLeaveDoctorIds.has(s.dentistUserId));

            // 2. Summary (3 compact stats)
            document.getElementById('mddMorningBadge').textContent = `${validMorningShifts.length} bác sĩ`;
            document.getElementById('mddAfternoonBadge').textContent = `${validAfternoonShifts.length} bác sĩ`;
            document.getElementById('mddMorningHeaderCount').textContent = `${validMorningShifts.length} BS`;
            document.getElementById('mddAfternoonHeaderCount').textContent = `${validAfternoonShifts.length} BS`;

            const conflictWrap = document.getElementById('mddConflictBadgeWrap');
            if (currentDetailCellData.conflicts && currentDetailCellData.conflicts.length > 0) {
                conflictWrap.style.display = 'inline-flex';
                document.getElementById('mddConflictBadge').textContent = currentDetailCellData.conflicts.length;
            } else {
                conflictWrap.style.display = 'none';
            }

            // 3. Nhóm A (Ca Sáng) & Nhóm B (Ca Chiều)
            renderShiftDoctorList(validMorningShifts, 'mddMorningList', '08:00', '12:00', approvedLeaveDoctorIds);
            renderShiftDoctorList(validAfternoonShifts, 'mddAfternoonList', '13:30', '17:30', approvedLeaveDoctorIds);

            // 4. Nhóm C: Bác Sĩ Nghỉ Phép
            const leavesContainer = document.getElementById('mddLeavesContainer');
            leavesContainer.innerHTML = '';
            document.getElementById('mddLeaveCountBadge').textContent = currentDetailCellData.leaves.length;

            if (!currentDetailCellData.leaves || currentDetailCellData.leaves.length === 0) {
                leavesContainer.innerHTML = '<div class="p-2 rounded border bg-light text-muted small text-center"><i class="bi bi-check-circle me-1 text-success"></i>Không có bác sĩ nghỉ phép.</div>';
            } else {
                const leavesList = document.createElement('div');
                leavesList.className = 'd-flex flex-column gap-2';
                currentDetailCellData.leaves.forEach(l => {
                    const isApproved = (l.status || '').toLowerCase() === 'approved';
                    const badgeClass = isApproved 
                        ? 'bg-success-subtle text-success border border-success-subtle' 
                        : 'bg-warning-subtle text-warning-emphasis border border-warning-subtle';
                    const statusText = isApproved ? 'Đã duyệt' : 'Chờ duyệt';
                    const statusDesc = isApproved ? 'Nghỉ phép đã duyệt' : 'Đơn nghỉ phép chờ duyệt';

                    const item = document.createElement('div');
                    item.className = 'p-2 rounded border bg-white d-flex justify-content-between align-items-center shadow-2xs';
                    item.innerHTML = `
                        <div>
                            <div class="fw-bold text-dark small">${formatDoctorName(l.dentistName)}</div>
                            <div class="text-muted" style="font-size: 12px;">
                                ${l.deptName ? l.deptName + ' • ' : ''}${statusDesc} · ${l.period || 'Cả ngày'}
                                ${l.reason ? ` <span class="text-secondary fst-italic">(${l.reason})</span>` : ''}
                            </div>
                        </div>
                        <span class="badge ${badgeClass}">${statusText}</span>
                    `;
                    leavesList.appendChild(item);
                });
                leavesContainer.appendChild(leavesList);
            }

            // 5. Nhóm D.1: Lịch Hẹn Trong Ngày
            const apptsContainer = document.getElementById('mddApptsContainer');
            apptsContainer.innerHTML = '';
            document.getElementById('mddApptCountBadge').textContent = currentDetailCellData.appts.length;

            if (!currentDetailCellData.appts || currentDetailCellData.appts.length === 0) {
                apptsContainer.innerHTML = '<div class="p-2 rounded border bg-white text-muted small text-center">Không có lịch hẹn trong ngày.</div>';
            } else {
                const apptsList = document.createElement('div');
                apptsList.className = 'd-flex flex-column gap-2';
                currentDetailCellData.appts.forEach(a => {
                    const item = document.createElement('div');
                    item.className = 'p-2 rounded border bg-white d-flex justify-content-between align-items-center shadow-2xs';
                    item.innerHTML = `
                        <div>
                            <div class="fw-bold text-dark small">
                                <i class="bi bi-clock me-1 text-primary"></i>${a.startTime} - ${a.endTime} • ${formatDoctorName(a.dentistName)}
                            </div>
                            <div class="text-muted" style="font-size: 12px;">${a.serviceName || 'Dịch vụ nha khoa'}</div>
                        </div>
                        <span class="badge bg-light text-dark border">${translateApptStatus(a.status)}</span>
                    `;
                    apptsList.appendChild(item);
                });
                apptsContainer.appendChild(apptsList);
            }

            // 6. Nhóm D.2: Cảnh Báo Xung Đột
            const conflictsContainer = document.getElementById('mddConflictsContainer');
            conflictsContainer.innerHTML = '';
            document.getElementById('mddConflictCountBadge').textContent = currentDetailCellData.conflicts.length;

            if (!currentDetailCellData.conflicts || currentDetailCellData.conflicts.length === 0) {
                conflictsContainer.innerHTML = '<div class="p-2 rounded border bg-white text-muted small text-center"><i class="bi bi-check-circle me-1 text-success"></i>Không có cảnh báo xung đột.</div>';
            } else {
                const conflictsList = document.createElement('div');
                conflictsList.className = 'd-flex flex-column gap-2';
                currentDetailCellData.conflicts.forEach(c => {
                    const item = document.createElement('div');
                    item.className = 'p-2 rounded border border-danger-subtle bg-danger-subtle text-danger shadow-2xs';
                    item.innerHTML = `
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <strong class="small"><i class="bi bi-exclamation-octagon-fill me-1"></i>${formatDoctorName(c.dentistName)}</strong>
                            <span class="badge bg-danger text-white">${c.severity === 'Danger' ? 'Nghiêm trọng' : 'Cảnh báo'}</span>
                        </div>
                        <div class="small" style="font-size: 12px;">
                            <div><strong>Thời gian:</strong> ${c.timeRange}</div>
                            <div><strong>Nguyên nhân:</strong> ${c.reason}</div>
                        </div>
                    `;
                    conflictsList.appendChild(item);
                });
                conflictsContainer.appendChild(conflictsList);
            }

            const detailModal = new bootstrap.Modal(document.getElementById('monthDayDetailModal'));
            detailModal.show();
        } catch (e) {
            console.error('Failed to open day detail modal:', e);
        }
    }

    function handleOpenOverrideFromDetail() {
        if (!currentDetailCellData) return;
        const detailModalEl = document.getElementById('monthDayDetailModal');
        const modalInstance = bootstrap.Modal.getInstance(detailModalEl);
        if (modalInstance) modalInstance.hide();

        if (typeof openDailyOverrideModal === 'function') {
            openDailyOverrideModal(
                currentDetailCellData.date,
                currentDetailCellData.onLeave,
                currentDetailCellData.leaveReason,
                parseInt(currentDetailCellData.apptCount || '0', 10),
                currentDetailCellData.shifts
            );
        }
    }

    </script>
