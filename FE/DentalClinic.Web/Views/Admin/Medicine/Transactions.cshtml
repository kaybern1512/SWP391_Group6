@model DentalClinic.Web.ViewModels.Admin.AdminMedicineTransactionsViewModel
@{
    ViewData["Title"] = "Nhật Ký Biến Động Kho Thuốc";
}

<div class="container-fluid p-0">
    <!-- Header -->
    <div class="page-header-dc">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <a asp-controller="AdminMedicine" asp-action="Index" class="text-decoration-none text-muted small">
                    <i class="bi bi-chevron-left"></i> Danh Sách Kho Thuốc
                </a>
                <span class="text-muted small">&bull;</span>
                <span class="badge-dc badge-role-systemadministrator">Audit Trail</span>
            </div>
            <h1 class="page-title"><i class="bi bi-clock-history me-2 text-primary"></i>Nhật Ký Biến Động Kho Thuốc</h1>
            <p class="page-subtitle">Truy vết toàn bộ lịch sử Nhập kho, Xuất cấp phát, Điều chỉnh kiểm kê thừa/thiếu theo lô và người thực hiện</p>
        </div>
        <div class="page-actions">
            <a asp-controller="AdminMedicine" asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Quay Lại Kho Thuốc
            </a>
        </div>
    </div>

    <!-- Table -->
    <div class="card-dc">
        <div class="card-dc-header d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-shield-check text-primary"></i>
                <span class="fw-bold">Lịch Sử Giao Dịch Kho Dược Phẩm</span>
                <span class="badge bg-light text-dark border">@Model.Transactions.Count giao dịch</span>
            </div>
        </div>
        <div class="card-dc-body p-0">
            <div class="table-responsive">
                <table class="table-dc mb-0">
                    <thead>
                        <tr>
                            <th>Thời Gian</th>
                            <th>Loại Giao Dịch</th>
                            <th>Mặt Hàng Thuốc</th>
                            <th>Số Lô (Batch)</th>
                            <th class="text-center">Biến Động</th>
                            <th class="text-center">Trước $\rightarrow$ Sau</th>
                            <th>Lý Do Giải Trình</th>
                            <th>Người Thao Tác</th>
                            <th>Mã Chứng Từ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Transactions.Count == 0)
                        {
                            <tr>
                                <td colspan="9" class="text-center py-4 text-muted">
                                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                    Chưa có giao dịch biến động nào được ghi nhận.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var tx in Model.Transactions)
                            {
                                <tr>
                                    <td class="small text-muted font-monospace">@tx.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</td>
                                    <td>
                                        @if (tx.TransactionType == "Import")
                                        {
                                            <span class="badge bg-primary-subtle text-primary"><i class="bi bi-arrow-down-left me-1"></i>Nhập kho</span>
                                        }
                                        else if (tx.TransactionType == "AdjustmentIncrease")
                                        {
                                            <span class="badge bg-success-subtle text-success"><i class="bi bi-plus me-1"></i>Kiểm kê tăng</span>
                                        }
                                        else if (tx.TransactionType == "AdjustmentDecrease")
                                        {
                                            <span class="badge bg-warning-subtle text-warning"><i class="bi bi-dash me-1"></i>Kiểm kê giảm</span>
                                        }
                                        else if (tx.TransactionType == "Dispense")
                                        {
                                            <span class="badge bg-info-subtle text-info"><i class="bi bi-arrow-up-right me-1"></i>Cấp thuốc</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary">@tx.TransactionType</span>
                                        }
                                    </td>
                                    <td>
                                        <a asp-controller="AdminMedicine" asp-action="Detail" asp-route-id="@tx.MedicineId" class="text-decoration-none fw-semibold text-dark">
                                            @tx.MedicineName
                                        </a>
                                        <div class="text-muted small font-monospace">@tx.MedicineCode</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border font-monospace">@tx.BatchNumber</span>
                                    </td>
                                    <td class="text-center fw-bold @(tx.TransactionType == "AdjustmentDecrease" || tx.TransactionType == "Dispense" ? "text-danger" : "text-success")">
                                        @(tx.TransactionType == "AdjustmentDecrease" || tx.TransactionType == "Dispense" ? "-" : "+")@tx.Quantity
                                    </td>
                                    <td class="text-center small font-monospace text-muted">
                                        @tx.QuantityBefore $\rightarrow$ @tx.QuantityAfter
                                    </td>
                                    <td class="small">@tx.Reason</td>
                                    <td class="small text-muted">
                                        <i class="bi bi-person me-1"></i>@tx.PerformedByUserName
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-muted small font-monospace">@(tx.ReferenceCode ?? "N/A")</span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
