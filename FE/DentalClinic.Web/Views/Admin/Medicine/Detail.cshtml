@model DentalClinic.Web.ViewModels.Admin.AdminMedicineDetailViewModel
@{
    var med = Model.Medicine;
    ViewData["Title"] = $"Kho Thuốc - {med.MedicineName}";
    var today = DateOnly.FromDateTime(DateTime.Today);
}

<div class="container-fluid p-0">
    <!-- Header -->
    <div class="page-header-dc">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <a asp-controller="AdminMedicine" asp-action="Index" class="text-decoration-none text-muted small">
                    <i class="bi bi-chevron-left"></i> Danh Sách Kho Thuốc
                </a>
                <span class="text-muted small">&bull;</span>
                <span class="badge bg-light text-dark border font-monospace">@med.MedicineCode</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <h1 class="page-title mb-0">@med.MedicineName</h1>
                @if (med.Status == "Active")
                {
                    <span class="badge bg-success-subtle text-success">Đang dùng</span>
                }
                else if (med.Status == "Inactive")
                {
                    <span class="badge bg-secondary-subtle text-secondary">Tạm dừng</span>
                }
                else
                {
                    <span class="badge bg-dark-subtle text-dark">Ngừng nhập</span>
                }
            </div>
            <p class="page-subtitle mt-1 mb-0">
                @(med.ActiveIngredient ?? "Chưa rõ hoạt chất") &bull; @(med.Concentration ?? "N/A") &bull; @med.DosageForm &bull; Đơn vị: <strong>@med.Unit</strong>
            </p>
        </div>
        <div class="page-actions d-flex gap-2">
            <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editMedicineModal">
                <i class="bi bi-pencil-square me-1"></i> Sửa Thông Tin
            </button>
            <button type="button" class="btn btn-outline-warning" data-bs-toggle="modal" data-bs-target="#adjustStockModal">
                <i class="bi bi-sliders me-1"></i> Điều Chỉnh Tồn Kho
            </button>
            <button type="button" class="btn btn-dc-primary" data-bs-toggle="modal" data-bs-target="#importBatchModal">
                <i class="bi bi-box-arrow-in-down me-1"></i> Nhập Thêm Kho
            </button>
        </div>
    </div>

    <!-- Quick Stats -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card-dc h-100 p-3">
                <span class="text-muted small fw-semibold">Tồn Kho Khả Dụng</span>
                <div class="h3 fw-bold my-1 @(med.TotalAvailableStock <= 0 ? "text-danger" : (med.IsLowStock ? "text-warning" : "text-success"))">
                    @med.TotalAvailableStock @med.Unit
                </div>
                <span class="text-muted small">Định mức cảnh báo: @med.MinimumStockAlert @med.Unit</span>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card-dc h-100 p-3">
                <span class="text-muted small fw-semibold">Đơn Giá Bán Quy Định</span>
                <div class="h3 fw-bold my-1 text-primary">
                    @med.UnitPrice.ToString("N0") đ
                </div>
                <span class="text-muted small">Đơn vị tính: 1 @med.Unit</span>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card-dc h-100 p-3">
                <span class="text-muted small fw-semibold">Trạng Thái Tồn Kho</span>
                @if (med.TotalAvailableStock <= 0)
                {
                    <div class="h5 fw-bold my-1 text-danger">
                        <i class="bi bi-x-circle me-1"></i> Hết Hàng (0)
                    </div>
                    <span class="text-muted small text-danger">Cần bổ sung kho thuốc</span>
                }
                else if (med.IsLowStock)
                {
                    <div class="h5 fw-bold my-1 text-warning">
                        <i class="bi bi-exclamation-triangle me-1"></i> Tồn Kho Thấp
                    </div>
                    <span class="text-muted small text-warning">Dưới định mức tối thiểu</span>
                }
                else
                {
                    <div class="h5 fw-bold my-1 text-success">
                        <i class="bi bi-check-circle me-1"></i> Tồn An Toàn
                    </div>
                    <span class="text-muted small text-success">Đạt tiêu chuẩn cấp phát</span>
                }
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card-dc h-100 p-3">
                <span class="text-muted small fw-semibold">Dạng Bào Chế & Hàm Lượng</span>
                <div class="h5 fw-bold my-1 text-dark text-truncate" title="@(med.DosageForm ?? "Dạng chuẩn")">
                    @(med.DosageForm ?? "Dạng chuẩn")
                </div>
                <span class="text-muted small">Hàm lượng: @(med.Concentration ?? "N/A")</span>
            </div>
        </div>
    </div>

    <!-- Navigation Tabs -->
    <ul class="nav nav-tabs mb-4" id="medicineTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active fw-semibold" id="stock-tab" data-bs-toggle="tab" data-bs-target="#stockTabContent" type="button" role="tab">
                <i class="bi bi-boxes me-2"></i> Quản Lý Tồn Kho & Thông Tin Thuốc
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-semibold" id="transactions-tab" data-bs-toggle="tab" data-bs-target="#transactionsTabContent" type="button" role="tab">
                <i class="bi bi-clock-history me-2"></i> Nhật Ký Biến Động Gần Đây (@med.RecentTransactions.Count)
            </button>
        </li>
    </ul>

    <div class="tab-content" id="medicineTabContent">
        <!-- TAB 1: THÔNG TIN TỒN KHO & QUẢN LÝ -->
        <div class="tab-pane fade show active" id="stockTabContent" role="tabpanel">
            <div class="row g-4">
                <div class="col-lg-7">
                    <div class="card-dc h-100">
                        <div class="card-dc-header d-flex justify-content-between align-items-center">
                            <div class="fw-bold"><i class="bi bi-clipboard-pulse text-primary me-2"></i>Chi Tiết Mặt Hàng Dược Phẩm</div>
                            <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editMedicineModal">
                                <i class="bi bi-pencil me-1"></i> Chỉnh sửa
                            </button>
                        </div>
                        <div class="card-dc-body p-4">
                            <div class="row g-3">
                                <div class="col-sm-6">
                                    <div class="text-muted small">Mã Thuốc</div>
                                    <div class="fw-bold fs-6 font-monospace text-primary">@med.MedicineCode</div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="text-muted small">Tên Thuốc</div>
                                    <div class="fw-bold fs-6">@med.MedicineName</div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="text-muted small">Hoạt Chất Chính</div>
                                    <div class="fw-semibold">@(med.ActiveIngredient ?? "Chưa rõ")</div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="text-muted small">Hàm Lượng / Quy Cách</div>
                                    <div class="fw-semibold">@(med.Concentration ?? "N/A")</div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="text-muted small">Dạng Bào Chế</div>
                                    <div>@(med.DosageForm ?? "Dạng chuẩn")</div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="text-muted small">Đơn Vị Tính</div>
                                    <div><span class="badge bg-secondary-subtle text-secondary">@med.Unit</span></div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="text-muted small">Đơn Giá Bán</div>
                                    <div class="fw-bold text-success">@med.UnitPrice.ToString("N0") VNĐ</div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="text-muted small">Định Mức Cảnh Báo Tối Thiểu</div>
                                    <div class="fw-semibold">@med.MinimumStockAlert @med.Unit</div>
                                </div>
                                <div class="col-12">
                                    <div class="text-muted small">Chỉ Định & Hướng Dẫn Sử Dụng</div>
                                    <div class="p-2 rounded bg-light border mt-1 small">
                                        @(string.IsNullOrWhiteSpace(med.UsageInstructions) ? "Chưa có ghi chú chỉ định." : med.UsageInstructions)
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-5">
                    <div class="card-dc h-100">
                        <div class="card-dc-header">
                            <div class="fw-bold"><i class="bi bi-box-seam text-primary me-2"></i>Thao Tác Kho Nhanh</div>
                        </div>
                        <div class="card-dc-body p-4 d-flex flex-column justify-content-between">
                            <div>
                                <div class="alert alert-info py-2 small mb-4">
                                    <i class="bi bi-info-circle-fill me-1"></i>
                                    Kho dược phẩm quản lý tồn kho trực tiếp theo đơn vị <strong>@med.Unit</strong>. Mọi thao tác nhập hoặc điều chỉnh đều tự động ghi nhật ký kiểm toán.
                                </div>

                                <div class="p-3 border rounded-3 bg-light mb-3 text-center">
                                    <div class="text-muted small mb-1">Số Lượng Tồn Kho Hiện Tại</div>
                                    <div class="display-6 fw-bold @(med.TotalAvailableStock <= 0 ? "text-danger" : (med.IsLowStock ? "text-warning" : "text-success"))">
                                        @med.TotalAvailableStock
                                    </div>
                                    <div class="fw-semibold text-muted">@med.Unit</div>
                                </div>
                            </div>

                            <div class="d-grid gap-2">
                                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#importBatchModal">
                                    <i class="bi bi-box-arrow-in-down me-2"></i> Nhập Thêm Kho
                                </button>
                                <button type="button" class="btn btn-outline-warning" data-bs-toggle="modal" data-bs-target="#adjustStockModal">
                                    <i class="bi bi-sliders me-2"></i> Điều Chỉnh Tồn Kho Kiểm Kê
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB 2: NHẬT KÝ BIẾN ĐỘNG -->
        <div class="tab-pane fade" id="transactionsTabContent" role="tabpanel">
            <div class="card-dc">
                <div class="card-dc-header d-flex justify-content-between align-items-center">
                    <div class="fw-bold"><i class="bi bi-clock-history text-primary me-2"></i>Lịch Sử Nhập / Xuất / Kiểm Kê (Audit Trail)</div>
                    <a asp-controller="AdminMedicine" asp-action="Transactions" asp-route-medicineId="@med.MedicineId" class="btn btn-sm btn-outline-secondary">
                        Xem Tất Cả Nhật Ký
                    </a>
                </div>
                <div class="card-dc-body p-0">
                    <div class="table-responsive">
                        <table class="table-dc mb-0">
                            <thead>
                                <tr>
                                    <th>Thời Gian</th>
                                    <th>Loại Giao Dịch</th>
                                    <th class="text-center">Biến Động</th>
                                    <th class="text-center">Trước $\rightarrow$ Sau</th>
                                    <th>Lý Do Giải Trình</th>
                                    <th>Người Thực Hiện</th>
                                    <th>Mã Tham Chiếu</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (med.RecentTransactions.Count == 0)
                                {
                                    <tr>
                                        <td colspan="7" class="text-center py-4 text-muted">
                                            <i class="bi bi-journal-text fs-2 d-block mb-2"></i>
                                            Chưa có giao dịch biến động nào được ghi nhận.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var tx in med.RecentTransactions)
                                    {
                                        <tr>
                                            <td class="small text-muted">@tx.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                            <td>
                                                @if (tx.TransactionType == "Import")
                                                {
                                                    <span class="badge bg-primary-subtle text-primary"><i class="bi bi-arrow-down-left me-1"></i>Nhập kho</span>
                                                }
                                                else if (tx.TransactionType == "AdjustmentIncrease")
                                                {
                                                    <span class="badge bg-success-subtle text-success"><i class="bi bi-plus me-1"></i>Kiểm kê tăng</span>
                                                }
                                                else if (tx.TransactionType == "AdjustmentDecrease")
                                                {
                                                    <span class="badge bg-warning-subtle text-warning"><i class="bi bi-dash me-1"></i>Kiểm kê giảm</span>
                                                }
                                                else if (tx.TransactionType == "Dispense")
                                                {
                                                    <span class="badge bg-info-subtle text-info"><i class="bi bi-arrow-up-right me-1"></i>Cấp thuốc</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary-subtle text-secondary">@tx.TransactionType</span>
                                                }
                                            </td>
                                            <td class="text-center fw-bold @(tx.TransactionType == "AdjustmentDecrease" || tx.TransactionType == "Dispense" ? "text-danger" : "text-success")">
                                                @(tx.TransactionType == "AdjustmentDecrease" || tx.TransactionType == "Dispense" ? "-" : "+")@tx.Quantity @med.Unit
                                            </td>
                                            <td class="text-center small font-monospace">@tx.QuantityBefore $\rightarrow$ @tx.QuantityAfter</td>
                                            <td class="small">@tx.Reason</td>
                                            <td class="small text-muted">@tx.PerformedByUserName</td>
                                            <td><span class="badge bg-light text-muted small font-monospace">@(tx.ReferenceCode ?? "N/A")</span></td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL: NHẬP THÊM KHO THUỐC -->
<div class="modal fade" id="importBatchModal" tabindex="-1" aria-labelledby="importBatchModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-controller="AdminMedicine" asp-action="ImportBatch" asp-route-id="@med.MedicineId">
                @Html.AntiForgeryToken()
                <input type="hidden" name="BatchNumber" value="STOCK-@med.MedicineCode" />
                <input type="hidden" name="ExpiryDate" value="@DateTime.Today.AddYears(1).ToString("yyyy-MM-dd")" />

                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold" id="importBatchModalLabel">
                        <i class="bi bi-box-arrow-in-down me-2"></i> Nhập Thêm Kho Dược Phẩm
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="alert alert-info py-2 small mb-3">
                        <i class="bi bi-info-circle me-1"></i> Đang nhập bổ sung kho cho thuốc: <strong>@med.MedicineName</strong> (@med.MedicineCode)
                    </div>

                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold">Số Lượng Nhập (@med.Unit) <span class="text-danger">*</span></label>
                            <input type="number" name="Quantity" class="form-control" min="1" placeholder="VD: 100" required />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold">Giá Vốn Nhập (VNĐ)</label>
                            <input type="number" name="CostPrice" class="form-control" min="0" step="100" placeholder="VD: 3200" />
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold">Mã Chứng Từ / Hóa Đơn</label>
                            <input type="text" name="ReferenceCode" class="form-control font-monospace" placeholder="VD: PO-2026-009, HD-DHG-881..." />
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold">Lý Do / Nguồn Gốc Nhập <span class="text-danger">*</span></label>
                            <input type="text" name="Reason" class="form-control" value="Nhập thêm kho theo hóa đơn giao hàng" required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary fw-semibold">
                        <i class="bi bi-check-lg me-1"></i> Xác Nhận Nhập Kho
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL: ĐIỀU CHỈNH TỒN KHO KIỂM KÊ -->
<div class="modal fade" id="adjustStockModal" tabindex="-1" aria-labelledby="adjustStockModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-controller="AdminMedicine" asp-action="AdjustStock" id="adjustStockForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="batchId" id="adjBatchId" value="@med.MedicineId" />
                <input type="hidden" name="medicineId" value="@med.MedicineId" />

                <div class="modal-header bg-warning text-dark">
                    <h5 class="modal-title fw-bold" id="adjustStockModalLabel">
                        <i class="bi bi-sliders me-2"></i> Điều Chỉnh Kiểm Kê Tồn Kho
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="alert alert-warning py-2 small mb-3">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>
                        Quy tắc bất biến: Mọi điều chỉnh tồn kho đều phải ghi nhận nhật ký có truy vết, không cho phép tồn âm.
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted small">Thuốc Đang Điều Chỉnh:</label>
                        <div class="fw-bold fs-6">@med.MedicineName <span class="font-monospace text-primary">(@med.MedicineCode)</span></div>
                        <div class="text-muted small">Tồn khả dụng hiện tại: <strong id="adjQtyAvailDisplay">@med.TotalAvailableStock</strong> @med.Unit</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Hình Thức Điều Chỉnh <span class="text-danger">*</span></label>
                        <select name="AdjustmentType" id="adjAdjustmentType" class="form-select" required>
                            <option value="Increase">Tăng tồn kho (+) (Kiểm kê thừa / trả hàng lại)</option>
                            <option value="Decrease">Giảm tồn kho (-) (Kiểm kê hao hụt / thuốc hỏng)</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Số Lượng Điều Chỉnh (@med.Unit) <span class="text-danger">*</span></label>
                        <input type="number" name="Quantity" id="adjQuantity" class="form-control" min="1" placeholder="Nhập số lượng thay đổi tuyệt đối" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Lý Do Giải Trình Bắt Buộc <span class="text-danger">*</span></label>
                        <textarea name="Reason" class="form-control" rows="3" placeholder="Ghi rõ lý do: VD: Kiểm kê định kỳ phát hiện thừa 2 viên..." required></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" id="btnSubmitAdjust" class="btn btn-warning fw-semibold">
                        <i class="bi bi-check-lg me-1"></i> Lưu Biên Bản Điều Chỉnh
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL: SỬA THÔNG TIN THUỐC -->
<div class="modal fade" id="editMedicineModal" tabindex="-1" aria-labelledby="editMedicineModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-controller="AdminMedicine" asp-action="Edit" asp-route-id="@med.MedicineId">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold" id="editMedicineModalLabel">
                        <i class="bi bi-pencil-square me-2"></i> Chỉnh Sửa Thông Tin Thuốc
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-12 col-md-4">
                            <label class="form-label fw-semibold">Mã Thuốc</label>
                            <input type="text" class="form-control font-monospace" value="@med.MedicineCode" disabled />
                        </div>
                        <div class="col-12 col-md-8">
                            <label class="form-label fw-semibold">Tên Thuốc <span class="text-danger">*</span></label>
                            <input type="text" name="MedicineName" class="form-control" value="@med.MedicineName" required />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold">Hoạt Chất Chính</label>
                            <input type="text" name="ActiveIngredient" class="form-control" value="@med.ActiveIngredient" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold">Hàm Lượng</label>
                            <input type="text" name="Concentration" class="form-control" value="@med.Concentration" />
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label fw-semibold">Dạng Bào Chế</label>
                            <input type="text" name="DosageForm" class="form-control" value="@med.DosageForm" />
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label fw-semibold">Đơn Vị Tính <span class="text-danger">*</span></label>
                            <input type="text" name="Unit" class="form-control" value="@med.Unit" required />
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label fw-semibold">Đơn Giá Bán (VNĐ) <span class="text-danger">*</span></label>
                            <input type="number" name="UnitPrice" class="form-control" min="0" step="100" value="@med.UnitPrice" required />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold">Ngưỡng Cảnh Báo Tồn Tối Thiểu</label>
                            <input type="number" name="MinimumStockAlert" class="form-control" min="0" value="@med.MinimumStockAlert" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold">Trạng Thái Danh Mục</label>
                            <select name="Status" class="form-select">
                                <option value="Active" selected="@(med.Status == "Active")">Đang dùng (Active)</option>
                                <option value="Inactive" selected="@(med.Status == "Inactive")">Tạm dừng (Inactive)</option>
                                <option value="Discontinued" selected="@(med.Status == "Discontinued")">Ngừng nhập (Discontinued)</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold">Chỉ Định & Hướng Dẫn Sử Dụng</label>
                            <textarea name="UsageInstructions" class="form-control" rows="2">@med.UsageInstructions</textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary fw-semibold">
                        <i class="bi bi-check-lg me-1"></i> Lưu Cập Nhật
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const adjustModal = document.getElementById('adjustStockModal');
        if (adjustModal) {
            adjustModal.addEventListener('show.bs.modal', function(event) {
                const submitBtn = document.getElementById('btnSubmitAdjust');
                if (submitBtn) {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = '<i class="bi bi-check-lg me-1"></i> Lưu Biên Bản Điều Chỉnh';
                }
            });
        }

        // Double-click protection and negative stock prevention
        const adjustForm = document.getElementById('adjustStockForm');
        if (adjustForm) {
            adjustForm.addEventListener('submit', function(e) {
                const adjType = document.getElementById('adjAdjustmentType')?.value;
                const qtyAvail = parseInt(document.getElementById('adjQtyAvailDisplay')?.textContent || '0', 10);
                const reqQty = parseInt(document.getElementById('adjQuantity')?.value || '0', 10);

                if (adjType === 'Decrease' && reqQty > qtyAvail) {
                    e.preventDefault();
                    alert(`Không thể giảm tồn kho! Số lượng yêu cầu giảm (${reqQty}) vượt quá số lượng tồn khả dụng hiện tại (${qtyAvail}).`);
                    return false;
                }

                const submitBtn = document.getElementById('btnSubmitAdjust');
                if (submitBtn) {
                    submitBtn.disabled = true;
                    submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang xử lý...';
                }
            });
        }
    });
</script>
