@model DentalClinic.Web.ViewModels.Admin.AdminMedicineDetailViewModel
@{
    var med = Model.Medicine;
    ViewData["Title"] = $"Kho Thuốc - {med.MedicineName}";
    var today = DateOnly.FromDateTime(DateTime.Today);
}

<div class="container-fluid p-0">
    <!-- Header -->
    <div class="page-header-dc">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <a asp-controller="AdminMedicine" asp-action="Index" class="text-decoration-none text-muted small">
                    <i class="bi bi-chevron-left"></i> Danh Sách Kho Thuốc
                </a>
                <span class="text-muted small">&bull;</span>
                <span class="badge bg-light text-dark border font-monospace">@med.MedicineCode</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <h1 class="page-title mb-0">@med.MedicineName</h1>
                @if (med.Status == "Active")
                {
                    <span class="badge bg-success-subtle text-success">Đang dùng</span>
                }
                else if (med.Status == "Inactive")
                {
                    <span class="badge bg-secondary-subtle text-secondary">Tạm dừng</span>
                }
                else
                {
                    <span class="badge bg-dark-subtle text-dark">Ngừng nhập</span>
                }
            </div>
            <p class="page-subtitle mt-1 mb-0">
                @(med.ActiveIngredient ?? "Chưa rõ hoạt chất") &bull; @(med.Concentration ?? "N/A") &bull; @med.DosageForm &bull; Đơn vị: <strong>@med.Unit</strong>
            </p>
        </div>
        <div class="page-actions d-flex gap-2">
            <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editMedicineModal">
                <i class="bi bi-pencil-square me-1"></i> Sửa Thông Tin
            </button>
            <button type="button" class="btn btn-dc-primary" data-bs-toggle="modal" data-bs-target="#importBatchModal">
                <i class="bi bi-box-arrow-in-down me-1"></i> Nhập Lô Thuốc Mới
            </button>
        </div>
    </div>

    <!-- Quick Stats -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card-dc h-100 p-3">
                <span class="text-muted small fw-semibold">Tồn Kho Khả Dụng</span>
                <div class="h3 fw-bold my-1 @(med.IsLowStock ? "text-warning" : "text-success")">
                    @med.TotalAvailableStock @med.Unit
                </div>
                <span class="text-muted small">Định mức cảnh báo: @med.MinimumStockAlert @med.Unit</span>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card-dc h-100 p-3">
                <span class="text-muted small fw-semibold">Đơn Giá Bán Quy Định</span>
                <div class="h3 fw-bold my-1 text-primary">
                    @med.UnitPrice.ToString("N0") đ
                </div>
                <span class="text-muted small">Đơn vị tính: 1 @med.Unit</span>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card-dc h-100 p-3">
                <span class="text-muted small fw-semibold">Tổng Số Lô Hàng</span>
                <div class="h3 fw-bold my-1 text-dark">
                    @med.Batches.Count
                </div>
                <span class="text-muted small">Lô còn tồn khả dụng: @med.ActiveBatchesCount</span>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card-dc h-100 p-3">
                <span class="text-muted small fw-semibold">Tình Trạng Hạn Dùng</span>
                @if (med.HasNearExpiryBatch)
                {
                    <div class="h5 fw-bold my-1 text-danger">
                        <i class="bi bi-hourglass-bottom me-1"></i> Có Lô Cận Hạn
                    </div>
                    <span class="text-muted small text-danger">Ưu tiên cấp theo nguyên tắc FEFO</span>
                }
                else
                {
                    <div class="h5 fw-bold my-1 text-success">
                        <i class="bi bi-shield-check me-1"></i> An Toàn
                    </div>
                    <span class="text-muted small">Tất cả các lô đều trên 60 ngày</span>
                }
            </div>
        </div>
    </div>

    <!-- Navigation Tabs -->
    <ul class="nav nav-tabs mb-4" id="medicineTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active fw-semibold" id="batches-tab" data-bs-toggle="tab" data-bs-target="#batchesTabContent" type="button" role="tab">
                <i class="bi bi-boxes me-2"></i> Danh Sách Lô Hàng (@med.Batches.Count)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-semibold" id="transactions-tab" data-bs-toggle="tab" data-bs-target="#transactionsTabContent" type="button" role="tab">
                <i class="bi bi-clock-history me-2"></i> Nhật Ký Biến Động Gần Đây (@med.RecentTransactions.Count)
            </button>
        </li>
    </ul>

    <div class="tab-content" id="medicineTabContent">
        <!-- TAB 1: DANH SÁCH LÔ HÀNG -->
        <div class="tab-pane fade show active" id="batchesTabContent" role="tabpanel">
            <div class="card-dc">
                <div class="card-dc-header d-flex justify-content-between align-items-center">
                    <div class="fw-bold"><i class="bi bi-boxes text-primary me-2"></i>Các Lô Thuốc Trong Kho (FEFO)</div>
                    <button type="button" class="btn btn-sm btn-dc-primary" data-bs-toggle="modal" data-bs-target="#importBatchModal">
                        <i class="bi bi-plus-lg me-1"></i> Nhập Lô Mới
                    </button>
                </div>
                <div class="card-dc-body p-0">
                    <div class="table-responsive">
                        <table class="table-dc mb-0">
                            <thead>
                                <tr>
                                    <th>Số Lô (Batch)</th>
                                    <th>Hạn Sử Dụng (Expiry)</th>
                                    <th class="text-center">Số Nhập Ban Đầu</th>
                                    <th class="text-center">Tồn Khả Dụng</th>
                                    <th class="text-end">Giá Vốn Nhập</th>
                                    <th class="text-center">Trạng Thái</th>
                                    <th class="text-end">Thao Tác Kiểm Kê</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (med.Batches.Count == 0)
                                {
                                    <tr>
                                        <td colspan="7" class="text-center py-4 text-muted">
                                            <i class="bi bi-box fs-2 d-block mb-2"></i>
                                            Chưa có lô hàng nào được nhập cho loại thuốc này.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var b in med.Batches)
                                    {
                                        <tr>
                                            <td>
                                                <span class="badge bg-light text-dark border font-monospace fw-bold">@b.BatchNumber</span>
                                                <div class="text-muted small">Nhập: @b.ReceivedDate.ToString("dd/MM/yyyy")</div>
                                            </td>
                                            <td>
                                                <div class="fw-bold @(b.IsExpired ? "text-danger" : (b.IsNearExpiry ? "text-warning" : "text-dark"))">
                                                    @b.ExpiryDate.ToString("dd/MM/yyyy")
                                                </div>
                                                @if (b.IsExpired)
                                                {
                                                    <span class="badge bg-danger small">Đã hết hạn (@b.DaysUntilExpiry ngày)</span>
                                                }
                                                else if (b.IsNearExpiry)
                                                {
                                                    <span class="badge bg-warning text-dark small">Cận hạn (còn @b.DaysUntilExpiry ngày)</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted small">Còn @b.DaysUntilExpiry ngày</span>
                                                }
                                            </td>
                                            <td class="text-center text-muted">@b.QuantityReceived @med.Unit</td>
                                            <td class="text-center">
                                                @if (b.QuantityAvailable <= 0)
                                                {
                                                    <span class="badge bg-secondary-subtle text-secondary">Hết lô (0)</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success-subtle text-success fw-bold fs-6">
                                                        @b.QuantityAvailable @med.Unit
                                                    </span>
                                                }
                                            </td>
                                            <td class="text-end text-muted">@b.CostPrice.ToString("N0") đ</td>
                                            <td class="text-center">
                                                @if (b.Status == "Available")
                                                {
                                                    <span class="badge bg-success-subtle text-success">Khả dụng</span>
                                                }
                                                else if (b.Status == "Depleted")
                                                {
                                                    <span class="badge bg-secondary-subtle text-secondary">Đã hết</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger-subtle text-danger">Khóa</span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                <button type="button" class="btn btn-sm btn-outline-warning" 
                                                        data-bs-toggle="modal" data-bs-target="#adjustStockModal"
                                                        data-batch-id="@b.MedicineBatchId"
                                                        data-batch-num="@b.BatchNumber"
                                                        data-qty-avail="@b.QuantityAvailable"
                                                        title="Điều chỉnh kiểm kê tồn kho">
                                                    <i class="bi bi-pencil-square me-1"></i> Điều Chỉnh Tồn
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB 2: NHẬT KÝ BIẾN ĐỘNG -->
        <div class="tab-pane fade" id="transactionsTabContent" role="tabpanel">
            <div class="card-dc">
                <div class="card-dc-header d-flex justify-content-between align-items-center">
                    <div class="fw-bold"><i class="bi bi-clock-history text-primary me-2"></i>Lịch Sử Nhập / Xuất / Kiểm Kê (Audit Trail)</div>
                    <a asp-controller="AdminMedicine" asp-action="Transactions" asp-route-medicineId="@med.MedicineId" class="btn btn-sm btn-outline-secondary">
                        Xem Tất Cả Nhật Ký
                    </a>
                </div>
                <div class="card-dc-body p-0">
                    <div class="table-responsive">
                        <table class="table-dc mb-0">
                            <thead>
                                <tr>
                                    <th>Thời Gian</th>
                                    <th>Loại Giao Dịch</th>
                                    <th>Số Lô</th>
                                    <th class="text-center">Biến Động</th>
                                    <th class="text-center">Trước $\rightarrow$ Sau</th>
                                    <th>Lý Do Giải Trình</th>
                                    <th>Người Thực Hiện</th>
                                    <th>Mã Tham Chiếu</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (med.RecentTransactions.Count == 0)
                                {
                                    <tr>
                                        <td colspan="8" class="text-center py-4 text-muted">
                                            <i class="bi bi-journal-text fs-2 d-block mb-2"></i>
                                            Chưa có giao dịch biến động nào được ghi nhận.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var tx in med.RecentTransactions)
                                    {
                                        <tr>
                                            <td class="small text-muted">@tx.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                            <td>
                                                @if (tx.TransactionType == "Import")
                                                {
                                                    <span class="badge bg-primary-subtle text-primary"><i class="bi bi-arrow-down-left me-1"></i>Nhập kho</span>
                                                }
                                                else if (tx.TransactionType == "AdjustmentIncrease")
                                                {
                                                    <span class="badge bg-success-subtle text-success"><i class="bi bi-plus me-1"></i>Kiểm kê tăng</span>
                                                }
                                                else if (tx.TransactionType == "AdjustmentDecrease")
                                                {
                                                    <span class="badge bg-warning-subtle text-warning"><i class="bi bi-dash me-1"></i>Kiểm kê giảm</span>
                                                }
                                                else if (tx.TransactionType == "Dispense")
                                                {
                                                    <span class="badge bg-info-subtle text-info"><i class="bi bi-arrow-up-right me-1"></i>Cấp thuốc</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary-subtle text-secondary">@tx.TransactionType</span>
                                                }
                                            </td>
                                            <td><span class="badge bg-light text-dark border font-monospace">@tx.BatchNumber</span></td>
                                            <td class="text-center fw-bold @(tx.TransactionType == "AdjustmentDecrease" || tx.TransactionType == "Dispense" ? "text-danger" : "text-success")">
                                                @(tx.TransactionType == "AdjustmentDecrease" || tx.TransactionType == "Dispense" ? "-" : "+")@tx.Quantity @med.Unit
                                            </td>
                                            <td class="text-center small font-monospace">@tx.QuantityBefore $\rightarrow$ @tx.QuantityAfter</td>
                                            <td class="small">@tx.Reason</td>
                                            <td class="small text-muted">@tx.PerformedByUserName</td>
                                            <td><span class="badge bg-light text-muted small font-monospace">@(tx.ReferenceCode ?? "N/A")</span></td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL: NHẬP LÔ THUỐC MỚI -->
<div class="modal fade" id="importBatchModal" tabindex="-1" aria-labelledby="importBatchModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-controller="AdminMedicine" asp-action="ImportBatch" asp-route-id="@med.MedicineId">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold" id="importBatchModalLabel">
                        <i class="bi bi-box-arrow-in-down me-2"></i> Nhập Lô Thuốc Mới
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="alert alert-info py-2 small mb-3">
                        <i class="bi bi-info-circle me-1"></i> Đang nhập lô cho thuốc: <strong>@med.MedicineName</strong> (@med.MedicineCode)
                    </div>

                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold">Số Lô Sản Xuất <span class="text-danger">*</span></label>
                            <input type="text" name="BatchNumber" class="form-control font-monospace" placeholder="VD: BATCH-2026-01" required />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold">Hạn Sử Dụng (Expiry) <span class="text-danger">*</span></label>
                            <input type="date" name="ExpiryDate" class="form-control" value="@DateTime.Today.AddMonths(18).ToString("yyyy-MM-dd")" min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" required />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold">Số Lượng Nhập (@med.Unit) <span class="text-danger">*</span></label>
                            <input type="number" name="Quantity" class="form-control" min="1" placeholder="VD: 200" required />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold">Giá Vốn Nhập (VNĐ)</label>
                            <input type="number" name="CostPrice" class="form-control" min="0" step="100" placeholder="VD: 3200" />
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold">Mã Chứng Từ / Hóa Đơn</label>
                            <input type="text" name="ReferenceCode" class="form-control font-monospace" placeholder="VD: PO-2026-009, HD-DHG-881..." />
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold">Lý Do / Nguồn Gốc Nhập</label>
                            <input type="text" name="Reason" class="form-control" value="Nhập kho theo hóa đơn giao hàng" required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary fw-semibold">
                        <i class="bi bi-check-lg me-1"></i> Xác Nhận Nhập Kho
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL: ĐIỀU CHỈNH TỒN KHO KIỂM KÊ -->
<div class="modal fade" id="adjustStockModal" tabindex="-1" aria-labelledby="adjustStockModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-controller="AdminMedicine" asp-action="AdjustStock">
                @Html.AntiForgeryToken()
                <input type="hidden" name="batchId" id="adjBatchId" />
                <input type="hidden" name="medicineId" value="@med.MedicineId" />

                <div class="modal-header bg-warning text-dark">
                    <h5 class="modal-title fw-bold" id="adjustStockModalLabel">
                        <i class="bi bi-sliders me-2"></i> Điều Chỉnh Kiểm Kê Tồn Kho
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="alert alert-warning py-2 small mb-3">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>
                        Quy tắc bất biến: Mọi điều chỉnh tồn kho đều phải ghi nhận nhật ký có truy vết, không cho phép tồn âm.
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted small">Lô Đang Điều Chỉnh:</label>
                        <div class="fw-bold fs-6 font-monospace" id="adjBatchDisplay">-</div>
                        <div class="text-muted small">Tồn khả dụng hiện tại: <strong id="adjQtyAvailDisplay">0</strong> @med.Unit</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Hình Thức Điều Chỉnh <span class="text-danger">*</span></label>
                        <select name="AdjustmentType" class="form-select" required>
                            <option value="Increase">Tăng tồn kho (+) (Kiểm kê thừa / trả hàng lại)</option>
                            <option value="Decrease">Giảm tồn kho (-) (Kiểm kê hao hụt / thuốc hỏng / hết hạn)</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Số Lượng Điều Chỉnh (@med.Unit) <span class="text-danger">*</span></label>
                        <input type="number" name="Quantity" class="form-control" min="1" placeholder="Nhập số lượng thay đổi tuyệt đối" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Lý Do Giải Trình Bắt Buộc <span class="text-danger">*</span></label>
                        <textarea name="Reason" class="form-control" rows="3" placeholder="Ghi rõ lý do: VD: Kiểm kê định kỳ ngày 03/11 phát hiện thừa 2 viên do đóng vỉ..." required></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-warning fw-semibold">
                        <i class="bi bi-check-lg me-1"></i> Lưu Biên Bản Điều Chỉnh
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL: SỬA THÔNG TIN THUỐC -->
<div class="modal fade" id="editMedicineModal" tabindex="-1" aria-labelledby="editMedicineModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-controller="AdminMedicine" asp-action="Edit" asp-route-id="@med.MedicineId">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold" id="editMedicineModalLabel">
                        <i class="bi bi-pencil-square me-2"></i> Chỉnh Sửa Thông Tin Thuốc
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-12 col-md-4">
                            <label class="form-label fw-semibold">Mã Thuốc</label>
                            <input type="text" class="form-control font-monospace" value="@med.MedicineCode" disabled />
                        </div>
                        <div class="col-12 col-md-8">
                            <label class="form-label fw-semibold">Tên Thuốc <span class="text-danger">*</span></label>
                            <input type="text" name="MedicineName" class="form-control" value="@med.MedicineName" required />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold">Hoạt Chất Chính</label>
                            <input type="text" name="ActiveIngredient" class="form-control" value="@med.ActiveIngredient" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold">Hàm Lượng</label>
                            <input type="text" name="Concentration" class="form-control" value="@med.Concentration" />
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label fw-semibold">Dạng Bào Chế</label>
                            <input type="text" name="DosageForm" class="form-control" value="@med.DosageForm" />
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label fw-semibold">Đơn Vị Tính <span class="text-danger">*</span></label>
                            <input type="text" name="Unit" class="form-control" value="@med.Unit" required />
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label fw-semibold">Đơn Giá Bán (VNĐ) <span class="text-danger">*</span></label>
                            <input type="number" name="UnitPrice" class="form-control" min="0" step="100" value="@med.UnitPrice" required />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold">Ngưỡng Cảnh Báo Tồn Tối Thiểu</label>
                            <input type="number" name="MinimumStockAlert" class="form-control" min="0" value="@med.MinimumStockAlert" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold">Trạng Thái Danh Mục</label>
                            <select name="Status" class="form-select">
                                <option value="Active" selected="@(med.Status == "Active")">Đang dùng (Active)</option>
                                <option value="Inactive" selected="@(med.Status == "Inactive")">Tạm dừng (Inactive)</option>
                                <option value="Discontinued" selected="@(med.Status == "Discontinued")">Ngừng nhập (Discontinued)</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold">Chỉ Định & Hướng Dẫn Sử Dụng</label>
                            <textarea name="UsageInstructions" class="form-control" rows="2">@med.UsageInstructions</textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary fw-semibold">
                        <i class="bi bi-check-lg me-1"></i> Lưu Cập Nhật
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const adjustModal = document.getElementById('adjustStockModal');
        if (adjustModal) {
            adjustModal.addEventListener('show.bs.modal', function(event) {
                const btn = event.relatedTarget;
                if (!btn) return;
                const batchId = btn.getAttribute('data-batch-id');
                const batchNum = btn.getAttribute('data-batch-num');
                const qtyAvail = btn.getAttribute('data-qty-avail');

                document.getElementById('adjBatchId').value = batchId;
                document.getElementById('adjBatchDisplay').textContent = batchNum;
                document.getElementById('adjQtyAvailDisplay').textContent = qtyAvail;
            });
        }
    });
</script>
