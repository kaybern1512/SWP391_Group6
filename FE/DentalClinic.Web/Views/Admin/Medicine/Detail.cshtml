@model DentalClinic.Web.ViewModels.Admin.AdminMedicineDetailViewModel
@{
    var med = Model.Medicine;
    ViewData["Title"] = $"Kho Thuốc - {med.MedicineName}";
    var currentUrl = Context.Request.Path + Context.Request.QueryString;
}

<div class="container-fluid p-0">
    <!-- Header -->
    <div class="page-header-dc">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <a asp-controller="AdminMedicine" asp-action="Index" class="text-decoration-none text-muted small">
                    <i class="bi bi-chevron-left"></i> Danh Sách Kho Thuốc
                </a>
                <span class="text-muted small">&bull;</span>
                <span class="badge bg-light text-dark border font-monospace">@med.MedicineCode</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <h1 class="page-title mb-0">@med.MedicineName</h1>
                @if (med.Status == "Active")
                {
                    <span class="badge bg-success-subtle text-success">Hoạt động</span>
                }
                else
                {
                    <span class="badge bg-secondary-subtle text-secondary">Tạm dừng</span>
                }
            </div>
            <p class="page-subtitle mt-1 mb-0">
                Hoạt chất: <strong>@(med.ActiveIngredient ?? "Chưa rõ hoạt chất")</strong> &bull; Đơn vị tính: <strong>@med.Unit</strong>
            </p>
        </div>
        <div class="page-actions d-flex gap-2">
            <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editMedicineModal">
                <i class="bi bi-pencil me-1"></i> Sửa Thông Tin
            </button>
            <button type="button" class="btn btn-dc-primary" data-bs-toggle="modal" data-bs-target="#updateStockModal">
                <i class="bi bi-boxes me-1"></i> Cập Nhật Tồn Kho
            </button>
        </div>
    </div>

    <!-- Alert Notifications -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
            <i class="bi bi-check-circle-fill fs-5 me-2"></i>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5 me-2"></i>
            <div>@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Quick Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card-dc h-100 p-3">
                <span class="text-muted small fw-semibold">Tồn Kho Khả Dụng</span>
                <div class="h3 fw-bold my-1 @(med.TotalAvailableStock <= 0 ? "text-danger" : (med.IsLowStock ? "text-warning" : "text-success"))">
                    @med.TotalAvailableStock @med.Unit
                </div>
                <span class="text-muted small">Định mức cảnh báo: @med.MinimumStockAlert @med.Unit</span>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card-dc h-100 p-3">
                <span class="text-muted small fw-semibold">Đơn Giá Bán Quy Định</span>
                <div class="h3 fw-bold my-1 text-primary">
                    @med.UnitPrice.ToString("N0") đ
                </div>
                <span class="text-muted small">Đơn vị: 1 @med.Unit</span>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card-dc h-100 p-3">
                <span class="text-muted small fw-semibold">Trạng Thái Tồn Kho</span>
                @if (med.TotalAvailableStock <= 0)
                {
                    <div class="h5 fw-bold my-1 text-danger">
                        <i class="bi bi-x-circle me-1"></i> Hết Hàng (0)
                    </div>
                    <span class="text-muted small text-danger">Cần bổ sung kho thuốc</span>
                }
                else if (med.IsLowStock)
                {
                    <div class="h5 fw-bold my-1 text-warning">
                        <i class="bi bi-exclamation-triangle me-1"></i> Tồn Kho Thấp
                    </div>
                    <span class="text-muted small text-warning">Dưới mức tối thiểu</span>
                }
                else
                {
                    <div class="h5 fw-bold my-1 text-success">
                        <i class="bi bi-check-circle me-1"></i> Tồn An Toàn
                    </div>
                    <span class="text-muted small text-success">Đạt chuẩn kê đơn</span>
                }
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card-dc h-100 p-3">
                <span class="text-muted small fw-semibold">Trạng Thái Kê Đơn</span>
                <div class="h5 fw-bold my-1 @(med.Status == "Active" && med.TotalAvailableStock > 0 ? "text-success" : "text-secondary")">
                    @(med.Status == "Active" && med.TotalAvailableStock > 0 ? "Sẵn sàng kê đơn" : "Tạm ngưng kê đơn")
                </div>
                <span class="text-muted small">Phân hệ Bác sĩ nha khoa</span>
            </div>
        </div>
    </div>

    <!-- Main Content Layout -->
    <div class="row g-4 mb-4">
        <!-- Thông tin chi tiết thuốc -->
        <div class="col-lg-7">
            <div class="card-dc h-100">
                <div class="card-dc-header d-flex justify-content-between align-items-center">
                    <div class="fw-bold"><i class="bi bi-clipboard-pulse text-primary me-2"></i>Thông Tin Mặt Hàng Thuốc</div>
                    <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editMedicineModal">
                        <i class="bi bi-pencil me-1"></i> Chỉnh sửa
                    </button>
                </div>
                <div class="card-dc-body p-4">
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <div class="text-muted small">Mã Thuốc</div>
                            <div class="fw-bold fs-6 font-monospace text-primary">@med.MedicineCode</div>
                        </div>
                        <div class="col-sm-6">
                            <div class="text-muted small">Tên Thuốc</div>
                            <div class="fw-bold fs-6">@med.MedicineName</div>
                        </div>
                        <div class="col-sm-6">
                            <div class="text-muted small">Hoạt Chất Chính</div>
                            <div class="fw-semibold">@(med.ActiveIngredient ?? "Chưa rõ")</div>
                        </div>
                        <div class="col-sm-6">
                            <div class="text-muted small">Đơn Vị Tính</div>
                            <div><span class="badge bg-secondary-subtle text-secondary">@med.Unit</span></div>
                        </div>
                        <div class="col-sm-6">
                            <div class="text-muted small">Đơn Giá Bán</div>
                            <div class="fw-bold text-success">@med.UnitPrice.ToString("N0") VNĐ</div>
                        </div>
                        <div class="col-sm-6">
                            <div class="text-muted small">Định Mức Cảnh Báo Tối Thiểu</div>
                            <div class="fw-semibold">@med.MinimumStockAlert @med.Unit</div>
                        </div>
                        <div class="col-sm-6">
                            <div class="text-muted small">Trạng Thái Hoạt Động</div>
                            <div>
                                @if (med.Status == "Active")
                                {
                                    <span class="badge bg-success-subtle text-success">Hoạt động</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary">Tạm dừng</span>
                                }
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="text-muted small">Ngày Tạo Danh Mục</div>
                            <div class="small text-muted font-monospace">@med.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                        </div>
                        <div class="col-12">
                            <div class="text-muted small">Chỉ Định & Hướng Dẫn Sử Dụng</div>
                            <div class="p-2 rounded bg-light border mt-1 small">
                                @(string.IsNullOrWhiteSpace(med.UsageInstructions) ? "Chưa có ghi chú chỉ định." : med.UsageInstructions)
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Thao tác kho nhanh -->
        <div class="col-lg-5">
            <div class="card-dc h-100">
                <div class="card-dc-header">
                    <div class="fw-bold"><i class="bi bi-box-seam text-primary me-2"></i>Quản Lý Tồn Kho Trực Tiếp</div>
                </div>
                <div class="card-dc-body p-4 d-flex flex-column justify-content-between">
                    <div>
                        <div class="alert alert-info py-2 small mb-4">
                            <i class="bi bi-info-circle-fill me-1"></i>
                            Quản lý tồn kho trực tiếp theo đơn vị <strong>@med.Unit</strong>. Thao tác cập nhật tồn kho hỗ trợ 3 nghiệp vụ: <em>Nhập thêm</em>, <em>Giảm tồn</em> và <em>Kiểm kê lại</em>.
                        </div>

                        <div class="p-3 border rounded-3 bg-light mb-3 text-center">
                            <div class="text-muted small mb-1">Số Lượng Tồn Kho Hiện Tại</div>
                            <div class="display-5 fw-bold @(med.TotalAvailableStock <= 0 ? "text-danger" : (med.IsLowStock ? "text-warning" : "text-success"))">
                                @med.TotalAvailableStock
                            </div>
                            <div class="fw-semibold text-muted">@med.Unit</div>
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="button" class="btn btn-dc-primary btn-lg" data-bs-toggle="modal" data-bs-target="#updateStockModal">
                            <i class="bi bi-boxes me-2"></i> Cập Nhật Tồn Kho
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Nhật ký biến động gần đây -->
    <div class="card-dc">
        <div class="card-dc-header d-flex justify-content-between align-items-center">
            <div class="fw-bold"><i class="bi bi-clock-history text-primary me-2"></i>Nhật Ký Biến Động Kho (@med.RecentTransactions.Count giao dịch)</div>
            <a asp-controller="AdminMedicine" asp-action="Transactions" asp-route-medicineId="@med.MedicineId" class="btn btn-sm btn-outline-secondary">
                Xem Tất Cả Nhật Ký
            </a>
        </div>
        <div class="card-dc-body p-0">
            <div class="table-responsive">
                <table class="table-dc mb-0">
                    <thead>
                        <tr>
                            <th>Thời Gian</th>
                            <th>Loại Biến Động</th>
                            <th class="text-center">Biến Động</th>
                            <th class="text-center">Trước $\rightarrow$ Sau</th>
                            <th>Lý Do Giải Trình</th>
                            <th>Người Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (med.RecentTransactions.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">
                                    <i class="bi bi-journal-text fs-2 d-block mb-2"></i>
                                    Chưa có giao dịch biến động nào được ghi nhận cho thuốc này.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var tx in med.RecentTransactions)
                            {
                                <tr>
                                    <td class="small text-muted font-monospace">@tx.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        @if (tx.TransactionType == "Import" || tx.TransactionType == "Add")
                                        {
                                            <span class="badge bg-primary-subtle text-primary"><i class="bi bi-plus-circle me-1"></i>Nhập thêm</span>
                                        }
                                        else if (tx.TransactionType == "AdjustmentIncrease")
                                        {
                                            <span class="badge bg-success-subtle text-success"><i class="bi bi-plus me-1"></i>Kiểm kê tăng</span>
                                        }
                                        else if (tx.TransactionType == "AdjustmentDecrease" || tx.TransactionType == "Deduct")
                                        {
                                            <span class="badge bg-warning-subtle text-warning"><i class="bi bi-dash me-1"></i>Giảm tồn</span>
                                        }
                                        else if (tx.TransactionType == "Dispense")
                                        {
                                            <span class="badge bg-info-subtle text-info"><i class="bi bi-arrow-up-right me-1"></i>Cấp thuốc</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary">@tx.TransactionType</span>
                                        }
                                    </td>
                                    <td class="text-center fw-bold @(tx.TransactionType == "AdjustmentDecrease" || tx.TransactionType == "Deduct" || tx.TransactionType == "Dispense" ? "text-danger" : "text-success")">
                                        @(tx.TransactionType == "AdjustmentDecrease" || tx.TransactionType == "Deduct" || tx.TransactionType == "Dispense" ? "-" : "+")@tx.Quantity @med.Unit
                                    </td>
                                    <td class="text-center small font-monospace text-muted">@tx.QuantityBefore $\rightarrow$ @tx.QuantityAfter</td>
                                    <td class="small">@tx.Reason</td>
                                    <td class="small text-muted">@tx.PerformedByUserName</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- ================================================================= -->
<!-- MODAL: SỬA THÔNG TIN THUỐC -->
<!-- ================================================================= -->
<div class="modal fade" id="editMedicineModal" tabindex="-1" aria-labelledby="editMedicineModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-controller="AdminMedicine" asp-action="Edit" asp-route-id="@med.MedicineId" id="detailEditMedicineForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@currentUrl" />

                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold" id="editMedicineModalLabel">
                        <i class="bi bi-pencil-square me-2"></i> Chỉnh Sửa Thông Tin Thuốc - @med.MedicineCode
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-12 col-md-4">
                            <label class="form-label fw-semibold">Mã Thuốc</label>
                            <input type="text" class="form-control font-monospace bg-light" value="@med.MedicineCode" readonly />
                            <div class="form-text">Mã thuốc định danh không đổi.</div>
                        </div>
                        <div class="col-12 col-md-8">
                            <label class="form-label fw-semibold">Tên Thuốc <span class="text-danger">*</span></label>
                            <input type="text" name="MedicineName" class="form-control" value="@med.MedicineName" required />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold">Hoạt Chất Chính</label>
                            <input type="text" name="ActiveIngredient" class="form-control" value="@med.ActiveIngredient" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold">Đơn Vị Tính <span class="text-danger">*</span></label>
                            <input type="text" name="Unit" class="form-control" value="@med.Unit" required />
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label fw-semibold">Đơn Giá Bán (VNĐ) <span class="text-danger">*</span></label>
                            <input type="number" name="UnitPrice" class="form-control" min="0" step="100" value="@((long)med.UnitPrice)" required />
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label fw-semibold">Ngưỡng Cảnh Báo Tồn Tối Thiểu</label>
                            <input type="number" name="MinimumStockAlert" class="form-control" min="0" value="@med.MinimumStockAlert" />
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label fw-semibold">Trạng Thái</label>
                            <select name="Status" class="form-select">
                                <option value="Active" selected="@(med.Status == "Active")">Hoạt động</option>
                                <option value="Inactive" selected="@(med.Status == "Inactive")">Tạm dừng</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold">Chỉ Định & Hướng Dẫn Sử Dụng</label>
                            <textarea name="UsageInstructions" class="form-control" rows="2">@med.UsageInstructions</textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" id="btnSubmitDetailEdit" class="btn btn-primary fw-semibold">
                        <i class="bi bi-check-lg me-1"></i> Lưu Cập Nhật
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ================================================================= -->
<!-- MODAL: CẬP NHẬT TỒN KHO (3 lựa chọn: Nhập thêm, Giảm tồn, Kiểm kê lại) -->
<!-- ================================================================= -->
<div class="modal fade" id="updateStockModal" tabindex="-1" aria-labelledby="updateStockModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-controller="AdminMedicine" asp-action="UpdateStock" asp-route-id="@med.MedicineId" id="detailUpdateStockForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@currentUrl" />
                <input type="hidden" name="MedicineId" value="@med.MedicineId" />

                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title fw-bold" id="updateStockModalLabel">
                        <i class="bi bi-boxes me-2"></i> Cập Nhật Tồn Kho - @med.MedicineName
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <!-- Current Medicine Stock Info -->
                    <div class="p-3 border rounded-3 bg-light mb-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <span class="badge bg-light text-dark border font-monospace">@med.MedicineCode</span>
                                <h6 class="fw-bold mb-0 text-dark mt-1">@med.MedicineName</h6>
                            </div>
                            <div class="text-end">
                                <div class="text-muted small">Tồn kho hiện tại</div>
                                <div class="fs-4 fw-bold text-primary">
                                    <span id="detailCurrentStockVal">@med.TotalAvailableStock</span> <span class="fs-6 fw-normal text-muted">@med.Unit</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 3 Nghiệp Vụ Options: Nhập thêm | Giảm tồn | Kiểm kê lại -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Lựa Chọn Thao Tác <span class="text-danger">*</span></label>
                        <div class="d-flex flex-column gap-2">
                            <label class="form-check-label p-2 border rounded d-flex align-items-center gap-2 cursor-pointer bg-white" for="detailOpAdd">
                                <input class="form-check-input my-0" type="radio" name="OperationType" id="detailOpAdd" value="Add" checked />
                                <div>
                                    <strong class="text-success"><i class="bi bi-plus-circle me-1"></i> Nhập thêm</strong>
                                    <div class="text-muted small">Cộng thêm số lượng mới vào tồn kho hiện tại</div>
                                </div>
                            </label>
                            <label class="form-check-label p-2 border rounded d-flex align-items-center gap-2 cursor-pointer bg-white" for="detailOpDeduct">
                                <input class="form-check-input my-0" type="radio" name="OperationType" id="detailOpDeduct" value="Deduct" />
                                <div>
                                    <strong class="text-danger"><i class="bi bi-dash-circle me-1"></i> Giảm tồn</strong>
                                    <div class="text-muted small">Trừ bớt số lượng do hao hụt, hư hỏng, trả hàng</div>
                                </div>
                            </label>
                            <label class="form-check-label p-2 border rounded d-flex align-items-center gap-2 cursor-pointer bg-white" for="detailOpReconcile">
                                <input class="form-check-input my-0" type="radio" name="OperationType" id="detailOpReconcile" value="Reconcile" />
                                <div>
                                    <strong class="text-primary"><i class="bi bi-arrow-repeat me-1"></i> Kiểm kê lại</strong>
                                    <div class="text-muted small">Ghi nhận số lượng thực tế kiểm đếm, tự tính độ lệch</div>
                                </div>
                            </label>
                        </div>
                    </div>

                    <!-- Quantity Input -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold" id="detailLblStockQty">
                            Số lượng nhập thêm (@med.Unit) <span class="text-danger">*</span>
                        </label>
                        <input type="number" name="Quantity" id="detailStockQtyInput" class="form-control form-control-lg fw-bold" min="1" value="1" required />
                        <div class="form-text" id="detailHelpStockQty">Nhập số đơn vị cần thêm vào kho.</div>
                    </div>

                    <!-- Validation Warning Alert -->
                    <div id="detailStockWarning" class="alert alert-danger py-2 small mb-3 d-none">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>
                        <span id="detailStockWarningText"></span>
                    </div>

                    <!-- Calculation Preview Box (Tồn trước, Thay đổi, Tồn sau) -->
                    <div class="card border-primary-subtle bg-primary-subtle p-3 mb-3">
                        <div class="row text-center g-2">
                            <div class="col-4 border-end">
                                <div class="text-muted small">Tồn trước</div>
                                <div class="fw-bold fs-6 text-dark" id="detailPreviewBefore">@med.TotalAvailableStock @med.Unit</div>
                            </div>
                            <div class="col-4 border-end">
                                <div class="text-muted small">Thay đổi</div>
                                <div class="fw-bold fs-6 text-success" id="detailPreviewChange">+1 @med.Unit</div>
                            </div>
                            <div class="col-4">
                                <div class="text-muted small">Tồn sau khi đổi</div>
                                <div class="fw-bold fs-5 text-primary" id="detailPreviewAfter">@(med.TotalAvailableStock + 1) @med.Unit</div>
                            </div>
                        </div>
                    </div>

                    <!-- Reason Input -->
                    <div class="mb-2">
                        <label class="form-label fw-semibold">Lý Do / Ghi Chú</label>
                        <input type="text" name="Reason" id="detailStockReason" class="form-control" value="Nhập thêm hàng vào kho" />
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" id="btnSubmitDetailStock" class="btn btn-success fw-semibold">
                        <i class="bi bi-check-lg me-1"></i> Xác Nhận Cập Nhật
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const currentStock = @med.TotalAvailableStock;
        const currentUnit = '@med.Unit';

        // Edit form double-click protection
        const editForm = document.getElementById('detailEditMedicineForm');
        if (editForm) {
            editForm.addEventListener('submit', function() {
                const btn = document.getElementById('btnSubmitDetailEdit');
                if (btn) {
                    btn.disabled = true;
                    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang lưu...';
                }
            });
        }

        // Stock form logic
        const stockForm = document.getElementById('detailUpdateStockForm');
        const qtyInput = document.getElementById('detailStockQtyInput');
        const warningEl = document.getElementById('detailStockWarning');
        const warningText = document.getElementById('detailStockWarningText');
        const submitBtn = document.getElementById('btnSubmitDetailStock');
        const previewBefore = document.getElementById('detailPreviewBefore');
        const previewChange = document.getElementById('detailPreviewChange');
        const previewAfter = document.getElementById('detailPreviewAfter');
        const lblQty = document.getElementById('detailLblStockQty');
        const helpQty = document.getElementById('detailHelpStockQty');
        const reasonInput = document.getElementById('detailStockReason');

        function updateDetailStockPreview() {
            const opType = document.querySelector('input[name="OperationType"]:checked')?.value || 'Add';
            const qtyVal = parseInt(qtyInput?.value || '0', 10);

            let afterQty = currentStock;
            let changeText = '+0';
            let isValid = true;
            let errorMessage = '';

            if (opType === 'Add') {
                lblQty.innerHTML = `Số lượng nhập thêm (${currentUnit}) <span class="text-danger">*</span>`;
                helpQty.textContent = 'Nhập số đơn vị cần thêm vào kho.';
                qtyInput.min = '1';
                if (!reasonInput.dataset.userEdited || reasonInput.value === 'Xuất giảm hao hụt / thuốc hỏng' || reasonInput.value === 'Cập nhật số lượng kiểm kê thực tế') {
                    reasonInput.value = 'Nhập thêm hàng vào kho';
                }

                if (isNaN(qtyVal) || qtyVal <= 0) {
                    isValid = false;
                    errorMessage = 'Số lượng nhập thêm phải lớn hơn 0.';
                } else {
                    afterQty = currentStock + qtyVal;
                    changeText = `+${qtyVal}`;
                }
            } else if (opType === 'Deduct') {
                lblQty.innerHTML = `Số lượng giảm tồn (${currentUnit}) <span class="text-danger">*</span>`;
                helpQty.textContent = `Không được nhập lớn hơn tồn kho hiện tại (${currentStock}).`;
                qtyInput.min = '1';
                qtyInput.max = currentStock.toString();
                if (!reasonInput.dataset.userEdited || reasonInput.value === 'Nhập thêm hàng vào kho' || reasonInput.value === 'Cập nhật số lượng kiểm kê thực tế') {
                    reasonInput.value = 'Xuất giảm hao hụt / thuốc hỏng';
                }

                if (isNaN(qtyVal) || qtyVal <= 0) {
                    isValid = false;
                    errorMessage = 'Số lượng giảm tồn phải lớn hơn 0.';
                } else if (qtyVal > currentStock) {
                    isValid = false;
                    errorMessage = `Số lượng giảm (${qtyVal}) không được vượt quá số lượng tồn kho hiện tại (${currentStock} ${currentUnit}).`;
                } else {
                    afterQty = currentStock - qtyVal;
                    changeText = `-${qtyVal}`;
                }
            } else if (opType === 'Reconcile') {
                lblQty.innerHTML = `Số lượng thực tế kiểm đếm (${currentUnit}) <span class="text-danger">*</span>`;
                helpQty.textContent = 'Nhập số lượng thực tế kiểm đếm trong kho; hệ thống sẽ tự tính độ lệch.';
                qtyInput.min = '0';
                qtyInput.removeAttribute('max');
                if (!reasonInput.dataset.userEdited || reasonInput.value === 'Nhập thêm hàng vào kho' || reasonInput.value === 'Xuất giảm hao hụt / thuốc hỏng') {
                    reasonInput.value = 'Cập nhật số lượng kiểm kê thực tế';
                }

                if (isNaN(qtyVal) || qtyVal < 0) {
                    isValid = false;
                    errorMessage = 'Số lượng kiểm kê thực tế không được âm.';
                } else {
                    afterQty = qtyVal;
                    const diff = qtyVal - currentStock;
                    changeText = diff >= 0 ? `+${diff}` : `${diff}`;
                }
            }

            // Update Preview numbers
            previewBefore.textContent = `${currentStock} ${currentUnit}`;
            previewChange.textContent = `${changeText} ${currentUnit}`;
            previewChange.className = `fw-bold fs-6 ${changeText.startsWith('-') ? 'text-danger' : (changeText.startsWith('+') && changeText !== '+0' ? 'text-success' : 'text-dark')}`;
            previewAfter.textContent = `${afterQty} ${currentUnit}`;
            previewAfter.className = `fw-bold fs-5 ${afterQty <= 0 ? 'text-danger' : 'text-primary'}`;

            if (!isValid) {
                warningText.textContent = errorMessage;
                warningEl.classList.remove('d-none');
                submitBtn.disabled = true;
            } else {
                warningEl.classList.add('d-none');
                submitBtn.disabled = false;
            }
        }

        document.querySelectorAll('input[name="OperationType"]').forEach(radio => {
            radio.addEventListener('change', updateDetailStockPreview);
        });

        if (qtyInput) {
            qtyInput.addEventListener('input', updateDetailStockPreview);
        }

        if (reasonInput) {
            reasonInput.addEventListener('input', function() {
                this.dataset.userEdited = 'true';
            });
        }

        if (stockForm) {
            stockForm.addEventListener('submit', function(e) {
                const opType = document.querySelector('input[name="OperationType"]:checked')?.value || 'Add';
                const qtyVal = parseInt(qtyInput?.value || '0', 10);

                if (opType === 'Deduct' && qtyVal > currentStock) {
                    e.preventDefault();
                    alert(`Số lượng giảm (${qtyVal}) không được vượt quá số lượng tồn kho hiện tại (${currentStock} ${currentUnit}).`);
                    return false;
                }

                if (submitBtn) {
                    submitBtn.disabled = true;
                    submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang xử lý...';
                }
            });
        }

        updateDetailStockPreview();
    });
</script>
}
